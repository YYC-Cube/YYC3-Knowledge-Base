{
  "name": "@yyc3/cn-optimizer",
  "version": "1.0.0",
  "description": "YYC³-CN中文优化专用模块 - 提供中文NLP、提示词优化、本地化支持",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./types": "./dist/types.js",
    "./tokenizer": "./dist/tokenizer.js",
    "./prompt": "./dist/prompt.js",
    "./localization": "./dist/localization.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/"
  },
  "keywords": [
    "yyc3",
    "chinese",
    "nlp",
    "localization",
    "prompt-optimization",
    "中文优化"
  ],
  "dependencies": {
    "zod": "^3.22.4"
  },
  "peerDependencies": {
    "typescript": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yyc3/yyc3-ai-family"
  }
}
