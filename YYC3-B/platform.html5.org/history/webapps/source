     <td>
    <tr>
     <td><span title="attr-meta-http-equiv-refresh">Refresh</span>
     <td><code title="">refresh</code>
     <td>
    <tr class="impl">
     <td><span title="attr-meta-http-equiv-set-cookie">Cookie setter</span>
     <td><code title="">set-cookie</code>
     <td>Non-conforming
  </table>

