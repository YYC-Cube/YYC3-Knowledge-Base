{
  "name": "@yyc3/lsp-integration",
  "version": "1.0.0",
  "description": "YYC³ 多语言LSP集成层 - 支持7种编程语言的智能代码分析",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./types": "./dist/types.js",
    "./client": "./dist/client.js",
    "./providers": "./dist/providers.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "yyc3",
    "lsp",
    "language-server-protocol",
    "typescript",
    "javascript",
    "python",
    "rust",
    "go",
    "java",
    "csharp"
  ],
  "dependencies": {
    "vscode-languageserver-protocol": "^3.17.0",
    "vscode-uri": "^3.0.0",
    "zod": "^3.22.4",
    "eventemitter3": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "files": ["dist", "README.md"],
  "license": "MIT"
}
