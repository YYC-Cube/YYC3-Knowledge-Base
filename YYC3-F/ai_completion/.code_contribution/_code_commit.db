  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/components/AIWidget/index.vue": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":281,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":281,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"<template>\\\\n  <div class=\\\\\\\"ai-widget-container\\\\\\\">\\\\n    <div class=\\\\\\\"ai-widget-button\\\\\\\" @click=\\\\\\\"toggleWidget\\\\\\\">\\\\n      <el-icon :size=\\\\\\\"24\\\\\\\">\\\\n        <ChatDotRound />\\\\n      </el-icon>\\\\n    </div>\\\\n\\\\n    <transition name=\\\\\\\"slide-up\\\\\\\">\\\\n      <div v-if=\\\\\\\"isOpen\\\\\\\" class=\\\\\\\"ai-widget-panel\\\\\\\">\\\\n        <div class=\\\\\\\"widget-header\\\\\\\">\\\\n          <div class=\\\\\\\"header-title\\\\\\\">\\\\n            <el-icon><Robot /></el-icon>\\\\n            <span>AI 助手</span>\\\\n          </div>\\\\n          <el-button type=\\\\\\\"text\\\\\\\" @click=\\\\\\\"toggleWidget\\\\\\\">\\\\n            <el-icon><Close /></el-icon>\\\\n          </el-button>\\\\n        </div>\\\\n\\\\n        <div class=\\\\\\\"widget-content\\\\\\\">\\\\n          <div class=\\\\\\\"chat-messages\\\\\\\" ref=\\\\\\\"messagesRef\\\\\\\">\\\\n            <div\\\\n              v-for=\\\\\\\"message in messages\\\\\\\"\\\\n              :key=\\\\\\\"message.id\\\\\\\"\\\\n              class=\\\\\\\"message\\\\\\\"\\\\n              :class=\\\\\\\"message.role\\\\\\\"\\\\n            >\\\\n              <div class=\\\\\\\"message-avatar\\\\\\\">\\\\n                <el-avatar v-if=\\\\\\\"message.role === \\\\'user\\\\'\\\\\\\" :size=\\\\\\\"32\\\\\\\">\\\\n                  {{ userInitial }}\\\\n                </el-avatar>\\\\n                <el-avatar v-else :size=\\\\\\\"32\\\\\\\" :style=\\\\\\\"{ background: \\\\'#6366f1\\\\' }\\\\\\\">\\\\n                  <el-icon><Robot /></el-icon>\\\\n          