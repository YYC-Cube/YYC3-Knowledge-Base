  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/components/analytics/__tests__/SalesAnalytics.test.ts": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":298,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":298,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"import { describe, it, expect, beforeEach, vi, afterEach } from \\\\'vitest\\\\'\\\\nimport { mount } from \\\\'@vue/test-utils\\\\'\\\\nimport { nextTick } from \\\\'vue\\\\'\\\\nimport { ElMessage } from \\\\'element-plus\\\\'\\\\nimport * as echarts from \\\\'echarts\\\\'\\\\nimport SalesAnalytics from \\\\'@/components/analytics/SalesAnalytics.vue\\\\'\\\\n\\\\nvi.mock(\\\\'element-plus\\\\', async () => {\\\\n  const actual = await vi.importActual(\\\\'element-plus\\\\')\\\\n  return {\\\\n    ...actual,\\\\n    ElMessage: {\\\\n      success: vi.fn(),\\\\n      error: vi.fn(),\\\\n      info: vi.fn(),\\\\n      warning: vi.fn()\\\\n    }\\\\n  }\\\\n})\\\\n\\\\nvi.mock(\\\\'echarts\\\\', () => ({\\\\n  default: {\\\\n    init: vi.fn(() => ({\\\\n      setOption: vi.fn(),\\\\n      dispose: vi.fn()\\\\n    })),\\\\n    graphic: {\\\\n      LinearGradient: vi.fn()\\\\n    }\\\\n  }\\\\n}))\\\\n\\\\ndescribe(\\\\'SalesAnalytics组件\\\\', () => {\\\\n  let wrapper: any\\\\n\\\\n  beforeEach(() => {\\\\n    wrapper = mount(SalesAnalytics)\\\\n    vi.clearAllMocks()\\\\n  })\\\\n\\\\n  afterEach(() => {\\\\n    if (wrapper) {\\\\n      wrapper.unmount()\\\\n    }\\\\n  })\\\\n\\\\n  describe(\\\\'组件渲染\\\\', () => {\\\\n    it(\\\\'应该正确渲染组件\\\\', () => {\\\\n      expect(wrapper.find(\\\\'.sales-analytics\\\\').exists()).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确渲染分析头部\\\\', () => {\\\\n      expect(wrapper.find(\\\\'.analytics-header\\\\').exists()).toBe(true)\\\\n      expect(wrapper.find(\\\\'.header-title h3\\\\').text()).toBe(\\\\'销售分析\\\\')\\\\n      expect(wrapper.find(\\\\'.header-title p\\\\').text()).toBe(\\\\'深入了解销售趋势和收入表现\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该正确渲染视图模式切换按钮\\\\', () => {\\\\n      const buttons = wrapper.findAll(\\\\'.el-button\\\\')\\\\n      expect(buttons.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确渲染分析内容区域\\\\', () => {\\\\n      expect(wrapper.find(\\\\'.analytics-content\\\\').exists()).toBe(true)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'视图模式切换\\\\', () => {\\\\n    it(\\\\'默认应该显示总览视图\\\\', () => {\\\\n      expect(wrapper.vm.viewMode).toBe(\\\\'overview\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该能够切换到趋势视图\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'trends\\\\' })\\\\n      expect(wrapper.vm.viewMode).toBe(\\\\'trends\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该能够切换到商品视图\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'products\\\\' })\\\\n      expect(wrapper.vm.viewMode).toBe(\\\\'products\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该能够切换到预测视图\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'forecast\\\\' })\\\\n      expect(wrapper.vm.viewMode).toBe(\\\\'forecast\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'总览视图\\\\', () => {\\\\n    it(\\\\'应该正确渲染总览视图\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'overview\\\\' })\\\\n      expect(wrapper.find(\\\\'.overview-view\\\\').exists()).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该显示销售收入趋势图表\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'overview\\\\' })\\\\n      expect(wrapper.vm.revenueChart).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该显示销售分布图表\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'overview\\\\' })\\\\n      expect(wrapper.vm.distributionChart).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该显示按小时销售分析图表\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'overview\\\\' })\\\\n      expect(wrapper.vm.hourlyChart).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该显示支付方式分布图表\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'overview\\\\' })\\\\n      expect(wrapper.vm.paymentChart).toBeDefined()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'趋势视图\\\\', () => {\\\\n    it(\\\\'应该正确渲染趋势视图\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'trends\\\\' })\\\\n      expect(wrapper.find(\\\\'.trends-view\\\\').exists()).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该显示销售趋势分析图表\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'trends\\\\' })\\\\n      expect(wrapper.vm.trendsChart).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该显示同比增长分析图表\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'trends\\\\' })\\\\n      expect(wrapper.vm.yoyChart).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该显示环比增长分析图表\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'trends\\\\' })\\\\n      expect(wrapper.vm.momChart).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该能够切换趋势粒度\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'trends\\\\', trendGranularity: \\\\'week\\\\' })\\\\n      expect(wrapper.vm.trendGranularity).toBe(\\\\'week\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该能够加载趋势数据\\\\', async () => {\\\\n      await wrapper.vm.loadTrendData()\\\\n      expect(ElMessage.info).toHaveBeenCalled()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'商品视图\\\\', () => {\\\\n    it(\\\\'应该正确渲染商品视图\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'products\\\\' })\\\\n      expect(wrapper.find(\\\\'.products-view\\\\').exists()).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该显示热销商品排行表格\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'products\\\\' })\\\\n      expect(wrapper.vm.topProducts).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该显示类别销售对比图表\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'products\\\\' })\\\\n      expect(wrapper.vm.categoryChart).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该显示商品关联分析图表\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'products\\\\' })\\\\n      expect(wrapper.vm.associationChart).toBeDefined()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'预测视图\\\\', () => {\\\\n    it(\\\\'应该正确渲染预测视图\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'forecast\\\\' })\\\\n      expect(wrapper.find(\\\\'.forecast-view\\\\').exists()).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该显示销售预测图表\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'forecast\\\\' })\\\\n      expect(wrapper.vm.forecastChart).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示预测准确度指标\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'forecast\\\\' })\\\\n      expect(wrapper.vm.forecastAccuracy).toBeDefined()\\\\n      expect(wrapper.vm.forecastAccuracy.mae).toBe(1250)\\\\n      expect(wrapper.vm.forecastAccuracy.rmse).toBe(1890)\\\\n      expect(wrapper.vm.forecastAccuracy.mape).toBe(8.5)\\\\n      expect(wrapper.vm.forecastAccuracy.r2).toBe(0.92)\\\\n    })\\\\n\\\\n    it(\\\\'应该显示预测建议\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'forecast\\\\' })\\\\n      const suggestions = wrapper.vm.forecastSuggestions\\\\n      expect(suggestions).toHaveLength(3)\\\\n      expect(suggestions[0].title).toBe(\\\\'预计下周销量增长15%\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该能够切换预测周期\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'forecast\\\\', forecastDays: 60 })\\\\n      expect(wrapper.vm.forecastDays).toBe(60)\\\\n    })\\\\n\\\\n    it(\\\\'应该能够切换预测模型\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'forecast\\\\', forecastModel: \\\\'lstm\\\\' })\\\\n      expect(wrapper.vm.forecastModel).toBe(\\\\'lstm\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该能够加载预测数据\\\\', async () => {\\\\n      await wrapper.vm.loadForecastData()\\\\n      expect(ElMessage.info).toHaveBeenCalled()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'图表初始化\\\\', () => {\\\\n    it(\\\\'应该正确初始化销售收入趋势图表\\\\', () => {\\\\n      wrapper.vm.initRevenueChart()\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确初始化销售分布图表\\\\', () => {\\\\n      wrapper.vm.initDistributionChart()\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确初始化按小时销售分析图表\\\\', () => {\\\\n      wrapper.vm.initHourlyChart()\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确初始化支付方式分布图表\\\\', () => {\\\\n      wrapper.vm.initPaymentChart()\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确初始化销售趋势分析图表\\\\', () => {\\\\n      wrapper.vm.initTrendsChart()\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确初始化同比增长分析图表\\\\', () => {\\\\n      wrapper.vm.initYoyChart()\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确初始化环比增长分析图表\\\\', () => {\\\\n      wrapper.vm.initMomChart()\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确初始化类别销售对比图表\\\\', () => {\\\\n      wrapper.vm.initCategoryChart()\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确初始化商品关联分析图表\\\\', () => {\\\\n      wrapper.vm.initAssociationChart()\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确初始化销售预测图表\\\\', () => {\\\\n      wrapper.vm.initForecastChart()\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'响应式行为\\\\', () => {\\\\n    it(\\\\'应该在视图模式变化时重新初始化图表\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'trends\\\\' })\\\\n      await nextTick()\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确处理趋势粒度变化\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'trends\\\\', trendGranularity: \\\\'month\\\\' })\\\\n      expect(wrapper.vm.trendGranularity).toBe(\\\\'month\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该正确处理预测周期变化\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'forecast\\\\', forecastDays: 90 })\\\\n      expect(wrapper.vm.forecastDays).toBe(90)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确处理预测模型变化\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'forecast\\\\', forecastModel: \\\\'prophet\\\\' })\\\\n      expect(wrapper.vm.forecastModel).toBe(\\\\'prophet\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'数据验证\\\\', () => {\\\\n    it(\\\\'预测准确度数据应该包含所有必需字段\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'forecast\\\\' })\\\\n      const accuracy = wrapper.vm.forecastAccuracy\\\\n      expect(accuracy).toHaveProperty(\\\\'mae\\\\')\\\\n      expect(accuracy).toHaveProperty(\\\\'rmse\\\\')\\\\n      expect(accuracy).toHaveProperty(\\\\'mape\\\\')\\\\n      expect(accuracy).toHaveProperty(\\\\'r2\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'预测建议数据应该包含所有必需字段\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'forecast\\\\' })\\\\n      const suggestion = wrapper.vm.forecastSuggestions[0]\\\\n      expect(suggestion).toHaveProperty(\\\\'title\\\\')\\\\n      expect(suggestion).toHaveProperty(\\\\'type\\\\')\\\\n      expect(suggestion).toHaveProperty(\\\\'description\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'热销商品数据应该包含所有必需字段\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'products\\\\' })\\\\n      const product = { rank: 1, itemName: \\\\'红烧肉\\\\', categoryName: \\\\'热菜\\\\', quantity: 580, revenue: 29000, profit: 11600, growth: 12.5 }\\\\n      expect(product).toHaveProperty(\\\\'rank\\\\')\\\\n      expect(product).toHaveProperty(\\\\'itemName\\\\')\\\\n      expect(product).toHaveProperty(\\\\'categoryName\\\\')\\\\n      expect(product).toHaveProperty(\\\\'quantity\\\\')\\\\n      expect(product).toHaveProperty(\\\\'revenue\\\\')\\\\n      expect(product).toHaveProperty(\\\\'profit\\\\')\\\\n      expect(product).toHaveProperty(\\\\'growth\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'边界情况\\\\', () => {\\\\n    it(\\\\'应该处理空图表引用\\\\', () => {\\\\n      wrapper.vm.revenueChart.value = null\\\\n      expect(() => wrapper.vm.initRevenueChart()).not.toThrow()\\\\n    })\\\\n\\\\n    it(\\\\'应该处理无效的视图模式\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'invalid\\\\' })\\\\n      expect(wrapper.vm.viewMode).toBe(\\\\'invalid\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该处理无效的趋势粒度\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'trends\\\\', trendGranularity: \\\\'invalid\\\\' })\\\\n      expect(wrapper.vm.trendGranularity).toBe(\\\\'invalid\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该处理无效的预测周期\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'forecast\\\\', forecastDays: 0 })\\\\n      expect(wrapper.vm.forecastDays).toBe(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该处理无效的预测模型\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'forecast\\\\', forecastModel: \\\\'invalid\\\\' })\\\\n      expect(wrapper.vm.forecastModel).toBe(\\\\'invalid\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'加载状态\\\\', () => {\\\\n    it(\\\\'应该正确设置加载状态\\\\', async () => {\\\\n      await wrapper.setData({ loading: true })\\\\n      expect(wrapper.vm.loading).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确清除加载状态\\\\', async () => {\\\\n      await wrapper.setData({ loading: false })\\\\n      expect(wrapper.vm.loading).toBe(false)\\\\n    })\\\\n  })\\\\n})\\\\n\",\"originAcceptText\":\"import { describe, it, expect, beforeEach, vi, afterEach } from 'vitest'\\nimport { mount } from '@vue/test-utils'\\nimport { nextTick } from 'vue'\\nimport { ElMessage } from 'element-plus'\\nimport * as echarts from 'echarts'\\nimport SalesAnalytics from '@/components/analytics/SalesAnalytics.vue'\\n\\nvi.mock('element-plus', async () => {\\n  const actual = await vi.importActual('element-plus')\\n  return {\\n    ...actual,\\n    ElMessage: {\\n      success: vi.fn(),\\n      error: vi.fn(),\\n      info: vi.fn(),\\n      warning: vi.fn()\\n    }\\n  }\\n})\\n\\nvi.mock('echarts', () => ({\\n  default: {\\n    init: vi.fn(() => ({\\n      setOption: vi.fn(),\\n      dispose: vi.fn()\\n    })),\\n    graphic: {\\n      LinearGradient: vi.fn()\\n    }\\n  }\\n}))\\n\\ndescribe('SalesAnalytics组件', () => {\\n  let wrapper: any\\n\\n  beforeEach(() => {\\n    wrapper = mount(SalesAnalytics)\\n    vi.clearAllMocks()\\n  })\\n\\n  afterEach(() => {\\n    if (wrapper) {\\n      wrapper.unmount()\\n    }\\n  })\\n\\n  describe('组件渲染', () => {\\n    it('应该正确渲染组件', () => {\\n      expect(wrapper.find('.sales-analytics').exists()).toBe(true)\\n    })\\n\\n    it('应该正确渲染分析头部', () => {\\n      expect(wrapper.find('.analytics-header').exists()).toBe(true)\\n      expect(wrapper.find('.header-title h3').text()).toBe('销售分析')\\n      expect(wrapper.find('.header-title p').text()).toBe('深入了解销售趋势和收入表现')\\n    })\\n\\n    it('应该正确渲染视图模式切换按钮', () => {\\n      const buttons = wrapper.findAll('.el-button')\\n      expect(buttons.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确渲染分析内容区域', () => {\\n      expect(wrapper.find('.analytics-content').exists()).toBe(true)\\n    })\\n  })\\n\\n  describe('视图模式切换', () => {\\n    it('默认应该显示总览视图', () => {\\n      expect(wrapper.vm.viewMode).toBe('overview')\\n    })\\n\\n    it('应该能够切换到趋势视图', async () => {\\n      await wrapper.setData({ viewMode: 'trends' })\\n      expect(wrapper.vm.viewMode).toBe('trends')\\n    })\\n\\n    it('应该能够切换到商品视图', async () => {\\n      await wrapper.setData({ viewMode: 'products' })\\n      expect(wrapper.vm.viewMode).toBe('products')\\n    })\\n\\n    it('应该能够切换到预测视图', async () => {\\n      await wrapper.setData({ viewMode: 'forecast' })\\n      expect(wrapper.vm.viewMode).toBe('forecast')\\n    })\\n  })\\n\\n  describe('总览视图', () => {\\n    it('应该正确渲染总览视图', async () => {\\n      await wrapper.setData({ viewMode: 'overview' })\\n      expect(wrapper.find('.overview-view').exists()).toBe(true)\\n    })\\n\\n    it('应该显示销售收入趋势图表', async () => {\\n      await wrapper.setData({ viewMode: 'overview' })\\n      expect(wrapper.vm.revenueChart).toBeDefined()\\n    })\\n\\n    it('应该显示销售分布图表', async () => {\\n      await wrapper.setData({ viewMode: 'overview' })\\n      expect(wrapper.vm.distributionChart).toBeDefined()\\n    })\\n\\n    it('应该显示按小时销售分析图表', async () => {\\n      await wrapper.setData({ viewMode: 'overview' })\\n      expect(wrapper.vm.hourlyChart).toBeDefined()\\n    })\\n\\n    it('应该显示支付方式分布图表', async () => {\\n      await wrapper.setData({ viewMode: 'overview' })\\n      expect(wrapper.vm.paymentChart).toBeDefined()\\n    })\\n  })\\n\\n  describe('趋势视图', () => {\\n    it('应该正确渲染趋势视图', async () => {\\n      await wrapper.setData({ viewMode: 'trends' })\\n      expect(wrapper.find('.trends-view').exists()).toBe(true)\\n    })\\n\\n    it('应该显示销售趋势分析图表', async () => {\\n      await wrapper.setData({ viewMode: 'trends' })\\n      expect(wrapper.vm.trendsChart).toBeDefined()\\n    })\\n\\n    it('应该显示同比增长分析图表', async () => {\\n      await wrapper.setData({ viewMode: 'trends' })\\n      expect(wrapper.vm.yoyChart).toBeDefined()\\n    })\\n\\n    it('应该显示环比增长分析图表', async () => {\\n      await wrapper.setData({ viewMode: 'trends' })\\n      expect(wrapper.vm.momChart).toBeDefined()\\n    })\\n\\n    it('应该能够切换趋势粒度', async () => {\\n      await wrapper.setData({ viewMode: 'trends', trendGranularity: 'week' })\\n      expect(wrapper.vm.trendGranularity).toBe('week')\\n    })\\n\\n    it('应该能够加载趋势数据', async () => {\\n      await wrapper.vm.loadTrendData()\\n      expect(ElMessage.info).toHaveBeenCalled()\\n    })\\n  })\\n\\n  describe('商品视图', () => {\\n    it('应该正确渲染商品视图', async () => {\\n      await wrapper.setData({ viewMode: 'products' })\\n      expect(wrapper.find('.products-view').exists()).toBe(true)\\n    })\\n\\n    it('应该显示热销商品排行表格', async () => {\\n      await wrapper.setData({ viewMode: 'products' })\\n      expect(wrapper.vm.topProducts).toBeDefined()\\n    })\\n\\n    it('应该显示类别销售对比图表', async () => {\\n      await wrapper.setData({ viewMode: 'products' })\\n      expect(wrapper.vm.categoryChart).toBeDefined()\\n    })\\n\\n    it('应该显示商品关联分析图表', async () => {\\n      await wrapper.setData({ viewMode: 'products' })\\n      expect(wrapper.vm.associationChart).toBeDefined()\\n    })\\n  })\\n\\n  describe('预测视图', () => {\\n    it('应该正确渲染预测视图', async () => {\\n      await wrapper.setData({ viewMode: 'forecast' })\\n      expect(wrapper.find('.forecast-view').exists()).toBe(true)\\n    })\\n\\n    it('应该显示销售预测图表', async () => {\\n      await wrapper.setData({ viewMode: 'forecast' })\\n      expect(wrapper.vm.forecastChart).toBeDefined()\\n    })\\n\\n    it('应该正确显示预测准确度指标', async () => {\\n      await wrapper.setData({ viewMode: 'forecast' })\\n      expect(wrapper.vm.forecastAccuracy).toBeDefined()\\n      expect(wrapper.vm.forecastAccuracy.mae).toBe(1250)\\n      expect(wrapper.vm.forecastAccuracy.rmse).toBe(1890)\\n      expect(wrapper.vm.forecastAccuracy.mape).toBe(8.5)\\n      expect(wrapper.vm.forecastAccuracy.r2).toBe(0.92)\\n    })\\n\\n    it('应该显示预测建议', async () => {\\n      await wrapper.setData({ viewMode: 'forecast' })\\n      const suggestions = wrapper.vm.forecastSuggestions\\n      expect(suggestions).toHaveLength(3)\\n      expect(suggestions[0].title).toBe('预计下周销量增长15%')\\n    })\\n\\n    it('应该能够切换预测周期', async () => {\\n      await wrapper.setData({ viewMode: 'forecast', forecastDays: 60 })\\n      expect(wrapper.vm.forecastDays).toBe(60)\\n    })\\n\\n    it('应该能够切换预测模型', async () => {\\n      await wrapper.setData({ viewMode: 'forecast', forecastModel: 'lstm' })\\n      expect(wrapper.vm.forecastModel).toBe('lstm')\\n    })\\n\\n    it('应该能够加载预测数据', async () => {\\n      await wrapper.vm.loadForecastData()\\n      expect(ElMessage.info).toHaveBeenCalled()\\n    })\\n  })\\n\\n  describe('图表初始化', () => {\\n    it('应该正确初始化销售收入趋势图表', () => {\\n      wrapper.vm.initRevenueChart()\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n\\n    it('应该正确初始化销售分布图表', () => {\\n      wrapper.vm.initDistributionChart()\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n\\n    it('应该正确初始化按小时销售分析图表', () => {\\n      wrapper.vm.initHourlyChart()\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n\\n    it('应该正确初始化支付方式分布图表', () => {\\n      wrapper.vm.initPaymentChart()\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n\\n    it('应该正确初始化销售趋势分析图表', () => {\\n      wrapper.vm.initTrendsChart()\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n\\n    it('应该正确初始化同比增长分析图表', () => {\\n      wrapper.vm.initYoyChart()\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n\\n    it('应该正确初始化环比增长分析图表', () => {\\n      wrapper.vm.initMomChart()\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n\\n    it('应该正确初始化类别销售对比图表', () => {\\n      wrapper.vm.initCategoryChart()\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n\\n    it('应该正确初始化商品关联分析图表', () => {\\n      wrapper.vm.initAssociationChart()\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n\\n    it('应该正确初始化销售预测图表', () => {\\n      wrapper.vm.initForecastChart()\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n  })\\n\\n  describe('响应式行为', () => {\\n    it('应该在视图模式变化时重新初始化图表', async () => {\\n      await wrapper.setData({ viewMode: 'trends' })\\n      await nextTick()\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n\\n    it('应该正确处理趋势粒度变化', async () => {\\n      await wrapper.setData({ viewMode: 'trends', trendGranularity: 'month' })\\n      expect(wrapper.vm.trendGranularity).toBe('month')\\n    })\\n\\n    it('应该正确处理预测周期变化', async () => {\\n      await wrapper.setData({ viewMode: 'forecast', forecastDays: 90 })\\n      expect(wrapper.vm.forecastDays).toBe(90)\\n    })\\n\\n    it('应该正确处理预测模型变化', async () => {\\n      await wrapper.setData({ viewMode: 'forecast', forecastModel: 'prophet' })\\n      expect(wrapper.vm.forecastModel).toBe('prophet')\\n    })\\n  })\\n\\n  describe('数据验证', () => {\\n    it('预测准确度数据应该包含所有必需字段', async () => {\\n      await wrapper.setData({ viewMode: 'forecast' })\\n      const accuracy = wrapper.vm.forecastAccuracy\\n      expect(accuracy).toHaveProperty('mae')\\n      expect(accuracy).toHaveProperty('rmse')\\n      expect(accuracy).toHaveProperty('mape')\\n      expect(accuracy).toHaveProperty('r2')\\n    })\\n\\n    it('预测建议数据应该包含所有必需字段', async () => {\\n      await wrapper.setData({ viewMode: 'forecast' })\\n      const suggestion = wrapper.vm.forecastSuggestions[0]\\n      expect(suggestion).toHaveProperty('title')\\n      expect(suggestion).toHaveProperty('type')\\n      expect(suggestion).toHaveProperty('description')\\n    })\\n\\n    it('热销商品数据应该包含所有必需字段', async () => {\\n      await wrapper.setData({ viewMode: 'products' })\\n      const product = { rank: 1, itemName: '红烧肉', categoryName: '热菜', quantity: 580, revenue: 29000, profit: 11600, growth: 12.5 }\\n      expect(product).toHaveProperty('rank')\\n      expect(product).toHaveProperty('itemName')\\n      expect(product).toHaveProperty('categoryName')\\n      expect(product).toHaveProperty('quantity')\\n      expect(product).toHaveProperty('revenue')\\n      expect(product).toHaveProperty('profit')\\n      expect(product).toHaveProperty('growth')\\n    })\\n  })\\n\\n  describe('边界情况', () => {\\n    it('应该处理空图表引用', () => {\\n      wrapper.vm.revenueChart.value = null\\n      expect(() => wrapper.vm.initRevenueChart()).not.toThrow()\\n    })\\n\\n    it('应该处理无效的视图模式', async () => {\\n      await wrapper.setData({ viewMode: 'invalid' })\\n      expect(wrapper.vm.viewMode).toBe('invalid')\\n    })\\n\\n    it('应该处理无效的趋势粒度', async () => {\\n      await wrapper.setData({ viewMode: 'trends', trendGranularity: 'invalid' })\\n      expect(wrapper.vm.trendGranularity).toBe('invalid')\\n    })\\n\\n    it('应该处理无效的预测周期', async () => {\\n      await wrapper.setData({ viewMode: 'forecast', forecastDays: 0 })\\n      expect(wrapper.vm.forecastDays).toBe(0)\\n    })\\n\\n    it('应该处理无效的预测模型', async () => {\\n      await wrapper.setData({ viewMode: 'forecast', forecastModel: 'invalid' })\\n      expect(wrapper.vm.forecastModel).toBe('invalid')\\n    })\\n  })\\n\\n  describe('加载状态', () => {\\n    it('应该正确设置加载状态', async () => {\\n      await wrapper.setData({ loading: true })\\n      expect(wrapper.vm.loading).toBe(true)\\n    })\\n\\n    it('应该正确清除加载状态', async () => {\\n      await wrapper.setData({ loading: false })\\n      expect(wrapper.vm.loading).toBe(false)\\n    })\\n  })\\n})\\n\",\"originTextLength\":10361,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768859828274},{\"originRange\":{\"start\":{\"line\":20,\"character\":0},\"end\":{\"line\":36,\"character\":40}},\"modifyRange\":{\"start\":{\"line\":20,\"character\":0},\"end\":{\"line\":36,\"character\":40}},\"action\":\"None\",\"isLine\":false,\"originText\":\"vi.mock(\\\\'echarts\\\\', () => {\\\\n  const mockChartInstance = {\\\\n    setOption: vi.fn(),\\\\n    resize: vi.fn(),\\\\n    dispose: vi.fn(),\\\\n    on: vi.fn(),\\\\n    off: vi.fn(),\\\\n    clear: vi.fn()\\\\n  }\\\\n  return {\\\\n    default: {\\\\n      init: vi.fn(() => mockChartInstance),\\\\n      graphic: {\\\\n        LinearGradient: vi.fn()\\\\n      }\\\\n    },\\\\n    init: vi.fn(() => mockChartInstance)\",\"originAcceptText\":\"vi.mock('echarts', () => {\\n  const mockChartInstance = {\\n    setOption: vi.fn(),\\n    resize: vi.fn(),\\n    dispose: vi.fn(),\\n    on: vi.fn(),\\n    off: vi.fn(),\\n    clear: vi.fn()\\n  }\\n  return {\\n    default: {\\n      init: vi.fn(() => mockChartInstance),\\n      graphic: {\\n        LinearGradient: vi.fn()\\n      }\\n    },\\n    init: vi.fn(() => mockChartInstance)\",\"originTextLength\":356,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768860330180},{\"originRange\":{\"start\":{\"line\":30,\"character\":0},\"end\":{\"line\":30,\"character\":2}},\"modifyRange\":{\"start\":{\"line\":30,\"character\":0}