      <el-table-column prop=\\\\\\\"category\\\\\\\" label=\\\\\\\"分类\\\\\\\" width=\\\\\\\"80\\\\\\\" />\\\\n            <el-table-column prop=\\\\\\\"storeName\\\\\\\" label=\\\\\\\"所属门店\\\\\\\" width=\\\\\\\"120\\\\\\\" />\\\\n            <el-table-column label=\\\\\\\"库存数量\\\\\\\" width=\\\\\\\"100\\\\\\\">\\\\n              <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                <span :class=\\\\\\\"getInventoryClass(row.status)\\\\\\\">{{ row.quantity }} {{ row.unit }}</span>\\\\n              </template>\\\\n            </el-table-column>\\\\n            <el-table-column prop=\\\\\\\"minQuantity\\\\\\\" label=\\\\\\\"最小库存\\\\\\\" width=\\\\\\\"100\\\\\\\" />\\\\n            <el-table-column prop=\\\\\\\"maxQuantity\\\\\\\" label=\\\\\\\"最大库存\\\\\\\" width=\\\\\\\"100\\\\\\\" />\\\\n            <el-table-column prop=\\\\\\\"costPrice\\\\\\\" label=\\\\\\\"成本价\\\\\\\" width=\\\\\\\"100\\\\\\\">\\\\n              <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                ¥{{ formatNumber(row.costPrice) }}\\\\n              </template>\\\\n            </el-table-column>\\\\n            <el-table-column label=\\\\\\\"库存状态\\\\\\\" width=\\\\\\\"80\\\\\\\">\\\\n              <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                <el-tag :type=\\\\\\\"getInventoryStatusType(row.status)\\\\\\\" size=\\\\\\\"small\\\\\\\">\\\\n                  {{ getInventoryStatusName(row.status) }}\\\\n                </el-tag>\\\\n              </template>\\\\n            </el-table-column>\\\\n            <el-table-column prop=\\\\\\\"location\\\\\\\" label=\\\\\\\"存放位置\\\\\\\" width=\\\\\\\"120\\\\\\\" />\\\\n            <el-table-column prop=\\\\\\\"expiryDate\\\\\\\" label=\\\\\\\"过期日期\\\\\\\" width=\\\\\\\"110\\\\\\\">\\\\n              <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                {{ row.expiryDate ? formatDateTime(row.expiryDate).split(\\\\' \\\\')[0] : \\\\'-\\\\' }}\\\\n              </template>\\\\n            </el-table-column>\\\\n            <el-table-column label=\\\\\\\"操作\\\\\\\" width=\\\\\\\"220\\\\\\\" fixed=\\\\\\\"right\\\\\\\">\\\\n              <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                <el-button link type=\\\\\\\"primary\\\\\\\" :icon=\\\\\\\"View\\\\\\\" @click=\\\\\\\"viewInventory(row)\\\\\\\">查看</el-button>\\\\n                <el-button link type=\\\\\\\"primary\\\\\\\" :icon=\\\\\\\"Plus\\\\\\\" @click=\\\\\\\"handleRestock(row)\\\\\\\">补货</el-button>\\\\n                <el-dropdown @command=\\\\\\\"(cmd) => handleInventoryAction(cmd, row)\\\\\\\">\\\\n                  <el-button link type=\\\\\\\"primary\\\\\\\" :icon=\\\\\\\"MoreFilled\\\\\\\">更多</el-button>\\\\n                  <template #dropdown>\\\\n                    <el-dropdown-item command=\\\\\\\"transfer\\\\\\\">调拨</el-dropdown-item>\\\\n                    <el-dropdown-item command=\\\\\\\"check\\\\\\\">盘点</el-dropdown-item>\\\\n                  </el-dropdown-menu>\\\\n                  </template>\\\\n                </el-dropdown>\\\\n              </template>\\\\n            </el-table-column>\\\\n          </el-table>\\\\n\\\\n          <el-pagination\\\\n            v-model:current-page=\\\\\\\"inventoryPagination.page\\\\\\\"\\\\n            v-model:page-size=\\\\\\\"inventoryPagination.limit\\\\\\\"\\\\n            :total=\\\\\\\"inventoryPagination.total\\\\\\\"\\\\n            :page-sizes=\\\\\\\"[10, 20, 50, 100]\\\\\\\"\\\\n            layout=\\\\\\\"total, sizes, prev, pager, next, jumper\\\\\\\"\\\\n            @current-change=\\\\\\\"handleInventoryPageChange\\\\\\\"\\\\n            @size-change=\\\\\\\"handleInventoryPageSizeChange\\\\\\\"\\\\n          />\\\\n        </div>\\\\n      </el-tab-pane>\\\\n\\\\n      <el-tab-pane label=\\\\\\\"数据统计\\\\\\\" name=\\\\\\\"stats\\\\\\\">\\\\n        <div class=\\\\\\\"stats-view\\\\\\\">\\\\n          <el-row :gutter=\\\\\\\"20\\\\\\\">\\\\n            <el-col :xs=\\\\\\\"24\\\\\\\" :sm=\\\\\\\"12\\\\\\\" :md=\\\\\\\"8\\\\\\\" :lg=\\\\\\\"6\\\\\\\">\\\\n              <el-card class=\\\\\\\"stat-card\\\\\\\">\\\\n                <div class=\\\\\\\"stat-content\\\\\\\">\\\\n                  <div class=\\\\\\\"stat-icon\\\\\\\" style=\\\\\\\"background: #409EFF\\\\\\\">\\\\n                    <el-icon><Shop /></el-icon>\\\\n                  </div>\\\\n                  <div class=\\\\\\\"stat-info\\\\\\\">\\\\n                    <div class=\\\\\\\"stat-value\\\\\\\">{{ stores.length }}</div>\\\\n                    <div class=\\\\\\\"stat-label\\\\\\\">门店总数</div>\\\\n                  </div>\\\\n                </div>\\\\n              </el-card>\\\\n            </el-col>\\\\n            <el-col :xs=\\\\\\\"24\\\\\\\" :sm=\\\\\\\"12\\\\\\\" :md=\\\\\\\"8\\\\\\\" :lg=\\\\\\\"6\\\\\\\">\\\\n              <el-card class=\\\\\\\"stat-card\\\\\\\">\\\\n                <div class=\\\\\\\"stat-content\\\\\\\">\\\\n                  <div class=\\\\\\\"stat-icon\\\\\\\" style=\\\\\\\"background: #67C23A\\\\\\\">\\\\n                    <el-icon><User /></el-icon>\\\\n                  </div>\\\\n                  <div class=\\\\\\\"stat-info\\\\\\\">\\\\n                    <div class=\\\\\\\"stat-value\\\\\\\">{{ employees.length }}</div>\\\\n                    <div class=\\\\\\\"stat-label\\\\\\\">员工总数</div>\\\\n                  </div>\\\\n                </div>\\\\n              </el-card>\\\\n            </el-col>\\\\n            <el-col :xs=\\\\\\\"24\\\\\\\" :sm=\\\\\\\"12\\\\\\\" :md=\\\\\\\"8\\\\\\\" :lg=\\\\\\\"6\\\\\\\">\\\\n              <el-card class=\\\\\\\"stat-card\\\\\\\">\\\\n                <div class=\\\\\\\"stat-content\\\\\\\">\\\\n                  <div class=\\\\\\\"stat-icon\\\\\\\" style=\\\\\\\"background: #E6A23C\\\\\\\">\\\\n                    <el-icon><Box /></el-icon>\\\\n                  </div>\\\\n                  <div class=\\\\\\\"stat-info\\\\\\\">\\\\n                    <div class=\\\\\\\"stat-value\\\\\\\">{{ inventory.length }}</div>\\\\n                    <div class=\\\\\\\"stat-label\\\\\\\">库存总数</div>\\\\n                  </div>\\\\n                </div>\\\\n              </el-card>\\\\n            </el-col>\\\\n            <el-col :xs=\\\\\\\"24\\\\\\\" :sm=\\\\\\\"12\\\\\\\" :md=\\\\\\\"8\\\\\\\" :lg=\\\\\\\"6\\\\\\\">\\\\n              <el-card class=\\\\\\\"stat-card\\\\\\\">\\\\n                <div class=\\\\\\\"stat-content\\\\\\\">\\\\n                  <div class=\\\\\\\"stat-icon\\\\\\\" style=\\\\\\\"background: #F56C6C\\\\\\\">\\\\n                    <el-icon><Money /></el-icon>\\\\n                  </div>\\\\n                  <div class=\\\\\\\"stat-info\\\\\\\">\\\\n                    <div class=\\\\\\\"stat-value\\\\\\\">{{ formatNumber(totalRevenue) }}</div>\\\\n                    <div class=\\\\\\\"stat-label\\\\\\\">总营业额</div>\\\\n                  </div>\\\\n                </div>\\\\n              </el-card>\\\\n            </el-col>\\\\n          </el-row>\\\\n\\\\n          <el-row :gutter=\\\\\\\"20\\\\\\\" style=\\\\\\\"margin-top: 20px\\\\\\\">\\\\n            <el-col :xs=\\\\\\\"24\\\\\\\" :lg=\\\\\\\"12\\\\\\\">\\\\n              <el-card class=\\\\\\\"chart-card\\\\\\\">\\\\n                <template #header>\\\\n                  <div class=\\\\\\\"card-header\\\\\\\">\\\\n                    <span>门店营收对比</span>\\\\n                  </div>\\\\n                </template>\\\\n                <div ref=\\\\\\\"revenueChartRef\\\\\\\" style=\\\\\\\"height: 400px\\\\\\\"></div>\\\\n              </el-card>\\\\n            </el-col>\\\\n            <el-col :xs=\\\\\\\"24\\\\\\\" :lg=\\\\\\\"12\\\\\\\">\\\\n              <el-card class=\\\\\\\"chart-card\\\\\\\">\\\\n                <template #header>\\\\n                  <div class=\\\\\\\"card-header\\\\\\\">\\\\n                    <span>员工绩效排名</span>\\\\n                  </div>\\\\n                </template>\\\\n                <div ref=\\\\\\\"performanceChartRef\\\\\\\" style=\\\\\\\"height: 400px\\\\\\\"></div>\\\\n              </el-card>\\\\n            </el-col>\\\\n          </el-row>\\\\n        </div>\\\\n      </el-tab-pane>\\\\n    </el-tabs>\\\\n\\\\n    <el-dialog\\\\n      v-model=\\\\\\\"showStoreDialog\\\\\\\"\\\\n      :title=\\\\\\\"storeDialogType === \\\\'create\\\\' ? \\\\'新增门店\\\\' : \\\\'编辑门店\\\\'\\\\\\\"\\\\n      width=\\\\\\\"800px\\\\\\\"\\\\n      :close-on-click-modal=\\\\\\\"false\\\\\\\"\\\\n    >\\\\n      <el-form :model=\\\\\\\"storeForm\\\\\\\" label-width=\\\\\\\"120px\\\\\\\">\\\\n        <el-form-item label=\\\\\\\"门店编号\\\\\\\" prop=\\\\\\\"storeCode\\\\\\\">\\\\n          <el-input v-model=\\\\\\\"storeForm.storeCode\\\\\\\" placeholder=\\\\\\\"请输入门店编号\\\\\\\" :disabled=\\\\\\\"storeDialogType === \\\\'edit\\\\'\\\\\\\" />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"门店名称\\\\\\\" prop=\\\\\\\"name\\\\\\\">\\\\n          <el-input v-model=\\\\\\\"storeForm.name\\\\\\\" placeholder=\\\\\\\"请输入门店名称\\\\\\\" />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"门店类型\\\\\\\" prop=\\\\\\\"type\\\\\\\">\\\\n          <el-radio-group v-model=\\\\\\\"storeForm.type\\\\\\\">\\\\n            <el-radio :label=\\\\\\\"StoreType.DIRECT\\\\\\\">直营店</el-radio>\\\\n            <el-radio :label=\\\\\\\"StoreType.FRANCHISE\\\\\\\">加盟店</el-radio>\\\\n          </el-radio-group>\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"门店状态\\\\\\\" prop=\\\\\\\"status\\\\\\\">\\\\n          <el-radio-group v-model=\\\\\\\"storeForm.status\\\\\\\">\\\\n            <el-radio :label=\\\\\\\"StoreStatus.OPEN\\\\\\\">营业中</el-radio>\\\\n            <el-radio :label=\\\\\\\"StoreStatus.CLOSED\\\\\\\">休息中</el-radio>\\\\n            <el-radio :label=\\\\\\\"StoreStatus.MAINTENANCE\\\\\\\">已关闭</el-radio>\\\\n          </el-radio-group>\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"门店地址\\\\\\\" prop=\\\\\\\"address\\\\\\\">\\\\n          <el-input v-model=\\\\\\\"storeForm.address\\\\\\\" placeholder=\\\\\\\"请输入门店地址\\\\\\\" />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"所在城市\\\\\\\" prop=\\\\\\\"city\\\\\\\">\\\\n          <el-input v-model=\\\\\\\"storeForm.city\\\\\\\" placeholder=\\\\\\\"请输入所在城市\\\\\\\" />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"所在区县\\\\\\\" prop=\\\\\\\"district\\\\\\\">\\\\n          <el-input v-model=\\\\\\\"storeForm.district\\\\\\\" placeholder=\\\\\\\"请输入所在区县\\\\\\\" />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"联系电话\\\\\\\" prop=\\\\\\\"phone\\\\\\\">\\\\n          <el-input v-model=\\\\\\\"storeForm.phone\\\\\\\" placeholder=\\\\\\\"请输入联系电话\\\\\\\" />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"邮箱\\\\\\\" prop=\\\\\\\"email\\\\\\\">\\\\n          <el-input v-model=\\\\\\\"storeForm.email\\\\\\\" placeholder=\\\\\\\"请输入邮箱\\\\\\\" />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"店长\\\\\\\" prop=\\\\\\\"managerId\\\\\\\">\\\\n          <el-select v-model=\\\\\\\"storeForm.managerId\\\\\\\" placeholder=\\\\\\\"请选择店长\\\\\\\">\\\\n            <el-option v-for=\\\\\\\"employee in employees\\\\\\\" :key=\\\\\\\"employee.id\\\\\\\" :label=\\\\\\\"employee.name\\\\\\\" :value=\\\\\\\"employee.id\\\\\\\" />\\\\n          </el-select>\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"营业时间\\\\\\\" prop=\\\\\\\"businessHours\\\\\\\">\\\\n          <el-row :gutter=\\\\\\\"10\\\\\\\">\\\\n            <el-col :span=\\\\\\\"3\\\\\\\">周一</el-col>\\\\n            <el-col :span=\\\\\\\"9\\\\\\\">\\\\n              <el-time-picker v-model=\\\\\\\"storeForm.businessHours.monday.open\\\\\\\" placeholder=\\\\\\\"开门时间\\\\\\\" format=\\\\\\\"HH:mm\\\\\\\" />\\\\n            </el-col>\\\\n            <el-col :span=\\\\\\\"9\\\\\\\">\\\\n              <el-time-picker v-model=\\\\\\\"storeForm.businessHours.monday.close\\\\\\\" placeholder=\\\\\\\"关门时间\\\\\\\" format=\\\\\\\"HH:mm\\\\\\\" />\\\\n            </el-col>\\\\n            <el-col :span=\\\\\\\"3\\\\\\\">\\\\n              <el-switch v-model=\\\\\\\"storeForm.businessHours.monday.enabled\\\\\\\" />\\\\n            </el-col>\\\\n          </el-row>\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"门店面积\\\\\\\" prop=\\\\\\\"area\\\\\\\">\\\\n          <el-input-number v-model=\\\\\\\"storeForm.area\\\\\\\" :min=\\\\\\\"1\\\\\\\" :max=\\\\\\\"10000\\\\\\\" />\\\\n          <span style=\\\\\\\"margin-left: 10px\\\\\\\">平方米</span>\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"最大容量\\\\\\\" prop=\\\\\\\"capacity\\\\\\\">\\\\n          <el-input-number v-model=\\\\\\\"storeForm.capacity\\\\\\\" :min=\\\\\\\"1\\\\\\\" :max=\\\\\\\"1000\\\\\\\" />\\\\n          <span style=\\\\\\\"margin-left: 10px\\\\\\\">人</span>\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"桌位数量\\\\\\\" prop=\\\\\\\"tables\\\\\\\">\\\\n          <el-input-number v-model=\\\\\\\"storeForm.tables\\\\\\\" :min=\\\\\\\"1\\\\\\\" :max=\\\\\\\"500\\\\\\\" />\\\\n          <span style=\\\\\\\"margin-left: 10px\\\\\\\">个</span>\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"开业日期\\\\\\\" prop=\\\\\\\"openingDate\\\\\\\">\\\\n          <el-date-picker v-model=\\\\\\\"storeForm.openingDate\\\\\\\" type=\\\\\\\"date\\\\\\\" placeholder=\\\\\\\"请选择开业日期\\\\\\\" />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"门店描述\\\\\\\" prop=\\\\\\\"description\\\\\\\">\\\\n          <el-input v-model=\\\\\\\"storeForm.description\\\\\\\" type=\\\\\\\"textarea\\\\\\\" :rows=\\\\\\\"3\\\\\\\" placeholder=\\\\\\\"请输入门店描述\\\\\\\" />\\\\n        </el-form-item>\\\\n      </el-form>\\\\n      <template #footer>\\\\n        <el-button @click=\\\\\\\"showStoreDialog = false\\\\\\\">取消</el-button>\\\\n        <el-button type=\\\\\\\"primary\\\\\\\" @click=\\\\\\\"confirmStore\\\\\\\">确定</el-button>\\\\n      </template>\\\\n    </el-dialog>\\\\n\\\\n    <el-dialog\\\\n      v-model=\\\\\\\"showEmployeeDialog\\\\\\\"\\\\n      :title=\\\\\\\"employeeDialogType === \\\\'create\\\\' ? \\\\'新增员工\\\\' : \\\\'编辑员工\\\\'\\\\\\\"\\\\n      width=\\\\\\\"800px\\\\\\\"\\\\n      :close-on-click-modal=\\\\\\\"false\\\\\\\"\\\\n    >\\\\n      <el-form :model=\\\\\\\"employeeForm\\\\\\\" label-width=\\\\\\\"120px\\\\\\\">\\\\n        <el-form-item label=\\\\\\\"工号\\\\\\\" prop=\\\\\\\"employeeCode\\\\\\\">\\\\n          <el-input v-model=\\\\\\\"employeeForm.employeeCode\\\\\\\" placeholder=\\\\\\\"请输入工号\\\\\\\" :disabled=\\\\\\\"employeeDialogType === \\\\'edit\\\\'\\\\\\\" />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"姓名\\\\\\\" prop=\\\\\\\"name\\\\\\\">\\\\n          <el-input v-model=\\\\\\\"employeeForm.name\\\\\\\" placeholder=\\\\\\\"请输入姓名\\\\\\\" />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"性别\\\\\\\" prop=\\\\\\\"gender\\\\\\\">\\\\n          <el-radio-group v-model=\\\\\\\"employeeForm.gender\\\\\\\">\\\\n            <el-radio label=\\\\\\\"male\\\\\\\">男</el-radio>\\\\n            <el-radio label=\\\\\\\"female\\\\\\\">女</el-radio>\\\\n            <el-radio label=\\\\\\\"other\\\\\\\">其他</el-radio>\\\\n          </el-radio-group>\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"手机号\\\\\\\" prop=\\\\\\\"phone\\\\\\\">\\\\n          <el-input v-model=\\\\\\\"employeeForm.phone\\\\\\\" placeholder=\\\\\\\"请输入手机号\\\\\\\" />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"邮箱\\\\\\\" prop=\\\\\\\"email\\\\\\\">\\\\n          <el-input v-model=\\\\\\\"employeeForm.email\\\\\\\" placeholder=\\\\\\\"请输入邮箱\\\\\\\" />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"所属门店\\\\\\\" prop=\\\\\\\"storeId\\\\\\\">\\\\n          <el-select v-model=\\\\\\\"employeeForm.storeId\\\\\\\" placeholder=\\\\\\\"请选择所属门店\\\\\\\">\\\\n            <el-option v-for=\\\\\\\"store in stores\\\\\\\" :key=\\\\\\\"store.id\\\\\\\" :label=\\\\\\\"store.name\\\\\\\" :value=\\\\\\\"store.id\\\\\\\" />\\\\n          </el-select>\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"部门\\\\\\\" prop=\\\\\\\"department\\\\\\\">\\\\n          <el-select v-model=\\\\\\\"employeeForm.department\\\\\\\" placeholder=\\\\\\\"请选择部门\\\\\\\">\\\\n            <el-option label=\\\\\\\"前厅\\\\\\\" value=\\\\\\\"前厅\\\\\\\" />\\\\n            <el-option label=\\\\\\\"后厨\\\\\\\" value=\\\\\\\"后厨\\\\\\\" />\\\\n            <el-option label=\\\\\\\"管理\\\\\\\" value=\\\\\\\"管理\\\\\\\" />\\\\n            <el-option label=\\\\\\\"财务\\\\\\\" value=\\\\\\\"财务\\\\\\\" />\\\\n          </el-select>\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"职位\\\\\\\" prop=\\\\\\\"position\\\\\\\">\\\\n          <el-input v-model=\\\\\\\"employeeForm.position\\\\\\\" placeholder=\\\\\\\"请输入职位\\\\\\\" />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"员工状态\\\\\\\" prop=\\\\\\\"status\\\\\\\">\\\\n          <el-radio-group v-model=\\\\\\\"employeeForm.status\\\\\\\">\\\\n            <el-radio :label=\\\\\\\"EmployeeStatus.ACTIVE\\\\\\\">在职</el-radio>\\\\n            <el-radio :label=\\\\\\\"EmployeeStatus.RESIGNED\\\\\\\">离职</el-radio>\\\\n            <el-radio :label=\\\\\\\"EmployeeStatus.LEAVE\\\\\\\">请假</el-radio>\\\\n          </el-radio-group>\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"入职日期\\\\\\\" prop=\\\\\\\"hireDate\\\\\\\">\\\\n          <el-date-picker v-model=\\\\\\\"employeeForm.hireDate\\\\\\\" type=\\\\\\\"date\\\\\\\" placeholder=\\\\\\\"请选择入职日期\\\\\\\" />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"薪资\\\\\\\" prop=\\\\\\\"salary\\\\\\\">\\\\n          <el-input-number v-model=\\\\\\\"employeeForm.salary\\\\\\\" :min=\\\\\\\"0\\\\\\\" :max=\\\\\\\"100000\\\\\\\" :precision=\\\\\\\"2\\\\\\\" />\\\\n          <span style=\\\\\\\"margin-left: 10px\\\\\\\">元</span>\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"地址\\\\\\\" prop=\\\\\\\"address\\\\\\\">\\\\n          <el-input v-model=\\\\\\\"employeeForm.address\\\\\\\" placeholder=\\\\\\\"请输入地址\\\\\\\" />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"身份证号\\\\\\\" prop=\\\\\\\"idCard\\\\\\\">\\\\n          <el-input v-model=\\\\\\\"employeeForm.idCard\\\\\\\" placeholder=\\\\\\\"请输入身份证号\\\\\\\" />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"银行账号\\\\\\\" prop=\\\\\\\"bankAccount\\\\\\\">\\\\n          <el-input v-model=\\\\\\\"employeeForm.bankAccount\\\\\\\" placeholder=\\\\\\\"请输入银行账号\\\\\\\" />\\\\n        </el-form-item>\\\\n      </el-form>\\\\n      <template #footer>\\\\n        <el-button @click=\\\\\\\"showEmployeeDialog = false\\\\\\\">取消</el-button>\\\\n        <el-button type=\\\\\\\"primary\\\\\\\" @click=\\\\\\\"confirmEmployee\\\\\\\">确定</el-button>\\\\n      </template>\\\\n    </el-dialog>\\\\n\\\\n    <el-dialog\\\\n      v-model=\\\\\\\"showTransferDialog\\\\\\\"\\\\n      title=\\\\\\\"员工调店\\\\\\\"\\\\n      width=\\\\\\\"600px\\\\\\\"\\\\n      :close-on-click-modal=\\\\\\\"false\\\\\\\"\\\\n    >\\\\n      <el-form :model=\\\\\\\"transferForm\\\\\\\" label-width=\\\\\\\"120px\\\\\\\">\\\\n        <el-form-item label=\\\\\\\"目标门店\\\\\\\" prop=\\\\\\\"targetStoreId\\\\\\\">\\\\n          <el-select v-model=\\\\\\\"transferForm.targetStoreId\\\\\\\" placeholder=\\\\\\\"请选择目标门店\\\\\\\">\\\\n            <el-option v-for=\\\\\\\"store in stores\\\\\\\" :key=\\\\\\\"store.id\\\\\\\" :label=\\\\\\\"store.name\\\\\\\" :value=\\\\\\\"store.id\\\\\\\" />\\\\n          </el-select>\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"调动原因\\\\\\\" prop=\\\\\\\"reason\\\\\\\">\\\\n          <el-input v-model=\\\\\\\"transferForm.reason\\\\\\\" type=\\\\\\\"textarea\\\\\\\" :rows=\\\\\\\"3\\\\\\\" placeholder=\\\\\\\"请输入调动原因\\\\\\\" />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"生效日期\\\\\\\" prop=\\\\\\\"effectiveDate\\\\\\\">\\\\n          <el-date-picker v-model=\\\\\\\"transferForm.effectiveDate\\\\\\\" type=\\\\\\\"date\\\\\\\" placeholder=\\\\\\\"请选择生效日期\\\\\\\" />\\\\n        </el-form-item>\\\\n      </el-form>\\\\n      <template #footer>\\\\n        <el-button @click=\\\\\\\"showTransferDialog = false\\\\\\\">取消</el-button>\\\\n        <el-button type=\\\\\\\"primary\\\\\\\" @click=\\\\\\\"confirmTransfer\\\\\\\">确定</el-button>\\\\n      </template>\\\\n    </el-dialog>\\\\n\\\\n    <el-dialog\\\\n      v-model=\\\\\\\"showRestockDialog\\\\\\\"\\\\n      title=\\\\\\\"库存补货\\\\\\\"\\\\n      width=\\\\\\\"600px\\\\\\\"\\\\n      :close-on-click-modal=\\\\\\\"false\\\\\\\"\\\\n    >\\\\n      <el-form :model=\\\\\\\"restockForm\\\\\\\" label-width=\\\\\\\"120px\\\\\\\">\\\\n        <el-form-item label=\\\\\\\"补货数量\\\\\\\" prop=\\\\\\\"quantity\\\\\\\">\\\\n          <el-input-number v-model=\\\\\\\"restockForm.quantity\\\\\\\" :min=\\\\\\\"1\\\\\\\" :max=\\\\\\\"10000\\\\\\\" />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"补货单价\\\\\\\" prop=\\\\\\\"costPrice\\\\\\\">\\\\n          <el-input-number v-model=\\\\\\\"restockForm.costPrice\\\\\\\" :min=\\\\\\\"0\\\\\\\" :max=\\\\\\\"100000\\\\\\\" :precision=\\\\\\\"2\\\\\\\" />\\\\n          <span style=\\\\\\\"margin-left: 10px\\\\\\\">元</span>\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"供应商\\\\\\\" prop=\\\\\\\"supplier\\\\\\\">\\\\n          <el-input v-model=\\\\\\\"restockForm.supplier.name\\\\\\\" placeholder=\\\\\\\"请输入供应商名称\\\\\\\" />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"批次号\\\\\\\" prop=\\\\\\\"batchNumber\\\\\\\">\\\\n          <el-input v-model=\\\\\\\"restockForm.batchNumber\\\\\\\" placeholder=\\\\\\\"请输入批次号\\\\\\\" />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"过期日期\\\\\\\" prop=\\\\\\\"expiryDate\\\\\\\">\\\\n          <el-date-picker v-model=\\\\\\\"restockForm.expiryDate\\\\\\\" type=\\\\\\\"date\\\\\\\" placeholder=\\\\\\\"请选择过期日期\\\\\\\" />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"备注\\\\\\\" prop=\\\\\\\"remarks\\\\\\\">\\\\n          <el-input v-model=\\\\\\\"restockForm.remarks\\\\\\\" type=\\\\\\\"textarea\\\\\\\" :rows=\\\\\\\"3\\\\\\\" placeholder=\\\\\\\"请输入备注\\\\\\\" />\\\\n        </el-form-item>\\\\n      </el-form>\\\\n      <template #footer>\\\\n        <el-button @click=\\\\\\\"showRestockDialog = false\\\\\\\">取消</el-button>\\\\n        <el-button type=\\\\\\\"primary\\\\\\\" @click=\\\\\\\"confirmRestock\\\\\\\">确定</el-button>\\\\n      </template>\\\\n    </el-dialog>\\\\n  </div>\\\\n</template>\\\\n\\\\n<script setup lang=\\\\\\\"ts\\\\\\\">\\\\nimport { ref, computed, onMounted, nextTick } from \\\\'vue\\\\'\\\\nimport { useChain } from \\\\'@/composables/useChain\\\\'\\\\nimport { StoreType, StoreStatus, EmployeeStatus, InventoryStatus } from \\\\'@/api/chain\\\\'\\\\nimport { Shop, User, Box, Money, Plus, Search, Refresh, View, Edit, MoreFilled } from \\\\'@element-plus/icons-vue\\\\'\\\\nimport * as echarts from \\\\'echarts\\\\'\\\\n\\\\nconst {\\\\n  loading,\\\\n  activeTab,\\\\n  stores,\\\\n  employees,\\\\n  inventory,\\\\n  storeStats,\\\\n  employeePerformance,\\\\n  selectedStore,\\\\n  selectedEmployee,\\\\n  selectedInventory,\\\\n  showStoreDialog,\\\\n  showEmployeeDialog,\\\\n  showTransferDialog,\\\\n  showRestockDialog,\\\\n  showTransferInventoryDialog,\\\\n  showCheckDialog,\\\\n  storeDialogType,\\\\n  employeeDialogType,\\\\n  storeForm,\\\\n  employeeForm,\\\\n  transferForm,\\\\n  restockForm,\\\\n  transferInventoryForm,\\\\n  checkForm,\\\\n  storePagination,\\\\n  employeePagination,\\\\n  inventoryPagination,\\\\n  storeFilter,\\\\n  employeeFilter,\\\\n  inventoryFilter,\\\\n  storesLoading,\\\\n  employeesLoading,\\\\n  inventoryLoading,\\\\n  statsLoading,\\\\n  loadStores,\\\\n  loadEmployees,\\\\n  loadInventory,\\\\n  loadStoreStats,\\\\n  loadEmployeePerformance,\\\\n  handleAddStore,\\\\n  handleEditStore,\\\\n  handleDeleteStore,\\\\n  handleUpdateStoreStatus,\\\\n  confirmStore,\\\\n  handleAddEmployee,\\\\n  handleEditEmployee,\\\\n  handleDeleteEmployee,\\\\n  handleTransferEmployee,\\\\n  confirmTransfer,\\\\n  confirmEmployee,\\\\n  handleRestock,\\\\n  confirmRestock,\\\\n  handleTransferInventory,\\\\n  confirmTransferInventory,\\\\n  handleCheckInventory,\\\\n  confirmCheck,\\\\n  handleStoreSearch,\\\\n  resetStoreFilter,\\\\n  handleEmployeeSearch,\\\\n  resetEmployeeFilter,\\\\n  handleInventorySearch,\\\\n  resetInventoryFilter,\\\\n  handleStorePageChange,\\\\n  handleStorePageSizeChange,\\\\n  handleEmployeePageChange,\\\\n  handleEmployeePageSizeChange,\\\\n  handleInventoryPageChange,\\\\n  handleInventoryPageSizeChange,\\\\n  handleTabChange,\\\\n  formatNumber,\\\\n  formatDateTime,\\\\n  getStoreTypeName,\\\\n  getStoreStatusName,\\\\n  getStoreStatusType,\\\\n  getEmployeeStatusName,\\\\n  getEmployeeStatusType,\\\\n  getInventoryStatusName,\\\\n  getInventoryStatusType\\\\n} = useChain()\\\\n\\\\nconst revenueChartRef = ref<HTMLElement>()\\\\nconst performanceChartRef = ref<HTMLElement>()\\\\n\\\\nconst totalRevenue = computed(() => {\\\\n  return storeStats.reduce((sum, stat) => sum + stat.totalRevenue, 0)\\\\n})\\\\n\\\\nconst viewStore = (store: any) => {\\\\n  console.log(\\\\'查看门店:\\\\', store)\\\\n}\\\\n\\\\nconst viewEmployee = (employee: any) => {\\\\n  console.log(\\\\'查看员工:\\\\', employee)\\\\n}\\\\n\\\\nconst viewInventory = (inventoryItem: any) => {\\\\n  console.log(\\\\'查看库存:\\\\', inventoryItem)\\\\n}\\\\n\\\\nconst handleStoreAction = (command: string, store: any) => {\\\\n  switch (command) {\\\\n    case \\\\'updateStatus\\\\':\\\\n      handleUpdateStoreStatus(store, store.status === StoreStatus.OPEN ? StoreStatus.CLOSED : StoreStatus.OPEN)\\\\n      break\\\\n    case \\\\'stats\\\\':\\\\n      console.log(\\\\'查看统计数据:\\\\', store)\\\\n      break\\\\n    case \\\\'delete\\\\':\\\\n      handleDeleteStore(store)\\\\n      break\\\\n  }\\\\n}\\\\n\\\\nconst handleEmployeeAction = (command: string, employee: any) => {\\\\n  switch (command) {\\\\n    case \\\\'transfer\\\\':\\\\n      handleTransferEmployee(employee)\\\\n      break\\\\n    case \\\\'performance\\\\':\\\\n      console.log(\\\\'查看绩效:\\\\', employee)\\\\n      break\\\\n    case \\\\'permissions\\\\':\\\\n      console.log(\\\\'查看权限:\\\\', employee)\\\\n      break\\\\n    case \\\\'delete\\\\':\\\\n      handleDeleteEmployee(employee)\\\\n      break\\\\n  }\\\\n}\\\\n\\\\nconst handleInventoryAction = (command: string, inventoryItem: any) => {\\\\n  switch (command) {\\\\n    case \\\\'transfer\\\\':\\\\n      handleTransferInventory(inventoryItem)\\\\n      break\\\\n    case \\\\'check\\\\':\\\\n      handleCheckInventory(inventoryItem.storeId)\\\\n      break\\\\n  }\\\\n}\\\\n\\\\nconst getInventoryClass = (status: InventoryStatus) => {\\\\n  switch (status) {\\\\n    case InventoryStatus.NORMAL:\\\\n      return \\\\'inventory-normal\\\\'\\\\n    case InventoryStatus.WARNING:\\\\n      return \\\\'inventory-warning\\\\'\\\\n    case InventoryStatus.OUT_OF_STOCK:\\\\n      return \\\\'inventory-out-of-stock\\\\'\\\\n    default:\\\\n      return \\\\'\\\\'\\\\n  }\\\\n}\\\\n\\\\nconst initCharts = () => {\\\\n  if (revenueChartRef.value) {\\\\n    const revenueChart = echarts.init(revenueChartRef.value)\\\\n    revenueChart.setOption({\\\\n      title: {\\\\n        text: \\\\'门店营收对比\\\\'\\\\n      },\\\\n      tooltip: {\\\\n        trigger: \\\\'axis\\\\'\\\\n      },\\\\n      xAxis: {\\\\n        type: \\\\'category\\\\',\\\\n        data: storeStats.map(stat => stat.storeName)\\\\n      },\\\\n      yAxis: {\\\\n        type: \\\\'value\\\\',\\\\n        name: \\\\'营收（元）\\\\'\\\\n      },\\\\n      series: [\\\\n        {\\\\n          name: \\\\'营收\\\\',\\\\n          type: \\\\'bar\\\\',\\\\n          data: storeStats.map(stat => stat.totalRevenue),\\\\n          itemStyle: {\\\\n            color: \\\\'#409EFF\\\\'\\\\n          }\\\\n        }\\\\n      ]\\\\n    })\\\\n  }\\\\n\\\\n  if (performanceChartRef.value) {\\\\n    const performanceChart = echarts.init(performanceChartRef.value)\\\\n    performanceChart.setOption({\\\\n      title: {\\\\n        text: \\\\'员工绩效排名\\\\'\\\\n      },\\\\n      tooltip: {\\\\n        trigger: \\\\'axis\\\\'\\\\n      },\\\\n      xAxis: {\\\\n        type: \\\\'category\\\\',\\\\n        data: employeePerformance.slice(0, 10).map(emp => emp.employeeName)\\\\n      },\\\\n      yAxis: {\\\\n        type: \\\\'value\\\\',\\\\n        name: \\\\'绩效评分\\\\'\\\\n      },\\\\n      series: [\\\\n        {\\\\n          name: \\\\'绩效评分\\\\',\\\\n          type: \\\\'bar\\\\',\\\\n          data: employeePerformance.slice(0, 10).map(emp => emp.performanceScore),\\\\n          itemStyle: {\\\\n            color: \\\\'#67C23A\\\\'\\\\n          }\\\\n        }\\\\n      ]\\\\n    })\\\\n  }\\\\n}\\\\n\\\\nonMounted(async () => {\\\\n  await loadStores()\\\\n  await loadEmployees()\\\\n  await loadInventory()\\\\n  await loadStoreStats()\\\\n  await loadEmployeePerformance()\\\\n  \\\\n  await nextTick()\\\\n  initCharts()\\\\n})\\\\n</script>\\\\n\\\\n<style scoped>\\\\n.chain-management {\\\\n  padding: 20px;\\\\n}\\\\n\\\\n.chain-header {\\\\n  display: flex;\\\\n  justify-content: space-between;\\\\n  align-items: center;\\\\n  margin-bottom: 20px;\\\\n}\\\\n\\\\n.header-left {\\\\n  display: flex;\\\\n  flex-direction: column;\\\\n  gap: 10px;\\\\n}\\\\n\\\\n.chain-title {\\\\n  margin: 0;\\\\n  font-size: 24px;\\\\n  font-weight: 600;\\\\n  color: #303133;\\\\n}\\\\n\\\\n.chain-info {\\\\n  display: flex;\\\\n  gap: 10px;\\\\n}\\\\n\\\\n.header-right {\\\\n  display: flex;\\\\n  gap: 10px;\\\\n}\\\\n\\\\n.chain-tabs {\\\\n  margin-top: 20px;\\\\n}\\\\n\\\\n.filter-bar {\\\\n  display: flex;\\\\n  gap: 10px;\\\\n  margin-bottom: 20px;\\\\n  flex-wrap: wrap;\\\\n}\\\\n\\\\n.filter-bar .el-input,\\\\n.filter-bar .el-select {\\\\n  width: 200px;\\\\n}\\\\n\\\\n.stores-view,\\\\n.employees-view,\\\\n.inventory-view,\\\\n.stats-view {\\\\n  padding: 20px 0;\\\\n}\\\\n\\\\n.manager-info,\\\\n.employee-info {\\\\n  display: flex;\\\\n  align-items: center;\\\\n  gap: 10px;\\\\n}\\\\n\\\\n.employee-detail {\\\\n  display: flex;\\\\n  flex-direction: column;\\\\n}\\\\n\\\\n.employee-name {\\\\n  font-weight: 600;\\\\n  color: #303133;\\\\n}\\\\n\\\\n.employee-phone {\\\\n  font-size: 12px;\\\\n  color: #909399;\\\\n}\\\\n\\\\n.inventory-normal {\\\\n  color: #67C23A;\\\\n  font-weight: 600;\\\\n}\\\\n\\\\n.inventory-warning {\\\\n  color: #E6A23C;\\\\n  font-weight: 600;\\\\n}\\\\n\\\\n.inventory-out-of-stock {\\\\n  color: #F56C6C;\\\\n  font-weight: 600;\\\\n}\\\\n\\\\n.stat-card {\\\\n  margin-bottom: 20px;\\\\n}\\\\n\\\\n.stat-content {\\\\n  display: flex;\\\\n  align-items: center;\\\\n  gap: 20px;\\\\n}\\\\n\\\\n.stat-icon {\\\\n  width: 60px;\\\\n  height: 60px;\\\\n  border-radius: 10px;\\\\n  display: flex;\\\\n  align-items: center;\\\\n  justify-content: center;\\\\n  color: white;\\\\n  font-size: 24px;\\\\n}\\\\n\\\\n.stat-info {\\\\n  flex: 1;\\\\n}\\\\n\\\\n.stat-value {\\\\n  font-size: 28px;\\\\n  font-weight: 600;\\\\n  color: #303133;\\\\n  margin-bottom: 5px;\\\\n}\\\\n\\\\n.stat-label {\\\\n  font-size: 14px;\\\\n  color: #909399;\\\\n}\\\\n\\\\n.chart-card {\\\\n  margin-bottom: 20px;\\\\n}\\\\n\\\\n.card-header {\\\\n  font-size: 16px;\\\\n  font-weight: 600;\\\\n  color: #303133;\\\\n}\\\\n\\\\n.el-pagination {\\\\n  margin-top: 20px;\\\\n  display: flex;\\\\n  justify-content: center;\\\\n}\\\\n</style>\\\\n\",\"originAcceptText\":\"<template>\\n  <div class=\\\"chain-management\\\">\\n    <div class=\\\"chain-header\\\">\\n      <div class=\\\"header-left\\\">\\n        <h2 class=\\\"chain-title\\\">连锁管理</h2>\\n        <div class=\\\"chain-info\\\">\\n          <el-tag type=\\\"info\\\" size=\\\"small\\\">\\n            <el-icon><Shop /></el-icon>\\n            门店总数: {{ stores.length }}\\n          </el-tag>\\n          <el-tag type=\\\"success\\\" size=\\\"small\\\">\\n            <el-icon><User /></el-icon>\\n            员工总数: {{ employees.length }}\\n          </el-tag>\\n          <el-tag type=\\\"warning\\\" size=\\\"small\\\">\\n            <el-icon><Box /></el-icon>\\n            库存总数: {{ inventory.length }}\\n          </el-tag>\\n          <el-tag type=\\\"primary\\\" size=\\\"small\\\">\\n            <el-icon><Money /></el-icon>\\n            总营业额: {{ formatNumber(totalRevenue) }}\\n          </el-tag>\\n        </div>\\n      </div>\\n      <div class=\\\"header-right\\\">\\n        <el-button type=\\\"primary\\\" :icon=\\\"Plus\\\" @click=\\\"handleAddStore\\\" v-if=\\\"activeTab === 'stores'\\\">\\n          新增门店\\n        </el-button>\\n        <el-button type=\\\"primary\\\" :icon=\\\"Plus\\\" @click=\\\"handleAddEmployee\\\" v-if=\\\"activeTab === 'employees'\\\">\\n          新增员工\\n        </el-button>\\n        <el-button type=\\\"primary\\\" :icon=\\\"Plus\\\" @click=\\\"handleRestock({} as any)\\\" v-if=\\\"activeTab === 'inventory'\\\">\\n          补货\\n        </el-button>\\n      </div>\\n    </div>\\n\\n    <el-tabs v-model=\\\"activeTab\\\" class=\\\"chain-tabs\\\" @tab-change=\\\"handleTabChange\\\">\\n      <el-tab-pane label=\\\"门店管理\\\" name=\\\"stores\\\">\\n        <div class=\\\"stores-view\\\">\\n          <div class=\\\"filter-bar\\\">\\n            <el-input\\n              v-model=\\\"storeFilter.search\\\"\\n              placeholder=\\\"搜索门店名称、编号、地址\\\"\\n              :prefix-icon=\\\"Search\\\"\\n              clearable\\n              @keyup.enter=\\\"handleStoreSearch\\\"\\n            />\\n            <el-select v-model=\\\"storeFilter.status\\\" placeholder=\\\"门店状态\\\" clearable>\\n              <el-option label=\\\"营业中\\\" :value=\\\"StoreStatus.OPEN\\\" />\\n              <el-option label=\\\"休息中\\\" :value=\\\"StoreStatus.CLOSED\\\" />\\n              <el-option label=\\\"已关闭\\\" :value=\\\"StoreStatus.MAINTENANCE\\\" />\\n            </el-select>\\n            <el-select v-model=\\\"storeFilter.type\\\" placeholder=\\\"门店类型\\\" clearable>\\n              <el-option label=\\\"直营店\\\" :value=\\\"StoreType.DIRECT\\\" />\\n              <el-option label=\\\"加盟店\\\" :value=\\\"StoreType.FRANCHISE\\\" />\\n            </el-select>\\n            <el-button type=\\\"primary\\\" :icon=\\\"Search\\\" @click=\\\"handleStoreSearch\\\">搜索</el-button>\\n            <el-button :icon=\\\"Refresh\\\" @click=\\\"resetStoreFilter\\\">重置</el-button>\\n          </div>\\n\\n          <el-table\\n            :data=\\\"stores\\\"\\n            v-loading=\\\"storesLoading\\\"\\n            stripe\\n            border\\n            style=\\\"width: 100%\\\"\\n          >\\n            <el-table-column prop=\\\"storeCode\\\" label=\\\"门店编号\\\" width=\\\"120\\\" />\\n            <el-table-column prop=\\\"name\\\" label=\\\"门店名称\\\" width=\\\"150\\\" />\\n            <el-table-column label=\\\"门店类型\\\" width=\\\"100\\\">\\n              <template #default=\\\"{ row }\\\">\\n                <el-tag :type=\\\"row.type === StoreType.DIRECT ? 'primary' : 'success'\\\" size=\\\"small\\\">\\n                  {{ getStoreTypeName(row.type) }}\\n                </el-tag>\\n              </template>\\n            </el-table-column>\\n            <el-table-column label=\\\"门店状态\\\" width=\\\"100\\\">\\n              <template #default=\\\"{ row }\\\">\\n                <el-tag :type=\\\"getStoreStatusType(row.status)\\\" size=\\\"small\\\">\\n                  {{ getStoreStatusName(row.status) }}\\n                </el-tag>\\n              </template>\\n            </el-table-column>\\n            <el-table-column prop=\\\"address\\\" label=\\\"地址\\\" min-width=\\\"200\\\" />\\n            <el-table-column prop=\\\"phone\\\" label=\\\"联系电话\\\" width=\\\"120\\\" />\\n            <el-table-column label=\\\"店长\\\" width=\\\"100\\\">\\n              <template #default=\\\"{ row }\\\">\\n                <div class=\\\"manager-info\\\">\\n                  <el-avatar :size=\\\"32\\\" :src=\\\"row.manager.avatar\\\" />\\n                  <span>{{ row.manager.name }}</span>\\n                </div>\\n              </template>\\n            </el-table-column>\\n            <el-table-column label=\\\"营业时间\\\" width=\\\"120\\\">\\n              <template #default=\\\"{ row }\\\">\\n                {{ row.businessHours.monday.open }} - {{ row.businessHours.monday.close }}\\n              </template>\\n            </el-table-column>\\n            <el-table-column prop=\\\"employees\\\" label=\\\"员工数\\\" width=\\\"80\\\" />\\n            <el-table-column prop=\\\"tables\\\" label=\\\"桌位数\\\" width=\\\"80\\\" />\\n            <el-table-column prop=\\\"rating\\\" label=\\\"评分\\\" width=\\\"80\\\">\\n              <template #default=\\\"{ row }\\\">\\n                <el-rate v-model=\\\"row.rating\\\" disabled show-score />\\n              </template>\\n            </el-table-column>\\n            <el-table-column prop=\\\"openingDate\\\" label=\\\"开业日期\\\" width=\\\"110\\\">\\n              <template #default=\\\"{ row }\\\">\\n                {{ formatDateTime(row.openingDate).split(' ')[0] }}\\n              </template>\\n            </el-table-column>\\n            <el-table-column label=\\\"操作\\\" width=\\\"220\\\" fixed=\\\"right\\\">\\n              <template #default=\\\"{ row }\\\">\\n                <el-button link type=\\\"primary\\\" :icon=\\\"View\\\" @click=\\\"viewStore(row)\\\">查看</el-button>\\n                <el-button link type=\\\"primary\\\" :icon=\\\"Edit\\\" @click=\\\"handleEditStore(row)\\\">编辑</el-button>\\n                <el-dropdown @command=\\\"(cmd) => handleStoreAction(cmd, row)\\\">\\n                  <el-button link type=\\\"primary\\\" :icon=\\\"MoreFilled\\\">更多</el-button>\\n                  <template #dropdown>\\n                    <el-dropdown-menu>\\n                      <el-dropdown-item command=\\\"updateStatus\\\">更新状态</el-dropdown-item>\\n                      <el-dropdown-item command=\\\"stats\\\">统计数据</el-dropdown-item>\\n                      <el-dropdown-item command=\\\"delete\\\" divided>删除</el-dropdown-item>\\n                    </el-dropdown-menu>\\n                  </template>\\n                </el-dropdown>\\n              </template>\\n            </el-table-column>\\n          </el-table>\\n\\n          <el-pagination\\n            v-model:current-page=\\\"storePagination.page\\\"\\n            v-model:page-size=\\\"storePagination.limit\\\"\\n            :total=\\\"storePagination.total\\\"\\n            :page-sizes=\\\"[10, 20, 50, 100]\\\"\\n            layout=\\\"total, sizes, prev, pager, next, jumper\\\"\\n            @current-change=\\\"handleStorePageChange\\\"\\n            @size-change=\\\"handleStorePageSizeChange\\\"\\n          />\\n        </div>\\n      </el-tab-pane>\\n\\n      <el-tab-pane label=\\\"员工管理\\\" name=\\\"employees\\\">\\n        <div class=\\\"employees-view\\\">\\n          <div class=\\\"filter-bar\\\">\\n            <el-input\\n              v-model=\\\"employeeFilter.search\\\"\\n              placeholder=\\\"搜索员工姓名、工号、手机号\\\"\\n              :prefix-icon=\\\"Search\\\"\\n              clearable\\n              @keyup.enter=\\\"handleEmployeeSearch\\\"\\n            />\\n            <el-select v-model=\\\"employeeFilter.storeId\\\" placeholder=\\\"所属门店\\\" clearable>\\n              <el-option v-for=\\\"store in stores\\\" :key=\\\"store.id\\\" :label=\\\"store.name\\\" :value=\\\"store.id\\\" />\\n            </el-select>\\n            <el-select v-model=\\\"employeeFilter.department\\\" placeholder=\\\"部门\\\" clearable>\\n              <el-option label=\\\"前厅\\\" value=\\\"前厅\\\" />\\n              <el-option label=\\\"后厨\\\" value=\\\"后厨\\\" />\\n              <el-option label=\\\"管理\\\" value=\\\"管理\\\" />\\n              <el-option label=\\\"财务\\\" value=\\\"财务\\\" />\\n            </el-select>\\n            <el-select v-model=\\\"employeeFilter.status\\\" placeholder=\\\"员工状态\\\" clearable>\\n              <el-option label=\\\"在职\\\" :value=\\\"EmployeeStatus.ACTIVE\\\" />\\n              <el-option label=\\\"离职\\\" :value=\\\"EmployeeStatus.RESIGNED\\\" />\\n              <el-option label=\\\"请假\\\" :value=\\\"EmployeeStatus.LEAVE\\\" />\\n            </el-select>\\n            <el-button type=\\\"primary\\\" :icon=\\\"Search\\\" @click=\\\"handleEmployeeSearch\\\">搜索</el-button>\\n            <el-button :icon=\\\"Refresh\\\" @click=\\\"resetEmployeeFilter\\\">重置</el-button>\\n          </div>\\n\\n          <el-table\\n            :data=\\\"employees\\\"\\n            v-loading=\\\"employeesLoading\\\"\\n            stripe\\n            border\\n            style=\\\"width: 100%\\\"\\n          >\\n            <el-table-column prop=\\\"employeeCode\\\" label=\\\"工号\\\" width=\\\"100\\\" />\\n            <el-table-column label=\\\"员工信息\\\" width=\\\"180\\\">\\n              <template #default=\\\"{ row }\\\">\\n                <div class=\\\"employee-info\\\">\\n                  <el-avatar :size=\\\"40\\\" :src=\\\"row.avatar\\\" />\\n                  <div class=\\\"employee-detail\\\">\\n                    <div class=\\\"employee-name\\\">{{ row.name }}</div>\\n                    <div class=\\\"employee-phone\\\">{{ row.phone }}</div>\\n                  </div>\\n                </div>\\n              </template>\\n            </el-table-column>\\n            <el-table-column prop=\\\"storeName\\\" label=\\\"所属门店\\\" width=\\\"120\\\" />\\n            <el-table-column prop=\\\"department\\\" label=\\\"部门\\\" width=\\\"80\\\" />\\n            <el-table-column prop=\\\"position\\\" label=\\\"职位\\\" width=\\\"100\\\" />\\n            <el-table-column label=\\\"员工状态\\\" width=\\\"80\\\">\\n              <template #default=\\\"{ row }\\\">\\n                <el-tag :type=\\\"getEmployeeStatusType(row.status)\\\" size=\\\"small\\\">\\n                  {{ getEmployeeStatusName(row.status) }}\\n                </el-tag>\\n              </template>\\n            </el-table-column>\\n            <el-table-column prop=\\\"hireDate\\\" label=\\\"入职日期\\\" width=\\\"110\\\">\\n              <template #default=\\\"{ row }\\\">\\n                {{ formatDateTime(row.hireDate).split(' ')[0] }}\\n              </template>\\n            </el-table-column>\\n            <el-table-column prop=\\\"salary\\\" label=\\\"薪资\\\" width=\\\"100\\\">\\n              <template #default=\\\"{ row }\\\">\\n                ¥{{ formatNumber(row.salary) }}\\n              </template>\\n            </el-table-column>\\n            <el-table-column label=\\\"操作\\\" width=\\\"220\\\" fixed=\\\"right\\\">\\n              <template #default=\\\"{ row }\\\">\\n                <el-button link type=\\\"primary\\\" :icon=\\\"View\\\" @click=\\\"viewEmployee(row)\\\">查看</el-button>\\n                <el-button link type=\\\"primary\\\" :icon=\\\"Edit\\\" @click=\\\"handleEditEmployee(row)\\\">编辑</el-button>\\n                <el-dropdown @command=\\\"(cmd) => handleEmployeeAction(cmd, row)\\\">\\n                  <el-button link type=\\\"primary\\\" :icon=\\\"MoreFilled\\\">更多</el-button>\\n                  <template #dropdown>\\n                    <el-dropdown-item command=\\\"transfer\\\">调店</el-dropdown-item>\\n                    <el-dropdown-item command=\\\"performance\\\">绩效</el-dropdown-item>\\n                    <el-dropdown-item command=\\\"permissions\\\">权限</el-dropdown-item>\\n                    <el-dropdown-item command=\\\"delete\\\" divided>删除</el-dropdown-item>\\n                  </el-dropdown-menu>\\n                  </template>\\n                </el-dropdown>\\n              </template>\\n            </el-table-column>\\n          </el-table>\\n\\n          <el-pagination\\n            v-model:current-page=\\\"employeePagination.page\\\"\\n            v-model:page-size=\\\"employeePagination.limit\\\"\\n            :total=\\\"employeePagination.total\\\"\\n            :page-sizes=\\\"[10, 20, 50, 100]\\\"\\n            layout=\\\"total, sizes, prev, pager, next, jumper\\\"\\n            @current-change=\\\"handleEmployeePageChange\\\"\\n            @size-change=\\\"handleEmployeePageSizeChange\\\"\\n          />\\n        </div>\\n      </el-tab-pane>\\n\\n      <el-tab-pane label=\\\"库存管理\\\" name=\\\"inventory\\\">\\n        <div class=\\\"inventory-view\\\">\\n          <div class=\\\"filter-bar\\\">\\n            <el-input\\n              v-model=\\\"inventoryFilter.search\\\"\\n              placeholder=\\\"搜索商品名称、编码\\\"\\n              :prefix-icon=\\\"Search\\\"\\n              clearable\\n              @keyup.enter=\\\"handleInventorySearch\\\"\\n            />\\n            <el-select v-model=\\\"inventoryFilter.storeId\\\" placeholder=\\\"所属门店\\\" clearable>\\n              <el-option v-for=\\\"store in stores\\\" :key=\\\"store.id\\\" :label=\\\"store.name\\\" :value=\\\"store.id\\\" />\\n            </el-select>\\n            <el-select v-model=\\\"inventoryFilter.category\\\" placeholder=\\\"商品分类\\\" clearable>\\n              <el-option label=\\\"食材\\\" value=\\\"食材\\\" />\\n              <el-option label=\\\"调料\\\" value=\\\"调料\\\" />\\n              <el-option label=\\\"饮品\\\" value=\\\"饮品\\\" />\\n              <el-option label=\\\"餐具\\\" value=\\\"餐具\\\" />\\n              <el-option label=\\\"其他\\\" value=\\\"其他\\\" />\\n            </el-select>\\n            <el-select v-model=\\\"inventoryFilter.status\\\" placeholder=\\\"库存状态\\\" clearable>\\n              <el-option label=\\\"充足\\\" :value=\\\"InventoryStatus.NORMAL\\\" />\\n              <el-option label=\\\"预警\\\" :value=\\\"InventoryStatus.WARNING\\\" />\\n              <el-option label=\\\"缺货\\\" :value=\\\"InventoryStatus.OUT_OF_STOCK\\\" />\\n            </el-select>\\n            <el-button type=\\\"primary\\\" :icon=\\\"Search\\\" @click=\\\"handleInventorySearch\\\">搜索</el-button>\\n            <el-button :icon=\\\"Refresh\\\" @click=\\\"resetInventoryFilter\\\">重置</el-button>\\n          </div>\\n\\n          <el-table\\n            :data=\\\"inventory\\\"\\n            v-loading=\\\"inventoryLoading\\\"\\n            stripe\\n            border\\n            style=\\\"width: 100%\\\"\\n          >\\n            <el-table-column prop=\\\"productCode\\\" label=\\\"商品编码\\\" width=\\\"120\\\" />\\n            <el-table-column prop=\\\"productName\\\" label=\\\"商品名称\\\" width=\\\"150\\\" />\\n            <el-table-column prop=\\\"category\\\" label=\\\"分类\\\" width=\\\"80\\\" />\\n            <el-table-column prop=\\\"storeName\\\" label=\\\"所属门店\\\" width=\\\"120\\\" />\\n            <el-table-column label=\\\"库存数量\\\" width=\\\"100\\\">\\n              <template #default=\\\"{ row }\\\">\\n                <span :class=\\\"getInventoryClass(row.status)\\\">{{ row.quantity }} {{ row.unit }}</span>\\n              </template>\\n            </el-table-column>\\n            <el-table-column prop=\\\"minQuantity\\\" label=\\\"最小库存\\\" width=\\\"100\\\" />\\n            <el-table-column prop=\\\"maxQuantity\\\" label=\\\"最大库存\\\" width=\\\"100\\\" />\\n            <el-table-column prop=\\\"costPrice\\\" label=\\\"成本价\\\" width=\\\"100\\\">\\n              <template #default=\\\"{ row }\\\">\\n                ¥{{ formatNumber(row.costPrice) }}\\n              </template>\\n            </el-table-column>\\n            <el-table-column label=\\\"库存状态\\\" width=\\\"80\\\">\\n              <template #default=\\\"{ row }\\\">\\n                <el-tag :type=\\\"getInventoryStatusType(row.status)\\\" size=\\\"small\\\">\\n                  {{ getInventoryStatusName(row.status) }}\\n                </el-tag>\\n              </template>\\n            </el-table-column>\\n            <el-table-column prop=\\\"location\\\" label=\\\"存放位置\\\" width=\\\"120\\\" />\\n            <el-table-column prop=\\\"expiryDate\\\" label=\\\"过期日期\\\" width=\\\"110\\\">\\n              <template #default=\\\"{ row }\\\">\\n                {{ row.expiryDate ? formatDateTime(row.expiryDate).split(' ')[0] : '-' }}\\n              </template>\\n            </el-table-column>\\n            <el-table-column label=\\\"操作\\\" width=\\\"220\\\" fixed=\\\"right\\\">\\n              <template #default=\\\"{ row }\\\">\\n                <el-button link type=\\\"primary\\\" :icon=\\\"View\\\" @click=\\\"viewInventory(row)\\\">查看</el-button>\\n                <el-button link type=\\\"primary\\\" :icon=\\\"Plus\\\" @click=\\\"handleRestock(row)\\\">补货</el-button>\\n                <el-dropdown @command=\\\"(cmd) => handleInventoryAction(cmd, row)\\\">\\n                  <el-button link type=\\\"primary\\\" :icon=\\\"MoreFilled\\\">更多</el-button>\\n                  <template #dropdown>\\n                    <el-dropdown-item command=\\\"transfer\\\">调拨</el-dropdown-item>\\n                    <el-dropdown-item command=\\\"check\\\">盘点</el-dropdown-item>\\n                  </el-dropdown-menu>\\n                  </template>\\n                </el-dropdown>\\n              </template>\\n            </el-table-column>\\n          </el-table>\\n\\n          <el-pagination\\n            v-model:current-page=\\\"inventoryPagination.page\\\"\\n            v-model:page-size=\\\"inventoryPagination.limit\\\"\\n            :total=\\\"inventoryPagination.total\\\"\\n            :page-sizes=\\\"[10, 20, 50, 100]\\\"\\n            layout=\\\"total, sizes, prev, pager, next, jumper\\\"\\n            @current-change=\\\"handleInventoryPageChange\\\"\\n            @size-change=\\\"handleInventoryPageSizeChange\\\"\\n          />\\n        </div>\\n      </el-tab-pane>\\n\\n      <el-tab-pane label=\\\"数据统计\\\" name=\\\"stats\\\">\\n        <div class=\\\"stats-view\\\">\\n          <el-row :gutter=\\\"20\\\">\\n            <el-col :xs=\\\"24\\\" :sm=\\\"12\\\" :md=\\\"8\\\" :lg=\\\"6\\\">\\n              <el-card class=\\\"stat-card\\\">\\n                <div class=\\\"stat-content\\\">\\n                  <div class=\\\"stat-icon\\\" style=\\\"background: #409EFF\\\">\\n                    <el-icon><Shop /></el-icon>\\n                  </div>\\n                  <div class=\\\"stat-info\\\">\\n                    <div class=\\\"stat-value\\\">{{ stores.length }}</div>\\n                    <div class=\\\"stat-label\\\">门店总数</div>\\n                  </div>\\n                </div>\\n              </el-card>\\n            </el-col>\\n            <el-col :xs=\\\"24\\\" :sm=\\\"12\\\" :md=\\\"8\\\" :lg=\\\"6\\\">\\n              <el-card class=\\\"stat-card\\\">\\n                <div class=\\\"stat-content\\\">\\n                  <div class=\\\"stat-icon\\\" style=\\\"background: #67C23A\\\">\\n                    <el-icon><User /></el-icon>\\n                  </div>\\n                  <div class=\\\"stat-info\\\">\\n                    <div class=\\\"stat-value\\\">{{ employees.length }}</div>\\n                    <div class=\\\"stat-label\\\">员工总数</div>\\n                  </div>\\n                </div>\\n              </el-card>\\n            </el-col>\\n            <el-col :xs=\\\"24\\\" :sm=\\\"12\\\" :md=\\\"8\\\" :lg=\\\"6\\\">\\n              <el-card class=\\\"stat-card\\\">\\n                <div class=\\\"stat-content\\\">\\n                  <div class=\\\"stat-icon\\\" style=\\\"background: #E6A23C\\\">\\n                    <el-icon><Box /></el-icon>\\n                  </div>\\n                  <div class=\\\"stat-info\\\">\\n                    <div class=\\\"stat-value\\\">{{ inventory.length }}</div>\\n                    <div class=\\\"stat-label\\\">库存总数</div>\\n                  </div>\\n                </div>\\n              </el-card>\\n            </el-col>\\n            <el-col :xs=\\\"24\\\" :sm=\\\"12\\\" :md=\\\"8\\\" :lg=\\\"6\\\">\\n              <el-card class=\\\"stat-card\\\">\\n                <div class=\\\"stat-content\\\">\\n                  <div class=\\\"stat-icon\\\" style=\\\"background: #F56C6C\\\">\\n                    <el-icon><Money /></el-icon>\\n                  </div>\\n                  <div class=\\\"stat-info\\\">\\n                    <div class=\\\"stat-value\\\">{{ formatNumber(totalRevenue) }}</div>\\n                    <div class=\\\"stat-label\\\">总营业额</div>\\n                  </div>\\n                </div>\\n              </el-card>\\n            </el-col>\\n          </el-row>\\n\\n          <el-row :gutter=\\\"20\\\" style=\\\"margin-top: 20px\\\">\\n            <el-col :xs=\\\"24\\\" :lg=\\\"12\\\">\\n              <el-card class=\\\"chart-card\\\">\\n                <template #header>\\n                  <div class=\\\"card-header\\\">\\n                    <span>门店营收对比</span>\\n                  </div>\\n                </template>\\n                <div ref=\\\"revenueChartRef\\\" style=\\\"height: 400px\\\"></div>\\n              </el-card>\\n            </el-col>\\n            <el-col :xs=\\\"24\\\" :lg=\\\"12\\\">\\n              <el-card class=\\\"chart-card\\\">\\n                <template #header>\\n                  <div class=\\\"card-header\\\">\\n                    <span>员工绩效排名</span>\\n                  </div>\\n                </template>\\n                <div ref=\\\"performanceChartRef\\\" style=\\\"height: 400px\\\"></div>\\n              </el-card>\\n            </el-col>\\n          </el-row>\\n        </div>\\n      </el-tab-pane>\\n    </el-tabs>\\n\\n    <el-dialog\\n      v-model=\\\"showStoreDialog\\\"\\n      :title=\\\"storeDialogType === 'create' ? '新增门店' : '编辑门店'\\\"\\n      width=\\\"800px\\\"\\n      :close-on-click-modal=\\\"false\\\"\\n    >\\n      <el-form :model=\\\"storeForm\\\" label-width=\\\"120px\\\">\\n        <el-form-item label=\\\"门店编号\\\" prop=\\\"storeCode\\\">\\n          <el-input v-model=\\\"storeForm.storeCode\\\" placeholder=\\\"请输入门店编号\\\" :disabled=\\\"storeDialogType === 'edit'\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"门店名称\\\" prop=\\\"name\\\">\\n          <el-input v-model=\\\"storeForm.name\\\" placeholder=\\\"请输入门店名称\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"门店类型\\\" prop=\\\"type\\\">\\n          <el-radio-group v-model=\\\"storeForm.type\\\">\\n            <el-radio :label=\\\"StoreType.DIRECT\\\">直营店</el-radio>\\n            <el-radio :label=\\\"StoreType.FRANCHISE\\\">加盟店</el-radio>\\n          </el-radio-group>\\n        </el-form-item>\\n        <el-form-item label=\\\"门店状态\\\" prop=\\\"status\\\">\\n          <el-radio-group v-model=\\\"storeForm.status\\\">\\n            <el-radio :label=\\\"StoreStatus.OPEN\\\">营业中</el-radio>\\n            <el-radio :label=\\\"StoreStatus.CLOSED\\\">休息中</el-radio>\\n            <el-radio :label=\\\"StoreStatus.MAINTENANCE\\\">已关闭</el-radio>\\n          </el-radio-group>\\n        </el-form-item>\\n        <el-form-item label=\\\"门店地址\\\" prop=\\\"address\\\">\\n          <el-input v-model=\\\"storeForm.address\\\" placeholder=\\\"请输入门店地址\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"所在城市\\\" prop=\\\"city\\\">\\n          <el-input v-model=\\\"storeForm.city\\\" placeholder=\\\"请输入所在城市\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"所在区县\\\" prop=\\\"district\\\">\\n          <el-input v-model=\\\"storeForm.district\\\" placeholder=\\\"请输入所在区县\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"联系电话\\\" prop=\\\"phone\\\">\\n          <el-input v-model=\\\"storeForm.phone\\\" placeholder=\\\"请输入联系电话\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"邮箱\\\" prop=\\\"email\\\">\\n          <el-input v-model=\\\"storeForm.email\\\" placeholder=\\\"请输入邮箱\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"店长\\\" prop=\\\"managerId\\\">\\n          <el-select v-model=\\\"storeForm.managerId\\\" placeholder=\\\"请选择店长\\\">\\n            <el-option v-for=\\\"employee in employees\\\" :key=\\\"employee.id\\\" :label=\\\"employee.name\\\" :value=\\\"employee.id\\\" />\\n          </el-select>\\n        </el-form-item>\\n        <el-form-item label=\\\"营业时间\\\" prop=\\\"businessHours\\\">\\n          <el-row :gutter=\\\"10\\\">\\n            <el-col :span=\\\"3\\\">周一</el-col>\\n            <el-col :span=\\\"9\\\">\\n              <el-time-picker v-model=\\\"storeForm.businessHours.monday.open\\\" placeholder=\\\"开门时间\\\" format=\\\"HH:mm\\\" />\\n            </el-col>\\n            <el-col :span=\\\"9\\\">\\n              <el-time-picker v-model=\\\"storeForm.businessHours.monday.close\\\" placeholder=\\\"关门时间\\\" format=\\\"HH:mm\\\" />\\n            </el-col>\\n            <el-col :span=\\\"3\\\">\\n              <el-switch v-model=\\\"storeForm.businessHours.monday.enabled\\\" />\\n            </el-col>\\n          </el-row>\\n        </el-form-item>\\n        <el-form-item label=\\\"门店面积\\\" prop=\\\"area\\\">\\n          <el-input-number v-model=\\\"storeForm.area\\\" :min=\\\"1\\\" :max=\\\"10000\\\" />\\n          <span style=\\\"margin-left: 10px\\\">平方米</span>\\n        </el-form-item>\\n        <el-form-item label=\\\"最大容量\\\" prop=\\\"capacity\\\">\\n          <el-input-number v-model=\\\"storeForm.capacity\\\" :min=\\\"1\\\" :max=\\\"1000\\\" />\\n          <span style=\\\"margin-left: 10px\\\">人</span>\\n        </el-form-item>\\n        <el-form-item label=\\\"桌位数量\\\" prop=\\\"tables\\\">\\n          <el-input-number v-model=\\\"storeForm.tables\\\" :min=\\\"1\\\" :max=\\\"500\\\" />\\n          <span style=\\\"margin-left: 10px\\\">个</span>\\n        </el-form-item>\\n        <el-form-item label=\\\"开业日期\\\" prop=\\\"openingDate\\\">\\n          <el-date-picker v-model=\\\"storeForm.openingDate\\\" type=\\\"date\\\" placeholder=\\\"请选择开业日期\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"门店描述\\\" prop=\\\"description\\\">\\n          <el-input v-model=\\\"storeForm.description\\\" type=\\\"textarea\\\" :rows=\\\"3\\\" placeholder=\\\"请输入门店描述\\\" />\\n        </el-form-item>\\n      </el-form>\\n      <template #footer>\\n        <el-button @click=\\\"showStoreDialog = false\\\">取消</el-button>\\n        <el-button type=\\\"primary\\\" @click=\\\"confirmStore\\\">确定</el-button>\\n      </template>\\n    </el-dialog>\\n\\n    <el-dialog\\n      v-model=\\\"showEmployeeDialog\\\"\\n      :title=\\\"employeeDialogType === 'create' ? '新增员工' : '编辑员工'\\\"\\n      width=\\\"800px\\\"\\n      :close-on-click-modal=\\\"false\\\"\\n    >\\n      <el-form :model=\\\"employeeForm\\\" label-width=\\\"120px\\\">\\n        <el-form-item label=\\\"工号\\\" prop=\\\"employeeCode\\\">\\n          <el-input v-model=\\\"employeeForm.employeeCode\\\" placeholder=\\\"请输入工号\\\" :disabled=\\\"employeeDialogType === 'edit'\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"姓名\\\" prop=\\\"name\\\">\\n          <el-input v-model=\\\"employeeForm.name\\\" placeholder=\\\"请输入姓名\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"性别\\\" prop=\\\"gender\\\">\\n          <el-radio-group v-model=\\\"employeeForm.gender\\\">\\n            <el-radio label=\\\"male\\\">男</el-radio>\\n            <el-radio label=\\\"female\\\">女</el-radio>\\n            <el-radio label=\\\"other\\\">其他</el-radio>\\n          </el-radio-group>\\n        </el-form-item>\\n        <el-form-item label=\\\"手机号\\\" prop=\\\"phone\\\">\\n          <el-input v-model=\\\"employeeForm.phone\\\" placeholder=\\\"请输入手机号\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"邮箱\\\" prop=\\\"email\\\">\\n          <el-input v-model=\\\"employeeForm.email\\\" placeholder=\\\"请输入邮箱\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"所属门店\\\" prop=\\\"storeId\\\">\\n          <el-select v-model=\\\"employeeForm.storeId\\\" placeholder=\\\"请选择所属门店\\\">\\n            <el-option v-for=\\\"store in stores\\\" :key=\\\"store.id\\\" :label=\\\"store.name\\\" :value=\\\"store.id\\\" />\\n          </el-select>\\n        </el-form-item>\\n        <el-form-item label=\\\"部门\\\" prop=\\\"department\\\">\\n          <el-select v-model=\\\"employeeForm.department\\\" placeholder=\\\"请选择部门\\\">\\n            <el-option label=\\\"前厅\\\" value=\\\"前厅\\\" />\\n            <el-option label=\\\"后厨\\\" value=\\\"后厨\\\" />\\n            <el-option label=\\\"管理\\\" value=\\\"管理\\\" />\\n            <el-option label=\\\"财务\\\" value=\\\"财务\\\" />\\n          </el-select>\\n        </el-form-item>\\n        <el-form-item label=\\\"职位\\\" prop=\\\"position\\\">\\n          <el-input v-model=\\\"employeeForm.position\\\" placeholder=\\\"请输入职位\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"员工状态\\\" prop=\\\"status\\\">\\n          <el-radio-group v-model=\\\"employeeForm.status\\\">\\n            <el-radio :label=\\\"EmployeeStatus.ACTIVE\\\">在职</el-radio>\\n            <el-radio :label=\\\"EmployeeStatus.RESIGNED\\\">离职</el-radio>\\n            <el-radio :label=\\\"EmployeeStatus.LEAVE\\\">请假</el-radio>\\n          </el-radio-group>\\n        </el-form-item>\\n        <el-form-item label=\\\"入职日期\\\" prop=\\\"hireDate\\\">\\n          <el-date-picker v-model=\\\"employeeForm.hireDate\\\" type=\\\"date\\\" placeholder=\\\"请选择入职日期\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"薪资\\\" prop=\\\"salary\\\">\\n          <el-input-number v-model=\\\"employeeForm.salary\\\" :min=\\\"0\\\" :max=\\\"100000\\\" :precision=\\\"2\\\" />\\n          <span style=\\\"margin-left: 10px\\\">元</span>\\n        </el-form-item>\\n        <el-form-item label=\\\"地址\\\" prop=\\\"address\\\">\\n          <el-input v-model=\\\"employeeForm.address\\\" placeholder=\\\"请输入地址\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"身份证号\\\" prop=\\\"idCard\\\">\\n          <el-input v-model=\\\"employeeForm.idCard\\\" placeholder=\\\"请输入身份证号\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"银行账号\\\" prop=\\\"bankAccount\\\">\\n          <el-input v-model=\\\"employeeForm.bankAccount\\\" placeholder=\\\"请输入银行账号\\\" />\\n        </el-form-item>\\n      </el-form>\\n      <template #footer>\\n        <el-button @click=\\\"showEmployeeDialog = false\\\">取消</el-button>\\n        <el-button type=\\\"primary\\\" @click=\\\"confirmEmployee\\\">确定</el-button>\\n      </template>\\n    </el-dialog>\\n\\n    <el-dialog\\n      v-model=\\\"showTransferDialog\\\"\\n      title=\\\"员工调店\\\"\\n      width=\\\"600px\\\"\\n      :close-on-click-modal=\\\"false\\\"\\n    >\\n      <el-form :model=\\\"transferForm\\\" label-width=\\\"120px\\\">\\n        <el-form-item label=\\\"目标门店\\\" prop=\\\"targetStoreId\\\">\\n          <el-select v-model=\\\"transferForm.targetStoreId\\\" placeholder=\\\"请选择目标门店\\\">\\n            <el-option v-for=\\\"store in stores\\\" :key=\\\"store.id\\\" :label=\\\"store.name\\\" :value=\\\"store.id\\\" />\\n          </el-select>\\n        </el-form-item>\\n        <el-form-item label=\\\"调动原因\\\" prop=\\\"reason\\\">\\n          <el-input v-model=\\\"transferForm.reason\\\" type=\\\"textarea\\\" :rows=\\\"3\\\" placeholder=\\\"请输入调动原因\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"生效日期\\\" prop=\\\"effectiveDate\\\">\\n          <el-date-picker v-model=\\\"transferForm.effectiveDate\\\" type=\\\"date\\\" placeholder=\\\"请选择生效日期\\\" />\\n        </el-form-item>\\n      </el-form>\\n      <template #footer>\\n        <el-button @click=\\\"showTransferDialog = false\\\">取消</el-button>\\n        <el-button type=\\\"primary\\\" @click=\\\"confirmTransfer\\\">确定</el-button>\\n      </template>\\n    </el-dialog>\\n\\n    <el-dialog\\n      v-model=\\\"showRestockDialog\\\"\\n      title=\\\"库存补货\\\"\\n      width=\\\"600px\\\"\\n      :close-on-click-modal=\\\"false\\\"\\n    >\\n      <el-form :model=\\\"restockForm\\\" label-width=\\\"120px\\\">\\n        <el-form-item label=\\\"补货数量\\\" prop=\\\"quantity\\\">\\n          <el-input-number v-model=\\\"restockForm.quantity\\\" :min=\\\"1\\\" :max=\\\"10000\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"补货单价\\\" prop=\\\"costPrice\\\">\\n          <el-input-number v-model=\\\"restockForm.costPrice\\\" :min=\\\"0\\\" :max=\\\"100000\\\" :precision=\\\"2\\\" />\\n          <span style=\\\"margin-left: 10px\\\">元</span>\\n        </el-form-item>\\n        <el-form-item label=\\\"供应商\\\" prop=\\\"supplier\\\">\\n          <el-input v-model=\\\"restockForm.supplier.name\\\" placeholder=\\\"请输入供应商名称\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"批次号\\\" prop=\\\"batchNumber\\\">\\n          <el-input v-model=\\\"restockForm.batchNumber\\\" placeholder=\\\"请输入批次号\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"过期日期\\\" prop=\\\"expiryDate\\\">\\n          <el-date-picker v-model=\\\"restockForm.expiryDate\\\" type=\\\"date\\\" placeholder=\\\"请选择过期日期\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"备注\\\" prop=\\\"remarks\\\">\\n          <el-input v-model=\\\"restockForm.remarks\\\" type=\\\"textarea\\\" :rows=\\\"3\\\" placeholder=\\\"请输入备注\\\" />\\n        </el-form-item>\\n      </el-form>\\n      <template #footer>\\n        <el-button @click=\\\"showRestockDialog = false\\\">取消</el-button>\\n        <el-button type=\\\"primary\\\" @click=\\\"confirmRestock\\\">确定</el-button>\\n      </template>\\n    </el-dialog>\\n  </div>\\n</template>\\n\\n<script setup lang=\\\"ts\\\">\\nimport { ref, computed, onMounted, nextTick } from 'vue'\\nimport { useChain } from '@/composables/useChain'\\nimport { StoreType, StoreStatus, EmployeeStatus, InventoryStatus } from '@/api/chain'\\nimport { Shop, User, Box, Money, Plus, Search, Refresh, View, Edit, MoreFilled } from '@element-plus/icons-vue'\\nimport * as echarts from 'echarts'\\n\\nconst {\\n  loading,\\n  activeTab,\\n  stores,\\n  employees,\\n  inventory,\\n  storeStats,\\n  employeePerformance,\\n  selectedStore,\\n  selectedEmployee,\\n  selectedInventory,\\n  showStoreDialog,\\n  showEmployeeDialog,\\n  showTransferDialog,\\n  showRestockDialog,\\n  showTransferInventoryDialog,\\n  showCheckDialog,\\n  storeDialogType,\\n  employeeDialogType,\\n  storeForm,\\n  employeeForm,\\n  transferForm,\\n  restockForm,\\n  transferInventoryForm,\\n  checkForm,\\n  storePagination,\\n  employeePagination,\\n  inventoryPagination,\\n  storeFilter,\\n  employeeFilter,\\n  inventoryFilter,\\n  storesLoading,\\n  employeesLoading,\\n  inventoryLoading,\\n  statsLoading,\\n  loadStores,\\n  loadEmployees,\\n  loadInventory,\\n  loadStoreStats,\\n  loadEmployeePerformance,\\n  handleAddStore,\\n  handleEditStore,\\n  handleDeleteStore,\\n  handleUpdateStoreStatus,\\n  confirmStore,\\n  handleAddEmployee,\\n  handleEditEmployee,\\n  handleDeleteEmployee,\\n  handleTransferEmployee,\\n  confirmTransfer,\\n  confirmEmployee,\\n  handleRestock,\\n  confirmRestock,\\n  handleTransferInventory,\\n  confirmTransferInventory,\\n  handleCheckInventory,\\n  confirmCheck,\\n  handleStoreSearch,\\n  resetStoreFilter,\\n  handleEmployeeSearch,\\n  resetEmployeeFilter,\\n  handleInventorySearch,\\n  resetInventoryFilter,\\n  handleStorePageChange,\\n  handleStorePageSizeChange,\\n  handleEmployeePageChange,\\n  handleEmployeePageSizeChange,\\n  handleInventoryPageChange,\\n  handleInventoryPageSizeChange,\\n  handleTabChange,\\n  formatNumber,\\n  formatDateTime,\\n  getStoreTypeName,\\n  getStoreStatusName,\\n  getStoreStatusType,\\n  getEmployeeStatusName,\\n  getEmployeeStatusType,\\n  getInventoryStatusName,\\n  getInventoryStatusType\\n} = useChain()\\n\\nconst revenueChartRef = ref<HTMLElement>()\\nconst performanceChartRef = ref<HTMLElement>()\\n\\nconst totalRevenue = computed(() => {\\n  return storeStats.reduce((sum, stat) => sum + stat.totalRevenue, 0)\\n})\\n\\nconst viewStore = (store: any) => {\\n  console.log('查看门店:', store)\\n}\\n\\nconst viewEmployee = (employee: any) => {\\n  console.log('查看员工:', employee)\\n}\\n\\nconst viewInventory = (inventoryItem: any) => {\\n  console.log('查看库存:', inventoryItem)\\n}\\n\\nconst handleStoreAction = (command: string, store: any) => {\\n  switch (command) {\\n    case 'updateStatus':\\n      handleUpdateStoreStatus(store, store.status === StoreStatus.OPEN ? StoreStatus.CLOSED : StoreStatus.OPEN)\\n      break\\n    case 'stats':\\n      console.log('查看统计数据:', store)\\n      break\\n    case 'delete':\\n      handleDeleteStore(store)\\n      break\\n  }\\n}\\n\\nconst handleEmployeeAction = (command: string, employee: any) => {\\n  switch (command) {\\n    case 'transfer':\\n      handleTransferEmployee(employee)\\n      break\\n    case 'performance':\\n      console.log('查看绩效:', employee)\\n      break\\n    case 'permissions':\\n      console.log('查看权限:', employee)\\n      break\\n    case 'delete':\\n      handleDeleteEmployee(employee)\\n      break\\n  }\\n}\\n\\nconst handleInventoryAction = (command: string, inventoryItem: any) => {\\n  switch (command) {\\n    case 'transfer':\\n      handleTransferInventory(inventoryItem)\\n      break\\n    case 'check':\\n      handleCheckInventory(inventoryItem.storeId)\\n      break\\n  }\\n}\\n\\nconst getInventoryClass = (status: InventoryStatus) => {\\n  switch (status) {\\n    case InventoryStatus.NORMAL:\\n      return 'inventory-normal'\\n    case InventoryStatus.WARNING:\\n      return 'inventory-warning'\\n    case InventoryStatus.OUT_OF_STOCK:\\n      return 'inventory-out-of-stock'\\n    default:\\n      return ''\\n  }\\n}\\n\\nconst initCharts = () => {\\n  if (revenueChartRef.value) {\\n    const revenueChart = echarts.init(revenueChartRef.value)\\n    revenueChart.setOption({\\n      title: {\\n        text: '门店营收对比'\\n      },\\n      tooltip: {\\n        trigger: 'axis'\\n      },\\n      xAxis: {\\n        type: 'category',\\n        data: storeStats.map(stat => stat.storeName)\\n      },\\n      yAxis: {\\n        type: 'value',\\n        name: '营收（元）'\\n      },\\n      series: [\\n        {\\n          name: '营收',\\n          type: 'bar',\\n          data: storeStats.map(stat => stat.totalRevenue),\\n          itemStyle: {\\n            color: '#409EFF'\\n          }\\n        }\\n      ]\\n    })\\n  }\\n\\n  if (performanceChartRef.value) {\\n    const performanceChart = echarts.init(performanceChartRef.value)\\n    performanceChart.setOption({\\n      title: {\\n        text: '员工绩效排名'\\n      },\\n      tooltip: {\\n        trigger: 'axis'\\n      },\\n      xAxis: {\\n        type: 'category',\\n        data: employeePerformance.slice(0, 10).map(emp => emp.employeeName)\\n      },\\n      yAxis: {\\n        type: 'value',\\n        name: '绩效评分'\\n      },\\n      series: [\\n        {\\n          name: '绩效评分',\\n          type: 'bar',\\n          data: employeePerformance.slice(0, 10).map(emp => emp.performanceScore),\\n          itemStyle: {\\n            color: '#67C23A'\\n          }\\n        }\\n      ]\\n    })\\n  }\\n}\\n\\nonMounted(async () => {\\n  await loadStores()\\n  await loadEmployees()\\n  await loadInventory()\\n  await loadStoreStats()\\n  await loadEmployeePerformance()\\n  \\n  await nextTick()\\n  initCharts()\\n})\\n</script>\\n\\n<style scoped>\\n.chain-management {\\n  padding: 20px;\\n}\\n\\n.chain-header {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n  margin-bottom: 20px;\\n}\\n\\n.header-left {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 10px;\\n}\\n\\n.chain-title {\\n  margin: 0;\\n  font-size: 24px;\\n  font-weight: 600;\\n  color: #303133;\\n}\\n\\n.chain-info {\\n  display: flex;\\n  gap: 10px;\\n}\\n\\n.header-right {\\n  display: flex;\\n  gap: 10px;\\n}\\n\\n.chain-tabs {\\n  margin-top: 20px;\\n}\\n\\n.filter-bar {\\n  display: flex;\\n  gap: 10px;\\n  margin-bottom: 20px;\\n  flex-wrap: wrap;\\n}\\n\\n.filter-bar .el-input,\\n.filter-bar .el-select {\\n  width: 200px;\\n}\\n\\n.stores-view,\\n.employees-view,\\n.inventory-view,\\n.stats-view {\\n  padding: 20px 0;\\n}\\n\\n.manager-info,\\n.employee-info {\\n  display: flex;\\n  align-items: center;\\n  gap: 10px;\\n}\\n\\n.employee-detail {\\n  display: flex;\\n  flex-direction: column;\\n}\\n\\n.employee-name {\\n  font-weight: 600;\\n  color: #303133;\\n}\\n\\n.employee-phone {\\n  font-size: 12px;\\n  color: #909399;\\n}\\n\\n.inventory-normal {\\n  color: #67C23A;\\n  font-weight: 600;\\n}\\n\\n.inventory-warning {\\n  color: #E6A23C;\\n  font-weight: 600;\\n}\\n\\n.inventory-out-of-stock {\\n  color: #F56C6C;\\n  font-weight: 600;\\n}\\n\\n.stat-card {\\n  margin-bottom: 20px;\\n}\\n\\n.stat-content {\\n  display: flex;\\n  align-items: center;\\n  gap: 20px;\\n}\\n\\n.stat-icon {\\n  width: 60px;\\n  height: 60px;\\n  border-radius: 10px;\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  color: white;\\n  font-size: 24px;\\n}\\n\\n.stat-info {\\n  flex: 1;\\n}\\n\\n.stat-value {\\n  font-size: 28px;\\n  font-weight: 600;\\n  color: #303133;\\n  margin-bottom: 5px;\\n}\\n\\n.stat-label {\\n  font-size: 14px;\\n  color: #909399;\\n}\\n\\n.chart-card {\\n  margin-bottom: 20px;\\n}\\n\\n.card-header {\\n  font-size: 16px;\\n  font-weight: 600;\\n  color: #303133;\\n}\\n\\n.el-pagination {\\n  margin-top: 20px;\\n  display: flex;\\n  justify-content: center;\\n}\\n</style>\\n\",\"originTextLength\":35645,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768883895747}]",
