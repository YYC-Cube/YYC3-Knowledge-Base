,\\\\n      right: \\\\'4%\\\\',\\\\n      bottom: \\\\'3%\\\\',\\\\n      containLabel: true\\\\n    },\\\\n    xAxis: {\\\\n      type: \\\\'category\\\\',\\\\n      data: [\\\\'1月\\\\', \\\\'2月\\\\', \\\\'3月\\\\', \\\\'4月\\\\', \\\\'5月\\\\', \\\\'6月\\\\']\\\\n    },\\\\n    yAxis: {\\\\n      type: \\\\'value\\\\',\\\\n      axisLabel: {\\\\n        formatter: \\\\'{value}分钟\\\\'\\\\n      }\\\\n    },\\\\n    series: [\\\\n      {\\\\n        name: \\\\'响应时间\\\\',\\\\n        type: \\\\'line\\\\',\\\\n        smooth: true,\\\\n        data: [3.8, 3.6, 3.5, 3.4, 3.3, 3.2],\\\\n        itemStyle: { color: \\\\'#409EFF\\\\' },\\\\n        areaStyle: {\\\\n          color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [\\\\n            { offset: 0, color: \\\\'rgba(64, 158, 255, 0.3)\\\\' },\\\\n            { offset: 1, color: \\\\'rgba(64, 158, 255, 0.05)\\\\' }\\\\n          ])\\\\n        }\\\\n      }\\\\n    ]\\\\n  }\\\\n  chart.setOption(option)\\\\n}\\\\n\\\\nconst initFeedbackChart = () => {\\\\n  if (!feedbackChart.value) return\\\\n  \\\\n  const chart = echarts.init(feedbackChart.value)\\\\n  const option = {\\\\n    tooltip: {\\\\n      trigger: \\\\'item\\\\',\\\\n      formatter: \\\\'{b}: {c}条 ({d}%)\\\\'\\\\n    },\\\\n    legend: {\\\\n      orient: \\\\'vertical\\\\',\\\\n      left: \\\\'left\\\\'\\\\n    },\\\\n    series: [\\\\n      {\\\\n        name: \\\\'客户反馈\\\\',\\\\n        type: \\\\'pie\\\\',\\\\n        radius: [\\\\'40%\\\\', \\\\'70%\\\\'],\\\\n        data: [\\\\n          { value: 680, name: \\\\'好评\\\\', itemStyle: { color: \\\\'#67C23A\\\\' } },\\\\n          { value: 120, name: \\\\'中评\\\\', itemStyle: { color: \\\\'#E6A23C\\\\' } },\\\\n          { value: 25, name: \\\\'差评\\\\', itemStyle: { color: \\\\'#F56C6C\\\\' } },\\\\n          { value: 175, name: \\\\'建议\\\\', itemStyle: { color: \\\\'#409EFF\\\\' } }\\\\n        ],\\\\n        emphasis: {\\\\n          itemStyle: {\\\\n            shadowBlur: 10,\\\\n            shadowOffsetX: 0,\\\\n            shadowColor: \\\\'rgba(0, 0, 0, 0.5)\\\\'\\\\n          }\\\\n        }\\\\n      }\\\\n    ]\\\\n  }\\\\n  chart.setOption(option)\\\\n}\\\\n\\\\nconst initWorkloadChart = () => {\\\\n  if (!workloadChart.value) return\\\\n  \\\\n  const chart = echarts.init(workloadChart.value)\\\\n  const option = {\\\\n    tooltip: {\\\\n      trigger: \\\\'axis\\\\',\\\\n      axisPointer: {\\\\n        type: \\\\'shadow\\\\'\\\\n      }\\\\n    },\\\\n    grid: {\\\\n      left: \\\\'3%\\\\',\\\\n      right: \\\\'4%\\\\',\\\\n      bottom: \\\\'3%\\\\',\\\\n      containLabel: true\\\\n    },\\\\n    xAxis: {\\\\n      type: \\\\'category\\\\',\\\\n      data: [\\\\'张三\\\\', \\\\'李四\\\\', \\\\'王五\\\\', \\\\'赵六\\\\', \\\\'钱七\\\\']\\\\n    },\\\\n    yAxis: {\\\\n      type: \\\\'value\\\\'\\\\n    },\\\\n    series: [\\\\n      {\\\\n        name: \\\\'处理订单数\\\\',\\\\n        type: \\\\'bar\\\\',\\\\n        data: [185, 178, 165, 158, 152],\\\\n        itemStyle: {\\\\n          color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [\\\\n            { offset: 0, color: \\\\'#409EFF\\\\' },\\\\n            { offset: 0.5, color: \\\\'#66b1ff\\\\' },\\\\n            { offset: 1, color: \\\\'#8cc5ff\\\\' }\\\\n          ])\\\\n        }\\\\n      }\\\\n    ]\\\\n  }\\\\n  chart.setOption(option)\\\\n}\\\\n\\\\nconst initPerformanceTrendChart = () => {\\\\n  if (!performanceTrendChart.value) return\\\\n  \\\\n  const chart = echarts.init(performanceTrendChart.value)\\\\n  const option = {\\\\n    tooltip: {\\\\n      trigger: \\\\'axis\\\\'\\\\n    },\\\\n    grid: {\\\\n      left: \\\\'3%\\\\',\\\\n      right: \\\\'4%\\\\',\\\\n      bottom: \\\\'3%\\\\',\\\\n      containLabel: true\\\\n    },\\\\n    xAxis: {\\\\n      type: \\\\'category\\\\',\\\\n      data: [\\\\'1月\\\\', \\\\'2月\\\\', \\\\'3月\\\\', \\\\'4月\\\\', \\\\'5月\\\\', \\\\'6月\\\\']\\\\n    },\\\\n    yAxis: {\\\\n      type: \\\\'value\\\\',\\\\n      axisLabel: {\\\\n        formatter: \\\\'{value}单/人\\\\'\\\\n      }\\\\n    },\\\\n    series: [\\\\n      {\\\\n        name: \\\\'人均订单\\\\',\\\\n        type: \\\\'line\\\\',\\\\n        smooth: true,\\\\n        data: [35, 36, 37, 38, 39, 41],\\\\n        itemStyle: { color: \\\\'#67C23A\\\\' },\\\\n        areaStyle: {\\\\n          color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [\\\\n            { offset: 0, color: \\\\'rgba(103, 194, 58, 0.3)\\\\' },\\\\n            { offset: 1, color: \\\\'rgba(103, 194, 58, 0.05)\\\\' }\\\\n          ])\\\\n        }\\\\n      }\\\\n    ]\\\\n  }\\\\n  chart.setOption(option)\\\\n}\\\\n\\\\nconst initTrainingChart = () => {\\\\n  if (!trainingChart.value) return\\\\n  \\\\n  const chart = echarts.init(trainingChart.value)\\\\n  const option = {\\\\n    tooltip: {\\\\n      trigger: \\\\'axis\\\\'\\\\n    },\\\\n    legend: {\\\\n      data: [\\\\'培训次数\\\\', \\\\'培训时长\\\\', \\\\'员工满意度\\\\']\\\\n    },\\\\n    grid: {\\\\n      left: \\\\'3%\\\\',\\\\n      right: \\\\'4%\\\\',\\\\n      bottom: \\\\'3%\\\\',\\\\n      containLabel: true\\\\n    },\\\\n    xAxis: {\\\\n      type: \\\\'category\\\\',\\\\n      data: [\\\\'1月\\\\', \\\\'2月\\\\', \\\\'3月\\\\', \\\\'4月\\\\', \\\\'5月\\\\', \\\\'6月\\\\']\\\\n    },\\\\n    yAxis: [\\\\n      {\\\\n        type: \\\\'value\\\\',\\\\n        name: \\\\'次数/时长\\\\',\\\\n        position: \\\\'left\\\\'\\\\n      },\\\\n      {\\\\n        type: \\\\'value\\\\',\\\\n        name: \\\\'满意度\\\\',\\\\n        position: \\\\'right\\\\',\\\\n        max: 5\\\\n      }\\\\n    ],\\\\n    series: [\\\\n      {\\\\n        name: \\\\'培训次数\\\\',\\\\n        type: \\\\'bar\\\\',\\\\n        data: [4, 5, 4, 6, 5, 6],\\\\n        itemStyle: { color: \\\\'#409EFF\\\\' }\\\\n      },\\\\n      {\\\\n        name: \\\\'培训时长\\\\',\\\\n        type: \\\\'line\\\\',\\\\n        smooth: true,\\\\n        data: [12, 15, 12, 18, 15, 18],\\\\n        itemStyle: { color: \\\\'#67C23A\\\\' }\\\\n      },\\\\n      {\\\\n        name: \\\\'员工满意度\\\\',\\\\n        type: \\\\'line\\\\',\\\\n        smooth: true,\\\\n        yAxisIndex: 1,\\\\n        data: [4.0, 4.1, 4.1, 4.2, 4.2, 4.2],\\\\n        itemStyle: { color: \\\\'#E6A23C\\\\' }\\\\n      }\\\\n    ]\\\\n  }\\\\n  chart.setOption(option)\\\\n}\\\\n\\\\nwatch(viewMode, async (newMode) => {\\\\n  await nextTick()\\\\n  \\\\n  if (newMode === \\\\'efficiency\\\\') {\\\\n    initTableUtilizationChart()\\\\n    initPeakHoursChart()\\\\n    initOrderProcessingChart()\\\\n    initCookingSpeedChart()\\\\n    initEfficiencyTrendChart()\\\\n  } else if (newMode === \\\\'cost\\\\') {\\\\n    initCostCompositionChart()\\\\n    initCostTrendChart()\\\\n    initUnitCostChart()\\\\n    initCostBenefitChart()\\\\n  } else if (newMode === \\\\'quality\\\\') {\\\\n    initSatisfactionTrendChart()\\\\n    initComplaintRateChart()\\\\n    initResponseTimeChart()\\\\n    initFeedbackChart()\\\\n  } else if (newMode === \\\\'staff\\\\') {\\\\n    initWorkloadChart()\\\\n    initPerformanceTrendChart()\\\\n    initTrainingChart()\\\\n  }\\\\n})\\\\n\\\\nonMounted(async () => {\\\\n  await nextTick()\\\\n  initTableUtilizationChart()\\\\n  initPeakHoursChart()\\\\n  initOrderProcessingChart()\\\\n  initCookingSpeedChart()\\\\n  initEfficiencyTrendChart()\\\\n})\\\\n</script>\\\\n\\\\n<style scoped lang=\\\\\\\"scss\\\\\\\">\\\\n.operational-analytics {\\\\n  .analytics-header {\\\\n    display: flex;\\\\n    justify-content: space-between;\\\\n    align-items: center;\\\\n    margin-bottom: 20px;\\\\n    \\\\n    .header-title {\\\\n      h3 {\\\\n        margin: 0 0 5px 0;\\\\n        font-size: 20px;\\\\n        color: #303133;\\\\n      }\\\\n      \\\\n      p {\\\\n        margin: 0;\\\\n        font-size: 14px;\\\\n        color: #909399;\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  .analytics-content {\\\\n    .chart-container {\\\\n      width: 100%;\\\\n      height: 350px;\\\\n    }\\\\n\\\\n    .large-chart-container {\\\\n      width: 100%;\\\\n      height: 500px;\\\\n    }\\\\n\\\\n    .efficiency-metric-card,\\\\n    .cost-metric-card,\\\\n    .quality-metric-card,\\\\n    .staff-metric-card {\\\\n      .metric-content {\\\\n        display: flex;\\\\n        align-items: center;\\\\n\\\\n        .metric-icon {\\\\n          width: 50px;\\\\n          height: 50px;\\\\n          border-radius: 8px;\\\\n          display: flex;\\\\n          align-items: center;\\\\n          justify-content: center;\\\\n          color: white;\\\\n          margin-right: 15px;\\\\n        }\\\\n\\\\n        .metric-info {\\\\n          flex: 1;\\\\n\\\\n          .metric-value {\\\\n            font-size: 24px;\\\\n            font-weight: bold;\\\\n            color: #303133;\\\\n            margin-bottom: 5px;\\\\n          }\\\\n\\\\n          .metric-label {\\\\n            font-size: 14px;\\\\n            color: #606266;\\\\n            margin-bottom: 5px;\\\\n          }\\\\n\\\\n          .metric-change {\\\\n            font-size: 12px;\\\\n\\\\n            &.positive {\\\\n              color: #67c23a;\\\\n            }\\\\n\\\\n            &.negative {\\\\n              color: #f56c6c;\\\\n            }\\\\n          }\\\\n        }\\\\n      }\\\\n    }\\\\n\\\\n    .cost-suggestions,\\\\n    .scheduling-suggestions {\\\\n      max-height: 350px;\\\\n      overflow-y: auto;\\\\n    }\\\\n\\\\n    .quality-scores {\\\\n      .score-item {\\\\n        padding: 15px;\\\\n        background: #f5f7fa;\\\\n        border-radius: 8px;\\\\n        margin-bottom: 10px;\\\\n\\\\n        .score-label {\\\\n          font-size: 14px;\\\\n          color: #606266;\\\\n          margin-bottom: 8px;\\\\n        }\\\\n\\\\n        .score-value {\\\\n          display: flex;\\\\n          align-items: center;\\\\n        }\\\\n      }\\\\n    }\\\\n  }\\\\n}\\\\n</style>\\\\n\",\"originAcceptText\":\"<template>\\n  <div class=\\\"operational-analytics\\\">\\n    <div class=\\\"analytics-header\\\">\\n      <div class=\\\"header-title\\\">\\n        <h3>运营分析</h3>\\n        <p>监控运营效率和服务质量</p>\\n      </div>\\n      <div class=\\\"header-actions\\\">\\n        <el-button-group>\\n          <el-button :type=\\\"viewMode === 'efficiency' ? 'primary' : 'default'\\\" @click=\\\"viewMode = 'efficiency'\\\">\\n            效率\\n          </el-button>\\n          <el-button :type=\\\"viewMode === 'cost' ? 'primary' : 'default'\\\" @click=\\\"viewMode = 'cost'\\\">\\n            成本\\n          </el-button>\\n          <el-button :type=\\\"viewMode === 'quality' ? 'primary' : 'default'\\\" @click=\\\"viewMode = 'quality'\\\">\\n            质量\\n          </el-button>\\n          <el-button :type=\\\"viewMode === 'staff' ? 'primary' : 'default'\\\" @click=\\\"viewMode = 'staff'\\\">\\n            员工\\n          </el-button>\\n        </el-button-group>\\n      </div>\\n    </div>\\n\\n    <div class=\\\"analytics-content\\\">\\n      <div v-if=\\\"viewMode === 'efficiency'\\\" class=\\\"efficiency-view\\\">\\n        <el-row :gutter=\\\"20\\\">\\n          <el-col :span=\\\"6\\\" v-for=\\\"metric in efficiencyMetrics\\\" :key=\\\"metric.key\\\">\\n            <el-card class=\\\"efficiency-metric-card\\\">\\n              <div class=\\\"metric-content\\\">\\n                <div class=\\\"metric-icon\\\" :style=\\\"{ backgroundColor: metric.color }\\\">\\n                  <el-icon :size=\\\"24\\\">\\n                    <component :is=\\\"metric.icon\\\" />\\n                  </el-icon>\\n                </div>\\n                <div class=\\\"metric-info\\\">\\n                  <div class=\\\"metric-value\\\">{{ metric.value }}</div>\\n                  <div class=\\\"metric-label\\\">{{ metric.label }}</div>\\n                  <div class=\\\"metric-change\\\" :class=\\\"metric.change >= 0 ? 'positive' : 'negative'\\\">\\n                    {{ metric.change >= 0 ? '+' : '' }}{{ metric.change }}%\\n                  </div>\\n                </div>\\n              </div>\\n            </el-card>\\n          </el-col>\\n        </el-row>\\n\\n        <el-row :gutter=\\\"20\\\" style=\\\"margin-top: 20px;\\\">\\n          <el-col :span=\\\"12\\\">\\n            <el-card title=\\\"桌位利用率\\\">\\n              <div ref=\\\"tableUtilizationChart\\\" class=\\\"chart-container\\\"></div>\\n            </el-card>\\n          </el-col>\\n          <el-col :span=\\\"12\\\">\\n            <el-card title=\\\"高峰时段分析\\\">\\n              <div ref=\\\"peakHoursChart\\\" class=\\\"chart-container\\\"></div>\\n            </el-card>\\n          </el-col>\\n        </el-row>\\n\\n        <el-row :gutter=\\\"20\\\" style=\\\"margin-top: 20px;\\\">\\n          <el-col :span=\\\"12\\\">\\n            <el-card title=\\\"订单处理时间\\\">\\n              <div ref=\\\"orderProcessingChart\\\" class=\\\"chart-container\\\"></div>\\n            </el-card>\\n          </el-col>\\n          <el-col :span=\\\"12\\\">\\n            <el-card title=\\\"出餐速度分析\\\">\\n              <div ref=\\\"cookingSpeedChart\\\" class=\\\"chart-container\\\"></div>\\n            </el-card>\\n          </el-col>\\n        </el-row>\\n\\n        <el-row :gutter=\\\"20\\\" style=\\\"margin-top: 20px;\\\">\\n          <el-col :span=\\\"24\\\">\\n            <el-card title=\\\"运营效率趋势\\\">\\n              <div ref=\\\"efficiencyTrendChart\\\" class=\\\"large-chart-container\\\"></div>\\n            </el-card>\\n          </el-col>\\n        </el-row>\\n      </div>\\n\\n      <div v-else-if=\\\"viewMode === 'cost'\\\" class=\\\"cost-view\\\">\\n        <el-row :gutter=\\\"20\\\">\\n          <el-col :span=\\\"6\\\" v-for=\\\"metric in costMetrics\\\" :key=\\\"metric.key\\\">\\n            <el-card class=\\\"cost-metric-card\\\">\\n              <div class=\\\"metric-content\\\">\\n                <div class=\\\"metric-icon\\\" :style=\\\"{ backgroundColor: metric.color }\\\">\\n                  <el-icon :size=\\\"24\\\">\\n                    <component :is=\\\"metric.icon\\\" />\\n                  </el-icon>\\n                </div>\\n                <div class=\\\"metric-info\\\">\\n                  <div class=\\\"metric-value\\\">{{ metric.value }}</div>\\n                  <div class=\\\"metric-label\\\">{{ metric.label }}</div>\\n                  <div class=\\\"metric-change\\\" :class=\\\"metric.change >= 0 ? 'positive' : 'negative'\\\">\\n                    {{ metric.change >= 0 ? '+' : '' }}{{ metric.change }}%\\n                  </div>\\n                </div>\\n              </div>\\n            </el-card>\\n          </el-col>\\n        </el-row>\\n\\n        <el-row :gutter=\\\"20\\\" style=\\\"margin-top: 20px;\\\">\\n          <el-col :span=\\\"12\\\">\\n            <el-card title=\\\"成本构成分析\\\">\\n              <div ref=\\\"costCompositionChart\\\" class=\\\"chart-container\\\"></div>\\n            </el-card>\\n          </el-col>\\n          <el-col :span=\\\"12\\\">\\n            <el-card title=\\\"成本趋势\\\">\\n              <div ref=\\\"costTrendChart\\\" class=\\\"chart-container\\\"></div>\\n            </el-card>\\n          </el-col>\\n        </el-row>\\n\\n        <el-row :gutter=\\\"20\\\" style=\\\"margin-top: 20px;\\\">\\n          <el-col :span=\\\"12\\\">\\n            <el-card title=\\\"单位成本分析\\\">\\n              <div ref=\\\"unitCostChart\\\" class=\\\"chart-container\\\"></div>\\n            </el-card>\\n          </el-col>\\n          <el-col :span=\\\"12\\\">\\n            <el-card title=\\\"成本控制建议\\\">\\n              <div class=\\\"cost-suggestions\\\">\\n                <el-alert\\n                  v-for=\\\"(suggestion, index) in costControlSuggestions\\\"\\n                  :key=\\\"index\\\"\\n                  :title=\\\"suggestion.title\\\"\\n                  :type=\\\"suggestion.type\\\"\\n                  :description=\\\"suggestion.description\\\"\\n                  :closable=\\\"false\\\"\\n                  style=\\\"margin-bottom: 10px;\\\"\\n                />\\n              </div>\\n            </el-card>\\n          </el-col>\\n        </el-row>\\n\\n        <el-row :gutter=\\\"20\\\" style=\\\"margin-top: 20px;\\\">\\n          <el-col :span=\\\"24\\\">\\n            <el-card title=\\\"成本效益分析\\\">\\n              <div ref=\\\"costBenefitChart\\\" class=\\\"large-chart-container\\\"></div>\\n            </el-card>\\n          </el-col>\\n        </el-row>\\n      </div>\\n\\n      <div v-else-if=\\\"viewMode === 'quality'\\\" class=\\\"quality-view\\\">\\n        <el-row :gutter=\\\"20\\\">\\n          <el-col :span=\\\"6\\\" v-for=\\\"metric in qualityMetrics\\\" :key=\\\"metric.key\\\">\\n            <el-card class=\\\"quality-metric-card\\\">\\n              <div class=\\\"metric-content\\\">\\n                <div class=\\\"metric-icon\\\" :style=\\\"{ backgroundColor: metric.color }\\\">\\n                  <el-icon :size=\\\"24\\\">\\n                    <component :is=\\\"metric.icon\\\" />\\n                  </el-icon>\\n                </div>\\n                <div class=\\\"metric-info\\\">\\n                  <div class=\\\"metric-value\\\">{{ metric.value }}</div>\\n                  <div class=\\\"metric-label\\\">{{ metric.label }}</div>\\n                  <div class=\\\"metric-change\\\" :class=\\\"metric.change >= 0 ? 'positive' : 'negative'\\\">\\n                    {{ metric.change >= 0 ? '+' : '' }}{{ metric.change }}%\\n                  </div>\\n                </div>\\n              </div>\\n            </el-card>\\n          </el-col>\\n        </el-row>\\n\\n        <el-row :gutter=\\\"20\\\" style=\\\"margin-top: 20px;\\\">\\n          <el-col :span=\\\"12\\\">\\n            <el-card title=\\\"客户满意度趋势\\\">\\n              <div ref=\\\"satisfactionTrendChart\\\" class=\\\"chart-container\\\"></div>\\n            </el-card>\\n          </el-col>\\n          <el-col :span=\\\"12\\\">\\n            <el-card title=\\\"投诉率分析\\\">\\n              <div ref=\\\"complaintRateChart\\\" class=\\\"chart-container\\\"></div>\\n            </el-card>\\n          </el-col>\\n        </el-row>\\n\\n        <el-row :gutter=\\\"20\\\" style=\\\"margin-top: 20px;\\\">\\n          <el-col :span=\\\"12\\\">\\n            <el-card title=\\\"处理时效分析\\\">\\n              <div ref=\\\"responseTimeChart\\\" class=\\\"chart-container\\\"></div>\\n            </el-card>\\n          </el-col>\\n          <el-col :span=\\\"12\\\">\\n            <el-card title=\\\"服务质量评分\\\">\\n              <div class=\\\"quality-scores\\\">\\n                <div v-for=\\\"score in qualityScores\\\" :key=\\\"score.label\\\" class=\\\"score-item\\\">\\n                  <div class=\\\"score-label\\\">{{ score.label }}</div>\\n                  <div class=\\\"score-value\\\">\\n                    <el-rate v-model=\\\"score.value\\\" disabled show-score />\\n                  </div>\\n                </div>\\n              </div>\\n            </el-card>\\n          </el-col>\\n        </el-row>\\n\\n        <el-row :gutter=\\\"20\\\" style=\\\"margin-top: 20px;\\\">\\n          <el-col :span=\\\"24\\\">\\n            <el-card title=\\\"客户反馈分析\\\">\\n              <div ref=\\\"feedbackChart\\\" class=\\\"large-chart-container\\\"></div>\\n            </el-card>\\n          </el-col>\\n        </el-row>\\n      </div>\\n\\n      <div v-else-if=\\\"viewMode === 'staff'\\\" class=\\\"staff-view\\\">\\n        <el-row :gutter=\\\"20\\\">\\n          <el-col :span=\\\"6\\\" v-for=\\\"metric in staffMetrics\\\" :key=\\\"metric.key\\\">\\n            <el-card class=\\\"staff-metric-card\\\">\\n              <div class=\\\"metric-content\\\">\\n                <div class=\\\"metric-icon\\\" :style=\\\"{ backgroundColor: metric.color }\\\">\\n                  <el-icon :size=\\\"24\\\">\\n                    <component :is=\\\"metric.icon\\\" />\\n                  </el-icon>\\n                </div>\\n                <div class=\\\"metric-info\\\">\\n                  <div class=\\\"metric-value\\\">{{ metric.value }}</div>\\n                  <div class=\\\"metric-label\\\">{{ metric.label }}</div>\\n                  <div class=\\\"metric-change\\\" :class=\\\"metric.change >= 0 ? 'positive' : 'negative'\\\">\\n                    {{ metric.change >= 0 ? '+' : '' }}{{ metric.change }}%\\n                  </div>\\n                </div>\\n              </div>\\n            </el-card>\\n          </el-col>\\n        </el-row>\\n\\n        <el-row :gutter=\\\"20\\\" style=\\\"margin-top: 20px;\\\">\\n          <el-col :span=\\\"12\\\">\\n            <el-card title=\\\"员工效率排行\\\">\\n              <el-table :data=\\\"staffEfficiency\\\" style=\\\"width: 100%\\\" max-height=\\\"400\\\">\\n                <el-table-column type=\\\"index\\\" label=\\\"排名\\\" width=\\\"60\\\" />\\n                <el-table-column prop=\\\"name\\\" label=\\\"姓名\\\" />\\n                <el-table-column prop=\\\"role\\\" label=\\\"职位\\\" width=\\\"100\\\" />\\n                <el-table-column prop=\\\"ordersProcessed\\\" label=\\\"处理订单\\\" width=\\\"100\\\" sortable />\\n                <el-table-column prop=\\\"avgTime\\\" label=\\\"平均时间\\\" width=\\\"100\\\" sortable>\\n                  <template #default=\\\"{ row }\\\">\\n                    {{ row.avgTime }}分钟\\n                  </template>\\n                </el-table-column>\\n                <el-table-column prop=\\\"satisfaction\\\" label=\\\"满意度\\\" width=\\\"100\\\">\\n                  <template #default=\\\"{ row }\\\">\\n                    <el-rate v-model=\\\"row.satisfaction\\\" disabled show-score />\\n                  </template>\\n                </el-table-column>\\n              </el-table>\\n            </el-card>\\n          </el-col>\\n          <el-col :span=\\\"12\\\">\\n            <el-card title=\\\"员工工作量分布\\\">\\n              <div ref=\\\"workloadChart\\\" class=\\\"chart-container\\\"></div>\\n            </el-card>\\n          </el-col>\\n        </el-row>\\n\\n        <el-row :gutter=\\\"20\\\" style=\\\"margin-top: 20px;\\\">\\n          <el-col :span=\\\"12\\\">\\n            <el-card title=\\\"员工绩效趋势\\\">\\n              <div ref=\\\"performanceTrendChart\\\" class=\\\"chart-container\\\"></div>\\n            </el-card>\\n          </el-col>\\n          <el-col :span=\\\"12\\\">\\n            <el-card title=\\\"排班优化建议\\\">\\n              <div class=\\\"scheduling-suggestions\\\">\\n                <el-alert\\n                  v-for=\\\"(suggestion, index) in schedulingSuggestions\\\"\\n                  :key=\\\"index\\\"\\n                  :title=\\\"suggestion.title\\\"\\n                  :type=\\\"suggestion.type\\\"\\n                  :description=\\\"suggestion.description\\\"\\n                  :closable=\\\"false\\\"\\n                  style=\\\"margin-bottom: 10px;\\\"\\n                />\\n              </div>\\n            </el-card>\\n          </el-col>\\n        </el-row>\\n\\n        <el-row :gutter=\\\"20\\\" style=\\\"margin-top: 20px;\\\">\\n          <el-col :span=\\\"24\\\">\\n            <el-card title=\\\"员工培训与发展\\\">\\n              <div ref=\\\"trainingChart\\\" class=\\\"large-chart-container\\\"></div>\\n            </el-card>\\n          </el-col>\\n        </el-row>\\n      </div>\\n    </div>\\n  </div>\\n</template>\\n\\n<script setup lang=\\\"ts\\\">\\nimport { ref, reactive, onMounted, nextTick, watch } from 'vue'\\nimport { ElMessage } from 'element-plus'\\nimport * as echarts from 'echarts'\\nimport { TrendCharts, Money, Star, User } from '@element-plus/icons-vue'\\n\\ninterface Metric {\\n  key: string\\n  label: string\\n  value: string | number\\n  change: number\\n  icon: string\\n  color: string\\n}\\n\\ninterface StaffEfficiency {\\n  name: string\\n  role: string\\n  ordersProcessed: number\\n  avgTime: number\\n  satisfaction: number\\n}\\n\\ninterface QualityScore {\\n  label: string\\n  value: number\\n}\\n\\nconst viewMode = ref('efficiency')\\n\\nconst tableUtilizationChart = ref()\\nconst peakHoursChart = ref()\\nconst orderProcessingChart = ref()\\nconst cookingSpeedChart = ref()\\nconst efficiencyTrendChart = ref()\\nconst costCompositionChart = ref()\\nconst costTrendChart = ref()\\nconst unitCostChart = ref()\\nconst costBenefitChart = ref()\\nconst satisfactionTrendChart = ref()\\nconst complaintRateChart = ref()\\nconst responseTimeChart = ref()\\nconst feedbackChart = ref()\\nconst workloadChart = ref()\\nconst performanceTrendChart = ref()\\nconst trainingChart = ref()\\n\\nconst efficiencyMetrics = ref<Metric[]>([\\n  {\\n    key: 'tableUtilization',\\n    label: '桌位利用率',\\n    value: '78.5%',\\n    change: 5.2,\\n    icon: 'TrendCharts',\\n    color: '#409EFF'\\n  },\\n  {\\n    key: 'orderProcessing',\\n    label: '订单处理效率',\\n    value: '92.3%',\\n    change: 3.8,\\n    icon: 'TrendCharts',\\n    color: '#67C23A'\\n  },\\n  {\\n    key: 'kitchenEfficiency',\\n    label: '厨房效率',\\n    value: '85.6%',\\n    change: 4.5,\\n    icon: 'TrendCharts',\\n    color: '#E6A23C'\\n  },\\n  {\\n    key: 'staffEfficiency',\\n    label: '员工效率',\\n    value: '88.2%',\\n    change: 2.9,\\n    icon: 'User',\\n    color: '#F56C6C'\\n  }\\n])\\n\\nconst costMetrics = ref<Metric[]>([\\n  {\\n    key: 'totalCost',\\n    label: '总成本',\\n    value: '¥88,000',\\n    change: -2.5,\\n    icon: 'Money',\\n    color: '#409EFF'\\n  },\\n  {\\n    key: 'laborCost',\\n    label: '人工成本',\\n    value: '¥18,000',\\n    change: -1.8,\\n    icon: 'User',\\n    color: '#67C23A'\\n  },\\n  {\\n    key: 'materialCost',\\n    label: '食材成本',\\n    value: '¥45,000',\\n    change: -3.2,\\n    icon: 'Money',\\n    color: '#E6A23C'\\n  },\\n  {\\n    key: 'costRatio',\\n    label: '成本占比',\\n    value: '47.7%',\\n    change: -1.5,\\n    icon: 'TrendCharts',\\n    color: '#F56C6C'\\n  }\\n])\\n\\nconst qualityMetrics = ref<Metric[]>([\\n  {\\n    key: 'satisfaction',\\n    label: '客户满意度',\\n    value: '4.6/5.0',\\n    change: 5.5,\\n    icon: 'Star',\\n    color: '#67C23A'\\n  },\\n  {\\n    key: 'complaintRate',\\n    label: '投诉率',\\n    value: '1.2%',\\n    change: -15.8,\\n    icon: 'TrendCharts',\\n    color: '#F56C6C'\\n  },\\n  {\\n    key: 'responseTime',\\n    label: '平均响应时间',\\n    value: '3.2分钟',\\n    change: -8.5,\\n    icon: 'TrendCharts',\\n    color: '#409EFF'\\n  },\\n  {\\n    key: 'resolutionRate',\\n    label: '问题解决率',\\n    value: '96.5%',\\n    change: 2.3,\\n    icon: 'Star',\\n    color: '#E6A23C'\\n  }\\n])\\n\\nconst staffMetrics = ref<Metric[]>([\\n  {\\n    key: 'totalStaff',\\n    label: '员工总数',\\n    value: 45,\\n    change: 5.0,\\n    icon: 'User',\\n    color: '#409EFF'\\n  },\\n  {\\n    key: 'avgOrders',\\n    label: '人均订单',\\n    value: 41.2,\\n    change: 8.3,\\n    icon: 'TrendCharts',\\n    color: '#67C23A'\\n  },\\n  {\\n    key: 'avgTime',\\n    label: '平均处理时间',\\n    value: '4.8分钟',\\n    change: -5.2,\\n    icon: 'TrendCharts',\\n    color: '#E6A23C'\\n  },\\n  {\\n    key: 'satisfaction',\\n    label: '员工满意度',\\n    value: '4.2/5.0',\\n    change: 3.5,\\n    icon: 'Star',\\n    color: '#F56C6C'\\n  }\\n])\\n\\nconst staffEfficiency = ref<StaffEfficiency[]>([\\n  { name: '张三', role: '服务员', ordersProcessed: 185, avgTime: 4.2, satisfaction: 4.8 },\\n  { name: '李四', role: '服务员', ordersProcessed: 178, avgTime: 4.5, satisfaction: 4.7 },\\n  { name: '王五', role: '厨师', ordersProcessed: 165, avgTime: 5.2, satisfaction: 4.6 },\\n  { name: '赵六', role: '服务员', ordersProcessed: 158, avgTime: 4.8, satisfaction: 4.5 },\\n  { name: '钱七', role: '厨师', ordersProcessed: 152, avgTime: 5.5, satisfaction: 4.4 }\\n])\\n\\nconst qualityScores = ref<QualityScore[]>([\\n  { label: '服务态度', value: 4.7 },\\n  { label: '菜品质量', value: 4.6 },\\n  { label: '环境卫生', value: 4.8 },\\n  { label: '出餐速度', value: 4.3 },\\n  { label: '性价比', value: 4.5 }\\n])\\n\\nconst costControlSuggestions = ref([\\n  {\\n    title: '优化食材采购',\\n    type: 'success',\\n    description: '建议与供应商协商批量采购，预计可降低食材成本5-8%'\\n  },\\n  {\\n    title: '调整人员排班',\\n    type: 'warning',\\n    description: '根据客流高峰优化排班，减少闲时人力浪费'\\n  },\\n  {\\n    title: '降低能源消耗',\\n    type: 'info',\\n    description: '推广节能设备使用，预计可降低水电成本10%'\\n  }\\n])\\n\\nconst schedulingSuggestions = ref([\\n  {\\n    title: '增加高峰期人手',\\n    type: 'warning',\\n    description: '午餐和晚餐高峰期建议增加2-3名服务员'\\n  },\\n  {\\n    title: '优化员工培训',\\n    type: 'success',\\n    description: '定期组织技能培训，提升员工服务效率'\\n  },\\n  {\\n    title: '实施绩效考核',\\n    type: 'info',\\n    description: '建立完善的绩效考核体系，激励员工提升效率'\\n  }\\n])\\n\\nconst initTableUtilizationChart = () => {\\n  if (!tableUtilizationChart.value) return\\n  \\n  const chart = echarts.init(tableUtilizationChart.value)\\n  const option = {\\n    tooltip: {\\n      trigger: 'axis'\\n    },\\n    grid: {\\n      left: '3%',\\n      right: '4%',\\n      bottom: '3%',\\n      containLabel: true\\n    },\\n    xAxis: {\\n      type: 'category',\\n      data: ['周一', '周二', '周三', '周四', '周五', '周六', '周日']\\n    },\\n    yAxis: {\\n      type: 'value',\\n      max: 100,\\n      axisLabel: {\\n        formatter: '{value}%'\\n      }\\n    },\\n    series: [\\n      {\\n        name: '桌位利用率',\\n        type: 'line',\\n        smooth: true,\\n        data: [65, 68, 72, 70, 78, 92, 88],\\n        itemStyle: { color: '#409EFF' },\\n        areaStyle: {\\n          color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [\\n            { offset: 0, color: 'rgba(64, 158, 255, 0.3)' },\\n            { offset: 1, color: 'rgba(64, 158, 255, 0.05)' }\\n          ])\\n        }\\n      }\\n    ]\\n  }\\n  chart.setOption(option)\\n}\\n\\nconst initPeakHoursChart = () => {\\n  if (!peakHoursChart.value) return\\n  \\n  const chart = echarts.init(peakHoursChart.value)\\n  const option = {\\n    tooltip: {\\n      trigger: 'axis'\\n    },\\n    grid: {\\n      left: '3%',\\n      right: '4%',\\n      bottom: '3%',\\n      containLabel: true\\n    },\\n    xAxis: {\\n      type: 'category',\\n      data: Array.from({ length: 24 }, (_, i) => i)\\n    },\\n    yAxis: {\\n      type: 'value'\\n    },\\n    series: [\\n      {\\n        name: '订单数',\\n        type: 'bar',\\n        data: [5, 3, 2, 1, 2, 8, 25, 45, 68, 85, 92, 88, 95, 90, 82, 78, 85, 92, 88, 75, 55, 35, 15, 8],\\n        itemStyle: {\\n          color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [\\n            { offset: 0, color: '#83bff6' },\\n            { offset: 0.5, color: '#188df0' },\\n            { offset: 1, color: '#188df0' }\\n          ])\\n        }\\n      }\\n    ]\\n  }\\n  chart.setOption(option)\\n}\\n\\nconst initOrderProcessingChart = () => {\\n  if (!orderProcessingChart.value) return\\n  \\n  const chart = echarts.init(orderProcessingChart.value)\\n  const option = {\\n    tooltip: {\\n      trigger: 'axis'\\n    },\\n    grid: {\\n      left: '3%',\\n      right: '4%',\\n      bottom: '3%',\\n      containLabel: true\\n    },\\n    xAxis: {\\n      type: 'category',\\n      data: ['接单', '确认', '制作', '出餐', '配送', '完成']\\n    },\\n    yAxis: {\\n      type: 'value',\\n      axisLabel: {\\n        formatter: '{value}分钟'\\n      }\\n    },\\n    series: [\\n      {\\n        name: '平均时间',\\n        type: 'bar',\\n        data: [0.5, 1.2, 8.5, 1.5, 15.2, 0.3],\\n        itemStyle: {\\n          color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [\\n            { offset: 0, color: '#67C23A' },\\n            { offset: 0.5, color: '#95d475' },\\n            { offset: 1, color: '#b3e19d' }\\n          ])\\n        }\\n      }\\n    ]\\n  }\\n  chart.setOption(option)\\n}\\n\\nconst initCookingSpeedChart = () => {\\n  if (!cookingSpeedChart.value) return\\n  \\n  const chart = echarts.init(cookingSpeedChart.value)\\n  const option = {\\n    tooltip: {\\n      trigger: 'axis'\\n    },\\n    grid: {\\n      left: '3%',\\n      right: '4%',\\n      bottom: '3%',\\n      containLabel: true\\n    },\\n    xAxis: {\\n      type: 'category',\\n      data: ['凉菜', '汤品', '热菜', '主食', '饮品']\\n    },\\n    yAxis: {\\n      type: 'value',\\n      axisLabel: {\\n        formatter: '{value}分钟'\\n      }\\n    },\\n    series: [\\n      {\\n        name: '平均制作时间',\\n        type: 'bar',\\n        data: [3.2, 8.5, 12.8, 6.5, 2.8],\\n        itemStyle: {\\n          color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [\\n            { offset: 0, color: '#E6A23C' },\\n            { offset: 0.5, color: '#f0c78a' },\\n            { offset: 1, color: '#f3d19e' }\\n          ])\\n        }\\n      }\\n    ]\\n  }\\n  chart.setOption(option)\\n}\\n\\nconst initEfficiencyTrendChart = () => {\\n  if (!efficiencyTrendChart.value) return\\n  \\n  const chart = echarts.init(efficiencyTrendChart.value)\\n  const option = {\\n    tooltip: {\\n      trigger: 'axis'\\n    },\\n    legend: {\\n      data: ['桌位利用率', '订单处理效率', '厨房效率', '员工效率']\\n    },\\n    grid: {\\n      left: '3%',\\n      right: '4%',\\n      bottom: '3%',\\n      containLabel: true\\n    },\\n    xAxis: {\\n      type: 'category',\\n      data: ['1月', '2月', '3月', '4月', '5月', '6月', '7月', '8月', '9月', '10月', '11月', '12月']\\n    },\\n    yAxis: {\\n      type: 'value',\\n      max: 100,\\n      axisLabel: {\\n        formatter: '{value}%'\\n      }\\n    },\\n    series: [\\n      {\\n        name: '桌位利用率',\\n        type: 'line',\\n        smooth: true,\\n        data: [72, 73, 74, 75, 76, 77, 78, 78, 79, 80, 81, 78],\\n        itemStyle: { color: '#409EFF' }\\n      },\\n      {\\n        name: '订单处理效率',\\n        type: 'line',\\n        smooth: true,\\n        data: [88, 89, 89, 90, 90, 91, 91, 92, 92, 92, 93, 92],\\n        itemStyle: { color: '#67C23A' }\\n      },\\n      {\\n        name: '厨房效率',\\n        type: 'line',\\n        smooth: true,\\n        data: [80, 81, 82, 82, 83, 84, 84, 85, 85, 86, 86, 85],\\n        itemStyle: { color: '#E6A23C' }\\n      },\\n      {\\n        name: '员工效率',\\n        type: 'line',\\n        smooth: true,\\n        data: [84, 85, 85, 86, 86, 87, 87, 88, 88, 88, 89, 88],\\n        itemStyle: { color: '#F56C6C' }\\n      }\\n    ]\\n  }\\n  chart.setOption(option)\\n}\\n\\nconst initCostCompositionChart = () => {\\n  if (!costCompositionChart.value) return\\n  \\n  const chart = echarts.init(costCompositionChart.value)\\n  const option = {\\n    tooltip: {\\n      trigger: 'item',\\n      formatter: '{b}: ¥{c} ({d}%)'\\n    },\\n    legend: {\\n      orient: 'vertical',\\n      left: 'left'\\n    },\\n    series: [\\n      {\\n        name: '成本构成',\\n        type: 'pie',\\n        radius: ['40%', '70%'],\\n        data: [\\n          { value: 45000, name: '食材成本', itemStyle: { color: '#F56C6C' } },\\n          { value: 18000, name: '人工成本', itemStyle: { color: '#409EFF' } },\\n          { value: 12000, name: '租金成本', itemStyle: { color: '#67C23A' } },\\n          { value: 8000, name: '水电成本', itemStyle: { color: '#E6A23C' } },\\n          { value: 5000, name: '其他成本', itemStyle: { color: '#909399' } }\\n        ],\\n        emphasis: {\\n          itemStyle: {\\n            shadowBlur: 10,\\n            shadowOffsetX: 0,\\n            shadowColor: 'rgba(0, 0, 0, 0.5)'\\n          }\\n        }\\n      }\\n    ]\\n  }\\n  chart.setOption(option)\\n}\\n\\nconst initCostTrendChart = () => {\\n  if (!costTrendChart.value) return\\n  \\n  const chart = echarts.init(costTrendChart.value)\\n  const option = {\\n    tooltip: {\\n      trigger: 'axis'\\n    },\\n    grid: {\\n      left: '3%',\\n      right: '4%',\\n      bottom: '3%',\\n      containLabel: true\\n    },\\n    xAxis: {\\n      type: 'category',\\n      data: ['1月', '2月', '3月', '4月', '5月', '6月']\\n    },\\n    yAxis: {\\n      type: 'value',\\n      axisLabel: {\\n        formatter: '¥{value}'\\n      }\\n    },\\n    series: [\\n      {\\n        name: '总成本',\\n        type: 'line',\\n        smooth: true,\\n        data: [92000, 91000, 89500, 89000, 88500, 88000],\\n        itemStyle: { color: '#F56C6C' },\\n        areaStyle: {\\n          color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [\\n            { offset: 0, color: 'rgba(245, 108, 108, 0.3)' },\\n            { offset: 1, color: 'rgba(245, 108, 108, 0.05)' }\\n          ])\\n        }\\n      }\\n    ]\\n  }\\n  chart.setOption(option)\\n}\\n\\nconst initUnitCostChart = () => {\\n  if (!unitCostChart.value) return\\n  \\n  const chart = echarts.init(unitCostChart.value)\\n  const option = {\\n    tooltip: {\\n      trigger: 'axis',\\n      axisPointer: {\\n        type: 'shadow'\\n      }\\n    },\\n    grid: {\\n      left: '3%',\\n      right: '4%',\\n      bottom: '3%',\\n      containLabel: true\\n    },\\n    xAxis: {\\n      type: 'category',\\n      data: ['堂食', '外卖', '打包', '团购']\\n    },\\n    yAxis: {\\n      type: 'value',\\n      axisLabel: {\\n        formatter: '¥{value}'\\n      }\\n    },\\n    series: [\\n      {\\n        name: '单位成本',\\n        type: 'bar',\\n        data: [18.5, 22.8, 16.2, 15.5],\\n        itemStyle: {\\n          color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [\\n            { offset: 0, color: '#409EFF' },\\n            { offset: 0.5, color: '#66b1ff' },\\n            { offset: 1, color: '#8cc5ff' }\\n          ])\\n        }\\n      }\\n    ]\\n  }\\n  chart.setOption(option)\\n}\\n\\nconst initCostBenefitChart = () => {\\n  if (!costBenefitChart.value) return\\n  \\n  const chart = echarts.init(costBenefitChart.value)\\n  const option = {\\n    tooltip: {\\n      trigger: 'axis'\\n    },\\n    legend: {\\n      data: ['收入', '成本', '利润']\\n    },\\n    grid: {\\n      left: '3%',\\n      right: '4%',\\n      bottom: '3%',\\n      containLabel: true\\n    },\\n    xAxis: {\\n      type: 'category',\\n      data: ['1月', '2月', '3月', '4月', '5月', '6月']\\n    },\\n    yAxis: {\\n      type: 'value',\\n      axisLabel: {\\n        formatter: '¥{value}'\\n      }\\n    },\\n    series: [\\n      {\\n        name: '收入',\\n        type: 'line',\\n        smooth: true,\\n        data: [185000, 188000, 192000, 195000, 198000, 200000],\\n        itemStyle: { color: '#67C23A' }\\n      },\\n      {\\n        name: '成本',\\n        type: 'line',\\n        smooth: true,\\n        data: [92000, 91000, 89500, 89000, 88500, 88000],\\n        itemStyle: { color: '#F56C6C' }\\n      },\\n      {\\n        name: '利润',\\n        type: 'bar',\\n        data: [93000, 97000, 102500, 106000, 109500, 112000],\\n        itemStyle: { color: '#409EFF' }\\n      }\\n    ]\\n  }\\n  chart.setOption(option)\\n}\\n\\nconst initSatisfactionTrendChart = () => {\\n  if (!satisfactionTrendChart.value) return\\n  \\n  const chart = echarts.init(satisfactionTrendChart.value)\\n  const option = {\\n    tooltip: {\\n      trigger: 'axis'\\n    },\\n    grid: {\\n      left: '3%',\\n      right: '4%',\\n      bottom: '3%',\\n      containLabel: true\\n    },\\n    xAxis: {\\n      type: 'category',\\n      data: ['1月', '2月', '3月', '4月', '5月', '6月']\\n    },\\n    yAxis: {\\n      type: 'value',\\n      max: 5,\\n      axisLabel: {\\n        formatter: '{value}分'\\n      }\\n    },\\n    series: [\\n      {\\n        name: '满意度',\\n        type: 'line',\\n        smooth: true,\\n        data: [4.3, 4.4, 4.4, 4.5, 4.5, 4.6],\\n        itemStyle: { color: '#67C23A' },\\n        areaStyle: {\\n          color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [\\n            { offset: 0, color: 'rgba(103, 194, 58, 0.3)' },\\n            { offset: 1, color: 'rgba(103, 194, 58, 0.05)' }\\n          ])\\n        }\\n      }\\n    ]\\n  }\\n  chart.setOption(option)\\n}\\n\\nconst initComplaintRateChart = () => {\\n  if (!complaintRateChart.value) return\\n  \\n  const chart = echarts.init(complaintRateChart.value)\\n  const option = {\\n    tooltip: {\\n      trigger: 'axis'\\n    },\\n    grid: {\\n      left: '3%',\\n      right: '4%',\\n      bottom: '3%',\\n      containLabel: true\\n    },\\n    xAxis: {\\n      type: 'category',\\n      data: ['1月', '2月', '3月', '4月', '5月', '6月']\\n    },\\n    yAxis: {\\n      type: 'value',\\n      axisLabel: {\\n        formatter: '{value}%'\\n      }\\n    },\\n    series: [\\n      {\\n        name: '投诉率',\\n        type: 'line',\\n        smooth: true,\\n        data: [1.8, 1.6, 1.5, 1.4, 1.3, 1.2],\\n        itemStyle: { color: '#F56C6C' },\\n        areaStyle: {\\n          color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [\\n            { offset: 0, color: 'rgba(245, 108, 108, 0.3)' },\\n            { offset: 1, color: 'rgba(245, 108, 108, 0.05)' }\\n          ])\\n        }\\n      }\\n    ]\\n  }\\n  chart.setOption(option)\\n}\\n\\nconst initResponseTimeChart = () => {\\n  if (!responseTimeChart.value) return\\n  \\n  const chart = echarts.init(responseTimeChart.value)\\n  const option = {\\n    tooltip: {\\n      trigger: 'axis'\\n    },\\n    grid: {\\n      left: '3%',\\n      right: '4%',\\n      bottom: '3%',\\n      containLabel: true\\n    },\\n    xAxis: {\\n      type: 'category',\\n      data: ['1月', '2月', '3月', '4月', '5月', '6月']\\n    },\\n    yAxis: {\\n      type: 'value',\\n      axisLabel: {\\n        formatter: '{value}分钟'\\n      }\\n    },\\n    series: [\\n      {\\n        name: '响应时间',\\n        type: 'line',\\n        smooth: true,\\n        data: [3.8, 3.6, 3.5, 3.4, 3.3, 3.2],\\n        itemStyle: { color: '#409EFF' },\\n        areaStyle: {\\n          color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [\\n            { offset: 0, color: 'rgba(64, 158, 255, 0.3)' },\\n            { offset: 1, color: 'rgba(64, 158, 255, 0.05)' }\\n          ])\\n        }\\n      }\\n    ]\\n  }\\n  chart.setOption(option)\\n}\\n\\nconst initFeedbackChart = () => {\\n  if (!feedbackChart.value) return\\n  \\n  const chart = echarts.init(feedbackChart.value)\\n  const option = {\\n    tooltip: {\\n      trigger: 'item',\\n      formatter: '{b}: {c}条 ({d}%)'\\n    },\\n    legend: {\\n      orient: 'vertical',\\n      left: 'left'\\n    },\\n    series: [\\n      {\\n        name: '客户反馈',\\n        type: 'pie',\\n        radius: ['40%', '70%'],\\n        data: [\\n          { value: 680, name: '好评', itemStyle: { color: '#67C23A' } },\\n          { value: 120, name: '中评', itemStyle: { color: '#E6A23C' } },\\n          { value: 25, name: '差评', itemStyle: { color: '#F56C6C' } },\\n          { value: 175, name: '建议', itemStyle: { color: '#409EFF' } }\\n        ],\\n        emphasis: {\\n          itemStyle: {\\n            shadowBlur: 10,\\n            shadowOffsetX: 0,\\n            shadowColor: 'rgba(0, 0, 0, 0.5)'\\n          }\\n        }\\n      }\\n    ]\\n  }\\n  chart.setOption(option)\\n}\\n\\nconst initWorkloadChart = () => {\\n  if (!workloadChart.value) return\\n  \\n  const chart = echarts.init(workloadChart.value)\\n  const option = {\\n    tooltip: {\\n      trigger: 'axis',\\n      axisPointer: {\\n        type: 'shadow'\\n      }\\n    },\\n    grid: {\\n      left: '3%',\\n      right: '4%',\\n      bottom: '3%',\\n      containLabel: true\\n    },\\n    xAxis: {\\n      type: 'category',\\n      data: ['张三', '李四', '王五', '赵六', '钱七']\\n    },\\n    yAxis: {\\n      type: 'value'\\n    },\\n    series: [\\n      {\\n        name: '处理订单数',\\n        type: 'bar',\\n        data: [185, 178, 165, 158, 152],\\n        itemStyle: {\\n          color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [\\n            { offset: 0, color: '#409EFF' },\\n            { offset: 0.5, color: '#66b1ff' },\\n            { offset: 1, color: '#8cc5ff' }\\n          ])\\n        }\\n      }\\n    ]\\n  }\\n  chart.setOption(option)\\n}\\n\\nconst initPerformanceTrendChart = () => {\\n  if (!performanceTrendChart.value) return\\n  \\n  const chart = echarts.init(performanceTrendChart.value)\\n  const option = {\\n    tooltip: {\\n      trigger: 'axis'\\n    },\\n    grid: {\\n      left: '3%',\\n      right: '4%',\\n      bottom: '3%',\\n      containLabel: true\\n    },\\n    xAxis: {\\n      type: 'category',\\n      data: ['1月', '2月', '3月', '4月', '5月', '6月']\\n    },\\n    yAxis: {\\n      type: 'value',\\n      axisLabel: {\\n        formatter: '{value}单/人'\\n      }\\n    },\\n    series: [\\n      {\\n        name: '人均订单',\\n        type: 'line',\\n        smooth: true,\\n        data: [35, 36, 37, 38, 39, 41],\\n        itemStyle: { color: '#67C23A' },\\n        areaStyle: {\\n          color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [\\n            { offset: 0, color: 'rgba(103, 194, 58, 0.3)' },\\n            { offset: 1, color: 'rgba(103, 194, 58, 0.05)' }\\n          ])\\n        }\\n      }\\n    ]\\n  }\\n  chart.setOption(option)\\n}\\n\\nconst initTrainingChart = () => {\\n  if (!trainingChart.value) return\\n  \\n  const chart = echarts.init(trainingChart.value)\\n  const option = {\\n    tooltip: {\\n      trigger: 'axis'\\n    },\\n    legend: {\\n      data: ['培训次数', '培训时长', '员工满意度']\\n    },\\n    grid: {\\n      left: '3%',\\n      right: '4%',\\n      bottom: '3%',\\n      containLabel: true\\n    },\\n    xAxis: {\\n      type: 'category',\\n      data: ['1月', '2月', '3月', '4月', '5月', '6月']\\n    },\\n    yAxis: [\\n      {\\n        type: 'value',\\n        name: '次数/时长',\\n        position: 'left'\\n      },\\n      {\\n        type: 'value',\\n        name: '满意度',\\n        position: 'right',\\n        max: 5\\n      }\\n    ],\\n    series: [\\n      {\\n        name: '培训次数',\\n        type: 'bar',\\n        data: [4, 5, 4, 6, 5, 6],\\n        itemStyle: { color: '#409EFF' }\\n      },\\n      {\\n        name: '培训时长',\\n        type: 'line',\\n        smooth: true,\\n        data: [12, 15, 12, 18, 15, 18],\\n        itemStyle: { color: '#67C23A' }\\n      },\\n      {\\n        name: '员工满意度',\\n        type: 'line',\\n        smooth: true,\\n        yAxisIndex: 1,\\n        data: [4.0, 4.1, 4.1, 4.2, 4.2, 4.2],\\n        itemStyle: { color: '#E6A23C' }\\n      }\\n    ]\\n  }\\n  chart.setOption(option)\\n}\\n\\nwatch(viewMode, async (newMode) => {\\n  await nextTick()\\n  \\n  if (newMode === 'efficiency') {\\n    initTableUtilizationChart()\\n    initPeakHoursChart()\\n    initOrderProcessingChart()\\n    initCookingSpeedChart()\\n    initEfficiencyTrendChart()\\n  } else if (newMode === 'cost') {\\n    initCostCompositionChart()\\n    initCostTrendChart()\\n    initUnitCostChart()\\n    initCostBenefitChart()\\n  } else if (newMode === 'quality') {\\n    initSatisfactionTrendChart()\\n    initComplaintRateChart()\\n    initResponseTimeChart()\\n    initFeedbackChart()\\n  } else if (newMode === 'staff') {\\n    initWorkloadChart()\\n    initPerformanceTrendChart()\\n    initTrainingChart()\\n  }\\n})\\n\\nonMounted(async () => {\\n  await nextTick()\\n  initTableUtilizationChart()\\n  initPeakHoursChart()\\n  initOrderProcessingChart()\\n  initCookingSpeedChart()\\n  initEfficiencyTrendChart()\\n})\\n</script>\\n\\n<style scoped lang=\\\"scss\\\">\\n.operational-analytics {\\n  .analytics-header {\\n    display: flex;\\n    justify-content: space-between;\\n    align-items: center;\\n    margin-bottom: 20px;\\n    \\n    .header-title {\\n      h3 {\\n        margin: 0 0 5px 0;\\n        font-size: 20px;\\n        color: #303133;\\n      }\\n      \\n      p {\\n        margin: 0;\\n        font-size: 14px;\\n        color: #909399;\\n      }\\n    }\\n  }\\n\\n  .analytics-content {\\n    .chart-container {\\n      width: 100%;\\n      height: 350px;\\n    }\\n\\n    .large-chart-container {\\n      width: 100%;\\n      height: 500px;\\n    }\\n\\n    .efficiency-metric-card,\\n    .cost-metric-card,\\n    .quality-metric-card,\\n    .staff-metric-card {\\n      .metric-content {\\n        display: flex;\\n        align-items: center;\\n\\n        .metric-icon {\\n          width: 50px;\\n          height: 50px;\\n          border-radius: 8px;\\n          display: flex;\\n          align-items: center;\\n          justify-content: center;\\n          color: white;\\n          margin-right: 15px;\\n        }\\n\\n        .metric-info {\\n          flex: 1;\\n\\n          .metric-value {\\n            font-size: 24px;\\n            font-weight: bold;\\n            color: #303133;\\n            margin-bottom: 5px;\\n          }\\n\\n          .metric-label {\\n            font-size: 14px;\\n            color: #606266;\\n            margin-bottom: 5px;\\n          }\\n\\n          .metric-change {\\n            font-size: 12px;\\n\\n            &.positive {\\n              color: #67c23a;\\n            }\\n\\n            &.negative {\\n              color: #f56c6c;\\n            }\\n          }\\n        }\\n      }\\n    }\\n\\n    .cost-suggestions,\\n    .scheduling-suggestions {\\n      max-height: 350px;\\n      overflow-y: auto;\\n    }\\n\\n    .quality-scores {\\n      .score-item {\\n        padding: 15px;\\n        background: #f5f7fa;\\n        border-radius: 8px;\\n        margin-bottom: 10px;\\n\\n        .score-label {\\n          font-size: 14px;\\n          color: #606266;\\n          margin-bottom: 8px;\\n        }\\n\\n        .score-value {\\n          display: flex;\\n          align-items: center;\\n        }\\n      }\\n    }\\n  }\\n}\\n</style>\\n\",\"originTextLength\":34901,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768859100507}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/views/DataAnalytics.vue": "[{\"originRange\":{\"start\":{\"line\":84,\"character\":0},\"end\":{\"line\":84,\"character\":26}},\"modifyRange\":{\"start\":{\"line\":84,\"character\":0},\"end\":{\"line\":84,\"character\":26}},\"action\":\"None\",\"isLine\":false,\"originText\":\"        <SalesAnalytics />\",\"originAcceptText\":\"        <SalesAnalytics />\",\"originTextLength\":26,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768859175163},{\"originRange\":{\"start\":{\"line\":195,\"character\":0},\"end\":{\"line\":195,\"character\":29}},\"modifyRange\":{\"start\":{\"line\":195,\"character\":0},\"end\":{\"line\":195,\"character\":29}},\"action\":\"None\",\"isLine\":false,\"originText\":\"        <CustomerAnalytics />\",\"originAcceptText\":\"        <CustomerAnalytics />\",\"originTextLength\":29,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768859175197},{\"originRange\":{\"start\":{\"line\":250,\"character\":0},\"end\":{\"line\":250,\"character\":25}},\"modifyRange\":{\"start\":{\"line\":250,\"character\":0},\"end\":{\"line\":250,\"character\":25}},\"action\":\"None\",\"isLine\":false,\"originText\":\"        <MenuAnalytics />\",\"originAcceptText\":\"        <MenuAnalytics />\",\"originTextLength\":25,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768859175219},{\"originRange\":{\"start\":{\"line\":289,\"character\":0},\"end\":{\"line\":289,\"character\":32}},\"modifyRange\":{\"start\":{\"line\":289,\"character\":0},\"end\":{\"line\":289,\"character\":32}},\"action\":\"None\",\"isLine\":false,\"originText\":\"        <OperationalAnalytics />\",\"originAcceptText\":\"        <OperationalAnalytics />\",\"originTextLength\":32,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768859175241},{\"originRange\":{\"start\":{\"line\":265,\"character\":0},\"end\":{\"line\":268,\"character\":82}},\"modifyRange\":{\"start\":{\"line\":265,\"character\":0},\"end\":{\"line\":268,\"character\":82}},\"action\":\"None\",\"isLine\":false,\"originText\":\"import SalesAnalytics from \\\\'@/components/analytics/SalesAnalytics.vue\\\\'\\\\nimport CustomerAnalytics from \\\\'@/components/analytics/CustomerAnalytics.vue\\\\'\\\\nimport MenuAnalytics from \\\\'@/components/analytics/MenuAnalytics.vue\\\\'\\\\nimport OperationalAnalytics from \\\\'@/components/analytics/OperationalAnalytics.vue\\\\'\",\"originAcceptText\":\"import SalesAnalytics from '@/components/analytics/SalesAnalytics.vue'\\nimport CustomerAnalytics from '@/components/analytics/CustomerAnalytics.vue'\\nimport MenuAnalytics from '@/components/analytics/MenuAnalytics.vue'\\nimport OperationalAnalytics from '@/components/analytics/OperationalAnalytics.vue'\",\"originTextLength\":299,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768859189749}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/docs/YYC3-Cater-Platform-%E6%96%87%E6%A1%A3%E9%97%AD%E7%8E%AF/YYC3-Cater-%E7%94%A8%E6%88%B7%E6%89%8B%E5%86%8C/%E6%95%B0%E6%8D%AE%E5%88%86%E6%9E%90%E5%8A%9F%E8%83%BD%E6%A8%A1%E5%9D%97%E7%94%A8%E6%88%B7%E6%89%8B%E5%86%8C.md": "[{\"originRange\":{\"start\":{\"line\":2,\"character\":0},\"end\":{\"line\":29,\"character\":9}},\"modifyRange\":{\"start\":{\"line\":2,\"character\":0},\"end\":{\"line\":29,\"character\":9}},\"action\":\"None\",\"isLine\":false,\"originText\":\"## 文档信息\\\\n\\\\n| 项目 | 内容 |\\\\n|------|------|\\\\n| 模块名称 | 数据分析功能模块 |\\\\n| 文档版本 | v1.0.0 |\\\\n| 创建日期 | 2025-01-20 |\\\\n| 最后更新 | 2025-01-20 |\\\\n| 适用对象 | 系统管理员、业务分析师、店长/经理 |\\\\n\\\\n---\\\\n\\\\n## 一、模块概述\\\\n\\\\n### 1.1 功能简介\\\\n\\\\n数据分析功能模块为餐饮企业提供全方位的业务数据洞察与分析能力，帮助管理者通过数据驱动的方式优化运营决策。模块包含数据采集、数据清洗、销售分析、客户分析、菜单分析、运营分析、预测分析和异常预警等功能。\\\\n\\\\n### 1.2 核心价值\\\\n\\\\n- **数据驱动决策**：基于真实数据进行分析，避免主观判断\\\\n- **实时监控**：实时掌握业务运营状况\\\\n- **趋势预测**：预测未来业务趋势，提前做好准备\\\\n- **异常预警**：及时发现异常情况，快速响应\\\\n- **优化建议**：提供智能优化建议，提升运营效率\\\\n\\\\n### 1.3 适用场景\\\\n\\\\n- 日常运营监控\\\\n- 销售业绩分析\\\\n- 客户行为分析\\\\n- 菜单优化决策\\\\n- 成本控制分析\\\\n- 服务质量提升\\\\n- 业务规划制定\\\\n\\\\n---\\\\n\\\\n## 二、功能导航\",\"originAcceptText\":\"## 文档信息\\n\\n| 项目 | 内容 |\\n|------|------|\\n| 模块名称 | 数据分析功能模块 |\\n| 文档版本 | v1.0.0 |\\n| 创建日期 | 2025-01-20 |\\n| 最后更新 | 2025-01-20 |\\n| 适用对象 | 系统管理员、业务分析师、店长/经理 |\\n\\n---\\n\\n## 一、模块概述\\n\\n### 1.1 功能简介\\n\\n数据分析功能模块为餐饮企业提供全方位的业务数据洞察与分析能力，帮助管理者通过数据驱动的方式优化运营决策。模块包含数据采集、数据清洗、销售分析、客户分析、菜单分析、运营分析、预测分析和异常预警等功能。\\n\\n### 1.2 核心价值\\n\\n- **数据驱动决策**：基于真实数据进行分析，避免主观判断\\n- **实时监控**：实时掌握业务运营状况\\n- **趋势预测**：预测未来业务趋势，提前做好准备\\n- **异常预警**：及时发现异常情况，快速响应\\n- **优化建议**：提供智能优化建议，提升运营效率\\n\\n### 1.3 适用场景\\n\\n- 日常运营监控\\n- 销售业绩分析\\n- 客户行为分析\\n- 菜单优化决策\\n- 成本控制分析\\n- 服务质量提升\\n- 业务规划制定\\n\\n---\\n\\n## 二、功能导航\",\"originTextLength\":519,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768859269765},{\"originRange\":{\"start\":{\"line\":8,\"character\":0},\"end\":{\"line\":552,\"character\":12}},\"modifyRange\":{\"start\":{\"line\":8,\"character\":0},\"end\":{\"line\":552,\"character\":12}},\"action\":\"None\",\"isLine\":false,\"originText\":\"### 2.1 模块入口\\\\n\\\\n1. 登录系统后，点击左侧导航栏的\\\\\\\"数据分析\\\\\\\"菜单\\\\n2. 进入数据分析主页面，默认显示销售分析标签页\\\\n\\\\n### 2.2 标签页说明\\\\n\\\\n| 标签页 | 功能说明 |\\\\n|--------|----------|\\\\n| 销售分析 | 销售收入、订单、商品等多维度分析 |\\\\n| 客户分析 | 客户增长、分段、行为、价值等分析 |\\\\n| 菜单分析 | 菜品表现、盈利能力、优化建议等分析 |\\\\n| 运营分析 | 运营效率、成本、质量、员工等分析 |\\\\n| 预测分析 | 销量、客户、需求等预测分析 |\\\\n| 异常预警 | 销售异常、库存异常、运营异常等预警 |\\\\n| 自定义仪表板 | 自定义数据可视化仪表板 |\\\\n\\\\n---\\\\n\\\\n## 三、数据采集管理\\\\n\\\\n### 3.1 功能概述\\\\n\\\\n数据采集管理用于配置和管理数据源，实现从多个业务系统自动采集数据。\\\\n\\\\n### 3.2 数据源配置\\\\n\\\\n#### 3.2.1 添加数据源\\\\n\\\\n1. 点击\\\\\\\"添加数据源\\\\\\\"按钮\\\\n2. 填写数据源信息：\\\\n   - **数据源名称**：输入数据源的名称，如\\\\\\\"订单系统\\\\\\\"\\\\n   - **数据源类型**：选择数据源类型（订单系统、会员系统、库存系统、支付系统、评价系统、外部API）\\\\n   - **采集方式**：选择采集方式（实时采集、批量采集）\\\\n   - **采集频率**：批量采集时设置采集频率（每小时、每6小时、每天、每周）\\\\n   - **连接配置**：输入连接配置JSON，例如：\\\\n     ```json\\\\n     {\\\\n       \\\\\\\"url\\\\\\\": \\\\\\\"http://api.example.com\\\\\\\",\\\\n       \\\\\\\"apiKey\\\\\\\": \\\\\\\"your_api_key\\\\\\\",\\\\n       \\\\\\\"timeout\\\\\\\": 30000\\\\n     }\\\\n     ```\\\\n   - **启用状态**：选择是否启用该数据源\\\\n3. 点击\\\\\\\"保存\\\\\\\"按钮完成添加\\\\n\\\\n#### 3.2.2 编辑数据源\\\\n\\\\n1. 在数据源列表中找到要编辑的数据源\\\\n2. 点击\\\\\\\"编辑\\\\\\\"按钮\\\\n3. 修改数据源信息\\\\n4. 点击\\\\\\\"保存\\\\\\\"按钮完成编辑\\\\n\\\\n#### 3.2.3 删除数据源\\\\n\\\\n1. 在数据源列表中找到要删除的数据源\\\\n2. 点击\\\\\\\"删除\\\\\\\"按钮\\\\n3. 确认删除操作\\\\n\\\\n#### 3.2.4 立即同步\\\\n\\\\n1. 在数据源列表中找到要同步的数据源\\\\n2. 点击\\\\\\\"立即同步\\\\\\\"按钮\\\\n3. 系统开始执行数据同步\\\\n4. 同步完成后查看同步状态\\\\n\\\\n### 3.3 数据源监控\\\\n\\\\n#### 3.3.1 查看同步状态\\\\n\\\\n- **成功**：数据同步成功\\\\n- **失败**：数据同步失败，可查看错误信息\\\\n- **待同步**：等待同步\\\\n\\\\n#### 3.3.2 查看同步日志\\\\n\\\\n1. 在数据源列表中点击\\\\\\\"日志\\\\\\\"按钮\\\\n2. 查看该数据源的同步日志，包括：\\\\n   - 同步时间\\\\n   - 同步状态\\\\n   - 采集记录数\\\\n   - 耗时\\\\n   - 错误信息\\\\n\\\\n### 3.4 数据源筛选\\\\n\\\\n1. 使用筛选条件过滤数据源：\\\\n   - **数据源类型**：按类型筛选\\\\n   - **采集方式**：按采集方式筛选\\\\n   - **状态**：按同步状态筛选\\\\n2. 点击\\\\\\\"查询\\\\\\\"按钮执行筛选\\\\n3. 点击\\\\\\\"重置\\\\\\\"按钮清除筛选条件\\\\n\\\\n---\\\\n\\\\n## 四、数据清洗管理\\\\n\\\\n### 4.1 功能概述\\\\n\\\\n数据清洗管理用于配置和管理数据清洗规则，自动识别和处理数据质量问题。\\\\n\\\\n### 4.2 清洗规则配置\\\\n\\\\n#### 4.2.1 新建规则\\\\n\\\\n1. 点击\\\\\\\"新建规则\\\\\\\"按钮\\\\n2. 填写规则信息：\\\\n   - **规则名称**：输入规则名称\\\\n   - **规则类型**：选择规则类型\\\\n     - **格式校验**：校验数据格式（手机号、邮箱、日期、数字等）\\\\n     - **重复数据**：识别和去除重复数据\\\\n     - **异常值检测**：检测异常值（标准差法、四分位距法、Z-Score法）\\\\n     - **完整性检查**：检查数据完整性（必填字段检查）\\\\n     - **一致性检查**：检查数据一致性（自定义SQL规则）\\\\n   - **规则配置**：根据规则类型配置具体参数\\\\n   - **优先级**：设置规则执行优先级（0-100）\\\\n   - **启用状态**：选择是否启用该规则\\\\n3. 点击\\\\\\\"保存\\\\\\\"按钮完成创建\\\\n\\\\n#### 4.2.2 编辑规则\\\\n\\\\n1. 在规则列表中找到要编辑的规则\\\\n2. 点击\\\\\\\"编辑\\\\\\\"按钮\\\\n3. 修改规则信息\\\\n4. 点击\\\\\\\"保存\\\\\\\"按钮完成编辑\\\\n\\\\n#### 4.2.3 删除规则\\\\n\\\\n1. 在规则列表中找到要删除的规则\\\\n2. 点击\\\\\\\"删除\\\\\\\"按钮\\\\n3. 确认删除操作\\\\n\\\\n#### 4.2.4 测试规则\\\\n\\\\n1. 在规则列表中找到要测试的规则\\\\n2. 点击\\\\\\\"测试\\\\\\\"按钮\\\\n3. 系统执行规则测试\\\\n4. 查看测试结果，包括发现问题记录数\\\\n\\\\n### 4.3 执行数据清洗\\\\n\\\\n#### 4.3.1 执行清洗\\\\n\\\\n1. 点击\\\\\\\"执行清洗\\\\\\\"按钮\\\\n2. 配置清洗参数：\\\\n   - **执行范围**：选择执行范围（全部数据、指定日期范围）\\\\n   - **日期范围**：指定日期范围时选择开始和结束日期\\\\n   - **选择规则**：选择要执行的规则（默认全部）\\\\n3. 点击\\\\\\\"执行清洗\\\\\\\"按钮\\\\n4. 系统开始执行数据清洗\\\\n5. 查看清洗结果\\\\n\\\\n#### 4.3.2 查看清洗结果\\\\n\\\\n清洗结果包括：\\\\n- **总记录数**：处理的总记录数\\\\n- **清洗记录数**：成功清洗的记录数\\\\n- **无效记录数**：发现的无效记录数\\\\n- **问题列表**：详细的问题列表，包括：\\\\n  - 规则名称\\\\n  - 问题类型\\\\n  - 问题记录数\\\\n  - 问题描述\\\\n  - 处理动作\\\\n\\\\n### 4.4 清洗规则筛选\\\\n\\\\n1. 使用筛选条件过滤规则：\\\\n   - **规则类型**：按类型筛选\\\\n   - **启用状态**：按启用状态筛选\\\\n2. 点击\\\\\\\"查询\\\\\\\"按钮执行筛选\\\\n3. 点击\\\\\\\"重置\\\\\\\"按钮清除筛选条件\\\\n\\\\n---\\\\n\\\\n## 五、销售分析\\\\n\\\\n### 5.1 功能概述\\\\n\\\\n销售分析提供销售数据的全方位分析，帮助了解销售趋势和收入表现。\\\\n\\\\n### 5.2 视图切换\\\\n\\\\n销售分析包含以下视图：\\\\n- **总览**：销售总收入、订单数、平均客单价等核心指标\\\\n- **趋势**：销售趋势分析，包括日趋势、周趋势、月趋势\\\\n- **商品**：商品销售排行、类别销售对比、商品关联分析\\\\n- **预测**：销售预测，包括短期、中期、长期预测\\\\n\\\\n### 5.3 销售总览\\\\n\\\\n#### 5.3.1 查看销售收入趋势\\\\n\\\\n- 显示最近7天的销售收入趋势图\\\\n- 可查看收入和利润两条曲线\\\\n- 鼠标悬停查看具体数值\\\\n\\\\n#### 5.3.2 查看销售分布\\\\n\\\\n- 显示销售分布饼图\\\\n- 包括堂食、外卖、打包、团购等类型\\\\n- 可查看各类型的销售额和占比\\\\n\\\\n#### 5.3.3 查看按小时销售分析\\\\n\\\\n- 显示24小时销售趋势图\\\\n- 可查看各时段的订单数量\\\\n- 帮助识别高峰时段\\\\n\\\\n#### 5.3.4 查看支付方式分布\\\\n\\\\n- 显示支付方式分布饼图\\\\n- 包括微信支付、支付宝、现金、其他等\\\\n- 可查看各支付方式的销售额和占比\\\\n\\\\n### 5.4 销售趋势\\\\n\\\\n#### 5.4.1 切换时间粒度\\\\n\\\\n- 选择日趋势、周趋势、月趋势\\\\n- 系统自动刷新数据\\\\n\\\\n#### 5.4.2 查看趋势图\\\\n\\\\n- 显示销售趋势图\\\\n- 包括收入、订单数、客单价三条曲线\\\\n- 可查看同比、环比增长情况\\\\n\\\\n### 5.5 商品销售\\\\n\\\\n#### 5.5.1 查看热销商品排行\\\\n\\\\n- 显示热销商品排行榜\\\\n- 包括排名、商品名称、销量、收入、增长率\\\\n- 可按销量、收入、增长率排序\\\\n\\\\n#### 5.5.2 查看类别销售对比\\\\n\\\\n- 显示类别销售对比柱状图\\\\n- 包括凉菜、汤品、主食、热菜、饮品、甜点等\\\\n- 可查看各类别的销量对比\\\\n\\\\n#### 5.5.3 查看商品关联分析\\\\n\\\\n- 显示商品关联网络图\\\\n- 可查看商品之间的关联关系\\\\n- 帮助优化套餐组合\\\\n\\\\n### 5.6 销售预测\\\\n\\\\n#### 5.6.1 配置预测参数\\\\n\\\\n- **预测周期**：选择预测周期（7天、15天、30天、60天、90天）\\\\n- **预测模型**：选择预测模型（ARIMA、Prophet、LSTM、集成模型）\\\\n\\\\n#### 5.6.2 查看预测结果\\\\n\\\\n- 显示销售预测图\\\\n- 包括历史数据和预测数据\\\\n- 显示置信区间\\\\n- 可查看预测准确度指标\\\\n\\\\n#### 5.6.3 查看预测建议\\\\n\\\\n- 显示预测建议列表\\\\n- 包括销量增长建议、库存预警、新菜品推广等\\\\n- 可根据建议调整运营策略\\\\n\\\\n---\\\\n\\\\n## 六、客户分析\\\\n\\\\n### 6.1 功能概述\\\\n\\\\n客户分析提供客户数据的全方位分析，帮助了解客户行为和价值贡献。\\\\n\\\\n### 6.2 视图切换\\\\n\\\\n客户分析包含以下视图：\\\\n- **增长**：客户增长趋势、客户来源分析、客户留存率、客户流失分析\\\\n- **分段**：客户分段概览、分段特征分析、RFM客户价值矩阵\\\\n- **行为**：消费频次分布、消费金额分布、消费时间偏好、菜品偏好分析、客户行为路径\\\\n- **价值**：客户价值指标、客户价值趋势、高价值客户TOP10、客户生命周期价值分析\\\\n- **地理**：客户地理分布、区域销售排行、配送区域分析、区域对比分析\\\\n\\\\n### 6.3 客户增长\\\\n\\\\n#### 6.3.1 查看客户增长趋势\\\\n\\\\n- 显示客户增长趋势图\\\\n- 包括新增客户、活跃客户、流失客户三条曲线\\\\n- 可切换日增长、周增长、月增长\\\\n\\\\n#### 6.3.2 查看客户来源分析\\\\n\\\\n- 显示客户来源分布饼图\\\\n- 包括线上推广、线下活动、口碑推荐、社交媒体、其他等\\\\n- 可查看各来源的客户数和占比\\\\n\\\\n#### 6.3.3 查看客户留存率\\\\n\\\\n- 显示客户留存率趋势图\\\\n- 显示第1月到第6月的留存率\\\\n- 帮助评估客户忠诚度\\\\n\\\\n#### 6.3.4 查看客户流失分析\\\\n\\\\n- 显示客户流失率柱状图\\\\n- 显示各月的流失率\\\\n- 帮助识别流失趋势\\\\n\\\\n### 6.4 客户分段\\\\n\\\\n#### 6.4.1 查看客户分段概览\\\\n\\\\n- 显示客户分段列表\\\\n- 包括核心客户、重要客户、普通客户、潜在客户\\\\n- 可查看各分段的客户数、占比、平均消费、消费频次\\\\n\\\\n#### 6.4.2 查看分段特征分析\\\\n\\\\n- 显示客户分段雷达图\\\\n- 包括消费金额、消费频次、最近消费、客户忠诚度、推荐意愿等维度\\\\n- 帮助了解各分段客户特征\\\\n\\\\n#### 6.4.3 查看RFM客户价值矩阵\\\\n\\\\n- 显示RFM客户价值矩阵散点图\\\\n- X轴为最近消费，Y轴为消费频次\\\\n- 可查看各客户的RFM分布\\\\n- 帮助识别高价值客户\\\\n\\\\n### 6.5 客户行为\\\\n\\\\n#### 6.5.1 查看消费频次分布\\\\n\\\\n- 显示消费频次分布柱状图\\\\n- 显示各消费频次的客户数\\\\n- 帮助了解客户消费习惯\\\\n\\\\n#### 6.5.2 查看消费金额分布\\\\n\\\\n- 显示消费金额分布柱状图\\\\n- 显示各消费金额区间的客户数\\\\n- 帮助了解客户消费能力\\\\n\\\\n#### 6.5.3 查看消费时间偏好\\\\n\\\\n- 显示消费时间偏好柱状图\\\\n- 包括早餐、午餐、下午茶、晚餐、夜宵\\\\n- 帮助优化营业时间\\\\n\\\\n#### 6.5.4 查看菜品偏好分析\\\\n\\\\n- 显示菜品偏好分布饼图\\\\n- 包括热菜、主食、凉菜、汤品、饮品、甜点\\\\n- 帮助了解客户口味偏好\\\\n\\\\n#### 6.5.5 查看客户行为路径\\\\n\\\\n- 显示客户行为路径图\\\\n- 包括浏览菜单、加入购物车、下单、支付、评价、再次购买等环节\\\\n- 帮助优化客户体验\\\\n\\\\n### 6.6 客户价值\\\\n\\\\n#### 6.6.1 查看客户价值指标\\\\n\\\\n- 显示客户价值指标卡片\\\\n- 包括客户总数、平均终身价值、客户保留率、客户满意度\\\\n- 可查看各指标的环比变化\\\\n\\\\n#### 6.6.2 查看客户价值趋势\\\\n\\\\n- 显示客户价值趋势图\\\\n- 显示平均终身价值的变化趋势\\\\n- 帮助评估客户价值增长\\\\n\\\\n#### 6.6.3 查看高价值客户TOP10\\\\n\\\\n- 显示高价值客户排行榜\\\\n- 包括排名、客户姓名、终身价值\\\\n- 帮助识别重点客户\\\\n\\\\n#### 6.6.4 查看客户生命周期价值分析\\\\n\\\\n- 显示客户生命周期价值趋势图\\\\n- 包括核心客户、重要客户、普通客户、潜在客户的LTV趋势\\\\n- 帮助评估客户价值增长潜力\\\\n\\\\n### 6.7 客户地理\\\\n\\\\n#### 6.7.1 查看客户地理分布\\\\n\\\\n- 显示客户地理分布地图\\\\n- 可查看各地区的客户数\\\\n- 帮助优化区域营销策略\\\\n\\\\n#### 6.7.2 查看区域销售排行\\\\n\\\\n- 显示区域销售排行榜\\\\n- 包括排名、区域、客户数、销售额\\\\n- 帮助识别重点区域\\\\n\\\\n#### 6.7.3 查看配送区域分析\\\\n\\\\n- 显示配送区域分析柱状图\\\\n- 包括3公里内、3-5公里、5-7公里、7-10公里、10公里以上\\\\n- 帮助优化配送策略\\\\n\\\\n#### 6.7.4 查看区域对比分析\\\\n\\\\n- 显示区域对比分析图\\\\n- 包括客户数和销售额两个维度\\\\n- 帮助对比各区域表现\\\\n\\\\n---\\\\n\\\\n## 七、菜单分析\\\\n\\\\n### 7.1 功能概述\\\\n\\\\n菜单分析提供菜单数据的全方位分析，帮助优化菜单结构和定价策略。\\\\n\\\\n### 7.2 视图切换\\\\n\\\\n菜单分析包含以下视图：\\\\n- **表现**：菜品销量排行、类别销售对比、菜品评价分析、菜品复购率\\\\n- **盈利**：整体毛利率、平均菜品毛利率、成本占比、利润增长率、类别毛利率分析、菜品毛利率排行、成本结构分析\\\\n- **优化**：滞销菜品识别、新菜品表现、价格弹性分析、菜单结构优化建议\\\\n- **矩阵**：BCG矩阵分析、明星菜品、问题菜品\\\\n\\\\n### 7.3 菜品表现\\\\n\\\\n#### 7.3.1 查看菜品销量排行\\\\n\\\\n- 显示热销菜品排行榜\\\\n- 包括排名、菜品名称、类别、销量、收入、评分\\\\n- 可按销量、收入、评分排序\\\\n\\\\n#### 7.3.2 查看类别销售对比\\\\n\\\\n- 显示类别销售对比柱状图\\\\n- 包括凉菜、汤品、主食、热菜、饮品、甜点\\\\n- 可查看各类别的销量对比\\\\n\\\\n#### 7.3.3 查看菜品评价分析\\\\n\\\\n- 显示菜品评价分布饼图\\\\n- 包括5星、4星、3星、2星、1星\\\\n- 可查看各评分的菜品数\\\\n\\\\n#### 7.3.4 查看菜品复购率\\\\n\\\\n- 显示菜品复购率柱状图\\\\n- 显示各菜品的复购率\\\\n- 帮助识别受欢迎的菜品\\\\n\\\\n### 7.4 盈利能力\\\\n\\\\n#### 7.4.1 查看盈利指标\\\\n\\\\n- 显示盈利指标卡片\\\\n- 包括整体毛利率、平均菜品毛利率、成本占比、利润增长率\\\\n- 可查看各指标的环比变化\\\\n\\\\n#### 7.4.2 查看类别毛利率分析\\\\n\\\\n- 显示类别毛利率分析柱状图\\\\n- 包括凉菜、汤品、主食、热菜、饮品、甜点\\\\n- 可查看各类别的毛利率\\\\n\\\\n#### 7.4.3 查看菜品毛利率排行\\\\n\\\\n- 显示高毛利率菜品排行榜\\\\n- 包括排名、菜品名称、毛利率、利润\\\\n- 可按毛利率、利润排序\\\\n\\\\n#### 7.4.4 查看成本结构分析\\\\n\\\\n- 显示成本结构分析饼图\\\\n- 包括食材成本、人工成本、租金成本、水电成本、其他成本\\\\n- 可查看各成本的占比\\\\n\\\\n### 7.5 菜单优化\\\\n\\\\n#### 7.5.1 查看滞销菜品识别\\\\n\\\\n- 显示滞销菜品列表\\\\n- 包括排名、菜品名称、销量、未售天数、库存\\\\n- 可执行下架或促销操作\\\\n\\\\n#### 7.5.2 查看新菜品表现\\\\n\\\\n- 显示新菜品列表\\\\n- 包括排名、菜品名称、上线日期、销量、评分、状态\\\\n- 可查看新菜品的表现\\\\n\\\\n#### 7.5.3 查看价格弹性分析\\\\n\\\\n- 显示价格弹性分析图\\\\n- 包括价格和销量两条曲线\\\\n- 帮助评估价格对销量的影响\\\\n\\\\n#### 7.5.4 查看菜单结构优化建议\\\\n\\\\n- 显示菜单结构优化建议列表\\\\n- 包括下架滞销菜品、推出春季特色菜品、调整热销菜品价格、优化菜单结构等\\\\n- 可查看预期影响\\\\n\\\\n### 7.6 BCG矩阵\\\\n\\\\n#### 7.6.1 查看BCG矩阵分析\\\\n\\\\n- 显示BCG矩阵散点图\\\\n- X轴为市场份额，Y轴为增长率\\\\n- 可查看各菜品的BCG分布\\\\n- 帮助识别明星、现金牛、问题、瘦狗类菜品\\\\n\\\\n#### 7.6.2 查看明星菜品\\\\n\\\\n- 显示明星菜品列表\\\\n- 包括排名、菜品名称、市场份额、增长率\\\\n- 帮助识别重点推广菜品\\\\n\\\\n#### 7.6.3 查看问题菜品\\\\n\\\\n- 显示问题菜品列表\\\\n- 包括排名、菜品名称、市场份额、增长率\\\\n- 帮助识别需要优化的菜品\\\\n\\\\n---\\\\n\\\\n## 八、运营分析\\\\n\\\\n### 8.1 功能概述\\\\n\\\\n运营分析提供运营数据的全方位分析，帮助监控运营效率和服务质量。\\\\n\\\\n### 8.2 视图切换\\\\n\\\\n运营分析包含以下视图：\\\\n- **效率**：桌位利用率、订单处理效率、厨房效率、员工效率、高峰时段分析、订单处理时间、出餐速度分析、运营效率趋势\\\\n- **成本**：总成本、人工成本、食材成本、成本占比、成本构成分析、成本趋势、单位成本分析、成本效益分析、成本控制建议\\\\n- **质量**：客户满意度、投诉率、平均响应时间、问题解决率、客户满意度趋势、投诉率分析、处理时效分析、服务质量评分、客户反馈分析\\\\n- **员工**：员工总数、人均订单、平均处理时间、员工满意度、员工效率排行、员工工作量分布、员工绩效趋势、排班优化建议、员工培训与发展\\\\n\\\\n### 8.3 运营效率\\\\n\\\\n#### 8.3.1 查看效率指标\\\\n\\\\n- 显示效率指标卡片\\\\n- 包括桌位利用率、订单处理效率、厨房效率、员工效率\\\\n- 可查看各指标的环比变化\\\\n\\\\n#### 8.3.2 查看桌位利用率\\\\n\\\\n- 显示桌位利用率趋势图\\\\n- 显示一周的桌位利用率\\\\n- 帮助优化桌位安排\\\\n\\\\n#### 8.3.3 查看高峰时段分析\\\\n\\\\n- 显示高峰时段分析柱状图\\\\n- 显示24小时的订单数量\\\\n- 帮助识别高峰时段\\\\n\\\\n#### 8.3.4 查看订单处理时间\\\\n\\\\n- 显示订单处理时间柱状图\\\\n- 包括接单、确认、制作、出餐、配送、完成等环节\\\\n- 帮助优化订单处理流程\\\\n\\\\n#### 8.3.5 查看出餐速度分析\\\\n\\\\n- 显示出餐速度分析柱状图\\\\n- 包括凉菜、汤品、热菜、主食、饮品\\\\n- 帮助优化出餐流程\\\\n\\\\n#### 8.3.6 查看运营效率趋势\\\\n\\\\n- 显示运营效率趋势图\\\\n- 包括桌位利用率、订单处理效率、厨房效率、员工效率\\\\n- 帮助评估运营效率变化\\\\n\\\\n### 8.4 运营成本\\\\n\\\\n#### 8.4.1 查看成本指标\\\\n\\\\n- 显示成本指标卡片\\\\n- 包括总成本、人工成本、食材成本、成本占比\\\\n- 可查看各指标的环比变化\\\\n\\\\n#### 8.4.2 查看成本构成分析\\\\n\\\\n- 显示成本构成分析饼图\\\\n- 包括食材成本、人工成本、租金成本、水电成本、其他成本\\\\n- 可查看各成本的占比\\\\n\\\\n#### 8.4.3 查看成本趋势\\\\n\\\\n- 显示成本趋势图\\\\n- 显示最近6个月的总成本变化\\\\n- 帮助评估成本变化趋势\\\\n\\\\n#### 8.4.4 查看单位成本分析\\\\n\\\\n- 显示单位成本分析柱状图\\\\n- 包括堂食、外卖、打包、团购\\\\n- 帮助对比各渠道的单位成本\\\\n\\\\n#### 8.4.5 查看成本效益分析\\\\n\\\\n- 显示成本效益分析图\\\\n- 包括收入、成本、利润\\\\n- 帮助评估成本效益\\\\n\\\\n#### 8.4.6 查看成本控制建议\\\\n\\\\n- 显示成本控制建议列表\\\\n- 包括优化食材采购、调整人员排班、降低能源消耗等\\\\n- 可根据建议调整成本控制策略\\\\n\\\\n### 8.5 服务质量\\\\n\\\\n#### 8.5.1 查看质量指标\\\\n\\\\n- 显示质量指标卡片\\\\n- 包括客户满意度、投诉率、平均响应时间、问题解决率\\\\n- 可查看各指标的环比变化\\\\n\\\\n#### 8.5.2 查看客户满意度趋势\\\\n\\\\n- 显示客户满意度趋势图\\\\n- 显示最近6个月的客户满意度变化\\\\n- 帮助评估服务质量变化\\\\n\\\\n#### 8.5.3 查看投诉率分析\\\\n\\\\n- 显示投诉率趋势图\\\\n- 显示最近6个月的投诉率变化\\\\n- 帮助评估投诉情况\\\\n\\\\n#### 8.5.4 查看处理时效分析\\\\n\\\\n- 显示处理时效趋势图\\\\n- 显示最近6个月的平均响应时间变化\\\\n- 帮助评估处理时效\\\\n\\\\n#### 8.5.5 查看服务质量评分\\\\n\\\\n- 显示服务质量评分列表\\\\n- 包括服务态度、菜品质量、环境卫生、出餐速度、性价比\\\\n- 可查看各维度的评分\\\\n\\\\n#### 8.5.6 查看客户反馈分析\\\\n\\\\n- 显示客户反馈分析饼图\\\\n- 包括好评、中评、差评、建议\\\\n- 可查看各反馈的数量和占比\\\\n\\\\n### 8.6 员工管理\\\\n\\\\n#### 8.6.1 查看员工指标\\\\n\\\\n- 显示员工指标卡片\\\\n- 包括员工总数、人均订单、平均处理时间、员工满意度\\\\n- 可查看各指标的环比变化\\\\n\\\\n#### 8.6.2 查看员工效率排行\\\\n\\\\n- 显示员工效率排行榜\\\\n- 包括排名、姓名、职位、处理订单、平均时间、满意度\\\\n- 可按处理订单、平均时间、满意度排序\\\\n\\\\n#### 8.6.3 查看员工工作量分布\\\\n\\\\n- 显示员工工作量分布柱状图\\\\n- 显示各员工处理的订单数\\\\n- 帮助优化人员安排\\\\n\\\\n#### 8.6.4 查看员工绩效趋势\\\\n\\\\n- 显示员工绩效趋势图\\\\n- 显示最近6个月的人均订单变化\\\\n- 帮助评估员工绩效变化\\\\n\\\\n#### 8.6.5 查看排班优化建议\\\\n\\\\n- 显示排班优化建议列表\\\\n- 包括增加高峰期人手、优化员工培训、实施绩效考核等\\\\n- 可根据建议调整排班策略\\\\n\\\\n#### 8.6.6 查看员工培训与发展\\\\n\\\\n- 显示员工培训与发展图\\\\n- 包括培训次数、培训时长、员工满意度\\\\n- 帮助评估培训效果\\\\n\\\\n---\\\\n\\\\n## 九、异常预警\\\\n\\\\n### 9.1 功能概述\\\\n\\\\n异常预警用于监控业务数据，及时发现异常情况并发送预警通知。\\\\n\\\\n### 9.2 预警类型\\\\n\\\\n| 预警类型 | 说明 |\\\\n|----------|------|\\\\n| 销售异常 | 销售额异常波动、订单量异常波动、客单价异常波动 |\\\\n| 库存异常 | 库存不足预警、库存积压预警、库存周转异常、损耗异常预警 |\\\\n| 运营异常 | 服务质量下降、投诉率上升、处理时效延长、运营效率下降 |\\\\n| 系统异常 | 数据采集失败、数据同步延迟、系统性能下降、系统错误告警 |\\\\n\\\\n### 9.3 预警规则配置\\\\n\\\\n#### 9.3.1 添加预警规则\\\\n\\\\n1. 点击\\\\\\\"添加规则\\\\\\\"按钮\\\\n2. 填写预警规则信息：\\\\n   - **规则名称**：输入规则名称\\\\n   - **预警类型**：选择预警类型\\\\n   - **条件配置**：配置预警条件\\\\n   - **严重程度**：选择严重程度（低、中、高、严重）\\\\n   - **通知渠道**：配置通知渠道（邮件、短信、Webhook）\\\\n   - **启用状态**：选择是否启用该规则\\\\n3. 点击\\\\\\\"保存\\\\\\\"按钮完成添加\\\\n\\\\n#### 9.3.2 编辑预警规则\\\\n\\\\n1. 在预警规则列表中找到要编辑的规则\\\\n2. 点击\\\\\\\"编辑\\\\\\\"按钮\\\\n3. 修改预警规则信息\\\\n4. 点击\\\\\\\"保存\\\\\\\"按钮完成编辑\\\\n\\\\n#### 9.3.3 删除预警规则\\\\n\\\\n1. 在预警规则列表中找到要删除的规则\\\\n2. 点击\\\\\\\"删除\\\\\\\"按钮\\\\n3. 确认删除操作\\\\n\\\\n### 9.4 预警记录查看\\\\n\\\\n#### 9.4.1 查看预警记录\\\\n\\\\n- 显示预警记录列表\\\\n- 包括预警时间、预警类型、严重程度、预警消息、预警数据、状态\\\\n- 可按状态筛选（待处理、已确认、已解决）\\\\n\\\\n#### 9.4.2 确认预警\\\\n\\\\n1. 在预警记录列表中找到要确认的预警\\\\n2. 点击\\\\\\\"确认\\\\\\\"按钮\\\\n3. 填写确认信息\\\\n4. 点击\\\\\\\"确定\\\\\\\"按钮完成确认\\\\n\\\\n#### 9.4.3 解决预警\\\\n\\\\n1. 在预警记录列表中找到要解决的预警\\\\n2. 点击\\\\\\\"解决\\\\\\\"按钮\\\\n3. 填写解决信息\\\\n4. 点击\\\\\\\"确定\\\\\\\"按钮完成解决\\\\n\\\\n---\\\\n\\\\n## 十、自定义仪表板\\\\n\\\\n### 10.1 功能概述\\\\n\\\\n自定义仪表板允许用户根据需求创建个性化的数据可视化仪表板。\\\\n\\\\n### 10.2 创建仪表板\\\\n\\\\n#### 10.2.1 新建仪表板\\\\n\\\\n1. 点击\\\\\\\"新建仪表板\\\\\\\"按钮\\\\n2. 填写仪表板信息：\\\\n   - **仪表板名称**：输入仪表板名称\\\\n   - **仪表板类型**：选择仪表板类型（默认、自定义）\\\\n   - **布局配置**：配置仪表板布局\\\\n   - **组件配置**：配置仪表板组件\\\\n   - **刷新频率**：设置刷新频率（手动、5分钟、15分钟、30分钟、1小时）\\\\n   - **公开状态**：选择是否公开\\\\n3. 点击\\\\\\\"保存\\\\\\\"按钮完成创建\\\\n\\\\n#### 10.2.2 编辑仪表板\\\\n\\\\n1. 在仪表板列表中找到要编辑的仪表板\\\\n2. 点击\\\\\\\"编辑\\\\\\\"按钮\\\\n3. 修改仪表板信息\\\\n4. 点击\\\\\\\"保存\\\\\\\"按钮完成编辑\\\\n\\\\n#### 10.2.3 删除仪表板\\\\n\\\\n1. 在仪表板列表中找到要删除的仪表板\\\\n2. 点击\\\\\\\"删除\\\\\\\"按钮\\\\n3. 确认删除操作\\\\n\\\\n### 10.3 仪表板组件\\\\n\\\\n#### 10.3.1 添加组件\\\\n\\\\n1. 进入仪表板编辑模式\",\"originAcceptText\":\"### 2.1 模块入口\\n\\n1. 登录系统后，点击左侧导航栏的\\\"数据分析\\\"菜单\\n2. 进入数据分析主页面，默认显示销售分析标签页\\n\\n### 2.2 标签页说明\\n\\n| 标签页 | 功能说明 |\\n|--------|----------|\\n| 销售分析 | 销售收入、订单、商品等多维度分析 |\\n| 客户分析 | 客户增长、分段、行为、价值等分析 |\\n| 菜单分析 | 菜品表现、盈利能力、优化建议等分析 |\\n| 运营分析 | 运营效率、成本、质量、员工等分析 |\\n| 预测分析 | 销量、客户、需求等预测分析 |\\n| 异常预警 | 销售异常、库存异常、运营异常等预警 |\\n| 自定义仪表板 | 自定义数据可视化仪表板 |\\n\\n---\\n\\n## 三、数据采集管理\\n\\n### 3.1 功能概述\\n\\n数据采集管理用于配置和管理数据源，实现从多个业务系统自动采集数据。\\n\\n### 3.2 数据源配置\\n\\n#### 3.2.1 添加数据源\\n\\n1. 点击\\\"添加数据源\\\"按钮\\n2. 填写数据源信息：\\n   - **数据源名称**：输入数据源的名称，如\\\"订单系统\\\"\\n   - **数据源类型**：选择数据源类型（订单系统、会员系统、库存系统、支付系统、评价系统、外部API）\\n   - **采集方式**：选择采集方式（实时采集、批量采集）\\n   - **采集频率**：批量采集时设置采集频率（每小时、每6小时、每天、每周）\\n   - **连接配置**：输入连接配置JSON，例如：\\n     ```json\\n     {\\n       \\\"url\\\": \\\"http://api.example.com\\\",\\n       \\\"apiKey\\\": \\\"your_api_key\\\",\\n       \\\"timeout\\\": 30000\\n     }\\n     ```\\n   - **启用状态**：选择是否启用该数据源\\n3. 点击\\\"保存\\\"按钮完成添加\\n\\n#### 3.2.2 编辑数据源\\n\\n1. 在数据源列表中找到要编辑的数据源\\n2. 点击\\\"编辑\\\"按钮\\n3. 修改数据源信息\\n4. 点击\\\"保存\\\"按钮完成编辑\\n\\n#### 3.2.3 删除数据源\\n\\n1. 在数据源列表中找到要删除的数据源\\n2. 点击\\\"删除\\\"按钮\\n3. 确认删除操作\\n\\n#### 3.2.4 立即同步\\n\\n1. 在数据源列表中找到要同步的数据源\\n2. 点击\\\"立即同步\\\"按钮\\n3. 系统开始执行数据同步\\n4. 同步完成后查看同步状态\\n\\n### 3.3 数据源监控\\n\\n#### 3.3.1 查看同步状态\\n\\n- **成功**：数据同步成功\\n- **失败**：数据同步失败，可查看错误信息\\n- **待同步**：等待同步\\n\\n#### 3.3.2 查看同步日志\\n\\n1. 在数据源列表中点击\\\"日志\\\"按钮\\n2. 查看该数据源的同步日志，包括：\\n   - 同步时间\\n   - 同步状态\\n   - 采集记录数\\n   - 耗时\\n   - 错误信息\\n\\n### 3.4 数据源筛选\\n\\n1. 使用筛选条件过滤数据源：\\n   - **数据源类型**：按类型筛选\\n   - **采集方式**：按采集方式筛选\\n   - **状态**：按同步状态筛选\\n2. 点击\\\"查询\\\"按钮执行筛选\\n3. 点击\\\"重置\\\"按钮清除筛选条件\\n\\n---\\n\\n## 四、数据清洗管理\\n\\n### 4.1 功能概述\\n\\n数据清洗管理用于配置和管理数据清洗规则，自动识别和处理数据质量问题。\\n\\n### 4.2 清洗规则配置\\n\\n#### 4.2.1 新建规则\\n\\n1. 点击\\\"新建规则\\\"按钮\\n2. 填写规则信息：\\n   - **规则名称**：输入规则名称\\n   - **规则类型**：选择规则类型\\n     - **格式校验**：校验数据格式（手机号、邮箱、日期、数字等）\\n     - **重复数据**：识别和去除重复数据\\n     - **异常值检测**：检测异常值（标准差法、四分位距法、Z-Score法）\\n     - **完整性检查**：检查数据完整性（必填字段检查）\\n     - **一致性检查**：检查数据一致性（自定义SQL规则）\\n   - **规则配置**：根据规则类型配置具体参数\\n   - **优先级**：设置规则执行优先级（0-100）\\n   - **启用状态**：选择是否启用该规则\\n3. 点击\\\"保存\\\"按钮完成创建\\n\\n#### 4.2.2 编辑规则\\n\\n1. 在规则列表中找到要编辑的规则\\n2. 点击\\\"编辑\\\"按钮\\n3. 修改规则信息\\n4. 点击\\\"保存\\\"按钮完成编辑\\n\\n#### 4.2.3 删除规则\\n\\n1. 在规则列表中找到要删除的规则\\n2. 点击\\\"删除\\\"按钮\\n3. 确认删除操作\\n\\n#### 4.2.4 测试规则\\n\\n1. 在规则列表中找到要测试的规则\\n2. 点击\\\"测试\\\"按钮\\n3. 系统执行规则测试\\n4. 查看测试结果，包括发现问题记录数\\n\\n### 4.3 执行数据清洗\\n\\n#### 4.3.1 执行清洗\\n\\n1. 点击\\\"执行清洗\\\"按钮\\n2. 配置清洗参数：\\n   - **执行范围**：选择执行范围（全部数据、指定日期范围）\\n   - **日期范围**：指定日期范围时选择开始和结束日期\\n   - **选择规则**：选择要执行的规则（默认全部）\\n3. 点击\\\"执行清洗\\\"按钮\\n4. 系统开始执行数据清洗\\n5. 查看清洗结果\\n\\n#### 4.3.2 查看清洗结果\\n\\n清洗结果包括：\\n- **总记录数**：处理的总记录数\\n- **清洗记录数**：成功清洗的记录数\\n- **无效记录数**：发现的无效记录数\\n- **问题列表**：详细的问题列表，包括：\\n  - 规则名称\\n  - 问题类型\\n  - 问题记录数\\n  - 问题描述\\n  - 处理动作\\n\\n### 4.4 清洗规则筛选\\n\\n1. 使用筛选条件过滤规则：\\n   - **规则类型**：按类型筛选\\n   - **启用状态**：按启用状态筛选\\n2. 点击\\\"查询\\\"按钮执行筛选\\n3. 点击\\\"重置\\\"按钮清除筛选条件\\n\\n---\\n\\n## 五、销售分析\\n\\n### 5.1 功能概述\\n\\n销售分析提供销售数据的全方位分析，帮助了解销售趋势和收入表现。\\n\\n### 5.2 视图切换\\n\\n销售分析包含以下视图：\\n- **总览**：销售总收入、订单数、平均客单价等核心指标\\n- **趋势**：销售趋势分析，包括日趋势、周趋势、月趋势\\n- **商品**：商品销售排行、类别销售对比、商品关联分析\\n- **预测**：销售预测，包括短期、中期、长期预测\\n\\n### 5.3 销售总览\\n\\n#### 5.3.1 查看销售收入趋势\\n\\n- 显示最近7天的销售收入趋势图\\n- 可查看收入和利润两条曲线\\n- 鼠标悬停查看具体数值\\n\\n#### 5.3.2 查看销售分布\\n\\n- 显示销售分布饼图\\n- 包括堂食、外卖、打包、团购等类型\\n- 可查看各类型的销售额和占比\\n\\n#### 5.3.3 查看按小时销售分析\\n\\n- 显示24小时销售趋势图\\n- 可查看各时段的订单数量\\n- 帮助识别高峰时段\\n\\n#### 5.3.4 查看支付方式分布\\n\\n- 显示支付方式分布饼图\\n- 包括微信支付、支付宝、现金、其他等\\n- 可查看各支付方式的销售额和占比\\n\\n### 5.4 销售趋势\\n\\n#### 5.4.1 切换时间粒度\\n\\n- 选择日趋势、周趋势、月趋势\\n- 系统自动刷新数据\\n\\n#### 5.4.2 查看趋势图\\n\\n- 显示销售趋势图\\n- 包括收入、订单数、客单价三条曲线\\n- 可查看同比、环比增长情况\\n\\n### 5.5 商品销售\\n\\n#### 5.5.1 查看热销商品排行\\n\\n- 显示热销商品排行榜\\n- 包括排名、商品名称、销量、收入、增长率\\n- 可按销量、收入、增长率排序\\n\\n#### 5.5.2 查看类别销售对比\\n\\n- 显示类别销售对比柱状图\\n- 包括凉菜、汤品、主食、热菜、饮品、甜点等\\n- 可查看各类别的销量对比\\n\\n#### 5.5.3 查看商品关联分析\\n\\n- 显示商品关联网络图\\n- 可查看商品之间的关联关系\\n- 帮助优化套餐组合\\n\\n### 5.6 销售预测\\n\\n#### 5.6.1 配置预测参数\\n\\n- **预测周期**：选择预测周期（7天、15天、30天、60天、90天）\\n- **预测模型**：选择预测模型（ARIMA、Prophet、LSTM、集成模型）\\n\\n#### 5.6.2 查看预测结果\\n\\n- 显示销售预测图\\n- 包括历史数据和预测数据\\n- 显示置信区间\\n- 可查看预测准确度指标\\n\\n#### 5.6.3 查看预测建议\\n\\n- 显示预测建议列表\\n- 包括销量增长建议、库存预警、新菜品推广等\\n- 可根据建议调整运营策略\\n\\n---\\n\\n## 六、客户分析\\n\\n### 6.1 功能概述\\n\\n客户分析提供客户数据的全方位分析，帮助了解客户行为和价值贡献。\\n\\n### 6.2 视图切换\\n\\n客户分析包含以下视图：\\n- **增长**：客户增长趋势、客户来源分析、客户留存率、客户流失分析\\n- **分段**：客户分段概览、分段特征分析、RFM客户价值矩阵\\n- **行为**：消费频次分布、消费金额分布、消费时间偏好、菜品偏好分析、客户行为路径\\n- **价值**：客户价值指标、客户价值趋势、高价值客户TOP10、客户生命周期价值分析\\n- **地理**：客户地理分布、区域销售排行、配送区域分析、区域对比分析\\n\\n### 6.3 客户增长\\n\\n#### 6.3.1 查看客户增长趋势\\n\\n- 显示客户增长趋势图\\n- 包括新增客户、活跃客户、流失客户三条曲线\\n- 可切换日增长、周增长、月增长\\n\\n#### 6.3.2 查看客户来源分析\\n\\n- 显示客户来源分布饼图\\n- 包括线上推广、线下活动、口碑推荐、社交媒体、其他等\\n- 可查看各来源的客户数和占比\\n\\n#### 6.3.3 查看客户留存率\\n\\n- 显示客户留存率趋势图\\n- 显示第1月到第6月的留存率\\n- 帮助评估客户忠诚度\\n\\n#### 6.3.4 查看客户流失分析\\n\\n- 显示客户流失率柱状图\\n- 显示各月的流失率\\n- 帮助识别流失趋势\\n\\n### 6.4 客户分段\\n\\n#### 6.4.1 查看客户分段概览\\n\\n- 显示客户分段列表\\n- 包括核心客户、重要客户、普通客户、潜在客户\\n- 可查看各分段的客户数、占比、平均消费、消费频次\\n\\n#### 6.4.2 查看分段特征分析\\n\\n- 显示客户分段雷达图\\n- 包括消费金额、消费频次、最近消费、客户忠诚度、推荐意愿等维度\\n- 帮助了解各分段客户特征\\n\\n#### 6.4.3 查看RFM客户价值矩阵\\n\\n- 显示RFM客户价值矩阵散点图\\n- X轴为最近消费，Y轴为消费频次\\n- 可查看各客户的RFM分布\\n- 帮助识别高价值客户\\n\\n### 6.5 客户行为\\n\\n#### 6.5.1 查看消费频次分布\\n\\n- 显示消费频次分布柱状图\\n- 显示各消费频次的客户数\\n- 帮助了解客户消费习惯\\n\\n#### 6.5.2 查看消费金额分布\\n\\n- 显示消费金额分布柱状图\\n- 显示各消费金额区间的客户数\\n- 帮助了解客户消费能力\\n\\n#### 6.5.3 查看消费时间偏好\\n\\n- 显示消费时间偏好柱状图\\n- 包括早餐、午餐、下午茶、晚餐、夜宵\\n- 帮助优化营业时间\\n\\n#### 6.5.4 查看菜品偏好分析\\n\\n- 显示菜品偏好分布饼图\\n- 包括热菜、主食、凉菜、汤品、饮品、甜点\\n- 帮助了解客户口味偏好\\n\\n#### 6.5.5 查看客户行为路径\\n\\n- 显示客户行为路径图\\n- 包括浏览菜单、加入购物车、下单、支付、评价、再次购买等环节\\n- 帮助优化客户体验\\n\\n### 6.6 客户价值\\n\\n#### 6.6.1 查看客户价值指标\\n\\n- 显示客户价值指标卡片\\n- 包括客户总数、平均终身价值、客户保留率、客户满意度\\n- 可查看各指标的环比变化\\n\\n#### 6.6.2 查看客户价值趋势\\n\\n- 显示客户价值趋势图\\n- 显示平均终身价值的变化趋势\\n- 帮助评估客户价值增长\\n\\n#### 6.6.3 查看高价值客户TOP10\\n\\n- 显示高价值客户排行榜\\n- 包括排名、客户姓名、终身价值\\n- 帮助识别重点客户\\n\\n#### 6.6.4 查看客户生命周期价值分析\\n\\n- 显示客户生命周期价值趋势图\\n- 包括核心客户、重要客户、普通客户、潜在客户的LTV趋势\\n- 帮助评估客户价值增长潜力\\n\\n### 6.7 客户地理\\n\\n#### 6.7.1 查看客户地理分布\\n\\n- 显示客户地理分布地图\\n- 可查看各地区的客户数\\n- 帮助优化区域营销策略\\n\\n#### 6.7.2 查看区域销售排行\\n\\n- 显示区域销售排行榜\\n- 包括排名、区域、客户数、销售额\\n- 帮助识别重点区域\\n\\n#### 6.7.3 查看配送区域分析\\n\\n- 显示配送区域分析柱状图\\n- 包括3公里内、3-5公里、5-7公里、7-10公里、10公里以上\\n- 帮助优化配送策略\\n\\n#### 6.7.4 查看区域对比分析\\n\\n- 显示区域对比分析图\\n- 包括客户数和销售额两个维度\\n- 帮助对比各区域表现\\n\\n---\\n\\n## 七、菜单分析\\n\\n### 7.1 功能概述\\n\\n菜单分析提供菜单数据的全方位分析，帮助优化菜单结构和定价策略。\\n\\n### 7.2 视图切换\\n\\n菜单分析包含以下视图：\\n- **表现**：菜品销量排行、类别销售对比、菜品评价分析、菜品复购率\\n- **盈利**：整体毛利率、平均菜品毛利率、成本占比、利润增长率、类别毛利率分析、菜品毛利率排行、成本结构分析\\n- **优化**：滞销菜品识别、新菜品表现、价格弹性分析、菜单结构优化建议\\n- **矩阵**：BCG矩阵分析、明星菜品、问题菜品\\n\\n### 7.3 菜品表现\\n\\n#### 7.3.1 查看菜品销量排行\\n\\n- 显示热销菜品排行榜\\n- 包括排名、菜品名称、类别、销量、收入、评分\\n- 可按销量、收入、评分排序\\n\\n#### 7.3.2 查看类别销售对比\\n\\n- 显示类别销售对比柱状图\\n- 包括凉菜、汤品、主食、热菜、饮品、甜点\\n- 可查看各类别的销量对比\\n\\n#### 7.3.3 查看菜品评价分析\\n\\n- 显示菜品评价分布饼图\\n- 包括5星、4星、3星、2星、1星\\n- 可查看各评分的菜品数\\n\\n#### 7.3.4 查看菜品复购率\\n\\n- 显示菜品复购率柱状图\\n- 显示各菜品的复购率\\n- 帮助识别受欢迎的菜品\\n\\n### 7.4 盈利能力\\n\\n#### 7.4.1 查看盈利指标\\n\\n- 显示盈利指标卡片\\n- 包括整体毛利率、平均菜品毛利率、成本占比、利润增长率\\n- 可查看各指标的环比变化\\n\\n#### 7.4.2 查看类别毛利率分析\\n\\n- 显示类别毛利率分析柱状图\\n- 包括凉菜、汤品、主食、热菜、饮品、甜点\\n- 可查看各类别的毛利率\\n\\n#### 7.4.3 查看菜品毛利率排行\\n\\n- 显示高毛利率菜品排行榜\\n- 包括排名、菜品名称、毛利率、利润\\n- 可按毛利率、利润排序\\n\\n#### 7.4.4 查看成本结构分析\\n\\n- 显示成本结构分析饼图\\n- 包括食材成本、人工成本、租金成本、水电成本、其他成本\\n- 可查看各成本的占比\\n\\n### 7.5 菜单优化\\n\\n#### 7.5.1 查看滞销菜品识别\\n\\n- 显示滞销菜品列表\\n- 包括排名、菜品名称、销量、未售天数、库存\\n- 可执行下架或促销操作\\n\\n#### 7.5.2 查看新菜品表现\\n\\n- 显示新菜品列表\\n- 包括排名、菜品名称、上线日期、销量、评分、状态\\n- 可查看新菜品的表现\\n\\n#### 7.5.3 查看价格弹性分析\\n\\n- 显示价格弹性分析图\\n- 包括价格和销量两条曲线\\n- 帮助评估价格对销量的影响\\n\\n#### 7.5.4 查看菜单结构优化建议\\n\\n- 显示菜单结构优化建议列表\\n- 包括下架滞销菜品、推出春季特色菜品、调整热销菜品价格、优化菜单结构等\\n- 可查看预期影响\\n\\n### 7.6 BCG矩阵\\n\\n#### 7.6.1 查看BCG矩阵分析\\n\\n- 显示BCG矩阵散点图\\n- X轴为市场份额，Y轴为增长率\\n- 可查看各菜品的BCG分布\\n- 帮助识别明星、现金牛、问题、瘦狗类菜品\\n\\n#### 7.6.2 查看明星菜品\\n\\n- 显示明星菜品列表\\n- 包括排名、菜品名称、市场份额、增长率\\n- 帮助识别重点推广菜品\\n\\n#### 7.6.3 查看问题菜品\\n\\n- 显示问题菜品列表\\n- 包括排名、菜品名称、市场份额、增长率\\n- 帮助识别需要优化的菜品\\n\\n---\\n\\n## 八、运营分析\\n\\n### 8.1 功能概述\\n\\n运营分析提供运营数据的全方位分析，帮助监控运营效率和服务质量。\\n\\n### 8.2 视图切换\\n\\n运营分析包含以下视图：\\n- **效率**：桌位利用率、订单处理效率、厨房效率、员工效率、高峰时段分析、订单处理时间、出餐速度分析、运营效率趋势\\n- **成本**：总成本、人工成本、食材成本、成本占比、成本构成分析、成本趋势、单位成本分析、成本效益分析、成本控制建议\\n- **质量**：客户满意度、投诉率、平均响应时间、问题解决率、客户满意度趋势、投诉率分析、处理时效分析、服务质量评分、客户反馈分析\\n- **员工**：员工总数、人均订单、平均处理时间、员工满意度、员工效率排行、员工工作量分布、员工绩效趋势、排班优化建议、员工培训与发展\\n\\n### 8.3 运营效率\\n\\n#### 8.3.1 查看效率指标\\n\\n- 显示效率指标卡片\\n- 包括桌位利用率、订单处理效率、厨房效率、员工效率\\n- 可查看各指标的环比变化\\n\\n#### 8.3.2 查看桌位利用率\\n\\n- 显示桌位利用率趋势图\\n- 显示一周的桌位利用率\\n- 帮助优化桌位安排\\n\\n#### 8.3.3 查看高峰时段分析\\n\\n- 显示高峰时段分析柱状图\\n- 显示24小时的订单数量\\n- 帮助识别高峰时段\\n\\n#### 8.3.4 查看订单处理时间\\n\\n- 显示订单处理时间柱状图\\n- 包括接单、确认、制作、出餐、配送、完成等环节\\n- 帮助优化订单处理流程\\n\\n#### 8.3.5 查看出餐速度分析\\n\\n- 显示出餐速度分析柱状图\\n- 包括凉菜、汤品、热菜、主食、饮品\\n- 帮助优化出餐流程\\n\\n#### 8.3.6 查看运营效率趋势\\n\\n- 显示运营效率趋势图\\n- 包括桌位利用率、订单处理效率、厨房效率、员工效率\\n- 帮助评估运营效率变化\\n\\n### 8.4 运营成本\\n\\n#### 8.4.1 查看成本指标\\n\\n- 显示成本指标卡片\\n- 包括总成本、人工成本、食材成本、成本占比\\n- 可查看各指标的环比变化\\n\\n#### 8.4.2 查看成本构成分析\\n\\n- 显示成本构成分析饼图\\n- 包括食材成本、人工成本、租金成本、水电成本、其他成本\\n- 可查看各成本的占比\\n\\n#### 8.4.3 查看成本趋势\\n\\n- 显示成本趋势图\\n- 显示最近6个月的总成本变化\\n- 帮助评估成本变化趋势\\n\\n#### 8.4.4 查看单位成本分析\\n\\n- 显示单位成本分析柱状图\\n- 包括堂食、外卖、打包、团购\\n- 帮助对比各渠道的单位成本\\n\\n#### 8.4.5 查看成本效益分析\\n\\n- 显示成本效益分析图\\n- 包括收入、成本、利润\\n- 帮助评估成本效益\\n\\n#### 8.4.6 查看成本控制建议\\n\\n- 显示成本控制建议列表\\n- 包括优化食材采购、调整人员排班、降低能源消耗等\\n- 可根据建议调整成本控制策略\\n\\n### 8.5 服务质量\\n\\n#### 8.5.1 查看质量指标\\n\\n- 显示质量指标卡片\\n- 包括客户满意度、投诉率、平均响应时间、问题解决率\\n- 可查看各指标的环比变化\\n\\n#### 8.5.2 查看客户满意度趋势\\n\\n- 显示客户满意度趋势图\\n- 显示最近6个月的客户满意度变化\\n- 帮助评估服务质量变化\\n\\n#### 8.5.3 查看投诉率分析\\n\\n- 显示投诉率趋势图\\n- 显示最近6个月的投诉率变化\\n- 帮助评估投诉情况\\n\\n#### 8.5.4 查看处理时效分析\\n\\n- 显示处理时效趋势图\\n- 显示最近6个月的平均响应时间变化\\n- 帮助评估处理时效\\n\\n#### 8.5.5 查看服务质量评分\\n\\n- 显示服务质量评分列表\\n- 包括服务态度、菜品质量、环境卫生、出餐速度、性价比\\n- 可查看各维度的评分\\n\\n#### 8.5.6 查看客户反馈分析\\n\\n- 显示客户反馈分析饼图\\n- 包括好评、中评、差评、建议\\n- 可查看各反馈的数量和占比\\n\\n### 8.6 员工管理\\n\\n#### 8.6.1 查看员工指标\\n\\n- 显示员工指标卡片\\n- 包括员工总数、人均订单、平均处理时间、员工满意度\\n- 可查看各指标的环比变化\\n\\n#### 8.6.2 查看员工效率排行\\n\\n- 显示员工效率排行榜\\n- 包括排名、姓名、职位、处理订单、平均时间、满意度\\n- 可按处理订单、平均时间、满意度排序\\n\\n#### 8.6.3 查看员工工作量分布\\n\\n- 显示员工工作量分布柱状图\\n- 显示各员工处理的订单数\\n- 帮助优化人员安排\\n\\n#### 8.6.4 查看员工绩效趋势\\n\\n- 显示员工绩效趋势图\\n- 显示最近6个月的人均订单变化\\n- 帮助评估员工绩效变化\\n\\n#### 8.6.5 查看排班优化建议\\n\\n- 显示排班优化建议列表\\n- 包括增加高峰期人手、优化员工培训、实施绩效考核等\\n- 可根据建议调整排班策略\\n\\n#### 8.6.6 查看员工培训与发展\\n\\n- 显示员工培训与发展图\\n- 包括培训次数、培训时长、员工满意度\\n- 帮助评估培训效果\\n\\n---\\n\\n## 九、异常预警\\n\\n### 9.1 功能概述\\n\\n异常预警用于监控业务数据，及时发现异常情况并发送预警通知。\\n\\n### 9.2 预警类型\\n\\n| 预警类型 | 说明 |\\n|----------|------|\\n| 销售异常 | 销售额异常波动、订单量异常波动、客单价异常波动 |\\n| 库存异常 | 库存不足预警、库存积压预警、库存周转异常、损耗异常预警 |\\n| 运营异常 | 服务质量下降、投诉率上升、处理时效延长、运营效率下降 |\\n| 系统异常 | 数据采集失败、数据同步延迟、系统性能下降、系统错误告警 |\\n\\n### 9.3 预警规则配置\\n\\n#### 9.3.1 添加预警规则\\n\\n1. 点击\\\"添加规则\\\"按钮\\n2. 填写预警规则信息：\\n   - **规则名称**：输入规则名称\\n   - **预警类型**：选择预警类型\\n   - **条件配置**：配置预警条件\\n   - **严重程度**：选择严重程度（低、中、高、严重）\\n   - **通知渠道**：配置通知渠道（邮件、短信、Webhook）\\n   - **启用状态**：选择是否启用该规则\\n3. 点击\\\"保存\\\"按钮完成添加\\n\\n#### 9.3.2 编辑预警规则\\n\\n1. 在预警规则列表中找到要编辑的规则\\n2. 点击\\\"编辑\\\"按钮\\n3. 修改预警规则信息\\n4. 点击\\\"保存\\\"按钮完成编辑\\n\\n#### 9.3.3 删除预警规则\\n\\n1. 在预警规则列表中找到要删除的规则\\n2. 点击\\\"删除\\\"按钮\\n3. 确认删除操作\\n\\n### 9.4 预警记录查看\\n\\n#### 9.4.1 查看预警记录\\n\\n- 显示预警记录列表\\n- 包括预警时间、预警类型、严重程度、预警消息、预警数据、状态\\n- 可按状态筛选（待处理、已确认、已解决）\\n\\n#### 9.4.2 确认预警\\n\\n1. 在预警记录列表中找到要确认的预警\\n2. 点击\\\"确认\\\"按钮\\n3. 填写确认信息\\n4. 点击\\\"确定\\\"按钮完成确认\\n\\n#### 9.4.3 解决预警\\n\\n1. 在预警记录列表中找到要解决的预警\\n2. 点击\\\"解决\\\"按钮\\n3. 填写解决信息\\n4. 点击\\\"确定\\\"按钮完成解决\\n\\n---\\n\\n## 十、自定义仪表板\\n\\n### 10.1 功能概述\\n\\n自定义仪表板允许用户根据需求创建个性化的数据可视化仪表板。\\n\\n### 10.2 创建仪表板\\n\\n#### 10.2.1 新建仪表板\\n\\n1. 点击\\\"新建仪表板\\\"按钮\\n2. 填写仪表板信息：\\n   - **仪表板名称**：输入仪表板名称\\n   - **仪表板类型**：选择仪表板类型（默认、自定义）\\n   - **布局配置**：配置仪表板布局\\n   - **组件配置**：配置仪表板组件\\n   - **刷新频率**：设置刷新频率（手动、5分钟、15分钟、30分钟、1小时）\\n   - **公开状态**：选择是否公开\\n3. 点击\\\"保存\\\"按钮完成创建\\n\\n#### 10.2.2 编辑仪表板\\n\\n1. 在仪表板列表中找到要编辑的仪表板\\n2. 点击\\\"编辑\\\"按钮\\n3. 修改仪表板信息\\n4. 点击\\\"保存\\\"按钮完成编辑\\n\\n#### 10.2.3 删除仪表板\\n\\n1. 在仪表板列表中找到要删除的仪表板\\n2. 点击\\\"删除\\\"按钮\\n3. 确认删除操作\\n\\n### 10.3 仪表板组件\\n\\n#### 10.3.1 添加组件\\n\\n1. 进入仪表板编辑模式\",\"originTextLength\":10119,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768859269803},{\"originRange\":{\"start\":{\"line\":165,\"character\":0},\"end\":{\"line\":177,\"character\":15}},\"modifyRange\":{\"start\":{\"line\":165,\"character\":0},\"end\":{\"line\":177,\"character\":15}},\"action\":\"None\",\"isLine\":false,\"originText\":\"3. 选择组件类型：\\\\n   - **指标卡片**：显示核心指标\\\\n   - **折线图**：显示趋势数据\\\\n   - **柱状图**：显示对比数据\\\\n   - **饼图**：显示占比数据\\\\n   - **表格**：显示详细数据\\\\n4. 配置组件参数\\\\n5. 点击\\\\\\\"确定\\\\\\\"按钮完成添加\\\\n\\\\n#### 10.3.2 编辑组件\\\\n\\\\n1. 在仪表板中找到要编辑的组件\\\\n2. 点击\\\\\\\"编辑\\\\\\\"按钮\\\\n3. 修改组件参数\\\\n4. 点击\\\\\\\"确定\\\\\\\"按钮完成编辑\",\"originAcceptText\":\"3. 选择组件类型：\\n   - **指标卡片**：显示核心指标\\n   - **折线图**：显示趋势数据\\n   - **柱状图**：显示对比数据\\n   - **饼图**：显示占比数据\\n   - **表格**：显示详细数据\\n4. 配置组件参数\\n5. 点击\\\"确定\\\"按钮完成添加\\n\\n#### 10.3.2 编辑组件\\n\\n1. 在仪表板中找到要编辑的组件\\n2. 点击\\\"编辑\\\"按钮\\n3. 修改组件参数\\n4. 点击\\\"确定\\\"按钮完成编辑\",\"originTextLength\":209,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768859269826},{\"originRange\":{\"start\":{\"line\":183,\"character\":0},\"end\":{\"line\":185,\"character\":11}},\"modifyRange\":{\"start\":{\"line\":183,\"character\":0},\"end\":{\"line\":185,\"character\":11}},\"action\":\"None\",\"isLine\":false,\"originText\":\"#### 10.3.3 删除组件\\\\n\\\\n1. 在仪表板中找到要删除的组件\\\\n2. 点击\\\\\\\"删除\\\\\\\"按钮\",\"originAcceptText\":\"#### 10.3.3 删除组件\\n\\n1. 在仪表板中找到要删除的组件\\n2. 点击\\\"删除\\\"按钮\",\"originTextLength\":46,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768859269851},{\"originRange\":{\"start\":{\"line\":188,\"character\":0},\"end\":{\"line\":223,\"character\":10}},\"modifyRange\":{\"start\":{\"line\":188,\"character\":0},\"end\":{\"line\":223,\"character\":10}},\"action\":\"None\",\"isLine\":false,\"originText\":\"### 10.4 仪表板分享\\\\n\\\\n#### 10.4.1 分享仪表板\\\\n\\\\n1. 在仪表板列表中找到要分享的仪表板\\\\n2. 点击\\\\\\\"分享\\\\\\\"按钮\\\\n3. 选择分享方式：\\\\n   - **生成链接**：生成分享链接\\\\n   - **导出配置**：导出仪表板配置\\\\n4. 点击\\\\\\\"确定\\\\\\\"按钮完成分享\\\\n\\\\n#### 10.4.2 导入仪表板\\\\n\\\\n1. 点击\\\\\\\"导入仪表板\\\\\\\"按钮\\\\n2. 选择要导入的配置文件\\\\n3. 点击\\\\\\\"确定\\\\\\\"按钮完成导入\\\\n\\\\n---\\\\n\\\\n## 十一、数据导出\\\\n\\\\n### 11.1 功能概述\\\\n\\\\n数据导出功能允许用户将分析数据导出为多种格式，便于离线查看和分享。\\\\n\\\\n### 11.2 导出操作\\\\n\\\\n#### 11.2.1 导出数据\\\\n\\\\n1. 点击\\\\\\\"导出报告\\\\\\\"按钮\\\\n2. 配置导出参数：\\\\n   - **报告类型**：选择报告类型\\\\n   - **日期范围**：选择日期范围\\\\n   - **导出格式**：选择导出格式（Excel、PDF、CSV）\\\\n   - **导出字段**：选择要导出的字段\\\\n3. 点击\\\\\\\"确定\\\\\\\"按钮开始导出\\\\n4. 下载导出文件\\\\n\\\\n#### 11.2.2 定时导出\\\\n\\\\n1. 点击\\\\\\\"定时导出\\\\\\\"按钮\\\\n2. 配置定时导出参数：\\\\n   - **导出频率**：选择导出频率（每天、每周、每月）\\\\n   - **导出时间**：设置导出时间\\\\n   - **导出格式**：选择导出格式\\\\n   - **接收邮箱**：设置接收邮箱\\\\n3. 点击\\\\\\\"确定\\\\\\\"按钮完成配置\\\\n\\\\n---\\\\n\\\\n## 十二、常见问题\",\"originAcceptText\":\"### 10.4 仪表板分享\\n\\n#### 10.4.1 分享仪表板\\n\\n1. 在仪表板列表中找到要分享的仪表板\\n2. 点击\\\"分享\\\"按钮\\n3. 选择分享方式：\\n   - **生成链接**：生成分享链接\\n   - **导出配置**：导出仪表板配置\\n4. 点击\\\"确定\\\"按钮完成分享\\n\\n#### 10.4.2 导入仪表板\\n\\n1. 点击\\\"导入仪表板\\\"按钮\\n2. 选择要导入的配置文件\\n3. 点击\\\"确定\\\"按钮完成导入\\n\\n---\\n\\n## 十一、数据导出\\n\\n### 11.1 功能概述\\n\\n数据导出功能允许用户将分析数据导出为多种格式，便于离线查看和分享。\\n\\n### 11.2 导出操作\\n\\n#### 11.2.1 导出数据\\n\\n1. 点击\\\"导出报告\\\"按钮\\n2. 配置导出参数：\\n   - **报告类型**：选择报告类型\\n   - **日期范围**：选择日期范围\\n   - **导出格式**：选择导出格式（Excel、PDF、CSV）\\n   - **导出字段**：选择要导出的字段\\n3. 点击\\\"确定\\\"按钮开始导出\\n4. 下载导出文件\\n\\n#### 11.2.2 定时导出\\n\\n1. 点击\\\"定时导出\\\"按钮\\n2. 配置定时导出参数：\\n   - **导出频率**：选择导出频率（每天、每周、每月）\\n   - **导出时间**：设置导出时间\\n   - **导出格式**：选择导出格式\\n   - **接收邮箱**：设置接收邮箱\\n3. 点击\\\"确定\\\"按钮完成配置\\n\\n---\\n\\n## 十二、常见问题\",\"originTextLength\":627,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768859269873},{\"originRange\":{\"start\":{\"line\":247,\"character\":0},\"end\":{\"line\":328,\"character\":8}},\"modifyRange\":{\"start\":{\"line\":247,\"character\":0},\"end\":{\"line\":328,\"character\":8}},\"action\":\"None\",\"isLine\":false,\"originText\":\"### 12.1 数据采集相关问题\\\\n\\\\n**Q: 数据源同步失败怎么办？**\\\\n\\\\nA: 请检查以下内容：\\\\n1. 数据源连接配置是否正确\\\\n2. 数据源是否可访问\\\\n3. 网络连接是否正常\\\\n4. 查看同步日志获取详细错误信息\\\\n\\\\n**Q: 如何提高数据采集频率？**\\\\n\\\\nA: \\\\n1. 将采集方式改为实时采集\\\\n2. 批量采集时设置更短的采集间隔\\\\n3. 确保系统性能足够支持高频采集\\\\n\\\\n### 12.2 数据清洗相关问题\\\\n\\\\n**Q: 清洗规则执行后数据被误删怎么办？**\\\\n\\\\nA: \\\\n1. 查看清洗结果日志\\\\n2. 找到被误删的数据\\\\n3. 调整清洗规则或恢复数据\\\\n\\\\n**Q: 如何提高数据清洗效率？**\\\\n\\\\nA: \\\\n1. 优化清洗规则优先级\\\\n2. 减少不必要的清洗规则\\\\n3. 增加系统资源\\\\n\\\\n### 12.3 数据分析相关问题\\\\n\\\\n**Q: 分析数据不准确怎么办？**\\\\n\\\\nA: 请检查以下内容：\\\\n1. 数据源数据是否准确\\\\n2. 数据清洗规则是否正确\\\\n3. 分析参数配置是否正确\\\\n4. 联系技术支持\\\\n\\\\n**Q: 如何自定义分析维度？**\\\\n\\\\nA: \\\\n1. 联系技术支持添加自定义维度\\\\n2. 使用自定义仪表板功能\\\\n3. 导出数据后自行分析\\\\n\\\\n### 12.4 预警相关问题\\\\n\\\\n**Q: 预警通知没有收到怎么办？**\\\\n\\\\nA: 请检查以下内容：\\\\n1. 预警规则是否启用\\\\n2. 通知渠道配置是否正确\\\\n3. 预警条件是否触发\\\\n4. 查看预警记录\\\\n\\\\n**Q: 如何减少误报？**\\\\n\\\\nA: \\\\n1. 调整预警条件阈值\\\\n2. 优化预警规则配置\\\\n3. 增加预警确认机制\\\\n\\\\n---\\\\n\\\\n## 十三、最佳实践\\\\n\\\\n### 13.1 数据采集最佳实践\\\\n\\\\n1. **合理设置采集频率**：根据数据重要性设置合适的采集频率\\\\n2. **定期检查数据质量**：定期查看数据质量报告，及时发现数据问题\\\\n3. **监控数据同步状态**：定期查看数据源同步状态，确保数据正常同步\\\\n4. **备份重要数据**：定期备份重要数据，防止数据丢失\\\\n\\\\n### 13.2 数据清洗最佳实践\\\\n\\\\n1. **优先处理重要数据**：设置清洗规则优先级，优先处理重要数据\\\\n2. **定期更新清洗规则**：根据业务变化定期更新清洗规则\\\\n3. **测试清洗规则**：执行清洗前先测试规则，避免误删数据\\\\n4. **记录清洗日志**：记录清洗日志，便于问题追溯\\\\n\\\\n### 13.3 数据分析最佳实践\\\\n\\\\n1. **多维度分析**：从多个维度分析数据，全面了解业务状况\\\\n2. **关注趋势变化**：关注数据趋势变化，及时发现业务问题\\\\n3. **结合业务场景**：结合实际业务场景分析数据，避免盲目决策\\\\n4. **定期复盘分析结果**：定期复盘分析结果，优化分析策略\\\\n\\\\n### 13.4 预警管理最佳实践\\\\n\\\\n1. **合理设置预警阈值**：根据业务实际情况设置预警阈值\\\\n2. **及时处理预警**：收到预警后及时处理，避免问题扩大\\\\n3. **定期优化预警规则**：根据预警效果定期优化预警规则\\\\n4. **建立预警处理流程**：建立预警处理流程，确保预警得到及时处理\\\\n\\\\n---\\\\n\\\\n## 十四、技术支持\\\\n\\\\n### 14.1 联系方式\\\\n\\\\n- **技术支持邮箱**：support@yyc3-catering.com\\\\n- **技术支持电话**：400-XXX-XXXX\\\\n- **在线客服**：登录系统后点击右下角客服图标\\\\n\\\\n### 14.2 反馈建议\\\\n\\\\n如果您在使用过程中有任何问题或建议，欢迎通过以下方式反馈：\\\\n- 在线反馈：登录系统后点击\\\\\\\"反馈建议\\\\\\\"\\\\n- 邮件反馈：feedback@yyc3-catering.com\\\\n- 电话反馈：400-XXX-XXXX\\\\n\\\\n---\\\\n\\\\n**文档结束**\",\"originAcceptText\":\"### 12.1 数据采集相关问题\\n\\n**Q: 数据源同步失败怎么办？**\\n\\nA: 请检查以下内容：\\n1. 数据源连接配置是否正确\\n2. 数据源是否可访问\\n3. 网络连接是否正常\\n4. 查看同步日志获取详细错误信息\\n\\n**Q: 如何提高数据采集频率？**\\n\\nA: \\n1. 将采集方式改为实时采集\\n2. 批量采集时设置更短的采集间隔\\n3. 确保系统性能足够支持高频采集\\n\\n### 12.2 数据清洗相关问题\\n\\n**Q: 清洗规则执行后数据被误删怎么办？**\\n\\nA: \\n1. 查看清洗结果日志\\n2. 找到被误删的数据\\n3. 调整清洗规则或恢复数据\\n\\n**Q: 如何提高数据清洗效率？**\\n\\nA: \\n1. 优化清洗规则优先级\\n2. 减少不必要的清洗规则\\n3. 增加系统资源\\n\\n### 12.3 数据分析相关问题\\n\\n**Q: 分析数据不准确怎么办？**\\n\\nA: 请检查以下内容：\\n1. 数据源数据是否准确\\n2. 数据清洗规则是否正确\\n3. 分析参数配置是否正确\\n4. 联系技术支持\\n\\n**Q: 如何自定义分析维度？**\\n\\nA: \\n1. 联系技术支持添加自定义维度\\n2. 使用自定义仪表板功能\\n3. 导出数据后自行分析\\n\\n### 12.4 预警相关问题\\n\\n**Q: 预警通知没有收到怎么办？**\\n\\nA: 请检查以下内容：\\n1. 预警规则是否启用\\n2. 通知渠道配置是否正确\\n3. 预警条件是否触发\\n4. 查看预警记录\\n\\n**Q: 如何减少误报？**\\n\\nA: \\n1. 调整预警条件阈值\\n2. 优化预警规则配置\\n3. 增加预警确认机制\\n\\n---\\n\\n## 十三、最佳实践\\n\\n### 13.1 数据采集最佳实践\\n\\n1. **合理设置采集频率**：根据数据重要性设置合适的采集频率\\n2. **定期检查数据质量**：定期查看数据质量报告，及时发现数据问题\\n3. **监控数据同步状态**：定期查看数据源同步状态，确保数据正常同步\\n4. **备份重要数据**：定期备份重要数据，防止数据丢失\\n\\n### 13.2 数据清洗最佳实践\\n\\n1. **优先处理重要数据**：设置清洗规则优先级，优先处理重要数据\\n2. **定期更新清洗规则**：根据业务变化定期更新清洗规则\\n3. **测试清洗规则**：执行清洗前先测试规则，避免误删数据\\n4. **记录清洗日志**：记录清洗日志，便于问题追溯\\n\\n### 13.3 数据分析最佳实践\\n\\n1. **多维度分析**：从多个维度分析数据，全面了解业务状况\\n2. **关注趋势变化**：关注数据趋势变化，及时发现业务问题\\n3. **结合业务场景**：结合实际业务场景分析数据，避免盲目决策\\n4. **定期复盘分析结果**：定期复盘分析结果，优化分析策略\\n\\n### 13.4 预警管理最佳实践\\n\\n1. **合理设置预警阈值**：根据业务实际情况设置预警阈值\\n2. **及时处理预警**：收到预警后及时处理，避免问题扩大\\n3. **定期优化预警规则**：根据预警效果定期优化预警规则\\n4. **建立预警处理流程**：建立预警处理流程，确保预警得到及时处理\\n\\n---\\n\\n## 十四、技术支持\\n\\n### 14.1 联系方式\\n\\n- **技术支持邮箱**：support@yyc3-catering.com\\n- **技术支持电话**：400-XXX-XXXX\\n- **在线客服**：登录系统后点击右下角客服图标\\n\\n### 14.2 反馈建议\\n\\n如果您在使用过程中有任何问题或建议，欢迎通过以下方式反馈：\\n- 在线反馈：登录系统后点击\\\"反馈建议\\\"\\n- 邮件反馈：feedback@yyc3-catering.com\\n- 电话反馈：400-XXX-XXXX\\n\\n---\\n\\n**文档结束**\",\"originTextLength\":1538,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768859269895}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/components/analytics/__tests__/CustomerAnalytics.test.ts": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":396,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":396,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"import { describe, it, expect, beforeEach, vi, afterEach } from \\\\'vitest\\\\'\\\\nimport { mount } from \\\\'@vue/test-utils\\\\'\\\\nimport { nextTick } from \\\\'vue\\\\'\\\\nimport { ElMessage } from \\\\'element-plus\\\\'\\\\nimport * as echarts from \\\\'echarts\\\\'\\\\nimport CustomerAnalytics from \\\\'@/components/analytics/CustomerAnalytics.vue\\\\'\\\\n\\\\nvi.mock(\\\\'element-plus\\\\', async () => {\\\\n  const actual = await vi.importActual(\\\\'element-plus\\\\')\\\\n  return {\\\\n    ...actual,\\\\n    ElMessage: {\\\\n      success: vi.fn(),\\\\n      error: vi.fn(),\\\\n      info: vi.fn(),\\\\n      warning: vi.fn()\\\\n    }\\\\n  }\\\\n})\\\\n\\\\nvi.mock(\\\\'echarts\\\\', () => ({\\\\n  default: {\\\\n    init: vi.fn(() => ({\\\\n      setOption: vi.fn(),\\\\n      dispose: vi.fn()\\\\n    })),\\\\n    graphic: {\\\\n      LinearGradient: vi.fn()\\\\n    }\\\\n  }\\\\n}))\\\\n\\\\ndescribe(\\\\'CustomerAnalytics组件\\\\', () => {\\\\n  let wrapper: any\\\\n\\\\n  beforeEach(() => {\\\\n    wrapper = mount(CustomerAnalytics)\\\\n    vi.clearAllMocks()\\\\n  })\\\\n\\\\n  afterEach(() => {\\\\n    if (wrapper) {\\\\n      wrapper.unmount()\\\\n    }\\\\n  })\\\\n\\\\n  describe(\\\\'组件渲染\\\\', () => {\\\\n    it(\\\\'应该正确渲染组件\\\\', () => {\\\\n      expect(wrapper.find(\\\\'.customer-analytics\\\\').exists()).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确渲染分析头部\\\\', () => {\\\\n      expect(wrapper.find(\\\\'.analytics-header\\\\').exists()).toBe(true)\\\\n      expect(wrapper.find(\\\\'.header-title h3\\\\').text()).toBe(\\\\'客户分析\\\\')\\\\n      expect(wrapper.find(\\\\'.header-title p\\\\').text()).toBe(\\\\'了解客户行为和价值贡献\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该正确渲染视图模式切换按钮\\\\', () => {\\\\n      const buttons = wrapper.findAll(\\\\'.el-button\\\\')\\\\n      expect(buttons.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确渲染分析内容区域\\\\', () => {\\\\n      expect(wrapper.find(\\\\'.analytics-content\\\\').exists()).toBe(true)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'视图模式切换\\\\', () => {\\\\n    it(\\\\'默认应该显示增长视图\\\\', () => {\\\\n      expect(wrapper.vm.viewMode).toBe(\\\\'growth\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该能够切换到分段视图\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'segments\\\\' })\\\\n      expect(wrapper.vm.viewMode).toBe(\\\\'segments\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该能够切换到行为视图\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'behavior\\\\' })\\\\n      expect(wrapper.vm.viewMode).toBe(\\\\'behavior\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该能够切换到价值视图\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'value\\\\' })\\\\n      expect(wrapper.vm.viewMode).toBe(\\\\'value\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该能够切换到地理视图\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'geo\\\\' })\\\\n      expect(wrapper.vm.viewMode).toBe(\\\\'geo\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'增长视图\\\\', () => {\\\\n    it(\\\\'应该正确渲染增长视图\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'growth\\\\' })\\\\n      expect(wrapper.find(\\\\'.growth-view\\\\').exists()).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该显示客户增长趋势图表\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'growth\\\\' })\\\\n      expect(wrapper.vm.growthChart).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该显示客户来源分析图表\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'growth\\\\' })\\\\n      expect(wrapper.vm.sourceChart).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该显示客户留存率图表\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'growth\\\\' })\\\\n      expect(wrapper.vm.retentionChart).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该显示客户流失分析图表\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'growth\\\\' })\\\\n      expect(wrapper.vm.churnChart).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该能够切换增长粒度\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'growth\\\\', growthGranularity: \\\\'week\\\\' })\\\\n      expect(wrapper.vm.growthGranularity).toBe(\\\\'week\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该能够加载增长数据\\\\', async () => {\\\\n      await wrapper.vm.loadGrowthData()\\\\n      expect(ElMessage.info).toHaveBeenCalledWith(\\\\'加载增长数据...\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'分段视图\\\\', () => {\\\\n    it(\\\\'应该正确渲染分段视图\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'segments\\\\' })\\\\n      expect(wrapper.find(\\\\'.segments-view\\\\').exists()).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该显示客户分段概览\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'segments\\\\' })\\\\n      expect(wrapper.find(\\\\'.segment-overview\\\\').exists()).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示客户分段数据\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'segments\\\\' })\\\\n      const segments = wrapper.vm.customerSegments\\\\n      expect(segments).toHaveLength(4)\\\\n      expect(segments[0].name).toBe(\\\\'核心客户\\\\')\\\\n      expect(segments[0].count).toBe(125)\\\\n      expect(segments[0].percentage).toBe(25)\\\\n    })\\\\n\\\\n    it(\\\\'应该显示分段特征分析图表\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'segments\\\\' })\\\\n      expect(wrapper.vm.segmentRadarChart).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该显示RFM客户价值矩阵图表\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'segments\\\\' })\\\\n      expect(wrapper.vm.rfmMatrixChart).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示核心客户分段\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'segments\\\\' })\\\\n      const coreSegment = wrapper.vm.customerSegments.find((s: any) => s.name === \\\\'核心客户\\\\')\\\\n      expect(coreSegment).toBeDefined()\\\\n      expect(coreSegment.tagType).toBe(\\\\'danger\\\\')\\\\n      expect(coreSegment.color).toBe(\\\\'#F56C6C\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示重要客户分段\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'segments\\\\' })\\\\n      const importantSegment = wrapper.vm.customerSegments.find((s: any) => s.name === \\\\'重要客户\\\\')\\\\n      expect(importantSegment).toBeDefined()\\\\n      expect(importantSegment.tagType).toBe(\\\\'warning\\\\')\\\\n      expect(importantSegment.color).toBe(\\\\'#E6A23C\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示普通客户分段\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'segments\\\\' })\\\\n      const normalSegment = wrapper.vm.customerSegments.find((s: any) => s.name === \\\\'普通客户\\\\')\\\\n      expect(normalSegment).toBeDefined()\\\\n      expect(normalSegment.tagType).toBe(\\\\'primary\\\\')\\\\n      expect(normalSegment.color).toBe(\\\\'#409EFF\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示潜在客户分段\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'segments\\\\' })\\\\n      const potentialSegment = wrapper.vm.customerSegments.find((s: any) => s.name === \\\\'潜在客户\\\\')\\\\n      expect(potentialSegment).toBeDefined()\\\\n      expect(potentialSegment.tagType).toBe(\\\\'info\\\\')\\\\n      expect(potentialSegment.color).toBe(\\\\'#909399\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'行为视图\\\\', () => {\\\\n    it(\\\\'应该正确渲染行为视图\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'behavior\\\\' })\\\\n      expect(wrapper.find(\\\\'.behavior-view\\\\').exists()).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该显示消费频次分布图表\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'behavior\\\\' })\\\\n      expect(wrapper.vm.frequencyChart).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该显示消费金额分布图表\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'behavior\\\\' })\\\\n      expect(wrapper.vm.amountChart).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该显示消费时间偏好图表\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'behavior\\\\' })\\\\n      expect(wrapper.vm.timePreferenceChart).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该显示菜品偏好分析图表\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'behavior\\\\' })\\\\n      expect(wrapper.vm.dishPreferenceChart).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该显示客户行为路径图表\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'behavior\\\\' })\\\\n      expect(wrapper.vm.behaviorPathChart).toBeDefined()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'价值视图\\\\', () => {\\\\n    it(\\\\'应该正确渲染价值视图\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'value\\\\' })\\\\n      expect(wrapper.find(\\\\'.value-view\\\\').exists()).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示价值指标卡片\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'value\\\\' })\\\\n      const metrics = wrapper.vm.valueMetrics\\\\n      expect(metrics).toHaveLength(4)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示客户总数指标\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'value\\\\' })\\\\n      const totalCustomers = wrapper.vm.valueMetrics.find((m: any) => m.key === \\\\'totalCustomers\\\\')\\\\n      expect(totalCustomers).toBeDefined()\\\\n      expect(totalCustomers.label).toBe(\\\\'客户总数\\\\')\\\\n      expect(totalCustomers.value).toBe(500)\\\\n      expect(totalCustomers.change).toBe(12.5)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示平均终身价值指标\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'value\\\\' })\\\\n      const avgLTV = wrapper.vm.valueMetrics.find((m: any) => m.key === \\\\'avgLTV\\\\')\\\\n      expect(avgLTV).toBeDefined()\\\\n      expect(avgLTV.label).toBe(\\\\'平均终身价值\\\\')\\\\n      expect(avgLTV.value).toBe(\\\\'¥3,250\\\\')\\\\n      expect(avgLTV.change).toBe(8.3)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示客户保留率指标\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'value\\\\' })\\\\n      const retentionRate = wrapper.vm.valueMetrics.find((m: any) => m.key === \\\\'retentionRate\\\\')\\\\n      expect(retentionRate).toBeDefined()\\\\n      expect(retentionRate.label).toBe(\\\\'客户保留率\\\\')\\\\n      expect(retentionRate.value).toBe(\\\\'85.2%\\\\')\\\\n      expect(retentionRate.change).toBe(2.1)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示客户满意度指标\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'value\\\\' })\\\\n      const satisfaction = wrapper.vm.valueMetrics.find((m: any) => m.key === \\\\'satisfaction\\\\')\\\\n      expect(satisfaction).toBeDefined()\\\\n      expect(satisfaction.label).toBe(\\\\'客户满意度\\\\')\\\\n      expect(satisfaction.value).toBe(\\\\'4.6/5.0\\\\')\\\\n      expect(satisfaction.change).toBe(5.5)\\\\n    })\\\\n\\\\n    it(\\\\'应该显示客户价值趋势图表\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'value\\\\' })\\\\n      expect(wrapper.vm.valueTrendChart).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该显示高价值客户TOP10表格\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'value\\\\' })\\\\n      const topCustomers = wrapper.vm.topValueCustomers\\\\n      expect(topCustomers).toHaveLength(10)\\\\n      expect(topCustomers[0].name).toBe(\\\\'张三\\\\')\\\\n      expect(topCustomers[0].ltv).toBe(15800)\\\\n    })\\\\n\\\\n    it(\\\\'应该显示客户生命周期价值分析图表\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'value\\\\' })\\\\n      expect(wrapper.vm.ltvChart).toBeDefined()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'地理视图\\\\', () => {\\\\n    it(\\\\'应该正确渲染地理视图\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'geo\\\\' })\\\\n      expect(wrapper.find(\\\\'.geo-view\\\\').exists()).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该显示客户地理分布图表\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'geo\\\\' })\\\\n      expect(wrapper.vm.geoChart).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该显示区域销售排行表格\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'geo\\\\' })\\\\n      const regionSales = wrapper.vm.regionSales\\\\n      expect(regionSales).toHaveLength(4)\\\\n      expect(regionSales[0].region).toBe(\\\\'朝阳区\\\\')\\\\n      expect(regionSales[0].customers).toBe(180)\\\\n      expect(regionSales[0].revenue).toBe(285000)\\\\n    })\\\\n\\\\n    it(\\\\'应该显示配送区域分析图表\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'geo\\\\' })\\\\n      expect(wrapper.vm.deliveryChart).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该显示区域对比分析图表\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'geo\\\\' })\\\\n      expect(wrapper.vm.regionCompareChart).toBeDefined()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'图表初始化\\\\', () => {\\\\n    it(\\\\'应该正确初始化增长趋势图表\\\\', () => {\\\\n      wrapper.vm.initGrowthChart()\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确初始化客户来源图表\\\\', () => {\\\\n      wrapper.vm.initSourceChart()\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确初始化客户留存率图表\\\\', () => {\\\\n      wrapper.vm.initRetentionChart()\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确初始化客户流失图表\\\\', () => {\\\\n      wrapper.vm.initChurnChart()\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确初始化分段雷达图表\\\\', () => {\\\\n      wrapper.vm.initSegmentRadarChart()\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确初始化RFM矩阵图表\\\\', () => {\\\\n      wrapper.vm.initRfmMatrixChart()\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确初始化消费频次图表\\\\', () => {\\\\n      wrapper.vm.initFrequencyChart()\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确初始化消费金额图表\\\\', () => {\\\\n      wrapper.vm.initAmountChart()\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确初始化时间偏好图表\\\\', () => {\\\\n      wrapper.vm.initTimePreferenceChart()\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确初始化菜品偏好图表\\\\', () => {\\\\n      wrapper.vm.initDishPreferenceChart()\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确初始化行为路径图表\\\\', () => {\\\\n      wrapper.vm.initBehaviorPathChart()\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确初始化价值趋势图表\\\\', () => {\\\\n      wrapper.vm.initValueTrendChart()\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确初始化生命周期价值图表\\\\', () => {\\\\n      wrapper.vm.initLtvChart()\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确初始化地理分布图表\\\\', () => {\\\\n      wrapper.vm.initGeoChart()\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确初始化配送区域图表\\\\', () => {\\\\n      wrapper.vm.initDeliveryChart()\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确初始化区域对比图表\\\\', () => {\\\\n      wrapper.vm.initRegionCompareChart()\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'响应式行为\\\\', () => {\\\\n    it(\\\\'应该在视图模式变化时重新初始化图表\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'segments\\\\' })\\\\n      await nextTick()\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确处理增长粒度变化\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'growth\\\\', growthGranularity: \\\\'week\\\\' })\\\\n      expect(wrapper.vm.growthGranularity).toBe(\\\\'week\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'数据验证\\\\', () => {\\\\n    it(\\\\'客户分段数据应该包含所有必需字段\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'segments\\\\' })\\\\n      const segment = wrapper.vm.customerSegments[0]\\\\n      expect(segment).toHaveProperty(\\\\'name\\\\')\\\\n      expect(segment).toHaveProperty(\\\\'count\\\\')\\\\n      expect(segment).toHaveProperty(\\\\'percentage\\\\')\\\\n      expect(segment).toHaveProperty(\\\\'avgSpent\\\\')\\\\n      expect(segment).toHaveProperty(\\\\'frequency\\\\')\\\\n      expect(segment).toHaveProperty(\\\\'tagType\\\\')\\\\n      expect(segment).toHaveProperty(\\\\'color\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'价值指标数据应该包含所有必需字段\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'value\\\\' })\\\\n      const metric = wrapper.vm.valueMetrics[0]\\\\n      expect(metric).toHaveProperty(\\\\'key\\\\')\\\\n      expect(metric).toHaveProperty(\\\\'label\\\\')\\\\n      expect(metric).toHaveProperty(\\\\'value\\\\')\\\\n      expect(metric).toHaveProperty(\\\\'change\\\\')\\\\n      expect(metric).toHaveProperty(\\\\'icon\\\\')\\\\n      expect(metric).toHaveProperty(\\\\'color\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'高价值客户数据应该包含所有必需字段\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'value\\\\' })\\\\n      const customer = wrapper.vm.topValueCustomers[0]\\\\n      expect(customer).toHaveProperty(\\\\'name\\\\')\\\\n      expect(customer).toHaveProperty(\\\\'ltv\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'区域销售数据应该包含所有必需字段\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'geo\\\\' })\\\\n      const region = wrapper.vm.regionSales[0]\\\\n      expect(region).toHaveProperty(\\\\'region\\\\')\\\\n      expect(region).toHaveProperty(\\\\'customers\\\\')\\\\n      expect(region).toHaveProperty(\\\\'revenue\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'边界情况\\\\', () => {\\\\n    it(\\\\'应该处理空图表引用\\\\', () => {\\\\n      wrapper.vm.growthChart.value = null\\\\n      expect(() => wrapper.vm.initGrowthChart()).not.toThrow()\\\\n    })\\\\n\\\\n    it(\\\\'应该处理无效的视图模式\\\\', async () => {\\\\n      await wrapper.setData({ viewMode: \\\\'invalid\\\\' })\\\\n      expect(wrapper.vm.viewMode).toBe(\\\\'invalid\\\\')\\\\n    })\\\\n  })\\\\n})\\\\n\",\"originAcceptText\":\"import { describe, it, expect, beforeEach, vi, afterEach } from 'vitest'\\nimport { mount } from '@vue/test-utils'\\nimport { nextTick } from 'vue'\\nimport { ElMessage } from 'element-plus'\\nimport * as echarts from 'echarts'\\nimport CustomerAnalytics from '@/components/analytics/CustomerAnalytics.vue'\\n\\nvi.mock('element-plus', async () => {\\n  const actual = await vi.importActual('element-plus')\\n  return {\\n    ...actual,\\n    ElMessage: {\\n      success: vi.fn(),\\n      error: vi.fn(),\\n      info: vi.fn(),\\n      warning: vi.fn()\\n    }\\n  }\\n})\\n\\nvi.mock('echarts', () => ({\\n  default: {\\n    init: vi.fn(() => ({\\n      setOption: vi.fn(),\\n      dispose: vi.fn()\\n    })),\\n    graphic: {\\n      LinearGradient: vi.fn()\\n    }\\n  }\\n}))\\n\\ndescribe('CustomerAnalytics组件', () => {\\n  let wrapper: any\\n\\n  beforeEach(() => {\\n    wrapper = mount(CustomerAnalytics)\\n    vi.clearAllMocks()\\n  })\\n\\n  afterEach(() => {\\n    if (wrapper) {\\n      wrapper.unmount()\\n    }\\n  })\\n\\n  describe('组件渲染', () => {\\n    it('应该正确渲染组件', () => {\\n      expect(wrapper.find('.customer-analytics').exists()).toBe(true)\\n    })\\n\\n    it('应该正确渲染分析头部', () => {\\n      expect(wrapper.find('.analytics-header').exists()).toBe(true)\\n      expect(wrapper.find('.header-title h3').text()).toBe('客户分析')\\n      expect(wrapper.find('.header-title p').text()).toBe('了解客户行为和价值贡献')\\n    })\\n\\n    it('应该正确渲染视图模式切换按钮', () => {\\n      const buttons = wrapper.findAll('.el-button')\\n      expect(buttons.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确渲染分析内容区域', () => {\\n      expect(wrapper.find('.analytics-content').exists()).toBe(true)\\n    })\\n  })\\n\\n  describe('视图模式切换', () => {\\n    it('默认应该显示增长视图', () => {\\n      expect(wrapper.vm.viewMode).toBe('growth')\\n    })\\n\\n    it('应该能够切换到分段视图', async () => {\\n      await wrapper.setData({ viewMode: 'segments' })\\n      expect(wrapper.vm.viewMode).toBe('segments')\\n    })\\n\\n    it('应该能够切换到行为视图', async () => {\\n      await wrapper.setData({ viewMode: 'behavior' })\\n      expect(wrapper.vm.viewMode).toBe('behavior')\\n    })\\n\\n    it('应该能够切换到价值视图', async () => {\\n      await wrapper.setData({ viewMode: 'value' })\\n      expect(wrapper.vm.viewMode).toBe('value')\\n    })\\n\\n    it('应该能够切换到地理视图', async () => {\\n      await wrapper.setData({ viewMode: 'geo' })\\n      expect(wrapper.vm.viewMode).toBe('geo')\\n    })\\n  })\\n\\n  describe('增长视图', () => {\\n    it('应该正确渲染增长视图', async () => {\\n      await wrapper.setData({ viewMode: 'growth' })\\n      expect(wrapper.find('.growth-view').exists()).toBe(true)\\n    })\\n\\n    it('应该显示客户增长趋势图表', async () => {\\n      await wrapper.setData({ viewMode: 'growth' })\\n      expect(wrapper.vm.growthChart).toBeDefined()\\n    })\\n\\n    it('应该显示客户来源分析图表', async () => {\\n      await wrapper.setData({ viewMode: 'growth' })\\n      expect(wrapper.vm.sourceChart).toBeDefined()\\n    })\\n\\n    it('应该显示客户留存率图表', async () => {\\n      await wrapper.setData({ viewMode: 'growth' })\\n      expect(wrapper.vm.retentionChart).toBeDefined()\\n    })\\n\\n    it('应该显示客户流失分析图表', async () => {\\n      await wrapper.setData({ viewMode: 'growth' })\\n      expect(wrapper.vm.churnChart).toBeDefined()\\n    })\\n\\n    it('应该能够切换增长粒度', async () => {\\n      await wrapper.setData({ viewMode: 'growth', growthGranularity: 'week' })\\n      expect(wrapper.vm.growthGranularity).toBe('week')\\n    })\\n\\n    it('应该能够加载增长数据', async () => {\\n      await wrapper.vm.loadGrowthData()\\n      expect(ElMessage.info).toHaveBeenCalledWith('加载增长数据...')\\n    })\\n  })\\n\\n  describe('分段视图', () => {\\n    it('应该正确渲染分段视图', async () => {\\n      await wrapper.setData({ viewMode: 'segments' })\\n      expect(wrapper.find('.segments-view').exists()).toBe(true)\\n    })\\n\\n    it('应该显示客户分段概览', async () => {\\n      await wrapper.setData({ viewMode: 'segments' })\\n      expect(wrapper.find('.segment-overview').exists()).toBe(true)\\n    })\\n\\n    it('应该正确显示客户分段数据', async () => {\\n      await wrapper.setData({ viewMode: 'segments' })\\n      const segments = wrapper.vm.customerSegments\\n      expect(segments).toHaveLength(4)\\n      expect(segments[0].name).toBe('核心客户')\\n      expect(segments[0].count).toBe(125)\\n      expect(segments[0].percentage).toBe(25)\\n    })\\n\\n    it('应该显示分段特征分析图表', async () => {\\n      await wrapper.setData({ viewMode: 'segments' })\\n      expect(wrapper.vm.segmentRadarChart).toBeDefined()\\n    })\\n\\n    it('应该显示RFM客户价值矩阵图表', async () => {\\n      await wrapper.setData({ viewMode: 'segments' })\\n      expect(wrapper.vm.rfmMatrixChart).toBeDefined()\\n    })\\n\\n    it('应该正确显示核心客户分段', async () => {\\n      await wrapper.setData({ viewMode: 'segments' })\\n      const coreSegment = wrapper.vm.customerSegments.find((s: any) => s.name === '核心客户')\\n      expect(coreSegment).toBeDefined()\\n      expect(coreSegment.tagType).toBe('danger')\\n      expect(coreSegment.color).toBe('#F56C6C')\\n    })\\n\\n    it('应该正确显示重要客户分段', async () => {\\n      await wrapper.setData({ viewMode: 'segments' })\\n      const importantSegment = wrapper.vm.customerSegments.find((s: any) => s.name === '重要客户')\\n      expect(importantSegment).toBeDefined()\\n      expect(importantSegment.tagType).toBe('warning')\\n      expect(importantSegment.color).toBe('#E6A23C')\\n    })\\n\\n    it('应该正确显示普通客户分段', async () => {\\n      await wrapper.setData({ viewMode: 'segments' })\\n      const normalSegment = wrapper.vm.customerSegments.find((s: any) => s.name === '普通客户')\\n      expect(normalSegment).toBeDefined()\\n      expect(normalSegment.tagType).toBe('primary')\\n      expect(normalSegment.color).toBe('#409EFF')\\n    })\\n\\n    it('应该正确显示潜在客户分段', async () => {\\n      await wrapper.setData({ viewMode: 'segments' })\\n      const potentialSegment = wrapper.vm.customerSegments.find((s: any) => s.name === '潜在客户')\\n      expect(potentialSegment).toBeDefined()\\n      expect(potentialSegment.tagType).toBe('info')\\n      expect(potentialSegment.color).toBe('#909399')\\n    })\\n  })\\n\\n  describe('行为视图', () => {\\n    it('应该正确渲染行为视图', async () => {\\n      await wrapper.setData({ viewMode: 'behavior' })\\n      expect(wrapper.find('.behavior-view').exists()).toBe(true)\\n    })\\n\\n    it('应该显示消费频次分布图表', async () => {\\n      await wrapper.setData({ viewMode: 'behavior' })\\n      expect(wrapper.vm.frequencyChart).toBeDefined()\\n    })\\n\\n    it('应该显示消费金额分布图表', async () => {\\n      await wrapper.setData({ viewMode: 'behavior' })\\n      expect(wrapper.vm.amountChart).toBeDefined()\\n    })\\n\\n    it('应该显示消费时间偏好图表', async () => {\\n      await wrapper.setData({ viewMode: 'behavior' })\\n      expect(wrapper.vm.timePreferenceChart).toBeDefined()\\n    })\\n\\n    it('应该显示菜品偏好分析图表', async () => {\\n      await wrapper.setData({ viewMode: 'behavior' })\\n      expect(wrapper.vm.dishPreferenceChart).toBeDefined()\\n    })\\n\\n    it('应该显示客户行为路径图表', async () => {\\n      await wrapper.setData({ viewMode: 'behavior' })\\n      expect(wrapper.vm.behaviorPathChart).toBeDefined()\\n    })\\n  })\\n\\n  describe('价值视图', () => {\\n    it('应该正确渲染价值视图', async () => {\\n      await wrapper.setData({ viewMode: 'value' })\\n      expect(wrapper.find('.value-view').exists()).toBe(true)\\n    })\\n\\n    it('应该正确显示价值指标卡片', async () => {\\n      await wrapper.setData({ viewMode: 'value' })\\n      const metrics = wrapper.vm.valueMetrics\\n      expect(metrics).toHaveLength(4)\\n    })\\n\\n    it('应该正确显示客户总数指标', async () => {\\n      await wrapper.setData({ viewMode: 'value' })\\n      const totalCustomers = wrapper.vm.valueMetrics.find((m: any) => m.key === 'totalCustomers')\\n      expect(totalCustomers).toBeDefined()\\n      expect(totalCustomers.label).toBe('客户总数')\\n      expect(totalCustomers.value).toBe(500)\\n      expect(totalCustomers.change).toBe(12.5)\\n    })\\n\\n    it('应该正确显示平均终身价值指标', async () => {\\n      await wrapper.setData({ viewMode: 'value' })\\n      const avgLTV = wrapper.vm.valueMetrics.find((m: any) => m.key === 'avgLTV')\\n      expect(avgLTV).toBeDefined()\\n      expect(avgLTV.label).toBe('平均终身价值')\\n      expect(avgLTV.value).toBe('¥3,250')\\n      expect(avgLTV.change).toBe(8.3)\\n    })\\n\\n    it('应该正确显示客户保留率指标', async () => {\\n      await wrapper.setData({ viewMode: 'value' })\\n      const retentionRate = wrapper.vm.valueMetrics.find((m: any) => m.key === 'retentionRate')\\n      expect(retentionRate).toBeDefined()\\n      expect(retentionRate.label).toBe('客户保留率')\\n      expect(retentionRate.value).toBe('85.2%')\\n      expect(retentionRate.change).toBe(2.1)\\n    })\\n\\n    it('应该正确显示客户满意度指标', async () => {\\n      await wrapper.setData({ viewMode: 'value' })\\n      const satisfaction = wrapper.vm.valueMetrics.find((m: any) => m.key === 'satisfaction')\\n      expect(satisfaction).toBeDefined()\\n      expect(satisfaction.label).toBe('客户满意度')\\n      expect(satisfaction.value).toBe('4.6/5.0')\\n      expect(satisfaction.change).toBe(5.5)\\n    })\\n\\n    it('应该显示客户价值趋势图表', async () => {\\n      await wrapper.setData({ viewMode: 'value' })\\n      expect(wrapper.vm.valueTrendChart).toBeDefined()\\n    })\\n\\n    it('应该显示高价值客户TOP10表格', async () => {\\n      await wrapper.setData({ viewMode: 'value' })\\n      const topCustomers = wrapper.vm.topValueCustomers\\n      expect(topCustomers).toHaveLength(10)\\n      expect(topCustomers[0].name).toBe('张三')\\n      expect(topCustomers[0].ltv).toBe(15800)\\n    })\\n\\n    it('应该显示客户生命周期价值分析图表', async () => {\\n      await wrapper.setData({ viewMode: 'value' })\\n      expect(wrapper.vm.ltvChart).toBeDefined()\\n    })\\n  })\\n\\n  describe('地理视图', () => {\\n    it('应该正确渲染地理视图', async () => {\\n      await wrapper.setData({ viewMode: 'geo' })\\n      expect(wrapper.find('.geo-view').exists()).toBe(true)\\n    })\\n\\n    it('应该显示客户地理分布图表', async () => {\\n      await wrapper.setData({ viewMode: 'geo' })\\n      expect(wrapper.vm.geoChart).toBeDefined()\\n    })\\n\\n    it('应该显示区域销售排行表格', async () => {\\n      await wrapper.setData({ viewMode: 'geo' })\\n      const regionSales = wrapper.vm.regionSales\\n      expect(regionSales).toHaveLength(4)\\n      expect(regionSales[0].region).toBe('朝阳区')\\n      expect(regionSales[0].customers).toBe(180)\\n      expect(regionSales[0].revenue).toBe(285000)\\n    })\\n\\n    it('应该显示配送区域分析图表', async () => {\\n      await wrapper.setData({ viewMode: 'geo' })\\n      expect(wrapper.vm.deliveryChart).toBeDefined()\\n    })\\n\\n    it('应该显示区域对比分析图表', async () => {\\n      await wrapper.setData({ viewMode: 'geo' })\\n      expect(wrapper.vm.regionCompareChart).toBeDefined()\\n    })\\n  })\\n\\n  describe('图表初始化', () => {\\n    it('应该正确初始化增长趋势图表', () => {\\n      wrapper.vm.initGrowthChart()\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n\\n    it('应该正确初始化客户来源图表', () => {\\n      wrapper.vm.initSourceChart()\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n\\n    it('应该正确初始化客户留存率图表', () => {\\n      wrapper.vm.initRetentionChart()\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n\\n    it('应该正确初始化客户流失图表', () => {\\n      wrapper.vm.initChurnChart()\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n\\n    it('应该正确初始化分段雷达图表', () => {\\n      wrapper.vm.initSegmentRadarChart()\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n\\n    it('应该正确初始化RFM矩阵图表', () => {\\n      wrapper.vm.initRfmMatrixChart()\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n\\n    it('应该正确初始化消费频次图表', () => {\\n      wrapper.vm.initFrequencyChart()\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n\\n    it('应该正确初始化消费金额图表', () => {\\n      wrapper.vm.initAmountChart()\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n\\n    it('应该正确初始化时间偏好图表', () => {\\n      wrapper.vm.initTimePreferenceChart()\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n\\n    it('应该正确初始化菜品偏好图表', () => {\\n      wrapper.vm.initDishPreferenceChart()\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n\\n    it('应该正确初始化行为路径图表', () => {\\n      wrapper.vm.initBehaviorPathChart()\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n\\n    it('应该正确初始化价值趋势图表', () => {\\n      wrapper.vm.initValueTrendChart()\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n\\n    it('应该正确初始化生命周期价值图表', () => {\\n      wrapper.vm.initLtvChart()\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n\\n    it('应该正确初始化地理分布图表', () => {\\n      wrapper.vm.initGeoChart()\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n\\n    it('应该正确初始化配送区域图表', () => {\\n      wrapper.vm.initDeliveryChart()\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n\\n    it('应该正确初始化区域对比图表', () => {\\n      wrapper.vm.initRegionCompareChart()\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n  })\\n\\n  describe('响应式行为', () => {\\n    it('应该在视图模式变化时重新初始化图表', async () => {\\n      await wrapper.setData({ viewMode: 'segments' })\\n      await nextTick()\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n\\n    it('应该正确处理增长粒度变化', async () => {\\n      await wrapper.setData({ viewMode: 'growth', growthGranularity: 'week' })\\n      expect(wrapper.vm.growthGranularity).toBe('week')\\n    })\\n  })\\n\\n  describe('数据验证', () => {\\n    it('客户分段数据应该包含所有必需字段', async () => {\\n      await wrapper.setData({ viewMode: 'segments' })\\n      const segment = wrapper.vm.customerSegments[0]\\n      expect(segment).toHaveProperty('name')\\n      expect(segment).toHaveProperty('count')\\n      expect(segment).toHaveProperty('percentage')\\n      expect(segment).toHaveProperty('avgSpent')\\n      expect(segment).toHaveProperty('frequency')\\n      expect(segment).toHaveProperty('tagType')\\n      expect(segment).toHaveProperty('color')\\n    })\\n\\n    it('价值指标数据应该包含所有必需字段', async () => {\\n      await wrapper.setData({ viewMode: 'value' })\\n      const metric = wrapper.vm.valueMetrics[0]\\n      expect(metric).toHaveProperty('key')\\n      expect(metric).toHaveProperty('label')\\n      expect(metric).toHaveProperty('value')\\n      expect(metric).toHaveProperty('change')\\n      expect(metric).toHaveProperty('icon')\\n      expect(metric).toHaveProperty('color')\\n    })\\n\\n    it('高价值客户数据应该包含所有必需字段', async () => {\\n      await wrapper.setData({ viewMode: 'value' })\\n      const customer = wrapper.vm.topValueCustomers[0]\\n      expect(customer).toHaveProperty('name')\\n      expect(customer).toHaveProperty('ltv')\\n    })\\n\\n    it('区域销售数据应该包含所有必需字段', async () => {\\n      await wrapper.setData({ viewMode: 'geo' })\\n      const region = wrapper.vm.regionSales[0]\\n      expect(region).toHaveProperty('region')\\n      expect(region).toHaveProperty('customers')\\n      expect(region).toHaveProperty('revenue')\\n    })\\n  })\\n\\n  describe('边界情况', () => {\\n    it('应该处理空图表引用', () => {\\n      wrapper.vm.growthChart.value = null\\n      expect(() => wrapper.vm.initGrowthChart()).not.toThrow()\\n    })\\n\\n    it('应该处理无效的视图模式', async () => {\\n      await wrapper.setData({ viewMode: 'invalid' })\\n      expect(wrapper.vm.viewMode).toBe('invalid')\\n    })\\n  })\\n})\\n\",\"originTextLength\":14272,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768859625895},{\"originRange\":{\"start\":{\"line\":20,\"character\":0},\"end\":{\"line\":36,\"character\":40}},\"modifyRange\":{\"start\":{\"line\":20,\"character\":0},\"end\":{\"line\":36,\"character\":40}},\"action\":\"None\",\"isLine\":false,\"originText\":\"vi.mock(\\\\'echarts\\\\', () => {\\\\n  const mockChartInstance = {\\\\n    setOption: vi.fn(),\\\\n    resize: vi.fn(),\\\\n    dispose: vi.fn(),\\\\n    on: vi.fn(),\\\\n    off: vi.fn(),\\\\n    clear: vi.fn()\\\\n  }\\\\n  return {\\\\n    default: {\\\\n      init: vi.fn(() => mockChartInstance),\\\\n      graphic: {\\\\n        LinearGradient: vi.fn()\\\\n      }\\\\n    },\\\\n    init: vi.fn(() => mockChartInstance)\",\"originAcceptText\":\"vi.mock('echarts', () => {\\n  const mockChartInstance = {\\n    setOption: vi.fn(),\\n    resize: vi.fn(),\\n    dispose: vi.fn(),\\n    on: vi.fn(),\\n    off: vi.fn(),\\n    clear: vi.fn()\\n  }\\n  return {\\n    default: {\\n      init: vi.fn(() => mockChartInstance),\\n      graphic: {\\n        LinearGradient: vi.fn()\\n      }\\n    },\\n    init: vi.fn(() => mockChartInstance)\",\"originTextLength\":356,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768860338530},{\"originRange\":{\"start\":{\"line\":30,\"character\":0},\"end\":{\"line\":30,\"character\":2}},\"modifyRange\":{\"start\":{\"line\":30,\"character\":0},\"end\":{\"line\":30,\"character\":2}},\"action\":\"None\",\"isLine\":false,\"originText\":\"})\",\"originAcceptText\":\"})\",\"originTextLength\":2,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768860338565},{\"originRange\":{\"start\":{\"line\":1,\"character\":0},\"end\":{\"line\":1,\"character\":49}},\"modifyRange\":{\"start\":{\"line\":1,\"character\":0},\"end\":{\"line\":1,\"character\":49}},\"action\":\"None\",\"isLine\":false,\"originText\":\"import { mount, nextTick } from \\\\'@vue/test-utils\\\\'\",\"originAcceptText\":\"import { mount, nextTick } from '@vue/test-utils'\",\"originTextLength\":49,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768860346178},{\"originRange\":{\"start\":{\"line\":1,\"character\":0},\"end\":{\"line\":2,\"character\":45}},\"modifyRange\":{\"start\":{\"line\":1,\"character\":0},\"end\":{\"line\":2,\"character\":45}},\"action\":\"None\",\"isLine\":false,\"originText\":\"import { mount } from \\\\'@vue/test-utils\\\\'\\\\nimport { nextTick as vueNextTick } from \\\\'vue\\\\'\",\"originAcceptText\":\"imp