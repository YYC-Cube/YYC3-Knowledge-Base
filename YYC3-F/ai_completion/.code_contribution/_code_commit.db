t canaryResult = await this.canaryDeployer.deploy(plan, {\\\\n      initialPercentage: 5,\\\\n      incrementPercentage: 10,\\\\n      maxPercentage: 100,\\\\n      healthCheckInterval: 30000,\\\\n      rollbackThreshold: 0.05\\\\n    });\\\\n    \\\\n    if (!canaryResult.success) {\\\\n      // 自动回滚\\\\n      await this.rollbackManager.rollback(canaryResult.deploymentId);\\\\n      throw new DeploymentError(canaryResult.error);\\\\n    }\\\\n    \\\\n    // 健康检查\\\\n    const healthCheck = await this.healthChecker.check({\\\\n      endpoints: plan.healthCheckEndpoints,\\\\n      timeout: 5000,\\\\n      retries: 3\\\\n    });\\\\n    \\\\n    if (!healthCheck.healthy) {\\\\n      await this.rollbackManager.rollback(canaryResult.deploymentId);\\\\n      throw new HealthCheckError(healthCheck.errors);\\\\n    }\\\\n    \\\\n    return canaryResult;\",\"originAcceptText\":\"  async executePlan(plan: ImprovementPlan): Promise<DeploymentResult> {\\n    // 金丝雀部署\\n    const canaryResult = await this.canaryDeployer.deploy(plan, {\\n      initialPercentage: 5,\\n      incrementPercentage: 10,\\n      maxPercentage: 100,\\n      healthCheckInterval: 30000,\\n      rollbackThreshold: 0.05\\n    });\\n    \\n    if (!canaryResult.success) {\\n      // 自动回滚\\n      await this.rollbackManager.rollback(canaryResult.deploymentId);\\n      throw new DeploymentError(canaryResult.error);\\n    }\\n    \\n    // 健康检查\\n    const healthCheck = await this.healthChecker.check({\\n      endpoints: plan.healthCheckEndpoints,\\n      timeout: 5000,\\n      retries: 3\\n    });\\n    \\n    if (!healthCheck.healthy) {\\n      await this.rollbackManager.rollback(canaryResult.deploymentId);\\n      throw new HealthCheckError(healthCheck.errors);\\n    }\\n    \\n    return canaryResult;\",\"originTextLength\":849,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1767732479971},{\"originRange\":{\"start\":{\"line\":224,\"character\":0},\"end\":{\"line\":225,\"character\":13}}