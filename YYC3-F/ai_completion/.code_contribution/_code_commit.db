e constructor() {}\\n\\n  /**\\n   * 获取单例实例\\n   */\\n  public static getInstance(): I18nService {\\n    if (!I18nService.instance) {\\n      I18nService.instance = new I18nService();\\n    }\\n    return I18nService.instance;\\n  }\\n\\n  /**\\n   * 设置当前语言\\n   * @param languageCode 语言代码\\n   */\\n  public setLanguage(languageCode: LanguageCode): void {\\n    if (this.resources[languageCode]) {\\n      this.currentLanguage = languageCode;\\n      // 保存到localStorage或cookie\\n      if (typeof window !== 'undefined') {\\n        localStorage.setItem('language', languageCode);\\n      }\\n    } else {\\n      throw new Error(`不支持的语言: ${languageCode}`);\\n    }\\n  }\\n\\n  /**\\n   * 获取当前语言\\n   */\\n  public getLanguage(): LanguageCode {\\n    return this.currentLanguage;\\n  }\\n\\n  /**\\n   * 获取翻译\\n   * @param key 翻译键\\n   * @param options 选项\\n   */\\n  public t(key: string, options: { [key: string]: any } = {}): string {\\n    const keys = key.split('.');\\n    let value: any = this.resources[this.currentLanguage];\\n\\n    for (const k of keys) {\\n      if (value && typeof value === 'object' && k in value) {\\n        value = value[k];\\n      } else {\\n        // 如果找不到翻译，返回键本身\\n        return key;\\n      }\\n    }\\n\\n    // 如果是字符串，进行变量替换\\n    if (typeof value === 'string') {\\n      return this.replacePlaceholders(value, options);\\n    }\\n\\n    // 如果不是字符串，返回键本身\\n    return key;\\n  }\\n\\n  /**\\n   * 替换占位符\\n   * @param text 文本\\n   * @param placeholders 占位符\\n   */\\n  private replacePlaceholders(text: string, placeholders: { [key: string]: any }): string {\\n    return text.replace(/\\\\{\\\\{([^}]+)\\\\}\\\\}/g, (match, key) => {\\n      return placeholders[key.trim()] !== undefined ? placeholders[key.trim()] : match;\\n    });\\n  }\\n\\n  /**\\n   * 获取支持的语言列表\\n   */\\n  public getSupportedLanguages(): LanguageConfig[] {\\n    return supportedLanguages;\\n  }\\n\\n  /**\\n   * 动态加载语言资源\\n   * @param languageCode 语言代码\\n   * @param resource 语言资源\\n   */\\n  public loadLanguage(languageCode: LanguageCode, resource: TranslationResource): void {\\n    this.resources[languageCode] = {\\n      ...this.resources[languageCode],\\n      ...resource\\n    };\\n  }\\n\\n  /**\\n   * 初始化语言\\n   */\\n  public init(): void {\\n    // 从localStorage或cookie获取语言设置\\n    if (typeof window !== 'undefined') {\\n      const savedLanguage = localStorage.getItem('language') as LanguageCode;\\n      if (savedLanguage && this.resources[savedLanguage]) {\\n        this.currentLanguage = savedLanguage;\\n      }\\n    }\\n  }\\n}\\n\\n// 导出单例实例\\nexport const i18n = I18nService.getInstance();\\n\",\"originTextLength\":21978,\"aiScene\":\"Completion\",\"behaviorType\":\"accept\",\"updateTime\":1766162509998}]",
  "range-cache-file:///Users/my/Downloads/%E6%99%BA%E6%9E%A2%E6%9C%8D%E5%8A%A1%E5%B9%B3%E5%8F%B0/lib/orders/__tests__/order.status.service.test.ts": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":127,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":127,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"/**\\\\n * @file 订单状态服务单元测试\\\\n * @description 测试订单状态服务的核心功能\\\\n * @module lib/orders/order.status.service\\\\n * @author YYC\\\\n * @version 1.0.0\\\\n * @created 2024-01-01\\\\n */\\\\n\\\\nimport { OrderStatus, LaundryItemStatus, QualityCheckStatus, OrderStatusService, orderStatusService } from \\\\'../order.status.service\\\\';\\\\n\\\\ndescribe(\\\\'OrderStatusService\\\\', () => {\\\\n  describe(\\\\'状态验证\\\\', () => {\\\\n    it(\\\\'应该正确验证有效的订单状态\\\\', () => {\\\\n      expect(orderStatusService.isValidOrderStatus(\\\\'pending\\\\')).toBe(true);\\\\n      expect(orderStatusService.isValidOrderStatus(\\\\'processing\\\\')).toBe(true);\\\\n      expect(orderStatusService.isValidOrderStatus(\\\\'cleaning\\\\')).toBe(true);\\\\n      expect(orderStatusService.isValidOrderStatus(\\\\'ironing\\\\')).toBe(true);\\\\n      expect(orderStatusService.isValidOrderStatus(\\\\'packaging\\\\')).toBe(true);\\\\n      expect(orderStatusService.isValidOrderStatus(\\\\'completed\\\\')).toBe(true);\\\\n      expect(orderStatusService.isValidOrderStatus(\\\\'delivered\\\\')).toBe(true);\\\\n      expect(orderStatusService.isValidOrderStatus(\\\\'cancelled\\\\')).toBe(true);\\\\n    });\\\\n\\\\n    it(\\\\'应该正确验证无效的订单状态\\\\', () => {\\\\n      expect(orderStatusService.isValidOrderStatus(\\\\'invalid\\\\')).toBe(false);\\\\n      expect(orderStatusService.isValidOrderStatus(\\\\'\\\\')).toBe(false);\\\\n      expect(orderStatusService.isValidOrderStatus(\\\\'unknown\\\\')).toBe(false);\\\\n    });\\\\n\\\\n    it(\\\\'应该正确验证物品状态\\\\', () => {\\\\n      expect(orderStatusService.isValidItemStatus(\\\\'received\\\\')).toBe(true);\\\\n      expect(orderStatusService.isValidItemStatus(\\\\'processed\\\\')).toBe(true);\\\\n      expect(orderStatusService.isValidItemStatus(\\\\'clean\\\\')).toBe(true);\\\\n      expect(orderStatusService.isValidItemStatus(\\\\'ironed\\\\')).toBe(true);\\\\n      expect(orderStatusService.isValidItemStatus(\\\\'packed\\\\')).toBe(true);\\\\n      expect(orderStatusService.isValidItemStatus(\\\\'invalid\\\\')).toBe(false);\\\\n    });\\\\n\\\\n    it(\\\\'应该正确验证质量检查状态\\\\', () => {\\\\n      expect(orderStatusService.isValidQualityCheckStatus(\\\\'pending\\\\')).toBe(true);\\\\n      expect(orderStatusService.isValidQualityCheckStatus(\\\\'passed\\\\')).toBe(true);\\\\n      expect(orderStatusService.isValidQualityCheckStatus(\\\\'failed\\\\')).toBe(true);\\\\n      expect(orderStatusService.isValidQualityCheckStatus(\\\\'invalid\\\\')).toBe(false);\\\\n    });\\\\n  });\\\\n\\\\n  describe(\\\\'状态转换\\\\', () => {\\\\n    it(\\\\'应该允许有效的状态转换\\\\', () => {\\\\n      // pending -> processing\\\\n      expect(orderStatusService.isValidTransition(OrderStatus.PENDING, OrderStatus.PROCESSING)).toBe(true);\\\\n      // pending -> cancelled\\\\n      expect(orderStatusService.isValidTransition(OrderStatus.PENDING, OrderStatus.CANCELLED)).toBe(true);\\\\n      // processing -> cleaning\\\\n      expect(orderStatusService.isValidTransition(OrderStatus.PROCESSING, OrderStatus.CLEANING)).toBe(true);\\\\n      // processing -> cancelled\\\\n      expect(orderStatusService.isValidTransition(OrderStatus.PROCESSING, OrderStatus.CANCELLED)).toBe(true);\\\\n      // cleaning -> ironing\\\\n      expect(orderStatusService.isValidTransition(OrderStatus.CLEANING, OrderStatus.IRONING)).toBe(true);\\\\n      // ironing -> packaging\\\\n      expect(orderStatusService.isValidTransition(OrderStatus.IRONING, OrderStatus.PACKAGING)).toBe(true);\\\\n      // packaging -> completed\\\\n      expect(orderStatusService.isValidTransition(OrderStatus.PACKAGING, OrderStatus.COMPLETED)).toBe(true);\\\\n      // completed -> delivered\\\\n      expect(orderStatusService.isValidTransition(OrderStatus.COMPLETED, OrderStatus.DELIVERED)).toBe(true);\\\\n    });\\\\n\\\\n    it(\\\\'应该拒绝无效的状态转换\\\\', () => {\\\\n      // pending -> completed (跳过中间状态)\\\\n      expect(orderStatusService.isValidTransition(OrderStatus.PENDING, OrderStatus.COMPLETED)).toBe(false);\\\\n      // cleaning -> completed (跳过中间状态)\\\\n      expect(orderStatusService.isValidTransition(OrderStatus.CLEANING, OrderStatus.COMPLETED)).toBe(false);\\\\n      // completed -> processing (状态回退)\\\\n      expect(orderStatusService.isValidTransition(OrderStatus.COMPLETED, OrderStatus.PROCESSING)).toBe(false);\\\\n      // delivered -> completed (状态回退)\\\\n      expect(orderStatusService.isValidTransition(OrderStatus.DELIVERED, OrderStatus.COMPLETED)).toBe(false);\\\\n      // cancelled -> processing (状态回退)\\\\n      expect(orderStatusService.isValidTransition(OrderStatus.CANCELLED, OrderStatus.PROCESSING)).toBe(false);\\\\n    });\\\\n\\\\n    it(\\\\'应该正确获取下一个可能的状态\\\\', () => {\\\\n      expect(orderStatusService.getNextPossibleStatus(OrderStatus.PENDING)).toEqual([OrderStatus.PROCESSING, OrderStatus.CANCELLED]);\\\\n      expect(orderStatusService.getNextPossibleStatus(OrderStatus.PROCESSING)).toEqual([OrderStatus.CLEANING, OrderStatus.CANCELLED]);\\\\n      expect(orderStatusService.getNextPossibleStatus(OrderStatus.CLEANING)).toEqual([OrderStatus.IRONING]);\\\\n      expect(orderStatusService.getNextPossibleStatus(OrderStatus.IRONING)).toEqual([OrderStatus.PACKAGING]);\\\\n      expect(orderStatusService.getNextPossibleStatus(OrderStatus.PACKAGING)).toEqual([OrderStatus.COMPLETED]);\\\\n      expect(orderStatusService.getNextPossibleStatus(OrderStatus.COMPLETED)).toEqual([OrderStatus.DELIVERED]);\\\\n      expect(orderStatusService.getNextPossibleStatus(OrderStatus.DELIVERED)).toEqual([]);\\\\n      expect(orderStatusService.getNextPossibleStatus(OrderStatus.CANCELLED)).toEqual([]);\\\\n    });\\\\n\\\\n    it(\\\\'应该正确进行状态转换\\\\', () => {\\\\n      // 有效的状态转换应该返回true\\\\n      expect(() => orderStatusService.transitionStatus(OrderStatus.PENDING, OrderStatus.PROCESSING)).not.toThrow();\\\\n      expect(orderStatusService.transitionStatus(OrderStatus.PENDING, OrderStatus.PROCESSING)).toBe(true);\\\\n    });\\\\n\\\\n    it(\\\\'应该对无效的状态转换抛出错误\\\\', () => {\\\\n      // 无效的状态转换应该抛出错误\\\\n      expect(() => orderStatusService.transitionStatus(OrderStatus.PENDING, OrderStatus.COMPLETED)).toThrow();\\\\n      expect(() => orderStatusService.transitionStatus(OrderStatus.PENDING, OrderStatus.COMPLETED)).toThrow(\\\\'无效的状态转换: pending -> completed\\\\');\\\\n    });\\\\n  });\\\\n\\\\n  describe(\\\\'状态显示名称\\\\', () => {\\\\n    it(\\\\'应该返回正确的订单状态显示名称\\\\', () => {\\\\n      expect(orderStatusService.getStatusDisplayName(OrderStatus.PENDING)).toBe(\\\\'待处理\\\\');\\\\n      expect(orderStatusService.getStatusDisplayName(OrderStatus.PROCESSING)).toBe(\\\\'处理中\\\\');\\\\n      expect(orderStatusService.getStatusDisplayName(OrderStatus.CLEANING)).toBe(\\\\'清洗中\\\\');\\\\n      expect(orderStatusService.getStatusDisplayName(OrderStatus.IRONING)).toBe(\\\\'熨烫中\\\\');\\\\n      expect(orderStatusService.getStatusDisplayName(OrderStatus.PACKAGING)).toBe(\\\\'包装中\\\\');\\\\n      expect(orderStatusService.getStatusDisplayName(OrderStatus.COMPLETED)).toBe(\\\\'已完成\\\\');\\\\n      expect(orderStatusService.getStatusDisplayName(OrderStatus.DELIVERED)).toBe(\\\\'已交付\\\\');\\\\n      expect(orderStatusService.getStatusDisplayName(OrderStatus.CANCELLED)).toBe(\\\\'已取消\\\\');\\\\n    });\\\\n\\\\n    it(\\\\'应该返回正确的物品状态显示名称\\\\', () => {\\\\n      expect(orderStatusService.getItemStatusDisplayName(LaundryItemStatus.RECEIVED)).toBe(\\\\'已接收\\\\');\\\\n      expect(orderStatusService.getItemStatusDisplayName(LaundryItemStatus.PROCESSED)).toBe(\\\\'处理中\\\\');\\\\n      expect(orderStatusService.getItemStatusDisplayName(LaundryItemStatus.CLEAN)).toBe(\\\\'已清洗\\\\');\\\\n      expect(orderStatusService.getItemStatusDisplayName(LaundryItemStatus.IRONED)).toBe(\\\\'已熨烫\\\\');\\\\n      expect(orderStatusService.getItemStatusDisplayName(LaundryItemStatus.PACKED)).toBe(\\\\'已包装\\\\');\\\\n    });\\\\n\\\\n    it(\\\\'应该返回正确的质量检查状态显示名称\\\\', () => {\\\\n      expect(orderStatusService.getQualityCheckStatusDisplayName(QualityCheckStatus.PENDING)).toBe(\\\\'待检查\\\\');\\\\n      expect(orderStatusService.getQualityCheckStatusDisplayName(QualityCheckStatus.PASSED)).toBe(\\\\'检查通过\\\\');\\\\n      expect(orderStatusService.getQualityCheckStatusDisplayName(QualityCheckStatus.FAILED)).toBe(\\\\'检查失败\\\\');\\\\n    });\\\\n  });\\\\n\\\\n  describe(\\\\'单例模式\\\\', () => {\\\\n    it(\\\\'应该返回相同的实例\\\\', () => {\\\\n      const instance1 = OrderStatusService.getInstance();\\\\n      const instance2 = OrderStatusService.getInstance();\\\\n      const instance3 = orderStatusService;\\\\n\\\\n      expect(instance1).toBe(instance2);\\\\n      expect(instance2).toBe(instance3);\\\\n    });\\\\n  });\\\\n});\\\\n\",\"originAcceptText\":\"/**\\n * @file 订单状态服务单元测试\\n * @description 测试订单状态服务的核心功能\\n * @module lib/orders/order.status.service\\n * @author YYC\\n * @version 1.0.0\\n * @created 2024-01-01\\n */\\n\\nimport { OrderStatus, LaundryItemStatus, QualityCheckStatus, OrderStatusService, orderStatusService } from '../order.status.service';\\n\\ndescribe('OrderStatusService', () => {\\n  describe('状态验证', () => {\\n    it('应该正确验证有效的订单状态', () => {\\n      expect(orderStatusService.isValidOrderStatus('pending')).toBe(true);\\n      expect(orderStatusService.isValidOrderStatus('processing')).toBe(true);\\n      expect(orderStatusService.isValidOrderStatus('cleaning')).toBe(true);\\n      expect(orderStatusService.isValidOrderStatus('ironing')).toBe(true);\\n      expect(orderStatusService.isValidOrderStatus('packaging')).toBe(true);\\n      expect(orderStatusService.isValidOrderStatus('completed')).toBe(true);\\n      expect(orderStatusService.isValidOrderStatus('delivered')).toBe(true);\\n      expect(orderStatusService.isValidOrderStatus('cancelled')).toBe(true);\\n    });\\n\\n    it('应该正确验证无效的订单状态', () => {\\n      expect(orderStatusService.isValidOrderStatus('invalid')).toBe(false);\\n      expect(orderStatusService.isValidOrderStatus('')).toBe(false);\\n      expect(orderStatusService.isValidOrderStatus('unknown')).toBe(false);\\n    });\\n\\n    it('应该正确验证物品状态', () => {\\n      expect(orderStatusService.isValidItemStatus('received')).toBe(true);\\n      expect(orderStatusService.isValidItemStatus('processed')).toBe(true);\\n      expect(orderStatusService.isValidItemStatus('clean')).toBe(true);\\n      expect(orderStatusService.isValidItemStatus('ironed')).toBe(true);\\n      expect(orderStatusService.isValidItemStatus('packed')).toBe(true);\\n      expect(orderStatusService.isValidItemStatus('invalid')).toBe(false);\\n    });\\n\\n    it('应该正确验证质量检查状态', () => {\\n      expect(orderStatusService.isValidQualityCheckStatus('pending')).toBe(true);\\n      expect(orderStatusService.isValidQualityCheckStatus('passed')).toBe(true);\\n      expect(orderStatusService.isValidQualityCheckStatus('failed')).toBe(true);\\n      expect(orderStatusService.isValidQualityCheckStatus('invalid')).toBe(false);\\n    });\\n  });\\n\\n  describe('状态转换', () => {\\n    it('应该允许有效的状态转换', () => {\\n      // pending -> processing\\n      expect(orderStatusService.isValidTransition(OrderStatus.PENDING, OrderStatus.PROCESSING)).toBe(true);\\n      // pending -> cancelled\\n      expect(orderStatusService.isValidTransition(OrderStatus.PENDING, OrderStatus.CANCELLED)).toBe(true);\\n      // processing -> cleaning\\n      expect(orderStatusService.isValidTransition(OrderStatus.PROCESSING, OrderStatus.CLEANING)).toBe(true);\\n      // processing -> cancelled\\n      expect(orderStatusService.isValidTransition(OrderStatus.PROCESSING, OrderStatus.CANCELLED)).toBe(true);\\n      // cleaning -> ironing\\n      expect(orderStatusService.isValidTransition(OrderStatus.CLEANING, OrderStatus.IRONING)).toBe(true);\\n      // ironing -> packaging\\n      expect(orderStatusService.isValidTransition(OrderStatus.IRONING, OrderStatus.PACKAGING)).toBe(true);\\n      // packaging -> completed\\n      expect(orderStatusService.isValidTransition(OrderStatus.PACKAGING, OrderStatus.COMPLETED)).toBe(true);\\n      // completed -> delivered\\n      expect(orderStatusService.isValidTransition(OrderStatus.COMPLETED, OrderStatus.DELIVERED)).toBe(true);\\n    });\\n\\n    it('应该拒绝无效的状态转换', () => {\\n      // pending -> completed (跳过中间状态)\\n      expect(orderStatusService.isValidTransition(OrderStatus.PENDING, OrderStatus.COMPLETED)).toBe(false);\\n      // cleaning -> completed (跳过中间状态)\\n      expect(orderStatusService.isValidTransition(OrderStatus.CLEANING, OrderStatus.COMPLETED)).toBe(false);\\n      // completed -> processing (状态回退)\\n      expect(orderStatusService.isValidTransition(OrderStatus.COMPLETED, OrderStatus.PROCESSING)).toBe(false);\\n      // delivered -> completed (状态回退)\\n      expect(orderStatusService.isValidTransition(OrderStatus.DELIVERED, OrderStatus.COMPLETED)).toBe(false);\\n      // cancelled -> processing (状态回退)\\n      expect(orderStatusService.isValidTransition(OrderStatus.CANCELLED, OrderStatus.PROCESSING)).toBe(false);\\n    });\\n\\n    it('应该正确获取下一个可能的状态', () => {\\n      expect(orderStatusService.getNextPossibleStatus(OrderStatus.PENDING)).toEqual([OrderStatus.PROCESSING, OrderStatus.CANCELLED]);\\n      expect(orderStatusService.getNextPossibleStatus(OrderStatus.PROCESSING)).toEqual([OrderStatus.CLEANING, OrderStatus.CANCELLED]);\\n      expect(orderStatusService.getNextPossibleStatus(OrderStatus.CLEANING)).toEqual([OrderStatus.IRONING]);\\n      expect(orderStatusService.getNextPossibleStatus(OrderStatus.IRONING)).toEqual([OrderStatus.PACKAGING]);\\n      expect(orderStatusService.getNextPossibleStatus(OrderStatus.PACKAGING)).toEqual([OrderStatus.COMPLETED]);\\n      expect(orderStatusService.getNextPossibleStatus(OrderStatus.COMPLETED)).toEqual([OrderStatus.DELIVERED]);\\n      expect(orderStatusService.getNextPossibleStatus(OrderStatus.DELIVERED)).toEqual([]);\\n      expect(orderStatusService.getNextPossibleStatus(OrderStatus.CANCELLED)).toEqual([]);\\n    });\\n\\n    it('应该正确进行状态转换', () => {\\n      // 有效的状态转换应该返回true\\n      expect(() => orderStatusService.transitionStatus(OrderStatus.PENDING, OrderStatus.PROCESSING)).not.toThrow();\\n      expect(orderStatusService.transitionStatus(OrderStatus.PENDING, OrderStatus.PROCESSING)).toBe(true);\\n    });\\n\\n    it('应该对无效的状态转换抛出错误', () => {\\n      // 无效的状态转换应该抛出错误\\n      expect(() => orderStatusService.transitionStatus(OrderStatus.PENDING, OrderStatus.COMPLETED)).toThrow();\\n      expect(() => orderStatusService.transitionStatus(OrderStatus.PENDING, OrderStatus.COMPLETED)).toThrow('无效的状态转换: pending -> completed');\\n    });\\n  });\\n\\n  describe('状态显示名称', () => {\\n    it('应该返回正确的订单状态显示名称', () => {\\n      expect(orderStatusService.getStatusDisplayName(OrderStatus.PENDING)).toBe('待处理');\\n      expect(orderStatusService.getStatusDisplayName(OrderStatus.PROCESSING)).toBe('处理中');\\n      expect(orderStatusService.getStatusDisplayName(OrderStatus.CLEANING)).toBe('清洗中');\\n      expect(orderStatusService.getStatusDisplayName(OrderStatus.IRONING)).toBe('熨烫中');\\n      expect(orderStatusService.getStatusDisplayName(OrderStatus.PACKAGING)).toBe('包装中');\\n      expect(orderStatusService.getStatusDisplayName(OrderStatus.COMPLETED)).toBe('已完成');\\n      expect(orderStatusService.getStatusDisplayName(OrderStatus.DELIVERED)).toBe('已交付');\\n      expect(orderStatusService.getStatusDisplayName(OrderStatus.CANCELLED)).toBe('已取消');\\n    });\\n\\n    it('应该返回正确的物品状态显示名称', () => {\\n      expect(orderStatusService.getItemStatusDisplayName(LaundryItemStatus.RECEIVED)).toBe('已接收');\\n      expect(orderStatusService.getItemStatusDisplayName(LaundryItemStatus.PROCESSED)).toBe('处理中');\\n      expect(orderStatusService.getItemStatusDisplayName(LaundryItemStatus.CLEAN)).toBe('已清洗');\\n      expect(orderStatusService.getItemStatusDisplayName(LaundryItemStatus.IRONED)).toBe('已熨烫');\\n      expect(orderStatusService.getItemStatusDisplayName(LaundryItemStatus.PACKED)).toBe('已包装');\\n    });\\n\\n    it('应该返回正确的质量检查状态显示名称', () => {\\n      expect(orderStatusService.getQualityCheckStatusDisplayName(QualityCheckStatus.PENDING)).toBe('待检查');\\n      expect(orderStatusService.getQualityCheckStatusDisplayName(QualityCheckStatus.PASSED)).toBe('检查通过');\\n      expect(orderStatusService.getQualityCheckStatusDisplayName(QualityCheckStatus.FAILED)).toBe('检查失败');\\n    });\\n  });\\n\\n  describe('单例模式', () => {\\n    it('应该返回相同的实例', () => {\\n      const instance1 = OrderStatusService.getInstance();\\n      const instance2 = OrderStatusService.getInstance();\\n      const instance3 = orderStatusService;\\n\\n      expect(instance1).toBe(instance2);\\n      expect(instance2).toBe(instance3);\\n    });\\n  });\\n});\\n\",\"originTextLength\":7649,\"aiScene\":\"Completion\",\"behaviorType\":\"accept\",\"updateTime\":1766162510000}]",
  "range-cache-file:///Users/my/Downloads/%E6%99%BA%E6%9E%A2%E6%9C%8D%E5%8A%A1%E5%B9%B3%E5%8F%B0/lib/orders/order.status.service.ts": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":190,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":190,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"/**\\\\n * @file 订单状态服务\\\\n * @description 统一管理订单状态的定义、转换和验证\\\\n * @module lib/orders/order.status.service\\\\n * @author YYC\\\\n * @version 1.0.0\\\\n * @created 2024-01-01\\\\n * @updated 2024-01-01\\\\n */\\\\n\\\\n/**\\\\n * 洗衣订单状态枚举\\\\n */\\\\nexport enum OrderStatus {\\\\n  // 订单初始状态\\\\n  PENDING = \\\\'pending\\\\',\\\\n  // 订单处理中\\\\n  PROCESSING = \\\\'processing\\\\',\\\\n  // 清洗中\\\\n  CLEANING = \\\\'cleaning\\\\',\\\\n  // 熨烫中\\\\n  IRONING = \\\\'ironing\\\\',\\\\n  // 包装中\\\\n  PACKAGING = \\\\'packaging\\\\',\\\\n  // 订单完成\\\\n  COMPLETED = \\\\'completed\\\\',\\\\n  // 订单已交付\\\\n  DELIVERED = \\\\'delivered\\\\',\\\\n  // 订单取消\\\\n  CANCELLED = \\\\'cancelled\\\\'\\\\n}\\\\n\\\\n/**\\\\n * 洗衣物品状态枚举\\\\n */\\\\nexport enum LaundryItemStatus {\\\\n  // 已接收\\\\n  RECEIVED = \\\\'received\\\\',\\\\n  // 处理中\\\\n  PROCESSED = \\\\'processed\\\\',\\\\n  // 已清洗\\\\n  CLEAN = \\\\'clean\\\\',\\\\n  // 已熨烫\\\\n  IRONED = \\\\'ironed\\\\',\\\\n  // 已包装\\\\n  PACKED = \\\\'packed\\\\'\\\\n}\\\\n\\\\n/**\\\\n * 质量检查状态枚举\\\\n */\\\\nexport enum QualityCheckStatus {\\\\n  // 待检查\\\\n  PENDING = \\\\'pending\\\\',\\\\n  // 检查通过\\\\n  PASSED = \\\\'passed\\\\',\\\\n  // 检查失败\\\\n  FAILED = \\\\'failed\\\\'\\\\n}\\\\n\\\\n/**\\\\n * 订单状态转换规则\\\\n * 键：当前状态\\\\n * 值：可转换的目标状态数组\\\\n */\\\\nexport const STATUS_TRANSITIONS: Record<OrderStatus, OrderStatus[]> = {\\\\n  [OrderStatus.PENDING]: [OrderStatus.PROCESSING, OrderStatus.CANCELLED],\\\\n  [OrderStatus.PROCESSING]: [OrderStatus.CLEANING, OrderStatus.CANCELLED],\\\\n  [OrderStatus.CLEANING]: [OrderStatus.IRONING],\\\\n  [OrderStatus.IRONING]: [OrderStatus.PACKAGING],\\\\n  [OrderStatus.PACKAGING]: [OrderStatus.COMPLETED],\\\\n  [OrderStatus.COMPLETED]: [OrderStatus.DELIVERED],\\\\n  [OrderStatus.DELIVERED]: [],\\\\n  [OrderStatus.CANCELLED]: []\\\\n};\\\\n\\\\n/**\\\\n * 订单状态服务类\\\\n */\\\\nexport class OrderStatusService {\\\\n  private static instance: OrderStatusService;\\\\n\\\\n  /**\\\\n   * 获取单例实例\\\\n   */\\\\n  public static getInstance(): OrderStatusService {\\\\n    if (!OrderStatusService.instance) {\\\\n      OrderStatusService.instance = new OrderStatusService();\\\\n    }\\\\n    return OrderStatusService.instance;\\\\n  }\\\\n\\\\n  /**\\\\n   * 验证状态转换是否有效\\\\n   * @param currentStatus 当前状态\\\\n   * @param targetStatus 目标状态\\\\n   * @returns 是否有效\\\\n   */\\\\n  public isValidTransition(currentStatus: OrderStatus, targetStatus: OrderStatus): boolean {\\\\n    const allowedTransitions = STATUS_TRANSITIONS[currentStatus];\\\\n    return allowedTransitions?.includes(targetStatus) || false;\\\\n  }\\\\n\\\\n  /**\\\\n   * 验证状态是否为有效订单状态\\\\n   * @param status 状态值\\\\n   * @returns 是否有效\\\\n   */\\\\n  public isValidOrderStatus(status: string): status is OrderStatus {\\\\n    return Object.values(OrderStatus).includes(status as OrderStatus);\\\\n  }\\\\n\\\\n  /**\\\\n   * 验证状态是否为有效物品状态\\\\n   * @param status 状态值\\\\n   * @returns 是否有效\\\\n   */\\\\n  public isValidItemStatus(status: string): status is LaundryItemStatus {\\\\n    return Object.values(LaundryItemStatus).includes(status as LaundryItemStatus);\\\\n  }\\\\n\\\\n  /**\\\\n   * 验证状态是否为有效质量检查状态\\\\n   * @param status 状态值\\\\n   * @returns 是否有效\\\\n   */\\\\n  public isValidQualityCheckStatus(status: string): status is QualityCheckStatus {\\\\n    return Object.values(QualityCheckStatus).includes(status as QualityCheckStatus);\\\\n  }\\\\n\\\\n  /**\\\\n   * 获取当前状态的下一个可能状态\\\\n   * @param currentStatus 当前状态\\\\n   * @returns 可能的下一个状态数组\\\\n   */\\\\n  public getNextPossibleStatus(currentStatus: OrderStatus): OrderStatus[] {\\\\n    return STATUS_TRANSITIONS[currentStatus] || [];\\\\n  }\\\\n\\\\n  /**\\\\n   * 获取状态的显示名称\\\\n   * @param status 状态值\\\\n   * @returns 显示名称\\\\n   */\\\\n  public getStatusDisplayName(status: OrderStatus): string {\\\\n    const statusNames: Record<OrderStatus, string> = {\\\\n      [OrderStatus.PENDING]: \\\\'待处理\\\\',\\\\n      [OrderStatus.PROCESSING]: \\\\'处理中\\\\',\\\\n      [OrderStatus.CLEANING]: \\\\'清洗中\\\\',\\\\n      [OrderStatus.IRONING]: \\\\'熨烫中\\\\',\\\\n      [OrderStatus.PACKAGING]: \\\\'包装中\\\\',\\\\n      [OrderStatus.COMPLETED]: \\\\'已完成\\\\',\\\\n      [OrderStatus.DELIVERED]: \\\\'已交付\\\\',\\\\n      [OrderStatus.CANCELLED]: \\\\'已取消\\\\'\\\\n    };\\\\n    return statusNames[status] || status;\\\\n  }\\\\n\\\\n  /**\\\\n   * 获取物品状态的显示名称\\\\n   * @param status 物品状态值\\\\n   * @returns 显示名称\\\\n   */\\\\n  public getItemStatusDisplayName(status: LaundryItemStatus): string {\\\\n    const statusNames: Record<LaundryItemStatus, string> = {\\\\n      [LaundryItemStatus.RECEIVED]: \\\\'已接收\\\\',\\\\n      [LaundryItemStatus.PROCESSED]: \\\\'处理中\\\\',\\\\n      [LaundryItemStatus.CLEAN]: \\\\'已清洗\\\\',\\\\n      [LaundryItemStatus.IRONED]: \\\\'已熨烫\\\\',\\\\n      [LaundryItemStatus.PACKED]: \\\\'已包装\\\\'\\\\n    };\\\\n    return statusNames[status] || status;\\\\n  }\\\\n\\\\n  /**\\\\n   * 获取质量检查状态的显示名称\\\\n   * @param status 质量检查状态值\\\\n   * @returns 显示名称\\\\n   */\\\\n  public getQualityCheckStatusDisplayName(status: QualityCheckStatus): string {\\\\n    const statusNames: Record<QualityCheckStatus, string> = {\\\\n      [QualityCheckStatus.PENDING]: \\\\'待检查\\\\',\\\\n      [QualityCheckStatus.PASSED]: \\\\'检查通过\\\\',\\\\n      [QualityCheckStatus.FAILED]: \\\\'检查失败\\\\'\\\\n    };\\\\n    return statusNames[status] || status;\\\\n  }\\\\n\\\\n  /**\\\\n   * 转换订单状态\\\\n   * @param currentStatus 当前状态\\\\n   * @param targetStatus 目标状态\\\\n   * @returns 转换是否成功\\\\n   */\\\\n  public transitionStatus(currentStatus: OrderStatus, targetStatus: OrderStatus): boolean {\\\\n    if (!this.isValidTransition(currentStatus, targetStatus)) {\\\\n      throw new Error(`无效的状态转换: ${currentStatus} -> ${targetStatus}`);\\\\n    }\\\\n    return true;\\\\n  }\\\\n}\\\\n\\\\n/**\\\\n * 订单状态服务实例\\\\n */\\\\nexport const orderStatusService = OrderStatusService.getInstance();\\\\n\",\"originAcceptText\":\"/**\\n * @file 订单状态服务\\n * @description 统一管理订单状态的定义、转换和验证\\n * @module lib/orders/order.status.service\\n * @author YYC\\n * @version 1.0.0\\n * @created 2024-01-01\\n * @updated 2024-01-01\\n */\\n\\n/**\\n * 洗衣订单状态枚举\\n */\\nexport enum OrderStatus {\\n  // 订单初始状态\\n  PENDING = 'pending',\\n  // 订单处理中\\n  PROCESSING = 'processing',\\n  // 清洗中\\n  CLEANING = 'cleaning',\\n  // 熨烫中\\n  IRONING = 'ironing',\\n  // 包装中\\n  PACKAGING = 'packaging',\\n  // 订单完成\\n  COMPLETED = 'completed',\\n  // 订单已交付\\n  DELIVERED = 'delivered',\\n  // 订单取消\\n  CANCELLED = 'cancelled'\\n}\\n\\n/**\\n * 洗衣物品状态枚举\\n */\\nexport enum LaundryItemStatus {\\n  // 已接收\\n  RECEIVED = 'received',\\n  // 处理中\\n  PROCESSED = 'processed',\\n  // 已清洗\\n  CLEAN = 'clean',\\n  // 已熨烫\\n  IRONED = 'ironed',\\n  // 已包装\\n  PACKED = 'packed'\\n}\\n\\n/**\\n * 质量检查状态枚举\\n */\\nexport enum QualityCheckStatus {\\n  // 待检查\\n  PENDING = 'pending',\\n  // 检查通过\\n  PASSED = 'passed',\\n  // 检查失败\\n  FAILED = 'failed'\\n}\\n\\n/**\\n * 订单状态转换规则\\n * 键：当前状态\\n * 值：可转换的目标状态数组\\n */\\nexport const STATUS_TRANSITIONS: Record<OrderStatus, OrderStatus[]> = {\\n  [OrderStatus.PENDING]: [OrderStatus.PROCESSING, OrderStatus.CANCELLED],\\n  [OrderStatus.PROCESSING]: [OrderStatus.CLEANING, OrderStatus.CANCELLED],\\n  [OrderStatus.CLEANING]: [OrderStatus.IRONING],\\n  [OrderStatus.IRONING]: [OrderStatus.PACKAGING],\\n  [OrderStatus.PACKAGING]: [OrderStatus.COMPLETED],\\n  [OrderStatus.COMPLETED]: [OrderStatus.DELIVERED],\\n  [OrderStatus.DELIVERED]: [],\\n  [OrderStatus.CANCELLED]: []\\n};\\n\\n/**\\n * 订单状态服务类\\n */\\nexport class OrderStatusService {\\n  private static instance: OrderStatusService;\\n\\n  /**\\n   * 获取单例实例\\n   */\\n  public static getInstance(): OrderStatusService {\\n    if (!OrderStatusService.instance) {\\n      OrderStatusService.instance = new OrderStatusService();\\n    }\\n    return OrderStatusService.instance;\\n  }\\n\\n  /**\\n   * 验证状态转换是否有效\\n   * @param currentStatus 当前状态\\n   * @param targetStatus 目标状态\\n   * @returns 是否有效\\n   */\\n  public isValidTransition(currentStatus: OrderStatus, targetStatus: OrderStatus): boolean {\\n    const allowedTransitions = STATUS_TRANSITIONS[currentStatus];\\n    return allowedTransitions?.includes(targetStatus) || false;\\n  }\\n\\n  /**\\n   * 验证状态是否为有效订单状态\\n   * @param status 状态值\\n   * @returns 是否有效\\n   */\\n  public isValidOrderStatus(status: string): status is OrderStatus {\\n    return Object.values(OrderStatus).includes(status as OrderStatus);\\n  }\\n\\n  /**\\n   * 验证状态是否为有效物品状态\\n   * @param status 状态值\\n   * @returns 是否有效\\n   */\\n  public isValidItemStatus(status: string): status is LaundryItemStatus {\\n    return Object.values(LaundryItemStatus).includes(status as LaundryItemStatus);\\n  }\\n\\n  /**\\n   * 验证状态是否为有效质量检查状态\\n   * @param status 状态值\\n   * @returns 是否有效\\n   */\\n  public isValidQualityCheckStatus(status: string): status is QualityCheckStatus {\\n    return Object.values(QualityCheckStatus).includes(status as QualityCheckStatus);\\n  }\\n\\n  /**\\n   * 获取当前状态的下一个可能状态\\n   * @param currentStatus 当前状态\\n   * @returns 可能的下一个状态数组\\n   */\\n  public getNextPossibleStatus(currentStatus: OrderStatus): OrderStatus[] {\\n    return STATUS_TRANSITIONS[currentStatus] || [];\\n  }\\n\\n  /**\\n   * 获取状态的显示名称\\n   * @param status 状态值\\n   * @returns 显示名称\\n   */\\n  public getStatusDisplayName(status: OrderStatus): string {\\n    const statusNames: Record<OrderStatus, string> = {\\n      [OrderStatus.PENDING]: '待处理',\\n      [OrderStatus.PROCESSING]: '处理中',\\n      [OrderStatus.CLEANING]: '清洗中',\\n      [OrderStatus.IRONING]: '熨烫中',\\n      [OrderStatus.PACKAGING]: '包装中',\\n      [OrderStatus.COMPLETED]: '已完成',\\n      [OrderStatus.DELIVERED]: '已交付',\\n      [OrderStatus.CANCELLED]: '已取消'\\n    };\\n    return statusNames[status] || status;\\n  }\\n\\n  /**\\n   * 获取物品状态的显示名称\\n   * @param status 物品状态值\\n   * @returns 显示名称\\n   */\\n  public getItemStatusDisplayName(status: LaundryItemStatus): string {\\n    const statusNames: Record<LaundryItemStatus, string> = {\\n      [LaundryItemStatus.RECEIVED]: '已接收',\\n      [LaundryItemStatus.PROCESSED]: '处理中',\\n      [LaundryItemStatus.CLEAN]: '已清洗',\\n      [LaundryItemStatus.IRONED]: '已熨烫',\\n      [LaundryItemStatus.PACKED]: '已包装'\\n    };\\n    return statusNames[status] || status;\\n  }\\n\\n  /**\\n   * 获取质量检查状态的显示名称\\n   * @param status 质量检查状态值\\n   * @returns 显示名称\\n   */\\n  public getQualityCheckStatusDisplayName(status: QualityCheckStatus): string {\\n    const statusNames: Record<QualityCheckStatus, string> = {\\n      [QualityCheckStatus.PENDING]: '待检查',\\n      [QualityCheckStatus.PASSED]: '检查通过',\\n      [QualityCheckStatus.FAILED]: '检查失败'\\n    };\\n    return statusNames[status] || status;\\n  }\\n\\n  /**\\n   * 转换订单状态\\n   * @param currentStatus 当前状态\\n   * @param targetStatus 目标状态\\n   * @returns 转换是否成功\\n   */\\n  public transitionStatus(currentStatus: OrderStatus, targetStatus: OrderStatus): boolean {\\n    if (!this.isValidTransition(currentStatus, targetStatus)) {\\n      throw new Error(`无效的状态转换: ${currentStatus} -> ${targetStatus}`);\\n    }\\n    return true;\\n  }\\n}\\n\\n/**\\n * 订单状态服务实例\\n */\\nexport const orderStatusService = OrderStatusService.getInstance();\\n\",\"originTextLength\":4859,\"aiScene\":\"Completion\",\"behaviorType\":\"accept\",\"updateTime\":1766162510003}]",
