  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/views/__tests__/SystemManagement.test.ts": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":346,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":346,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"/**\\\\n * @fileoverview YYC³餐饮管理系统 - SystemManagement组件单元测试\\\\n * @description 测试SystemManagement组件的功能\\\\n * @module SystemManagement.test\\\\n * @author YYC³\\\\n * @version 1.0.0\\\\n * @created 2025-01-20\\\\n */\\\\n\\\\nimport { describe, it, expect, beforeEach, vi } from \\\\'vitest\\\\'\\\\nimport { mount, VueWrapper } from \\\\'@vue/test-utils\\\\'\\\\nimport { createPinia, setActivePinia } from \\\\'pinia\\\\'\\\\nimport { ref, computed } from \\\\'vue\\\\'\\\\nimport ElementPlus, { ElMessage, ElMessageBox } from \\\\'element-plus\\\\'\\\\nimport SystemManagement from \\\\'@/views/SystemManagement.vue\\\\'\\\\n\\\\nvi.mock(\\\\'element-plus\\\\', () => ({\\\\n  default: {\\\\n    ElMessage: {\\\\n      success: vi.fn(),\\\\n      error: vi.fn(),\\\\n      warning: vi.fn(),\\\\n      info: vi.fn()\\\\n    },\\\\n    ElMessageBox: {\\\\n      confirm: vi.fn()\\\\n    }\\\\n  },\\\\n  ElMessage: {\\\\n    success: vi.fn(),\\\\n    error: vi.fn(),\\\\n    warning: vi.fn(),\\\\n    info: vi.fn()\\\\n  },\\\\n  ElMessageBox: {\\\\n    confirm: vi.fn()\\\\n  }\\\\n}))\\\\n\\\\ndescribe(\\\\'SystemManagement组件\\\\', () => {\\\\n  let wrapper: VueWrapper<any>\\\\n  let pinia: any\\\\n\\\\n  beforeEach(() => {\\\\n    pinia = createPinia()\\\\n    setActivePinia(pinia)\\\\n    vi.clearAllMocks()\\\\n  })\\\\n\\\\n  const createWrapper = () => {\\\\n    return mount(SystemManagement, {\\\\n      global: {\\\\n        plugins: [ElementPlus, pinia],\\\\n        stubs: {\\\\n          \\\\'el-dialog\\\\': {\\\\n            template: \\\\'<div class=\\\\\\\"el-dialog-mock\\\\\\\" v-if=\\\\\\\"modelValue\\\\\\\"><slot></slot><slot name=\\\\\\\"footer\\\\\\\"></slot></div>\\\\',\\\\n            props: [\\\\'modelValue\\\\', \\\\'title\\\\'],\\\\n            emits: [\\\\'update:modelValue\\\\']\\\\n          },\\\\n          \\\\'el-table\\\\': {\\\\n            template: \\\\'<div class=\\\\\\\"el-table-mock\\\\\\\"><slot></slot></div>\\\\',\\\\n            props: [\\\\'data\\\\', \\\\'loading\\\\', \\\\'border\\\\']\\\\n          },\\\\n          \\\\'el-table-column\\\\': {\\\\n            template: \\\\'<div class=\\\\\\\"el-table-column-mock\\\\\\\"><slot></slot></div>\\\\',\\\\n            props: [\\\\'prop\\\\', \\\\'label\\\\', \\\\'width\\\\']\\\\n          },\\\\n          \\\\'el-row\\\\': {\\\\n            template: \\\\'<div class=\\\\\\\"el-row-mock\\\\\\\"><slot></slot></div>\\\\',\\\\n            props: [\\\\'gutter\\\\']\\\\n          },\\\\n          \\\\'el-col\\\\': {\\\\n            template: \\\\'<div class=\\\\\\\"el-col-mock\\\\\\\"><slot></slot></div>\\\\',\\\\n            props: [\\\\'xs\\\\', \\\\'sm\\\\', \\\\'md\\\\', \\\\'lg\\\\', \\\\'span\\\\']\\\\n          },\\\\n          \\\\'el-card\\\\': {\\\\n            template: \\\\'<div class=\\\\\\\"el-card-mock\\\\\\\"><slot name=\\\\\\\"header\\\\\\\" v-if=\\\\\\\"$slots.header\\\\\\\"></slot><slot></slot></div>\\\\',\\\\n            props: [\\\\'class\\\\']\\\\n          },\\\\n          \\\\'el-form\\\\': {\\\\n            template: \\\\'<div class=\\\\\\\"el-form-mock\\\\\\\"><slot></slot></div>\\\\',\\\\n            props: [\\\\'model\\\\', \\\\'labelWidth\\\\']\\\\n          },\\\\n          \\\\'el-form-item\\\\': {\\\\n            template: \\\\'<div class=\\\\\\\"el-form-item-mock\\\\\\\"><slot></slot></div>\\\\',\\\\n            props: [\\\\'label\\\\', \\\\'prop\\\\']\\\\n          },\\\\n          \\\\'el-input\\\\': {\\\\n            template: \\\\'<input class=\\\\\\\"el-input-mock\\\\\\\" />\\\\',\\\\n            props: [\\\\'model\\\\', \\\\'placeholder\\\\', \\\\'clearable\\\\', \\\\'style\\\\', \\\\'type\\\\']\\\\n          },\\\\n          \\\\'el-select\\\\': {\\\\n            template: \\\\'<select class=\\\\\\\"el-select-mock\\\\\\\"><slot></slot></select>\\\\',\\\\n            props: [\\\\'model\\\\', \\\\'placeholder\\\\', \\\\'clearable\\\\', \\\\'style\\\\']\\\\n          },\\\\n          \\\\'el-option\\\\': {\\\\n            template: \\\\'<option class=\\\\\\\"el-option-mock\\\\\\\"><slot></slot></option>\\\\',\\\\n            props: [\\\\'label\\\\', \\\\'value\\\\']\\\\n          },\\\\n          \\\\'el-switch\\\\': {\\\\n            template: \\\\'<input type=\\\\\\\"checkbox\\\\\\\" class=\\\\\\\"el-switch-mock\\\\\\\" />\\\\',\\\\n            props: [\\\\'model\\\\', \\\\'activeText\\\\', \\\\'inactiveText\\\\']\\\\n          },\\\\n          \\\\'el-date-picker\\\\': {\\\\n            template: \\\\'<input type=\\\\\\\"date\\\\\\\" class=\\\\\\\"el-date-picker-mock\\\\\\\" />\\\\',\\\\n            props: [\\\\'model\\\\', \\\\'type\\\\', \\\\'placeholder\\\\']\\\\n          },\\\\n          \\\\'el-tree\\\\': {\\\\n            template: \\\\'<div class=\\\\\\\"el-tree-mock\\\\\\\"><slot></slot></div>\\\\',\\\\n            props: [\\\\'data\\\\', \\\\'showCheckbox\\\\', \\\\'nodeKey\\\\', \\\\'props\\\\']\\\\n          }\\\\n        }\\\\n      }\\\\n    })\\\\n  }\\\\n\\\\n  describe(\\\\'初始化渲染\\\\', () => {\\\\n    it(\\\\'应该正确渲染页面标题\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.vm.managementTitle).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该渲染标签页切换\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.vm.activeTab).toBeDefined()\\\\n      expect([\\\\'users\\\\', \\\\'roles\\\\', \\\\'departments\\\\', \\\\'settings\\\\', \\\\'audit-logs\\\\']).toContain(wrapper.vm.activeTab)\\\\n    })\\\\n\\\\n    it(\\\\'应该显示统计信息\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.vm.statistics).toBeDefined()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'标签页切换\\\\', () => {\\\\n    it(\\\\'应该支持用户管理标签\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      wrapper.vm.activeTab = \\\\'users\\\\'\\\\n      expect(wrapper.vm.activeTab).toBe(\\\\'users\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该支持角色管理标签\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      wrapper.vm.activeTab = \\\\'roles\\\\'\\\\n      expect(wrapper.vm.activeTab).toBe(\\\\'roles\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该支持部门管理标签\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      wrapper.vm.activeTab = \\\\'departments\\\\'\\\\n      expect(wrapper.vm.activeTab).toBe(\\\\'departments\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该支持系统设置标签\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      wrapper.vm.activeTab = \\\\'settings\\\\'\\\\n      expect(wrapper.vm.activeTab).toBe(\\\\'settings\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该支持审计日志标签\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      wrapper.vm.activeTab = \\\\'audit-logs\\\\'\\\\n      expect(wrapper.vm.activeTab).toBe(\\\\'audit-logs\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'用户管理\\\\', () => {\\\\n    it(\\\\'应该正确加载用户数据\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.vm.users).toBeDefined()\\\\n      expect(Array.isArray(wrapper.vm.users)).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该能够新增用户\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(typeof wrapper.vm.handleAddUser).toBe(\\\\'function\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该能够编辑用户\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(typeof wrapper.vm.handleEditUser).toBe(\\\\'function\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该能够删除用户\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(typeof wrapper.vm.handleDeleteUser).toBe(\\\\'function\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该能够重置用户密码\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(typeof wrapper.vm.handleResetPassword).toBe(\\\\'function\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该能够锁定用户\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(typeof wrapper.vm.handleLockUser).toBe(\\\\'function\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该能够解锁用户\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(typeof wrapper.vm.handleUnlockUser).toBe(\\\\'function\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该能够搜索用户\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(typeof wrapper.vm.handleSearch).toBe(\\\\'function\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该能够重置筛选\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(typeof wrapper.vm.handleReset).toBe(\\\\'function\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'角色管理\\\\', () => {\\\\n    it(\\\\'应该正确加载角色数据\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.vm.roles).toBeDefined()\\\\n      expect(Array.isArray(wrapper.vm.roles)).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该能够新增角色\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(typeof wrapper.vm.handleAddRole).toBe(\\\\'function\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该能够编辑角色\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(typeof wrapper.vm.handleEditRole).toBe(\\\\'function\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该能够删除角色\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(typeof wrapper.vm.handleDeleteRole).toBe(\\\\'function\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该能够配置权限\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(typeof wrapper.vm.handleConfigurePermissions).toBe(\\\\'function\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'部门管理\\\\', () => {\\\\n    it(\\\\'应该正确加载部门数据\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.vm.departments).toBeDefined()\\\\n      expect(Array.isArray(wrapper.vm.departments)).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该能够新增部门\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(typeof wrapper.vm.handleAddDepartment).toBe(\\\\'function\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该能够编辑部门\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(typeof wrapper.vm.handleEditDepartment).toBe(\\\\'function\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该能够删除部门\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(typeof wrapper.vm.handleDeleteDepartment).toBe(\\\\'function\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'系统设置\\\\', () => {\\\\n    it(\\\\'应该正确加载系统设置\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.vm.systemSettings).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该能够保存设置\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(typeof wrapper.vm.handleSaveSettings).toBe(\\\\'function\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'审计日志\\\\', () => {\\\\n    it(\\\\'应该正确加载审计日志\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.vm.auditLogs).toBeDefined()\\\\n      expect(Array.isArray(wrapper.vm.auditLogs)).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该能够导出日志\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(typeof wrapper.vm.handleExportLogs).toBe(\\\\'function\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该能够查看日志详情\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(typeof wrapper.vm.handleViewLogDetail).toBe(\\\\'function\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'筛选功能\\\\', () => {\\\\n    it(\\\\'应该正确初始化筛选条件\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.vm.filters).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该支持关键词搜索\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.vm.filters.keyword).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该支持状态筛选\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.vm.filters.status).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该支持角色筛选\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.vm.filters.roleId).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该支持部门筛选\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.vm.filters.departmentId).toBeDefined()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'分页功能\\\\', () => {\\\\n    it(\\\\'应该正确初始化分页\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.vm.pagination).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该能够切换页码\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(typeof wrapper.vm.handlePageChange).toBe(\\\\'function\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该能够改变页大小\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(typeof wrapper.vm.handleSizeChange).toBe(\\\\'function\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'对话框管理\\\\', () => {\\\\n    it(\\\\'应该能够打开用户对话框\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.vm.showUserDialog).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该能够打开角色对话框\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.vm.showRoleDialog).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该能够打开部门对话框\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.vm.showDepartmentDialog).toBeDefined()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'表单处理\\\\', () => {\\\\n    it(\\\\'应该正确初始化用户表单\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.vm.userForm).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确初始化角色表单\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.vm.roleForm).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确初始化部门表单\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.vm.departmentForm).toBeDefined()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'辅助功能\\\\', () => {\\\\n    it(\\\\'应该能够获取部门名称\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(typeof wrapper.vm.getDepartmentName).toBe(\\\\'function\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该能够获取角色名称\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(typeof wrapper.vm.getRoleName).toBe(\\\\'function\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该能够获取状态类型\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(typeof wrapper.vm.getStatusType).toBe(\\\\'function\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'生命周期\\\\', () => {\\\\n    it(\\\\'应该在挂载时初始化数据\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.vm.users).toBeDefined()\\\\n      expect(wrapper.vm.roles).toBeDefined()\\\\n      expect(wrapper.vm.departments).toBeDefined()\\\\n      expect(wrapper.vm.statistics).toBeDefined()\\\\n    })\\\\n  })\\\\n})\\\\n\",\"originAcceptText\":\"/**\\n * @fileoverview YYC³餐饮管理系统 - SystemManagement组件单元测试\\n * @description 测试SystemManagement组件的功能\\n * @module SystemManagement.test\\n * @author YYC³\\n * @version 1.0.0\\n * @created 2025-01-20\\n */\\n\\nimport { describe, it, expect, beforeEach, vi } from 'vitest'\\nimport { mount, VueWrapper } from '@vue/test-utils'\\nimport { createPinia, setActivePinia } from 'pinia'\\nimport { ref, computed } from 'vue'\\nimport ElementPlus, { ElMessage, ElMessageBox } from 'element-plus'\\nimport SystemManagement from '@/views/SystemManagement.vue'\\n\\nvi.mock('element-plus', () => ({\\n  default: {\\n    ElMessage: {\\n      success: vi.fn(),\\n      error: vi.fn(),\\n      warning: vi.fn(),\\n      info: vi.fn()\\n    },\\n    ElMessageBox: {\\n      confirm: vi.fn()\\n    }\\n  },\\n  ElMessage: {\\n    success: vi.fn(),\\n    error: vi.fn(),\\n    warning: vi.fn(),\\n    info: vi.fn()\\n  },\\n  ElMessageBox: {\\n    confirm: vi.fn()\\n  }\\n}))\\n\\ndescribe('SystemManagement组件', () => {\\n  let wrapper: VueWrapper<any>\\n  let pinia: any\\n\\n  beforeEach(() => {\\n    pinia = createPinia()\\n    setActivePinia(pinia)\\n    vi.clearAllMocks()\\n  })\\n\\n  const createWrapper = () => {\\n    return mount(SystemManagement, {\\n      global: {\\n        plugins: [ElementPlus, pinia],\\n        stubs: {\\n          'el-dialog': {\\n            template: '<div class=\\\"el-dialog-mock\\\" v-if=\\\"modelValue\\\"><slot></slot><slot name=\\\"footer\\\"></slot></div>',\\n            props: ['modelValue', 'title'],\\n            emits: ['update:modelValue']\\n          },\\n          'el-table': {\\n            template: '<div class=\\\"el-table-mock\\\"><slot></slot></div>',\\n            props: ['data', 'loading', 'border']\\n          },\\n          'el-table-column': {\\n            template: '<div class=\\\"el-table-column-mock\\\"><slot></slot></div>',\\n            props: ['prop', 'label', 'width']\\n          },\\n          'el-row': {\\n            template: '<div class=\\\"el-row-mock\\\"><slot></slot></div>',\\n            props: ['gutter']\\n          },\\n          'el-col': {\\n            template: '<div class=\\\"el-col-mock\\\"><slot></slot></div>',\\n            props: ['xs', 'sm', 'md', 'lg', 'span']\\n          },\\n          'el-card': {\\n            template: '<div class=\\\"el-card-mock\\\"><slot name=\\\"header\\\" v-if=\\\"$slots.header\\\"></slot><slot></slot></div>',\\n            props: ['class']\\n          },\\n          'el-form': {\\n            template: '<div class=\\\"el-form-mock\\\"><slot></slot></div>',\\n            props: ['model', 'labelWidth']\\n          },\\n          'el-form-item': {\\n            template: '<div class=\\\"el-form-item-mock\\\"><slot></slot></div>',\\n            props: ['label', 'prop']\\n          },\\n          'el-input': {\\n            template: '<input class=\\\"el-input-mock\\\" />',\\n            props: ['model', 'placeholder', 'clearable', 'style', 'type']\\n          },\\n          'el-select': {\\n            template: '<select class=\\\"el-select-mock\\\"><slot></slot></select>',\\n            props: ['model', 'placeholder', 'clearable', 'style']\\n          },\\n          'el-option': {\\n            template: '<option class=\\\"el-option-mock\\\"><slot></slot></option>',\\n            props: ['label', 'value']\\n          },\\n          'el-switch': {\\n            template: '<input type=\\\"checkbox\\\" class=\\\"el-switch-mock\\\" />',\\n            props: ['model', 'activeText', 'inactiveText']\\n          },\\n          'el-date-picker': {\\n            template: '<input type=\\\"date\\\" class=\\\"el-date-picker-mock\\\" />',\\n            props: ['model', 'type', 'placeholder']\\n          },\\n          'el-tree': {\\n            template: '<div class=\\\"el-tree-mock\\\"><slot></slot></div>',\\n            props: ['data', 'showCheckbox', 'nodeKey', 'props']\\n          }\\n        }\\n      }\\n    })\\n  }\\n\\n  describe('初始化渲染', () => {\\n    it('应该正确渲染页面标题', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.vm.managementTitle).toBeDefined()\\n    })\\n\\n    it('应该渲染标签页切换', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.vm.activeTab).toBeDefined()\\n      expect(['users', 'roles', 'departments', 'settings', 'audit-logs']).toContain(wrapper.vm.activeTab)\\n    })\\n\\n    it('应该显示统计信息', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.vm.statistics).toBeDefined()\\n    })\\n  })\\n\\n  describe('标签页切换', () => {\\n    it('应该支持用户管理标签', () => {\\n      wrapper = createWrapper()\\n      wrapper.vm.activeTab = 'users'\\n      expect(wrapper.vm.activeTab).toBe('users')\\n    })\\n\\n    it('应该支持角色管理标签', () => {\\n      wrapper = createWrapper()\\n      wrapper.vm.activeTab = 'roles'\\n      expect(wrapper.vm.activeTab).toBe('roles')\\n    })\\n\\n    it('应该支持部门管理标签', () => {\\n      wrapper = createWrapper()\\n      wrapper.vm.activeTab = 'departments'\\n      expect(wrapper.vm.activeTab).toBe('departments')\\n    })\\n\\n    it('应该支持系统设置标签', () => {\\n      wrapper = createWrapper()\\n      wrapper.vm.activeTab = 'settings'\\n      expect(wrapper.vm.activeTab).toBe('settings')\\n    })\\n\\n    it('应该支持审计日志标签', () => {\\n      wrapper = createWrapper()\\n      wrapper.vm.activeTab = 'audit-logs'\\n      expect(wrapper.vm.activeTab).toBe('audit-logs')\\n    })\\n  })\\n\\n  describe('用户管理', () => {\\n    it('应该正确加载用户数据', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.vm.users).toBeDefined()\\n      expect(Array.isArray(wrapper.vm.users)).toBe(true)\\n    })\\n\\n    it('应该能够新增用户', () => {\\n      wrapper = createWrapper()\\n      expect(typeof wrapper.vm.handleAddUser).toBe('function')\\n    })\\n\\n    it('应该能够编辑用户', () => {\\n      wrapper = createWrapper()\\n      expect(typeof wrapper.vm.handleEditUser).toBe('function')\\n    })\\n\\n    it('应该能够删除用户', () => {\\n      wrapper = createWrapper()\\n      expect(typeof wrapper.vm.handleDeleteUser).toBe('function')\\n    })\\n\\n    it('应该能够重置用户密码', () => {\\n      wrapper = createWrapper()\\n      expect(typeof wrapper.vm.handleResetPassword).toBe('function')\\n    })\\n\\n    it('应该能够锁定用户', () => {\\n      wrapper = createWrapper()\\n      expect(typeof wrapper.vm.handleLockUser).toBe('function')\\n    })\\n\\n    it('应该能够解锁用户', () => {\\n      wrapper = createWrapper()\\n      expect(typeof wrapper.vm.handleUnlockUser).toBe('function')\\n    })\\n\\n    it('应该能够搜索用户', () => {\\n      wrapper = createWrapper()\\n      expect(typeof wrapper.vm.handleSearch).toBe('function')\\n    })\\n\\n    it('应该能够重置筛选', () => {\\n      wrapper = createWrapper()\\n      expect(typeof wrapper.vm.handleReset).toBe('function')\\n    })\\n  })\\n\\n  describe('角色管理', () => {\\n    it('应该正确加载角色数据', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.vm.roles).toBeDefined()\\n      expect(Array.isArray(wrapper.vm.roles)).toBe(true)\\n    })\\n\\n    it('应该能够新增角色', () => {\\n      wrapper = createWrapper()\\n      expect(typeof wrapper.vm.handleAddRole).toBe('function')\\n    })\\n\\n    it('应该能够编辑角色', () => {\\n      wrapper = createWrapper()\\n      expect(typeof wrapper.vm.handleEditRole).toBe('function')\\n    })\\n\\n    it('应该能够删除角色', () => {\\n      wrapper = createWrapper()\\n      expect(typeof wrapper.vm.handleDeleteRole).toBe('function')\\n    })\\n\\n    it('应该能够配置权限', () => {\\n      wrapper = createWrapper()\\n      expect(typeof wrapper.vm.handleConfigurePermissions).toBe('function')\\n    })\\n  })\\n\\n  describe('部门管理', () => {\\n    it('应该正确加载部门数据', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.vm.departments).toBeDefined()\\n      expect(Array.isArray(wrapper.vm.departments)).toBe(true)\\n    })\\n\\n    it('应该能够新增部门', () => {\\n      wrapper = createWrapper()\\n      expect(typeof wrapper.vm.handleAddDepartment).toBe('function')\\n    })\\n\\n    it('应该能够编辑部门', () => {\\n      wrapper = createWrapper()\\n      expect(typeof wrapper.vm.handleEditDepartment).toBe('function')\\n    })\\n\\n    it('应该能够删除部门', () => {\\n      wrapper = createWrapper()\\n      expect(typeof wrapper.vm.handleDeleteDepartment).toBe('function')\\n    })\\n  })\\n\\n  describe('系统设置', () => {\\n    it('应该正确加载系统设置', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.vm.systemSettings).toBeDefined()\\n    })\\n\\n    it('应该能够保存设置', () => {\\n      wrapper = createWrapper()\\n      expect(typeof wrapper.vm.handleSaveSettings).toBe('function')\\n    })\\n  })\\n\\n  describe('审计日志', () => {\\n    it('应该正确加载审计日志', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.vm.auditLogs).toBeDefined()\\n      expect(Array.isArray(wrapper.vm.auditLogs)).toBe(true)\\n    })\\n\\n    it('应该能够导出日志', () => {\\n      wrapper = createWrapper()\\n      expect(typeof wrapper.vm.handleExportLogs).toBe('function')\\n    })\\n\\n    it('应该能够查看日志详情', () => {\\n      wrapper = createWrapper()\\n      expect(typeof wrapper.vm.handleViewLogDetail).toBe('function')\\n    })\\n  })\\n\\n  describe('筛选功能', () => {\\n    it('应该正确初始化筛选条件', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.vm.filters).toBeDefined()\\n    })\\n\\n    it('应该支持关键词搜索', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.vm.filters.keyword).toBeDefined()\\n    })\\n\\n    it('应该支持状态筛选', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.vm.filters.status).toBeDefined()\\n    })\\n\\n    it('应该支持角色筛选', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.vm.filters.roleId).toBeDefined()\\n    })\\n\\n    it('应该支持部门筛选', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.vm.filters.departmentId).toBeDefined()\\n    })\\n  })\\n\\n  describe('分页功能', () => {\\n    it('应该正确初始化分页', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.vm.pagination).toBeDefined()\\n    })\\n\\n    it('应该能够切换页码', () => {\\n      wrapper = createWrapper()\\n      expect(typeof wrapper.vm.handlePageChange).toBe('function')\\n    })\\n\\n    it('应该能够改变页大小', () => {\\n      wrapper = createWrapper()\\n      expect(typeof wrapper.vm.handleSizeChange).toBe('function')\\n    })\\n  })\\n\\n  describe('对话框管理', () => {\\n    it('应该能够打开用户对话框', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.vm.showUserDialog).toBeDefined()\\n    })\\n\\n    it('应该能够打开角色对话框', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.vm.showRoleDialog).toBeDefined()\\n    })\\n\\n    it('应该能够打开部门对话框', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.vm.showDepartmentDialog).toBeDefined()\\n    })\\n  })\\n\\n  describe('表单处理', () => {\\n    it('应该正确初始化用户表单', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.vm.userForm).toBeDefined()\\n    })\\n\\n    it('应该正确初始化角色表单', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.vm.roleForm).toBeDefined()\\n    })\\n\\n    it('应该正确初始化部门表单', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.vm.departmentForm).toBeDefined()\\n    })\\n  })\\n\\n  describe('辅助功能', () => {\\n    it('应该能够获取部门名称', () => {\\n      wrapper = createWrapper()\\n      expect(typeof wrapper.vm.getDepartmentName).toBe('function')\\n    })\\n\\n    it('应该能够获取角色名称', () => {\\n      wrapper = createWrapper()\\n      expect(typeof wrapper.vm.getRoleName).toBe('function')\\n    })\\n\\n    it('应该能够获取状态类型', () => {\\n      wrapper = createWrapper()\\n      expect(typeof wrapper.vm.getStatusType).toBe('function')\\n    })\\n  })\\n\\n  describe('生命周期', () => {\\n    it('应该在挂载时初始化数据', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.vm.users).toBeDefined()\\n      expect(wrapper.vm.roles).toBeDefined()\\n      expect(wrapper.vm.departments).toBeDefined()\\n      expect(wrapper.vm.statistics).toBeDefined()\\n    })\\n  })\\n})\\n\",\"originTextLength\":10927,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768901083812},{\"originRange\":{\"start\":{\"line\":303,\"character\":0},\"end\":{\"line\":303,\"character\":46}},\"modifyRange\":{\"start\":{\"line\":303,\"character\":0},\"end\":{\"line\":303,\"character\":46}},\"action\":\"None\",\"isLine\":false,\"originText\":\"      expect(wrapper.vm.filters).toBeDefined()\",\"originAcceptText\":\"      expect(wrapper.vm.filters).toBeDefined()\",\"originTextLength\":46,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768901297395},{\"originRange\":{\"start\":{\"line\":308,\"character\":0},\"end\":{\"line\":308,\"character\":46}},\"modifyRange\":{\"start\":{\"line\":308,\"character\":0},\"end\":{\"line\":308,\"character\":46}},\"action\":\"None\",\"isLine\":false,\"originText\":\"      expect(wrapper.vm.filters).toBeDefined()\",\"originAcceptText\":\"      expect(wrapper.vm.filters).toBeDefined()\",\"originTextLength\":46,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768901297467},{\"originRange\":{\"start\":{\"line\":313,\"character\":0},\"end\":{\"line\":313,\"character\":46}},\"modifyRange\":{\"start\":{\"line\":313,\"character\":0},\"end\":{\"line\":313,\"character\":46}},\"action\":\"None\",\"isLine\":false,\"originText\":\"      expect(wrapper.vm.filters).toBeDefined()\",\"originAcceptText\":\"      expect(wrapper.vm.filters).toBeDefined()\",\"originTextLength\":46,\"aiScene\":\"builder\",\"behaviorType\":\"