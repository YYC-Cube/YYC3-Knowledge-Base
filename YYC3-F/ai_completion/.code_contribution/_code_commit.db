e,\\n          'el-slider': true,\\n          'el-divider': true,\\n          'el-radio-group': true,\\n          'el-radio-button': true\\n        }\\n      }\\n    })\",\"originTextLength\":869,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768873640207}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/views/__tests__/DataAnalytics.integration.test.ts": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":358,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":358,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"import { describe, it, expect, beforeEach, afterEach, vi } from \\\\'vitest\\\\'\\\\nimport { mount, VueWrapper } from \\\\'@vue/test-utils\\\\'\\\\nimport { createPinia, setActivePinia } from \\\\'pinia\\\\'\\\\nimport { createRouter, createMemoryHistory } from \\\\'vue-router\\\\'\\\\nimport ElementPlus from \\\\'element-plus\\\\'\\\\nimport * as echarts from \\\\'echarts\\\\'\\\\n\\\\nimport DataAnalytics from \\\\'../../views/DataAnalytics.vue\\\\'\\\\nimport CustomerAnalytics from \\\\'../../components/analytics/CustomerAnalytics.vue\\\\'\\\\nimport MenuAnalytics from \\\\'../../components/analytics/MenuAnalytics.vue\\\\'\\\\nimport OperationalAnalytics from \\\\'../../components/analytics/OperationalAnalytics.vue\\\\'\\\\nimport SalesAnalytics from \\\\'../../components/analytics/SalesAnalytics.vue\\\\'\\\\nimport AlertSystem from \\\\'../../components/analytics/AlertSystem.vue\\\\'\\\\nimport CustomDashboard from \\\\'../../components/analytics/CustomDashboard.vue\\\\'\\\\n\\\\nvi.mock(\\\\'echarts\\\\', () => ({\\\\n  default: {\\\\n    init: vi.fn(() => ({\\\\n      setOption: vi.fn(),\\\\n      resize: vi.fn(),\\\\n      dispose: vi.fn()\\\\n    }))\\\\n  }\\\\n}))\\\\n\\\\nconst router = createRouter({\\\\n  history: createMemoryHistory(),\\\\n  routes: [\\\\n    { path: \\\\'/analytics\\\\', component: DataAnalytics }\\\\n  ]\\\\n})\\\\n\\\\ndescribe(\\\\'DataAnalytics集成测试\\\\', () => {\\\\n  let wrapper: VueWrapper<any>\\\\n  let pinia: any\\\\n\\\\n  beforeEach(() => {\\\\n    pinia = createPinia()\\\\n    setActivePinia(pinia)\\\\n\\\\n    wrapper = mount(DataAnalytics, {\\\\n      global: {\\\\n        plugins: [pinia, router, ElementPlus],\\\\n        stubs: {\\\\n          \\\\'el-card\\\\': true,\\\\n          \\\\'el-row\\\\': true,\\\\n          \\\\'el-col\\\\': true,\\\\n          \\\\'el-tabs\\\\': true,\\\\n          \\\\'el-tab-pane\\\\': true,\\\\n          \\\\'el-button\\\\': true,\\\\n          \\\\'el-select\\\\': true,\\\\n          \\\\'el-option\\\\': true,\\\\n          \\\\'el-date-picker\\\\': true,\\\\n          \\\\'el-dialog\\\\': true,\\\\n          \\\\'el-table\\\\': true,\\\\n          \\\\'el-table-column\\\\': true,\\\\n          \\\\'el-statistic\\\\': true,\\\\n          \\\\'el-progress\\\\': true,\\\\n          \\\\'el-tag\\\\': true,\\\\n          \\\\'el-icon\\\\': true,\\\\n          \\\\'el-tooltip\\\\': true,\\\\n          \\\\'el-popover\\\\': true,\\\\n          \\\\'el-switch\\\\': true,\\\\n          \\\\'el-slider\\\\': true,\\\\n          \\\\'el-input\\\\': true,\\\\n          \\\\'el-form\\\\': true,\\\\n          \\\\'el-form-item\\\\': true,\\\\n          \\\\'el-radio-group\\\\': true,\\\\n          \\\\'el-radio-button\\\\': true,\\\\n          \\\\'el-divider\\\\': true,\\\\n          \\\\'el-alert\\\\': true,\\\\n          \\\\'el-badge\\\\': true,\\\\n          \\\\'el-dropdown\\\\': true,\\\\n          \\\\'el-dropdown-menu\\\\': true,\\\\n          \\\\'el-dropdown-item\\\\': true\\\\n        }\\\\n      }\\\\n    })\\\\n\\\\n    router.push(\\\\'/analytics\\\\')\\\\n  })\\\\n\\\\n  afterEach(() => {\\\\n    if (wrapper) {\\\\n      wrapper.unmount()\\\\n    }\\\\n    vi.clearAllMocks()\\\\n  })\\\\n\\\\n  describe(\\\\'整体功能测试\\\\', () => {\\\\n    it(\\\\'应该正确渲染数据分析主页面\\\\', () => {\\\\n      expect(wrapper.find(\\\\'.data-analytics\\\\').exists()).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该包含所有分析组件\\\\', () => {\\\\n      expect(wrapper.findComponent(CustomerAnalytics).exists()).toBe(true)\\\\n      expect(wrapper.findComponent(MenuAnalytics).exists()).toBe(true)\\\\n      expect(wrapper.findComponent(OperationalAnalytics).exists()).toBe(true)\\\\n      expect(wrapper.findComponent(SalesAnalytics).exists()).toBe(true)\\\\n      expect(wrapper.findComponent(AlertSystem).exists()).toBe(true)\\\\n      expect(wrapper.findComponent(CustomDashboard).exists()).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确初始化日期范围选择器\\\\', () => {\\\\n      expect(wrapper.vm.dateRange).toBeDefined()\\\\n      expect(wrapper.vm.dateRange).toHaveLength(2)\\\\n    })\\\\n\\\\n    it(\\\\'应该支持切换分析模块\\\\', async () => {\\\\n      expect(wrapper.vm.activeTab).toBe(\\\\'overview\\\\')\\\\n\\\\n      await wrapper.setData({ activeTab: \\\\'customer\\\\' })\\\\n      expect(wrapper.vm.activeTab).toBe(\\\\'customer\\\\')\\\\n\\\\n      await wrapper.setData({ activeTab: \\\\'menu\\\\' })\\\\n      expect(wrapper.vm.activeTab).toBe(\\\\'menu\\\\')\\\\n\\\\n      await wrapper.setData({ activeTab: \\\\'operational\\\\' })\\\\n      expect(wrapper.vm.activeTab).toBe(\\\\'operational\\\\')\\\\n\\\\n      await wrapper.setData({ activeTab: \\\\'sales\\\\' })\\\\n      expect(wrapper.vm.activeTab).toBe(\\\\'sales\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'组件交互测试\\\\', () => {\\\\n    it(\\\\'应该能够从客户分析切换到菜单分析\\\\', async () => {\\\\n      await wrapper.setData({ activeTab: \\\\'customer\\\\' })\\\\n      expect(wrapper.findComponent(CustomerAnalytics).exists()).toBe(true)\\\\n\\\\n      await wrapper.setData({ activeTab: \\\\'menu\\\\' })\\\\n      expect(wrapper.findComponent(MenuAnalytics).exists()).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该能够从菜单分析切换到运营分析\\\\', async () => {\\\\n      await wrapper.setData({ activeTab: \\\\'menu\\\\' })\\\\n      expect(wrapper.findComponent(MenuAnalytics).exists()).toBe(true)\\\\n\\\\n      await wrapper.setData({ activeTab: \\\\'operational\\\\' })\\\\n      expect(wrapper.findComponent(OperationalAnalytics).exists()).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该能够从运营分析切换到销售分析\\\\', async () => {\\\\n      await wrapper.setData({ activeTab: \\\\'operational\\\\' })\\\\n      expect(wrapper.findComponent(OperationalAnalytics).exists()).toBe(true)\\\\n\\\\n      await wrapper.setData({ activeTab: \\\\'sales\\\\' })\\\\n      expect(wrapper.findComponent(SalesAnalytics).exists()).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该能够从销售分析切换到自定义仪表板\\\\', async () => {\\\\n      await wrapper.setData({ activeTab: \\\\'sales\\\\' })\\\\n      expect(wrapper.findComponent(SalesAnalytics).exists()).toBe(true)\\\\n\\\\n      await wrapper.setData({ activeTab: \\\\'custom\\\\' })\\\\n      expect(wrapper.findComponent(CustomDashboard).exists()).toBe(true)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'数据刷新功能测试\\\\', () => {\\\\n    it(\\\\'应该支持手动刷新数据\\\\', async () => {\\\\n      const refreshSpy = vi.spyOn(wrapper.vm, \\\\'refreshData\\\\')\\\\n      await wrapper.vm.refreshData()\\\\n      expect(refreshSpy).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'刷新后应该更新所有分析组件的数据\\\\', async () => {\\\\n      await wrapper.setData({ activeTab: \\\\'customer\\\\' })\\\\n      const customerAnalytics = wrapper.findComponent(CustomerAnalytics)\\\\n      await wrapper.vm.refreshData()\\\\n      expect(customerAnalytics.vm.lastRefreshTime).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该显示刷新状态指示器\\\\', async () => {\\\\n      await wrapper.setData({ isRefreshing: true })\\\\n      expect(wrapper.vm.isRefreshing).toBe(true)\\\\n\\\\n      await wrapper.setData({ isRefreshing: false })\\\\n      expect(wrapper.vm.isRefreshing).toBe(false)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'日期范围筛选测试\\\\', () => {\\\\n    it(\\\\'应该支持选择日期范围\\\\', async () => {\\\\n      const newDateRange = [new Date(\\\\'2024-01-01\\\\'), new Date(\\\\'2024-01-31\\\\')]\\\\n      await wrapper.setData({ dateRange: newDateRange })\\\\n      expect(wrapper.vm.dateRange).toEqual(newDateRange)\\\\n    })\\\\n\\\\n    it(\\\\'日期范围改变后应该触发数据刷新\\\\', async () => {\\\\n      const refreshSpy = vi.spyOn(wrapper.vm, \\\\'refreshData\\\\')\\\\n      const newDateRange = [new Date(\\\\'2024-01-01\\\\'), new Date(\\\\'2024-01-31\\\\')]\\\\n      await wrapper.setData({ dateRange: newDateRange })\\\\n      expect(refreshSpy).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该支持快捷日期选择\\\\', async () => {\\\\n      await wrapper.vm.selectQuickDate(\\\\'today\\\\')\\\\n      expect(wrapper.vm.dateRange).toBeDefined()\\\\n\\\\n      await wrapper.vm.selectQuickDate(\\\\'week\\\\')\\\\n      expect(wrapper.vm.dateRange).toBeDefined()\\\\n\\\\n      await wrapper.vm.selectQuickDate(\\\\'month\\\\')\\\\n      expect(wrapper.vm.dateRange).toBeDefined()\\\\n\\\\n      await wrapper.vm.selectQuickDate(\\\\'year\\\\')\\\\n      expect(wrapper.vm.dateRange).toBeDefined()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'告警系统集成测试\\\\', () => {\\\\n    it(\\\\'应该正确显示告警通知\\\\', async () => {\\\\n      await wrapper.setData({ showAlerts: true })\\\\n      const alertSystem = wrapper.findComponent(AlertSystem)\\\\n      expect(alertSystem.exists()).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该能够处理告警通知\\\\', async () => {\\\\n      const alertSystem = wrapper.findComponent(AlertSystem)\\\\n      const handleAlertSpy = vi.spyOn(wrapper.vm, \\\\'handleAlert\\\\')\\\\n      await alertSystem.vm.$emit(\\\\'alert\\\\', { type: \\\\'warning\\\\', message: \\\\'测试告警\\\\' })\\\\n      expect(handleAlertSpy).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该能够关闭告警通知\\\\', async () => {\\\\n      await wrapper.setData({ showAlerts: true })\\\\n      expect(wrapper.vm.showAlerts).toBe(true)\\\\n\\\\n      await wrapper.setData({ showAlerts: false })\\\\n      expect(wrapper.vm.showAlerts).toBe(false)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'自定义仪表板集成测试\\\\', () => {\\\\n    it(\\\\'应该能够打开自定义仪表板\\\\', async () => {\\\\n      await wrapper.setData({ activeTab: \\\\'custom\\\\' })\\\\n      const customDashboard = wrapper.findComponent(CustomDashboard)\\\\n      expect(customDashboard.exists()).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该能够保存自定义仪表板配置\\\\', async () => {\\\\n      const customDashboard = wrapper.findComponent(CustomDashboard)\\\\n      const saveConfigSpy = vi.spyOn(wrapper.vm, \\\\'saveDashboardConfig\\\\')\\\\n      const config = {\\\\n        layout: [\\\\'customer\\\\', \\\\'menu\\\\', \\\\'sales\\\\'],\\\\n        widgets: [\\\\n          { id: \\\\'customer-growth\\\\', position: { x: 0, y: 0, w: 6, h: 4 } },\\\\n          { id: \\\\'menu-performance\\\\', position: { x: 6, y: 0, w: 6, h: 4 } },\\\\n          { id: \\\\'sales-trend\\\\', position: { x: 0, y: 4, w: 12, h: 4 } }\\\\n        ]\\\\n      }\\\\n      await wrapper.vm.saveDashboardConfig(config)\\\\n      expect(saveConfigSpy).toHaveBeenCalledWith(config)\\\\n    })\\\\n\\\\n    it(\\\\'应该能够加载自定义仪表板配置\\\\', async () => {\\\\n      const loadConfigSpy = vi.spyOn(wrapper.vm, \\\\'loadDashboardConfig\\\\')\\\\n      await wrapper.vm.loadDashboardConfig()\\\\n      expect(loadConfigSpy).toHaveBeenCalled()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'数据导出功能测试\\\\', () => {\\\\n    it(\\\\'应该支持导出分析报告\\\\', async () => {\\\\n      const exportSpy = vi.spyOn(wrapper.vm, \\\\'exportReport\\\\')\\\\n      await wrapper.vm.exportReport(\\\\'pdf\\\\')\\\\n      expect(exportSpy).toHaveBeenCalledWith(\\\\'pdf\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该支持导出不同格式的报告\\\\', async () => {\\\\n      const formats = [\\\\'pdf\\\\', \\\\'excel\\\\', \\\\'csv\\\\']\\\\n      for (const format of formats) {\\\\n        await wrapper.vm.exportReport(format)\\\\n        expect(wrapper.vm.exportFormat).toBe(format)\\\\n      }\\\\n    })\\\\n\\\\n    it(\\\\'导出时应该包含当前选择的数据范围\\\\', async () => {\\\\n      await wrapper.setData({ dateRange: [new Date(\\\\'2024-01-01\\\\'), new Date(\\\\'2024-01-31\\\\')] })\\\\n      const exportSpy = vi.spyOn(wrapper.vm, \\\\'exportReport\\\\')\\\\n      await wrapper.vm.exportReport(\\\\'pdf\\\\')\\\\n      expect(exportSpy).toHaveBeenCalled()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'性能测试\\\\', () => {\\\\n    it(\\\\'应该在合理时间内完成组件初始化\\\\', async () => {\\\\n      const startTime = Date.now()\\\\n      await wrapper.vm.$nextTick()\\\\n      const endTime = Date.now()\\\\n      expect(endTime - startTime).toBeLessThan(1000)\\\\n    })\\\\n\\\\n    it(\\\\'应该在合理时间内完成数据刷新\\\\', async () => {\\\\n      const startTime = Date.now()\\\\n      await wrapper.vm.refreshData()\\\\n      const endTime = Date.now()\\\\n      expect(endTime - startTime).toBeLessThan(2000)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确处理大量数据\\\\', async () => {\\\\n      const largeDataSet = Array.from({ length: 10000 }, (_, i) => ({\\\\n        id: i,\\\\n        value: Math.random() * 100\\\\n      }))\\\\n      await wrapper.setData({ analyticsData: largeDataSet })\\\\n      expect(wrapper.vm.analyticsData).toHaveLength(10000)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'错误处理测试\\\\', () => {\\\\n    it(\\\\'应该正确处理数据加载错误\\\\', async () => {\\\\n      const consoleSpy = vi.spyOn(console, \\\\'error\\\\').mockImplementation(() => {})\\\\n      await wrapper.vm.refreshData().catch(() => {})\\\\n      expect(consoleSpy).toHaveBeenCalled()\\\\n      consoleSpy.mockRestore()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确处理组件渲染错误\\\\', async () => {\\\\n      const consoleSpy = vi.spyOn(console, \\\\'error\\\\').mockImplementation(() => {})\\\\n      try {\\\\n        await wrapper.setData({ activeTab: \\\\'invalid\\\\' })\\\\n      } catch (error) {\\\\n        expect(consoleSpy).toHaveBeenCalled()\\\\n      }\\\\n      consoleSpy.mockRestore()\\\\n    })\\\\n\\\\n    it(\\\\'应该显示友好的错误提示\\\\', async () => {\\\\n      await wrapper.setData({ error: \\\\'测试错误\\\\' })\\\\n      expect(wrapper.vm.error).toBe(\\\\'测试错误\\\\')\\\\n      expect(wrapper.find(\\\\'.error-message\\\\').exists()).toBe(true)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'响应式设计测试\\\\', () => {\\\\n    it(\\\\'应该在小屏幕上正确显示\\\\', async () => {\\\\n      await wrapper.setData({ screenSize: \\\\'small\\\\' })\\\\n      expect(wrapper.vm.screenSize).toBe(\\\\'small\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该在中屏幕上正确显示\\\\', async () => {\\\\n      await wrapper.setData({ screenSize: \\\\'medium\\\\' })\\\\n      expect(wrapper.vm.screenSize).toBe(\\\\'medium\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该在大屏幕上正确显示\\\\', async () => {\\\\n      await wrapper.setData({ screenSize: \\\\'large\\\\' })\\\\n      expect(wrapper.vm.screenSize).toBe(\\\\'large\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该根据屏幕大小调整布局\\\\', async () => {\\\\n      await wrapper.setData({ screenSize: \\\\'small\\\\' })\\\\n      expect(wrapper.vm.layoutMode).toBe(\\\\'compact\\\\')\\\\n\\\\n      await wrapper.setData({ screenSize: \\\\'large\\\\' })\\\\n      expect(wrapper.vm.layoutMode).toBe(\\\\'expanded\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'数据可视化集成测试\\\\', () => {\\\\n    it(\\\\'应该正确初始化所有图表\\\\', async () => {\\\\n      await wrapper.vm.$nextTick()\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确更新图表数据\\\\', async () => {\\\\n      await wrapper.setData({ activeTab: \\\\'customer\\\\' })\\\\n      const customerAnalytics = wrapper.findComponent(CustomerAnalytics)\\\\n      await customerAnalytics.vm.updateChartData()\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确处理图表交互\\\\', async () => {\\\\n      await wrapper.setData({ activeTab: \\\\'sales\\\\' })\\\\n      const salesAnalytics = wrapper.findComponent(SalesAnalytics)\\\\n      await salesAnalytics.vm.handleChartClick({ dataIndex: 0 })\\\\n      expect(wrapper.vm.selectedDataPoint).toBeDefined()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'实时数据更新测试\\\\', () => {\\\\n    it(\\\\'应该支持实时数据更新\\\\', async () => {\\\\n      await wrapper.setData({ enableRealTimeUpdates: true })\\\\n      expect(wrapper.vm.enableRealTimeUpdates).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确处理实时数据推送\\\\', async () => {\\\\n      const handleRealTimeUpdateSpy = vi.spyOn(wrapper.vm, \\\\'handleRealTimeUpdate\\\\')\\\\n      const updateData = { type: \\\\'sales\\\\', data: { value: 1000 } }\\\\n      await wrapper.vm.handleRealTimeUpdate(updateData)\\\\n      expect(handleRealTimeUpdateSpy).toHaveBeenCalledWith(updateData)\\\\n    })\\\\n\\\\n    it(\\\\'应该能够暂停和恢复实时更新\\\\', async () => {\\\\n      await wrapper.setData({ enableRealTimeUpdates: true })\\\\n      expect(wrapper.vm.enableRealTimeUpdates).toBe(true)\\\\n\\\\n      await wrapper.setData({ enableRealTimeUpdates: false })\\\\n      expect(wrapper.vm.enableRealTimeUpdates).toBe(false)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'权限控制测试\\\\', () => {\\\\n    it(\\\\'应该根据用户权限显示不同的分析模块\\\\', async () => {\\\\n      await wrapper.setData({ userPermissions: [\\\\'customer\\\\', \\\\'menu\\\\'] })\\\\n      expect(wrapper.vm.availableTabs).toContain(\\\\'customer\\\\')\\\\n      expect(wrapper.vm.availableTabs).toContain(\\\\'menu\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该隐藏无权限访问的分析模块\\\\', async () => {\\\\n      await wrapper.setData({ userPermissions: [\\\\'customer\\\\'] })\\\\n      expect(wrapper.vm.availableTabs).toContain(\\\\'customer\\\\')\\\\n      expect(wrapper.vm.availableTabs).not.toContain(\\\\'operational\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该正确处理权限不足的情况\\\\', async () => {\\\\n      await wrapper.setData({ userPermissions: [] })\\\\n      expect(wrapper.vm.availableTabs).toHaveLength(0)\\\\n    })\\\\n  })\\\\n})\\\\n\",\"originAcceptText\":\"import { describe, it, expect, beforeEach, afterEach, vi } from 'vitest'\\nimport { mount, VueWrapper } from '@vue/test-utils'\\nimport { createPinia, setActivePinia } from 'pinia'\\nimport { createRouter, createMemoryHistory } from 'vue-router'\\nimport ElementPlus from 'element-plus'\\nimport * as echarts from 'echarts'\\n\\nimport DataAnalytics from '../../views/DataAnalytics.vue'\\nimport CustomerAnalytics from '../../components/analytics/CustomerAnalytics.vue'\\nimport MenuAnalytics from '../../components/analytics/MenuAnalytics.vue'\\nimport OperationalAnalytics from '../../components/analytics/OperationalAnalytics.vue'\\nimport SalesAnalytics from '../../components/analytics/SalesAnalytics.vue'\\nimport AlertSystem from '../../components/analytics/AlertSystem.vue'\\nimport CustomDashboard from '../../components/analytics/CustomDashboard.vue'\\n\\nvi.mock('echarts', () => ({\\n  default: {\\n    init: vi.fn(() => ({\\n      setOption: vi.fn(),\\n      resize: vi.fn(),\\n      dispose: vi.fn()\\n    }))\\n  }\\n}))\\n\\nconst router = createRouter({\\n  history: createMemoryHistory(),\\n  routes: [\\n    { path: '/analytics', component: DataAnalytics }\\n  ]\\n})\\n\\ndescribe('DataAnalytics集成测试', () => {\\n  let wrapper: VueWrapper<any>\\n  let pinia: any\\n\\n  beforeEach(() => {\\n    pinia = createPinia()\\n    setActivePinia(pinia)\\n\\n    wrapper = mount(DataAnalytics, {\\n      global: {\\n        plugins: [pinia, router, ElementPlus],\\n        stubs: {\\n          'el-card': true,\\n          'el-row': true,\\n          'el-col': true,\\n          'el-tabs': true,\\n          'el-tab-pane': true,\\n          'el-button': true,\\n          'el-select': true,\\n          'el-option': true,\\n          'el-date-picker': true,\\n          'el-dialog': true,\\n          'el-table': true,\\n          'el-table-column': true,\\n          'el-statistic': true,\\n          'el-progress': true,\\n          'el-tag': true,\\n          'el-icon': true,\\n          'el-tooltip': true,\\n          'el-popover': true,\\n          'el-switch': true,\\n          'el-slider': true,\\n          'el-input': true,\\n          'el-form': true,\\n          'el-form-item': true,\\n          'el-radio-group': true,\\n          'el-radio-button': true,\\n          'el-divider': true,\\n          'el-alert': true,\\n          'el-badge': true,\\n          'el-dropdown': true,\\n          'el-dropdown-menu': true,\\n          'el-dropdown-item': true\\n        }\\n      }\\n    })\\n\\n    router.push('/analytics')\\n  })\\n\\n  afterEach(() => {\\n    if (wrapper) {\\n      wrapper.unmount()\\n    }\\n    vi.clearAllMocks()\\n  })\\n\\n  describe('整体功能测试', () => {\\n    it('应该正确渲染数据分析主页面', () => {\\n      expect(wrapper.find('.data-analytics').exists()).toBe(true)\\n    })\\n\\n    it('应该包含所有分析组件', () => {\\n      expect(wrapper.findComponent(CustomerAnalytics).exists()).toBe(true)\\n      expect(wrapper.findComponent(MenuAnalytics).exists()).toBe(true)\\n      expect(wrapper.findComponent(OperationalAnalytics).exists()).toBe(true)\\n      expect(wrapper.findComponent(SalesAnalytics).exists()).toBe(true)\\n      expect(wrapper.findComponent(AlertSystem).exists()).toBe(true)\\n      expect(wrapper.findComponent(CustomDashboard).exists()).toBe(true)\\n    })\\n\\n    it('应该正确初始化日期范围选择器', () => {\\n      expect(wrapper.vm.dateRange).toBeDefined()\\n      expect(wrapper.vm.dateRange).toHaveLength(2)\\n    })\\n\\n    it('应该支持切换分析模块', async () => {\\n      expect(wrapper.vm.activeTab).toBe('overview')\\n\\n      await wrapper.setData({ activeTab: 'customer' })\\n      expect(wrapper.vm.activeTab).toBe('customer')\\n\\n      await wrapper.setData({ activeTab: 'menu' })\\n      expect(wrapper.vm.activeTab).toBe('menu')\\n\\n      await wrapper.setData({ activeTab: 'operational' })\\n      expect(wrapper.vm.activeTab).toBe('operational')\\n\\n      await wrapper.setData({ activeTab: 'sales' })\\n      expect(wrapper.vm.activeTab).toBe('sales')\\n    })\\n  })\\n\\n  describe('组件交互测试', () => {\\n    it('应该能够从客户分析切换到菜单分析', async () => {\\n      await wrapper.setData({ activeTab: 'customer' })\\n      expect(wrapper.findComponent(CustomerAnalytics).exists()).toBe(true)\\n\\n      await wrapper.setData({ activeTab: 'menu' })\\n      expect(wrapper.findComponent(MenuAnalytics).exists()).toBe(true)\\n    })\\n\\n    it('应该能够从菜单分析切换到运营分析', async () => {\\n      await wrapper.setData({ activeTab: 'menu' })\\n      expect(wrapper.findComponent(MenuAnalytics).exists()).toBe(true)\\n\\n      await wrapper.setData({ activeTab: 'operational' })\\n      expect(wrapper.findComponent(OperationalAnalytics).exists()).toBe(true)\\n    })\\n\\n    it('应该能够从运营分析切换到销售分析', async () => {\\n      await wrapper.setData({ activeTab: 'operational' })\\n      expect(wrapper.findComponent(OperationalAnalytics).exists()).toBe(true)\\n\\n      await wrapper.setData({ activeTab: 'sales' })\\n      expect(wrapper.findComponent(SalesAnalytics).exists()).toBe(true)\\n    })\\n\\n    it('应该能够从销售分析切换到自定义仪表板', async () => {\\n      await wrapper.setData({ activeTab: 'sales' })\\n      expect(wrapper.findComponent(SalesAnalytics).exists()).toBe(true)\\n\\n      await wrapper.setData({ activeTab: 'custom' })\\n      expect(wrapper.findComponent(CustomDashboard).exists()).toBe(true)\\n    })\\n  })\\n\\n  describe('数据刷新功能测试', () => {\\n    it('应该支持手动刷新数据', async () => {\\n      const refreshSpy = vi.spyOn(wrapper.vm, 'refreshData')\\n      await wrapper.vm.refreshData()\\n      expect(refreshSpy).toHaveBeenCalled()\\n    })\\n\\n    it('刷新后应该更新所有分析组件的数据', async () => {\\n      await wrapper.setData({ activeTab: 'customer' })\\n      const customerAnalytics = wrapper.findComponent(CustomerAnalytics)\\n      await wrapper.vm.refreshData()\\n      expect(customerAnalytics.vm.lastRefreshTime).toBeDefined()\\n    })\\n\\n    it('应该显示刷新状态指示器', async () => {\\n      await wrapper.setData({ isRefreshing: true })\\n      expect(wrapper.vm.isRefreshing).toBe(true)\\n\\n      await wrapper.setData({ isRefreshing: false })\\n      expect(wrapper.vm.isRefreshing).toBe(false)\\n    })\\n  })\\n\\n  describe('日期范围筛选测试', () => {\\n    it('应该支持选择日期范围', async () => {\\n      const newDateRange = [new Date('2024-01-01'), new Date('2024-01-31')]\\n      await wrapper.setData({ dateRange: newDateRange })\\n      expect(wrapper.vm.dateRange).toEqual(newDateRange)\\n    })\\n\\n    it('日期范围改变后应该触发数据刷新', async () => {\\n      const refreshSpy = vi.spyOn(wrapper.vm, 'refreshData')\\n      const newDateRange = [new Date('2024-01-01'), new Date('2024-01-31')]\\n      await wrapper.setData({ dateRange: newDateRange })\\n      expect(refreshSpy).toHaveBeenCalled()\\n    })\\n\\n    it('应该支持快捷日期选择', async () => {\\n      await wrapper.vm.selectQuickDate('today')\\n      expect(wrapper.vm.dateRange).toBeDefined()\\n\\n      await wrapper.vm.selectQuickDate('week')\\n      expect(wrapper.vm.dateRange).toBeDefined()\\n\\n      await wrapper.vm.selectQuickDate('month')\\n      expect(wrapper.vm.dateRange).toBeDefined()\\n\\n      await wrapper.vm.selectQuickDate('year')\\n      expect(wrapper.vm.dateRange).toBeDefined()\\n    })\\n  })\\n\\n  describe('告警系统集成测试', () => {\\n    it('应该正确显示告警通知', async () => {\\n      await wrapper.setData({ showAlerts: true })\\n      const alertSystem = wrapper.findComponent(AlertSystem)\\n      expect(alertSystem.exists()).toBe(true)\\n    })\\n\\n    it('应该能够处理告警通知', async () => {\\n      const alertSystem = wrapper.findComponent(AlertSystem)\\n      const handleAlertSpy = vi.spyOn(wrapper.vm, 'handleAlert')\\n      await alertSystem.vm.$emit('alert', { type: 'warning', message: '测试告警' })\\n      expect(handleAlertSpy).toHaveBeenCalled()\\n    })\\n\\n    it('应该能够关闭告警通知', async () => {\\n      await wrapper.setData({ showAlerts: true })\\n      expect(wrapper.vm.showAlerts).toBe(true)\\n\\n      await wrapper.setData({ showAlerts: false })\\n      expect(wrapper.vm.showAlerts).toBe(false)\\n    })\\n  })\\n\\n  describe('自定义仪表板集成测试', () => {\\n    it('应该能够打开自定义仪表板', async () => {\\n      await wrapper.setData({ activeTab: 'custom' })\\n      const customDashboard = wrapper.findComponent(CustomDashboard)\\n      expect(customDashboard.exists()).toBe(true)\\n    })\\n\\n    it('应该能够保存自定义仪表板配置', async () => {\\n      const customDashboard = wrapper.findComponent(CustomDashboard)\\n      const saveConfigSpy = vi.spyOn(wrapper.vm, 'saveDashboardConfig')\\n      const config = {\\n        layout: ['customer', 'menu', 'sales'],\\n        widgets: [\\n          { id: 'customer-growth', position: { x: 0, y: 0, w: 6, h: 4 } },\\n          { id: 'menu-performance', position: { x: 6, y: 0, w: 6, h: 4 } },\\n          { id: 'sales-trend', position: { x: 0, y: 4, w: 12, h: 4 } }\\n        ]\\n      }\\n      await wrapper.vm.saveDashboardConfig(config)\\n      expect(saveConfigSpy).toHaveBeenCalledWith(config)\\n    })\\n\\n    it('应该能够加载自定义仪表板配置', async () => {\\n      const loadConfigSpy = vi.spyOn(wrapper.vm, 'loadDashboardConfig')\\n      await wrapper.vm.loadDashboardConfig()\\n      expect(loadConfigSpy).toHaveBeenCalled()\\n    })\\n  })\\n\\n  describe('数据导出功能测试', () => {\\n    it('应该支持导出分析报告', async () => {\\n      const exportSpy = vi.spyOn(wrapper.vm, 'exportReport')\\n      await wrapper.vm.exportReport('pdf')\\n      expect(exportSpy).toHaveBeenCalledWith('pdf')\\n    })\\n\\n    it('应该支持导出不同格式的报告', async () => {\\n      const formats = ['pdf', 'excel', 'csv']\\n      for (const format of formats) {\\n        await wrapper.vm.exportReport(format)\\n        expect(wrapper.vm.exportFormat).toBe(format)\\n      }\\n    })\\n\\n    it('导出时应该包含当前选择的数据范围', async () => {\\n      await wrapper.setData({ dateRange: [new Date('2024-01-01'), new Date('2024-01-31')] })\\n      const exportSpy = vi.spyOn(wrapper.vm, 'exportReport')\\n      await wrapper.vm.exportReport('pdf')\\n      expect(exportSpy).toHaveBeenCalled()\\n    })\\n  })\\n\\n  describe('性能测试', () => {\\n    it('应该在合理时间内完成组件初始化', async () => {\\n      const startTime = Date.now()\\n      await wrapper.vm.$nextTick()\\n      const endTime = Date.now()\\n      expect(endTime - startTime).toBeLessThan(1000)\\n    })\\n\\n    it('应该在合理时间内完成数据刷新', async () => {\\n      const startTime = Date.now()\\n      await wrapper.vm.refreshData()\\n      const endTime = Date.now()\\n      expect(endTime - startTime).toBeLessThan(2000)\\n    })\\n\\n    it('应该正确处理大量数据', async () => {\\n      const largeDataSet = Array.from({ length: 10000 }, (_, i) => ({\\n        id: i,\\n        value: Math.random() * 100\\n      }))\\n      await wrapper.setData({ analyticsData: largeDataSet })\\n      expect(wrapper.vm.analyticsData).toHaveLength(10000)\\n    })\\n  })\\n\\n  describe('错误处理测试', () => {\\n    it('应该正确处理数据加载错误', async () => {\\n      const consoleSpy = vi.spyOn(console, 'error').mockImplementation(() => {})\\n      await wrapper.vm.refreshData().catch(() => {})\\n      expect(consoleSpy).toHaveBeenCalled()\\n      consoleSpy.mockRestore()\\n    })\\n\\n    it('应该正确处理组件渲染错误', async () => {\\n      const consoleSpy = vi.spyOn(console, 'error').mockImplementation(() => {})\\n      try {\\n        await wrapper.setData({ activeTab: 'invalid' })\\n      } catch (error) {\\n        expect(consoleSpy).toHaveBeenCalled()\\n      }\\n      consoleSpy.mockRestore()\\n    })\\n\\n    it('应该显示友好的错误提示', async () => {\\n      await wrapper.setData({ error: '测试错误' })\\n      expect(wrapper.vm.error).toBe('测试错误')\\n      expect(wrapper.find('.error-message').exists()).toBe(true)\\n    })\\n  })\\n\\n  describe('响应式设计测试', () => {\\n    it('应该在小屏幕上正确显示', async () => {\\n      await wrapper.setData({ screenSize: 'small' })\\n      expect(wrapper.vm.screenSize).toBe('small')\\n    })\\n\\n    it('应该在中屏幕上正确显示', async () => {\\n      await wrapper.setData({ screenSize: 'medium' })\\n      expect(wrapper.vm.screenSize).toBe('medium')\\n    })\\n\\n    it('应该在大屏幕上正确显示', async () => {\\n      await wrapper.setData({ screenSize: 'large' })\\n      expect(wrapper.vm.screenSize).toBe('large')\\n    })\\n\\n    it('应该根据屏幕大小调整布局', async () => {\\n      await wrapper.setData({ screenSize: 'small' })\\n      expect(wrapper.vm.layoutMode).toBe('compact')\\n\\n      await wrapper.setData({ screenSize: 'large' })\\n      expect(wrapper.vm.layoutMode).toBe('expanded')\\n    })\\n  })\\n\\n  describe('数据可视化集成测试', () => {\\n    it('应该正确初始化所有图表', async () => {\\n      await wrapper.vm.$nextTick()\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n\\n    it('应该正确更新图表数据', async () => {\\n      await wrapper.setData({ activeTab: 'customer' })\\n      const customerAnalytics = wrapper.findComponent(CustomerAnalytics)\\n      await customerAnalytics.vm.updateChartData()\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n\\n    it('应该正确处理图表交互', async () => {\\n      await wrapper.setData({ activeTab: 'sales' })\\n      const salesAnalytics = wrapper.findComponent(SalesAnalytics)\\n      await salesAnalytics.vm.handleChartClick({ dataIndex: 0 })\\n      expect(wrapper.vm.selectedDataPoint).toBeDefined()\\n    })\\n  })\\n\\n  describe('实时数据更新测试', () => {\\n    it('应该支持实时数据更新', async () => {\\n      await wrapper.setData({ enableRealTimeUpdates: true })\\n      expect(wrapper.vm.enableRealTimeUpdates).toBe(true)\\n    })\\n\\n    it('应该正确处理实时数据推送', async () => {\\n      const handleRealTimeUpdateSpy = vi.spyOn(wrapper.vm, 'handleRealTimeUpdate')\\n      const updateData = { type: 'sales', data: { value: 1000 } }\\n      await wrapper.vm.handleRealTimeUpdate(updateData)\\n      expect(handleRealTimeUpdateSpy).toHaveBeenCalledWith(updateData)\\n    })\\n\\n    it('应该能够暂停和恢复实时更新', async () => {\\n      await wrapper.setData({ enableRealTimeUpdates: true })\\n      expect(wrapper.vm.enableRealTimeUpdates).toBe(true)\\n\\n      await wrapper.setData({ enableRealTimeUpdates: false })\\n      expect(wrapper.vm.enableRealTimeUpdates).toBe(false)\\n    })\\n  })\\n\\n  describe('权限控制测试', () => {\\n    it('应该根据用户权限显示不同的分析模块', async () => {\\n      await wrapper.setData({ userPermissions: ['customer', 'menu'] })\\n      expect(wrapper.vm.availableTabs).toContain('customer')\\n      expect(wrapper.vm.availableTabs).toContain('menu')\\n    })\\n\\n    it('应该隐藏无权限访问的分析模块', async () => {\\n      await wrapper.setData({ userPermissions: ['customer'] })\\n      expect(wrapper.vm.availableTabs).toContain('customer')\\n      expect(wrapper.vm.availableTabs).not.toContain('operational')\\n    })\\n\\n    it('应该正确处理权限不足的情况', async () => {\\n      await wrapper.setData({ userPermissions: [] })\\n      expect(wrapper.vm.availableTabs).toHaveLength(0)\\n    })\\n  })\\n})\\n\",\"originTextLength\":13834,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768859946692},{\"originRange\":{\"start\":{\"line\":15,\"character\":0},\"end\":{\"line\":31,\"character\":40}},\"modifyRange\":{\"start\":{\"line\":15,\"character\":0},\"end\":{\"line\":31,\"character\":40}},\"action\":\"None\",\"isLine\":false,\"originText\":\"vi.mock(\\\\'echarts\\\\', () => {\\\\n  const mockChartInstance = {\\\\n    setOption: vi.fn(),\\\\n    resize: vi.fn(),\\\\n    dispose: vi.fn(),\\\\n    on: vi.fn(),\\\\n    off: vi.fn(),\\\\n    clear: vi.fn()\\\\n  }\\\\n  return {\\\\n    default: {\\\\n      init: vi.fn(() => mockChartInstance),\\\\n      graphic: {\\\\n        LinearGradient: vi.fn()\\\\n      }\\\\n    },\\\\n    init: vi.fn(() => mockChartInstance)\",\"originAcceptText\":\"vi.mock('echarts', () => {\\n  const mockChartInstance = {\\n    setOption: vi.fn(),\\n    resize: vi.fn(),\\n    dispose: vi.fn(),\\n    on: vi.fn(),\\n    off: vi.fn(),\\n    clear: vi.fn()\\n  }\\n  return {\\n    default: {\\n      init: vi.fn(() => mockChartInstance),\\n      graphic: {\\n        LinearGradient: vi.fn()\\n      }\\n    },\\n    init: vi.fn(() => mockChartInstance)\",\"originTextLength\":356,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768860388698},{\"originRange\":{\"start\":{\"line\":23,\"character\":0},\"end\":{\"line\":23,\"character\":2}},\"modifyRange\":{\"start\":{\"line\":23,\"character\":0},\"end\":{\"line\":23,\"character\":2}},\"action\":\"None\",\"isLine\":false,\"originText\":\"})\",\"originAcceptText\":\"})\",\"originTextLength\":2,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768860388732},{\"originRange\":{\"start\":{\"line\":24,\"character\":0},\"end\":{\"line\":24,\"character\":36}},\"modifyRange\":{\"start\":{\"line\":24,\"character\":0},\"end\":{\"line\":24,\"character\":36}},\"action\":\"None\"