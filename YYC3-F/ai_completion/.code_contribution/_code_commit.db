  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/utils/request.ts": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":46,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":46,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"/**\\\\n * @fileoverview HTTP请求工具\\\\n * @description 封装HTTP请求\\\\n * @module request\\\\n * @author YYC³\\\\n * @version 1.0.0\\\\n * @created 2025-01-20\\\\n */\\\\n\\\\nexport interface RequestOptions {\\\\n  method?: \\\\'GET\\\\' | \\\\'POST\\\\' | \\\\'PUT\\\\' | \\\\'DELETE\\\\'\\\\n  headers?: Record<string, string>\\\\n  body?: any\\\\n}\\\\n\\\\nexport interface ApiResponse<T = any> {\\\\n  success: boolean\\\\n  data?: T\\\\n  message?: string\\\\n  code?: number\\\\n}\\\\n\\\\nexport const request = async <T = any>(\\\\n  url: string,\\\\n  options: RequestOptions = {}\\\\n): Promise<ApiResponse<T>> => {\\\\n  const { method = \\\\'GET\\\\', headers = {}, body } = options\\\\n\\\\n  try {\\\\n    const response = await fetch(url, {\\\\n      method,\\\\n      headers: {\\\\n        \\\\'Content-Type\\\\': \\\\'application/json\\\\',\\\\n        ...headers\\\\n      },\\\\n      body: body ? JSON.stringify(body) : undefined\\\\n    })\\\\n\\\\n    if (!response.ok) {\\\\n      throw new Error(`HTTP error! status: ${response.status}`)\\\\n    }\\\\n\\\\n    return await response.json()\\\\n  } catch (error) {\\\\n    console.error(\\\\'Request failed:\\\\', error)\\\\n    return {\\\\n      success: false,\\\\n      message: error instanceof Error ? error.message : \\\\'请求失败\\\\'\\\\n    }\\\\n  }\\\\n}\\\\n\\\\nexport default request\\\\n\",\"originAcceptText\":\"/**\\n * @fileoverview HTTP请求工具\\n * @description 封装HTTP请求\\n * @module request\\n * @author YYC³\\n * @version 1.0.0\\n * @created 2025-01-20\\n */\\n\\nexport interface RequestOptions {\\n  method?: 'GET' | 'POST' | 'PUT' | 'DELETE'\\n  headers?: Record<string, string>\\n  body?: any\\n}\\n\\nexport interface ApiResponse<T = any> {\\n  success: boolean\\n  data?: T\\n  message?: string\\n  code?: number\\n}\\n\\nexport const request = async <T = any>(\\n  url: string,\\n  options: RequestOptions = {}\\n): Promise<ApiResponse<T>> => {\\n  const { method = 'GET', headers = {}, body } = options\\n\\n  try {\\n    const response = await fetch(url, {\\n      method,\\n      headers: {\\n        'Content-Type': 'application/json',\\n        ...headers\\n      },\\n      body: body ? JSON.stringify(body) : undefined\\n    })\\n\\n    if (!response.ok) {\\n      throw new Error(`HTTP error! status: ${response.status}`)\\n    }\\n\\n    return await response.json()\\n  } catch (error) {\\n    console.error('Request failed:', error)\\n    return {\\n      success: false,\\n      message: error instanceof Error ? error.message : '请求失败'\\n    }\\n  }\\n}\\n\\nexport default request\\n\",\"originTextLength\":1087,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768901172771}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/views/__tests__/DataAnalytics.test.ts": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":270,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":270,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"/**\\\\n * @fileoverview YYC³餐饮管理系统 - DataAnalytics组件单元测试\\\\n * @description 测试DataAnalytics组件的功能\\\\n * @module DataAnalytics.test\\\\n * @author YYC³\\\\n * @version 1.0.0\\\\n * @created 2025-01-20\\\\n */\\\\n\\\\nimport { describe, it, expect, beforeEach, vi } from \\\\'vitest\\\\'\\\\nimport { mount, VueWrapper } from \\\\'@vue/test-utils\\\\'\\\\nimport { createPinia, setActivePinia } from \\\\'pinia\\\\'\\\\nimport { ref, computed } from \\\\'vue\\\\'\\\\nimport ElementPlus, { ElMessage } from \\\\'element-plus\\\\'\\\\nimport DataAnalytics from \\\\'@/views/DataAnalytics.vue\\\\'\\\\n\\\\nvi.mock(\\\\'element-plus\\\\', () => ({\\\\n  default: {\\\\n    ElMessage: {\\\\n      success: vi.fn(),\\\\n      error: vi.fn(),\\\\n      warning: vi.fn(),\\\\n      info: vi.fn()\\\\n    }\\\\n  },\\\\n  ElMessage: {\\\\n    success: vi.fn(),\\\\n    error: vi.fn(),\\\\n    warning: vi.fn(),\\\\n    info: vi.fn()\\\\n  }\\\\n}))\\\\n\\\\ndescribe(\\\\'DataAnalytics组件\\\\', () => {\\\\n  let wrapper: VueWrapper<any>\\\\n  let pinia: any\\\\n\\\\n  beforeEach(() => {\\\\n    pinia = createPinia()\\\\n    setActivePinia(pinia)\\\\n    vi.clearAllMocks()\\\\n  })\\\\n\\\\n  const createWrapper = () => {\\\\n    return mount(DataAnalytics, {\\\\n      global: {\\\\n        plugins: [ElementPlus, pinia],\\\\n        stubs: {\\\\n          \\\\'el-tabs\\\\': {\\\\n            template: \\\\'<div class=\\\\\\\"el-tabs-mock\\\\\\\"><slot></slot></div>\\\\',\\\\n            props: [\\\\'model\\\\']\\\\n          },\\\\n          \\\\'el-tab-pane\\\\': {\\\\n            template: \\\\'<div class=\\\\\\\"el-tab-pane-mock\\\\\\\"><slot></slot></div>\\\\',\\\\n            props: [\\\\'label\\\\', \\\\'name\\\\']\\\\n          },\\\\n          \\\\'el-row\\\\': {\\\\n            template: \\\\'<div class=\\\\\\\"el-row-mock\\\\\\\"><slot></slot></div>\\\\',\\\\n            props: [\\\\'gutter\\\\']\\\\n          },\\\\n          \\\\'el-col\\\\': {\\\\n            template: \\\\'<div class=\\\\\\\"el-col-mock\\\\\\\"><slot></slot></div>\\\\',\\\\n            props: [\\\\'span\\\\']\\\\n          },\\\\n          \\\\'el-card\\\\': {\\\\n            template: \\\\'<div class=\\\\\\\"el-card-mock\\\\\\\"><slot></slot></div>\\\\',\\\\n            props: [\\\\'class\\\\']\\\\n          },\\\\n          \\\\'el-select\\\\': {\\\\n            template: \\\\'<select class=\\\\\\\"el-select-mock\\\\\\\"><slot></slot></select>\\\\',\\\\n            props: [\\\\'model\\\\']\\\\n          },\\\\n          \\\\'el-option\\\\': {\\\\n            template: \\\\'<option class=\\\\\\\"el-option-mock\\\\\\\"><slot></slot></option>\\\\',\\\\n            props: [\\\\'label\\\\', \\\\'value\\\\']\\\\n          },\\\\n          \\\\'el-date-picker\\\\': {\\\\n            template: \\\\'<input type=\\\\\\\"date\\\\\\\" class=\\\\\\\"el-date-picker-mock\\\\\\\" />\\\\',\\\\n            props: [\\\\'model\\\\', \\\\'type\\\\', \\\\'rangeSeparator\\\\', \\\\'startPlaceholder\\\\', \\\\'endPlaceholder\\\\']\\\\n          },\\\\n          \\\\'el-button\\\\': {\\\\n            template: \\\\'<button class=\\\\\\\"el-button-mock\\\\\\\"><slot></slot></button>\\\\',\\\\n            props: [\\\\'type\\\\', \\\\'loading\\\\']\\\\n          },\\\\n          \\\\'el-icon\\\\': {\\\\n            template: \\\\'<span class=\\\\\\\"el-icon-mock\\\\\\\"><slot></slot></span>\\\\'\\\\n          },\\\\n          \\\\'SalesAnalytics\\\\': {\\\\n            template: \\\\'<div class=\\\\\\\"sales-analytics-mock\\\\\\\">Sales Analytics</div>\\\\'\\\\n          },\\\\n          \\\\'CustomerAnalytics\\\\': {\\\\n            template: \\\\'<div class=\\\\\\\"customer-analytics-mock\\\\\\\">Customer Analytics</div>\\\\'\\\\n          },\\\\n          \\\\'MenuAnalytics\\\\': {\\\\n            template: \\\\'<div class=\\\\\\\"menu-analytics-mock\\\\\\\">Menu Analytics</div>\\\\'\\\\n          },\\\\n          \\\\'OperationalAnalytics\\\\': {\\\\n            template: \\\\'<div class=\\\\\\\"operational-analytics-mock\\\\\\\">Operational Analytics</div>\\\\'\\\\n          },\\\\n          \\\\'FinancialAnalytics\\\\': {\\\\n            template: \\\\'<div class=\\\\\\\"financial-analytics-mock\\\\\\\">Financial Analytics</div>\\\\'\\\\n          },\\\\n          \\\\'InventoryAnalytics\\\\': {\\\\n            template: \\\\'<div class=\\\\\\\"inventory-analytics-mock\\\\\\\">Inventory Analytics</div>\\\\'\\\\n          }\\\\n        }\\\\n      }\\\\n    })\\\\n  }\\\\n\\\\n  describe(\\\\'初始化渲染\\\\', () => {\\\\n    it(\\\\'应该正确渲染页面标题\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.vm.activeTab).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该渲染日期范围选择器\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.vm.selectedDateRange).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该渲染核心指标卡片\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.vm.coreMetrics).toBeDefined()\\\\n      expect(Array.isArray(wrapper.vm.coreMetrics)).toBe(true)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'日期范围选择\\\\', () => {\\\\n    it(\\\\'应该支持今天选项\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      wrapper.vm.selectedDateRange = \\\\'today\\\\'\\\\n      expect(wrapper.vm.selectedDateRange).toBe(\\\\'today\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该支持昨天选项\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      wrapper.vm.selectedDateRange = \\\\'yesterday\\\\'\\\\n      expect(wrapper.vm.selectedDateRange).toBe(\\\\'yesterday\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该支持本周选项\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      wrapper.vm.selectedDateRange = \\\\'this_week\\\\'\\\\n      expect(wrapper.vm.selectedDateRange).toBe(\\\\'this_week\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该支持本月选项\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      wrapper.vm.selectedDateRange = \\\\'this_month\\\\'\\\\n      expect(wrapper.vm.selectedDateRange).toBe(\\\\'this_month\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该支持自定义日期范围\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      wrapper.vm.selectedDateRange = \\\\'custom\\\\'\\\\n      expect(wrapper.vm.selectedDateRange).toBe(\\\\'custom\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'核心指标\\\\', () => {\\\\n    it(\\\\'应该正确初始化核心指标\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.vm.coreMetrics).toBeDefined()\\\\n      expect(Array.isArray(wrapper.vm.coreMetrics)).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该包含销售额指标\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      const salesMetric = wrapper.vm.coreMetrics.find((m: any) => m.key === \\\\'sales\\\\')\\\\n      expect(salesMetric).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该包含订单数指标\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      const ordersMetric = wrapper.vm.coreMetrics.find((m: any) => m.key === \\\\'orders\\\\')\\\\n      expect(ordersMetric).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该包含客户数指标\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      const customersMetric = wrapper.vm.coreMetrics.find((m: any) => m.key === \\\\'customers\\\\')\\\\n      expect(customersMetric).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该包含客单价指标\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      const avgOrderMetric = wrapper.vm.coreMetrics.find((m: any) => m.key === \\\\'avg_order\\\\')\\\\n      expect(avgOrderMetric).toBeDefined()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'标签页切换\\\\', () => {\\\\n    it(\\\\'应该支持销售分析标签\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      wrapper.vm.activeTab = \\\\'sales\\\\'\\\\n      expect(wrapper.vm.activeTab).toBe(\\\\'sales\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该支持客户分析标签\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      wrapper.vm.activeTab = \\\\'customer\\\\'\\\\n      expect(wrapper.vm.activeTab).toBe(\\\\'customer\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该支持菜单分析标签\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      wrapper.vm.activeTab = \\\\'menu\\\\'\\\\n      expect(wrapper.vm.activeTab).toBe(\\\\'menu\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该支持运营分析标签\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      wrapper.vm.activeTab = \\\\'operational\\\\'\\\\n      expect(wrapper.vm.activeTab).toBe(\\\\'operational\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该支持财务分析标签\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      wrapper.vm.activeTab = \\\\'financial\\\\'\\\\n      expect(wrapper.vm.activeTab).toBe(\\\\'financial\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该支持库存分析标签\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      wrapper.vm.activeTab = \\\\'inventory\\\\'\\\\n      expect(wrapper.vm.activeTab).toBe(\\\\'inventory\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'数据操作\\\\', () => {\\\\n    it(\\\\'应该能够刷新数据\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(typeof wrapper.vm.refreshData).toBe(\\\\'function\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该能够导出数据\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(typeof wrapper.vm.exportData).toBe(\\\\'function\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该能够打开仪表板设置\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.vm.showDashboardSettings).toBeDefined()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'日期范围变化\\\\', () => {\\\\n    it(\\\\'应该能够处理日期范围变化\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(typeof wrapper.vm.onDateRangeChange).toBe(\\\\'function\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该能够处理自定义日期变化\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(typeof wrapper.vm.onCustomDateChange).toBe(\\\\'function\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'标签页变化\\\\', () => {\\\\n    it(\\\\'应该能够处理标签页变化\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(typeof wrapper.vm.onTabChange).toBe(\\\\'function\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'数据格式化\\\\', () => {\\\\n    it(\\\\'应该能够格式化指标值\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(typeof wrapper.vm.formatMetricValue).toBe(\\\\'function\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'加载状态\\\\', () => {\\\\n    it(\\\\'应该正确初始化加载状态\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.vm.loading).toBeDefined()\\\\n      expect(typeof wrapper.vm.loading).toBe(\\\\'boolean\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'自定义日期范围\\\\', () => {\\\\n    it(\\\\'应该正确初始化自定义日期范围\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.vm.customDateRange).toBeDefined()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'仪表板设置\\\\', () => {\\\\n    it(\\\\'应该能够显示仪表板设置对话框\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.vm.showDashboardSettings).toBeDefined()\\\\n      expect(typeof wrapper.vm.showDashboardSettings).toBe(\\\\'boolean\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'生命周期\\\\', () => {\\\\n    it(\\\\'应该在挂载时初始化数据\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.vm.coreMetrics).toBeDefined()\\\\n      expect(wrapper.vm.activeTab).toBeDefined()\\\\n      expect(wrapper.vm.selectedDateRange).toBeDefined()\\\\n    })\\\\n  })\\\\n})\\\\n\",\"originAcceptText\":\"/**\\n * @fileoverview YYC³餐饮管理系统 - DataAnalytics组件单元测试\\n * @description 测试DataAnalytics组件的功能\\n * @module DataAnalytics.test\\n * @author YYC³\\n * @version 1.0.0\\n * @created 2025-01-20\\n */\\n\\nimport { describe, it, expect, beforeEach, vi } from 'vitest'\\nimport { mount, VueWrapper } from '@vue/test-utils'\\nimport { createPinia, setActivePinia } from 'pinia'\\nimport { ref, computed } from 'vue'\\nimport ElementPlus, { ElMessage } from 'element-plus'\\nimport DataAnalytics from '@/views/DataAnalytics.vue'\\n\\nvi.mock('element-plus', () => ({\\n  default: {\\n    ElMessage: {\\n      success: vi.fn(),\\n      error: vi.fn(),\\n      warning: vi.fn(),\\n      info: vi.fn()\\n    }\\n  },\\n  ElMessage: {\\n    success: vi.fn(),\\n    error: vi.fn(),\\n    warning: vi.fn(),\\n    info: vi.fn()\\n  }\\n}))\\n\\ndescribe('DataAnalytics组件', () => {\\n  let wrapper: VueWrapper<any>\\n  let pinia: any\\n\\n  beforeEach(() => {\\n    pinia = createPinia()\\n    setActivePinia(pinia)\\n    vi.clearAllMocks()\\n  })\\n\\n  const createWrapper = () => {\\n    return mount(DataAnalytics, {\\n      global: {\\n        plugins: [ElementPlus, pinia],\\n        stubs: {\\n          'el-tabs': {\\n            template: '<div class=\\\"el-tabs-mock\\\"><slot></slot></div>',\\n            props: ['model']\\n          },\\n          'el-tab-pane': {\\n            template: '<div class=\\\"el-tab-pane-mock\\\"><slot></slot></div>',\\n            props: ['label', 'name']\\n          },\\n          'el-row': {\\n            template: '<div class=\\\"el-row-mock\\\"><slot></slot></div>',\\n            props: ['gutter']\\n          },\\n          'el-col': {\\n            template: '<div class=\\\"el-col-mock\\\"><slot></slot></div>',\\n            props: ['span']\\n          },\\n          'el-card': {\\n            template: '<div class=\\\"el-card-mock\\\"><slot></slot></div>',\\n            props: ['class']\\n          },\\n          'el-select': {\\n            template: '<select class=\\\"el-select-mock\\\"><slot></slot></select>',\\n            props: ['model']\\n          },\\n          'el-option': {\\n            template: '<option class=\\\"el-option-mock\\\"><slot></slot></option>',\\n            props: ['label', 'value']\\n          },\\n          'el-date-picker': {\\n            template: '<input type=\\\"date\\\" class=\\\"el-date-picker-mock\\\" />',\\n            props: ['model', 'type', 'rangeSeparator', 'startPlaceholder', 'endPlaceholder']\\n          },\\n          'el-button': {\\n            template: '<button class=\\\"el-button-mock\\\"><slot></slot></button>',\\n            props: ['type', 'loading']\\n          },\\n          'el-icon': {\\n            template: '<span class=\\\"el-icon-mock\\\"><slot></slot></span>'\\n          },\\n          'SalesAnalytics': {\\n            template: '<div class=\\\"sales-analytics-mock\\\">Sales Analytics</div>'\\n          },\\n          'CustomerAnalytics': {\\n            template: '<div class=\\\"customer-analytics-mock\\\">Customer Analytics</div>'\\n          },\\n          'MenuAnalytics': {\\n            template: '<div class=\\\"menu-analytics-mock\\\">Menu Analytics</div>'\\n          },\\n          'OperationalAnalytics': {\\n            template: '<div class=\\\"operational-analytics-mock\\\">Operational Analytics</div>'\\n          },\\n          'FinancialAnalytics': {\\n            template: '<div class=\\\"financial-analytics-mock\\\">Financial Analytics</div>'\\n          },\\n          'InventoryAnalytics': {\\n            template: '<div class=\\\"inventory-analytics-mock\\\">Inventory Analytics</div>'\\n          }\\n        }\\n      }\\n    })\\n  }\\n\\n  describe('初始化渲染', () => {\\n    it('应该正确渲染页面标题', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.vm.activeTab).toBeDefined()\\n    })\\n\\n    it('应该渲染日期范围选择器', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.vm.selectedDateRange).toBeDefined()\\n    })\\n\\n    it('应该渲染核心指标卡片', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.vm.coreMetrics).toBeDefined()\\n      expect(Array.isArray(wrapper.vm.coreMetrics)).toBe(true)\\n    })\\n  })\\n\\n  describe('日期范围选择', () => {\\n    it('应该支持今天选项', () => {\\n      wrapper = createWrapper()\\n      wrapper.vm.selectedDateRange = 'today'\\n      expect(wrapper.vm.selectedDateRange).toBe('today')\\n    })\\n\\n    it('应该支持昨天选项', () => {\\n      wrapper = createWrapper()\\n      wrapper.vm.selectedDateRange = 'yesterday'\\n      expect(wrapper.vm.selectedDateRange).toBe('yesterday')\\n    })\\n\\n    it('应该支持本周选项', () => {\\n      wrapper = createWrapper()\\n      wrapper.vm.selectedDateRange = 'this_week'\\n      expect(wrapper.vm.selectedDateRange).toBe('this_week')\\n    })\\n\\n    it('应该支持本月选项', () => {\\n      wrapper = createWrapper()\\n      wrapper.vm.selectedDateRange = 'this_month'\\n      expect(wrapper.vm.selectedDateRange).toBe('this_month')\\n    })\\n\\n    it('应该支持自定义日期范围', () => {\\n      wrapper = createWrapper()\\n      wrapper.vm.selectedDateRange = 'custom'\\n      expect(wrapper.vm.selectedDateRange).toBe('custom')\\n    })\\n  })\\n\\n  describe('核心指标', () => {\\n    it('应该正确初始化核心指标', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.vm.coreMetrics).toBeDefined()\\n      expect(Array.isArray(wrapper.vm.coreMetrics)).toBe(true)\\n    })\\n\\n    it('应该包含销售额指标', () => {\\n      wrapper = createWrapper()\\n      const salesMetric = wrapper.vm.coreMetrics.find((m: any) => m.key === 'sales')\\n      expect(salesMetric).toBeDefined()\\n    })\\n\\n    it('应该包含订单数指标', () => {\\n      wrapper = createWrapper()\\n      const ordersMetric = wrapper.vm.coreMetrics.find((m: any) => m.key === 'orders')\\n      expect(ordersMetric).toBeDefined()\\n    })\\n\\n    it('应该包含客户数指标', () => {\\n      wrapper = createWrapper()\\n      const customersMetric = wrapper.vm.coreMetrics.find((m: any) => m.key === 'customers')\\n      expect(customersMetric).toBeDefined()\\n    })\\n\\n    it('应该包含客单价指标', () => {\\n      wrapper = createWrapper()\\n      const avgOrderMetric = wrapper.vm.coreMetrics.find((m: any) => m.key === 'avg_order')\\n      expect(avgOrderMetric).toBeDefined()\\n    })\\n  })\\n\\n  describe('标签页切换', () => {\\n    it('应该支持销售分析标签', () => {\\n      wrapper = createWrapper()\\n      wrapper.vm.activeTab = 'sales'\\n      expect(wrapper.vm.activeTab).toBe('sales')\\n    })\\n\\n    it('应该支持客户分析标签', () => {\\n      wrapper = createWrapper()\\n      wrapper.vm.activeTab = 'customer'\\n      expect(wrapper.vm.activeTab).toBe('customer')\\n    })\\n\\n    it('应该支持菜单分析标签', () => {\\n      wrapper = createWrapper()\\n      wrapper.vm.activeTab = 'menu'\\n      expect(wrapper.vm.activeTab).toBe('menu')\\n    })\\n\\n    it('应该支持运营分析标签', () => {\\n      wrapper = createWrapper()\\n      wrapper.vm.activeTab = 'operational'\\n      expect(wrapper.vm.activeTab).toBe('operational')\\n    })\\n\\n    it('应该支持财务分析标签', () => {\\n      wrapper = createWrapper()\\n      wrapper.vm.activeTab = 'financial'\\n      expect(wrapper.vm.activeTab).toBe('financial')\\n    })\\n\\n    it('应该支持库存分析标签', () => {\\n      wrapper = createWrapper()\\n      wrapper.vm.activeTab = 'inventory'\\n      expect(wrapper.vm.activeTab).toBe('inventory')\\n    })\\n  })\\n\\n  describe('数据操作', () => {\\n    it('应该能够刷新数据', () => {\\n      wrapper = createWrapper()\\n      expect(typeof wrapper.vm.refreshData).toBe('function')\\n    })\\n\\n    it('应该能够导出数据', () => {\\n      wrapper = createWrapper()\\n      expect(typeof wrapper.vm.exportData).toBe('function')\\n    })\\n\\n    it('应该能够打开仪表板设置', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.vm.showDashboardSettings).toBeDefined()\\n    })\\n  })\\n\\n  describe('日期范围变化', () => {\\n    it('应该能够处理日期范围变化', () => {\\n      wrapper = createWrapper()\\n      expect(typeof wrapper.vm.onDateRangeChange).toBe('function')\\n    })\\n\\n    it('应该能够处理自定义日期变化', () => {\\n      wrapper = createWrapper()\\n      expect(typeof wrapper.vm.onCustomDateChange).toBe('function')\\n    })\\n  })\\n\\n  describe('标签页变化', () => {\\n    it('应该能够处理标签页变化', () => {\\n      wrapper = createWrapper()\\n      expect(typeof wrapper.vm.onTabChange).toBe('function')\\n    })\\n  })\\n\\n  describe('数据格式化', () => {\\n    it('应该能够格式化指标值', () => {\\n      wrapper = createWrapper()\\n      expect(typeof wrapper.vm.formatMetricValue).toBe('function')\\n    })\\n  })\\n\\n  describe('加载状态', () => {\\n    it('应该正确初始化加载状态', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.vm.loading).toBeDefined()\\n      expect(typeof wrapper.vm.loading).toBe('boolean')\\n    })\\n  })\\n\\n  describe('自定义日期范围', () => {\\n    it('应该正确初始化自定义日期范围', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.vm.customDateRange).toBeDefined()\\n    })\\n  })\\n\\n  describe('仪表板设置', () => {\\n    it('应该能够显示仪表板设置对话框', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.vm.showDashboardSettings).toBeDefined()\\n      expect(typeof wrapper.vm.showDashboardSettings).toBe('boolean')\\n    })\\n  })\\n\\n  describe('生命周期', () => {\\n    it('应该在挂载时初始化数据', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.vm.coreMetrics).toBeDefined()\\n      expect(wrapper.vm.activeTab).toBeDefined()\\n      expect(wrapper.vm.selectedDateRange).toBeDefined()\\n    })\\n  })\\n})\\n\",\"originTextLength\":8680,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768901610746},{\"originRange\":{\"start\":{\"line\":12,\"character\":0},\"end\":{\"line\":12,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":12,\"character\":0},\"end\":{\"line\":12,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"\",\"originAcceptText\":\"\",\"originTextLength\":0,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768901654414},{\"originRange\":{\"start\":{\"line\":86,\"character\":0},\"end\":{\"line\":113,\"character\":12}},\"modifyRange\":{\"start\":{\"line\":86,\"character\":0},\"end\":{\"line\":113,\"character\":12}},\"action\":\"None\",\"isLine\":false,\"originText\":\"          \\\\'el-checkbox\\\\': {\\\\n            template: \\\\'<input type=\\\\\\\"checkbox\\\\\\\" class=\\\\\\\"el-checkbox-mock\\\\\\\" />\\\\',\\\\n            props: [\\\\'label\\\\', \\\\'border\\\\', \\\\'model\\\\']\\\\n          },\\\\n          \\\\'el-checkbox-group\\\\': {\\\\n            template: \\\\'<div class=\\\\\\\"el-checkbox-group-mock\\\\\\\"><slot></slot></div>\\\\',\\\\n            props: [\\\\'model\\\\']\\\\n          },\\\\n          \\\\'el-input-number\\\\': {\\\\n            template: \\\\'<input type=\\\\\\\"number\\\\\\\" class=\\\\\\\"el-input-number-mock\\\\\\\" />\\\\',\\\\n            props: [\\\\'model\\\\', \\\\'min\\\\']\\\\n          },\\\\n          \\\\'el-dialog\\\\': {\\\\n            template: \\\\'<div class=\\\\\\\"el-dialog-mock\\\\\\\" v-if=\\\\\\\"modelValue\\\\\\\"><slot></slot><slot name=\\\\\\\"footer\\\\\\\"></slot></div>\\\\',\\\\n            props: [\\\\'modelValue\\\\', \\\\'title\\\\', \\\\'width\\\\']\\\\n          },\\\\n          \\\\'el-form\\\\': {\\\\n            template: \\\\'<div class=\\\\\\\"el-form-mock\\\\\\\"><slot></slot></div>\\\\',\\\\n            props: [\\\\'model\\\\', \\\\'labelWidth\\\\']\\\\n          },\\\\n          \\\\'el-form-item\\\\': {\\\\n            template: \\\\'<div class=\\\\\\\"el-form-item-mock\\\\\\\"><slot></slot></div>\\\\',\\\\n            props: [\\\\'label\\\\']\\\\n          },\\\\n          \\\\'el-alert\\\\': {\\\\n            template: \\\\'<div class=\\\\\\\"el-alert-mock\\\\\\\"><slot></slot></div>\\\\',\\\\n            props: [\\\\'title\\\\', \\\\'type\\\\', \\\\'closable\\\\']\\\\n          },\",\"originAcceptText\":\"          'el-checkbox': {\\n            template: '<input type=\\\"checkbox\\\" class=\\\"el-checkbox-mock\\\" />',\\n            props: ['label', 'border', 'model']\\n          },\\n          'el-checkbox-group': {\\n            template: '<div class=\\\"el-checkbox-group-mock\\\"><slot></slot></div>',\\n            props: ['model']\\n          },\\n          'el-input-number': {\\n            template: '<input type=\\\"number\\\" class=\\\"el-input-number-mock\\\" />',\\n            props: ['model', 'min']\\n          },\\n          'el-dialog': {\\n            template: '<div class=\\\"el-dialog-mock\\\" v-if=\\\"modelValue\\\"><slot></slot><slot name=\\\"footer\\\"></slot></div>',\\n            props: ['modelValue', 'title', 'width']\\n          },\\n          'el-form': {\\n            template: '<div class=\\\"el-form-mock\\\"><slot></slot></div>',\\n            props: ['model', 'labelWidth']\\n          },\\n          'el-form-item': {\\n            template: '<div class=\\\"el-form-item-mock\\\"><slot></slot></div>',\\n            props: ['label']\\n          },\\n          'el-alert': {\\n            template: '<div class=\\\"el-alert-mock\\\"><slot></slot></div>',\\n            props: ['title', 'type', 'closable']\\n          },\",\"originTextLength\":1139,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768901720816},{\"originRange\":{\"start\":{\"line\":114,\"character\":0},\"end\":{\"line\":129,\"character\":12}},\"modifyRange\":{\"start\":{\"line\":114,\"character\":0},\"end\":{\"line\":129,\"character\":12}},\"action\":\"None\",\"isLine\":false,\"originText\":\"          \\\\'el-progress\\\\': {\\\\n            template: \\\\'<div class=\\\\\\\"el-progress-mock\\\\\\\"></div>\\\\',\\\\n            props: [\\\\'percentage\\\\', \\\\'strokeWidth\\\\']\\\\n          },\\\\n          \\\\'el-table\\\\': {\\\\n            template: \\\\'<div class=\\\\\\\"el-table-mock\\\\\\\"><slot></slot></div>\\\\',\\\\n            props: [\\\\'data\\\\', \\\\'style\\\\']\\\\n          },\\\\n          \\\\'el-table-column\\\\': {\\\\n            template: \\\\'<div class=\\\\\\\"el-table-column-mock\\\\\\\"></div>\\\\',\\\\n            props: [\\\\'prop\\\\', \\\\'label\\\\', \\\\'width\\\\']\\\\n          },\\\\n          \\\\'el-tag\\\\': {\\\\n            template: \\\\'<span class=\\\\\\\"el-tag-mock\\\\\\\"><slot></slot></span>\\\\',\\\\n            props: [\\\\'type\\\\']\\\\n          },\",\"originAcceptText\":\"          'el-progress': {\\n            template: '<div class=\\\"el-progress-mock\\\"></div>',\\n            props: ['percentage', 'strokeWidth']\\n          },\\n          'el-table': {\\n            template: '<div class=\\\"el-table-mock\\\"><slot></slot></div>',\\n            props: ['data', 'style']\\n          },\\n          'el-table-column': {\\n            template: '<div class=\\\"el-table-column-mock\\\"></div>',\\n            props: ['prop', 'label', 'width']\\n          },\\n          'el-tag': {\\n            template: '<span class=\\\"el-tag-mock\\\"><slot></slot></span>',\\n            props: ['type']\\n          },\",\"originTextLength\":587,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768901826032},{\"originRange\":{\"start\":{\"line\":210,\"character\":0},\"end\":{\"line\":210,\"character\":26}},\"modifyRange\":{\"start\":{\"line\":210,\"character\":0},\"end\":{\"line\":210,\"character\":26}},\"action\":\"None\",\"isLine\":false,\"originText\":\"    it(\\\\'应该包含收入指标\\\\', () => {\",\"originAcceptText\":\"    it('应该包含收入指标', () => {\",\"originTextLength\":26,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768902648119},{\"originRange\":{\"start\":{\"line\":212,\"character\":0},\"end\":{\"line\":213,\"character\":41}},\"modifyRange\":{\"start\":{\"line\":212,\"character\":0},\"end\":{\"line\":213,\"character\":41}},\"action\":\"None\",\"isLine\":false,\"originText\":\"      const revenueMetric = wrapper.vm.coreMetrics.find((m: any) => m.key === \\\\'revenue\\\\')\\\\n      expect(revenueMetric).toBeDefined()\",\"originAcceptText\":\"      const revenueMetric = wrapper.vm.coreMetrics.find((m: any) => m.key === 'revenue')\\n      expect(revenueMetric).toBeDefined()\",\"originTextLength\":130,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768902648179},{\"originRange\":{\"start\":{\"line\":228,\"character\":0},\"end\":{\"line\":228,\"character\":27}},\"modifyRange\":{\"start\":{\"line\":228,\"character\":0},\"end\":{\"line\":228,\"character\":27}},\"action\":\"None\",\"isLine\":false,\"originText\":\"    it(\\\\'应该包含满意度指标\\\\', () => {\",\"originAcceptText\":\"    it('应该包含满意度指标', () => {\",\"originTextLength\":27,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768902648228},{\"originRange\":{\"start\":{\"line\":230,\"character\":0},\"end\":{\"line\":231,\"character\":46}},\"modifyRange\":{\"start\":{\"line\":230,\"character\":0},\"end\":{\"line\":231,\"character\":46}},\"action\":\"None\",\"isLine\":false,\"originText\":\"      const satisfactionMetric = wrapper.vm.coreMetrics.find((m: any) => m.key === \\\\'satisfaction\\\\')\\\\n      expect(satisfactionMetric).toBeDefined()\",\"originAcceptText\":\"      const satisfactionMetric = wrapper.vm.coreMetrics.find((m: any) => m.key === 'satisfaction')\\n      expect(satisfactionMetric).toBeDefined()\",\"originTextLength\":145,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768902648265}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/components/analytics/AlertSystem.vue": "[{\"originRange\":{\"start\":{\"line\":164,\"character\":0},\"end\":{\"line\":165,\"character\":25}},\"modifyRange\":{\"start\":{\"line\":164,\"character\":0},\"end\":{\"line\":165,\"character\":25}},\"action\":\"None\",\"isLine\":false,\"originText\":\"                />\\\\n              </template>\",\"originAcceptText\":\"                />\\n              </template>\",\"originTextLength\":44,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768901909777}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/docs/YYC3-Cater-Platform-%E6%96%87%E6%A1%A3%E9%97%AD%E7%8E%AF/YYC3-Cater-%E9%9C%80%E6%B1%82%E8%AE%BE%E8%AE%A1%E6%96%87%E6%A1%A3/%E5%AE%A2%E6%88%B7%E7%94%9F%E5%91%BD%E5%91%A8%E6%9C%9F%E7%AE%A1%E7%90%86%E5%8A%9F%E8%83%BD%E6%A8%A1%E5%9D%97%E9%9C%80%E6%B1%82%E5%88%86%E6%9E%90%E4%B8%8E%E8%AE%BE%E8%AE%A1%E6%96%87%E6%A1%A3.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":1214,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":1214,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# 客户生命周期管理功能模块需求分析与设计文档\\\\n\\\\n## 一、模块概述\\\\n\\\\n### 1.1 模块简介\\\\n客户生命周期管理是YYC³餐饮管理系统的核心客户关系管理（CRM）功能，通过科学的客户阶段划分、智能流转规则、价值评估模型和预警机制，实现客户全生命周期的精细化管理，提升客户满意度和忠诚度。\\\\n\\\\n### 1.2 业务价值\\\\n- 提升客户留存率15-20%\\\\n- 提高客户生命周期价值（CLV）25-30%\\\\n- 降低客户流失率10-15%\\\\n- 优化营销资源投入效率\\\\n- 实现个性化客户服务\\\\n\\\\n### 1.3 目标用户\\\\n- 店长/运营经理：查看客户生命周期数据，制定营销策略\\\\n- 客服人员：接收智能提醒，进行客户关怀\\\\n- 营销人员：基于客户分群进行精准营销\\\\n- 管理层：监控客户生命周期指标，决策支持\\\\n\\\\n## 二、客户生命周期阶段划分标准\\\\n\\\\n### 2.1 生命周期阶段定义\\\\n\\\\n#### 2.1.1 潜在客户（Potential）\\\\n**定义**：尚未完成首次消费的客户\\\\n**进入条件**：\\\\n- 注册账号但未下单\\\\n- 留存联系方式但未消费\\\\n- 参与营销活动但未转化\\\\n\\\\n**退出条件**：\\\\n- 完成首次消费 → 转为新客户\\\\n- 超过30天未转化 → 转为流失潜在客户\\\\n\\\\n**关键指标**：\\\\n- 注册天数\\\\n- 营销活动参与次数\\\\n- 互动频率\\\\n\\\\n**运营策略**：\\\\n- 新客优惠券发放\\\\n- 引导下单流程优化\\\\n- 产品推荐\\\\n\\\\n#### 2.1.2 新客户（New Customer）\\\\n**定义**：首次消费后30天内的客户\\\\n**进入条件**：\\\\n- 完成首次消费\\\\n- 消费金额 > 0\\\\n\\\\n**退出条件**：\\\\n- 消费次数 ≥ 3次 且 消费天数 ≥ 7天 → 转为活跃客户\\\\n- 超过30天未再次消费 → 转为休眠客户\\\\n\\\\n**关键指标**：\\\\n- 首次消费金额\\\\n- 首次消费时间\\\\n- 首次消费品类\\\\n- 复购意向\\\\n\\\\n**运营策略**：\\\\n- 首单感谢\\\\n- 二次消费激励\\\\n- 产品使用指导\\\\n\\\\n#### 2.1.3 活跃客户（Active）\\\\n**定义**：近30天内有消费且消费频次较高的客户\\\\n**进入条件**：\\\\n- 消费次数 ≥ 3次\\\\n- 消费天数 ≥ 7天\\\\n- 最近30天内有消费\\\\n\\\\n**退出条件**：\\\\n- 消费次数 ≥ 10次 且 累计消费金额 ≥ 2000元 → 转为忠诚客户\\\\n- 超过30天未消费 → 转为休眠客户\\\\n- RFM评分下降 → 转为价值下降客户\\\\n\\\\n**关键指标**：\\\\n- 消费频次（Frequency）\\\\n- 消费金额（Monetary）\\\\n- 最近消费时间（Recency）\\\\n- 消费品类多样性\\\\n\\\\n**运营策略**：\\\\n- 会员等级提升\\\\n- 专属优惠\\\\n- 新品优先体验\\\\n\\\\n#### 2.1.4 忠诚客户（Loyal）\\\\n**定义**：消费频次高、金额大、关系稳定的客户\\\\n**进入条件**：\\\\n- 消费次数 ≥ 10次\\\\n- 累计消费金额 ≥ 2000元\\\\n- 最近90天内有消费\\\\n- 满意度评分 ≥ 4.5\\\\n\\\\n**退出条件**：\\\\n- 超过60天未消费 → 转为流失风险客户\\\\n- 消费频次下降 → 转为活跃客户\\\\n\\\\n**关键指标**：\\\\n- 累计消费金额\\\\n- 消费频次\\\\n- 客户满意度\\\\n- 推荐意愿\\\\n\\\\n**运营策略**：\\\\n- VIP专属服务\\\\n- 生日关怀\\\\n- 定制化服务\\\\n- 积分奖励\\\\n\\\\n#### 2.1.5 休眠客户（Dormant）\\\\n**定义**：曾经消费但近期未消费的客户\\\\n**进入条件**：\\\\n- 活跃客户超过30天未消费\\\\n- 新客户超过30天未再次消费\\\\n- 忠诚客户超过60天未消费\\\\n\\\\n**退出条件**：\\\\n- 重新消费 → 转为活跃客户\\\\n- 超过90天未消费 → 转为流失客户\\\\n\\\\n**关键指标**：\\\\n- 休眠天数\\\\n- 历史消费频次\\\\n- 历史消费金额\\\\n- 唤醒难度\\\\n\\\\n**运营策略**：\\\\n- 唤醒优惠券\\\\n- 个性化推荐\\\\n- 主动关怀电话\\\\n\\\\n#### 2.1.6 流失客户（Churned）\\\\n**定义**：超过90天未消费且无互动的客户\\\\n**进入条件**：\\\\n- 休眠客户超过90天未消费\\\\n- 多次唤醒尝试失败\\\\n\\\\n**退出条件**：\\\\n- 重新消费 → 转为新客户（重新计算生命周期）\\\\n\\\\n**关键指标**：\\\\n- 流失天数\\\\n- 流失原因\\\\n- 挽回成本\\\\n\\\\n**运营策略**：\\\\n- 流失原因调研\\\\n- 重新获取策略\\\\n- 防止再次流失\\\\n\\\\n### 2.2 客户价值等级划分\\\\n\\\\n#### 2.2.1 普通客户（Regular）\\\\n- RFM评分：1-3分\\\\n- 消费频次：1-3次/月\\\\n- 消费金额：< 500元/月\\\\n\\\\n#### 2.2.2 会员客户（Member）\\\\n- RFM评分：4-6分\\\\n- 消费频次：4-6次/月\\\\n- 消费金额：500-1000元/月\\\\n\\\\n#### 2.2.3 VIP客户（VIP）\\\\n- RFM评分：7-9分\\\\n- 消费频次：≥ 7次/月\\\\n- 消费金额：≥ 1000元/月\\\\n\\\\n### 2.3 客户分群维度\\\\n\\\\n#### 2.3.1 高价值客户\\\\n- 累计消费金额前20%\\\\n- 消费频次前20%\\\\n- RFM评分 ≥ 7分\\\\n\\\\n#### 2.3.2 高频客户\\\\n- 消费频次前30%\\\\n- 月均消费次数 ≥ 5次\\\\n\\\\n#### 2.3.3 新客户\\\\n- 注册时间 ≤ 30天\\\\n- 消费次数 ≤ 3次\\\\n\\\\n#### 2.3.4 流失风险客户\\\\n- 最近消费时间 > 30天\\\\n- 消费频次下降 > 50%\\\\n- 满意度评分 < 3.5\\\\n\\\\n#### 2.3.5 忠诚客户\\\\n- 消费频次 ≥ 8次/月\\\\n- 客户时长 ≥ 6个月\\\\n- 满意度评分 ≥ 4.5\\\\n\\\\n#### 2.3.6 休眠客户\\\\n- 最近消费时间 > 30天\\\\n- 历史消费次数 ≥ 3次\\\\n\\\\n## 三、客户生命周期自动流转规则引擎\\\\n\\\\n### 3.1 规则引擎架构\\\\n\\\\n#### 3.1.1 规则定义\\\\n```typescript\\\\ninterface LifecycleRule {\\\\n  id: string\\\\n  name: string\\\\n  description: string\\\\n  fromStage: string[]\\\\n  toStage: string\\\\n  conditions: RuleCondition[]\\\\n  priority: number\\\\n  enabled: boolean\\\\n  createdAt: Date\\\\n  updatedAt: Date\\\\n}\\\\n\\\\ninterface RuleCondition {\\\\n  field: string\\\\n  operator: \\\\'eq\\\\' | \\\\'ne\\\\' | \\\\'gt\\\\' | \\\\'lt\\\\' | \\\\'gte\\\\' | \\\\'lte\\\\' | \\\\'in\\\\' | \\\\'not_in\\\\'\\\\n  value: any\\\\n  logicalOperator?: \\\\'AND\\\\' | \\\\'OR\\\\'\\\\n}\\\\n```\\\\n\\\\n#### 3.1.2 规则执行流程\\\\n1. **触发事件**：客户数据变更（消费、注册、互动等）\\\\n2. **规则匹配**：根据当前阶段筛选适用规则\\\\n3. **条件评估**：评估规则条件是否满足\\\\n4. **优先级排序**：按优先级排序匹配的规则\\\\n5. **规则执行**：执行最高优先级规则\\\\n6. **状态更新**：更新客户生命周期阶段\\\\n7. **事件通知**：发送通知给相关人员\\\\n8. **日志记录**：记录流转历史\\\\n\\\\n### 3.2 预置流转规则\\\\n\\\\n#### 3.2.1 潜在客户 → 新客户\\\\n```\\\\n规则ID: RULE_001\\\\n优先级: 1\\\\n条件:\\\\n  - 首次消费时间 不为空\\\\n  - 消费金额 > 0\\\\n动作:\\\\n  - 更新生命周期阶段为 \\\\'new_customer\\\\'\\\\n  - 发送欢迎消息\\\\n  - 发放新客优惠券\\\\n```\\\\n\\\\n#### 3.2.2 新客户 → 活跃客户\\\\n```\\\\n规则ID: RULE_002\\\\n优先级: 2\\\\n条件:\\\\n  - 消费次数 >= 3\\\\n  - 消费天数 >= 7\\\\n  - 最近消费时间 <= 30天前\\\\n动作:\\\\n  - 更新生命周期阶段为 \\\\'active\\\\'\\\\n  - 发送会员升级提醒\\\\n  - 推荐热门商品\\\\n```\\\\n\\\\n#### 3.2.3 活跃客户 → 忠诚客户\\\\n```\\\\n规则ID: RULE_003\\\\n优先级: 3\\\\n条件:\\\\n  - 消费次数 >= 10\\\\n  - 累计消费金额 >= 2000\\\\n  - 最近消费时间 <= 90天前\\\\n  - 满意度评分 >= 4.5\\\\n动作:\\\\n  - 更新生命周期阶段为 \\\\'loyal\\\\'\\\\n  - 升级为VIP客户\\\\n  - 发放VIP专属权益\\\\n  - 通知店长\\\\n```\\\\n\\\\n#### 3.2.4 活跃客户 → 休眠客户\\\\n```\\\\n规则ID: RULE_004\\\\n优先级: 4\\\\n条件:\\\\n  - 最近消费时间 > 30天前\\\\n  - 当前阶段为 \\\\'active\\\\'\\\\n动作:\\\\n  - 更新生命周期阶段为 \\\\'dormant\\\\'\\\\n  - 发送唤醒优惠券\\\\n  - 设置流失预警\\\\n```\\\\n\\\\n#### 3.2.5 忠诚客户 → 休眠客户\\\\n```\\\\n规则ID: RULE_005\\\\n优先级: 5\\\\n条件:\\\\n  - 最近消费时间 > 60天前\\\\n  - 当前阶段为 \\\\'loyal\\\\'\\\\n动作:\\\\n  - 更新生命周期阶段为 \\\\'dormant\\\\'\\\\n  - 发送专属唤醒优惠\\\\n  - 安排客服回访\\\\n```\\\\n\\\\n#### 3.2.6 休眠客户 → 流失客户\\\\n```\\\\n规则ID: RULE_006\\\\n优先级: 6\\\\n条件:\\\\n  - 最近消费时间 > 90天前\\\\n  - 当前阶段为 \\\\'dormant\\\\'\\\\n  - 唤醒尝试次数 >= 3\\\\n动作:\\\\n  - 更新生命周期阶段为 \\\\'churned\\\\'\\\\n  - 标记为流失客户\\\\n  - 生成流失分析报告\\\\n```\\\\n\\\\n#### 3.2.7 休眠客户 → 活跃客户\\\\n```\\\\n规则ID: RULE_007\\\\n优先级: 7\\\\n条件:\\\\n  - 当前阶段为 \\\\'dormant\\\\'\\\\n  - 产生新消费\\\\n动作:\\\\n  - 更新生命周期阶段为 \\\\'active\\\\'\\\\n  - 发送欢迎回归消息\\\\n  - 推荐新品\\\\n```\\\\n\\\\n### 3.3 规则引擎实现\\\\n\\\\n#### 3.3.1 规则引擎核心类\\\\n```typescript\\\\nclass LifecycleRuleEngine {\\\\n  private rules: LifecycleRule[]\\\\n  private eventBus: EventBus\\\\n\\\\n  constructor(rules: LifecycleRule[]) {\\\\n    this.rules = rules.sort((a, b) => b.priority - a.priority)\\\\n    this.eventBus = new EventBus()\\\\n  }\\\\n\\\\n  async evaluate(customer: Customer, event: CustomerEvent): Promise<RuleResult[]> {\\\\n    const applicableRules = this.rules.filter(rule =>\\\\n      rule.fromStage.includes(customer.lifecycleStage) && rule.enabled\\\\n    )\\\\n\\\\n    const results: RuleResult[] = []\\\\n    for (const rule of applicableRules) {\\\\n      if (await this.evaluateConditions(rule.conditions, customer, event)) {\\\\n        results.push({\\\\n          rule,\\\\n          matched: true,\\\\n          timestamp: new Date()\\\\n        })\\\\n      }\\\\n    }\\\\n\\\\n    return results.sort((a, b) => b.rule.priority - a.rule.priority)\\\\n  }\\\\n\\\\n  private async evaluateConditions(\\\\n    conditions: RuleCondition[],\\\\n    customer: Customer,\\\\n    event: CustomerEvent\\\\n  ): Promise<boolean> {\\\\n    let result = true\\\\n    let currentOperator: \\\\'AND\\\\' | \\\\'OR\\\\' = \\\\'AND\\\\'\\\\n\\\\n    for (const condition of conditions) {\\\\n      const conditionResult = this.evaluateCondition(condition, customer, event)\\\\n      currentOperator = condition.logicalOperator || \\\\'AND\\\\'\\\\n\\\\n      if (currentOperator === \\\\'AND\\\\') {\\\\n        result = result && conditionResult\\\\n      } else {\\\\n        result = result || conditionResult\\\\n      }\\\\n    }\\\\n\\\\n    return result\\\\n  }\\\\n\\\\n  private evaluateCondition(\\\\n    condition: RuleCondition,\\\\n    customer: Customer,\\\\n    event: CustomerEvent\\\\n  ): boolean {\\\\n    const fieldValue = this.getFieldValue(condition.field, customer, event)\\\\n\\\\n    switch (condition.operator) {\\\\n      case \\\\'eq\\\\':\\\\n        return fieldValue === condition.value\\\\n      case \\\\'ne\\\\':\\\\n        return fieldValue !== condition.value\\\\n      case \\\\'gt\\\\':\\\\n        return fieldValue > condition.value\\\\n      case \\\\'lt\\\\':\\\\n        return fieldValue < condition.value\\\\n      case \\\\'gte\\\\':\\\\n        return fieldValue >= condition.value\\\\n      case \\\\'lte\\\\':\\\\n        return fieldValue <= condition.value\\\\n      case \\\\'in\\\\':\\\\n        return Array.isArray(condition.value) && condition.value.includes(fieldValue)\\\\n      case \\\\'not_in\\\\':\\\\n        return Array.isArray(condition.value) && !condition.value.includes(fieldValue)\\\\n      default:\\\\n        return false\\\\n    }\\\\n  }\\\\n\\\\n  private getFieldValue(field: string, customer: Customer, event: CustomerEvent): any {\\\\n    const fieldPath = field.split(\\\\'.\\\\')\\\\n    let value: any = { ...customer, ...event }\\\\n\\\\n    for (const key of fieldPath) {\\\\n      value = value?.[key]\\\\n    }\\\\n\\\\n    return value\\\\n  }\\\\n}\\\\n```\\\\n\\\\n## 四、客户价值评估模型（RFM）\\\\n\\\\n### 4.1 RFM模型概述\\\\n\\\\nRFM模型是客户价值评估的经典方法，通过三个维度对客户进行评分：\\\\n- **R（Recency）**：最近一次消费时间\\\\n- **F（Frequency）**：消费频次\\\\n- **M（Monetary）**：消费金额\\\\n\\\\n### 4.2 RFM评分标准\\\\n\\\\n#### 4.2.1 R评分（最近消费时间）\\\\n| 分数 | 最近消费时间 |\\\\n|------|-------------|\\\\n| 5分 | 0-7天 |\\\\n| 4分 | 8-14天 |\\\\n| 3分 | 15-30天 |\\\\n| 2分 | 31-60天 |\\\\n| 1分 | >60天 |\\\\n\\\\n#### 4.2.2 F评分（消费频次）\\\\n| 分数 | 月均消费次数 |\\\\n|------|-------------|\\\\n| 5分 | ≥ 8次 |\\\\n| 4分 | 5-7次 |\\\\n| 3分 | 3-4次 |\\\\n| 2分 | 1-2次 |\\\\n| 1分 | 0次 |\\\\n\\\\n#### 4.2.3 M评分（消费金额）\\\\n| 分数 | 月均消费金额 |\\\\n|------|-------------|\\\\n| 5分 | ≥ 1000元 |\\\\n| 4分 | 500-999元 |\\\\n| 3分 | 300-499元 |\\\\n| 2分 | 100-299元 |\\\\n| 1分 | < 100元 |\\\\n\\\\n### 4.3 RFM总分计算\\\\n\\\\n#### 4.3.1 计算公式\\\\n```\\\\nRFM总分 = R评分 × 0.3 + F评分 × 0.4 + M评分 × 0.3\\\\n```\\\\n\\\\n#### 4.3.2 客户价值分级\\\\n| RFM总分 | 客户等级 | 占比 |\\\\n|---------|----------|------|\\\\n| 4.5-5.0 | 超级VIP | 5% |\\\\n| 3.5-4.4 | VIP | 15% |\\\\n| 2.5-3.4 | 会员 | 30% |\\\\n| 1.5-2.4 | 普通 | 40% |\\\\n| 0-1.4 | 低价值 | 10% |\\\\n\\\\n### 4.4 RFM模型实现\\\\n\\\\n```typescript\\\\ninterface RFMScore {\\\\n  recencyScore: number\\\\n  frequencyScore: number\\\\n  monetaryScore: number\\\\n  totalScore: number\\\\n  customerLevel: string\\\\n}\\\\n\\\\nclass RFMModel {\\\\n  calculateRFMScore(customer: Customer): RFMScore {\\\\n    const recencyScore = this.calculateRecencyScore(customer.lastOrderDate)\\\\n    const frequencyScore = this.calculateFrequencyScore(customer.orderCount)\\\\n    const monetaryScore = this.calculateMonetaryScore(customer.totalSpent)\\\\n\\\\n    const totalScore =\\\\n      recencyScore * 0.3 +\\\\n      frequencyScore * 0.4 +\\\\n      monetaryScore * 0.3\\\\n\\\\n    return {\\\\n      recencyScore,\\\\n      frequencyScore,\\\\n      monetaryScore,\\\\n      totalScore: Math.round(totalScore * 10) / 10,\\\\n      customerLevel: this.getCustomerLevel(totalScore)\\\\n    }\\\\n  }\\\\n\\\\n  private calculateRecencyScore(lastOrderDate: Date | null): number {\\\\n    if (!lastOrderDate) return 1\\\\n\\\\n    const daysSinceLastOrder = Math.floor(\\\\n      (Date.now() - new Date(lastOrderDate).getTime()) / (1000 * 60 * 60 * 24)\\\\n    )\\\\n\\\\n    if (daysSinceLastOrder <= 7) return 5\\\\n    if (daysSinceLastOrder <= 14) return 4\\\\n    if (daysSinceLastOrder <= 30) return 3\\\\n    if (daysSinceLastOrder <= 60) return 2\\\\n    return 1\\\\n  }\\\\n\\\\n  private calculateFrequencyScore(orderCount: number): number {\\\\n    const monthlyOrders = orderCount / 12\\\\n\\\\n    if (monthlyOrders >= 8) return 5\\\\n    if (monthlyOrders >= 5) return 4\\\\n    if (monthlyOrders >= 3) return 3\\\\n    if (monthlyOrders >= 1) return 2\\\\n    return 1\\\\n  }\\\\n\\\\n  private calculateMonetaryScore(totalSpent: number): number {\\\\n    const monthlySpent = totalSpent / 12\\\\n\\\\n    if (monthlySpent >= 1000) return 5\\\\n    if (monthlySpent >= 500) return 4\\\\n    if (monthlySpent >= 300) return 3\\\\n    if (monthlySpent >= 100) return 2\\\\n    return 1\\\\n  }\\\\n\\\\n  private getCustomerLevel(totalScore: number): string {\\\\n    if (totalScore >= 4.5) return \\\\'super_vip\\\\'\\\\n    if (totalScore >= 3.5) return \\\\'vip\\\\'\\\\n    if (totalScore >= 2.5) return \\\\'member\\\\'\\\\n    if (totalScore >= 1.5) return \\\\'regular\\\\'\\\\n    return \\\\'low_value\\\\'\\\\n  }\\\\n}\\\\n```\\\\n\\\\n## 五、智能客户关怀提醒功能\\\\n\\\\n### 5.1 关怀场景设计\\\\n\\\\n#### 5.1.1 新客户关怀\\\\n**触发时机**：客户首次消费后24小时内\\\\n**关怀内容**：\\\\n- 感谢首次消费\\\\n- 介绍会员权益\\\\n- 发放新客优惠券\\\\n- 推荐热门商品\\\\n\\\\n#### 5.1.2 生日关怀\\\\n**触发时机**：客户生日当天\\\\n**关怀内容**：\\\\n- 生日祝福\\\\n- 生日专属优惠券\\\\n- 免费赠送小礼品\\\\n- 邀请亲友同享优惠\\\\n\\\\n#### 5.1.3 节日关怀\\\\n**触发时机**：重要节日（春节、中秋、国庆等）\\\\n**关怀内容**：\\\\n- 节日祝福\\\\n- 节日专属优惠\\\\n- 节日特色菜品推荐\\\\n\\\\n#### 5.1.4 消费频次下降提醒\\\\n**触发时机**：客户消费频次下降超过50%\\\\n**关怀内容**：\\\\n- 询问是否有问题\\\\n- 提供专属优惠\\\\n- 推荐新品\\\\n\\\\n#### 5.1.5 长期未消费提醒\\\\n**触发时机**：客户30天未消费\\\\n**关怀内容**：\\\\n- 表达关心\\\\n- 发放唤醒优惠券\\\\n- 推荐近期优惠活动\\\\n\\\\n#### 5.1.6 VIP客户专属关怀\\\\n**触发时机**：VIP客户每月定期\\\\n**关怀内容**：\\\\n- 专属客服对接\\\\n- 新品优先体验\\\\n- 定制化服务\\\\n- 积分奖励\\\\n\\\\n### 5.2 关怀提醒规则\\\\n\\\\n```typescript\\\\ninterface CareReminderRule {\\\\n  id: string\\\\n  name: string\\\\n  triggerType: \\\\'event\\\\' | \\\\'schedule\\\\' | \\\\'condition\\\\'\\\\n  triggerCondition: any\\\\n  careType: string\\\\n  contentTemplate: string\\\\n  channels: string[]\\\\n  priority: number\\\\n  enabled: boolean\\\\n}\\\\n\\\\nconst careReminderRules: CareReminderRule[] = [\\\\n  {\\\\n    id: \\\\'CARE_001\\\\',\\\\n    name: \\\\'新客户关怀\\\\',\\\\n    triggerType: \\\\'event\\\\',\\\\n    triggerCondition: { eventType: \\\\'first_order\\\\', hoursAfter: 24 },\\\\n    careType: \\\\'welcome\\\\',\\\\n    contentTemplate: \\\\'感谢您首次光临！\\\\',\\\\n    channels: [\\\\'sms\\\\', \\\\'push\\\\'],\\\\n    priority: 1,\\\\n    enabled: true\\\\n  },\\\\n  {\\\\n    id: \\\\'CARE_002\\\\',\\\\n    name: \\\\'生日关怀\\\\',\\\\n    triggerType: \\\\'schedule\\\\',\\\\n    triggerCondition: { schedule: \\\\'birthday\\\\' },\\\\n    careType: \\\\'birthday\\\\',\\\\n    contentTemplate: \\\\'生日快乐！\\\\',\\\\n    channels: [\\\\'sms\\\\', \\\\'push\\\\', \\\\'email\\\\'],\\\\n    priority: 2,\\\\n    enabled: true\\\\n  },\\\\n  {\\\\n    id: \\\\'CARE_003\\\\',\\\\n    name: \\\\'消费频次下降提醒\\\\',\\\\n    triggerType: \\\\'condition\\\\',\\\\n    triggerCondition: {\\\\n      field: \\\\'orderFrequencyChange\\\\',\\\\n      operator: \\\\'lt\\\\',\\\\n      value: -0.5\\\\n    },\\\\n    careType: \\\\'frequency_drop\\\\',\\\\n    contentTemplate: \\\\'最近很少见到您\\\\',\\\\n    channels: [\\\\'sms\\\\', \\\\'push\\\\'],\\\\n    priority: 3,\\\\n    enabled: true\\\\n  },\\\\n  {\\\\n    id: \\\\'CARE_004\\\\',\\\\n    name: \\\\'长期未消费提醒\\\\',\\\\n    triggerType: \\\\'condition\\\\',\\\\n    triggerCondition: {\\\\n      field: \\\\'daysSinceLastOrder\\\\',\\\\n      operator: \\\\'gte\\\\',\\\\n      value: 30\\\\n    },\\\\n    careType: \\\\'inactive\\\\',\\\\n    contentTemplate: \\\\'好久不见\\\\',\\\\n    channels: [\\\\'sms\\\\', \\\\'push\\\\', \\\\'email\\\\'],\\\\n    priority: 4,\\\\n    enabled: true\\\\n  }\\\\n]\\\\n```\\\\n\\\\n### 5.3 关怀提醒引擎\\\\n\\\\n```typescript\\\\nclass CareReminderEngine {\\\\n  private rules: CareReminderRule[]\\\\n  private notificationService: NotificationService\\\\n\\\\n  constructor(rules: CareReminderRule[]) {\\\\n    this.rules = rules\\\\n    this.notificationService = new NotificationService()\\\\n  }\\\\n\\\\n  async processCustomerEvent(customer: Customer, event: CustomerEvent): Promise<void> {\\\\n    for (const rule of this.rules) {\\\\n      if (!rule.enabled) continue\\\\n\\\\n      const shouldTrigger = await this.evaluateTrigger(rule, customer, event)\\\\n      if (shouldTrigger) {\\\\n        await this.sendCareReminder(customer, rule)\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  private async evaluateTrigger(\\\\n    rule: CareReminderRule,\\\\n    customer: Customer,\\\\n    event: CustomerEvent\\\\n  ): Promise<boolean> {\\\\n    switch (rule.triggerType) {\\\\n      case \\\\'event\\\\':\\\\n        return this.evaluateEventTrigger(rule.triggerCondition, event)\\\\n      case \\\\'schedule\\\\':\\\\n        return this.evaluateScheduleTrigger(rule.triggerCondition, customer)\\\\n      case \\\\'condition\\\\':\\\\n        return this.evaluateConditionTrigger(rule.triggerCondition, customer)\\\\n      default:\\\\n        return false\\\\n    }\\\\n  }\\\\n\\\\n  private async sendCareReminder(\\\\n    customer: Customer,\\\\n    rule: CareReminderRule\\\\n  ): Promise<void> {\\\\n    const content = this.generateContent(rule.contentTemplate, customer)\\\\n\\\\n    for (const channel of rule.channels) {\\\\n      await this.notificationService.send({\\\\n        channel,\\\\n        recipient: customer,\\\\n        content,\\\\n        type: rule.careType\\\\n      })\\\\n    }\\\\n\\\\n    await this.logCareReminder(customer.id, rule.id, content)\\\\n  }\\\\n\\\\n  private generateContent(template: string, customer: Customer): string {\\\\n    return template\\\\n      .replace(\\\\'{name}\\\\', customer.name)\\\\n      .replace(\\\\'{level}\\\\', customer.level)\\\\n      .replace(\\\\'{lastOrderDate}\\\\', formatDate(customer.lastOrderDate))\\\\n  }\\\\n}\\\\n```\\\\n\\\\n## 六、客户流失预警机制\\\\n\\\\n### 6.1 流失预警指标\\\\n\\\\n#### 6.1.1 行为指标\\\\n- 最近消费时间 > 30天\\\\n- 消费频次下降 > 50%\\\\n- 消费金额下降 > 50%\\\\n- 互动频率下降 > 60%\\\\n- 满意度评分 < 3.5\\\\n\\\\n#### 6.1.2 预警等级\\\\n\\\\n| 等级 | 颜色 | 条件 | 处理时效 |\\\\n|------|------|------|----------|\\\\n| 高危 | 红色 | 最近消费 > 60天 且 消费频次下降 > 70% | 24小时内 |\\\\n| 中危 | 橙色 | 最近消费 > 45天 或 消费频次下降 > 50% | 48小时内 |\\\\n| 低危 | 黄色 | 最近消费 > 30天 或 消费频次下降 > 30% | 72小时内 |\\\\n\\\\n### 6.2 流失预测模型\\\\n\\\\n```typescript\\\\ninterface ChurnPrediction {\\\\n  customerId: string\\\\n  churnProbability: number\\\\n  riskLevel: \\\\'high\\\\' | \\\\'medium\\\\' | \\\\'low\\\\'\\\\n  riskFactors: string[]\\\\n  predictedChurnDate: Date\\\\n  recommendations: string[]\\\\n}\\\\n\\\\nclass ChurnPredictionModel {\\\\n  predictChurn(customer: Customer): ChurnPrediction {\\\\n    const riskFactors: string[] = []\\\\n    let churnProbability = 0\\\\n\\\\n    if (this.isInactive(customer, 30)) {\\\\n      churnProbability += 0.2\\\\n      riskFactors.push(\\\\'30天未消费\\\\')\\\\n    }\\\\n\\\\n    if (this.isInactive(customer, 60)) {\\\\n      churnProbability += 0.3\\\\n      riskFactors.push(\\\\'60天未消费\\\\')\\\\n    }\\\\n\\\\n    if (this.hasFrequencyDrop(customer, 0.5)) {\\\\n      churnProbability += 0.25\\\\n      riskFactors.push(\\\\'消费频次下降50%\\\\')\\\\n    }\\\\n\\\\n    if (this.hasSpendingDrop(customer, 0.5)) {\\\\n      churnProbability += 0.15\\\\n      riskFactors.push(\\\\'消费金额下降50%\\\\')\\\\n    }\\\\n\\\\n    if (customer.satisfactionScore < 3.5) {\\\\n      churnProbability += 0.1\\\\n      riskFactors.push(\\\\'满意度低\\\\')\\\\n    }\\\\n\\\\n    churnProbability = Math.min(churnProbability, 1.0)\\\\n\\\\n    return {\\\\n      customerId: customer.id,\\\\n      churnProbability,\\\\n      riskLevel: this.getRiskLevel(churnProbability),\\\\n      riskFactors,\\\\n      predictedChurnDate: this.predictChurnDate(churnProbability),\\\\n      recommendations: this.generateRecommendations(riskFactors)\\\\n    }\\\\n  }\\\\n\\\\n  private isInactive(customer: Customer, days: number): boolean {\\\\n    if (!customer.lastOrderDate) return true\\\\n    const daysSinceLastOrder = Math.floor(\\\\n      (Date.now() - new Date(customer.lastOrderDate).getTime()) / (1000 * 60 * 60 * 24)\\\\n    )\\\\n    return daysSinceLastOrder > days\\\\n  }\\\\n\\\\n  private hasFrequencyDrop(customer: Customer, threshold: number): boolean {\\\\n    const currentFrequency = this.calculateMonthlyFrequency(customer, 30)\\\\n    const previousFrequency = this.calculateMonthlyFrequency(customer, 90)\\\\n    return currentFrequency < previousFrequency * (1 - threshold)\\\\n  }\\\\n\\\\n  private hasSpendingDrop(customer: Customer, threshold: number): boolean {\\\\n    const currentSpending = this.calculateMonthlySpending(customer, 30)\\\\n    const previousSpending = this.calculateMonthlySpending(customer, 90)\\\\n    return currentSpending < previousSpending * (1 - threshold)\\\\n  }\\\\n\\\\n  private getRiskLevel(probability: number): \\\\'high\\\\' | \\\\'medium\\\\' | \\\\'low\\\\' {\\\\n    if (probability >= 0.7) return \\\\'high\\\\'\\\\n    if (probability >= 0.4) return \\\\'medium\\\\'\\\\n    return \\\\'low\\\\'\\\\n  }\\\\n\\\\n  private predictChurnDate(probability: number): Date {\\\\n    const daysToChurn = Math.floor(90 * (1 - probability))\\\\n    return new Date(Date.now() + daysToChurn * 24 * 60 * 60 * 1000)\\\\n  }\\\\n\\\\n  private generateRecommendations(riskFactors: string[]): string[] {\\\\n    const recommendations: string[] = []\\\\n\\\\n    if (riskFactors.includes(\\\\'30天未消费\\\\')) {\\\\n      recommendations.push(\\\\'发送唤醒优惠券\\\\')\\\\n      recommendations.push(\\\\'安排客服回访\\\\')\\\\n    }\\\\n\\\\n    if (riskFactors.includes(\\\\'消费频次下降50%\\\\')) {\\\\n      recommendations.push(\\\\'了解消费下降原因\\\\')\\\\n      recommendations.push(\\\\'提供专属优惠\\\\')\\\\n    }\\\\n\\\\n    if (riskFactors.includes(\\\\'满意度低\\\\')) {\\\\n      recommendations.push(\\\\'安排满意度调研\\\\')\\\\n      recommendations.push(\\\\'改进服务质量\\\\')\\\\n    }\\\\n\\\\n    return recommendations\\\\n  }\\\\n}\\\\n```\\\\n\\\\n### 6.3 流失预警处理流程\\\\n\\\\n1. **预警触发**：系统自动检测到流失风险\\\\n2. **预警评估**：计算流失概率和风险等级\\\\n3. **预警通知**：发送通知给店长和客服\\\\n4. **任务分配**：自动分配给相应客服人员\\\\n5. **客户回访**：客服人员主动联系客户\\\\n6. **问题解决**：了解问题并提供解决方案\\\\n7. **效果跟踪**：记录处理结果和客户反馈\\\\n8. **持续监控**：持续监控客户状态\\\\n\\\\n## 七、生命周期数据分析看板\\\\n\\\\n### 7.1 看板布局设计\\\\n\\\\n#### 7.1.1 顶部指标卡片\\\\n- 总客户数\\\\n- 活跃客户数\\\\n- 流失客户数\\\\n- 客户留存率\\\\n- 平均生命周期价值（CLV）\\\\n- 客户满意度\\\\n\\\\n#### 7.1.2 生命周期阶段分布图\\\\n- 饼图展示各阶段客户占比\\\\n- 环比变化趋势\\\\n- 阶段流转统计\\\\n\\\\n#### 7.1.3 客户价值分布图\\\\n- 柱状图展示RFM评分分布\\\\n- 客户等级占比\\\\n- 价值变化趋势\\\\n\\\\n#### 7.1.4 流失预警列表\\\\n- 高危流失客户\\\\n- 中危流失客户\\\\n- 低危流失客户\\\\n- 处理状态跟踪\\\\n\\\\n#### 7.1.5 关怀提醒列表\\\\n- 待处理关怀提醒\\\\n- 已完成关怀记录\\\\n- 关怀效果统计\\\\n\\\\n#### 7.1.6 客户流转趋势图\\\\n- 折线图展示阶段流转趋势\\\\n- 流入流出统计\\\\n- 转化率分析\\\\n\\\\n### 7.2 数据可视化组件\\\\n\\\\n```typescript\\\\ninterface LifecycleDashboardData {\\\\n  overview: {\\\\n    totalCustomers: number\\\\n    activeCustomers: number\\\\n    churnedCustomers: number\\\\n    retentionRate: number\\\\n    averageCLV: number\\\\n    satisfactionScore: number\\\\n  }\\\\n  stageDistribution: {\\\\n    stage: string\\\\n    count: number\\\\n    percentage: number\\\\n    change: number\\\\n  }[]\\\\n  valueDistribution: {\\\\n    level: string\\\\n    count: number\\\\n    avgRFMScore: number\\\\n  }[]\\\\n  churnAlerts: ChurnPrediction[]\\\\n  careReminders: CareReminder[]\\\\n  flowTrends: {\\\\n    date: string\\\\n    fromStage: string\\\\n    toStage: string\\\\n    count: number\\\\n  }[]\\\\n}\\\\n```\\\\n\\\\n## 八、数据模型设计\\\\n\\\\n### 8.1 客户生命周期表（customer_lifecycle）\\\\n\\\\n```sql\\\\nCREATE TABLE customer_lifecycle (\\\\n  id VARCHAR(36) PRIMARY KEY,\\\\n  customer_id VARCHAR(36) NOT NULL,\\\\n  current_stage VARCHAR(50) NOT NULL,\\\\n  previous_stage VARCHAR(50),\\\\n  stage_entered_at TIMESTAMP NOT NULL,\\\\n  stage_duration_days INT,\\\\n  total_days_in_stage INT,\\\\n  rfm_score DECIMAL(3,1),\\\\n  customer_level VARCHAR(50),\\\\n  churn_probability DECIMAL(5,2),\\\\n  risk_level VARCHAR(20),\\\\n  last_order_date TIMESTAMP,\\\\n  order_count INT,\\\\n  total_spent DECIMAL(10,2),\\\\n  satisfaction_score DECIMAL(3,1),\\\\n  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\\\\n  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,\\\\n  INDEX idx_customer_id (customer_id),\\\\n  INDEX idx_current_stage (current_stage),\\\\n  INDEX idx_churn_probability (churn_probability),\\\\n  FOREIGN KEY (customer_id) REFERENCES customers(id) ON DELETE CASCADE\\\\n);\\\\n```\\\\n\\\\n### 8.2 生命周期流转记录表（lifecycle_transitions）\\\\n\\\\n```sql\\\\nCREATE TABLE lifecycle_transitions (\\\\n  id VARCHAR(36) PRIMARY KEY,\\\\n  customer_id VARCHAR(36) NOT NULL,\\\\n  from_stage VARCHAR(50),\\\\n  to_stage VARCHAR(50) NOT NULL,\\\\n  transition_date TIMESTAMP NOT NULL,\\\\n  rule_id VARCHAR(50),\\\\n  reason TEXT,\\\\n  metadata JSON,\\\\n  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\\\\n  INDEX idx_customer_id (customer_id),\\\\n  INDEX idx_transition_date (transition_date),\\\\n  INDEX idx_to_stage (to_stage),\\\\n  FOREIGN KEY (customer_id) REFERENCES customers(id) ON DELETE CASCADE\\\\n);\\\\n```\\\\n\\\\n### 8.3 关怀提醒记录表（care_reminders）\\\\n\\\\n```sql\\\\nCREATE TABLE care_reminders (\\\\n  id VARCHAR(36) PRIMARY KEY,\\\\n  customer_id VARCHAR(36) NOT NULL,\\\\n  rule_id VARCHAR(50) NOT NULL,\\\\n  care_type VARCHAR(50) NOT NULL,\\\\n  content TEXT NOT NULL,\\\\n  channels JSON NOT NULL,\\\\n  scheduled_at TIMESTAMP NOT NULL,\\\\n  sent_at TIMESTAMP,\\\\n  status ENUM(\\\\'pending\\\\', \\\\'sent\\\\', \\\\'failed\\\\') DEFAULT \\\\'pending\\\\',\\\\n  response TEXT,\\\\n  effectiveness_score INT,\\\\n  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\\\\n  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,\\\\n  INDEX idx_customer_id (customer_id),\\\\n  INDEX idx_scheduled_at (scheduled_at),\\\\n  INDEX idx_status (status),\\\\n  FOREIGN KEY (customer_id) REFERENCES customers(id) ON DELETE CASCADE\\\\n);\\\\n```\\\\n\\\\n### 8.4 流失预警记录表（churn_alerts）\\\\n\\\\n```sql\\\\nCREATE TABLE churn_alerts (\\\\n  id VARCHAR(36) PRIMARY KEY,\\\\n  customer_id VARCHAR(36) NOT NULL,\\\\n  churn_probability DECIMAL(5,2) NOT NULL,\\\\n  risk_level VARCHAR(20) NOT NULL,\\\\n  risk_factors JSON NOT NULL,\\\\n  predicted_churn_date TIMESTAMP,\\\\n  assigned_to VARCHAR(36),\\\\n  status ENUM(\\\\'pending\\\\', \\\\'in_progress\\\\', \\\\'resolved\\\\', \\\\'closed\\\\') DEFAULT \\\\'pending\\\\',\\\\n  resolution_notes TEXT,\\\\n  resolved_at TIMESTAMP,\\\\n  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\\\\n  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,\\\\n  INDEX idx_customer_id (customer_id),\\\\n  INDEX idx_risk_level (risk_level),\\\\n  INDEX idx_status (status),\\\\n  INDEX idx_created_at (created_at),\\\\n  FOREIGN KEY (customer_id) REFERENCES customers(id) ON DELETE CASCADE,\\\\n  FOREIGN KEY (assigned_to) REFERENCES users(id) ON DELETE SET NULL\\\\n);\\\\n```\\\\n\\\\n## 九、API接口设计\\\\n\\\\n### 9.1 客户生命周期接口\\\\n\\\\n#### 9.1.1 获取客户生命周期信息\\\\n```\\\\nGET /api/v1/customers/{customerId}/lifecycle\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"id\\\\\\\": \\\\\\\"xxx\\\\\\\",\\\\n    \\\\\\\"customerId\\\\\\\": \\\\\\\"xxx\\\\\\\",\\\\n    \\\\\\\"currentStage\\\\\\\": \\\\\\\"active\\\\\\\",\\\\n    \\\\\\\"previousStage\\\\\\\": \\\\\\\"new_customer\\\\\\\",\\\\n    \\\\\\\"stageEnteredAt\\\\\\\": \\\\\\\"2024-01-01T00:00:00Z\\\\\\\",\\\\n    \\\\\\\"stageDurationDays\\\\\\\": 15,\\\\n    \\\\\\\"rfmScore\\\\\\\": {\\\\n      \\\\\\\"recencyScore\\\\\\\": 4,\\\\n      \\\\\\\"frequencyScore\\\\\\\": 3,\\\\n      \\\\\\\"monetaryScore\\\\\\\": 4,\\\\n      \\\\\\\"totalScore\\\\\\\": 3.7,\\\\n      \\\\\\\"customerLevel\\\\\\\": \\\\\\\"member\\\\\\\"\\\\n    },\\\\n    \\\\\\\"churnProbability\\\\\\\": 0.15,\\\\n    \\\\\\\"riskLevel\\\\\\\": \\\\\\\"low\\\\\\\"\\\\n  }\\\\n}\\\\n```\\\\n\\\\n#### 9.1.2 更新客户生命周期阶段\\\\n```\\\\nPOST /api/v1/customers/{customerId}/lifecycle/stage\\\\n\\\\nRequest:\\\\n{\\\\n  \\\\\\\"stage\\\\\\\": \\\\\\\"loyal\\\\\\\",\\\\n  \\\\\\\"reason\\\\\\\": \\\\\\\"达到忠诚客户标准\\\\\\\",\\\\n  \\\\\\\"ruleId\\\\\\\": \\\\\\\"RULE_003\\\\\\\"\\\\n}\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"id\\\\\\\": \\\\\\\"xxx\\\\\\\",\\\\n    \\\\\\\"customerId\\\\\\\": \\\\\\\"xxx\\\\\\\",\\\\n    \\\\\\\"currentStage\\\\\\\": \\\\\\\"loyal\\\\\\\",\\\\n    \\\\\\\"previousStage\\\\\\\": \\\\\\\"active\\\\\\\",\\\\n    \\\\\\\"transitionDate\\\\\\\": \\\\\\\"2024-01-15T00:00:00Z\\\\\\\"\\\\n  }\\\\n}\\\\n```\\\\n\\\\n#### 9.1.3 获取生命周期流转历史\\\\n```\\\\nGET /api/v1/customers/{customerId}/lifecycle/transitions?page=1&limit=10\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"items\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"id\\\\\\\": \\\\\\\"xxx\\\\\\\",\\\\n        \\\\\\\"fromStage\\\\\\\": \\\\\\\"new_customer\\\\\\\",\\\\n        \\\\\\\"toStage\\\\\\\": \\\\\\\"active\\\\\\\",\\\\n        \\\\\\\"transitionDate\\\\\\\": \\\\\\\"2024-01-10T00:00:00Z\\\\\\\",\\\\n        \\\\\\\"ruleId\\\\\\\": \\\\\\\"RULE_002\\\\\\\",\\\\n        \\\\\\\"reason\\\\\\\": \\\\\\\"达到活跃客户标准\\\\\\\"\\\\n      }\\\\n    ],\\\\n    \\\\\\\"pagination\\\\\\\": {\\\\n      \\\\\\\"total\\\\\\\": 10,\\\\n      \\\\\\\"page\\\\\\\": 1,\\\\n      \\\\\\\"limit\\\\\\\": 10,\\\\n      \\\\\\\"totalPages\\\\\\\": 1\\\\n    }\\\\n  }\\\\n}\\\\n```\\\\n\\\\n### 9.2 RFM评分接口\\\\n\\\\n#### 9.2.1 计算客户RFM评分\\\\n```\\\\nPOST /api/v1/customers/rfm/calculate\\\\n\\\\nRequest:\\\\n{\\\\n  \\\\\\\"customerIds\\\\\\\": [\\\\\\\"id1\\\\\\\", \\\\\\\"id2\\\\\\\", \\\\\\\"id3\\\\\\\"]\\\\n}\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": [\\\\n    {\\\\n      \\\\\\\"customerId\\\\\\\": \\\\\\\"id1\\\\\\\",\\\\n      \\\\\\\"recencyScore\\\\\\\": 4,\\\\n      \\\\\\\"frequencyScore\\\\\\\": 3,\\\\n      \\\\\\\"monetaryScore\\\\\\\": 4,\\\\n      \\\\\\\"totalScore\\\\\\\": 3.7,\\\\n      \\\\\\\"customerLevel\\\\\\\": \\\\\\\"member\\\\\\\"\\\\n    }\\\\n  ]\\\\n}\\\\n```\\\\n\\\\n### 9.3 关怀提醒接口\\\\n\\\\n#### 9.3.1 获取待处理关怀提醒\\\\n```\\\\nGET /api/v1/care-reminders/pending?page=1&limit=20\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"items\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"id\\\\\\\": \\\\\\\"xxx\\\\\\\",\\\\n        \\\\\\\"customerId\\\\\\\": \\\\\\\"xxx\\\\\\\",\\\\n        \\\\\\\"customerName\\\\\\\": \\\\\\\"张三\\\\\\\",\\\\n        \\\\\\\"careType\\\\\\\": \\\\\\\"birthday\\\\\\\",\\\\n        \\\\\\\"content\\\\\\\": \\\\\\\"生日快乐！\\\\\\\",\\\\n        \\\\\\\"scheduledAt\\\\\\\": \\\\\\\"2024-01-15T00:00:00Z\\\\\\\",\\\\n        \\\\\\\"status\\\\\\\": \\\\\\\"pending\\\\\\\"\\\\n      }\\\\n    ],\\\\n    \\\\\\\"pagination\\\\\\\": {\\\\n      \\\\\\\"total\\\\\\\": 50,\\\\n      \\\\\\\"page\\\\\\\": 1,\\\\n      \\\\\\\"limit\\\\\\\": 20,\\\\n      \\\\\\\"totalPages\\\\\\\": 3\\\\n    }\\\\n  }\\\\n}\\\\n```\\\\n\\\\n#### 9.3.2 标记关怀提醒为已发送\\\\n```\\\\nPUT /api/v1/care-reminders/{reminderId}/send\\\\n\\\\nRequest:\\\\n{\\\\n  \\\\\\\"response\\\\\\\": \\\\\\\"客户表示感谢\\\\\\\",\\\\n  \\\\\\\"effectivenessScore\\\\\\\": 5\\\\n}\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"id\\\\\\\": \\\\\\\"xxx\\\\\\\",\\\\n    \\\\\\\"status\\\\\\\": \\\\\\\"sent\\\\\\\",\\\\n    \\\\\\\"sentAt\\\\\\\": \\\\\\\"2024-01-15T10:00:00Z\\\\\\\",\\\\n    \\\\\\\"response\\\\\\\": \\\\\\\"客户表示感谢\\\\\\\",\\\\n    \\\\\\\"effectivenessScore\\\\\\\": 5\\\\n  }\\\\n}\\\\n```\\\\n\\\\n### 9.4 流失预警接口\\\\n\\\\n#### 9.4.1 获取流失预警列表\\\\n```\\\\nGET /api/v1/churn-alerts?riskLevel=high&status=pending&page=1&limit=20\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"items\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"id\\\\\\\": \\\\\\\"xxx\\\\\\\",\\\\n        \\\\\\\"customerId\\\\\\\": \\\\\\\"xxx\\\\\\\",\\\\n        \\\\\\\"customerName\\\\\\\": \\\\\\\"李四\\\\\\\",\\\\n        \\\\\\\"churnProbability\\\\\\\": 0.85,\\\\n        \\\\\\\"riskLevel\\\\\\\": \\\\\\\"high\\\\\\\",\\\\n        \\\\\\\"riskFactors\\\\\\\": [\\\\\\\"60天未消费\\\\\\\", \\\\\\\"消费频次下降70%\\\\\\\"],\\\\n        \\\\\\\"predictedChurnDate\\\\\\\": \\\\\\\"2024-02-15T00:00:00Z\\\\\\\",\\\\n        \\\\\\\"status\\\\\\\": \\\\\\\"pending\\\\\\\",\\\\n        \\\\\\\"createdAt\\\\\\\": \\\\\\\"2024-01-10T00:00:00Z\\\\\\\"\\\\n      }\\\\n    ],\\\\n    \\\\\\\"pagination\\\\\\\": {\\\\n      \\\\\\\"total\\\\\\\": 25,\\\\n      \\\\\\\"page\\\\\\\": 1,\\\\n      \\\\\\\"limit\\\\\\\": 20,\\\\n      \\\\\\\"totalPages\\\\\\\": 2\\\\n    }\\\\n  }\\\\n}\\\\n```\\\\n\\\\n#### 9.4.2 分配流失预警处理人\\\\n```\\\\nPUT /api/v1/churn-alerts/{alertId}/assign\\\\n\\\\nRequest:\\\\n{\\\\n  \\\\\\\"assignedTo\\\\\\\": \\\\\\\"userId123\\\\\\\"\\\\n}\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"id\\\\\\\": \\\\\\\"xxx\\\\\\\",\\\\n    \\\\\\\"assignedTo\\\\\\\": \\\\\\\"userId123\\\\\\\",\\\\n    \\\\\\\"status\\\\\\\": \\\\\\\"in_progress\\\\\\\",\\\\n    \\\\\\\"assignedAt\\\\\\\": \\\\\\\"2024-01-15T10:00:00Z\\\\\\\"\\\\n  }\\\\n}\\\\n```\\\\n\\\\n#### 9.4.3 更新流失预警状态\\\\n```\\\\nPUT /api/v1/churn-alerts/{alertId}/resolve\\\\n\\\\nRequest:\\\\n{\\\\n  \\\\\\\"status\\\\\\\": \\\\\\\"resolved\\\\\\\",\\\\n  \\\\\\\"resolutionNotes\\\\\\\": \\\\\\\"已联系客户，问题已解决\\\\\\\"\\\\n}\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"id\\\\\\\": \\\\\\\"xxx\\\\\\\",\\\\n    \\\\\\\"status\\\\\\\": \\\\\\\"resolved\\\\\\\",\\\\n    \\\\\\\"resolutionNotes\\\\\\\": \\\\\\\"已联系客户，问题已解决\\\\\\\",\\\\n    \\\\\\\"resolvedAt\\\\\\\": \\\\\\\"2024-01-15T15:00:00Z\\\\\\\"\\\\n  }\\\\n}\\\\n```\\\\n\\\\n### 9.5 生命周期数据看板接口\\\\n\\\\n#### 9.5.1 获取生命周期概览数据\\\\n```\\\\nGET /api/v1/analytics/lifecycle/overview?startDate=2024-01-01&endDate=2024-01-31\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"overview\\\\\\\": {\\\\n      \\\\\\\"totalCustomers\\\\\\\": 10000,\\\\n      \\\\\\\"activeCustomers\\\\\\\": 6500,\\\\n      \\\\\\\"churnedCustomers\\\\\\\": 500,\\\\n      \\\\\\\"retentionRate\\\\\\\": 0.95,\\\\n      \\\\\\\"averageCLV\\\\\\\": 2500,\\\\n      \\\\\\\"satisfactionScore\\\\\\\": 4.3\\\\n    },\\\\n    \\\\\\\"stageDistribution\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"stage\\\\\\\": \\\\\\\"potential\\\\\\\",\\\\n        \\\\\\\"count\\\\\\\": 2000,\\\\n        \\\\\\\"percentage\\\\\\\": 0.2,\\\\n        \\\\\\\"change\\\\\\\": 0.05\\\\n      },\\\\n      {\\\\n        \\\\\\\"stage\\\\\\\": \\\\\\\"new_customer\\\\\\\",\\\\n        \\\\\\\"count\\\\\\\": 1500,\\\\n        \\\\\\\"percentage\\\\\\\": 0.15,\\\\n        \\\\\\\"change\\\\\\\": 0.03\\\\n      }\\\\n    ],\\\\n    \\\\\\\"valueDistribution\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"level\\\\\\\": \\\\\\\"vip\\\\\\\",\\\\n        \\\\\\\"count\\\\\\\": 1500,\\\\n        \\\\\\\"avgRFMScore\\\\\\\": 4.2\\\\n      }\\\\n    ],\\\\n    \\\\\\\"churnAlerts\\\\\\\": {\\\\n      \\\\\\\"high\\\\\\\": 25,\\\\n      \\\\\\\"medium\\\\\\\": 50,\\\\n      \\\\\\\"low\\\\\\\": 75\\\\n    }\\\\n  }\\\\n}\\\\n```\\\\n\\\\n## 十、技术实现要点\\\\n\\\\n### 10.1 前端技术栈\\\\n- Vue 3 + TypeScript\\\\n- Element Plus UI组件库\\\\n- ECharts数据可视化\\\\n- Pinia状态管理\\\\n- Vue Router路由管理\\\\n\\\\n### 10.2 后端技术栈\\\\n- Node.js + Express\\\\n- TypeScript\\\\n- PostgreSQL数据库\\\\n- Redis缓存\\\\n- 定时任务（node-cron）\\\\n\\\\n### 10.3 性能优化\\\\n- RFM评分计算缓存（Redis）\\\\n- 规则引擎结果缓存\\\\n- 数据预加载\\\\n- 虚拟滚动优化列表\\\\n- 分页加载\\\\n\\\\n### 10.4 安全性\\\\n- 数据加密传输（HTTPS）\\\\n- 敏感信息脱敏\\\\n- 访问权限控制\\\\n- 操作日志记录\\\\n- 数据备份\\\\n\\\\n## 十一、测试计划\\\\n\\\\n### 11.1 单元测试\\\\n- 生命周期流转规则测试\\\\n- RFM模型计算测试\\\\n- 流失预测模型测试\\\\n- 关怀提醒引擎测试\\\\n\\\\n### 11.2 集成测试\\\\n- 客户生命周期流转端到端测试\\\\n- 关怀提醒发送测试\\\\n- 流失预警处理测试\\\\n\\\\n### 11.3 性能测试\\\\n- 大规模客户数据处理测试\\\\n- 规则引擎性能测试\\\\n- 并发访问测试\\\\n\\\\n## 十二、上线计划\\\\n\\\\n### 12.1 阶段一：基础功能（1-2周）\\\\n- 客户生命周期阶段划分\\\\n- RFM模型实现\\\\n- 基础数据看板\\\\n\\\\n### 12.2 阶段二：智能功能（2-3周）\\\\n- 自动流转规则引擎\\\\n- 关怀提醒功能\\\\n- 流失预警机制\\\\n\\\\n### 12.3 阶段三：优化完善（1-2周）\\\\n- 数据可视化优化\\\\n- 性能优化\\\\n- 用户反馈收集与改进\\\\n\\\\n### 12.4 阶段四：全面推广（持续）\\\\n- 全员培训\\\\n- 数据监控\\\\n- 持续优化迭代\\\\n\\\\n---\\\\n\\\\n**文档版本**: v1.0.0\\\\n**创建日期**: 2025-01-20\\\\n**最后更新**: 2025-01-20\\\\n**文档状态**: 已完成\\\\n\",\"originAcceptText\":\"# 客户生命周期管理功能模块需求分析与设计文档\\n\\n## 一、模块概述\\n\\n### 1.1 模块简介\\n客户生命周期管理是YYC³餐饮管理系统的核心客户关系管理（CRM）功能，通过科学的客户阶段划分、智能流转规则、价值评估模型和预警机制，实现客户全生命周期的精细化管理，提升客户满意度和忠诚度。\\n\\n### 1.2 业务价值\\n- 提升客户留存率15-20%\\n- 提高客户生命周期价值（CLV）25-30%\\n- 降低客户流失率10-15%\\n- 优化营销资源投入效率\\n- 实现个性化客户服务\\n\\n### 1.3 目标用户\\n- 店长/运营经理：查看客户生命周期数据，制定营销策略\\n- 客服人员：接收智能提醒，进行客户关怀\\n- 营销人员：基于客户分群进行精准营销\\n- 管理层：监控客户生命周期指标，决策支持\\n\\n## 二、客户生命周期阶段划分标准\\n\\n### 2.1 生命周期阶段定义\\n\\n#### 2.1.1 潜在客户（Potential）\\n**定义**：尚未完成首次消费的客户\\n**进入条件**：\\n- 注册账号但未下单\\n- 留存联系方式但未消费\\n- 参与营销活动但未转化\\n\\n**退出条件**：\\n- 完成首次消费 → 转为新客户\\n- 超过30天未转化 → 转为流失潜在客户\\n\\n**关键指标**：\\n- 注册天数\\n- 营销活动参与次数\\n- 互动频率\\n\\n**运营策略**：\\n- 新客优惠券发放\\n- 引导下单流程优化\\n- 产品推荐\\n\\n#### 2.1.2 新客户（New Customer）\\n**定义**：首次消费后30天内的客户\\n**进入条件**：\\n- 完成首次消费\\n- 消费金额 > 0\\n\\n**退出条件**：\\n- 消费次数 ≥ 3次 且 消费天数 ≥ 7天 → 转为活跃客户\\n- 超过30天未再次消费 → 转为休眠客户\\n\\n**关键指标**：\\n- 首次消费金额\\n- 首次消费时间\\n- 首次消费品类\\n- 复购意向\\n\\n**运营策略**：\\n- 首单感谢\\n- 二次消费激励\\n- 产品使用指导\\n\\n#### 2.1.3 活跃客户（Active）\\n**定义**：近30天内有消费且消费频次较高的客户\\n**进入条件**：\\n- 消费次数 ≥ 3次\\n- 消费天数 ≥ 7天\\n- 最近30天内有消费\\n\\n**退出条件**：\\n- 消费次数 ≥ 10次 且 累计消费金额 ≥ 2000元 → 转为忠诚客户\\n- 超过30天未消费 → 转为休眠客户\\n- RFM评分下降 → 转为价值下降客户\\n\\n**关键指标**：\\n- 消费频次（Frequency）\\n- 消费金额（Monetary）\\n- 最近消费时间（Recency）\\n- 消费品类多样性\\n\\n**运营策略**：\\n- 会员等级提升\\n- 专属优惠\\n- 新品优先体验\\n\\n#### 2.1.4 忠诚客户（Loyal）\\n**定义**：消费频次高、金额大、关系稳定的客户\\n**进入条件**：\\n- 消费次数 ≥ 10次\\n- 累计消费金额 ≥ 2000元\\n- 最近90天内有消费\\n- 满意度评分 ≥ 4.5\\n\\n**退出条件**：\\n- 超过60天未消费 → 转为流失风险客户\\n- 消费频次下降 → 转为活跃客户\\n\\n**关键指标**：\\n- 累计消费金额\\n- 消费频次\\n- 客户满意度\\n- 推荐意愿\\n\\n**运营策略**：\\n- VIP专属服务\\n- 生日关怀\\n- 定制化服务\\n- 积分奖励\\n\\n#### 2.1.5 休眠客户（Dormant）\\n**定义**：曾经消费但近期未消费的客户\\n**进入条件**：\\n- 活跃客户超过30天未消费\\n- 新客户超过30天未再次消费\\n- 忠诚客户超过60天未消费\\n\\n**退出条件**：\\n- 重新消费 → 转为活跃客户\\n- 超过90天未消费 → 转为流失客户\\n\\n**关键指标**：\\n- 休眠天数\\n- 历史消费频次\\n- 历史消费金额\\n- 唤醒难度\\n\\n**运营策略**：\\n- 唤醒优惠券\\n- 个性化推荐\\n- 主动关怀电话\\n\\n#### 2.1.6 流失客户（Churned）\\n**定义**：超过90天未消费且无互动的客户\\n**进入条件**：\\n- 休眠客户超过90天未消费\\n- 多次唤醒尝试失败\\n\\n**退出条件**：\\n- 重新消费 → 转为新客户（重新计算生命周期）\\n\\n**关键指标**：\\n- 流失天数\\n- 流失原因\\n- 挽回成本\\n\\n**运营策略**：\\n- 流失原因调研\\n- 重新获取策略\\n- 防止再次流失\\n\\n### 2.2 客户价值等级划分\\n\\n#### 2.2.1 普通客户（Regular）\\n- RFM评分：1-3分\\n- 消费频次：1-3次/月\\n- 消费金额：< 500元/月\\n\\n#### 2.2.2 会员客户（Member）\\n- RFM评分：4-6分\\n- 消费频次：4-6次/月\\n- 消费金额：500-1000元/月\\n\\n#### 2.2.3 VIP客户（VIP）\\n- RFM评分：7-9分\\n- 消费频次：≥ 7次/月\\n- 消费金额：≥ 1000元/月\\n\\n### 2.3 客户分群维度\\n\\n#### 2.3.1 高价值客户\\n- 累计消费金额前20%\\n- 消费频次前20%\\n- RFM评分 ≥ 7分\\n\\n#### 2.3.2 高频客户\\n- 消费频次前30%\\n- 月均消费次数 ≥ 5次\\n\\n#### 2.3.3 新客户\\n- 注册时间 ≤ 30天\\n- 消费次数 ≤ 3次\\n\\n#### 2.3.4 流失风险客户\\n- 最近消费时间 > 30天\\n- 消费频次下降 > 50%\\n- 满意度评分 < 3.5\\n\\n#### 2.3.5 忠诚客户\\n- 消费频次 ≥ 8次/月\\n- 客户时长 ≥ 6个月\\n- 满意度评分 ≥ 4.5\\n\\n#### 2.3.6 休眠客户\\n- 最近消费时间 > 30天\\n- 历史消费次数 ≥ 3次\\n\\n## 三、客户生命周期自动流转规则引擎\\n\\n### 3.1 规则引擎架构\\n\\n#### 3.1.1 规则定义\\n```typescript\\ninterface LifecycleRule {\\n  id: string\\n  name: string\\n  description: string\\n  fromStage: string[]\\n  toStage: string\\n  conditions: RuleCondition[]\\n  priority: number\\n  enabled: boolean\\n  createdAt: Date\\n  updatedAt: Date\\n}\\n\\ninterface RuleCondition {\\n  field: string\\n  operator: 'eq' | 'ne' | 'gt' | 'lt' | 'gte' | 'lte' | 'in' | 'not_in'\\n  value: any\\n  logicalOperator?: 'AND' | 'OR'\\n}\\n```\\n\\n#### 3.1.2 规则执行流程\\n1. **触发事件**：客户数据变更（消费、注册、互动等）\\n2. **规则匹配**：根据当前阶段筛选适用规则\\n3. **条件评估**：评估规则条件是否满足\\n4. **优先级排序**：按优先级排序匹配的规则\\n5. **规则执行**：执行最高优先级规则\\n6. **状态更新**：更新客户生命周期阶段\\n7. **事件通知**：发送通知给相关人员\\n8. **日志记录**：记录流转历史\\n\\n### 3.2 预置流转规则\\n\\n#### 3.2.1 潜在客户 → 新客户\\n```\\n规则ID: RULE_001\\n优先级: 1\\n条件:\\n  - 首次消费时间 不为空\\n  - 消费金额 > 0\\n动作:\\n  - 更新生命周期阶段为 'new_customer'\\n  - 发送欢迎消息\\n  - 发放新客优惠券\\n```\\n\\n#### 3.2.2 新客户 → 活跃客户\\n```\\n规则ID: RULE_002\\n优先级: 2\\n条件:\\n  - 消费次数 >= 3\\n  - 消费天数 >= 7\\n  - 最近消费时间 <= 30天前\\n动作:\\n  - 更新生命周期阶段为 'active'\\n  - 发送会员升级提醒\\n  - 推荐热门商品\\n```\\n\\n#### 3.2.3 活跃客户 → 忠诚客户\\n```\\n规则ID: RULE_003\\n优先级: 3\\n条件:\\n  - 消费次数 >= 10\\n  - 累计消费金额 >= 2000\\n  - 最近消费时间 <= 90天前\\n  - 满意度评分 >= 4.5\\n动作:\\n  - 更新生命周期阶段为 'loyal'\\n  - 升级为VIP客户\\n  - 发放VIP专属权益\\n  - 通知店长\\n```\\n\\n#### 3.2.4 活跃客户 → 休眠客户\\n```\\n规则ID: RULE_004\\n优先级: 4\\n条件:\\n  - 最近消费时间 > 30天前\\n  - 当前阶段为 'active'\\n动作:\\n  - 更新生命周期阶段为 'dormant'\\n  - 发送唤醒优惠券\\n  - 设置流失预警\\n```\\n\\n#### 3.2.5 忠诚客户 → 休眠客户\\n```\\n规则ID: RULE_005\\n优先级: 5\\n条件:\\n  - 最近消费时间 > 60天前\\n  - 当前阶段为 'loyal'\\n动作:\\n  - 更新生命周期阶段为 'dormant'\\n  - 发送专属唤醒优惠\\n  - 安排客服回访\\n```\\n\\n#### 3.2.6 休眠客户 → 流失客户\\n```\\n规则ID: RULE_006\\n优先级: 6\\n条件:\\n  - 最近消费时间 > 90天前\\n  - 当前阶段为 'dormant'\\n  - 唤醒尝试次数 >= 3\\n动作:\\n  - 更新生命周期阶段为 'churned'\\n  - 标记为流失客户\\n  - 生成流失分析报告\\n```\\n\\n#### 3.2.7 休眠客户 → 活跃客户\\n```\\n规则ID: RULE_007\\n优先级: 7\\n条件:\\n  - 当前阶段为 'dormant'\\n  - 产生新消费\\n动作:\\n  - 更新生命周期阶段为 'active'\\n  - 发送欢迎回归消息\\n  - 推荐新品\\n```\\n\\n### 3.3 规则引擎实现\\n\\n#### 3.3.1 规则引擎核心类\\n```typescript\\nclass LifecycleRuleEngine {\\n  private rules: LifecycleRule[]\\n  private eventBus: EventBus\\n\\n  constructor(rules: LifecycleRule[]) {\\n    this.rules = rules.sort((a, b) => b.priority - a.priority)\\n    this.eventBus = new EventBus()\\n  }\\n\\n  async evaluate(customer: Customer, event: CustomerEvent): Promise<RuleResult[]> {\\n    const applicableRules = this.rules.filter(rule =>\\n      rule.fromStage.includes(customer.lifecycleStage) && rule.enabled\\n    )\\n\\n    const results: RuleResult[] = []\\n    for (const rule of applicableRules) {\\n      if (await this.evaluateConditions(rule.conditions, customer, event)) {\\n        results.push({\\n          rule,\\n          matched: true,\\n          timestamp: new Date()\\n        })\\n      }\\n    }\\n\\n    return results.sort((a, b) => b.rule.priority - a.rule.priority)\\n  }\\n\\n  private async evaluateConditions(\\n    conditions: RuleCondition[],\\n    customer: Customer,\\n    event: CustomerEvent\\n  ): Promise<boolean> {\\n    let result = true\\n    let currentOperator: 'AND' | 'OR' = 'AND'\\n\\n    for (const condition of conditions) {\\n      const conditionResult = this.evaluateCondition(condition, customer, event)\\n      currentOperator = condition.logicalOperator || 'AND'\\n\\n      if (currentOperator === 'AND') {\\n        result = result && conditionResult\\n      } else {\\n        result = result || conditionResult\\n      }\\n    }\\n\\n    return result\\n  }\\n\\n  private evaluateCondition(\\n    condition: RuleCondition,\\n    customer: Customer,\\n    event: CustomerEvent\\n  ): boolean {\\n    const fieldValue = this.getFieldValue(condition.field, customer, event)\\n\\n    switch (condition.operator) {\\n      case 'eq':\\n        return fieldValue === condition.value\\n      case 'ne':\\n        return fieldValue !== condition.value\\n      case 'gt':\\n        return fieldValue > condition.value\\n      case 'lt':\\n        return fieldValue < condition.value\\n      case 'gte':\\n        return fieldValue >= condition.value\\n      case 'lte':\\n        return fieldValue <= condition.value\\n      case 'in':\\n        return Array.isArray(condition.value) && condition.value.includes(fieldValue)\\n      case 'not_in':\\n        return Array.isArray(condition.value) && !condition.value.includes(fieldValue)\\n      default:\\n        return false\\n    }\\n  }\\n\\n  private getFieldValue(field: string, customer: Customer, event: CustomerEvent): any {\\n    const fieldPath = field.split('.')\\n    let value: any = { ...customer, ...event }\\n\\n    for (const key of fieldPath) {\\n      value = value?.[key]\\n    }\\n\\n    return value\\n  }\\n}\\n```\\n\\n## 四、客户价值评估模型（RFM）\\n\\n### 4.1 RFM模型概述\\n\\nRFM模型是客户价值评估的经典方法，通过三个维度对客户进行评分：\\n- **R（Recency）**：最近一次消费时间\\n- **F（Frequency）**：消费频次\\n- **M（Monetary）**：消费金额\\n\\n### 4.2 RFM评分标准\\n\\n#### 4.2.1 R评分（最近消费时间）\\n| 分数 | 最近消费时间 |\\n|------|-------------|\\n| 5分 | 0-7天 |\\n| 4分 | 8-14天 |\\n| 3分 | 15-30天 |\\n| 2分 | 31-60天 |\\n| 1分 | >60天 |\\n\\n#### 4.2.2 F评分（消费频次）\\n| 分数 | 月均消费次数 |\\n|------|-------------|\\n| 5分 | ≥ 8次 |\\n| 4分 | 5-7次 |\\n| 3分 | 3-4次 |\\n| 2分 | 1-2次 |\\n| 1分 | 0次 |\\n\\n#### 4.2.3 M评分（消费金额）\\n| 分数 | 月均消费金额 |\\n|------|-------------|\\n| 5分 | ≥ 1000元 |\\n| 4分 | 500-999元 |\\n| 3分 | 300-499元 |\\n| 2分 | 100-299元 |\\n| 1分 | < 100元 |\\n\\n### 4.3 RFM总分计算\\n\\n#### 4.3.1 计算公式\\n```\\nRFM总分 = R评分 × 0.3 + F评分 × 0.4 + M评分 × 0.3\\n```\\n\\n#### 4.3.2 客户价值分级\\n| RFM总分 | 客户等级 | 占比 |\\n|---------|----------|------|\\n| 4.5-5.0 | 超级VIP | 5% |\\n| 3.5-4.4 | VIP | 15% |\\n| 2.5-3.4 | 会员 | 30% |\\n| 1.5-2.4 | 普通 | 40% |\\n| 0-1.4 | 低价值 | 10% |\\n\\n### 4.4 RFM模型实现\\n\\n```typescript\\ninterface RFMScore {\\n  recencyScore: number\\n  frequencyScore: number\\n  monetaryScore: number\\n  totalScore: number\\n  customerLevel: string\\n}\\n\\nclass RFMModel {\\n  calculateRFMScore(customer: Customer): RFMScore {\\n    const recencyScore = this.calculateRecencyScore(customer.lastOrderDate)\\n    const frequencyScore = this.calculateFrequencyScore(customer.orderCount)\\n    const monetaryScore = this.calculateMonetaryScore(customer.totalSpent)\\n\\n    const totalScore =\\n      recencyScore * 0.3 +\\n      frequencyScore * 0.4 +\\n      monetaryScore * 0.3\\n\\n    return {\\n      recencyScore,\\n      frequencyScore,\\n      monetaryScore,\\n      totalScore: Math.round(totalScore * 10) / 10,\\n      customerLevel: this.getCustomerLevel(totalScore)\\n    }\\n  }\\n\\n  private calculateRecencyScore(lastOrderDate: Date | null): number {\\n    if (!lastOrderDate) return 1\\n\\n    const daysSinceLastOrder = Math.floor(\\n      (Date.now() - new Date(lastOrderDate).getTime()) / (1000 * 60 * 60 * 24)\\n    )\\n\\n    if (daysSinceLastOrder <= 7) return 5\\n    if (daysSinceLastOrder <= 14) return 4\\n    if (daysSinceLastOrder <= 30) return 3\\n    if (daysSinceLastOrder <= 60) return 2\\n    return 1\\n  }\\n\\n  private calculateFrequencyScore(orderCount: number): number {\\n    const monthlyOrders = orderCount / 12\\n\\n    if (monthlyOrders >= 8) return 5\\n    if (monthlyOrders >= 5) return 4\\n    if (monthlyOrders >= 3) return 3\\n    if (monthlyOrders >= 1) return 2\\n    return 1\\n  }\\n\\n  private calculateMonetaryScore(totalSpent: number): number {\\n    const monthlySpent = totalSpent / 12\\n\\n    if (monthlySpent >= 1000) return 5\\n    if (monthlySpent >= 500) return 4\\n    if (monthlySpent >= 300) return 3\\n    if (monthlySpent >= 100) return 2\\n    return 1\\n  }\\n\\n  private getCustomerLevel(totalScore: number): string {\\n    if (totalScore >= 4.5) return 'super_vip'\\n    if (totalScore >= 3.5) return 'vip'\\n    if (totalScore >= 2.5) return 'member'\\n    if (totalScore >= 1.5) return 'regular'\\n    return 'low_value'\\n  }\\n}\\n```\\n\\n## 五、智能客户关怀提醒功能\\n\\n### 5.1 关怀场景设计\\n\\n#### 5.1.1 新客户关怀\\n**触发时机**：客户首次消费后24小时内\\n**关怀内容**：\\n- 感谢首次消费\\n- 介绍会员权益\\n- 发放新客优惠券\\n- 推荐热门商品\\n\\n#### 5.1.2 生日关怀\\n**触发时机**：客户生日当天\\n**关怀内容**：\\n- 生日祝福\\n- 生日专属优惠券\\n- 免费赠送小礼品\\n- 邀请亲友同享优惠\\n\\n#### 5.1.3 节日关怀\\n**触发时机**：重要节日（春节、中秋、国庆等）\\n**关怀内容**：\\n- 节日祝福\\n- 节日专属优惠\\n- 节日特色菜品推荐\\n\\n#### 5.1.4 消费频次下降提醒\\n**触发时机**：客户消费频次下降超过50%\\n**关怀内容**：\\n- 询问是否有问题\\n- 提供专属优惠\\n- 推荐新品\\n\\n#### 5.1.5 长期未消费提醒\\n**触发时机**：客户30天未消费\\n**关怀内容**：\\n- 表达关心\\n- 发放唤醒优惠券\\n- 推荐近期优惠活动\\n\\n#### 5.1.6 VIP客户专属关怀\\n**触发时机**：VIP客户每月定期\\n**关怀内容**：\\n- 专属客服对接\\n- 新品优先体验\\n- 定制化服务\\n- 积分奖励\\n\\n### 5.2 关怀提醒规则\\n\\n```typescript\\ninterface CareReminderRule {\\n  id: string\\n  name: string\\n  triggerType: 'event' | 'schedule' | 'condition'\\n  triggerCondition: any\\n  careType: string\\n  contentTemplate: string\\n  channels: string[]\\n  priority: number\\n  enabled: boolean\\n}\\n\\nconst careReminderRules: CareReminderRule[] = [\\n  {\\n    id: 'CARE_001',\\n    name: '新客户关怀',\\n    triggerType: 'event',\\n    triggerCondition: { eventType: 'first_order', hoursAfter: 24 },\\n    careType: 'welcome',\\n    contentTemplate: '感谢您首次光临！',\\n    channels: ['sms', 'push'],\\n    priority: 1,\\n    enabled: true\\n  },\\n  {\\n    id: 'CARE_002',\\n    name: '生日关怀',\\n    triggerType: 'schedule',\\n    triggerCondition: { schedule: 'birthday' },\\n    careType: 'birthday',\\n    contentTemplate: '生日快乐！',\\n    channels: ['sms', 'push', 'email'],\\n    priority: 2,\\n    enabled: true\\n  },\\n  {\\n    id: 'CARE_003',\\n    name: '消费频次下降提醒',\\n    triggerType: 'condition',\\n    triggerCondition: {\\n      field: 'orderFrequencyChange',\\n      operator: 'lt',\\n      value: -0.5\\n    },\\n    careType: 'frequency_drop',\\n    contentTemplate: '最近很少见到您',\\n    channels: ['sms', 'push'],\\n    priority: 3,\\n    enabled: true\\n  },\\n  {\\n    id: 'CARE_004',\\n    name: '长期未消费提醒',\\n    triggerType: 'condition',\\n    triggerCondition: {\\n      field: 'daysSinceLastOrder',\\n      operator: 'gte',\\n      value: 30\\n    },\\n    careType: 'inactive',\\n    contentTemplate: '好久不见',\\n    channels: ['sms', 'push', 'email'],\\n    priority: 4,\\n    enabled: true\\n  }\\n]\\n```\\n\\n### 5.3 关怀提醒引擎\\n\\n```typescript\\nclass CareReminderEngine {\\n  private rules: CareReminderRule[]\\n  private notificationService: NotificationService\\n\\n  constructor(rules: CareReminderRule[]) {\\n    this.rules = rules\\n    this.notificationService = new NotificationService()\\n  }\\n\\n  async processCustomerEvent(customer: Customer, event: CustomerEvent): Promise<void> {\\n    for (const rule of this.rules) {\\n      if (!rule.enabled) continue\\n\\n      const shouldTrigger = await this.evaluateTrigger(rule, customer, event)\\n      if (shouldTrigger) {\\n        await this.sendCareReminder(customer, rule)\\n      }\\n    }\\n  }\\n\\n  private async evaluateTrigger(\\n    rule: CareReminderRule,\\n    customer: Customer,\\n    event: CustomerEvent\\n  ): Promise<boolean> {\\n    switch (rule.triggerType) {\\n      case 'event':\\n        return this.evaluateEventTrigger(rule.triggerCondition, event)\\n      case 'schedule':\\n        return this.evaluateScheduleTrigger(rule.triggerCondition, customer)\\n      case 'condition':\\n        return this.evaluateConditionTrigger(rule.triggerCondition, customer)\\n      default:\\n        return false\\n    }\\n  }\\n\\n  private async sendCareReminder(\\n    customer: Customer,\\n    rule: CareReminderRule\\n  ): Promise<void> {\\n    const content = this.generateContent(rule.contentTemplate, customer)\\n\\n    for (const channel of rule.channels) {\\n      await this.notificationService.send({\\n        channel,\\n        recipient: customer,\\n        content,\\n        type: rule.careType\\n      })\\n    }\\n\\n    await this.logCareReminder(customer.id, rule.id, content)\\n  }\\n\\n  private generateContent(template: string, customer: Customer): string {\\n    return template\\n      .replace('{name}', customer.name)\\n      .replace('{level}', customer.level)\\n      .replace('{lastOrderDate}', formatDate(customer.lastOrderDate))\\n  }\\n}\\n```\\n\\n## 六、客户流失预警机制\\n\\n### 6.1 流失预警指标\\n\\n#### 6.1.1 行为指标\\n- 最近消费时间 > 30天\\n- 消费频次下降 > 50%\\n- 消费金额下降 > 50%\\n- 互动频率下降 > 60%\\n- 满意度评分 < 3.5\\n\\n#### 6.1.2 预警等级\\n\\n| 等级 | 颜色 | 条件 | 处理时效 |\\n|------|------|------|----------|\\n| 高危 | 红色 | 最近消费 > 60天 且 消费频次下降 > 70% | 24小时内 |\\n| 中危 | 橙色 | 最近消费 > 45天 或 消费频次下降 > 50% | 48小时内 |\\n| 低危 | 黄色 | 最近消费 > 30天 或 消费频次下降 > 30% | 72小时内 |\\n\\n### 6.2 流失预测模型\\n\\n```typescript\\ninterface ChurnPrediction {\\n  customerId: string\\n  churnProbability: number\\n  riskLevel: 'high' | 'medium' | 'low'\\n  riskFactors: string[]\\n  predictedChurnDate: Date\\n  recommendations: string[]\\n}\\n\\nclass ChurnPredictionModel {\\n  predictChurn(customer: Customer): ChurnPrediction {\\n    const riskFactors: string[] = []\\n    let churnProbability = 0\\n\\n    if (this.isInactive(customer, 30)) {\\n      churnProbability += 0.2\\n      riskFactors.push('30天未消费')\\n    }\\n\\n    if (this.isInactive(customer, 60)) {\\n      churnProbability += 0.3\\n      riskFactors.push('60天未消费')\\n    }\\n\\n    if (this.hasFrequencyDrop(customer, 0.5)) {\\n      churnProbability += 0.25\\n      riskFactors.push('消费频次下降50%')\\n    }\\n\\n    if (this.hasSpendingDrop(customer, 0.5)) {\\n      churnProbability += 0.15\\n      riskFactors.push('消费金额下降50%')\\n    }\\n\\n    if (customer.satisfactionScore < 3.5) {\\n      churnProbability += 0.1\\n      riskFactors.push('满意度低')\\n    }\\n\\n    churnProbability = Math.min(churnProbability, 1.0)\\n\\n    return {\\n      customerId: customer.id,\\n      churnProbability,\\n      riskLevel: this.getRiskLevel(churnProbability),\\n      riskFactors,\\n      predictedChurnDate: this.predictChurnDate(churnProbability),\\n      recommendations: this.generateRecommendations(riskFactors)\\n    }\\n  }\\n\\n  private isInactive(customer: Customer, days: number): boolean {\\n    if (!customer.lastOrderDate) return true\\n    const daysSinceLastOrder = Math.floor(\\n      (Date.now() - new Date(customer.lastOrderDate).getTime()) / (1000 * 60 * 60 * 24)\\n    )\\n    return daysSinceLastOrder > days\\n  }\\n\\n  private hasFrequencyDrop(customer: Customer, threshold: number): boolean {\\n    const currentFrequency = this.calculateMonthlyFrequency(customer, 30)\\n    const previousFrequency = this.calculateMonthlyFrequency(customer, 90)\\n    return currentFrequency < previousFrequency * (1 - threshold)\\n  }\\n\\n  private hasSpendingDrop(customer: Customer, threshold: number): boolean {\\n    const currentSpending = this.calculateMonthlySpending(customer, 30)\\n    const previousSpending = this.calculateMonthlySpending(customer, 90)\\n    return currentSpending < previousSpending * (1 - threshold)\\n  }\\n\\n  private getRiskLevel(probability: number): 'high' | 'medium' | 'low' {\\n    if (probability >= 0.7) return 'high'\\n    if (probability >= 0.4) return 'medium'\\n    return 'low'\\n  }\\n\\n  private predictChurnDate(probability: number): Date {\\n    const daysToChurn = Math.floor(90 * (1 - probability))\\n    return new Date(Date.now() + daysToChurn * 24 * 60 * 60 * 1000)\\n  }\\n\\n  private generateRecommendations(riskFactors: string[]): string[] {\\n    const recommendations: string[] = []\\n\\n    if (riskFactors.includes('30天未消费')) {\\n      recommendations.push('发送唤醒优惠券')\\n      recommendations.push('安排客服回访')\\n    }\\n\\n    if (riskFactors.includes('消费频次下降50%')) {\\n      recommendations.push('了解消费下降原因')\\n      recommendations.push('提供专属优惠')\\n    }\\n\\n    if (riskFactors.includes('满意度低')) {\\n      recommendations.push('安排满意度调研')\\n      recommendations.push('改进服务质量')\\n    }\\n\\n    return recommendations\\n  }\\n}\\n```\\n\\n### 6.3 流失预警处理流程\\n\\n1. **预警触发**：系统自动检测到流失风险\\n2. **预警评估**：计算流失概率和风险等级\\n3. **预警通知**：发送通知给店长和客服\\n4. **任务分配**：自动分配给相应客服人员\\n5. **客户回访**：客服人员主动联系客户\\n6. **问题解决**：了解问题并提供解决方案\\n7. **效果跟踪**：记录处理结果和客户反馈\\n8. **持续监控**：持续监控客户状态\\n\\n## 七、生命周期数据分析看板\\n\\n### 7.1 看板布局设计\\n\\n#### 7.1.1 顶部指标卡片\\n- 总客户数\\n- 活跃客户数\\n- 流失客户数\\n- 客户留存率\\n- 平均生命周期价值（CLV）\\n- 客户满意度\\n\\n#### 7.1.2 生命周期阶段分布图\\n- 饼图展示各阶段客户占比\\n- 环比变化趋势\\n- 阶段流转统计\\n\\n#### 7.1.3 客户价值分布图\\n- 柱状图展示RFM评分分布\\n- 客户等级占比\\n- 价值变化趋势\\n\\n#### 7.1.4 流失预警列表\\n- 高危流失客户\\n- 中危流失客户\\n- 低危流失客户\\n- 处理状态跟踪\\n\\n#### 7.1.5 关怀提醒列表\\n- 待处理关怀提醒\\n- 已完成关怀记录\\n- 关怀效果统计\\n\\n#### 7.1.6 客户流转趋势图\\n- 折线图展示阶段流转趋势\\n- 流入流出统计\\n- 转化率分析\\n\\n### 7.2 数据可视化组件\\n\\n```typescript\\ninterface LifecycleDashboardData {\\n  overview: {\\n    totalCustomers: number\\n    activeCustomers: number\\n    churnedCustomers: number\\n    retentionRate: number\\n    averageCLV: number\\n    satisfactionScore: number\\n  }\\n  stageDistribution: {\\n    stage: string\\n    count: number\\n    percentage: number\\n    change: number\\n  }[]\\n  valueDistribution: {\\n    level: string\\n    count: number\\n    avgRFMScore: number\\n  }[]\\n  churnAlerts: ChurnPrediction[]\\n  careReminders: CareReminder[]\\n  flowTrends: {\\n    date: string\\n    fromStage: string\\n    toStage: string\\n    count: number\\n  }[]\\n}\\n```\\n\\n## 八、数据模型设计\\n\\n### 8.1 客户生命周期表（customer_lifecycle）\\n\\n```sql\\nCREATE TABLE customer_lifecycle (\\n  id VARCHAR(36) PRIMARY KEY,\\n  customer_id VARCHAR(36) NOT NULL,\\n  current_stage VARCHAR(50) NOT NULL,\\n  previous_stage VARCHAR(50),\\n  stage_entered_at TIMESTAMP NOT NULL,\\n  stage_duration_days INT,\\n  total_days_in_stage INT,\\n  rfm_score DECIMAL(3,1),\\n  customer_level VARCHAR(50),\\n  churn_probability DECIMAL(5,2),\\n  risk_level VARCHAR(20),\\n  last_order_date TIMESTAMP,\\n  order_count INT,\\n  total_spent DECIMAL(10,2),\\n  satisfaction_score DECIMAL(3,1),\\n  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\\n  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,\\n  INDEX idx_customer_id (customer_id),\\n  INDEX idx_current_stage (current_stage),\\n  INDEX idx_churn_probability (churn_probability),\\n  FOREIGN KEY (customer_id) REFERENCES customers(id) ON DELETE CASCADE\\n);\\n```\\n\\n### 8.2 生命周期流转记录表（lifecycle_transitions）\\n\\n```sql\\nCREATE TABLE lifecycle_transitions (\\n  id VARCHAR(36) PRIMARY KEY,\\n  customer_id VARCHAR(36) NOT NULL,\\n  from_stage VARCHAR(50),\\n  to_stage VARCHAR(50) NOT NULL,\\n  transition_date TIMESTAMP NOT NULL,\\n  rule_id VARCHAR(50),\\n  reason TEXT,\\n  metadata JSON,\\n  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\\n  INDEX idx_customer_id (customer_id),\\n  INDEX idx_transition_date (transition_date),\\n  INDEX idx_to_stage (to_stage),\\n  FOREIGN KEY (customer_id) REFERENCES customers(id) ON DELETE CASCADE\\n);\\n```\\n\\n### 8.3 关怀提醒记录表（care_reminders）\\n\\n```sql\\nCREATE TABLE care_reminders (\\n  id VARCHAR(36) PRIMARY KEY,\\n  customer_id VARCHAR(36) NOT NULL,\\n  rule_id VARCHAR(50) NOT NULL,\\n  care_type VARCHAR(50) NOT NULL,\\n  content TEXT NOT NULL,\\n  channels JSON NOT NULL,\\n  scheduled_at TIMESTAMP NOT NULL,\\n  sent_at TIMESTAMP,\\n  status ENUM('pending', 'sent', 'failed') DEFAULT 'pending',\\n  response TEXT,\\n  effectiveness_score INT,\\n  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\\n  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,\\n  INDEX idx_customer_id (customer_id),\\n  INDEX idx_scheduled_at (scheduled_at),\\n  INDEX idx_status (status),\\n  FOREIGN KEY (customer_id) REFERENCES customers(id) ON DELETE CASCADE\\n);\\n```\\n\\n### 8.4 流失预警记录表（churn_alerts）\\n\\n```sql\\nCREATE TABLE churn_alerts (\\n  id VARCHAR(36) PRIMARY KEY,\\n  customer_id VARCHAR(36) NOT NULL,\\n  churn_probability DECIMAL(5,2) NOT NULL,\\n  risk_level VARCHAR(20) NOT NULL,\\n  risk_factors JSON NOT NULL,\\n  predicted_churn_date TIMESTAMP,\\n  assigned_to VARCHAR(36),\\n  status ENUM('pending', 'in_progress', 'resolved', 'closed') DEFAULT 'pending',\\n  resolution_notes TEXT,\\n  resolved_at TIMESTAMP,\\n  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\\n  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,\\n  INDEX idx_customer_id (customer_id),\\n  INDEX idx_risk_level (risk_level),\\n  INDEX idx_status (status),\\n  INDEX idx_created_at (created_at),\\n  FOREIGN KEY (customer_id) REFERENCES customers(id) ON DELETE CASCADE,\\n  FOREIGN KEY (assigned_to) REFERENCES users(id) ON DELETE SET NULL\\n);\\n```\\n\\n## 九、API接口设计\\n\\n### 9.1 客户生命周期接口\\n\\n#### 9.1.1 获取客户生命周期信息\\n```\\nGET /api/v1/customers/{customerId}/lifecycle\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"id\\\": \\\"xxx\\\",\\n    \\\"customerId\\\": \\\"xxx\\\",\\n    \\\"currentStage\\\": \\\"active\\\",\\n    \\\"previousStage\\\": \\\"new_customer\\\",\\n    \\\"stageEnteredAt\\\": \\\"2024-01-01T00:00:00Z\\\",\\n    \\\"stageDurationDays\\\": 15,\\n    \\\"rfmScore\\\": {\\n      \\\"recencyScore\\\": 4,\\n      \\\"frequencyScore\\\": 3,\\n      \\\"monetaryScore\\\": 4,\\n      \\\"totalScore\\\": 3.7,\\n      \\\"customerLevel\\\": \\\"member\\\"\\n    },\\n    \\\"churnProbability\\\": 0.15,\\n    \\\"riskLevel\\\": \\\"low\\\"\\n  }\\n}\\n```\\n\\n#### 9.1.2 更新客户生命周期阶段\\n```\\nPOST /api/v1/customers/{customerId}/lifecycle/stage\\n\\nRequest:\\n{\\n  \\\"stage\\\": \\\"loyal\\\",\\n  \\\"reason\\\": \\\"达到忠诚客户标准\\\",\\n  \\\"ruleId\\\": \\\"RULE_003\\\"\\n}\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"id\\\": \\\"xxx\\\",\\n    \\\"customerId\\\": \\\"xxx\\\",\\n    \\\"currentStage\\\": \\\"loyal\\\",\\n    \\\"previousStage\\\": \\\"active\\\",\\n    \\\"transitionDate\\\": \\\"2024-01-15T00:00:00Z\\\"\\n  }\\n}\\n```\\n\\n#### 9.1.3 获取生命周期流转历史\\n```\\nGET /api/v1/customers/{customerId}/lifecycle/transitions?page=1&limit=10\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"items\\\": [\\n      {\\n        \\\"id\\\": \\\"xxx\\\",\\n        \\\"fromStage\\\": \\\"new_customer\\\",\\n        \\\"toStage\\\": \\\"active\\\",\\n        \\\"transitionDate\\\": \\\"2024-01-10T00:00:00Z\\\",\\n        \\\"ruleId\\\": \\\"RULE_002\\\",\\n        \\\"reason\\\": \\\"达到活跃客户标准\\\"\\n      }\\n    ],\\n    \\\"pagination\\\": {\\n      \\\"total\\\": 10,\\n      \\\"page\\\": 1,\\n      \\\"limit\\\": 10,\\n      \\\"totalPages\\\": 1\\n    }\\n  }\\n}\\n```\\n\\n### 9.2 RFM评分接口\\n\\n#### 9.2.1 计算客户RFM评分\\n```\\nPOST /api/v1/customers/rfm/calculate\\n\\nRequest:\\n{\\n  \\\"customerIds\\\": [\\\"id1\\\", \\\"id2\\\", \\\"id3\\\"]\\n}\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": [\\n    {\\n      \\\"customerId\\\": \\\"id1\\\",\\n      \\\"recencyScore\\\": 4,\\n      \\\"frequencyScore\\\": 3,\\n      \\\"monetaryScore\\\": 4,\\n      \\\"totalScore\\\": 3.7,\\n      \\\"customerLevel\\\": \\\"member\\\"\\n    }\\n  ]\\n}\\n```\\n\\n### 9.3 关怀提醒接口\\n\\n#### 9.3.1 获取待处理关怀提醒\\n```\\nGET /api/v1/care-reminders/pending?page=1&limit=20\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"items\\\": [\\n      {\\n        \\\"id\\\": \\\"xxx\\\",\\n        \\\"customerId\\\": \\\"xxx\\\",\\n        \\\"customerName\\\": \\\"张三\\\",\\n        \\\"careType\\\": \\\"birthday\\\",\\n        \\\"content\\\": \\\"生日快乐！\\\",\\n        \\\"scheduledAt\\\": \\\"2024-01-15T00:00:00Z\\\",\\n        \\\"status\\\": \\\"pending\\\"\\n      }\\n    ],\\n    \\\"pagination\\\": {\\n      \\\"total\\\": 50,\\n      \\\"page\\\": 1,\\n      \\\"limit\\\": 20,\\n      \\\"totalPages\\\": 3\\n    }\\n  }\\n}\\n```\\n\\n#### 9.3.2 标记关怀提醒为已发送\\n```\\nPUT /api/v1/care-reminders/{reminderId}/send\\n\\nRequest:\\n{\\n  \\\"response\\\": \\\"客户表示感谢\\\",\\n  \\\"effectivenessScore\\\": 5\\n}\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"id\\\": \\\"xxx\\\",\\n    \\\"status\\\": \\\"sent\\\",\\n    \\\"sentAt\\\": \\\"2024-01-15T10:00:00Z\\\",\\n    \\\"response\\\": \\\"客户表示感谢\\\",\\n    \\\"effectivenessScore\\\": 5\\n  }\\n}\\n```\\n\\n### 9.4 流失预警接口\\n\\n#### 9.4.1 获取流失预警列表\\n```\\nGET /api/v1/churn-alerts?riskLevel=high&status=pending&page=1&limit=20\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"items\\\": [\\n      {\\n        \\\"id\\\": \\\"xxx\\\",\\n        \\\"customerId\\\": \\\"xxx\\\",\\n        \\\"customerName\\\": \\\"李四\\\",\\n        \\\"churnProbability\\\": 0.85,\\n        \\\"riskLevel\\\": \\\"high\\\",\\n        \\\"riskFactors\\\": [\\\"60天未消费\\\", \\\"消费频次下降70%\\\"],\\n        \\\"predictedChurnDate\\\": \\\"2024-02-15T00:00:00Z\\\",\\n        \\\"status\\\": \\\"pending\\\",\\n        \\\"createdAt\\\": \\\"2024-01-10T00:00:00Z\\\"\\n      }\\n    ],\\n    \\\"pagination\\\": {\\n      \\\"total\\\": 25,\\n      \\\"page\\\": 1,\\n      \\\"limit\\\": 20,\\n      \\\"totalPages\\\": 2\\n    }\\n  }\\n}\\n```\\n\\n#### 9.4.2 分配流失预警处理人\\n```\\nPUT /api/v1/churn-alerts/{alertId}/assign\\n\\nRequest:\\n{\\n  \\\"assignedTo\\\": \\\"userId123\\\"\\n}\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"id\\\": \\\"xxx\\\",\\n    \\\"assignedTo\\\": \\\"userId123\\\",\\n    \\\"status\\\": \\\"in_progress\\\",\\n    \\\"assignedAt\\\": \\\"2024-01-15T10:00:00Z\\\"\\n  }\\n}\\n```\\n\\n#### 9.4.3 更新流失预警状态\\n```\\nPUT /api/v1/churn-alerts/{alertId}/resolve\\n\\nRequest:\\n{\\n  \\\"status\\\": \\\"resolved\\\",\\n  \\\"resolutionNotes\\\": \\\"已联系客户，问题已解决\\\"\\n}\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"id\\\": \\\"xxx\\\",\\n    \\\"status\\\": \\\"resolved\\\",\\n    \\\"resolutionNotes\\\": \\\"已联系客户，问题已解决\\\",\\n    \\\"resolvedAt\\\": \\\"2024-01-15T15:00:00Z\\\"\\n  }\\n}\\n```\\n\\n### 9.5 生命周期数据看板接口\\n\\n#### 9.5.1 获取生命周期概览数据\\n```\\nGET /api/v1/analytics/lifecycle/overview?startDate=2024-01-01&endDate=2024-01-31\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"overview\\\": {\\n      \\\"totalCustomers\\\": 10000,\\n      \\\"activeCustomers\\\": 6500,\\n      \\\"churnedCustomers\\\": 500,\\n      \\\"retentionRate\\\": 0.95,\\n      \\\"averageCLV\\\": 2500,\\n      \\\"satisfactionScore\\\": 4.3\\n    },\\n    \\\"stageDistribution\\\": [\\n      {\\n        \\\"stage\\\": \\\"potential\\\",\\n        \\\"count\\\": 2000,\\n        \\\"percentage\\\": 0.2,\\n        \\\"change\\\": 0.05\\n      },\\n      {\\n        \\\"stage\\\": \\\"new_customer\\\",\\n        \\\"count\\\": 1500,\\n        \\\"percentage\\\": 0.15,\\n        \\\"change\\\": 0.03\\n      }\\n    ],\\n    \\\"valueDistribution\\\": [\\n      {\\n        \\\"level\\\": \\\"vip\\\",\\n        \\\"count\\\": 1500,\\n        \\\"avgRFMScore\\\": 4.2\\n      }\\n    ],\\n    \\\"churnAlerts\\\": {\\n      \\\"high\\\": 25,\\n      \\\"medium\\\": 50,\\n      \\\"low\\\": 75\\n    }\\n  }\\n}\\n```\\n\\n## 十、技术实现要点\\n\\n### 10.1 前端技术栈\\n- Vue 3 + TypeScript\\n- Element Plus UI组件库\\n- ECharts数据可视化\\n- Pinia状态管理\\n- Vue Router路由管理\\n\\n### 10.2 后端技术栈\\n- Node.js + Express\\n- TypeScript\\n- PostgreSQL数据库\\n- Redis缓存\\n- 定时任务（node-cron）\\n\\n### 10.3 性能优化\\n- RFM评分计算缓存（Redis）\\n- 规则引擎结果缓存\\n- 数据预加载\\n- 虚拟滚动优化列表\\n- 分页加载\\n\\n### 10.4 安全性\\n- 数据加密传输（HTTPS）\\n- 敏感信息脱敏\\n- 访问权限控制\\n- 操作日志记录\\n- 数据备份\\n\\n## 十一、测试计划\\n\\n### 11.1 单元测试\\n- 生命周期流转规则测试\\n- RFM模型计算测试\\n- 流失预测模型测试\\n- 关怀提醒引擎测试\\n\\n### 11.2 集成测试\\n- 客户生命周期流转端到端测试\\n- 关怀提醒发送测试\\n- 流失预警处理测试\\n\\n### 11.3 性能测试\\n- 大规模客户数据处理测试\\n- 规则引擎性能测试\\n- 并发访问测试\\n\\n## 十二、上线计划\\n\\n### 12.1 阶段一：基础功能（1-2周）\\n- 客户生命周期阶段划分\\n- RFM模型实现\\n- 基础数据看板\\n\\n### 12.2 阶段二：智能功能（2-3周）\\n- 自动流转规则引擎\\n- 关怀提醒功能\\n- 流失预警机制\\n\\n### 12.3 阶段三：优化完善（1-2周）\\n- 数据可视化优化\\n- 性能优化\\n- 用户反馈收集与改进\\n\\n### 12.4 阶段四：全面推广（持续）\\n- 全员培训\\n- 数据监控\\n- 持续优化迭代\\n\\n---\\n\\n**文档版本**: v1.0.0\\n**创建日期**: 2025-01-20\\n**最后更新**: 2025-01-20\\n**文档状态**: 已完成\\n\",\"originTextLength\":26445,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768910410112}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/composables/useLifecycleRuleEngine.ts": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":465,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":465,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"/**\\\\n * @fileoverview YYC³餐饮管理系统 - 客户生命周期规则引擎\\\\n * @description 实现客户生命周期自动流转规则引擎\\\\n * @module lifecycle-rule-engine\\\\n * @author YYC³\\\\n * @version 1.0.0\\\\n * @created 2025-01-20\\\\n */\\\\n\\\\nimport { ref, reactive } from \\\\'vue\\\\'\\\\nimport { ElMessage } from \\\\'element-plus\\\\'\\\\n\\\\nexport interface LifecycleRule {\\\\n  id: string\\\\n  name: string\\\\n  description: string\\\\n  fromStage: string[]\\\\n  toStage: string\\\\n  conditions: RuleCondition[]\\\\n  priority: number\\\\n  enabled: boolean\\\\n  createdAt: Date\\\\n  updatedAt: Date\\\\n}\\\\n\\\\nexport interface RuleCondition {\\\\n  field: string\\\\n  operator: \\\\'eq\\\\' | \\\\'ne\\\\' | \\\\'gt\\\\' | \\\\'lt\\\\' | \\\\'gte\\\\' | \\\\'lte\\\\' | \\\\'in\\\\' | \\\\'not_in\\\\'\\\\n  value: any\\\\n  logicalOperator?: \\\\'AND\\\\' | \\\\'OR\\\\'\\\\n}\\\\n\\\\nexport interface RuleResult {\\\\n  rule: LifecycleRule\\\\n  matched: boolean\\\\n  timestamp: Date\\\\n}\\\\n\\\\nexport interface CustomerEvent {\\\\n  type: \\\\'order\\\\' | \\\\'register\\\\' | \\\\'interaction\\\\' | \\\\'satisfaction\\\\' | \\\\'custom\\\\'\\\\n  customerId: string\\\\n  data: any\\\\n  timestamp: Date\\\\n}\\\\n\\\\nexport interface Customer {\\\\n  id: string\\\\n  name: string\\\\n  lifecycleStage: string\\\\n  lastOrderDate: Date | null\\\\n  orderCount: number\\\\n  totalSpent: number\\\\n  satisfactionScore: number\\\\n  registeredAt: Date\\\\n  [key: string]: any\\\\n}\\\\n\\\\nclass LifecycleRuleEngine {\\\\n  private rules: LifecycleRule[]\\\\n  private eventCallbacks: Map<string, Function[]>\\\\n\\\\n  constructor() {\\\\n    this.rules = []\\\\n    this.eventCallbacks = new Map()\\\\n    this.initializeDefaultRules()\\\\n  }\\\\n\\\\n  private initializeDefaultRules(): void {\\\\n    this.rules = [\\\\n      {\\\\n        id: \\\\'RULE_001\\\\',\\\\n        name: \\\\'潜在客户转新客户\\\\',\\\\n        description: \\\\'首次消费后自动转为新客户\\\\',\\\\n        fromStage: [\\\\'potential\\\\'],\\\\n        toStage: \\\\'new_customer\\\\',\\\\n        conditions: [\\\\n          {\\\\n            field: \\\\'event.type\\\\',\\\\n            operator: \\\\'eq\\\\',\\\\n            value: \\\\'order\\\\'\\\\n          },\\\\n          {\\\\n            field: \\\\'orderCount\\\\',\\\\n            operator: \\\\'gte\\\\',\\\\n            value: 1,\\\\n            logicalOperator: \\\\'AND\\\\'\\\\n          }\\\\n        ],\\\\n        priority: 1,\\\\n        enabled: true,\\\\n        createdAt: new Date(),\\\\n        updatedAt: new Date()\\\\n      },\\\\n      {\\\\n        id: \\\\'RULE_002\\\\',\\\\n        name: \\\\'新客户转活跃客户\\\\',\\\\n        description: \\\\'消费3次且消费7天后转为活跃客户\\\\',\\\\n        fromStage: [\\\\'new_customer\\\\'],\\\\n        toStage: \\\\'active\\\\',\\\\n        conditions: [\\\\n          {\\\\n            field: \\\\'orderCount\\\\',\\\\n            operator: \\\\'gte\\\\',\\\\n            value: 3\\\\n          },\\\\n          {\\\\n            field: \\\\'daysSinceFirstOrder\\\\',\\\\n            operator: \\\\'gte\\\\',\\\\n            value: 7,\\\\n            logicalOperator: \\\\'AND\\\\'\\\\n          },\\\\n          {\\\\n            field: \\\\'daysSinceLastOrder\\\\',\\\\n            operator: \\\\'lte\\\\',\\\\n            value: 30,\\\\n            logicalOperator: \\\\'AND\\\\'\\\\n          }\\\\n        ],\\\\n        priority: 2,\\\\n        enabled: true,\\\\n        createdAt: new Date(),\\\\n        updatedAt: new Date()\\\\n      },\\\\n      {\\\\n        id: \\\\'RULE_003\\\\',\\\\n        name: \\\\'活跃客户转忠诚客户\\\\',\\\\n        description: \\\\'消费10次且累计消费2000元后转为忠诚客户\\\\',\\\\n        fromStage: [\\\\'active\\\\'],\\\\n        toStage: \\\\'loyal\\\\',\\\\n        conditions: [\\\\n          {\\\\n            field: \\\\'orderCount\\\\',\\\\n            operator: \\\\'gte\\\\',\\\\n            value: 10\\\\n          },\\\\n          {\\\\n            field: \\\\'totalSpent\\\\',\\\\n            operator: \\\\'gte\\\\',\\\\n            value: 2000,\\\\n            logicalOperator: \\\\'AND\\\\'\\\\n          },\\\\n          {\\\\n            field: \\\\'daysSinceLastOrder\\\\',\\\\n            operator: \\\\'lte\\\\',\\\\n            value: 90,\\\\n            logicalOperator: \\\\'AND\\\\'\\\\n          },\\\\n          {\\\\n            field: \\\\'satisfactionScore\\\\',\\\\n            operator: \\\\'gte\\\\',\\\\n            value: 4.5,\\\\n            logicalOperator: \\\\'AND\\\\'\\\\n          }\\\\n        ],\\\\n        priority: 3,\\\\n        enabled: true,\\\\n        createdAt: new Date(),\\\\n        updatedAt: new Date()\\\\n      },\\\\n      {\\\\n        id: \\\\'RULE_004\\\\',\\\\n        name: \\\\'活跃客户转休眠客户\\\\',\\\\n        description: \\\\'超过30天未消费转为休眠客户\\\\',\\\\n        fromStage: [\\\\'active\\\\'],\\\\n        toStage: \\\\'dormant\\\\',\\\\n        conditions: [\\\\n          {\\\\n            field: \\\\'daysSinceLastOrder\\\\',\\\\n            operator: \\\\'gt\\\\',\\\\n            value: 30\\\\n          }\\\\n        ],\\\\n        priority: 4,\\\\n        enabled: true,\\\\n        createdAt: new Date(),\\\\n        updatedAt: new Date()\\\\n      },\\\\n      {\\\\n        id: \\\\'RULE_005\\\\',\\\\n        name: \\\\'忠诚客户转休眠客户\\\\',\\\\n        description: \\\\'超过60天未消费转为休眠客户\\\\',\\\\n        fromStage: [\\\\'loyal\\\\'],\\\\n        toStage: \\\\'dormant\\\\',\\\\n        conditions: [\\\\n          {\\\\n            field: \\\\'daysSinceLastOrder\\\\',\\\\n            operator: \\\\'gt\\\\',\\\\n            value: 60\\\\n          }\\\\n        ],\\\\n        priority: 5,\\\\n        enabled: true,\\\\n        createdAt: new Date(),\\\\n        updatedAt: new Date()\\\\n      },\\\\n      {\\\\n        id: \\\\'RULE_006\\\\',\\\\n        name: \\\\'休眠客户转流失客户\\\\',\\\\n        description: \\\\'超过90天未消费且唤醒失败3次转为流失客户\\\\',\\\\n        fromStage: [\\\\'dormant\\\\'],\\\\n        toStage: \\\\'churned\\\\',\\\\n        conditions: [\\\\n          {\\\\n            field: \\\\'daysSinceLastOrder\\\\',\\\\n            operator: \\\\'gt\\\\',\\\\n            value: 90\\\\n          },\\\\n          {\\\\n            field: \\\\'wakeupAttempts\\\\',\\\\n            operator: \\\\'gte\\\\',\\\\n            value: 3,\\\\n            logicalOperator: \\\\'AND\\\\'\\\\n          }\\\\n        ],\\\\n        priority: 6,\\\\n        enabled: true,\\\\n        createdAt: new Date(),\\\\n        updatedAt: new Date()\\\\n      },\\\\n      {\\\\n        id: \\\\'RULE_007\\\\',\\\\n        name: \\\\'休眠客户转活跃客户\\\\',\\\\n        description: \\\\'休眠客户重新消费后转为活跃客户\\\\',\\\\n        fromStage: [\\\\'dormant\\\\'],\\\\n        toStage: \\\\'active\\\\',\\\\n        conditions: [\\\\n          {\\\\n            field: \\\\'event.type\\\\',\\\\n            operator: \\\\'eq\\\\',\\\\n            value: \\\\'order\\\\'\\\\n          }\\\\n        ],\\\\n        priority: 7,\\\\n        enabled: true,\\\\n        createdAt: new Date(),\\\\n        updatedAt: new Date()\\\\n      },\\\\n      {\\\\n        id: \\\\'RULE_008\\\\',\\\\n        name: \\\\'流失客户转新客户\\\\',\\\\n        description: \\\\'流失客户重新消费后转为新客户\\\\',\\\\n        fromStage: [\\\\'churned\\\\'],\\\\n        toStage: \\\\'new_customer\\\\',\\\\n        conditions: [\\\\n          {\\\\n            field: \\\\'event.type\\\\',\\\\n            operator: \\\\'eq\\\\',\\\\n            value: \\\\'order\\\\'\\\\n          }\\\\n        ],\\\\n        priority: 8,\\\\n        enabled: true,\\\\n        createdAt: new Date(),\\\\n        updatedAt: new Date()\\\\n      }\\\\n    ]\\\\n  }\\\\n\\\\n  async evaluate(customer: Customer, event: CustomerEvent): Promise<RuleResult[]> {\\\\n    const applicableRules = this.rules.filter(rule =>\\\\n      rule.fromStage.includes(customer.lifecycleStage) && rule.enabled\\\\n    )\\\\n\\\\n    const results: RuleResult[] = []\\\\n    for (const rule of applicableRules) {\\\\n      const matched = await this.evaluateConditions(rule.conditions, customer, event)\\\\n      if (matched) {\\\\n        results.push({\\\\n          rule,\\\\n          matched: true,\\\\n          timestamp: new Date()\\\\n        })\\\\n      }\\\\n    }\\\\n\\\\n    return results.sort((a, b) => b.rule.priority - a.rule.priority)\\\\n  }\\\\n\\\\n  private async evaluateConditions(\\\\n    conditions: RuleCondition[],\\\\n    customer: Customer,\\\\n    event: CustomerEvent\\\\n  ): Promise<boolean> {\\\\n    if (conditions.length === 0) return true\\\\n\\\\n    let result = true\\\\n    let currentOperator: \\\\'AND\\\\' | \\\\'OR\\\\' = \\\\'AND\\\\'\\\\n\\\\n    for (const condition of conditions) {\\\\n      const conditionResult = this.evaluateCondition(condition, customer, event)\\\\n      currentOperator = condition.logicalOperator || \\\\'AND\\\\'\\\\n\\\\n      if (currentOperator === \\\\'AND\\\\') {\\\\n        result = result && conditionResult\\\\n      } else {\\\\n        result = result || conditionResult\\\\n      }\\\\n    }\\\\n\\\\n    return result\\\\n  }\\\\n\\\\n  private evaluateCondition(\\\\n    condition: RuleCondition,\\\\n    customer: Customer,\\\\n    event: CustomerEvent\\\\n  ): boolean {\\\\n    const fieldValue = this.getFieldValue(condition.field, customer, event)\\\\n\\\\n    switch (condition.operator) {\\\\n      case \\\\'eq\\\\':\\\\n        return fieldValue === condition.value\\\\n      case \\\\'ne\\\\':\\\\n        return fieldValue !== condition.value\\\\n      case \\\\'gt\\\\':\\\\n        return fieldValue > condition.value\\\\n      case \\\\'lt\\\\':\\\\n        return fieldValue < condition.value\\\\n      case \\\\'gte\\\\':\\\\n        return fieldValue >= condition.value\\\\n      case \\\\'lte\\\\':\\\\n        return fieldValue <= condition.value\\\\n      case \\\\'in\\\\':\\\\n        return Array.isArray(condition.value) && condition.value.includes(fieldValue)\\\\n      case \\\\'not_in\\\\':\\\\n        return Array.isArray(condition.value) && !condition.value.includes(fieldValue)\\\\n      default:\\\\n        return false\\\\n    }\\\\n  }\\\\n\\\\n  private getFieldValue(field: string, customer: Customer, event: CustomerEvent): any {\\\\n    const fieldPath = field.split(\\\\'.\\\\')\\\\n    let value: any = { ...customer, event }\\\\n\\\\n    for (const key of fieldPath) {\\\\n      value = value?.[key]\\\\n    }\\\\n\\\\n    if (field === \\\\'daysSinceLastOrder\\\\' && customer.lastOrderDate) {\\\\n      return Math.floor(\\\\n        (Date.now() - new Date(customer.lastOrderDate).getTime()) / (1000 * 60 * 60 * 24)\\\\n      )\\\\n    }\\\\n\\\\n    if (field === \\\\'daysSinceFirstOrder\\\\' && customer.registeredAt) {\\\\n      return Math.floor(\\\\n        (Date.now() - new Date(customer.registeredAt).getTime()) / (1000 * 60 * 60 * 24)\\\\n      )\\\\n    }\\\\n\\\\n    return value\\\\n  }\\\\n\\\\n  addRule(rule: LifecycleRule): void {\\\\n    this.rules.push(rule)\\\\n    this.sortRules()\\\\n  }\\\\n\\\\n  updateRule(ruleId: string, updates: Partial<LifecycleRule>): void {\\\\n    const index = this.rules.findIndex(r => r.id === ruleId)\\\\n    if (index !== -1) {\\\\n      this.rules[index] = { ...this.rules[index], ...updates, updatedAt: new Date() }\\\\n      this.sortRules()\\\\n    }\\\\n  }\\\\n\\\\n  deleteRule(ruleId: string): void {\\\\n    this.rules = this.rules.filter(r => r.id !== ruleId)\\\\n  }\\\\n\\\\n  enableRule(ruleId: string): void {\\\\n    const rule = this.rules.find(r => r.id === ruleId)\\\\n    if (rule) {\\\\n      rule.enabled = true\\\\n      rule.updatedAt = new Date()\\\\n    }\\\\n  }\\\\n\\\\n  disableRule(ruleId: string): void {\\\\n    const rule = this.rules.find(r => r.id === ruleId)\\\\n    if (rule) {\\\\n      rule.enabled = false\\\\n      rule.updatedAt = new Date()\\\\n    }\\\\n  }\\\\n\\\\n  getRules(): LifecycleRule[] {\\\\n    return [...this.rules]\\\\n  }\\\\n\\\\n  getRule(ruleId: string): LifecycleRule | undefined {\\\\n    return this.rules.find(r => r.id === ruleId)\\\\n  }\\\\n\\\\n  private sortRules(): void {\\\\n    this.rules.sort((a, b) => b.priority - a.priority)\\\\n  }\\\\n\\\\n  on(event: string, callback: Function): void {\\\\n    if (!this.eventCallbacks.has(event)) {\\\\n      this.eventCallbacks.set(event, [])\\\\n    }\\\\n    this.eventCallbacks.get(event)?.push(callback)\\\\n  }\\\\n\\\\n  emit(event: string, data: any): void {\\\\n    const callbacks = this.eventCallbacks.get(event) || []\\\\n    callbacks.forEach(callback => callback(data))\\\\n  }\\\\n}\\\\n\\\\nconst ruleEngine = new LifecycleRuleEngine()\\\\n\\\\nexport function useLifecycleRuleEngine() {\\\\n  const loading = ref(false)\\\\n  const rules = ref<LifecycleRule[]>([])\\\\n  const transitionHistory = ref<any[]>([])\\\\n\\\\n  const loadRules = async () => {\\\\n    loading.value = true\\\\n    try {\\\\n      rules.value = ruleEngine.getRules()\\\\n    } catch (error) {\\\\n      console.error(\\\\'Load rules failed:\\\\', error)\\\\n      ElMessage.error(\\\\'加载规则失败\\\\')\\\\n    } finally {\\\\n      loading.value = false\\\\n    }\\\\n  }\\\\n\\\\n  const evaluateCustomer = async (customer: Customer, event: CustomerEvent) => {\\\\n    loading.value = true\\\\n    try {\\\\n      const results = await ruleEngine.evaluate(customer, event)\\\\n      if (results.length > 0) {\\\\n        const topResult = results[0]\\\\n        await executeTransition(customer, topResult)\\\\n      }\\\\n      return results\\\\n    } catch (error) {\\\\n      console.error(\\\\'Evaluate customer failed:\\\\', error)\\\\n      ElMessage.error(\\\\'评估客户失败\\\\')\\\\n      return []\\\\n    } finally {\\\\n      loading.value = false\\\\n    }\\\\n  }\\\\n\\\\n  const executeTransition = async (customer: Customer, result: RuleResult) => {\\\\n    try {\\\\n      const transition = {\\\\n        customerId: customer.id,\\\\n        fromStage: customer.lifecycleStage,\\\\n        toStage: result.rule.toStage,\\\\n        ruleId: result.rule.id,\\\\n        reason: result.rule.description,\\\\n        timestamp: result.timestamp\\\\n      }\\\\n\\\\n      transitionHistory.value.unshift(transition)\\\\n      \\\\n      ruleEngine.emit(\\\\'stageTransition\\\\', transition)\\\\n      \\\\n      ElMessage.success(`客户 ${customer.name} 已从 ${customer.lifecycleStage} 转为 ${result.rule.toStage}`)\\\\n    } catch (error) {\\\\n      console.error(\\\\'Execute transition failed:\\\\', error)\\\\n      ElMessage.error(\\\\'执行流转失败\\\\')\\\\n    }\\\\n  }\\\\n\\\\n  const addRule = (rule: LifecycleRule) => {\\\\n    ruleEngine.addRule(rule)\\\\n    loadRules()\\\\n    ElMessage.success(\\\\'规则添加成功\\\\')\\\\n  }\\\\n\\\\n  const updateRule = (ruleId: string, updates: Partial<LifecycleRule>) => {\\\\n    ruleEngine.updateRule(ruleId, updates)\\\\n    loadRules()\\\\n    ElMessage.success(\\\\'规则更新成功\\\\')\\\\n  }\\\\n\\\\n  const deleteRule = (ruleId: string) => {\\\\n    ruleEngine.deleteRule(ruleId)\\\\n    loadRules()\\\\n    ElMessage.success(\\\\'规则删除成功\\\\')\\\\n  }\\\\n\\\\n  const toggleRule = (ruleId: string, enabled: boolean) => {\\\\n    if (enabled) {\\\\n      ruleEngine.enableRule(ruleId)\\\\n    } else {\\\\n      ruleEngine.disableRule(ruleId)\\\\n    }\\\\n    loadRules()\\\\n  }\\\\n\\\\n  return {\\\\n    loading,\\\\n    rules,\\\\n    transitionHistory,\\\\n    loadRules,\\\\n    evaluateCustomer,\\\\n    addRule,\\\\n    updateRule,\\\\n    deleteRule,\\\\n    toggleRule\\\\n  }\\\\n}\\\\n\",\"originAcceptText\":\"/**\\n * @fileoverview YYC³餐饮管理系统 - 客户生命周期规则引擎\\n * @description 实现客户生命周期自动流转规则引擎\\n * @module lifecycle-rule-engine\\n * @author YYC³\\n * @version 1.0.0\\n * @created 2025-01-20\\n */\\n\\nimport { ref, reactive } from 'vue'\\nimport { ElMessage } from 'element-plus'\\n\\nexport interface LifecycleRule {\\n  id: string\\n  name: string\\n  description: string\\n  fromStage: string[]\\n  toStage: string\\n  conditions: RuleCondition[]\\n  priority: number\\n  enabled: boolean\\n  createdAt: Date\\n  updatedAt: Date\\n}\\n\\nexport interface RuleCondition {\\n  field: string\\n  operator: 'eq' | 'ne' | 'gt' | 'lt' | 'gte' | 'lte' | 'in' | 'not_in'\\n  value: any\\n  logicalOperator?: 'AND' | 'OR'\\n}\\n\\nexport interface RuleResult {\\n  rule: LifecycleRule\\n  matched: boolean\\n  timestamp: Date\\n}\\n\\nexport interface CustomerEvent {\\n  type: 'order' | 'register' | 'interaction' | 'satisfaction' | 'custom'\\n  customerId: string\\n  data: any\\n  timestamp: Date\\n}\\n\\nexport interface Customer {\\n  id: string\\n  name: string\\n  lifecycleStage: string\\n  lastOrderDate: Date | null\\n  orderCount: number\\n  totalSpent: number\\n  satisfactionScore: number\\n  registeredAt: Date\\n  [key: string]: any\\n}\\n\\nclass LifecycleRuleEngine {\\n  private rules: LifecycleRule[]\\n  private eventCallbacks: Map<string, Function[]>\\n\\n  constructor() {\\n    this.rules = []\\n    this.eventCallbacks = new Map()\\n    this.initializeDefaultRules()\\n  }\\n\\n  private initializeDefaultRules(): void {\\n    this.rules = [\\n      {\\n        id: 'RULE_001',\\n        name: '潜在客户转新客户',\\n        description: '首次消费后自动转为新客户',\\n        fromStage: ['potential'],\\n        toStage: 'new_customer',\\n        conditions: [\\n          {\\n            field: 'event.type',\\n            operator: 'eq',\\n            value: 'order'\\n          },\\n          {\\n            field: 'orderCount',\\n            operator: 'gte',\\n            value: 1,\\n            logicalOperator: 'AND'\\n          }\\n        ],\\n        priority: 1,\\n        enabled: true,\\n        createdAt: new Date(),\\n        updatedAt: new Date()\\n      },\\n      {\\n        id: 'RULE_002',\\n        name: '新客户转活跃客户',\\n        description: '消费3次且消费7天后转为活跃客户',\\n        fromStage: ['new_customer'],\\n        toStage: 'active',\\n        conditions: [\\n          {\\n            field: 'orderCount',\\n            operator: 'gte',\\n            value: 3\\n          },\\n          {\\n            field: 'daysSinceFirstOrder',\\n            operator: 'gte',\\n            value: 7,\\n            logicalOperator: 'AND'\\n          },\\n          {\\n            field: 'daysSinceLastOrder',\\n            operator: 'lte',\\n            value: 30,\\n            logicalOperator: 'AND'\\n          }\\n        ],\\n        priority: 2,\\n        enabled: true,\\n        createdAt: new Date(),\\n        updatedAt: new Date()\\n      },\\n      {\\n        id: 'RULE_003',\\n        name: '活跃客户转忠诚客户',\\n        description: '消费10次且累计消费2000元后转为忠诚客户',\\n        fromStage: ['active'],\\n        toStage: 'loyal',\\n        conditions: [\\n          {\\n            field: 'orderCount',\\n            operator: 'gte',\\n            value: 10\\n          },\\n          {\\n            field: 'totalSpent',\\n            operator: 'gte',\\n            value: 2000,\\n            logicalOperator: 'AND'\\n          },\\n          {\\n            field: 'daysSinceLastOrder',\\n            operator: 'lte',\\n            value: 90,\\n            logicalOperator: 'AND'\\n          },\\n          {\\n            field: 'satisfactionScore',\\n            operator: 'gte',\\n            value: 4.5,\\n            logicalOperator: 'AND'\\n          }\\n        ],\\n        priority: 3,\\n        enabled: true,\\n        createdAt: new Date(),\\n        updatedAt: new Date()\\n      },\\n      {\\n        id: 'RULE_004',\\n        name: '活跃客户转休眠客户',\\n        description: '超过30天未消费转为休眠客户',\\n        fromStage: ['active'],\\n        toStage: 'dormant',\\n        conditions: [\\n          {\\n            field: 'daysSinceLastOrder',\\n            operator: 'gt',\\n            value: 30\\n          }\\n        ],\\n        priority: 4,\\n        enabled: true,\\n        createdAt: new Date(),\\n        updatedAt: new Date()\\n      },\\n      {\\n        id: 'RULE_005',\\n        name: '忠诚客户转休眠客户',\\n        description: '超过60天未消费转为休眠客户',\\n        fromStage: ['loyal'],\\n        toStage: 'dormant',\\n        conditions: [\\n          {\\n            field: 'daysSinceLastOrder',\\n            operator: 'gt',\\n            value: 60\\n          }\\n        ],\\n        priority: 5,\\n        enabled: true,\\n        createdAt: new Date(),\\n        updatedAt: new Date()\\n      },\\n      {\\n        id: 'RULE_006',\\n        name: '休眠客户转流失客户',\\n        description: '超过90天未消费且唤醒失败3次转为流失客户',\\n        fromStage: ['dormant'],\\n        toStage: 'churned',\\n        conditions: [\\n          {\\n            field: 'daysSinceLastOrder',\\n            operator: 'gt',\\n            value: 90\\n          },\\n          {\\n            field: 'wakeupAttempts',\\n            operator: 'gte',\\n            value: 3,\\n            logicalOperator: 'AND'\\n          }\\n        ],\\n        priority: 6,\\n        enabled: true,\\n        createdAt: new Date(),\\n        updatedAt: new Date()\\n      },\\n      {\\n        id: 'RULE_007',\\n        name: '休眠客户转活跃客户',\\n        description: '休眠客户重新消费后转为活跃客户',\\n        fromStage: ['dormant'],\\n        toStage: 'active',\\n        conditions: [\\n          {\\n            field: 'event.type',\\n            operator: 'eq',\\n            value: 'order'\\n          }\\n        ],\\n        priority: 7,\\n        enabled: true,\\n        createdAt: new Date(),\\n        updatedAt: new Date()\\n      },\\n      {\\n        id: 'RULE_008',\\n        name: '流失客户转新客户',\\n        description: '流失客户重新消费后转为新客户',\\n        fromStage: ['churned'],\\n        toStage: 'new_customer',\\n        conditions: [\\n          {\\n            field: 'event.type',\\n            operator: 'eq',\\n            value: 'order'\\n          }\\n        ],\\n        priority: 8,\\n        enabled: true,\\n        createdAt: new Date(),\\n        updatedAt: new Date()\\n      }\\n    ]\\n  }\\n\\n  async evaluate(customer: Customer, event: CustomerEvent): Promise<RuleResult[]> {\\n    const applicableRules = this.rules.filter(rule =>\\n      rule.fromStage.includes(customer.lifecycleStage) && rule.enabled\\n    )\\n\\n    const results: RuleResult[] = []\\n    for (const rule of applicableRules) {\\n      const matched = await this.evaluateConditions(rule.conditions, customer, event)\\n      if (matched) {\\n        results.push({\\n          rule,\\n          matched: true,\\n          timestamp: new Date()\\n        })\\n      }\\n    }\\n\\n    return results.sort((a, b) => b.rule.priority - a.rule.priority)\\n  }\\n\\n  private async evaluateConditions(\\n    conditions: RuleCondition[],\\n    customer: Customer,\\n    event: CustomerEvent\\n  ): Promise<boolean> {\\n    if (conditions.length === 0) return true\\n\\n    let result = true\\n    let currentOperator: 'AND' | 'OR' = 'AND'\\n\\n    for (const condition of conditions) {\\n      const conditionResult = this.evaluateCondition(condition, customer, event)\\n      currentOperator = condition.logicalOperator || 'AND'\\n\\n      if (currentOperator === 'AND') {\\n        result = result && conditionResult\\n      } else {\\n        result = result || conditionResult\\n      }\\n    }\\n\\n    return result\\n  }\\n\\n  private evaluateCondition(\\n    condition: RuleCondition,\\n    customer: Customer,\\n    event: CustomerEvent\\n  ): boolean {\\n    const fieldValue = this.getFieldValue(condition.field, customer, event)\\n\\n    switch (condition.operator) {\\n      case 'eq':\\n        return fieldValue === condition.value\\n      case 'ne':\\n        return fieldValue !== condition.value\\n      case 'gt':\\n        return fieldValue > condition.value\\n      case 'lt':\\n        return fieldValue < condition.value\\n      case 'gte':\\n        return fieldValue >= condition.value\\n      case 'lte':\\n        return fieldValue <= condition.value\\n      case 'in':\\n        return Array.isArray(condition.value) && condition.value.includes(fieldValue)\\n      case 'not_in':\\n        return Array.isArray(condition.value) && !condition.value.includes(fieldValue)\\n      default:\\n        return false\\n    }\\n  }\\n\\n  private getFieldValue(field: string, customer: Customer, event: CustomerEvent): any {\\n    const fieldPath = field.split('.')\\n    let value: any = { ...customer, event }\\n\\n    for (const key of fieldPath) {\\n      value = value?.[key]\\n    }\\n\\n    if (field === 'daysSinceLastOrder' && customer.lastOrderDate) {\\n      return Math.floor(\\n        (Date.now() - new Date(customer.lastOrderDate).getTime()) / (1000 * 60 * 60 * 24)\\n      )\\n    }\\n\\n    if (field === 'daysSinceFirstOrder' && customer.registeredAt) {\\n      return Math.floor(\\n        (Date.now() - new Date(customer.registeredAt).getTime()) / (1000 * 60 * 60 * 24)\\n      )\\n    }\\n\\n    return value\\n  }\\n\\n  addRule(rule: LifecycleRule): void {\\n    this.rules.push(rule)\\n    this.sortRules()\\n  }\\n\\n  updateRule(ruleId: string, updates: Partial<LifecycleRule>): void {\\n    const index = this.rules.findIndex(r => r.id === ruleId)\\n    if (index !== -1) {\\n      this.rules[index] = { ...this.rules[index], ...updates, updatedAt: new Date() }\\n      this.sortRules()\\n    }\\n  }\\n\\n  deleteRule(ruleId: string): void {\\n    this.rules = this.rules.filter(r => r.id !== ruleId)\\n  }\\n\\n  enableRule(ruleId: string): void {\\n    const rule = this.rules.find(r => r.id === ruleId)\\n    if (rule) {\\n      rule.enabled = true\\n      rule.updatedAt = new Date()\\n    }\\n  }\\n\\n  disableRule(ruleId: string): void {\\n    const rule = this.rules.find(r => r.id === ruleId)\\n    if (rule) {\\n      rule.enabled = false\\n      rule.updatedAt = new Date()\\n    }\\n  }\\n\\n  getRules(): LifecycleRule[] {\\n    return [...this.rules]\\n  }\\n\\n  getRule(ruleId: string): LifecycleRule | undefined {\\n    return this.rules.find(r => r.id === ruleId)\\n  }\\n\\n  private sortRules(): void {\\n    this.rules.sort((a, b) => b.priority - a.priority)\\n  }\\n\\n  on(event: string, callback: Function): void {\\n    if (!this.eventCallbacks.has(event)) {\\n      this.eventCallbacks.set(event, [])\\n    }\\n    this.eventCallbacks.get(event)?.push(callback)\\n  }\\n\\n  emit(event: string, data: any): void {\\n    const callbacks = this.eventCallbacks.get(event) || []\\n    callbacks.forEach(callback => callback(data))\\n  }\\n}\\n\\nconst ruleEngine = new LifecycleRuleEngine()\\n\\nexport function useLifecycleRuleEngine() {\\n  const loading = ref(false)\\n  const rules = ref<LifecycleRule[]>([])\\n  const transitionHistory = ref<any[]>([])\\n\\n  const loadRules = async () => {\\n    loading.value = true\\n    try {\\n      rules.value = ruleEngine.getRules()\\n    } catch (error) {\\n      console.error('Load rules failed:', error)\\n      ElMessage.error('加载规则失败')\\n    } finally {\\n      loading.value = false\\n    }\\n  }\\n\\n  const evaluateCustomer = async (customer: Customer, event: CustomerEvent) => {\\n    loading.value = true\\n    try {\\n      const results = await ruleEngine.evaluate(customer, event)\\n      if (results.length > 0) {\\n        const topResult = results[0]\\n        await executeTransition(customer, topResult)\\n      }\\n      return results\\n    } catch (error) {\\n      console.error('Evaluate customer failed:', error)\\n      ElMessage.error('评估客户失败')\\n      return []\\n    } finally {\\n      loading.value = false\\n    }\\n  }\\n\\n  const executeTransition = async (customer: Customer, result: RuleResult) => {\\n    try {\\n      const transition = {\\n        customerId: customer.id,\\n        fromStage: customer.lifecycleStage,\\n        toStage: result.rule.toStage,\\n        ruleId: result.rule.id,\\n        reason: result.rule.description,\\n        timestamp: result.timestamp\\n      }\\n\\n      transitionHistory.value.unshift(transition)\\n      \\n      ruleEngine.emit('stageTransition', transition)\\n      \\n      ElMessage.success(`客户 ${customer.name} 已从 ${customer.lifecycleStage} 转为 ${result.rule.toStage}`)\\n    } catch (error) {\\n      console.error('Execute transition failed:', error)\\n      ElMessage.error('执行流转失败')\\n    }\\n  }\\n\\n  const addRule = (rule: LifecycleRule) => {\\n    ruleEngine.addRule(rule)\\n    loadRules()\\n    ElMessage.success('规则添加成功')\\n  }\\n\\n  const updateRule = (ruleId: string, updates: Partial<LifecycleRule>) => {\\n    ruleEngine.updateRule(ruleId, updates)\\n    loadRules()\\n    ElMessage.success('规则更新成功')\\n  }\\n\\n  const deleteRule = (ruleId: string) => {\\n    ruleEngine.deleteRule(ruleId)\\n    loadRules()\\n    ElMessage.success('规则删除成功')\\n  }\\n\\n  const toggleRule = (ruleId: string, enabled: boolean) => {\\n    if (enabled) {\\n      ruleEngine.enableRule(ruleId)\\n    } else {\\n      ruleEngine.disableRule(ruleId)\\n    }\\n    loadRules()\\n  }\\n\\n  return {\\n    loading,\\n    rules,\\n    transitionHistory,\\n    loadRules,\\n    evaluateCustomer,\\n    addRule,\\n    updateRule,\\n    deleteRule,\\n    toggleRule\\n  }\\n}\\n\",\"originTextLength\":12473,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768910521056}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/composables/useRFMModel.ts": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":313,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":313,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"/**\\\\n * @fileoverview YYC³餐饮管理系统 - 客户价值评估模型（RFM）\\\\n * @description 实现RFM客户价值评估模型\\\\n * @module rfm-model\\\\n * @author YYC³\\\\n * @version 1.0.0\\\\n * @created 2025-01-20\\\\n */\\\\n\\\\nimport { ref, computed } from \\\\'vue\\\\'\\\\nimport { ElMessage } from \\\\'element-plus\\\\'\\\\n\\\\nexport interface RFMScore {\\\\n  recencyScore: number\\\\n  frequencyScore: number\\\\n  monetaryScore: number\\\\n  totalScore: number\\\\n  customerLevel: string\\\\n  levelLabel: string\\\\n  levelColor: string\\\\n}\\\\n\\\\nexport interface CustomerRFMData {\\\\n  customerId: string\\\\n  customerName: string\\\\n  lastOrderDate: Date | null\\\\n  orderCount: number\\\\n  totalSpent: number\\\\n  averageOrderValue: number\\\\n  registeredAt: Date\\\\n}\\\\n\\\\nexport interface RFMAnalysisResult {\\\\n  customerId: string\\\\n  customerName: string\\\\n  rfmScore: RFMScore\\\\n  segment: string\\\\n  segmentLabel: string\\\\n  recommendations: string[]\\\\n}\\\\n\\\\nclass RFMModel {\\\\n  private readonly RECENCY_WEIGHT = 0.3\\\\n  private readonly FREQUENCY_WEIGHT = 0.4\\\\n  private readonly MONETARY_WEIGHT = 0.3\\\\n\\\\n  calculateRFMScore(customer: CustomerRFMData): RFMScore {\\\\n    const recencyScore = this.calculateRecencyScore(customer.lastOrderDate)\\\\n    const frequencyScore = this.calculateFrequencyScore(customer.orderCount, customer.registeredAt)\\\\n    const monetaryScore = this.calculateMonetaryScore(customer.totalSpent, customer.registeredAt)\\\\n\\\\n    const totalScore =\\\\n      recencyScore * this.RECENCY_WEIGHT +\\\\n      frequencyScore * this.FREQUENCY_WEIGHT +\\\\n      monetaryScore * this.MONETARY_WEIGHT\\\\n\\\\n    const customerLevel = this.getCustomerLevel(totalScore)\\\\n\\\\n    return {\\\\n      recencyScore,\\\\n      frequencyScore,\\\\n      monetaryScore,\\\\n      totalScore: Math.round(totalScore * 10) / 10,\\\\n      customerLevel: customerLevel.level,\\\\n      levelLabel: customerLevel.label,\\\\n      levelColor: customerLevel.color\\\\n    }\\\\n  }\\\\n\\\\n  private calculateRecencyScore(lastOrderDate: Date | null): number {\\\\n    if (!lastOrderDate) return 1\\\\n\\\\n    const daysSinceLastOrder = Math.floor(\\\\n      (Date.now() - new Date(lastOrderDate).getTime()) / (1000 * 60 * 60 * 24)\\\\n    )\\\\n\\\\n    if (daysSinceLastOrder <= 7) return 5\\\\n    if (daysSinceLastOrder <= 14) return 4\\\\n    if (daysSinceLastOrder <= 30) return 3\\\\n    if (daysSinceLastOrder <= 60) return 2\\\\n    return 1\\\\n  }\\\\n\\\\n  private calculateFrequencyScore(orderCount: number, registeredAt: Date): number {\\\\n    const daysSinceRegistration = Math.floor(\\\\n      (Date.now() - new Date(registeredAt).getTime()) / (1000 * 60 * 60 * 24)\\\\n    )\\\\n\\\\n    const monthsSinceRegistration = Math.max(1, daysSinceRegistration / 30)\\\\n    const monthlyOrders = orderCount / monthsSinceRegistration\\\\n\\\\n    if (monthlyOrders >= 8) return 5\\\\n    if (monthlyOrders >= 5) return 4\\\\n    if (monthlyOrders >= 3) return 3\\\\n    if (monthlyOrders >= 1) return 2\\\\n    return 1\\\\n  }\\\\n\\\\n  private calculateMonetaryScore(totalSpent: number, registeredAt: Date): number {\\\\n    const daysSinceRegistration = Math.floor(\\\\n      (Date.now() - new Date(registeredAt).getTime()) / (1000 * 60 * 60 * 24)\\\\n    )\\\\n\\\\n    const monthsSinceRegistration = Math.max(1, daysSinceRegistration / 30)\\\\n    const monthlySpent = totalSpent / monthsSinceRegistration\\\\n\\\\n    if (monthlySpent >= 1000) return 5\\\\n    if (monthlySpent >= 500) return 4\\\\n    if (monthlySpent >= 300) return 3\\\\n    if (monthlySpent >= 100) return 2\\\\n    return 1\\\\n  }\\\\n\\\\n  private getCustomerLevel(totalScore: number): { level: string; label: string; color: string } {\\\\n    if (totalScore >= 4.5) {\\\\n      return { level: \\\\'super_vip\\\\', label: \\\\'超级VIP\\\\', color: \\\\'#F56C6C\\\\' }\\\\n    }\\\\n    if (totalScore >= 3.5) {\\\\n      return { level: \\\\'vip\\\\', label: \\\\'VIP\\\\', color: \\\\'#E6A23C\\\\' }\\\\n    }\\\\n    if (totalScore >= 2.5) {\\\\n      return { level: \\\\'member\\\\', label: \\\\'会员\\\\', color: \\\\'#409EFF\\\\' }\\\\n    }\\\\n    if (totalScore >= 1.5) {\\\\n      return { level: \\\\'regular\\\\', label: \\\\'普通\\\\', color: \\\\'#67C23A\\\\' }\\\\n    }\\\\n    return { level: \\\\'low_value\\\\', label: \\\\'低价值\\\\', color: \\\\'#909399\\\\' }\\\\n  }\\\\n\\\\n  analyzeCustomer(customer: CustomerRFMData): RFMAnalysisResult {\\\\n    const rfmScore = this.calculateRFMScore(customer)\\\\n    const segment = this.getCustomerSegment(rfmScore)\\\\n    const recommendations = this.generateRecommendations(rfmScore, segment)\\\\n\\\\n    return {\\\\n      customerId: customer.customerId,\\\\n      customerName: customer.customerName,\\\\n      rfmScore,\\\\n      segment,\\\\n      segmentLabel: this.getSegmentLabel(segment),\\\\n      recommendations\\\\n    }\\\\n  }\\\\n\\\\n  private getCustomerSegment(rfmScore: RFMScore): string {\\\\n    if (rfmScore.customerLevel === \\\\'super_vip\\\\' || rfmScore.customerLevel === \\\\'vip\\\\') {\\\\n      if (rfmScore.recencyScore >= 4 && rfmScore.frequencyScore >= 4) {\\\\n        return \\\\'high_value_loyal\\\\'\\\\n      }\\\\n      return \\\\'high_value\\\\'\\\\n    }\\\\n\\\\n    if (rfmScore.recencyScore >= 4 && rfmScore.frequencyScore >= 4) {\\\\n      return \\\\'frequent\\\\'\\\\n    }\\\\n\\\\n    if (rfmScore.recencyScore >= 4) {\\\\n      return \\\\'new_active\\\\'\\\\n    }\\\\n\\\\n    if (rfmScore.frequencyScore >= 4) {\\\\n      return \\\\'loyal\\\\'\\\\n    }\\\\n\\\\n    if (rfmScore.recencyScore <= 2 && rfmScore.frequencyScore <= 2) {\\\\n      return \\\\'at_risk\\\\'\\\\n    }\\\\n\\\\n    if (rfmScore.recencyScore <= 2) {\\\\n      return \\\\'dormant\\\\'\\\\n    }\\\\n\\\\n    return \\\\'regular\\\\'\\\\n  }\\\\n\\\\n  private getSegmentLabel(segment: string): string {\\\\n    const labels: Record<string, string> = {\\\\n      high_value_loyal: \\\\'高价值忠诚客户\\\\',\\\\n      high_value: \\\\'高价值客户\\\\',\\\\n      frequent: \\\\'高频客户\\\\',\\\\n      new_active: \\\\'新活跃客户\\\\',\\\\n      loyal: \\\\'忠诚客户\\\\',\\\\n      at_risk: \\\\'流失风险客户\\\\',\\\\n      dormant: \\\\'休眠客户\\\\',\\\\n      regular: \\\\'普通客户\\\\'\\\\n    }\\\\n    return labels[segment] || \\\\'未知\\\\'\\\\n  }\\\\n\\\\n  private generateRecommendations(rfmScore: RFMScore, segment: string): string[] {\\\\n    const recommendations: string[] = []\\\\n\\\\n    if (segment === \\\\'high_value_loyal\\\\') {\\\\n      recommendations.push(\\\\'提供VIP专属服务\\\\')\\\\n      recommendations.push(\\\\'邀请参与新品体验\\\\')\\\\n      recommendations.push(\\\\'发放专属优惠券\\\\')\\\\n    } else if (segment === \\\\'high_value\\\\') {\\\\n      recommendations.push(\\\\'提升消费频次\\\\')\\\\n      recommendations.push(\\\\'推荐高价值商品\\\\')\\\\n      recommendations.push(\\\\'提供会员升级\\\\')\\\\n    } else if (segment === \\\\'frequent\\\\') {\\\\n      recommendations.push(\\\\'提升客单价\\\\')\\\\n      recommendations.push(\\\\'推荐套餐组合\\\\')\\\\n      recommendations.push(\\\\'发放积分奖励\\\\')\\\\n    } else if (segment === \\\\'new_active\\\\') {\\\\n      recommendations.push(\\\\'引导二次消费\\\\')\\\\n      recommendations.push(\\\\'介绍会员权益\\\\')\\\\n      recommendations.push(\\\\'发放新客优惠券\\\\')\\\\n    } else if (segment === \\\\'loyal\\\\') {\\\\n      recommendations.push(\\\\'保持服务质量\\\\')\\\\n      recommendations.push(\\\\'定期关怀\\\\')\\\\n      recommendations.push(\\\\'发放忠诚奖励\\\\')\\\\n    } else if (segment === \\\\'at_risk\\\\') {\\\\n      recommendations.push(\\\\'立即联系客户\\\\')\\\\n      recommendations.push(\\\\'了解流失原因\\\\')\\\\n      recommendations.push(\\\\'提供挽留优惠\\\\')\\\\n    } else if (segment === \\\\'dormant\\\\') {\\\\n      recommendations.push(\\\\'发送唤醒优惠券\\\\')\\\\n      recommendations.push(\\\\'个性化推荐\\\\')\\\\n      recommendations.push(\\\\'安排客服回访\\\\')\\\\n    } else {\\\\n      recommendations.push(\\\\'提升消费频次\\\\')\\\\n      recommendations.push(\\\\'增加客户互动\\\\')\\\\n      recommendations.push(\\\\'优化产品推荐\\\\')\\\\n    }\\\\n\\\\n    return recommendations\\\\n  }\\\\n\\\\n  batchCalculate(customers: CustomerRFMData[]): RFMAnalysisResult[] {\\\\n    return customers.map(customer => this.analyzeCustomer(customer))\\\\n  }\\\\n\\\\n  getSegmentStatistics(results: RFMAnalysisResult[]): any {\\\\n    const segmentCounts: Record<string, number> = {}\\\\n    const segmentScores: Record<string, number[]> = {}\\\\n\\\\n    results.forEach(result => {\\\\n      if (!segmentCounts[result.segment]) {\\\\n        segmentCounts[result.segment] = 0\\\\n        segmentScores[result.segment] = []\\\\n      }\\\\n      segmentCounts[result.segment]++\\\\n      segmentScores[result.segment].push(result.rfmScore.totalScore)\\\\n    })\\\\n\\\\n    const total = results.length\\\\n    const statistics = Object.keys(segmentCounts).map(segment => {\\\\n      const scores = segmentScores[segment]\\\\n      const avgScore = scores.length > 0\\\\n        ? scores.reduce((sum, score) => sum + score, 0) / scores.length\\\\n        : 0\\\\n\\\\n      return {\\\\n        segment,\\\\n        segmentLabel: this.getSegmentLabel(segment),\\\\n        count: segmentCounts[segment],\\\\n        percentage: Math.round((segmentCounts[segment] / total) * 100),\\\\n        avgRFMScore: Math.round(avgScore * 10) / 10\\\\n      }\\\\n    })\\\\n\\\\n    return statistics.sort((a, b) => b.count - a.count)\\\\n  }\\\\n}\\\\n\\\\nconst rfmModel = new RFMModel()\\\\n\\\\nexport function useRFMModel() {\\\\n  const loading = ref(false)\\\\n  const currentRFMScore = ref<RFMScore | null>(null)\\\\n  const analysisResults = ref<RFMAnalysisResult[]>([])\\\\n  const segmentStatistics = ref<any[]>([])\\\\n\\\\n  const calculateCustomerRFM = (customer: CustomerRFMData): RFMScore => {\\\\n    try {\\\\n      const score = rfmModel.calculateRFMScore(customer)\\\\n      currentRFMScore.value = score\\\\n      return score\\\\n    } catch (error) {\\\\n      console.error(\\\\'Calculate RFM score failed:\\\\', error)\\\\n      ElMessage.error(\\\\'计算RFM评分失败\\\\')\\\\n      throw error\\\\n    }\\\\n  }\\\\n\\\\n  const analyzeCustomer = (customer: CustomerRFMData): RFMAnalysisResult => {\\\\n    try {\\\\n      const result = rfmModel.analyzeCustomer(customer)\\\\n      return result\\\\n    } catch (error) {\\\\n      console.error(\\\\'Analyze customer failed:\\\\', error)\\\\n      ElMessage.error(\\\\'分析客户失败\\\\')\\\\n      throw error\\\\n    }\\\\n  }\\\\n\\\\n  const batchAnalyze = async (customers: CustomerRFMData[]) => {\\\\n    loading.value = true\\\\n    try {\\\\n      const results = rfmModel.batchCalculate(customers)\\\\n      analysisResults.value = results\\\\n      segmentStatistics.value = rfmModel.getSegmentStatistics(results)\\\\n      return results\\\\n    } catch (error) {\\\\n      console.error(\\\\'Batch analyze failed:\\\\', error)\\\\n      ElMessage.error(\\\\'批量分析失败\\\\')\\\\n      return []\\\\n    } finally {\\\\n      loading.value = false\\\\n    }\\\\n  }\\\\n\\\\n  const getRecencyLabel = (score: number): string => {\\\\n    const labels = [\\\\'>60天\\\\', \\\\'31-60天\\\\', \\\\'15-30天\\\\', \\\\'8-14天\\\\', \\\\'0-7天\\\\']\\\\n    return labels[score - 1] || \\\\'未知\\\\'\\\\n  }\\\\n\\\\n  const getFrequencyLabel = (score: number): string => {\\\\n    const labels = [\\\\'0次/月\\\\', \\\\'1-2次/月\\\\', \\\\'3-4次/月\\\\', \\\\'5-7次/月\\\\', \\\\'≥8次/月\\\\']\\\\n    return labels[score - 1] || \\\\'未知\\\\'\\\\n  }\\\\n\\\\n  const getMonetaryLabel = (score: number): string => {\\\\n    const labels = [\\\\'<100元/月\\\\', \\\\'100-299元/月\\\\', \\\\'300-499元/月\\\\', \\\\'500-999元/月\\\\', \\\\'≥1000元/月\\\\']\\\\n    return labels[score - 1] || \\\\'未知\\\\'\\\\n  }\\\\n\\\\n  const getScoreColor = (score: number): string => {\\\\n    if (score >= 4.5) return \\\\'#F56C6C\\\\'\\\\n    if (score >= 3.5) return \\\\'#E6A23C\\\\'\\\\n    if (score >= 2.5) return \\\\'#409EFF\\\\'\\\\n    if (score >= 1.5) return \\\\'#67C23A\\\\'\\\\n    return \\\\'#909399\\\\'\\\\n  }\\\\n\\\\n  const getLevelIcon = (level: string): string => {\\\\n    const icons: Record<string, string> = {\\\\n      super_vip: \\\\'Crown\\\\',\\\\n      vip: \\\\'Star\\\\',\\\\n      member: \\\\'User\\\\',\\\\n      regular: \\\\'UserFilled\\\\',\\\\n      low_value: \\\\'User\\\\'\\\\n    }\\\\n    return icons[level] || \\\\'User\\\\'\\\\n  }\\\\n\\\\n  return {\\\\n    loading,\\\\n    currentRFMScore,\\\\n    analysisResults,\\\\n    segmentStatistics,\\\\n    calculateCustomerRFM,\\\\n    analyzeCustomer,\\\\n    batchAnalyze,\\\\n    getRecencyLabel,\\\\n    getFrequencyLabel,\\\\n    getMonetaryLabel,\\\\n    getScoreColor,\\\\n    getLevelIcon\\\\n  }\\\\n}\\\\n\",\"originAcceptText\":\"/**\\n * @fileoverview YYC³餐饮管理系统 - 客户价值评估模型（RFM）\\n * @description 实现RFM客户价值评估模型\\n * @module rfm-model\\n * @author YYC³\\n * @version 1.0.0\\n * @created 2025-01-20\\n */\\n\\nimport { ref, computed } from 'vue'\\nimport { ElMessage } from 'element-plus'\\n\\nexport interface RFMScore {\\n  recencyScore: number\\n  frequencyScore: number\\n  monetaryScore: number\\n  totalScore: number\\n  customerLevel: string\\n  levelLabel: string\\n  levelColor: string\\n}\\n\\nexport interface CustomerRFMData {\\n  customerId: string\\n  customerName: string\\n  lastOrderDate: Date | null\\n  orderCount: number\\n  totalSpent: number\\n  averageOrderValue: number\\n  registeredAt: Date\\n}\\n\\nexport interface RFMAnalysisResult {\\n  customerId: string\\n  customerName: string\\n  rfmScore: RFMScore\\n  segment: string\\n  segmentLabel: string\\n  recommendations: string[]\\n}\\n\\nclass RFMModel {\\n  private readonly RECENCY_WEIGHT = 0.3\\n  private readonly FREQUENCY_WEIGHT = 0.4\\n  private readonly MONETARY_WEIGHT = 0.3\\n\\n  calculateRFMScore(customer: CustomerRFMData): RFMScore {\\n    const recencyScore = this.calculateRecencyScore(customer.lastOrderDate)\\n    const frequencyScore = this.calculateFrequencyScore(customer.orderCount, customer.registeredAt)\\n    const monetaryScore = this.calculateMonetaryScore(customer.totalSpent, customer.registeredAt)\\n\\n    const totalScore =\\n      recencyScore * this.RECENCY_WEIGHT +\\n      frequencyScore * this.FREQUENCY_WEIGHT +\\n      monetaryScore * this.MONETARY_WEIGHT\\n\\n    const customerLevel = this.getCustomerLevel(totalScore)\\n\\n    return {\\n      recencyScore,\\n      frequencyScore,\\n      monetaryScore,\\n      totalScore: Math.round(totalScore * 10) / 10,\\n      customerLevel: customerLevel.level,\\n      levelLabel: customerLevel.label,\\n      levelColor: customerLevel.color\\n    }\\n  }\\n\\n  private calculateRecencyScore(lastOrderDate: Date | null): number {\\n    if (!lastOrderDate) return 1\\n\\n    const daysSinceLastOrder = Math.floor(\\n      (Date.now() - new Date(lastOrderDate).getTime()) / (1000 * 60 * 60 * 24)\\n    )\\n\\n    if (daysSinceLastOrder <= 7) return 5\\n    if (daysSinceLastOrder <= 14) return 4\\n    if (daysSinceLastOrder <= 30) return 3\\n    if (daysSinceLastOrder <= 60) return 2\\n    return 1\\n  }\\n\\n  private calculateFrequencyScore(orderCount: number, registeredAt: Date): number {\\n    const daysSinceRegistration = Math.floor(\\n      (Date.now() - new Date(registeredAt).getTime()) / (1000 * 60 * 60 * 24)\\n    )\\n\\n    const monthsSinceRegistration = Math.max(1, daysSinceRegistration / 30)\\n    const monthlyOrders = orderCount / monthsSinceRegistration\\n\\n    if (monthlyOrders >= 8) return 5\\n    if (monthlyOrders >= 5) return 4\\n    if (monthlyOrders >= 3) return 3\\n    if (monthlyOrders >= 1) return 2\\n    return 1\\n  }\\n\\n  private calculateMonetaryScore(totalSpent: number, registeredAt: Date): number {\\n    const daysSinceRegistration = Math.floor(\\n      (Date.now() - new Date(registeredAt).getTime()) / (1000 * 60 * 60 * 24)\\n    )\\n\\n    const monthsSinceRegistration = Math.max(1, daysSinceRegistration / 30)\\n    const monthlySpent = totalSpent / monthsSinceRegistration\\n\\n    if (monthlySpent >= 1000) return 5\\n    if (monthlySpent >= 500) return 4\\n    if (monthlySpent >= 300) return 3\\n    if (monthlySpent >= 100) return 2\\n    return 1\\n  }\\n\\n  private getCustomerLevel(totalScore: number): { level: string; label: string; color: string } {\\n    if (totalScore >= 4.5) {\\n      return { level: 'super_vip', label: '超级VIP', color: '#F56C6C' }\\n    }\\n    if (totalScore >= 3.5) {\\n      return { level: 'vip', label: 'VIP', color: '#E6A23C' }\\n    }\\n    if (totalScore >= 2.5) {\\n      return { level: 'member', label: '会员', color: '#409EFF' }\\n    }\\n    if (totalScore >= 1.5) {\\n      return { level: 'regular', label: '普通', color: '#67C23A' }\\n    }\\n    return { level: 'low_value', label: '低价值', color: '#909399' }\\n  }\\n\\n  analyzeCustomer(customer: CustomerRFMData): RFMAnalysisResult {\\n    const rfmScore = this.calculateRFMScore(customer)\\n    const segment = this.getCustomerSegment(rfmScore)\\n    const recommendations = this.generateRecommendations(rfmScore, segment)\\n\\n    return {\\n      customerId: customer.customerId,\\n      customerName: customer.customerName,\\n      rfmScore,\\n      segment,\\n      segmentLabel: this.getSegmentLabel(segment),\\n      recommendations\\n    }\\n  }\\n\\n  private getCustomerSegment(rfmScore: RFMScore): string {\\n    if (rfmScore.customerLevel === 'super_vip' || rfmScore.customerLevel === 'vip') {\\n      if (rfmScore.recencyScore >= 4 && rfmScore.frequencyScore >= 4) {\\n        return 'high_value_loyal'\\n      }\\n      return 'high_value'\\n    }\\n\\n    if (rfmScore.recencyScore >= 4 && rfmScore.frequencyScore >= 4) {\\n      return 'frequent'\\n    }\\n\\n    if (rfmScore.recencyScore >= 4) {\\n      return 'new_active'\\n    }\\n\\n    if (rfmScore.frequencyScore >= 4) {\\n      return 'loyal'\\n    }\\n\\n    if (rfmScore.recencyScore <= 2 && rfmScore.frequencyScore <= 2) {\\n      return 'at_risk'\\n    }\\n\\n    if (rfmScore.recencyScore <= 2) {\\n      return 'dormant'\\n    }\\n\\n    return 'regular'\\n  }\\n\\n  private getSegmentLabel(segment: string): string {\\n    const labels: Record<string, string> = {\\n      high_value_loyal: '高价值忠诚客户',\\n      high_value: '高价值客户',\\n      frequent: '高频客户',\\n      new_active: '新活跃客户',\\n      loyal: '忠诚客户',\\n      at_risk: '流失风险客户',\\n      dormant: '休眠客户',\\n      regular: '普通客户'\\n    }\\n    return labels[segment] || '未知'\\n  }\\n\\n  private generateRecommendations(rfmScore: RFMScore, segment: string): string[] {\\n    const recommendations: string[] = []\\n\\n    if (segment === 'high_value_loyal') {\\n      recommendations.push('提供VIP专属服务')\\n      recommendations.push('邀请参与新品体验')\\n      recommendations.push('发放专属优惠券')\\n    } else if (segment === 'high_value') {\\n      recommendations.push('提升消费频次')\\n      recommendations.push('推荐高价值商品')\\n      recommendations.push('提供会员升级')\\n    } else if (segment === 'frequent') {\\n      recommendations.push('提升客单价')\\n      recommendations.push('推荐套餐组合')\\n      recommendations.push('发放积分奖励')\\n    } else if (segment === 'new_active') {\\n      recommendations.push('引导二次消费')\\n      recommendations.push('介绍会员权益')\\n      recommendations.push('发放新客优惠券')\\n    } else if (segment === 'loyal') {\\n      recommendations.push('保持服务质量')\\n      recommendations.push('定期关怀')\\n      recommendations.push('发放忠诚奖励')\\n    } else if (segment === 'at_risk') {\\n      recommendations.push('立即联系客户')\\n      recommendations.push('了解流失原因')\\n      recommendations.push('提供挽留优惠')\\n    } else if (segment === 'dormant') {\\n      recommendations.push('发送唤醒优惠券')\\n      recommendations.push('个性化推荐')\\n      recommendations.push('安排客服回访')\\n    } else {\\n      recommendations.push('提升消费频次')\\n      recommendations.push('增加客户互动')\\n      recommendations.push('优化产品推荐')\\n    }\\n\\n    return recommendations\\n  }\\n\\n  batchCalculate(customers: CustomerRFMData[]): RFMAnalysisResult[] {\\n    return customers.map(customer => this.analyzeCustomer(customer))\\n  }\\n\\n  getSegmentStatistics(results: RFMAnalysisResult[]): any {\\n    const segmentCounts: Record<string, number> = {}\\n    const segmentScores: Record<string, number[]> = {}\\n\\n    results.forEach(result => {\\n      if (!segmentCounts[result.segment]) {\\n        segmentCounts[result.segment] = 0\\n        segmentScores[result.segment] = []\\n      }\\n      segmentCounts[result.segment]++\\n      segmentScores[result.segment].push(result.rfmScore.totalScore)\\n    })\\n\\n    const total = results.length\\n    const statistics = Object.keys(segmentCounts).map(segment => {\\n      const scores = segmentScores[segment]\\n      const avgScore = scores.length > 0\\n        ? scores.reduce((sum, score) => sum + score, 0) / scores.length\\n        : 0\\n\\n      return {\\n        segment,\\n        segmentLabel: this.getSegmentLabel(segment),\\n        count: segmentCounts[segment],\\n        percentage: Math.round((segmentCounts[segment] / total) * 100),\\n        avgRFMScore: Math.round(avgScore * 10) / 10\\n      }\\n    })\\n\\n    return statistics.sort((a, b) => b.count - a.count)\\n  }\\n}\\n\\nconst rfmModel = new RFMModel()\\n\\nexport function useRFMModel() {\\n  const loading = ref(false)\\n  const currentRFMScore = ref<RFMScore | null>(null)\\n  const analysisResults = ref<RFMAnalysisResult[]>([])\\n  const segmentStatistics = ref<any[]>([])\\n\\n  const calculateCustomerRFM = (customer: CustomerRFMData): RFMScore => {\\n    try {\\n      const score = rfmModel.calculateRFMScore(customer)\\n      currentRFMScore.value = score\\n      return score\\n    } catch (error) {\\n      console.error('Calculate RFM score failed:', error)\\n      ElMessage.error('计算RFM评分失败')\\n      throw error\\n    }\\n  }\\n\\n  const analyzeCustomer = (customer: CustomerRFMData): RFMAnalysisResult => {\\n    try {\\n      const result = rfmModel.analyzeCustomer(customer)\\n      return result\\n    } catch (error) {\\n      console.error('Analyze customer failed:', error)\\n      ElMessage.error('分析客户失败')\\n      throw error\\n    }\\n  }\\n\\n  const batchAnalyze = async (customers: CustomerRFMData[]) => {\\n    loading.value = true\\n    try {\\n      const results = rfmModel.batchCalculate(customers)\\n      analysisResults.value = results\\n      segmentStatistics.value = rfmModel.getSegmentStatistics(results)\\n      return results\\n    } catch (error) {\\n      console.error('Batch analyze failed:', error)\\n      ElMessage.error('批量分析失败')\\n      return []\\n    } finally {\\n      loading.value = false\\n    }\\n  }\\n\\n  const getRecencyLabel = (score: number): string => {\\n    const labels = ['>60天', '31-60天', '15-30天', '8-14天', '0-7天']\\n    return labels[score - 1] || '未知'\\n  }\\n\\n  const getFrequencyLabel = (score: number): string => {\\n    const labels = ['0次/月', '1-2次/月', '3-4次/月', '5-7次/月', '≥8次/月']\\n    return labels[score - 1] || '未知'\\n  }\\n\\n  const getMonetaryLabel = (score: number): string => {\\n    const labels = ['<100元/月', '100-299元/月', '300-499元/月', '500-999元/月', '≥1000元/月']\\n    return labels[score - 1] || '未知'\\n  }\\n\\n  const getScoreColor = (score: number): string => {\\n    if (score >= 4.5) return '#F56C6C'\\n    if (score >= 3.5) return '#E6A23C'\\n    if (score >= 2.5) return '#409EFF'\\n    if (score >= 1.5) return '#67C23A'\\n    return '#909399'\\n  }\\n\\n  const getLevelIcon = (level: string): string => {\\n    const icons: Record<string, string> = {\\n      super_vip: 'Crown',\\n      vip: 'Star',\\n      member: 'User',\\n      regular: 'UserFilled',\\n      low_value: 'User'\\n    }\\n    return icons[level] || 'User'\\n  }\\n\\n  return {\\n    loading,\\n    currentRFMScore,\\n    analysisResults,\\n    segmentStatistics,\\n    calculateCustomerRFM,\\n    analyzeCustomer,\\n    batchAnalyze,\\n    getRecencyLabel,\\n    getFrequencyLabel,\\n    getMonetaryLabel,\\n    getScoreColor,\\n    getLevelIcon\\n  }\\n}\\n\",\"originTextLength\":10500,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768910667139}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/composables/useCareReminder.ts": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":648,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":648,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"/**\\\\n * @fileoverview YYC³餐饮管理系统 - 智能客户关怀提醒功能\\\\n * @description 实现智能客户关怀提醒引擎\\\\n * @module care-reminder-engine\\\\n * @author YYC³\\\\n * @version 1.0.0\\\\n * @created 2025-01-20\\\\n */\\\\n\\\\nimport { ref, computed } from \\\\'vue\\\\'\\\\nimport { ElMessage } from \\\\'element-plus\\\\'\\\\n\\\\nexport interface CareReminderRule {\\\\n  id: string\\\\n  name: string\\\\n  description: string\\\\n  triggerType: \\\\'event\\\\' | \\\\'schedule\\\\' | \\\\'condition\\\\'\\\\n  triggerCondition: any\\\\n  careType: string\\\\n  contentTemplate: string\\\\n  channels: string[]\\\\n  priority: number\\\\n  enabled: boolean\\\\n  createdAt: Date\\\\n  updatedAt: Date\\\\n}\\\\n\\\\nexport interface CareReminder {\\\\n  id: string\\\\n  customerId: string\\\\n  customerName: string\\\\n  customerPhone: string\\\\n  customerEmail: string\\\\n  ruleId: string\\\\n  careType: string\\\\n  content: string\\\\n  channels: string[]\\\\n  scheduledAt: Date\\\\n  sentAt: Date | null\\\\n  status: \\\\'pending\\\\' | \\\\'sent\\\\' | \\\\'failed\\\\'\\\\n  response: string | null\\\\n  effectivenessScore: number | null\\\\n  createdAt: Date\\\\n  updatedAt: Date\\\\n}\\\\n\\\\nexport interface Customer {\\\\n  id: string\\\\n  name: string\\\\n  phone: string\\\\n  email: string\\\\n  birthday: Date | null\\\\n  lifecycleStage: string\\\\n  lastOrderDate: Date | null\\\\n  orderCount: number\\\\n  totalSpent: number\\\\n  satisfactionScore: number\\\\n  registeredAt: Date\\\\n}\\\\n\\\\nclass CareReminderEngine {\\\\n  private rules: CareReminderRule[]\\\\n  private reminders: CareReminder[]\\\\n\\\\n  constructor() {\\\\n    this.rules = []\\\\n    this.reminders = []\\\\n    this.initializeDefaultRules()\\\\n  }\\\\n\\\\n  private initializeDefaultRules(): void {\\\\n    this.rules = [\\\\n      {\\\\n        id: \\\\'CARE_001\\\\',\\\\n        name: \\\\'新客户关怀\\\\',\\\\n        description: \\\\'客户首次消费后24小时内发送欢迎消息\\\\',\\\\n        triggerType: \\\\'event\\\\',\\\\n        triggerCondition: {\\\\n          eventType: \\\\'first_order\\\\',\\\\n          hoursAfter: 24\\\\n        },\\\\n        careType: \\\\'welcome\\\\',\\\\n        contentTemplate: \\\\'亲爱的{name}，感谢您首次光临YYC³！我们为您准备了新客专属优惠券，期待您的再次光临！\\\\',\\\\n        channels: [\\\\'sms\\\\', \\\\'push\\\\'],\\\\n        priority: 1,\\\\n        enabled: true,\\\\n        createdAt: new Date(),\\\\n        updatedAt: new Date()\\\\n      },\\\\n      {\\\\n        id: \\\\'CARE_002\\\\',\\\\n        name: \\\\'生日关怀\\\\',\\\\n        description: \\\\'客户生日当天发送生日祝福和专属优惠\\\\',\\\\n        triggerType: \\\\'schedule\\\\',\\\\n        triggerCondition: {\\\\n          schedule: \\\\'birthday\\\\',\\\\n          time: \\\\'09:00\\\\'\\\\n        },\\\\n        careType: \\\\'birthday\\\\',\\\\n        contentTemplate: \\\\'亲爱的{name}，生日快乐！YYC³祝您生日快乐，特为您准备生日专属优惠券和免费小礼品！\\\\',\\\\n        channels: [\\\\'sms\\\\', \\\\'push\\\\', \\\\'email\\\\'],\\\\n        priority: 2,\\\\n        enabled: true,\\\\n        createdAt: new Date(),\\\\n        updatedAt: new Date()\\\\n      },\\\\n      {\\\\n        id: \\\\'CARE_003\\\\',\\\\n        name: \\\\'节日关怀\\\\',\\\\n        description: \\\\'重要节日发送节日祝福和优惠\\\\',\\\\n        triggerType: \\\\'schedule\\\\',\\\\n        triggerCondition: {\\\\n          schedule: \\\\'holiday\\\\',\\\\n          holidays: [\\\\'spring_festival\\\\', \\\\'mid_autumn\\\\', \\\\'national_day\\\\']\\\\n        },\\\\n        careType: \\\\'holiday\\\\',\\\\n        contentTemplate: \\\\'亲爱的{name}，{holiday}快乐！YYC³祝您节日愉快，特推出节日特色菜品和优惠活动！\\\\',\\\\n        channels: [\\\\'sms\\\\', \\\\'push\\\\'],\\\\n        priority: 3,\\\\n        enabled: true,\\\\n        createdAt: new Date(),\\\\n        updatedAt: new Date()\\\\n      },\\\\n      {\\\\n        id: \\\\'CARE_004\\\\',\\\\n        name: \\\\'消费频次下降提醒\\\\',\\\\n        description: \\\\'客户消费频次下降超过50%时发送关怀\\\\',\\\\n        triggerType: \\\\'condition\\\\',\\\\n        triggerCondition: {\\\\n          field: \\\\'orderFrequencyChange\\\\',\\\\n          operator: \\\\'lt\\\\',\\\\n          value: -0.5\\\\n        },\\\\n        careType: \\\\'frequency_drop\\\\',\\\\n        contentTemplate: \\\\'亲爱的{name}，最近很少见到您，是有什么不满意的地方吗？我们为您准备了专属优惠券，期待您的光临！\\\\',\\\\n        channels: [\\\\'sms\\\\', \\\\'push\\\\'],\\\\n        priority: 4,\\\\n        enabled: true,\\\\n        createdAt: new Date(),\\\\n        updatedAt: new Date()\\\\n      },\\\\n      {\\\\n        id: \\\\'CARE_005\\\\',\\\\n        name: \\\\'长期未消费提醒\\\\',\\\\n        description: \\\\'客户30天未消费时发送唤醒消息\\\\',\\\\n        triggerType: \\\\'condition\\\\',\\\\n        triggerCondition: {\\\\n          field: \\\\'daysSinceLastOrder\\\\',\\\\n          operator: \\\\'gte\\\\',\\\\n          value: 30\\\\n        },\\\\n        careType: \\\\'inactive\\\\',\\\\n        contentTemplate: \\\\'亲爱的{name}，好久不见！我们很想念您，特准备了唤醒优惠券，期待您的回归！\\\\',\\\\n        channels: [\\\\'sms\\\\', \\\\'push\\\\', \\\\'email\\\\'],\\\\n        priority: 5,\\\\n        enabled: true,\\\\n        createdAt: new Date(),\\\\n        updatedAt: new Date()\\\\n      },\\\\n      {\\\\n        id: \\\\'CARE_006\\\\',\\\\n        name: \\\\'VIP客户专属关怀\\\\',\\\\n        description: \\\\'VIP客户每月定期关怀\\\\',\\\\n        triggerType: \\\\'schedule\\\\',\\\\n        triggerCondition: {\\\\n          schedule: \\\\'monthly\\\\',\\\\n          day: 1,\\\\n          customerLevel: [\\\\'vip\\\\', \\\\'super_vip\\\\']\\\\n        },\\\\n        careType: \\\\'vip_care\\\\',\\\\n        contentTemplate: \\\\'尊敬的VIP客户{name}，感谢您一直以来的支持！本月为您准备了专属权益和新品优先体验机会！\\\\',\\\\n        channels: [\\\\'sms\\\\', \\\\'push\\\\', \\\\'email\\\\'],\\\\n        priority: 6,\\\\n        enabled: true,\\\\n        createdAt: new Date(),\\\\n        updatedAt: new Date()\\\\n      },\\\\n      {\\\\n        id: \\\\'CARE_007\\\\',\\\\n        name: \\\\'满意度跟进\\\\',\\\\n        description: \\\\'客户消费后3天发送满意度调研\\\\',\\\\n        triggerType: \\\\'event\\\\',\\\\n        triggerCondition: {\\\\n          eventType: \\\\'order_completed\\\\',\\\\n          daysAfter: 3\\\\n        },\\\\n        careType: \\\\'satisfaction\\\\',\\\\n        contentTemplate: \\\\'亲爱的{name}，感谢您最近的光临！我们非常重视您的用餐体验，期待您的反馈！\\\\',\\\\n        channels: [\\\\'sms\\\\', \\\\'push\\\\'],\\\\n        priority: 7,\\\\n        enabled: true,\\\\n        createdAt: new Date(),\\\\n        updatedAt: new Date()\\\\n      },\\\\n      {\\\\n        id: \\\\'CARE_008\\\\',\\\\n        name: \\\\'会员升级提醒\\\\',\\\\n        description: \\\\'客户达到会员升级标准时发送恭喜消息\\\\',\\\\n        triggerType: \\\\'condition\\\\',\\\\n        triggerCondition: {\\\\n          field: \\\\'canUpgrade\\\\',\\\\n          operator: \\\\'eq\\\\',\\\\n          value: true\\\\n        },\\\\n        careType: \\\\'upgrade\\\\',\\\\n        contentTemplate: \\\\'恭喜{name}！您已达到{newLevel}会员标准，升级后将享受更多专属权益！\\\\',\\\\n        channels: [\\\\'sms\\\\', \\\\'push\\\\', \\\\'email\\\\'],\\\\n        priority: 8,\\\\n        enabled: true,\\\\n        createdAt: new Date(),\\\\n        updatedAt: new Date()\\\\n      }\\\\n    ]\\\\n  }\\\\n\\\\n  async processCustomerEvent(customer: Customer, event: any): Promise<CareReminder[]> {\\\\n    const triggeredReminders: CareReminder[] = []\\\\n\\\\n    for (const rule of this.rules) {\\\\n      if (!rule.enabled) continue\\\\n\\\\n      const shouldTrigger = await this.evaluateTrigger(rule, customer, event)\\\\n      if (shouldTrigger) {\\\\n        const reminder = await this.createReminder(customer, rule)\\\\n        triggeredReminders.push(reminder)\\\\n        this.reminders.push(reminder)\\\\n      }\\\\n    }\\\\n\\\\n    return triggeredReminders\\\\n  }\\\\n\\\\n  private async evaluateTrigger(\\\\n    rule: CareReminderRule,\\\\n    customer: Customer,\\\\n    event: any\\\\n  ): Promise<boolean> {\\\\n    switch (rule.triggerType) {\\\\n      case \\\\'event\\\\':\\\\n        return this.evaluateEventTrigger(rule.triggerCondition, event)\\\\n      case \\\\'schedule\\\\':\\\\n        return this.evaluateScheduleTrigger(rule.triggerCondition, customer)\\\\n      case \\\\'condition\\\\':\\\\n        return this.evaluateConditionTrigger(rule.triggerCondition, customer)\\\\n      default:\\\\n        return false\\\\n    }\\\\n  }\\\\n\\\\n  private evaluateEventTrigger(condition: any, event: any): boolean {\\\\n    if (!event) return false\\\\n\\\\n    if (condition.eventType === \\\\'first_order\\\\' && event.type === \\\\'first_order\\\\') {\\\\n      const hoursSinceOrder = this.getHoursSince(event.timestamp)\\\\n      return hoursSinceOrder <= condition.hoursAfter\\\\n    }\\\\n\\\\n    if (condition.eventType === \\\\'order_completed\\\\' && event.type === \\\\'order_completed\\\\') {\\\\n      const daysSinceOrder = this.getDaysSince(event.timestamp)\\\\n      return daysSinceOrder <= condition.daysAfter\\\\n    }\\\\n\\\\n    return false\\\\n  }\\\\n\\\\n  private evaluateScheduleTrigger(condition: any, customer: Customer): boolean {\\\\n    const now = new Date()\\\\n\\\\n    if (condition.schedule === \\\\'birthday\\\\' && customer.birthday) {\\\\n      const birthday = new Date(customer.birthday)\\\\n      const today = new Date(now.getFullYear(), now.getMonth(), now.getDate())\\\\n      const birthdayThisYear = new Date(now.getFullYear(), birthday.getMonth(), birthday.getDate())\\\\n      return today.getTime() === birthdayThisYear.getTime()\\\\n    }\\\\n\\\\n    if (condition.schedule === \\\\'monthly\\\\' && condition.day) {\\\\n      return now.getDate() === condition.day && condition.customerLevel?.includes(customer.lifecycleStage)\\\\n    }\\\\n\\\\n    if (condition.schedule === \\\\'holiday\\\\') {\\\\n      const today = now.getMonth() + 1 + \\\\'-\\\\' + now.getDate()\\\\n      const holidays: Record<string, string> = {\\\\n        \\\\'1-1\\\\': \\\\'spring_festival\\\\',\\\\n        \\\\'9-15\\\\': \\\\'mid_autumn\\\\',\\\\n        \\\\'10-1\\\\': \\\\'national_day\\\\'\\\\n      }\\\\n      return condition.holidays?.includes(holidays[today])\\\\n    }\\\\n\\\\n    return false\\\\n  }\\\\n\\\\n  private evaluateConditionTrigger(condition: any, customer: Customer): boolean {\\\\n    if (condition.field === \\\\'daysSinceLastOrder\\\\') {\\\\n      const daysSinceLastOrder = this.getDaysSince(customer.lastOrderDate)\\\\n      return this.compareValue(daysSinceLastOrder, condition.operator, condition.value)\\\\n    }\\\\n\\\\n    if (condition.field === \\\\'orderFrequencyChange\\\\') {\\\\n      const currentFrequency = this.calculateMonthlyFrequency(customer, 30)\\\\n      const previousFrequency = this.calculateMonthlyFrequency(customer, 90)\\\\n      const change = (currentFrequency - previousFrequency) / previousFrequency\\\\n      return this.compareValue(change, condition.operator, condition.value)\\\\n    }\\\\n\\\\n    if (condition.field === \\\\'canUpgrade\\\\') {\\\\n      return this.canUpgradeCustomer(customer)\\\\n    }\\\\n\\\\n    return false\\\\n  }\\\\n\\\\n  private compareValue(\\\\n    actual: number,\\\\n    operator: string,\\\\n    expected: number\\\\n  ): boolean {\\\\n    switch (operator) {\\\\n      case \\\\'eq\\\\':\\\\n        return actual === expected\\\\n      case \\\\'ne\\\\':\\\\n        return actual !== expected\\\\n      case \\\\'gt\\\\':\\\\n        return actual > expected\\\\n      case \\\\'lt\\\\':\\\\n        return actual < expected\\\\n      case \\\\'gte\\\\':\\\\n        return actual >= expected\\\\n      case \\\\'lte\\\\':\\\\n        return actual <= expected\\\\n      default:\\\\n        return false\\\\n    }\\\\n  }\\\\n\\\\n  private getHoursSince(date: Date | null): number {\\\\n    if (!date) return Infinity\\\\n    return Math.floor((Date.now() - new Date(date).getTime()) / (1000 * 60 * 60))\\\\n  }\\\\n\\\\n  private getDaysSince(date: Date | null): number {\\\\n    if (!date) return Infinity\\\\n    return Math.floor((Date.now() - new Date(date).getTime()) / (1000 * 60 * 60 * 24))\\\\n  }\\\\n\\\\n  private calculateMonthlyFrequency(customer: Customer, days: number): number {\\\\n    if (days <= 0) return 0\\\\n    return (customer.orderCount / days) * 30\\\\n  }\\\\n\\\\n  private canUpgradeCustomer(customer: Customer): boolean {\\\\n    if (customer.lifecycleStage === \\\\'regular\\\\' && customer.orderCount >= 3 && customer.totalSpent >= 500) {\\\\n      return true\\\\n    }\\\\n    if (customer.lifecycleStage === \\\\'member\\\\' && customer.orderCount >= 10 && customer.totalSpent >= 2000) {\\\\n      return true\\\\n    }\\\\n    return false\\\\n  }\\\\n\\\\n  private async createReminder(\\\\n    customer: Customer,\\\\n    rule: CareReminderRule\\\\n  ): Promise<CareReminder> {\\\\n    const content = this.generateContent(rule.contentTemplate, customer, rule)\\\\n\\\\n    return {\\\\n      id: this.generateId(),\\\\n      customerId: customer.id,\\\\n      customerName: customer.name,\\\\n      customerPhone: customer.phone,\\\\n      customerEmail: customer.email,\\\\n      ruleId: rule.id,\\\\n      careType: rule.careType,\\\\n      content,\\\\n      channels: rule.channels,\\\\n      scheduledAt: this.calculateScheduledTime(rule),\\\\n      sentAt: null,\\\\n      status: \\\\'pending\\\\',\\\\n      response: null,\\\\n      effectivenessScore: null,\\\\n      createdAt: new Date(),\\\\n      updatedAt: new Date()\\\\n    }\\\\n  }\\\\n\\\\n  private generateContent(\\\\n    template: string,\\\\n    customer: Customer,\\\\n    rule: CareReminderRule\\\\n  ): string {\\\\n    let content = template\\\\n      .replace(\\\\'{name}\\\\', customer.name)\\\\n      .replace(\\\\'{level}\\\\', this.getLevelLabel(customer.lifecycleStage))\\\\n      .replace(\\\\'{lastOrderDate}\\\\', this.formatDate(customer.lastOrderDate))\\\\n\\\\n    if (rule.careType === \\\\'upgrade\\\\') {\\\\n      const newLevel = this.getNextLevel(customer.lifecycleStage)\\\\n      content = content.replace(\\\\'{newLevel}\\\\', newLevel)\\\\n    }\\\\n\\\\n    if (rule.careType === \\\\'holiday\\\\') {\\\\n      const holiday = this.getCurrentHoliday()\\\\n      content = content.replace(\\\\'{holiday}\\\\', holiday)\\\\n    }\\\\n\\\\n    return content\\\\n  }\\\\n\\\\n  private calculateScheduledTime(rule: CareReminderRule): Date {\\\\n    const now = new Date()\\\\n\\\\n    if (rule.triggerType === \\\\'event\\\\') {\\\\n      return new Date(now.getTime() + 60 * 1000)\\\\n    }\\\\n\\\\n    if (rule.triggerType === \\\\'schedule\\\\') {\\\\n      if (rule.triggerCondition.schedule === \\\\'birthday\\\\') {\\\\n        return new Date(now.getFullYear(), now.getMonth(), now.getDate(), 9, 0, 0)\\\\n      }\\\\n      if (rule.triggerCondition.schedule === \\\\'monthly\\\\') {\\\\n        const nextMonth = now.getMonth() + 1\\\\n        return new Date(now.getFullYear(), nextMonth, rule.triggerCondition.day, 9, 0, 0)\\\\n      }\\\\n    }\\\\n\\\\n    return new Date(now.getTime() + 60 * 1000)\\\\n  }\\\\n\\\\n  private getLevelLabel(stage: string): string {\\\\n    const labels: Record<string, string> = {\\\\n      potential: \\\\'潜在客户\\\\',\\\\n      new_customer: \\\\'新客户\\\\',\\\\n      active: \\\\'活跃客户\\\\',\\\\n      loyal: \\\\'忠诚客户\\\\',\\\\n      dormant: \\\\'休眠客户\\\\',\\\\n      churned: \\\\'流失客户\\\\'\\\\n    }\\\\n    return labels[stage] || \\\\'客户\\\\'\\\\n  }\\\\n\\\\n  private getNextLevel(currentStage: string): string {\\\\n    const levels = [\\\\'regular\\\\', \\\\'member\\\\', \\\\'vip\\\\', \\\\'super_vip\\\\']\\\\n    const currentIndex = levels.indexOf(currentStage)\\\\n    if (currentIndex < levels.length - 1) {\\\\n      return this.getLevelLabel(levels[currentIndex + 1])\\\\n    }\\\\n    return this.getLevelLabel(currentStage)\\\\n  }\\\\n\\\\n  private getCurrentHoliday(): string {\\\\n    const now = new Date()\\\\n    const date = now.getMonth() + 1 + \\\\'-\\\\' + now.getDate()\\\\n    const holidays: Record<string, string> = {\\\\n      \\\\'1-1\\\\': \\\\'春节\\\\',\\\\n      \\\\'9-15\\\\': \\\\'中秋节\\\\',\\\\n      \\\\'10-1\\\\': \\\\'国庆节\\\\'\\\\n    }\\\\n    return holidays[date] || \\\\'\\\\'\\\\n  }\\\\n\\\\n  private formatDate(date: Date | null): string {\\\\n    if (!date) return \\\\'从未\\\\'\\\\n    return new Date(date).toLocaleDateString(\\\\'zh-CN\\\\')\\\\n  }\\\\n\\\\n  private generateId(): string {\\\\n    return \\\\'REM_\\\\' + Date.now() + \\\\'_\\\\' + Math.random().toString(36).substr(2, 9)\\\\n  }\\\\n\\\\n  async sendReminder(reminder: CareReminder): Promise<boolean> {\\\\n    try {\\\\n      for (const channel of reminder.channels) {\\\\n        await this.sendToChannel(reminder, channel)\\\\n      }\\\\n\\\\n      reminder.sentAt = new Date()\\\\n      reminder.status = \\\\'sent\\\\'\\\\n      reminder.updatedAt = new Date()\\\\n\\\\n      return true\\\\n    } catch (error) {\\\\n      console.error(\\\\'Send reminder failed:\\\\', error)\\\\n      reminder.status = \\\\'failed\\\\'\\\\n      reminder.updatedAt = new Date()\\\\n      return false\\\\n    }\\\\n  }\\\\n\\\\n  private async sendToChannel(reminder: CareReminder, channel: string): Promise<void> {\\\\n    switch (channel) {\\\\n      case \\\\'sms\\\\':\\\\n        await this.sendSMS(reminder)\\\\n        break\\\\n      case \\\\'email\\\\':\\\\n        await this.sendEmail(reminder)\\\\n        break\\\\n      case \\\\'push\\\\':\\\\n        await this.sendPush(reminder)\\\\n        break\\\\n    }\\\\n  }\\\\n\\\\n  private async sendSMS(reminder: CareReminder): Promise<void> {\\\\n    console.log(`Sending SMS to ${reminder.customerPhone}: ${reminder.content}`)\\\\n  }\\\\n\\\\n  private async sendEmail(reminder: CareReminder): Promise<void> {\\\\n    console.log(`Sending Email to ${reminder.customerEmail}: ${reminder.content}`)\\\\n  }\\\\n\\\\n  private async sendPush(reminder: CareReminder): Promise<void> {\\\\n    console.log(`Sending Push to ${reminder.customerId}: ${reminder.content}`)\\\\n  }\\\\n\\\\n  markAsSent(reminderId: string, response: string, effectivenessScore: number): void {\\\\n    const reminder = this.reminders.find(r => r.id === reminderId)\\\\n    if (reminder) {\\\\n      reminder.sentAt = new Date()\\\\n      reminder.status = \\\\'sent\\\\'\\\\n      reminder.response = response\\\\n      reminder.effectivenessScore = effectivenessScore\\\\n      reminder.updatedAt = new Date()\\\\n    }\\\\n  }\\\\n\\\\n  getPendingReminders(): CareReminder[] {\\\\n    return this.reminders.filter(r => r.status === \\\\'pending\\\\')\\\\n  }\\\\n\\\\n  getSentReminders(): CareReminder[] {\\\\n    return this.reminders.filter(r => r.status === \\\\'sent\\\\')\\\\n  }\\\\n\\\\n  getRemindersByCustomer(customerId: string): CareReminder[] {\\\\n    return this.reminders.filter(r => r.customerId === customerId)\\\\n  }\\\\n\\\\n  getRemindersByType(careType: string): CareReminder[] {\\\\n    return this.reminders.filter(r => r.careType === careType)\\\\n  }\\\\n\\\\n  getEffectivenessStatistics(): any {\\\\n    const sentReminders = this.reminders.filter(r => r.status === \\\\'sent\\\\' && r.effectivenessScore !== null)\\\\n    \\\\n    if (sentReminders.length === 0) {\\\\n      return {\\\\n        totalSent: 0,\\\\n        avgEffectiveness: 0,\\\\n        byType: {}\\\\n      }\\\\n    }\\\\n\\\\n    const avgEffectiveness = sentReminders.reduce((sum, r) => sum + (r.effectivenessScore || 0), 0) / sentReminders.length\\\\n\\\\n    const byType: Record<string, any> = {}\\\\n    sentReminders.forEach(r => {\\\\n      if (!byType[r.careType]) {\\\\n        byType[r.careType] = { count: 0, totalScore: 0, avgScore: 0 }\\\\n      }\\\\n      byType[r.careType].count++\\\\n      byType[r.careType].totalScore += r.effectivenessScore || 0\\\\n      byType[r.careType].avgScore = byType[r.careType].totalScore / byType[r.careType].count\\\\n    })\\\\n\\\\n    return {\\\\n      totalSent: sentReminders.length,\\\\n      avgEffectiveness: Math.round(avgEffectiveness * 10) / 10,\\\\n      byType\\\\n    }\\\\n  }\\\\n}\\\\n\\\\nconst careReminderEngine = new CareReminderEngine()\\\\n\\\\nexport function useCareReminder() {\\\\n  const loading = ref(false)\\\\n  const pendingReminders = ref<CareReminder[]>([])\\\\n  const sentReminders = ref<CareReminder[]>([])\\\\n  const effectivenessStats = ref<any>(null)\\\\n\\\\n  const loadPendingReminders = async () => {\\\\n    loading.value = true\\\\n    try {\\\\n      pendingReminders.value = careReminderEngine.getPendingReminders()\\\\n    } catch (error) {\\\\n      console.error(\\\\'Load pending reminders failed:\\\\', error)\\\\n      ElMessage.error(\\\\'加载待处理提醒失败\\\\')\\\\n    } finally {\\\\n      loading.value = false\\\\n    }\\\\n  }\\\\n\\\\n  const loadSentReminders = async () => {\\\\n    loading.value = true\\\\n    try {\\\\n      sentReminders.value = careReminderEngine.getSentReminders()\\\\n    } catch (error) {\\\\n      console.error(\\\\'Load sent reminders failed:\\\\', error)\\\\n      ElMessage.error(\\\\'加载已发送提醒失败\\\\')\\\\n    } finally {\\\\n      loading.value = false\\\\n    }\\\\n  }\\\\n\\\\n  const loadEffectivenessStats = async () => {\\\\n    loading.value = true\\\\n    try {\\\\n      effectivenessStats.value = careReminderEngine.getEffectivenessStatistics()\\\\n    } catch (error) {\\\\n      console.error(\\\\'Load effectiveness stats failed:\\\\', error)\\\\n      ElMessage.error(\\\\'加载效果统计失败\\\\')\\\\n    } finally {\\\\n      loading.value = false\\\\n    }\\\\n  }\\\\n\\\\n  const processCustomerEvent = async (customer: Customer, event: any) => {\\\\n    loading.value = true\\\\n    try {\\\\n      const reminders = await careReminderEngine.processCustomerEvent(customer, event)\\\\n      if (reminders.length > 0) {\\\\n        ElMessage.success(`已生成 ${reminders.length} 条关怀提醒`)\\\\n      }\\\\n      return reminders\\\\n    } catch (error) {\\\\n      console.error(\\\\'Process customer event failed:\\\\', error)\\\\n      ElMessage.error(\\\\'处理客户事件失败\\\\')\\\\n      return []\\\\n    } finally {\\\\n      loading.value = false\\\\n    }\\\\n  }\\\\n\\\\n  const sendReminder = async (reminder: CareReminder) => {\\\\n    loading.value = true\\\\n    try {\\\\n      const success = await careReminderEngine.sendReminder(reminder)\\\\n      if (success) {\\\\n        ElMessage.success(\\\\'关怀提醒发送成功\\\\')\\\\n        await loadPendingReminders()\\\\n        await loadSentReminders()\\\\n      } else {\\\\n        ElMessage.error(\\\\'关怀提醒发送失败\\\\')\\\\n      }\\\\n      return success\\\\n    } catch (error) {\\\\n      console.error(\\\\'Send reminder failed:\\\\', error)\\\\n      ElMessage.error(\\\\'发送提醒失败\\\\')\\\\n      return false\\\\n    } finally {\\\\n      loading.value = false\\\\n    }\\\\n  }\\\\n\\\\n  const markAsSent = async (reminderId: string, response: string, effectivenessScore: number) => {\\\\n    try {\\\\n      careReminderEngine.markAsSent(reminderId, response, effectivenessScore)\\\\n      ElMessage.success(\\\\'标记成功\\\\')\\\\n      await loadSentReminders()\\\\n    } catch (error) {\\\\n      console.error(\\\\'Mark as sent failed:\\\\', error)\\\\n      ElMessage.error(\\\\'标记失败\\\\')\\\\n    }\\\\n  }\\\\n\\\\n  const getCareTypeLabel = (careType: string): string => {\\\\n    const labels: Record<string, string> = {\\\\n      welcome: \\\\'新客户关怀\\\\',\\\\n      birthday: \\\\'生日关怀\\\\',\\\\n      holiday: \\\\'节日关怀\\\\',\\\\n      frequency_drop: \\\\'消费频次下降\\\\',\\\\n      inactive: \\\\'长期未消费\\\\',\\\\n      vip_care: \\\\'VIP专属关怀\\\\',\\\\n      satisfaction: \\\\'满意度跟进\\\\',\\\\n      upgrade: \\\\'会员升级\\\\'\\\\n    }\\\\n    return labels[careType] || \\\\'未知\\\\'\\\\n  }\\\\n\\\\n  const getChannelLabel = (channel: string): string => {\\\\n    const labels: Record<string, string> = {\\\\n      sms: \\\\'短信\\\\',\\\\n      email: \\\\'邮件\\\\',\\\\n      push: \\\\'推送\\\\'\\\\n    }\\\\n    return labels[channel] || \\\\'未知\\\\'\\\\n  }\\\\n\\\\n  const getStatusColor = (status: string): string => {\\\\n    const colors: Record<string, string> = {\\\\n      pending: \\\\'#E6A23C\\\\',\\\\n      sent: \\\\'#67C23A\\\\',\\\\n      failed: \\\\'#F56C6C\\\\'\\\\n    }\\\\n    return colors[status] || \\\\'#909399\\\\'\\\\n  }\\\\n\\\\n  const getEffectivenessColor = (score: number): string => {\\\\n    if (score >= 4) return \\\\'#67C23A\\\\'\\\\n    if (score >= 3) return \\\\'#409EFF\\\\'\\\\n    if (score >= 2) return \\\\'#E6A23C\\\\'\\\\n    return \\\\'#F56C6C\\\\'\\\\n  }\\\\n\\\\n  return {\\\\n    loading,\\\\n    pendingReminders,\\\\n    sentReminders,\\\\n    effectivenessStats,\\\\n    loadPendingReminders,\\\\n    loadSentReminders,\\\\n    loadEffectivenessStats,\\\\n    processCustomerEvent,\\\\n    sendReminder,\\\\n    markAsSent,\\\\n    getCareTypeLabel,\\\\n    getChannelLabel,\\\\n    getStatusColor,\\\\n    getEffectivenessColor\\\\n  }\\\\n}\\\\n\",\"originAcceptText\":\"/**\\n * @fileoverview YYC³餐饮管理系统 - 智能客户关怀提醒功能\\n * @description 实现智能客户关怀提醒引擎\\n * @module care-reminder-engine\\n * @author YYC³\\n * @version 1.0.0\\n * @created 2025-01-20\\n */\\n\\nimport { ref, computed } from 'vue'\\nimport { ElMessage } from 'element-plus'\\n\\nexport interface CareReminderRule {\\n  id: string\\n  name: string\\n  description: string\\n  triggerType: 'event' | 'schedule' | 'condition'\\n  triggerCondition: any\\n  careType: string\\n  contentTemplate: string\\n  channels: string[]\\n  priority: number\\n  enabled: boolean\\n  createdAt: Date\\n  updatedAt: Date\\n}\\n\\nexport interface CareReminder {\\n  id: string\\n  customerId: string\\n  customerName: string\\n  customerPhone: string\\n  customerEmail: string\\n  ruleId: string\\n  careType: string\\n  content: string\\n  channels: string[]\\n  scheduledAt: Date\\n  sentAt: Date | null\\n  status: 'pending' | 'sent' | 'failed'\\n  response: string | null\\n  effectivenessScore: number | null\\n  createdAt: Date\\n  updatedAt: Date\\n}\\n\\nexport interface Customer {\\n  id: string\\n  name: string\\n  phone: string\\n  email: string\\n  birthday: Date | null\\n  lifecycleStage: string\\n  lastOrderDate: Date | null\\n  orderCount: number\\n  totalSpent: number\\n  satisfactionScore: number\\n  registeredAt: Date\\n}\\n\\nclass CareReminderEngine {\\n  private rules: CareReminderRule[]\\n  private reminders: CareReminder[]\\n\\n  constructor() {\\n    this.rules = []\\n    this.reminders = []\\n    this.initializeDefaultRules()\\n  }\\n\\n  private initializeDefaultRules(): void {\\n    this.rules = [\\n      {\\n        id: 'CARE_001',\\n        name: '新客户关怀',\\n        description: '客户首次消费后24小时内发送欢迎消息',\\n        triggerType: 'event',\\n        triggerCondition: {\\n          eventType: 'first_order',\\n          hoursAfter: 24\\n        },\\n        careType: 'welcome',\\n        contentTemplate: '亲爱的{name}，感谢您首次光临YYC³！我们为您准备了新客专属优惠券，期待您的再次光临！',\\n        channels: ['sms', 'push'],\\n        priority: 1,\\n        enabled: true,\\n        createdAt: new Date(),\\n        updatedAt: new Date()\\n      },\\n      {\\n        id: 'CARE_002',\\n        name: '生日关怀',\\n        description: '客户生日当天发送生日祝福和专属优惠',\\n        triggerType: 'schedule',\\n        triggerCondition: {\\n          schedule: 'birthday',\\n          time: '09:00'\\n        },\\n        careType: 'birthday',\\n        contentTemplate: '亲爱的{name}，生日快乐！YYC³祝您生日快乐，特为您准备生日专属优惠券和免费小礼品！',\\n        channels: ['sms', 'push', 'email'],\\n        priority: 2,\\n        enabled: true,\\n        createdAt: new Date(),\\n        updatedAt: new Date()\\n      },\\n      {\\n        id: 'CARE_003',\\n        name: '节日关怀',\\n        description: '重要节日发送节日祝福和优惠',\\n        triggerType: 'schedule',\\n        triggerCondition: {\\n          schedule: 'holiday',\\n          holidays: ['spring_festival', 'mid_autumn', 'national_day']\\n        },\\n        careType: 'holiday',\\n        contentTemplate: '亲爱的{name}，{holiday}快乐！YYC³祝您节日愉快，特推出节日特色菜品和优惠活动！',\\n        channels: ['sms', 'push'],\\n        priority: 3,\\n        enabled: true,\\n        createdAt: new Date(),\\n        updatedAt: new Date()\\n      },\\n      {\\n        id: 'CARE_004',\\n        name: '消费频次下降提醒',\\n        description: '客户消费频次下降超过50%时发送关怀',\\n        triggerType: 'condition',\\n        triggerCondition: {\\n          field: 'orderFrequencyChange',\\n          operator: 'lt',\\n          value: -0.5\\n        },\\n        careType: 'frequency_drop',\\n        contentTemplate: '亲爱的{name}，最近很少见到您，是有什么不满意的地方吗？我们为您准备了专属优惠券，期待您的光临！',\\n        channels: ['sms', 'push'],\\n        priority: 4,\\n        enabled: true,\\n        createdAt: new Date(),\\n        updatedAt: new Date()\\n      },\\n      {\\n        id: 'CARE_005',\\n        name: '长期未消费提醒',\\n        description: '客户30天未消费时发送唤醒消息',\\n        triggerType: 'condition',\\n        triggerCondition: {\\n          field: 'daysSinceLastOrder',\\n          operator: 'gte',\\n          value: 30\\n        },\\n        careType: 'inactive',\\n        contentTemplate: '亲爱的{name}，好久不见！我们很想念您，特准备了唤醒优惠券，期待您的回归！',\\n        channels: ['sms', 'push', 'email'],\\n        priority: 5,\\n        enabled: true,\\n        createdAt: new Date(),\\n        updatedAt: new Date()\\n      },\\n      {\\n        id: 'CARE_006',\\n        name: 'VIP客户专属关怀',\\n        description: 'VIP客户每月定期关怀',\\n        triggerType: 'schedule',\\n        triggerCondition: {\\n          schedule: 'monthly',\\n          day: 1,\\n          customerLevel: ['vip', 'super_vip']\\n        },\\n        careType: 'vip_care',\\n        contentTemplate: '尊敬的VIP客户{name}，感谢您一直以来的支持！本月为您准备了专属权益和新品优先体验机会！',\\n        channels: ['sms', 'push', 'email'],\\n        priority: 6,\\n        enabled: true,\\n        createdAt: new Date(),\\n        updatedAt: new Date()\\n      },\\n      {\\n        id: 'CARE_007',\\n        name: '满意度跟进',\\n        description: '客户消费后3天发送满意度调研',\\n        triggerType: 'event',\\n        triggerCondition: {\\n          eventType: 'order_completed',\\n          daysAfter: 3\\n        },\\n        careType: 'satisfaction',\\n        contentTemplate: '亲爱的{name}，感谢您最近的光临！我们非常重视您的用餐体验，期待您的反馈！',\\n        channels: ['sms', 'push'],\\n        priority: 7,\\n        enabled: true,\\n        createdAt: new Date(),\\n        updatedAt: new Date()\\n      },\\n      {\\n        id: 'CARE_008',\\n        name: '会员升级提醒',\\n        description: '客户达到会员升级标准时发送恭喜消息',\\n        triggerType: 'condition',\\n        triggerCondition: {\\n          field: 'canUpgrade',\\n          operator: 'eq',\\n          value: true\\n        },\\n        careType: 'upgrade',\\n        contentTemplate: '恭喜{name}！您已达到{newLevel}会员标准，升级后将享受更多专属权益！',\\n        channels: ['sms', 'push', 'email'],\\n        priority: 8,\\n        enabled: true,\\n        createdAt: new Date(),\\n        updatedAt: new Date()\\n      }\\n    ]\\n  }\\n\\n  async processCustomerEvent(customer: Customer, event: any): Promise<CareReminder[]> {\\n    const triggeredReminders: CareReminder[] = []\\n\\n    for (const rule of this.rules) {\\n      if (!rule.enabled) continue\\n\\n      const shouldTrigger = await this.evaluateTrigger(rule, customer, event)\\n      if (shouldTrigger) {\\n        const reminder = await this.createReminder(customer, rule)\\n        triggeredReminders.push(reminder)\\n        this.reminders.push(reminder)\\n      }\\n    }\\n\\n    return triggeredReminders\\n  }\\n\\n  private async evaluateTrigger(\\n    rule: CareReminderRule,\\n    customer: Customer,\\n    event: any\\n  ): Promise<boolean> {\\n    switch (rule.triggerType) {\\n      case 'event':\\n        return this.evaluateEventTrigger(rule.triggerCondition, event)\\n      case 'schedule':\\n        return this.evaluateScheduleTrigger(rule.triggerCondition, customer)\\n      case 'condition':\\n        return this.evaluateConditionTrigger(rule.triggerCondition, customer)\\n      default:\\n        return false\\n    }\\n  }\\n\\n  private evaluateEventTrigger(condition: any, event: any): boolean {\\n    if (!event) return false\\n\\n    if (condition.eventType === 'first_order' && event.type === 'first_order') {\\n      const hoursSinceOrder = this.getHoursSince(event.timestamp)\\n      return hoursSinceOrder <= condition.hoursAfter\\n    }\\n\\n    if (condition.eventType === 'order_completed' && event.type === 'order_completed') {\\n      const daysSinceOrder = this.getDaysSince(event.timestamp)\\n      return daysSinceOrder <= condition.daysAfter\\n    }\\n\\n    return false\\n  }\\n\\n  private evaluateScheduleTrigger(condition: any, customer: Customer): boolean {\\n    const now = new Date()\\n\\n    if (condition.schedule === 'birthday' && customer.birthday) {\\n      const birthday = new Date(customer.birthday)\\n      const today = new Date(now.getFullYear(), now.getMonth(), now.getDate())\\n      const birthdayThisYear = new Date(now.getFullYear(), birthday.getMonth(), birthday.getDate())\\n      return today.getTime() === birthdayThisYear.getTime()\\n    }\\n\\n    if (condition.schedule === 'monthly' && condition.day) {\\n      return now.getDate() === condition.day && condition.customerLevel?.includes(customer.lifecycleStage)\\n    }\\n\\n    if (condition.schedule === 'holiday') {\\n      const today = now.getMonth() + 1 + '-' + now.getDate()\\n      const holidays: Record<string, string> = {\\n        '1-1': 'spring_festival',\\n        '9-15': 'mid_autumn',\\n        '10-1': 'national_day'\\n      }\\n      return condition.holidays?.includes(holidays[today])\\n    }\\n\\n    return false\\n  }\\n\\n  private evaluateConditionTrigger(condition: any, customer: Customer): boolean {\\n    if (condition.field === 'daysSinceLastOrder') {\\n      const daysSinceLastOrder = this.getDaysSince(customer.lastOrderDate)\\n      return this.compareValue(daysSinceLastOrder, condition.operator, condition.value)\\n    }\\n\\n    if (condition.field === 'orderFrequencyChange') {\\n      const currentFrequency = this.calculateMonthlyFrequency(customer, 30)\\n      const previousFrequency = this.calculateMonthlyFrequency(customer, 90)\\n      const change = (currentFrequency - previousFrequency) / previousFrequency\\n      return this.compareValue(change, condition.operator, condition.value)\\n    }\\n\\n    if (condition.field === 'canUpgrade') {\\n      return this.canUpgradeCustomer(customer)\\n    }\\n\\n    return false\\n  }\\n\\n  private compareValue(\\n    actual: number,\\n    operator: string,\\n    expected: number\\n  ): boolean {\\n    switch (operator) {\\n      case 'eq':\\n        return actual === expected\\n      case 'ne':\\n        return actual !== expected\\n      case 'gt':\\n        return actual > expected\\n      case 'lt':\\n        return actual < expected\\n      case 'gte':\\n        return actual >= expected\\n      case 'lte':\\n        return actual <= expected\\n      default:\\n        return false\\n    }\\n  }\\n\\n  private getHoursSince(date: Date | null): number {\\n    if (!date) return Infinity\\n    return Math.floor((Date.now() - new Date(date).getTime()) / (1000 * 60 * 60))\\n  }\\n\\n  private getDaysSince(date: Date | null): number {\\n    if (!date) return Infinity\\n    return Math.floor((Date.now() - new Date(date).getTime()) / (1000 * 60 * 60 * 24))\\n  }\\n\\n  private calculateMonthlyFrequency(customer: Customer, days: number): number {\\n    if (days <= 0) return 0\\n    return (customer.orderCount / days) * 30\\n  }\\n\\n  private canUpgradeCustomer(customer: Customer): boolean {\\n    if (customer.lifecycleStage === 'regular' && customer.orderCount >= 3 && customer.totalSpent >= 500) {\\n      return true\\n    }\\n    if (customer.lifecycleStage === 'member' && customer.orderCount >= 10 && customer.totalSpent >= 2000) {\\n      return true\\n    }\\n    return false\\n  }\\n\\n  private async createReminder(\\n    customer: Customer,\\n    rule: CareReminderRule\\n  ): Promise<CareReminder> {\\n    const content = this.generateContent(rule.contentTemplate, customer, rule)\\n\\n    return {\\n      id: this.generateId(),\\n      customerId: customer.id,\\n      customerName: customer.name,\\n      customerPhone: customer.phone,\\n      customerEmail: customer.email,\\n      ruleId: rule.id,\\n      careType: rule.careType,\\n      content,\\n      channels: rule.channels,\\n      scheduledAt: this.calculateScheduledTime(rule),\\n      sentAt: null,\\n      status: 'pending',\\n      response: null,\\n      effectivenessScore: null,\\n      createdAt: new Date(),\\n      updatedAt: new Date()\\n    }\\n  }\\n\\n  private generateContent(\\n    template: string,\\n    customer: Customer,\\n    rule: CareReminderRule\\n  ): string {\\n    let content = template\\n      .replace('{name}', customer.name)\\n      .replace('{level}', this.getLevelLabel(customer.lifecycleStage))\\n      .replace('{lastOrderDate}', this.formatDate(customer.lastOrderDate))\\n\\n    if (rule.careType === 'upgrade') {\\n      const newLevel = this.getNextLevel(customer.lifecycleStage)\\n      content = content.replace('{newLevel}', newLevel)\\n    }\\n\\n    if (rule.careType === 'holiday') {\\n      const holiday = this.getCurrentHoliday()\\n      content = content.replace('{holiday}', holiday)\\n    }\\n\\n    return content\\n  }\\n\\n  private calculateScheduledTime(rule: CareReminderRule): Date {\\n    const now = new Date()\\n\\n    if (rule.triggerType === 'event') {\\n      return new Date(now.getTime() + 60 * 1000)\\n    }\\n\\n    if (rule.triggerType === 'schedule') {\\n      if (rule.triggerCondition.schedule === 'birthday') {\\n        return new Date(now.getFullYear(), now.getMonth(), now.getDate(), 9, 0, 0)\\n      }\\n      if (rule.triggerCondition.schedule === 'monthly') {\\n        const nextMonth = now.getMonth() + 1\\n        return new Date(now.getFullYear(), nextMonth, rule.triggerCondition.day, 9, 0, 0)\\n      }\\n    }\\n\\n    return new Date(now.getTime() + 60 * 1000)\\n  }\\n\\n  private getLevelLabel(stage: string): string {\\n    const labels: Record<string, string> = {\\n      potential: '潜在客户',\\n      new_customer: '新客户',\\n      active: '活跃客户',\\n      loyal: '忠诚客户',\\n      dormant: '休眠客户',\\n      churned: '流失客户'\\n    }\\n    return labels[stage] || '客户'\\n  }\\n\\n  private getNextLevel(currentStage: string): string {\\n    const levels = ['regular', 'member', 'vip', 'super_vip']\\n    const currentIndex = levels.indexOf(currentStage)\\n    if (currentIndex < levels.length - 1) {\\n      return this.getLevelLabel(levels[currentIndex + 1])\\n    }\\n    return this.getLevelLabel(currentStage)\\n  }\\n\\n  private getCurrentHoliday(): string {\\n    const now = new Date()\\n    const date = now.getMonth() + 1 + '-' + now.getDate()\\n    const holidays: Record<string, string> = {\\n      '1-1': '春节',\\n      '9-15': '中秋节',\\n      '10-1': '国庆节'\\n    }\\n    return holidays[date] || ''\\n  }\\n\\n  private formatDate(date: Date | null): string {\\n    if (!date) return '从未'\\n    return new Date(date).toLocaleDateString('zh-CN')\\n  }\\n\\n  private generateId(): string {\\n    return 'REM_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9)\\n  }\\n\\n  async sendReminder(reminder: CareReminder): Promise<boolean> {\\n    try {\\n      for (const channel of reminder.channels) {\\n        await this.sendToChannel(reminder, channel)\\n      }\\n\\n      reminder.sentAt = new Date()\\n      reminder.status = 'sent'\\n      reminder.updatedAt = new Date()\\n\\n      return true\\n    } catch (error) {\\n      console.error('Send reminder failed:', error)\\n      reminder.status = 'failed'\\n      reminder.updatedAt = new Date()\\n      return false\\n    }\\n  }\\n\\n  private async sendToChannel(reminder: CareReminder, channel: string): Promise<void> {\\n    switch (channel) {\\n      case 'sms':\\n        await this.sendSMS(reminder)\\n        break\\n      case 'email':\\n        await this.sendEmail(reminder)\\n        break\\n      case 'push':\\n        await this.sendPush(reminder)\\n        break\\n    }\\n  }\\n\\n  private async sendSMS(reminder: CareReminder): Promise<void> {\\n    console.log(`Sending SMS to ${reminder.customerPhone}: ${reminder.content}`)\\n  }\\n\\n  private async sendEmail(reminder: CareReminder): Promise<void> {\\n    console.log(`Sending Email to ${reminder.customerEmail}: ${reminder.content}`)\\n  }\\n\\n  private async sendPush(reminder: CareReminder): Promise<void> {\\n    console.log(`Sending Push to ${reminder.customerId}: ${reminder.content}`)\\n  }\\n\\n  markAsSent(reminderId: string, response: string, effectivenessScore: number): void {\\n    const reminder = this.reminders.find(r => r.id === reminderId)\\n    if (reminder) {\\n      reminder.sentAt = new Date()\\n      reminder.status = 'sent'\\n      reminder.response = response\\n      reminder.effectivenessScore = effectivenessScore\\n      reminder.updatedAt = new Date()\\n    }\\n  }\\n\\n  getPendingReminders(): CareReminder[] {\\n    return this.reminders.filter(r => r.status === 'pending')\\n  }\\n\\n  getSentReminders(): CareReminder[] {\\n    return this.reminders.filter(r => r.status === 'sent')\\n  }\\n\\n  getRemindersByCustomer(customerId: string): CareReminder[] {\\n    return this.reminders.filter(r => r.customerId === customerId)\\n  }\\n\\n  getRemindersByType(careType: string): CareReminder[] {\\n    return this.reminders.filter(r => r.careType === careType)\\n  }\\n\\n  getEffectivenessStatistics(): any {\\n    const sentReminders = this.reminders.filter(r => r.status === 'sent' && r.effectivenessScore !== null)\\n    \\n    if (sentReminders.length === 0) {\\n      return {\\n        totalSent: 0,\\n        avgEffectiveness: 0,\\n        byType: {}\\n      }\\n    }\\n\\n    const avgEffectiveness = sentReminders.reduce((sum, r) => sum + (r.effectivenessScore || 0), 0) / sentReminders.length\\n\\n    const byType: Record<string, any> = {}\\n    sentReminders.forEach(r => {\\n      if (!byType[r.careType]) {\\n        byType[r.careType] = { count: 0, totalScore: 0, avgScore: 0 }\\n      }\\n      byType[r.careType].count++\\n      byType[r.careType].totalScore += r.effectivenessScore || 0\\n      byType[r.careType].avgScore = byType[r.careType].totalScore / byType[r.careType].count\\n    })\\n\\n    return {\\n      totalSent: sentReminders.length,\\n      avgEffectiveness: Math.round(avgEffectiveness * 10) / 10,\\n      byType\\n    }\\n  }\\n}\\n\\nconst careReminderEngine = new CareReminderEngine()\\n\\nexport function useCareReminder() {\\n  const loading = ref(false)\\n  const pendingReminders = ref<CareReminder[]>([])\\n  const sentReminders = ref<CareReminder[]>([])\\n  const effectivenessStats = ref<any>(null)\\n\\n  const loadPendingReminders = async () => {\\n    loading.value = true\\n    try {\\n      pendingReminders.value = careReminderEngine.getPendingReminders()\\n    } catch (error) {\\n      console.error('Load pending reminders failed:', error)\\n      ElMessage.error('加载待处理提醒失败')\\n    } finally {\\n      loading.value = false\\n    }\\n  }\\n\\n  const loadSentReminders = async () => {\\n    loading.value = true\\n    try {\\n      sentReminders.value = careReminderEngine.getSentReminders()\\n    } catch (error) {\\n      console.error('Load sent reminders failed:', error)\\n      ElMessage.error('加载已发送提醒失败')\\n    } finally {\\n      loading.value = false\\n    }\\n  }\\n\\n  const loadEffectivenessStats = async () => {\\n    loading.value = true\\n    try {\\n      effectivenessStats.value = careReminderEngine.getEffectivenessStatistics()\\n    } catch (error) {\\n      console.error('Load effectiveness stats failed:', error)\\n      ElMessage.error('加载效果统计失败')\\n    } finally {\\n      loading.value = false\\n    }\\n  }\\n\\n  const processCustomerEvent = async (customer: Customer, event: any) => {\\n    loading.value = true\\n    try {\\n      const reminders = await careReminderEngine.processCustomerEvent(customer, event)\\n      if (reminders.length > 0) {\\n        ElMessage.success(`已生成 ${reminders.length} 条关怀提醒`)\\n      }\\n      return reminders\\n    } catch (error) {\\n      console.error('Process customer event failed:', error)\\n      ElMessage.error('处理客户事件失败')\\n      return []\\n    } finally {\\n      loading.value = false\\n    }\\n  }\\n\\n  const sendReminder = async (reminder: CareReminder) => {\\n    loading.value = true\\n    try {\\n      const success = await careReminderEngine.sendReminder(reminder)\\n      if (success) {\\n        ElMessage.success('关怀提醒发送成功')\\n        await loadPendingReminders()\\n        await loadSentReminders()\\n      } else {\\n        ElMessage.error('关怀提醒发送失败')\\n      }\\n      return success\\n    } catch (error) {\\n      console.error('Send reminder failed:', error)\\n      ElMessage.error('发送提醒失败')\\n      return false\\n    } finally {\\n      loading.value = false\\n    }\\n  }\\n\\n  const markAsSent = async (reminderId: string, response: string, effectivenessScore: number) => {\\n    try {\\n      careReminderEngine.markAsSent(reminderId, response, effectivenessScore)\\n      ElMessage.success('标记成功')\\n      await loadSentReminders()\\n    } catch (error) {\\n      console.error('Mark as sent failed:', error)\\n      ElMessage.error('标记失败')\\n    }\\n  }\\n\\n  const getCareTypeLabel = (careType: string): string => {\\n    const labels: Record<string, string> = {\\n      welcome: '新客户关怀',\\n      birthday: '生日关怀',\\n      holiday: '节日关怀',\\n      frequency_drop: '消费频次下降',\\n      inactive: '长期未消费',\\n      vip_care: 'VIP专属关怀',\\n      satisfaction: '满意度跟进',\\n      upgrade: '会员升级'\\n    }\\n    return labels[careType] || '未知'\\n  }\\n\\n  const getChannelLabel = (channel: string): string => {\\n    const labels: Record<string, string> = {\\n      sms: '短信',\\n      email: '邮件',\\n      push: '推送'\\n    }\\n    return labels[channel] || '未知'\\n  }\\n\\n  const getStatusColor = (status: string): string => {\\n    const colors: Record<string, string> = {\\n      pending: '#E6A23C',\\n      sent: '#67C23A',\\n      failed: '#F56C6C'\\n    }\\n    return colors[status] || '#909399'\\n  }\\n\\n  const getEffectivenessColor = (score: number): string => {\\n    if (score >= 4) return '#67C23A'\\n    if (score >= 3) return '#409EFF'\\n    if (score >= 2) return '#E6A23C'\\n    return '#F56C6C'\\n  }\\n\\n  return {\\n    loading,\\n    pendingReminders,\\n    sentReminders,\\n    effectivenessStats,\\n    loadPendingReminders,\\n    loadSentReminders,\\n    loadEffectivenessStats,\\n    processCustomerEvent,\\n    sendReminder,\\n    markAsSent,\\n    getCareTypeLabel,\\n    getChannelLabel,\\n    getStatusColor,\\n    getEffectivenessColor\\n  }\\n}\\n\",\"originTextLength\":20345,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768910787182}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/composables/useChurnPrediction.ts": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":394,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":394,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"/**\\\\n * @fileoverview YYC³餐饮管理系统 - 客户流失预警机制\\\\n * @description 实现客户流失预测和预警功能\\\\n * @module churn-prediction\\\\n * @author YYC³\\\\n * @version 1.0.0\\\\n * @created 2025-01-20\\\\n */\\\\n\\\\nimport { ref, computed } from \\\\'vue\\\\'\\\\nimport { ElMessage } from \\\\'element-plus\\\\'\\\\n\\\\nexport interface ChurnPrediction {\\\\n  customerId: string\\\\n  customerName: string\\\\n  customerPhone: string\\\\n  customerEmail: string\\\\n  churnProbability: number\\\\n  riskLevel: \\\\'high\\\\' | \\\\'medium\\\\' | \\\\'low\\\\'\\\\n  riskFactors: string[]\\\\n  predictedChurnDate: Date\\\\n  recommendations: string[]\\\\n  assignedTo: string | null\\\\n  status: \\\\'pending\\\\' | \\\\'in_progress\\\\' | \\\\'resolved\\\\' | \\\\'closed\\\\'\\\\n  createdAt: Date\\\\n  updatedAt: Date\\\\n}\\\\n\\\\nexport interface Customer {\\\\n  id: string\\\\n  name: string\\\\n  phone: string\\\\n  email: string\\\\n  lifecycleStage: string\\\\n  lastOrderDate: Date | null\\\\n  orderCount: number\\\\n  totalSpent: number\\\\n  satisfactionScore: number\\\\n  registeredAt: Date\\\\n  recentOrders: any[]\\\\n  recentInteractions: any[]\\\\n}\\\\n\\\\nclass ChurnPredictionModel {\\\\n  private readonly HIGH_RISK_THRESHOLD = 0.7\\\\n  private readonly MEDIUM_RISK_THRESHOLD = 0.4\\\\n  private readonly INACTIVE_DAYS_THRESHOLD = 30\\\\n  private readonly FREQUENCY_DROP_THRESHOLD = 0.5\\\\n  private readonly SPENDING_DROP_THRESHOLD = 0.5\\\\n  private readonly SATISFACTION_THRESHOLD = 3.5\\\\n\\\\n  predictChurn(customer: Customer): ChurnPrediction {\\\\n    const riskFactors: string[] = []\\\\n    let churnProbability = 0\\\\n\\\\n    const daysSinceLastOrder = this.getDaysSince(customer.lastOrderDate)\\\\n    const frequencyDrop = this.calculateFrequencyDrop(customer)\\\\n    const spendingDrop = this.calculateSpendingDrop(customer)\\\\n\\\\n    if (this.isInactive(customer, 30)) {\\\\n      churnProbability += 0.2\\\\n      riskFactors.push(\\\\'30天未消费\\\\')\\\\n    }\\\\n\\\\n    if (this.isInactive(customer, 60)) {\\\\n      churnProbability += 0.3\\\\n      riskFactors.push(\\\\'60天未消费\\\\')\\\\n    }\\\\n\\\\n    if (frequencyDrop <= -this.FREQUENCY_DROP_THRESHOLD) {\\\\n      churnProbability += 0.25\\\\n      riskFactors.push(`消费频次下降${Math.abs(frequencyDrop * 100).toFixed(0)}%`)\\\\n    }\\\\n\\\\n    if (spendingDrop <= -this.SPENDING_DROP_THRESHOLD) {\\\\n      churnProbability += 0.15\\\\n      riskFactors.push(`消费金额下降${Math.abs(spendingDrop * 100).toFixed(0)}%`)\\\\n    }\\\\n\\\\n    if (customer.satisfactionScore < this.SATISFACTION_THRESHOLD) {\\\\n      churnProbability += 0.1\\\\n      riskFactors.push(`满意度评分${customer.satisfactionScore}分`)\\\\n    }\\\\n\\\\n    if (customer.lifecycleStage === \\\\'dormant\\\\') {\\\\n      churnProbability += 0.15\\\\n      riskFactors.push(\\\\'处于休眠状态\\\\')\\\\n    }\\\\n\\\\n    churnProbability = Math.min(churnProbability, 1.0)\\\\n\\\\n    const riskLevel = this.getRiskLevel(churnProbability)\\\\n    const predictedChurnDate = this.predictChurnDate(churnProbability)\\\\n    const recommendations = this.generateRecommendations(riskFactors)\\\\n\\\\n    return {\\\\n      customerId: customer.id,\\\\n      customerName: customer.name,\\\\n      customerPhone: customer.phone,\\\\n      customerEmail: customer.email,\\\\n      churnProbability: Math.round(churnProbability * 100) / 100,\\\\n      riskLevel,\\\\n      riskFactors,\\\\n      predictedChurnDate,\\\\n      recommendations,\\\\n      assignedTo: null,\\\\n      status: \\\\'pending\\\\',\\\\n      createdAt: new Date(),\\\\n      updatedAt: new Date()\\\\n    }\\\\n  }\\\\n\\\\n  batchPredict(customers: Customer[]): ChurnPrediction[] {\\\\n    return customers.map(customer => this.predictChurn(customer))\\\\n  }\\\\n\\\\n  private isInactive(customer: Customer, days: number): boolean {\\\\n    if (!customer.lastOrderDate) return true\\\\n    const daysSinceLastOrder = this.getDaysSince(customer.lastOrderDate)\\\\n    return daysSinceLastOrder > days\\\\n  }\\\\n\\\\n  private getDaysSince(date: Date | null): number {\\\\n    if (!date) return Infinity\\\\n    return Math.floor((Date.now() - new Date(date).getTime()) / (1000 * 60 * 60 * 24))\\\\n  }\\\\n\\\\n  private calculateFrequencyDrop(customer: Customer): number {\\\\n    const currentFrequency = this.calculateMonthlyFrequency(customer, 30)\\\\n    const previousFrequency = this.calculateMonthlyFrequency(customer, 90)\\\\n\\\\n    if (previousFrequency === 0) return 0\\\\n\\\\n    return (currentFrequency - previousFrequency) / previousFrequency\\\\n  }\\\\n\\\\n  private calculateSpendingDrop(customer: Customer): number {\\\\n    const currentSpending = this.calculateMonthlySpending(customer, 30)\\\\n    const previousSpending = this.calculateMonthlySpending(customer, 90)\\\\n\\\\n    if (previousSpending === 0) return 0\\\\n\\\\n    return (currentSpending - previousSpending) / previousSpending\\\\n  }\\\\n\\\\n  private calculateMonthlyFrequency(customer: Customer, days: number): number {\\\\n    if (days <= 0) return 0\\\\n\\\\n    const recentOrders = customer.recentOrders?.filter(order => {\\\\n      const orderDate = new Date(order.createdAt)\\\\n      const daysSinceOrder = this.getDaysSince(orderDate)\\\\n      return daysSinceOrder <= days\\\\n    }) || []\\\\n\\\\n    return (recentOrders.length / days) * 30\\\\n  }\\\\n\\\\n  private calculateMonthlySpending(customer: Customer, days: number): number {\\\\n    if (days <= 0) return 0\\\\n\\\\n    const recentOrders = customer.recentOrders?.filter(order => {\\\\n      const orderDate = new Date(order.createdAt)\\\\n      const daysSinceOrder = this.getDaysSince(orderDate)\\\\n      return daysSinceOrder <= days\\\\n    }) || []\\\\n\\\\n    const totalSpent = recentOrders.reduce((sum, order) => sum + (order.amount || 0), 0)\\\\n    return (totalSpent / days) * 30\\\\n  }\\\\n\\\\n  private getRiskLevel(probability: number): \\\\'high\\\\' | \\\\'medium\\\\' | \\\\'low\\\\' {\\\\n    if (probability >= this.HIGH_RISK_THRESHOLD) return \\\\'high\\\\'\\\\n    if (probability >= this.MEDIUM_RISK_THRESHOLD) return \\\\'medium\\\\'\\\\n    return \\\\'low\\\\'\\\\n  }\\\\n\\\\n  private predictChurnDate(probability: number): Date {\\\\n    const daysToChurn = Math.floor(90 * (1 - probability))\\\\n    return new Date(Date.now() + daysToChurn * 24 * 60 * 60 * 1000)\\\\n  }\\\\n\\\\n  private generateRecommendations(riskFactors: string[]): string[] {\\\\n    const recommendations: string[] = []\\\\n\\\\n    if (riskFactors.some(f => f.includes(\\\\'30天未消费\\\\') || f.includes(\\\\'60天未消费\\\\'))) {\\\\n      recommendations.push(\\\\'发送唤醒优惠券\\\\')\\\\n      recommendations.push(\\\\'安排客服回访\\\\')\\\\n      recommendations.push(\\\\'个性化推荐优惠活动\\\\')\\\\n    }\\\\n\\\\n    if (riskFactors.some(f => f.includes(\\\\'消费频次下降\\\\'))) {\\\\n      recommendations.push(\\\\'了解消费下降原因\\\\')\\\\n      recommendations.push(\\\\'提供专属优惠\\\\')\\\\n      recommendations.push(\\\\'推荐热门商品\\\\')\\\\n    }\\\\n\\\\n    if (riskFactors.some(f => f.includes(\\\\'消费金额下降\\\\'))) {\\\\n      recommendations.push(\\\\'了解消费下降原因\\\\')\\\\n      recommendations.push(\\\\'提供套餐优惠\\\\')\\\\n      recommendations.push(\\\\'推荐高价值商品\\\\')\\\\n    }\\\\n\\\\n    if (riskFactors.some(f => f.includes(\\\\'满意度\\\\'))) {\\\\n      recommendations.push(\\\\'安排满意度调研\\\\')\\\\n      recommendations.push(\\\\'改进服务质量\\\\')\\\\n      recommendations.push(\\\\'提供补偿方案\\\\')\\\\n    }\\\\n\\\\n    if (riskFactors.some(f => f.includes(\\\\'休眠状态\\\\'))) {\\\\n      recommendations.push(\\\\'发送专属唤醒优惠\\\\')\\\\n      recommendations.push(\\\\'VIP客服对接\\\\')\\\\n      recommendations.push(\\\\'定制化服务方案\\\\')\\\\n    }\\\\n\\\\n    if (recommendations.length === 0) {\\\\n      recommendations.push(\\\\'定期跟进客户\\\\')\\\\n      recommendations.push(\\\\'保持客户互动\\\\')\\\\n      recommendations.push(\\\\'提升服务质量\\\\')\\\\n    }\\\\n\\\\n    return recommendations\\\\n  }\\\\n\\\\n  getChurnStatistics(predictions: ChurnPrediction[]): any {\\\\n    const total = predictions.length\\\\n    const highRisk = predictions.filter(p => p.riskLevel === \\\\'high\\\\').length\\\\n    const mediumRisk = predictions.filter(p => p.riskLevel === \\\\'medium\\\\').length\\\\n    const lowRisk = predictions.filter(p => p.riskLevel === \\\\'low\\\\').length\\\\n\\\\n    const avgChurnProbability = predictions.length > 0\\\\n      ? predictions.reduce((sum, p) => sum + p.churnProbability, 0) / predictions.length\\\\n      : 0\\\\n\\\\n    const riskFactorCounts: Record<string, number> = {}\\\\n    predictions.forEach(p => {\\\\n      p.riskFactors.forEach(factor => {\\\\n        if (!riskFactorCounts[factor]) {\\\\n          riskFactorCounts[factor] = 0\\\\n        }\\\\n        riskFactorCounts[factor]++\\\\n      })\\\\n    })\\\\n\\\\n    const topRiskFactors = Object.entries(riskFactorCounts)\\\\n      .sort((a, b) => b[1] - a[1])\\\\n      .slice(0, 5)\\\\n      .map(([factor, count]) => ({\\\\n        factor,\\\\n        count,\\\\n        percentage: Math.round((count / total) * 100)\\\\n      }))\\\\n\\\\n    return {\\\\n      total,\\\\n      highRisk,\\\\n      mediumRisk,\\\\n      lowRisk,\\\\n      highRiskPercentage: Math.round((highRisk / total) * 100),\\\\n      mediumRiskPercentage: Math.round((mediumRisk / total) * 100),\\\\n      lowRiskPercentage: Math.round((lowRisk / total) * 100),\\\\n      avgChurnProbability: Math.round(avgChurnProbability * 100) / 100,\\\\n      topRiskFactors\\\\n    }\\\\n  }\\\\n\\\\n  getTrendAnalysis(predictions: ChurnPrediction[]): any {\\\\n    const now = new Date()\\\\n    const oneWeekAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000)\\\\n    const twoWeeksAgo = new Date(now.getTime() - 14 * 24 * 60 * 60 * 1000)\\\\n    const oneMonthAgo = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000)\\\\n\\\\n    const currentWeek = predictions.filter(p => p.createdAt >= oneWeekAgo)\\\\n    const previousWeek = predictions.filter(p => p.createdAt >= twoWeeksAgo && p.createdAt < oneWeekAgo)\\\\n    const currentMonth = predictions.filter(p => p.createdAt >= oneMonthAgo)\\\\n\\\\n    const currentWeekHighRisk = currentWeek.filter(p => p.riskLevel === \\\\'high\\\\').length\\\\n    const previousWeekHighRisk = previousWeek.filter(p => p.riskLevel === \\\\'high\\\\').length\\\\n\\\\n    const weekTrend = previousWeekHighRisk > 0\\\\n      ? ((currentWeekHighRisk - previousWeekHighRisk) / previousWeekHighRisk) * 100\\\\n      : 0\\\\n\\\\n    return {\\\\n      currentWeekCount: currentWeek.length,\\\\n      previousWeekCount: previousWeek.length,\\\\n      currentMonthCount: currentMonth.length,\\\\n      currentWeekHighRisk,\\\\n      previousWeekHighRisk,\\\\n      weekTrend: Math.round(weekTrend * 10) / 10,\\\\n      avgChurnProbability: {\\\\n        currentWeek: this.calculateAvgProbability(currentWeek),\\\\n        previousWeek: this.calculateAvgProbability(previousWeek),\\\\n        currentMonth: this.calculateAvgProbability(currentMonth)\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  private calculateAvgProbability(predictions: ChurnPrediction[]): number {\\\\n    if (predictions.length === 0) return 0\\\\n    return predictions.reduce((sum, p) => sum + p.churnProbability, 0) / predictions.length\\\\n  }\\\\n}\\\\n\\\\nconst churnPredictionModel = new ChurnPredictionModel()\\\\n\\\\nexport function useChurnPrediction() {\\\\n  const loading = ref(false)\\\\n  const churnPredictions = ref<ChurnPrediction[]>([])\\\\n  const churnStatistics = ref<any>(null)\\\\n  const trendAnalysis = ref<any>(null)\\\\n\\\\n  const predictCustomerChurn = (customer: Customer): ChurnPrediction => {\\\\n    try {\\\\n      const prediction = churnPredictionModel.predictChurn(customer)\\\\n      return prediction\\\\n    } catch (error) {\\\\n      console.error(\\\\'Predict churn failed:\\\\', error)\\\\n      ElMessage.error(\\\\'预测客户流失失败\\\\')\\\\n      throw error\\\\n    }\\\\n  }\\\\n\\\\n  const batchPredictChurn = async (customers: Customer[]) => {\\\\n    loading.value = true\\\\n    try {\\\\n      const predictions = churnPredictionModel.batchPredict(customers)\\\\n      churnPredictions.value = predictions\\\\n      churnStatistics.value = churnPredictionModel.getChurnStatistics(predictions)\\\\n      trendAnalysis.value = churnPredictionModel.getTrendAnalysis(predictions)\\\\n      return predictions\\\\n    } catch (error) {\\\\n      console.error(\\\\'Batch predict churn failed:\\\\', error)\\\\n      ElMessage.error(\\\\'批量预测流失失败\\\\')\\\\n      return []\\\\n    } finally {\\\\n      loading.value = false\\\\n    }\\\\n  }\\\\n\\\\n  const assignAlert = (alertId: string, assignedTo: string): void => {\\\\n    const alert = churnPredictions.value.find(p => p.customerId === alertId)\\\\n    if (alert) {\\\\n      alert.assignedTo = assignedTo\\\\n      alert.status = \\\\'in_progress\\\\'\\\\n      alert.updatedAt = new Date()\\\\n      ElMessage.success(\\\\'预警已分配\\\\')\\\\n    }\\\\n  }\\\\n\\\\n  const resolveAlert = (alertId: string, resolutionNotes: string): void => {\\\\n    const alert = churnPredictions.value.find(p => p.customerId === alertId)\\\\n    if (alert) {\\\\n      alert.status = \\\\'resolved\\\\'\\\\n      alert.updatedAt = new Date()\\\\n      ElMessage.success(\\\\'预警已解决\\\\')\\\\n    }\\\\n  }\\\\n\\\\n  const closeAlert = (alertId: string): void => {\\\\n    const alert = churnPredictions.value.find(p => p.customerId === alertId)\\\\n    if (alert) {\\\\n      alert.status = \\\\'closed\\\\'\\\\n      alert.updatedAt = new Date()\\\\n      ElMessage.success(\\\\'预警已关闭\\\\')\\\\n    }\\\\n  }\\\\n\\\\n  const getHighRiskAlerts = (): ChurnPrediction[] => {\\\\n    return churnPredictions.value.filter(p => p.riskLevel === \\\\'high\\\\' && p.status === \\\\'pending\\\\')\\\\n  }\\\\n\\\\n  const getMediumRiskAlerts = (): ChurnPrediction[] => {\\\\n    return churnPredictions.value.filter(p => p.riskLevel === \\\\'medium\\\\' && p.status === \\\\'pending\\\\')\\\\n  }\\\\n\\\\n  const getLowRiskAlerts = (): ChurnPrediction[] => {\\\\n    return churnPredictions.value.filter(p => p.riskLevel === \\\\'low\\\\' && p.status === \\\\'pending\\\\')\\\\n  }\\\\n\\\\n  const getAlertsByStatus = (status: string): ChurnPrediction[] => {\\\\n    return churnPredictions.value.filter(p => p.status === status)\\\\n  }\\\\n\\\\n  const getRiskLevelColor = (riskLevel: string): string => {\\\\n    const colors: Record<string, string> = {\\\\n      high: \\\\'#F56C6C\\\\',\\\\n      medium: \\\\'#E6A23C\\\\',\\\\n      low: \\\\'#E6A23C\\\\'\\\\n    }\\\\n    return colors[riskLevel] || \\\\'#909399\\\\'\\\\n  }\\\\n\\\\n  const getRiskLevelLabel = (riskLevel: string): string => {\\\\n    const labels: Record<string, string> = {\\\\n      high: \\\\'高危\\\\',\\\\n      medium: \\\\'中危\\\\',\\\\n      low: \\\\'低危\\\\'\\\\n    }\\\\n    return labels[riskLevel] || \\\\'未知\\\\'\\\\n  }\\\\n\\\\n  const getStatusColor = (status: string): string => {\\\\n    const colors: Record<string, string> = {\\\\n      pending: \\\\'#F56C6C\\\\',\\\\n      in_progress: \\\\'#E6A23C\\\\',\\\\n      resolved: \\\\'#67C23A\\\\',\\\\n      closed: \\\\'#909399\\\\'\\\\n    }\\\\n    return colors[status] || \\\\'#909399\\\\'\\\\n  }\\\\n\\\\n  const getStatusLabel = (status: string): string => {\\\\n    const labels: Record<string, string> = {\\\\n      pending: \\\\'待处理\\\\',\\\\n      in_progress: \\\\'处理中\\\\',\\\\n      resolved: \\\\'已解决\\\\',\\\\n      closed: \\\\'已关闭\\\\'\\\\n    }\\\\n    return labels[status] || \\\\'未知\\\\'\\\\n  }\\\\n\\\\n  const getUrgency = (prediction: ChurnPrediction): string => {\\\\n    const daysUntilChurn = Math.floor(\\\\n      (prediction.predictedChurnDate.getTime() - Date.now()) / (1000 * 60 * 60 * 24)\\\\n    )\\\\n\\\\n    if (daysUntilChurn <= 7) return \\\\'紧急\\\\'\\\\n    if (daysUntilChurn <= 14) return \\\\'高\\\\'\\\\n    if (daysUntilChurn <= 30) return \\\\'中\\\\'\\\\n    return \\\\'低\\\\'\\\\n  }\\\\n\\\\n  const getUrgencyColor = (urgency: string): string => {\\\\n    const colors: Record<string, string> = {\\\\n      紧急: \\\\'#F56C6C\\\\',\\\\n      高: \\\\'#E6A23C\\\\',\\\\n      中: \\\\'#409EFF\\\\',\\\\n      低: \\\\'#67C23A\\\\'\\\\n    }\\\\n    return colors[urgency] || \\\\'#909399\\\\'\\\\n  }\\\\n\\\\n  return {\\\\n    loading,\\\\n    churnPredictions,\\\\n    churnStatistics,\\\\n    trendAnalysis,\\\\n    predictCustomerChurn,\\\\n    batchPredictChurn,\\\\n    assignAlert,\\\\n    resolveAlert,\\\\n    closeAlert,\\\\n    getHighRiskAlerts,\\\\n    getMediumRiskAlerts,\\\\n    getLowRiskAlerts,\\\\n    getAlertsByStatus,\\\\n    getRiskLevelColor,\\\\n    getRiskLevelLabel,\\\\n    getStatusColor,\\\\n    getStatusLabel,\\\\n    getUrgency,\\\\n    getUrgencyColor\\\\n  }\\\\n}\\\\n\",\"originAcceptText\":\"/**\\n * @fileoverview YYC³餐饮管理系统 - 客户流失预警机制\\n * @description 实现客户流失预测和预警功能\\n * @module churn-prediction\\n * @author YYC³\\n * @version 1.0.0\\n * @created 2025-01-20\\n */\\n\\nimport { ref, computed } from 'vue'\\nimport { ElMessage } from 'element-plus'\\n\\nexport interface ChurnPrediction {\\n  customerId: string\\n  customerName: string\\n  customerPhone: string\\n  customerEmail: string\\n  churnProbability: number\\n  riskLevel: 'high' | 'medium' | 'low'\\n  riskFactors: string[]\\n  predictedChurnDate: Date\\n  recommendations: string[]\\n  assignedTo: string | null\\n  status: 'pending' | 'in_progress' | 'resolved' | 'closed'\\n  createdAt: Date\\n  updatedAt: Date\\n}\\n\\nexport interface Customer {\\n  id: string\\n  name: string\\n  phone: string\\n  email: string\\n  lifecycleStage: string\\n  lastOrderDate: Date | null\\n  orderCount: number\\n  totalSpent: number\\n  satisfactionScore: number\\n  registeredAt: Date\\n  recentOrders: any[]\\n  recentInteractions: any[]\\n}\\n\\nclass ChurnPredictionModel {\\n  private readonly HIGH_RISK_THRESHOLD = 0.7\\n  private readonly MEDIUM_RISK_THRESHOLD = 0.4\\n  private readonly INACTIVE_DAYS_THRESHOLD = 30\\n  private readonly FREQUENCY_DROP_THRESHOLD = 0.5\\n  private readonly SPENDING_DROP_THRESHOLD = 0.5\\n  private readonly SATISFACTION_THRESHOLD = 3.5\\n\\n  predictChurn(customer: Customer): ChurnPrediction {\\n    const riskFactors: string[] = []\\n    let churnProbability = 0\\n\\n    const daysSinceLastOrder = this.getDaysSince(customer.lastOrderDate)\\n    const frequencyDrop = this.calculateFrequencyDrop(customer)\\n    const spendingDrop = this.calculateSpendingDrop(customer)\\n\\n    if (this.isInactive(customer, 30)) {\\n      churnProbability += 0.2\\n      riskFactors.push('30天未消费')\\n    }\\n\\n    if (this.isInactive(customer, 60)) {\\n      churnProbability += 0.3\\n      riskFactors.push('60天未消费')\\n    }\\n\\n    if (frequencyDrop <= -this.FREQUENCY_DROP_THRESHOLD) {\\n      churnProbability += 0.25\\n      riskFactors.push(`消费频次下降${Math.abs(frequencyDrop * 100).toFixed(0)}%`)\\n    }\\n\\n    if (spendingDrop <= -this.SPENDING_DROP_THRESHOLD) {\\n      churnProbability += 0.15\\n      riskFactors.push(`消费金额下降${Math.abs(spendingDrop * 100).toFixed(0)}%`)\\n    }\\n\\n    if (customer.satisfactionScore < this.SATISFACTION_THRESHOLD) {\\n      churnProbability += 0.1\\n      riskFactors.push(`满意度评分${customer.satisfactionScore}分`)\\n    }\\n\\n    if (customer.lifecycleStage === 'dormant') {\\n      churnProbability += 0.15\\n      riskFactors.push('处于休眠状态')\\n    }\\n\\n    churnProbability = Math.min(churnProbability, 1.0)\\n\\n    const riskLevel = this.getRiskLevel(churnProbability)\\n    const predictedChurnDate = this.predictChurnDate(churnProbability)\\n    const recommendations = this.generateRecommendations(riskFactors)\\n\\n    return {\\n      customerId: customer.id,\\n      customerName: customer.name,\\n      customerPhone: customer.phone,\\n      customerEmail: customer.email,\\n      churnProbability: Math.round(churnProbability * 100) / 100,\\n      riskLevel,\\n      riskFactors,\\n      predictedChurnDate,\\n      recommendations,\\n      assignedTo: null,\\n      status: 'pending',\\n      createdAt: new Date(),\\n      updatedAt: new Date()\\n    }\\n  }\\n\\n  batchPredict(customers: Customer[]): ChurnPrediction[] {\\n    return customers.map(customer => this.predictChurn(customer))\\n  }\\n\\n  private isInactive(customer: Customer, days: number): boolean {\\n    if (!customer.lastOrderDate) return true\\n    const daysSinceLastOrder = this.getDaysSince(customer.lastOrderDate)\\n    return daysSinceLastOrder > days\\n  }\\n\\n  private getDaysSince(date: Date | null): number {\\n    if (!date) return Infinity\\n    return Math.floor((Date.now() - new Date(date).getTime()) / (1000 * 60 * 60 * 24))\\n  }\\n\\n  private calculateFrequencyDrop(customer: Customer): number {\\n    const currentFrequency = this.calculateMonthlyFrequency(customer, 30)\\n    const previousFrequency = this.calculateMonthlyFrequency(customer, 90)\\n\\n    if (previousFrequency === 0) return 0\\n\\n    return (currentFrequency - previousFrequency) / previousFrequency\\n  }\\n\\n  private calculateSpendingDrop(customer: Customer): number {\\n    const currentSpending = this.calculateMonthlySpending(customer, 30)\\n    const previousSpending = this.calculateMonthlySpending(customer, 90)\\n\\n    if (previousSpending === 0) return 0\\n\\n    return (currentSpending - previousSpending) / previousSpending\\n  }\\n\\n  private calculateMonthlyFrequency(customer: Customer, days: number): number {\\n    if (days <= 0) return 0\\n\\n    const recentOrders = customer.recentOrders?.filter(order => {\\n      const orderDate = new Date(order.createdAt)\\n      const daysSinceOrder = this.getDaysSince(orderDate)\\n      return daysSinceOrder <= days\\n    }) || []\\n\\n    return (recentOrders.length / days) * 30\\n  }\\n\\n  private calculateMonthlySpending(customer: Customer, days: number): number {\\n    if (days <= 0) return 0\\n\\n    const recentOrders = customer.recentOrders?.filter(order => {\\n      const orderDate = new Date(order.createdAt)\\n      const daysSinceOrder = this.getDaysSince(orderDate)\\n      return daysSinceOrder <= days\\n    }) || []\\n\\n    const totalSpent = recentOrders.reduce((sum, order) => sum + (order.amount || 0), 0)\\n    return (totalSpent / days) * 30\\n  }\\n\\n  private getRiskLevel(probability: number): 'high' | 'medium' | 'low' {\\n    if (probability >= this.HIGH_RISK_THRESHOLD) return 'high'\\n    if (probability >= this.MEDIUM_RISK_THRESHOLD) return 'medium'\\n    return 'low'\\n  }\\n\\n  private predictChurnDate(probability: number): Date {\\n    const daysToChurn = Math.floor(90 * (1 - probability))\\n    return new Date(Date.now() + daysToChurn * 24 * 60 * 60 * 1000)\\n  }\\n\\n  private generateRecommendations(riskFactors: string[]): string[] {\\n    const recommendations: string[] = []\\n\\n    if (riskFactors.some(f => f.includes('30天未消费') || f.includes('60天未消费'))) {\\n      recommendations.push('发送唤醒优惠券')\\n      recommendations.push('安排客服回访')\\n      recommendations.push('个性化推荐优惠活动')\\n    }\\n\\n    if (riskFactors.some(f => f.includes('消费频次下降'))) {\\n      recommendations.push('了解消费下降原因')\\n      recommendations.push('提供专属优惠')\\n      recommendations.push('推荐热门商品')\\n    }\\n\\n    if (riskFactors.some(f => f.includes('消费金额下降'))) {\\n      recommendations.push('了解消费下降原因')\\n      recommendations.push('提供套餐优惠')\\n      recommendations.push('推荐高价值商品')\\n    }\\n\\n    if (riskFactors.some(f => f.includes('满意度'))) {\\n      recommendations.push('安排满意度调研')\\n      recommendations.push('改进服务质量')\\n      recommendations.push('提供补偿方案')\\n    }\\n\\n    if (riskFactors.some(f => f.includes('休眠状态'))) {\\n      recommendations.push('发送专属唤醒优惠')\\n      recommendations.push('VIP客服对接')\\n      recommendations.push('定制化服务方案')\\n    }\\n\\n    if (recommendations.length === 0) {\\n      recommendations.push('定期跟进客户')\\n      recommendations.push('保持客户互动')\\n      recommendations.push('提升服务质量')\\n    }\\n\\n    return recommendations\\n  }\\n\\n  getChurnStatistics(predictions: ChurnPrediction[]): any {\\n    const total = predictions.length\\n    const highRisk = predictions.filter(p => p.riskLevel === 'high').length\\n    const mediumRisk = predictions.filter(p => p.riskLevel === 'medium').length\\n    const lowRisk = predictions.filter(p => p.riskLevel === 'low').length\\n\\n    const avgChurnProbability = predictions.length > 0\\n      ? predictions.reduce((sum, p) => sum + p.churnProbability, 0) / predictions.length\\n      : 0\\n\\n    const riskFactorCounts: Record<string, number> = {}\\n    predictions.forEach(p => {\\n      p.riskFactors.forEach(factor => {\\n        if (!riskFactorCounts[factor]) {\\n          riskFactorCounts[factor] = 0\\n        }\\n        riskFactorCounts[factor]++\\n      })\\n    })\\n\\n    const topRiskFactors = Object.entries(riskFactorCounts)\\n      .sort((a, b) => b[1] - a[1])\\n      .slice(0, 5)\\n      .map(([factor, count]) => ({\\n        factor,\\n        count,\\n        percentage: Math.round((count / total) * 100)\\n      }))\\n\\n    return {\\n      total,\\n      highRisk,\\n      mediumRisk,\\n      lowRisk,\\n      highRiskPercentage: Math.round((highRisk / total) * 100),\\n      mediumRiskPercentage: Math.round((mediumRisk / total) * 100),\\n      lowRiskPercentage: Math.round((lowRisk / total) * 100),\\n      avgChurnProbability: Math.round(avgChurnProbability * 100) / 100,\\n      topRiskFactors\\n    }\\n  }\\n\\n  getTrendAnalysis(predictions: ChurnPrediction[]): any {\\n    const now = new Date()\\n    const oneWeekAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000)\\n    const twoWeeksAgo = new Date(now.getTime() - 14 * 24 * 60 * 60 * 1000)\\n    const oneMonthAgo = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000)\\n\\n    const currentWeek = predictions.filter(p => p.createdAt >= oneWeekAgo)\\n    const previousWeek = predictions.filter(p => p.createdAt >= twoWeeksAgo && p.createdAt < oneWeekAgo)\\n    const currentMonth = predictions.filter(p => p.createdAt >= oneMonthAgo)\\n\\n    const currentWeekHighRisk = currentWeek.filter(p => p.riskLevel === 'high').length\\n    const previousWeekHighRisk = previousWeek.filter(p => p.riskLevel === 'high').length\\n\\n    const weekTrend = previousWeekHighRisk > 0\\n      ? ((currentWeekHighRisk - previousWeekHighRisk) / previousWeekHighRisk) * 100\\n      : 0\\n\\n    return {\\n      currentWeekCount: currentWeek.length,\\n      previousWeekCount: previousWeek.length,\\n      currentMonthCount: currentMonth.length,\\n      currentWeekHighRisk,\\n      previousWeekHighRisk,\\n      weekTrend: Math.round(weekTrend * 10) / 10,\\n      avgChurnProbability: {\\n        currentWeek: this.calculateAvgProbability(currentWeek),\\n        previousWeek: this.calculateAvgProbability(previousWeek),\\n        currentMonth: this.calculateAvgProbability(currentMonth)\\n      }\\n    }\\n  }\\n\\n  private calculateAvgProbability(predictions: ChurnPrediction[]): number {\\n    if (predictions.length === 0) return 0\\n    return predictions.reduce((sum, p) => sum + p.churnProbability, 0) / predictions.length\\n  }\\n}\\n\\nconst churnPredictionModel = new ChurnPredictionModel()\\n\\nexport function useChurnPrediction() {\\n  const loading = ref(false)\\n  const churnPredictions = ref<ChurnPrediction[]>([])\\n  const churnStatistics = ref<any>(null)\\n  const trendAnalysis = ref<any>(null)\\n\\n  const predictCustomerChurn = (customer: Customer): ChurnPrediction => {\\n    try {\\n      const prediction = churnPredictionModel.predictChurn(customer)\\n      return prediction\\n    } catch (error) {\\n      console.error('Predict churn failed:', error)\\n      ElMessage.error('预测客户流失失败')\\n      throw error\\n    }\\n  }\\n\\n  const batchPredictChurn = async (customers: Customer[]) => {\\n    loading.value = true\\n    try {\\n      const predictions = churnPredictionModel.batchPredict(customers)\\n      churnPredictions.value = predictions\\n      churnStatistics.value = churnPredictionModel.getChurnStatistics(predictions)\\n      trendAnalysis.value = churnPredictionModel.getTrendAnalysis(predictions)\\n      return predictions\\n    } catch (error) {\\n      console.error('Batch predict churn failed:', error)\\n      ElMessage.error('批量预测流失失败')\\n      return []\\n    } finally {\\n      loading.value = false\\n    }\\n  }\\n\\n  const assignAlert = (alertId: string, assignedTo: string): void => {\\n    const alert = churnPredictions.value.find(p => p.customerId === alertId)\\n    if (alert) {\\n      alert.assignedTo = assignedTo\\n      alert.status = 'in_progress'\\n      alert.updatedAt = new Date()\\n      ElMessage.success('预警已分配')\\n    }\\n  }\\n\\n  const resolveAlert = (alertId: string, resolutionNotes: string): void => {\\n    const alert = churnPredictions.value.find(p => p.customerId === alertId)\\n    if (alert) {\\n      alert.status = 'resolved'\\n      alert.updatedAt = new Date()\\n      ElMessage.success('预警已解决')\\n    }\\n  }\\n\\n  const closeAlert = (alertId: string): void => {\\n    const alert = churnPredictions.value.find(p => p.customerId === alertId)\\n    if (alert) {\\n      alert.status = 'closed'\\n      alert.updatedAt = new Date()\\n      ElMessage.success('预警已关闭')\\n    }\\n  }\\n\\n  const getHighRiskAlerts = (): ChurnPrediction[] => {\\n    return churnPredictions.value.filter(p => p.riskLevel === 'high' && p.status === 'pending')\\n  }\\n\\n  const getMediumRiskAlerts = (): ChurnPrediction[] => {\\n    return churnPredictions.value.filter(p => p.riskLevel === 'medium' && p.status === 'pending')\\n  }\\n\\n  const getLowRiskAlerts = (): ChurnPrediction[] => {\\n    return churnPredictions.value.filter(p => p.riskLevel === 'low' && p.status === 'pending')\\n  }\\n\\n  const getAlertsByStatus = (status: string): ChurnPrediction[] => {\\n    return churnPredictions.value.filter(p => p.status === status)\\n  }\\n\\n  const getRiskLevelColor = (riskLevel: string): string => {\\n    const colors: Record<string, string> = {\\n      high: '#F56C6C',\\n      medium: '#E6A23C',\\n      low: '#E6A23C'\\n    }\\n    return colors[riskLevel] || '#909399'\\n  }\\n\\n  const getRiskLevelLabel = (riskLevel: string): string => {\\n    const labels: Record<string, string> = {\\n      high: '高危',\\n      medium: '中危',\\n      low: '低危'\\n    }\\n    return labels[riskLevel] || '未知'\\n  }\\n\\n  const getStatusColor = (status: string): string => {\\n    const colors: Record<string, string> = {\\n      pending: '#F56C6C',\\n      in_progress: '#E6A23C',\\n      resolved: '#67C23A',\\n      closed: '#909399'\\n    }\\n    return colors[status] || '#909399'\\n  }\\n\\n  const getStatusLabel = (status: string): string => {\\n    const labels: Record<string, string> = {\\n      pending: '待处理',\\n      in_progress: '处理中',\\n      resolved: '已解决',\\n      closed: '已关闭'\\n    }\\n    return labels[status] || '未知'\\n  }\\n\\n  const getUrgency = (prediction: ChurnPrediction): string => {\\n    const daysUntilChurn = Math.floor(\\n      (prediction.predictedChurnDate.getTime() - Date.now()) / (1000 * 60 * 60 * 24)\\n    )\\n\\n    if (daysUntilChurn <= 7) return '紧急'\\n    if (daysUntilChurn <= 14) return '高'\\n    if (daysUntilChurn <= 30) return '中'\\n    return '低'\\n  }\\n\\n  const getUrgencyColor = (urgency: string): string => {\\n    const colors: Record<string, string> = {\\n      紧急: '#F56C6C',\\n      高: '#E6A23C',\\n      中: '#409EFF',\\n      低: '#67C23A'\\n    }\\n    return colors[urgency] || '#909399'\\n  }\\n\\n  return {\\n    loading,\\n    churnPredictions,\\n    churnStatistics,\\n    trendAnalysis,\\n    predictCustomerChurn,\\n    batchPredictChurn,\\n    assignAlert,\\n    resolveAlert,\\n    closeAlert,\\n    getHighRiskAlerts,\\n    getMediumRiskAlerts,\\n    getLowRiskAlerts,\\n    getAlertsByStatus,\\n    getRiskLevelColor,\\n    getRiskLevelLabel,\\n    getStatusColor,\\n    getStatusLabel,\\n    getUrgency,\\n    getUrgencyColor\\n  }\\n}\\n\",\"originTextLength\":14233,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768910884684}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/views/CustomerLifecycleDashboard.vue": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":945,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":945,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"<template>\\\\n  <div class=\\\\\\\"customer-lifecycle-dashboard\\\\\\\">\\\\n    <div class=\\\\\\\"dashboard-header\\\\\\\">\\\\n      <h1>客户生命周期管理看板</h1>\\\\n      <div class=\\\\\\\"header-actions\\\\\\\">\\\\n        <el-date-picker\\\\n          v-model=\\\\\\\"dateRange\\\\\\\"\\\\n          type=\\\\\\\"daterange\\\\\\\"\\\\n          range-separator=\\\\\\\"至\\\\\\\"\\\\n          start-placeholder=\\\\\\\"开始日期\\\\\\\"\\\\n          end-placeholder=\\\\\\\"结束日期\\\\\\\"\\\\n          @change=\\\\\\\"loadDashboardData\\\\\\\"\\\\n        />\\\\n        <el-button type=\\\\\\\"primary\\\\\\\" @click=\\\\\\\"loadDashboardData\\\\\\\" :loading=\\\\\\\"loading\\\\\\\">\\\\n          <el-icon><Refresh /></el-icon>\\\\n          刷新数据\\\\n        </el-button>\\\\n        <el-button @click=\\\\\\\"exportDashboard\\\\\\\">\\\\n          <el-icon><Download /></el-icon>\\\\n          导出报告\\\\n        </el-button>\\\\n      </div>\\\\n    </div>\\\\n\\\\n    <el-row :gutter=\\\\\\\"20\\\\\\\" class=\\\\\\\"metrics-row\\\\\\\">\\\\n      <el-col :span=\\\\\\\"4\\\\\\\" v-for=\\\\\\\"metric in overviewMetrics\\\\\\\" :key=\\\\\\\"metric.key\\\\\\\">\\\\n        <el-card class=\\\\\\\"metric-card\\\\\\\" :class=\\\\\\\"metric.type\\\\\\\">\\\\n          <div class=\\\\\\\"metric-content\\\\\\\">\\\\n            <div class=\\\\\\\"metric-icon\\\\\\\" :style=\\\\\\\"{ backgroundColor: metric.color }\\\\\\\">\\\\n              <el-icon :size=\\\\\\\"32\\\\\\\">\\\\n                <component :is=\\\\\\\"metric.icon\\\\\\\" />\\\\n              </el-icon>\\\\n            </div>\\\\n            <div class=\\\\\\\"metric-info\\\\\\\">\\\\n              <div class=\\\\\\\"metric-value\\\\\\\">{{ metric.value }}</div>\\\\n              <div class=\\\\\\\"metric-label\\\\\\\">{{ metric.label }}</div>\\\\n              <div class=\\\\\\\"metric-trend\\\\\\\" v-if=\\\\\\\"metric.trend !== undefined\\\\\\\">\\\\n                <el-icon :size=\\\\\\\"14\\\\\\\" :color=\\\\\\\"getTrendColor(metric.trendType)\\\\\\\">\\\\n                  <component :is=\\\\\\\"getTrendIcon(metric.trendType)\\\\\\\" />\\\\n                </el-icon>\\\\n                <span>{{ metric.trend }}%</span>\\\\n              </div>\\\\n            </div>\\\\n          </div>\\\\n        </el-card>\\\\n      </el-col>\\\\n    </el-row>\\\\n\\\\n    <el-row :gutter=\\\\\\\"20\\\\\\\" class=\\\\\\\"charts-row\\\\\\\">\\\\n      <el-col :span=\\\\\\\"12\\\\\\\">\\\\n        <el-card class=\\\\\\\"chart-card\\\\\\\">\\\\n          <template #header>\\\\n            <div class=\\\\\\\"card-header\\\\\\\">\\\\n              <span>生命周期阶段分布</span>\\\\n              <el-radio-group v-model=\\\\\\\"stageViewType\\\\\\\" size=\\\\\\\"small\\\\\\\">\\\\n                <el-radio-button label=\\\\\\\"pie\\\\\\\">饼图</el-radio-button>\\\\n                <el-radio-button label=\\\\\\\"bar\\\\\\\">柱状图</el-radio-button>\\\\n              </el-radio-group>\\\\n            </div>\\\\n          </template>\\\\n          <div ref=\\\\\\\"stageDistributionChart\\\\\\\" class=\\\\\\\"chart-container\\\\\\\"></div>\\\\n        </el-card>\\\\n      </el-col>\\\\n\\\\n      <el-col :span=\\\\\\\"12\\\\\\\">\\\\n        <el-card class=\\\\\\\"chart-card\\\\\\\">\\\\n          <template #header>\\\\n            <div class=\\\\\\\"card-header\\\\\\\">\\\\n              <span>客户价值分布（RFM）</span>\\\\n            </div>\\\\n          </template>\\\\n          <div ref=\\\\\\\"valueDistributionChart\\\\\\\" class=\\\\\\\"chart-container\\\\\\\"></div>\\\\n        </el-card>\\\\n      </el-col>\\\\n    </el-row>\\\\n\\\\n    <el-row :gutter=\\\\\\\"20\\\\\\\" class=\\\\\\\"charts-row\\\\\\\">\\\\n      <el-col :span=\\\\\\\"12\\\\\\\">\\\\n        <el-card class=\\\\\\\"chart-card\\\\\\\">\\\\n          <template #header>\\\\n            <div class=\\\\\\\"card-header\\\\\\\">\\\\n              <span>生命周期流转趋势</span>\\\\n            </div>\\\\n          </template>\\\\n          <div ref=\\\\\\\"flowTrendChart\\\\\\\" class=\\\\\\\"chart-container\\\\\\\"></div>\\\\n        </el-card>\\\\n      </el-col>\\\\n\\\\n      <el-col :span=\\\\\\\"12\\\\\\\">\\\\n        <el-card class=\\\\\\\"chart-card\\\\\\\">\\\\n          <template #header>\\\\n            <div class=\\\\\\\"card-header\\\\\\\">\\\\n              <span>客户留存率趋势</span>\\\\n            </div>\\\\n          </template>\\\\n          <div ref=\\\\\\\"retentionRateChart\\\\\\\" class=\\\\\\\"chart-container\\\\\\\"></div>\\\\n        </el-card>\\\\n      </el-col>\\\\n    </el-row>\\\\n\\\\n    <el-row :gutter=\\\\\\\"20\\\\\\\" class=\\\\\\\"charts-row\\\\\\\">\\\\n      <el-col :span=\\\\\\\"24\\\\\\\">\\\\n        <el-card class=\\\\\\\"chart-card\\\\\\\">\\\\n          <template #header>\\\\n            <div class=\\\\\\\"card-header\\\\\\\">\\\\n              <span>客户生命周期价值（CLV）分布</span>\\\\n            </div>\\\\n          </template>\\\\n          <div ref=\\\\\\\"clvDistributionChart\\\\\\\" class=\\\\\\\"chart-container\\\\\\\"></div>\\\\n        </el-card>\\\\n      </el-col>\\\\n    </el-row>\\\\n\\\\n    <el-row :gutter=\\\\\\\"20\\\\\\\" class=\\\\\\\"alerts-row\\\\\\\">\\\\n      <el-col :span=\\\\\\\"24\\\\\\\">\\\\n        <el-card class=\\\\\\\"alerts-card\\\\\\\">\\\\n          <template #header>\\\\n            <div class=\\\\\\\"card-header\\\\\\\">\\\\n              <span>流失预警</span>\\\\n              <div class=\\\\\\\"header-actions\\\\\\\">\\\\n                <el-radio-group v-model=\\\\\\\"alertRiskLevel\\\\\\\" size=\\\\\\\"small\\\\\\\" @change=\\\\\\\"filterAlerts\\\\\\\">\\\\n                  <el-radio-button label=\\\\\\\"all\\\\\\\">全部</el-radio-button>\\\\n                  <el-radio-button label=\\\\\\\"high\\\\\\\">高危</el-radio-button>\\\\n                  <el-radio-button label=\\\\\\\"medium\\\\\\\">中危</el-radio-button>\\\\n                  <el-radio-button label=\\\\\\\"low\\\\\\\">低危</el-radio-button>\\\\n                </el-radio-group>\\\\n              </div>\\\\n            </div>\\\\n          </template>\\\\n          <el-table :data=\\\\\\\"filteredAlerts\\\\\\\" style=\\\\\\\"width: 100%\\\\\\\">\\\\n            <el-table-column prop=\\\\\\\"customerName\\\\\\\" label=\\\\\\\"客户名称\\\\\\\" width=\\\\\\\"120\\\\\\\" />\\\\n            <el-table-column prop=\\\\\\\"churnProbability\\\\\\\" label=\\\\\\\"流失概率\\\\\\\" width=\\\\\\\"100\\\\\\\">\\\\n              <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                <el-tag :type=\\\\\\\"getChurnProbabilityType(row.churnProbability)\\\\\\\">\\\\n                  {{ (row.churnProbability * 100).toFixed(0) }}%\\\\n                </el-tag>\\\\n              </template>\\\\n            </el-table-column>\\\\n            <el-table-column prop=\\\\\\\"riskLevel\\\\\\\" label=\\\\\\\"风险等级\\\\\\\" width=\\\\\\\"80\\\\\\\">\\\\n              <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                <el-tag :type=\\\\\\\"getRiskLevelType(row.riskLevel)\\\\\\\">\\\\n                  {{ getRiskLevelLabel(row.riskLevel) }}\\\\n                </el-tag>\\\\n              </template>\\\\n            </el-table-column>\\\\n            <el-table-column prop=\\\\\\\"riskFactors\\\\\\\" label=\\\\\\\"风险因素\\\\\\\" width=\\\\\\\"200\\\\\\\">\\\\n              <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                <el-tag\\\\n                  v-for=\\\\\\\"factor in row.riskFactors\\\\\\\"\\\\n                  :key=\\\\\\\"factor\\\\\\\"\\\\n                  size=\\\\\\\"small\\\\\\\"\\\\n                  style=\\\\\\\"margin-right: 5px;\\\\\\\"\\\\n                >\\\\n                  {{ factor }}\\\\n                </el-tag>\\\\n              </template>\\\\n            </el-table-column>\\\\n            <el-table-column prop=\\\\\\\"predictedChurnDate\\\\\\\" label=\\\\\\\"预计流失日期\\\\\\\" width=\\\\\\\"120\\\\\\\">\\\\n              <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                {{ formatDate(row.predictedChurnDate) }}\\\\n              </template>\\\\n            </el-table-column>\\\\n            <el-table-column prop=\\\\\\\"status\\\\\\\" label=\\\\\\\"状态\\\\\\\" width=\\\\\\\"100\\\\\\\">\\\\n              <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                <el-tag :type=\\\\\\\"getStatusType(row.status)\\\\\\\">\\\\n                  {{ getStatusLabel(row.status) }}\\\\n                </el-tag>\\\\n              </template>\\\\n            </el-table-column>\\\\n            <el-table-column label=\\\\\\\"操作\\\\\\\" width=\\\\\\\"200\\\\\\\">\\\\n              <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                <el-button\\\\n                  v-if=\\\\\\\"row.status === \\\\'pending\\\\'\\\\\\\"\\\\n                  type=\\\\\\\"primary\\\\\\\"\\\\n                  size=\\\\\\\"small\\\\\\\"\\\\n                  @click=\\\\\\\"assignAlert(row)\\\\\\\"\\\\n                >\\\\n                  分配处理\\\\n                </el-button>\\\\n                <el-button\\\\n                  v-if=\\\\\\\"row.status === \\\\'in_progress\\\\'\\\\\\\"\\\\n                  type=\\\\\\\"success\\\\\\\"\\\\n                  size=\\\\\\\"small\\\\\\\"\\\\n                  @click=\\\\\\\"resolveAlert(row)\\\\\\\"\\\\n                >\\\\n                  标记解决\\\\n                </el-button>\\\\n                <el-button\\\\n                  size=\\\\\\\"small\\\\\\\"\\\\n                  @click=\\\\\\\"viewCustomerDetail(row)\\\\\\\"\\\\n                >\\\\n                  查看详情\\\\n                </el-button>\\\\n              </template>\\\\n            </el-table-column>\\\\n          </el-table>\\\\n        </el-card>\\\\n      </el-col>\\\\n    </el-row>\\\\n\\\\n    <el-row :gutter=\\\\\\\"20\\\\\\\" class=\\\\\\\"care-reminders-row\\\\\\\">\\\\n      <el-col :span=\\\\\\\"24\\\\\\\">\\\\n        <el-card class=\\\\\\\"care-reminders-card\\\\\\\">\\\\n          <template #header>\\\\n            <div class=\\\\\\\"card-header\\\\\\\">\\\\n              <span>关怀提醒</span>\\\\n              <div class=\\\\\\\"header-actions\\\\\\\">\\\\n                <el-radio-group v-model=\\\\\\\"careReminderStatus\\\\\\\" size=\\\\\\\"small\\\\\\\" @change=\\\\\\\"filterCareReminders\\\\\\\">\\\\n                  <el-radio-button label=\\\\\\\"pending\\\\\\\">待处理</el-radio-button>\\\\n                  <el-radio-button label=\\\\\\\"sent\\\\\\\">已发送</el-radio-button>\\\\n                  <el-radio-button label=\\\\\\\"all\\\\\\\">全部</el-radio-button>\\\\n                </el-radio-group>\\\\n              </div>\\\\n            </div>\\\\n          </template>\\\\n          <el-table :data=\\\\\\\"filteredCareReminders\\\\\\\" style=\\\\\\\"width: 100%\\\\\\\">\\\\n            <el-table-column prop=\\\\\\\"customerName\\\\\\\" label=\\\\\\\"客户名称\\\\\\\" width=\\\\\\\"120\\\\\\\" />\\\\n            <el-table-column prop=\\\\\\\"careType\\\\\\\" label=\\\\\\\"关怀类型\\\\\\\" width=\\\\\\\"120\\\\\\\">\\\\n              <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                <el-tag size=\\\\\\\"small\\\\\\\">\\\\n                  {{ getCareTypeLabel(row.careType) }}\\\\n                </el-tag>\\\\n              </template>\\\\n            </el-table-column>\\\\n            <el-table-column prop=\\\\\\\"content\\\\\\\" label=\\\\\\\"关怀内容\\\\\\\" min-width=\\\\\\\"200\\\\\\\" show-overflow-tooltip />\\\\n            <el-table-column prop=\\\\\\\"channels\\\\\\\" label=\\\\\\\"发送渠道\\\\\\\" width=\\\\\\\"150\\\\\\\">\\\\n              <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                <el-tag\\\\n                  v-for=\\\\\\\"channel in row.channels\\\\\\\"\\\\n                  :key=\\\\\\\"channel\\\\\\\"\\\\n                  size=\\\\\\\"small\\\\\\\"\\\\n                  style=\\\\\\\"margin-right: 5px;\\\\\\\"\\\\n                >\\\\n                  {{ getChannelLabel(channel) }}\\\\n                </el-tag>\\\\n              </template>\\\\n            </el-table-column>\\\\n            <el-table-column prop=\\\\\\\"scheduledAt\\\\\\\" label=\\\\\\\"计划发送时间\\\\\\\" width=\\\\\\\"150\\\\\\\">\\\\n              <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                {{ formatDateTime(row.scheduledAt) }}\\\\n              </template>\\\\n            </el-table-column>\\\\n            <el-table-column prop=\\\\\\\"status\\\\\\\" label=\\\\\\\"状态\\\\\\\" width=\\\\\\\"100\\\\\\\">\\\\n              <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                <el-tag :type=\\\\\\\"getCareStatusType(row.status)\\\\\\\">\\\\n                  {{ getCareStatusLabel(row.status) }}\\\\n                </el-tag>\\\\n              </template>\\\\n            </el-table-column>\\\\n            <el-table-column label=\\\\\\\"操作\\\\\\\" width=\\\\\\\"150\\\\\\\">\\\\n              <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                <el-button\\\\n                  v-if=\\\\\\\"row.status === \\\\'pending\\\\'\\\\\\\"\\\\n                  type=\\\\\\\"primary\\\\\\\"\\\\n                  size=\\\\\\\"small\\\\\\\"\\\\n                  @click=\\\\\\\"sendCareReminder(row)\\\\\\\"\\\\n                >\\\\n                  发送\\\\n                </el-button>\\\\n                <el-button\\\\n                  size=\\\\\\\"small\\\\\\\"\\\\n                  @click=\\\\\\\"viewReminderDetail(row)\\\\\\\"\\\\n                >\\\\n                  查看\\\\n                </el-button>\\\\n              </template>\\\\n            </el-table-column>\\\\n          </el-table>\\\\n        </el-card>\\\\n      </el-col>\\\\n    </el-row>\\\\n\\\\n    <el-dialog v-model=\\\\\\\"showAssignDialog\\\\\\\" title=\\\\\\\"分配流失预警\\\\\\\" width=\\\\\\\"500px\\\\\\\">\\\\n      <el-form :model=\\\\\\\"assignForm\\\\\\\" label-width=\\\\\\\"100px\\\\\\\">\\\\n        <el-form-item label=\\\\\\\"客户名称\\\\\\\">\\\\n          <el-input v-model=\\\\\\\"assignForm.customerName\\\\\\\" disabled />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"处理人员\\\\\\\">\\\\n          <el-select v-model=\\\\\\\"assignForm.assignedTo\\\\\\\" placeholder=\\\\\\\"请选择处理人员\\\\\\\">\\\\n            <el-option\\\\n              v-for=\\\\\\\"user in staffList\\\\\\\"\\\\n              :key=\\\\\\\"user.id\\\\\\\"\\\\n              :label=\\\\\\\"user.name\\\\\\\"\\\\n              :value=\\\\\\\"user.id\\\\\\\"\\\\n            />\\\\n          </el-select>\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"备注\\\\\\\">\\\\n          <el-input\\\\n            v-model=\\\\\\\"assignForm.notes\\\\\\\"\\\\n            type=\\\\\\\"textarea\\\\\\\"\\\\n            :rows=\\\\\\\"3\\\\\\\"\\\\n            placeholder=\\\\\\\"请输入备注信息\\\\\\\"\\\\n          />\\\\n        </el-form-item>\\\\n      </el-form>\\\\n      <template #footer>\\\\n        <el-button @click=\\\\\\\"showAssignDialog = false\\\\\\\">取消</el-button>\\\\n        <el-button type=\\\\\\\"primary\\\\\\\" @click=\\\\\\\"confirmAssign\\\\\\\">确认分配</el-button>\\\\n      </template>\\\\n    </el-dialog>\\\\n\\\\n    <el-dialog v-model=\\\\\\\"showResolveDialog\\\\\\\" title=\\\\\\\"标记预警已解决\\\\\\\" width=\\\\\\\"500px\\\\\\\">\\\\n      <el-form :model=\\\\\\\"resolveForm\\\\\\\" label-width=\\\\\\\"100px\\\\\\\">\\\\n        <el-form-item label=\\\\\\\"客户名称\\\\\\\">\\\\n          <el-input v-model=\\\\\\\"resolveForm.customerName\\\\\\\" disabled />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"解决说明\\\\\\\">\\\\n          <el-input\\\\n            v-model=\\\\\\\"resolveForm.resolutionNotes\\\\\\\"\\\\n            type=\\\\\\\"textarea\\\\\\\"\\\\n            :rows=\\\\\\\"4\\\\\\\"\\\\n            placeholder=\\\\\\\"请输入解决说明\\\\\\\"\\\\n          />\\\\n        </el-form-item>\\\\n      </el-form>\\\\n      <template #footer>\\\\n        <el-button @click=\\\\\\\"showResolveDialog = false\\\\\\\">取消</el-button>\\\\n        <el-button type=\\\\\\\"primary\\\\\\\" @click=\\\\\\\"confirmResolve\\\\\\\">确认解决</el-button>\\\\n      </template>\\\\n    </el-dialog>\\\\n  </div>\\\\n</template>\\\\n\\\\n<script setup lang=\\\\\\\"ts\\\\\\\">\\\\nimport { ref, computed, onMounted, onBeforeUnmount, nextTick } from \\\\'vue\\\\'\\\\nimport { ElMessage } from \\\\'element-plus\\\\'\\\\nimport * as echarts from \\\\'echarts\\\\'\\\\nimport {\\\\n  Refresh,\\\\n  Download,\\\\n  User,\\\\n  TrendCharts,\\\\n  Warning,\\\\n  ArrowUp,\\\\n  ArrowDown\\\\n} from \\\\'@element-plus/icons-vue\\\\'\\\\nimport { useLifecycleRuleEngine } from \\\\'@/composables/useLifecycleRuleEngine\\\\'\\\\nimport { useRFMModel } from \\\\'@/composables/useRFMModel\\\\'\\\\nimport { useCareReminder } from \\\\'@/composables/useCareReminder\\\\'\\\\nimport { useChurnPrediction } from \\\\'@/composables/useChurnPrediction\\\\'\\\\n\\\\nconst { loadRules } = useLifecycleRuleEngine()\\\\nconst { batchAnalyze, getScoreColor } = useRFMModel()\\\\nconst {\\\\n  pendingReminders,\\\\n  sentReminders,\\\\n  loadPendingReminders,\\\\n  loadSentReminders,\\\\n  sendReminder,\\\\n  getCareTypeLabel,\\\\n  getChannelLabel\\\\n} = useCareReminder()\\\\nconst {\\\\n  churnPredictions,\\\\n  batchPredictChurn,\\\\n  assignAlert,\\\\n  resolveAlert,\\\\n  getRiskLevelLabel,\\\\n  getRiskLevelColor,\\\\n  getStatusLabel,\\\\n  getStatusColor,\\\\n  getUrgency\\\\n} = useChurnPrediction()\\\\n\\\\nconst loading = ref(false)\\\\nconst dateRange = ref<[Date, Date] | null>(null)\\\\nconst stageViewType = ref(\\\\'pie\\\\')\\\\nconst alertRiskLevel = ref(\\\\'all\\\\')\\\\nconst careReminderStatus = ref(\\\\'pending\\\\')\\\\nconst showAssignDialog = ref(false)\\\\nconst showResolveDialog = ref(false)\\\\n\\\\nconst stageDistributionChart = ref<HTMLElement | null>(null)\\\\nconst valueDistributionChart = ref<HTMLElement | null>(null)\\\\nconst flowTrendChart = ref<HTMLElement | null>(null)\\\\nconst retentionRateChart = ref<HTMLElement | null>(null)\\\\nconst clvDistributionChart = ref<HTMLElement | null>(null)\\\\n\\\\nlet stageChartInstance: echarts.ECharts | null = null\\\\nlet valueChartInstance: echarts.ECharts | null = null\\\\nlet flowChartInstance: echarts.ECharts | null = null\\\\nlet retentionChartInstance: echarts.ECharts | null = null\\\\nlet clvChartInstance: echarts.ECharts | null = null\\\\n\\\\nconst overviewMetrics = computed(() => [\\\\n  {\\\\n    key: \\\\'total\\\\',\\\\n    label: \\\\'总客户数\\\\',\\\\n    value: \\\\'12,580\\\\',\\\\n    icon: User,\\\\n    type: \\\\'primary\\\\',\\\\n    color: \\\\'#409EFF\\\\',\\\\n    trend: 8.5,\\\\n    trendType: \\\\'up\\\\'\\\\n  },\\\\n  {\\\\n    key: \\\\'active\\\\',\\\\n    label: \\\\'活跃客户\\\\',\\\\n    value: \\\\'8,245\\\\',\\\\n    icon: TrendCharts,\\\\n    type: \\\\'success\\\\',\\\\n    color: \\\\'#67C23A\\\\',\\\\n    trend: 12.3,\\\\n    trendType: \\\\'up\\\\'\\\\n  },\\\\n  {\\\\n    key: \\\\'churned\\\\',\\\\n    label: \\\\'流失客户\\\\',\\\\n    value: \\\\'425\\\\',\\\\n    icon: Warning,\\\\n    type: \\\\'danger\\\\',\\\\n    color: \\\\'#F56C6C\\\\',\\\\n    trend: -5.2,\\\\n    trendType: \\\\'down\\\\'\\\\n  },\\\\n  {\\\\n    key: \\\\'retention\\\\',\\\\n    label: \\\\'客户留存率\\\\',\\\\n    value: \\\\'96.6%\\\\',\\\\n    icon: TrendCharts,\\\\n    type: \\\\'warning\\\\',\\\\n    color: \\\\'#E6A23C\\\\',\\\\n    trend: 2.1,\\\\n    trendType: \\\\'up\\\\'\\\\n  },\\\\n  {\\\\n    key: \\\\'clv\\\\',\\\\n    label: \\\\'平均CLV\\\\',\\\\n    value: \\\\'¥2,580\\\\',\\\\n    icon: TrendCharts,\\\\n    type: \\\\'info\\\\',\\\\n    color: \\\\'#909399\\\\',\\\\n    trend: 15.8,\\\\n    trendType: \\\\'up\\\\'\\\\n  },\\\\n  {\\\\n    key: \\\\'satisfaction\\\\',\\\\n    label: \\\\'客户满意度\\\\',\\\\n    value: \\\\'4.3\\\\',\\\\n    icon: TrendCharts,\\\\n    type: \\\\'success\\\\',\\\\n    color: \\\\'#67C23A\\\\',\\\\n    trend: 3.5,\\\\n    trendType: \\\\'up\\\\'\\\\n  }\\\\n])\\\\n\\\\nconst filteredAlerts = computed(() => {\\\\n  let alerts = churnPredictions.value\\\\n  if (alertRiskLevel.value !== \\\\'all\\\\') {\\\\n    alerts = alerts.filter(a => a.riskLevel === alertRiskLevel.value)\\\\n  }\\\\n  return alerts\\\\n})\\\\n\\\\nconst filteredCareReminders = computed(() => {\\\\n  if (careReminderStatus.value === \\\\'pending\\\\') {\\\\n    return pendingReminders.value\\\\n  } else if (careReminderStatus.value === \\\\'sent\\\\') {\\\\n    return sentReminders.value\\\\n  }\\\\n  return [...pendingReminders.value, ...sentReminders.value]\\\\n})\\\\n\\\\nconst assignForm = ref({\\\\n  customerId: \\\\'\\\\',\\\\n  customerName: \\\\'\\\\',\\\\n  assignedTo: \\\\'\\\\',\\\\n  notes: \\\\'\\\\'\\\\n})\\\\n\\\\nconst resolveForm = ref({\\\\n  customerId: \\\\'\\\\',\\\\n  customerName: \\\\'\\\\',\\\\n  resolutionNotes: \\\\'\\\\'\\\\n})\\\\n\\\\nconst staffList = ref([\\\\n  { id: \\\\'1\\\\', name: \\\\'张三\\\\' },\\\\n  { id: \\\\'2\\\\', name: \\\\'李四\\\\' },\\\\n  { id: \\\\'3\\\\', name: \\\\'王五\\\\' }\\\\n])\\\\n\\\\nconst loadDashboardData = async () => {\\\\n  loading.value = true\\\\n  try {\\\\n    await Promise.all([\\\\n      loadPendingReminders(),\\\\n      loadSentReminders()\\\\n    ])\\\\n\\\\n    await nextTick()\\\\n    initCharts()\\\\n  } catch (error) {\\\\n    console.error(\\\\'Load dashboard data failed:\\\\', error)\\\\n    ElMessage.error(\\\\'加载看板数据失败\\\\')\\\\n  } finally {\\\\n    loading.value = false\\\\n  }\\\\n}\\\\n\\\\nconst initCharts = () => {\\\\n  initStageDistributionChart()\\\\n  initValueDistributionChart()\\\\n  initFlowTrendChart()\\\\n  initRetentionRateChart()\\\\n  initCLVDistributionChart()\\\\n}\\\\n\\\\nconst initStageDistributionChart = () => {\\\\n  if (!stageDistributionChart.value) return\\\\n\\\\n  if (stageChartInstance) {\\\\n    stageChartInstance.dispose()\\\\n  }\\\\n\\\\n  stageChartInstance = echarts.init(stageDistributionChart.value)\\\\n\\\\n  const option = {\\\\n    tooltip: {\\\\n      trigger: \\\\'item\\\\',\\\\n      formatter: \\\\'{b}: {c} ({d}%)\\\\'\\\\n    },\\\\n    legend: {\\\\n      orient: \\\\'vertical\\\\',\\\\n      left: \\\\'left\\\\'\\\\n    },\\\\n    series: [\\\\n      {\\\\n        name: \\\\'生命周期阶段\\\\',\\\\n        type: \\\\'pie\\\\',\\\\n        radius: [\\\\'40%\\\\', \\\\'70%\\\\'],\\\\n        avoidLabelOverlap: false,\\\\n        itemStyle: {\\\\n          borderRadius: 10,\\\\n          borderColor: \\\\'#fff\\\\',\\\\n          borderWidth: 2\\\\n        },\\\\n        label: {\\\\n          show: false,\\\\n          position: \\\\'center\\\\'\\\\n        },\\\\n        emphasis: {\\\\n          label: {\\\\n            show: true,\\\\n            fontSize: 20,\\\\n            fontWeight: \\\\'bold\\\\'\\\\n          }\\\\n        },\\\\n        labelLine: {\\\\n          show: false\\\\n        },\\\\n        data: [\\\\n          { value: 2500, name: \\\\'潜在客户\\\\', itemStyle: { color: \\\\'#909399\\\\' } },\\\\n          { value: 1887, name: \\\\'新客户\\\\', itemStyle: { color: \\\\'#409EFF\\\\' } },\\\\n          { value: 5032, name: \\\\'活跃客户\\\\', itemStyle: { color: \\\\'#67C23A\\\\' } },\\\\n          { value: 1887, name: \\\\'忠诚客户\\\\', itemStyle: { color: \\\\'#E6A23C\\\\' } },\\\\n          { value: 1005, name: \\\\'休眠客户\\\\', itemStyle: { color: \\\\'#F56C6C\\\\' } },\\\\n          { value: 269, name: \\\\'流失客户\\\\', itemStyle: { color: \\\\'#909399\\\\' } }\\\\n        ]\\\\n      }\\\\n    ]\\\\n  }\\\\n\\\\n  stageChartInstance.setOption(option)\\\\n}\\\\n\\\\nconst initValueDistributionChart = () => {\\\\n  if (!valueDistributionChart.value) return\\\\n\\\\n  if (valueChartInstance) {\\\\n    valueChartInstance.dispose()\\\\n  }\\\\n\\\\n  valueChartInstance = echarts.init(valueDistributionChart.value)\\\\n\\\\n  const option = {\\\\n    tooltip: {\\\\n      trigger: \\\\'axis\\\\',\\\\n      axisPointer: {\\\\n        type: \\\\'shadow\\\\'\\\\n      }\\\\n    },\\\\n    grid: {\\\\n      left: \\\\'3%\\\\',\\\\n      right: \\\\'4%\\\\',\\\\n      bottom: \\\\'3%\\\\',\\\\n      containLabel: true\\\\n    },\\\\n    xAxis: [\\\\n      {\\\\n        type: \\\\'category\\\\',\\\\n        data: [\\\\'超级VIP\\\\', \\\\'VIP\\\\', \\\\'会员\\\\', \\\\'普通\\\\', \\\\'低价值\\\\'],\\\\n        axisTick: {\\\\n          alignWithLabel: true\\\\n        }\\\\n      }\\\\n    ],\\\\n    yAxis: [\\\\n      {\\\\n        type: \\\\'value\\\\'\\\\n      }\\\\n    ],\\\\n    series: [\\\\n      {\\\\n        name: \\\\'客户数量\\\\',\\\\n        type: \\\\'bar\\\\',\\\\n        barWidth: \\\\'60%\\\\',\\\\n        data: [\\\\n          { value: 629, itemStyle: { color: \\\\'#F56C6C\\\\' } },\\\\n          { value: 1887, itemStyle: { color: \\\\'#E6A23C\\\\' } },\\\\n          { value: 3774, itemStyle: { color: \\\\'#409EFF\\\\' } },\\\\n          { value: 5032, itemStyle: { color: \\\\'#67C23A\\\\' } },\\\\n          { value: 1258, itemStyle: { color: \\\\'#909399\\\\' } }\\\\n        ]\\\\n      }\\\\n    ]\\\\n  }\\\\n\\\\n  valueChartInstance.setOption(option)\\\\n}\\\\n\\\\nconst initFlowTrendChart = () => {\\\\n  if (!flowTrendChart.value) return\\\\n\\\\n  if (flowChartInstance) {\\\\n    flowChartInstance.dispose()\\\\n  }\\\\n\\\\n  flowChartInstance = echarts.init(flowTrendChart.value)\\\\n\\\\n  const option = {\\\\n    tooltip: {\\\\n      trigger: \\\\'axis\\\\'\\\\n    },\\\\n    legend: {\\\\n      data: [\\\\'流入\\\\', \\\\'流出\\\\']\\\\n    },\\\\n    grid: {\\\\n      left: \\\\'3%\\\\',\\\\n      right: \\\\'4%\\\\',\\\\n      bottom: \\\\'3%\\\\',\\\\n      containLabel: true\\\\n    },\\\\n    xAxis: {\\\\n      type: \\\\'category\\\\',\\\\n      boundaryGap: false,\\\\n      data: [\\\\'1月\\\\', \\\\'2月\\\\', \\\\'3月\\\\', \\\\'4月\\\\', \\\\'5月\\\\', \\\\'6月\\\\']\\\\n    },\\\\n    yAxis: {\\\\n      type: \\\\'value\\\\'\\\\n    },\\\\n    series: [\\\\n      {\\\\n        name: \\\\'流入\\\\',\\\\n        type: \\\\'line\\\\',\\\\n        stack: \\\\'Total\\\\',\\\\n        areaStyle: {\\\\n          color: \\\\'#67C23A\\\\'\\\\n        },\\\\n        lineStyle: {\\\\n          width: 1\\\\n        },\\\\n        showSymbol: false,\\\\n        data: [820, 932, 901, 934, 1290, 1330]\\\\n      },\\\\n      {\\\\n        name: \\\\'流出\\\\',\\\\n        type: \\\\'line\\\\',\\\\n        stack: \\\\'Total\\\\',\\\\n        areaStyle: {\\\\n          color: \\\\'#F56C6C\\\\'\\\\n        },\\\\n        lineStyle: {\\\\n          width: 1\\\\n        },\\\\n        showSymbol: false,\\\\n        data: [120, 132, 101, 134, 90, 230]\\\\n      }\\\\n    ]\\\\n  }\\\\n\\\\n  flowChartInstance.setOption(option)\\\\n}\\\\n\\\\nconst initRetentionRateChart = () => {\\\\n  if (!retentionRateChart.value) return\\\\n\\\\n  if (retentionChartInstance) {\\\\n    retentionChartInstance.dispose()\\\\n  }\\\\n\\\\n  retentionChartInstance = echarts.init(retentionRateChart.value)\\\\n\\\\n  const option = {\\\\n    tooltip: {\\\\n      trigger: \\\\'axis\\\\',\\\\n      formatter: \\\\'{b}: {c}%\\\\'\\\\n    },\\\\n    grid: {\\\\n      left: \\\\'3%\\\\',\\\\n      right: \\\\'4%\\\\',\\\\n      bottom: \\\\'3%\\\\',\\\\n      containLabel: true\\\\n    },\\\\n    xAxis: {\\\\n      type: \\\\'category\\\\',\\\\n      boundaryGap: false,\\\\n      data: [\\\\'1月\\\\', \\\\'2月\\\\', \\\\'3月\\\\', \\\\'4月\\\\', \\\\'5月\\\\', \\\\'6月\\\\']\\\\n    },\\\\n    yAxis: {\\\\n      type: \\\\'value\\\\',\\\\n      axisLabel: {\\\\n        formatter: \\\\'{value}%\\\\'\\\\n      }\\\\n    },\\\\n    series: [\\\\n      {\\\\n        name: \\\\'留存率\\\\',\\\\n        type: \\\\'line\\\\',\\\\n        data: [95.2, 96.1, 95.8, 96.5, 97.2, 96.6],\\\\n        smooth: true,\\\\n        lineStyle: {\\\\n          width: 3,\\\\n          color: \\\\'#409EFF\\\\'\\\\n        },\\\\n        areaStyle: {\\\\n          color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [\\\\n            { offset: 0, color: \\\\'rgba(64, 158, 255, 0.3)\\\\' },\\\\n            { offset: 1, color: \\\\'rgba(64, 158, 255, 0.05)\\\\' }\\\\n          ])\\\\n        }\\\\n      }\\\\n    ]\\\\n  }\\\\n\\\\n  retentionChartInstance.setOption(option)\\\\n}\\\\n\\\\nconst initCLVDistributionChart = () => {\\\\n  if (!clvDistributionChart.value) return\\\\n\\\\n  if (clvChartInstance) {\\\\n    clvChartInstance.dispose()\\\\n  }\\\\n\\\\n  clvChartInstance = echarts.init(clvDistributionChart.value)\\\\n\\\\n  const option = {\\\\n    tooltip: {\\\\n      trigger: \\\\'item\\\\',\\\\n      formatter: \\\\'{b}: ¥{c}\\\\'\\\\n    },\\\\n    grid: {\\\\n      left: \\\\'3%\\\\',\\\\n      right: \\\\'4%\\\\',\\\\n      bottom: \\\\'3%\\\\',\\\\n      containLabel: true\\\\n    },\\\\n    xAxis: {\\\\n      type: \\\\'category\\\\',\\\\n      data: [\\\\'<1000\\\\', \\\\'1000-2000\\\\', \\\\'2000-3000\\\\', \\\\'3000-4000\\\\', \\\\'4000-5000\\\\', \\\\'>5000\\\\'],\\\\n      axisTick: {\\\\n        alignWithLabel: true\\\\n      }\\\\n    },\\\\n    yAxis: {\\\\n      type: \\\\'value\\\\',\\\\n      axisLabel: {\\\\n        formatter: \\\\'¥{value}\\\\'\\\\n      }\\\\n    },\\\\n    series: [\\\\n      {\\\\n        name: \\\\'客户数量\\\\',\\\\n        type: \\\\'bar\\\\',\\\\n        barWidth: \\\\'60%\\\\',\\\\n        data: [\\\\n          { value: 2516, itemStyle: { color: \\\\'#909399\\\\' } },\\\\n          { value: 3774, itemStyle: { color: \\\\'#67C23A\\\\' } },\\\\n          { value: 3145, itemStyle: { color: \\\\'#409EFF\\\\' } },\\\\n          { value: 1887, itemStyle: { color: \\\\'#E6A23C\\\\' } },\\\\n          { value: 942, itemStyle: { color: \\\\'#F56C6C\\\\' } },\\\\n          { value: 316, itemStyle: { color: \\\\'#E6A23C\\\\' } }\\\\n        ]\\\\n      }\\\\n    ]\\\\n  }\\\\n\\\\n  clvChartInstance.setOption(option)\\\\n}\\\\n\\\\nconst filterAlerts = () => {\\\\n}\\\\n\\\\nconst filterCareReminders = () => {\\\\n}\\\\n\\\\nconst assignAlert = (alert: any) => {\\\\n  assignForm.value = {\\\\n    customerId: alert.customerId,\\\\n    customerName: alert.customerName,\\\\n    assignedTo: \\\\'\\\\',\\\\n    notes: \\\\'\\\\'\\\\n  }\\\\n  showAssignDialog.value = true\\\\n}\\\\n\\\\nconst confirmAssign = () => {\\\\n  if (!assignForm.value.assignedTo) {\\\\n    ElMessage.warning(\\\\'请选择处理人员\\\\')\\\\n    return\\\\n  }\\\\n\\\\n  assignAlert(assignForm.value.customerId, assignForm.value.assignedTo)\\\\n  showAssignDialog.value = false\\\\n  ElMessage.success(\\\\'分配成功\\\\')\\\\n}\\\\n\\\\nconst resolveAlert = (alert: any) => {\\\\n  resolveForm.value = {\\\\n    customerId: alert.customerId,\\\\n    customerName: alert.customerName,\\\\n    resolutionNotes: \\\\'\\\\'\\\\n  }\\\\n  showResolveDialog.value = true\\\\n}\\\\n\\\\nconst confirmResolve = () => {\\\\n  if (!resolveForm.value.resolutionNotes) {\\\\n    ElMessage.warning(\\\\'请输入解决说明\\\\')\\\\n    return\\\\n  }\\\\n\\\\n  resolveAlert(resolveForm.value.customerId, resolveForm.value.resolutionNotes)\\\\n  showResolveDialog.value = false\\\\n  ElMessage.success(\\\\'标记成功\\\\')\\\\n}\\\\n\\\\nconst sendCareReminder = async (reminder: any) => {\\\\n  try {\\\\n    await sendReminder(reminder)\\\\n  } catch (error) {\\\\n    console.error(\\\\'Send care reminder failed:\\\\', error)\\\\n  }\\\\n}\\\\n\\\\nconst viewCustomerDetail = (alert: any) => {\\\\n  ElMessage.info(\\\\'查看客户详情功能开发中\\\\')\\\\n}\\\\n\\\\nconst viewReminderDetail = (reminder: any) => {\\\\n  ElMessage.info(\\\\'查看提醒详情功能开发中\\\\')\\\\n}\\\\n\\\\nconst exportDashboard = () => {\\\\n  ElMessage.info(\\\\'导出报告功能开发中\\\\')\\\\n}\\\\n\\\\nconst getTrendColor = (trendType: string): string => {\\\\n  return trendType === \\\\'up\\\\' ? \\\\'#67C23A\\\\' : \\\\'#F56C6C\\\\'\\\\n}\\\\n\\\\nconst getTrendIcon = (trendType: string): any => {\\\\n  return trendType === \\\\'up\\\\' ? ArrowUp : ArrowDown\\\\n}\\\\n\\\\nconst getChurnProbabilityType = (probability: number): string => {\\\\n  if (probability >= 0.7) return \\\\'danger\\\\'\\\\n  if (probability >= 0.4) return \\\\'warning\\\\'\\\\n  return \\\\'info\\\\'\\\\n}\\\\n\\\\nconst getRiskLevelType = (riskLevel: string): string => {\\\\n  if (riskLevel === \\\\'high\\\\') return \\\\'danger\\\\'\\\\n  if (riskLevel === \\\\'medium\\\\') return \\\\'warning\\\\'\\\\n  return \\\\'info\\\\'\\\\n}\\\\n\\\\nconst getStatusType = (status: string): string => {\\\\n  if (status === \\\\'pending\\\\') return \\\\'warning\\\\'\\\\n  if (status === \\\\'in_progress\\\\') return \\\\'primary\\\\'\\\\n  if (status === \\\\'resolved\\\\') return \\\\'success\\\\'\\\\n  return \\\\'info\\\\'\\\\n}\\\\n\\\\nconst getCareStatusType = (status: string): string => {\\\\n  if (status === \\\\'pending\\\\') return \\\\'warning\\\\'\\\\n  if (status === \\\\'sent\\\\') return \\\\'success\\\\'\\\\n  return \\\\'info\\\\'\\\\n}\\\\n\\\\nconst getCareStatusLabel = (status: string): string => {\\\\n  const labels: Record<string, string> = {\\\\n    pending: \\\\'待发送\\\\',\\\\n    sent: \\\\'已发送\\\\',\\\\n    failed: \\\\'发送失败\\\\'\\\\n  }\\\\n  return labels[status] || \\\\'未知\\\\'\\\\n}\\\\n\\\\nconst formatDate = (date: Date): string => {\\\\n  return new Date(date).toLocaleDateString(\\\\'zh-CN\\\\')\\\\n}\\\\n\\\\nconst formatDateTime = (date: Date): string => {\\\\n  return new Date(date).toLocaleString(\\\\'zh-CN\\\\')\\\\n}\\\\n\\\\nonMounted(() => {\\\\n  loadDashboardData()\\\\n})\\\\n\\\\nonBeforeUnmount(() => {\\\\n  if (stageChartInstance) stageChartInstance.dispose()\\\\n  if (valueChartInstance) valueChartInstance.dispose()\\\\n  if (flowChartInstance) flowChartInstance.dispose()\\\\n  if (retentionChartInstance) retentionChartInstance.dispose()\\\\n  if (clvChartInstance) clvChartInstance.dispose()\\\\n})\\\\n</script>\\\\n\\\\n<style scoped>\\\\n.customer-lifecycle-dashboard {\\\\n  padding: 20px;\\\\n  background: #f5f7fa;\\\\n  min-height: 100vh;\\\\n}\\\\n\\\\n.dashboard-header {\\\\n  display: flex;\\\\n  justify-content: space-between;\\\\n  align-items: center;\\\\n  margin-bottom: 20px;\\\\n  padding: 20px;\\\\n  background: white;\\\\n  border-radius: 8px;\\\\n  box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.1);\\\\n}\\\\n\\\\n.dashboard-header h1 {\\\\n  margin: 0;\\\\n  font-size: 24px;\\\\n  font-weight: bold;\\\\n  color: #303133;\\\\n}\\\\n\\\\n.header-actions {\\\\n  display: flex;\\\\n  gap: 10px;\\\\n}\\\\n\\\\n.metrics-row,\\\\n.charts-row,\\\\n.alerts-row,\\\\n.care-reminders-row {\\\\n  margin-bottom: 20px;\\\\n}\\\\n\\\\n.metric-card {\\\\n  cursor: pointer;\\\\n  transition: all 0.3s;\\\\n}\\\\n\\\\n.metric-card:hover {\\\\n  transform: translateY(-5px);\\\\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);\\\\n}\\\\n\\\\n.metric-content {\\\\n  display: flex;\\\\n  align-items: center;\\\\n  gap: 15px;\\\\n}\\\\n\\\\n.metric-icon {\\\\n  width: 60px;\\\\n  height: 60px;\\\\n  border-radius: 12px;\\\\n  display: flex;\\\\n  align-items: center;\\\\n  justify-content: center;\\\\n  color: white;\\\\n}\\\\n\\\\n.metric-info {\\\\n  flex: 1;\\\\n}\\\\n\\\\n.metric-value {\\\\n  font-size: 28px;\\\\n  font-weight: bold;\\\\n  color: #303133;\\\\n  margin-bottom: 5px;\\\\n}\\\\n\\\\n.metric-label {\\\\n  font-size: 14px;\\\\n  color: #909399;\\\\n  margin-bottom: 5px;\\\\n}\\\\n\\\\n.metric-trend {\\\\n  display: flex;\\\\n  align-items: center;\\\\n  gap: 5px;\\\\n  font-size: 12px;\\\\n}\\\\n\\\\n.chart-card {\\\\n  height: 400px;\\\\n}\\\\n\\\\n.card-header {\\\\n  display: flex;\\\\n  justify-content: space-between;\\\\n  align-items: center;\\\\n}\\\\n\\\\n.chart-container {\\\\n  width: 100%;\\\\n  height: 320px;\\\\n}\\\\n\\\\n.alerts-card,\\\\n.care-reminders-card {\\\\n  min-height: 500px;\\\\n}\\\\n\\\\n.header-actions {\\\\n  display: flex;\\\\n  gap: 10px;\\\\n}\\\\n</style>\\\\n\",\"originAcceptText\":\"<template>\\n  <div class=\\\"customer-lifecycle-dashboard\\\">\\n    <div class=\\\"dashboard-header\\\">\\n      <h1>客户生命周期管理看板</h1>\\n      <div class=\\\"header-actions\\\">\\n        <el-date-picker\\n          v-model=\\\"dateRange\\\"\\n          type=\\\"daterange\\\"\\n          range-separator=\\\"至\\\"\\n          start-placeholder=\\\"开始日期\\\"\\n          end-placeholder=\\\"结束日期\\\"\\n          @change=\\\"loadDashboardData\\\"\\n        />\\n        <el-button type=\\\"primary\\\" @click=\\\"loadDashboardData\\\" :loading=\\\"loading\\\">\\n          <el-icon><Refresh /></el-icon>\\n          刷新数据\\n        </el-button>\\n        <el-button @click=\\\"exportDashboard\\\">\\n          <el-icon><Download /></el-icon>\\n          导出报告\\n        </el-button>\\n      </div>\\n    </div>\\n\\n    <el-row :gutter=\\\"20\\\" class=\\\"metrics-row\\\">\\n      <el-col :span=\\\"4\\\" v-for=\\\"metric in overviewMetrics\\\" :key=\\\"metric.key\\\">\\n        <el-card class=\\\"metric-card\\\" :class=\\\"metric.type\\\">\\n          <div class=\\\"metric-content\\\">\\n            <div class=\\\"metric-icon\\\" :style=\\\"{ backgroundColor: metric.color }\\\">\\n              <el-icon :size=\\\"32\\\">\\n                <component :is=\\\"metric.icon\\\" />\\n              </el-icon>\\n            </div>\\n            <div class=\\\"metric-info\\\">\\n              <div class=\\\"metric-value\\\">{{ metric.value }}</div>\\n              <div class=\\\"metric-label\\\">{{ metric.label }}</div>\\n              <div class=\\\"metric-trend\\\" v-if=\\\"metric.trend !== undefined\\\">\\n                <el-icon :size=\\\"14\\\" :color=\\\"getTrendColor(metric.trendType)\\\">\\n                  <component :is=\\\"getTrendIcon(metric.trendType)\\\" />\\n                </el-icon>\\n                <span>{{ metric.trend }}%</span>\\n              </div>\\n            </div>\\n          </div>\\n        </el-card>\\n      </el-col>\\n    </el-row>\\n\\n    <el-row :gutter=\\\"20\\\" class=\\\"charts-row\\\">\\n      <el-col :span=\\\"12\\\">\\n        <el-card class=\\\"chart-card\\\">\\n          <template #header>\\n            <div class=\\\"card-header\\\">\\n              <span>生命周期阶段分布</span>\\n              <el-radio-group v-model=\\\"stageViewType\\\" size=\\\"small\\\">\\n                <el-radio-button label=\\\"pie\\\">饼图</el-radio-button>\\n                <el-radio-button label=\\\"bar\\\">柱状图</el-radio-button>\\n              </el-radio-group>\\n            </div>\\n          </template>\\n          <div ref=\\\"stageDistributionChart\\\" class=\\\"chart-container\\\"></div>\\n        </el-card>\\n      </el-col>\\n\\n      <el-col :span=\\\"12\\\">\\n        <el-card class=\\\"chart-card\\\">\\n          <template #header>\\n            <div class=\\\"card-header\\\">\\n              <span>客户价值分布（RFM）</span>\\n            </div>\\n          </template>\\n          <div ref=\\\"valueDistributionChart\\\" class=\\\"chart-container\\\"></div>\\n        </el-card>\\n      </el-col>\\n    </el-row>\\n\\n    <el-row :gutter=\\\"20\\\" class=\\\"charts-row\\\">\\n      <el-col :span=\\\"12\\\">\\n        <el-card class=\\\"chart-card\\\">\\n          <template #header>\\n            <div class=\\\"card-header\\\">\\n              <span>生命周期流转趋势</span>\\n            </div>\\n          </template>\\n          <div ref=\\\"flowTrendChart\\\" class=\\\"chart-container\\\"></div>\\n        </el-card>\\n      </el-col>\\n\\n      <el-col :span=\\\"12\\\">\\n        <el-card class=\\\"chart-card\\\">\\n          <template #header>\\n            <div class=\\\"card-header\\\">\\n              <span>客户留存率趋势</span>\\n            </div>\\n          </template>\\n          <div ref=\\\"retentionRateChart\\\" class=\\\"chart-container\\\"></div>\\n        </el-card>\\n      </el-col>\\n    </el-row>\\n\\n    <el-row :gutter=\\\"20\\\" class=\\\"charts-row\\\">\\n      <el-col :span=\\\"24\\\">\\n        <el-card class=\\\"chart-card\\\">\\n          <template #header>\\n            <div class=\\\"card-header\\\">\\n              <span>客户生命周期价值（CLV）分布</span>\\n            </div>\\n          </template>\\n          <div ref=\\\"clvDistributionChart\\\" class=\\\"chart-container\\\"></div>\\n        </el-card>\\n      </el-col>\\n    </el-row>\\n\\n    <el-row :gutter=\\\"20\\\" class=\\\"alerts-row\\\">\\n      <el-col :span=\\\"24\\\">\\n        <el-card class=\\\"alerts-card\\\">\\n          <template #header>\\n            <div class=\\\"card-header\\\">\\n              <span>流失预警</span>\\n              <div class=\\\"header-actions\\\">\\n                <el-radio-group v-model=\\\"alertRiskLevel\\\" size=\\\"small\\\" @change=\\\"filterAlerts\\\">\\n                  <el-radio-button label=\\\"all\\\">全部</el-radio-button>\\n                  <el-radio-button label=\\\"high\\\">高危</el-radio-button>\\n                  <el-radio-button label=\\\"medium\\\">中危</el-radio-button>\\n                  <el-radio-button label=\\\"low\\\">低危</el-radio-button>\\n                </el-radio-group>\\n              </div>\\n            </div>\\n          </template>\\n          <el-table :data=\\\"filteredAlerts\\\" style=\\\"width: 100%\\\">\\n            <el-table-column prop=\\\"customerName\\\" label=\\\"客户名称\\\" width=\\\"120\\\" />\\n            <el-table-column prop=\\\"churnProbability\\\" label=\\\"流失概率\\\" width=\\\"100\\\">\\n              <template #default=\\\"{ row }\\\">\\n                <el-tag :type=\\\"getChurnProbabilityType(row.churnProbability)\\\">\\n                  {{ (row.churnProbability * 100).toFixed(0) }}%\\n                </el-tag>\\n              </template>\\n            </el-table-column>\\n            <el-table-column prop=\\\"riskLevel\\\" label=\\\"风险等级\\\" width=\\\"80\\\">\\n              <template #default=\\\"{ row }\\\">\\n                <el-tag :type=\\\"getRiskLevelType(row.riskLevel)\\\">\\n                  {{ getRiskLevelLabel(row.riskLevel) }}\\n                </el-tag>\\n              </template>\\n            </el-table-column>\\n            <el-table-column prop=\\\"riskFactors\\\" label=\\\"风险因素\\\" width=\\\"200\\\">\\n              <template #default=\\\"{ row }\\\">\\n                <el-tag\\n                  v-for=\\\"factor in row.riskFactors\\\"\\n                  :key=\\\"factor\\\"\\n                  size=\\\"small\\\"\\n                  style=\\\"margin-right: 5px;\\\"\\n                >\\n                  {{ factor }}\\n                </el-tag>\\n              </template>\\n            </el-table-column>\\n            <el-table-column prop=\\\"predictedChurnDate\\\" label=\\\"预计流失日期\\\" width=\\\"120\\\">\\n              <template #default=\\\"{ row }\\\">\\n                {{ formatDate(row.predictedChurnDate) }}\\n              </template>\\n            </el-table-column>\\n            <el-table-column prop=\\\"status\\\" label=\\\"状态\\\" width=\\\"100\\\">\\n              <template #default=\\\"{ row }\\\">\\n                <el-tag :type=\\\"getStatusType(row.status)\\\">\\n                  {{ getStatusLabel(row.status) }}\\n                </el-tag>\\n              </template>\\n            </el-table-column>\\n            <el-table-column label=\\\"操作\\\" width=\\\"200\\\">\\n              <template #default=\\\"{ row }\\\">\\n                <el-button\\n                  v-if=\\\"row.status === 'pending'\\\"\\n                  type=\\\"primary\\\"\\n                  size=\\\"small\\\"\\n                  @click=\\\"assignAlert(row)\\\"\\n                >\\n                  分配处理\\n                </el-button>\\n                <el-button\\n                  v-if=\\\"row.status === 'in_progress'\\\"\\n                  type=\\\"success\\\"\\n                  size=\\\"small\\\"\\n                  @click=\\\"resolveAlert(row)\\\"\\n                >\\n                  标记解决\\n                </el-button>\\n                <el-button\\n                  size=\\\"small\\\"\\n                  @click=\\\"viewCustomerDetail(row)\\\"\\n                >\\n                  查看详情\\n                </el-button>\\n              </template>\\n            </el-table-column>\\n          </el-table>\\n        </el-card>\\n      </el-col>\\n    </el-row>\\n\\n    <el-row :gutter=\\\"20\\\" class=\\\"care-reminders-row\\\">\\n      <el-col :span=\\\"24\\\">\\n        <el-card class=\\\"care-reminders-card\\\">\\n          <template #header>\\n            <div class=\\\"card-header\\\">\\n              <span>关怀提醒</span>\\n              <div class=\\\"header-actions\\\">\\n                <el-radio-group v-model=\\\"careReminderStatus\\\" size=\\\"small\\\" @change=\\\"filterCareReminders\\\">\\n                  <el-radio-button label=\\\"pending\\\">待处理</el-radio-button>\\n                  <el-radio-button label=\\\"sent\\\">已发送</el-radio-button>\\n                  <el-radio-button label=\\\"all\\\">全部</el-radio-button>\\n                </el-radio-group>\\n              </div>\\n            </div>\\n          </template>\\n          <el-table :data=\\\"filteredCareReminders\\\" style=\\\"width: 100%\\\">\\n            <el-table-column prop=\\\"customerName\\\" label=\\\"客户名称\\\" width=\\\"120\\\" />\\n            <el-table-column prop=\\\"careType\\\" label=\\\"关怀类型\\\" width=\\\"120\\\">\\n              <template #default=\\\"{ row }\\\">\\n                <el-tag size=\\\"small\\\">\\n                  {{ getCareTypeLabel(row.careType) }}\\n                </el-tag>\\n              </template>\\n            </el-table-column>\\n            <el-table-column prop=\\\"content\\\" label=\\\"关怀内容\\\" min-width=\\\"200\\\" show-overflow-tooltip />\\n            <el-table-column prop=\\\"channels\\\" label=\\\"发送渠道\\\" width=\\\"150\\\">\\n              <template #default=\\\"{ row }\\\">\\n                <el-tag\\n                  v-for=\\\"channel in row.channels\\\"\\n                  :key=\\\"channel\\\"\\n                  size=\\\"small\\\"\\n                  style=\\\"margin-right: 5px;\\\"\\n                >\\n                  {{ getChannelLabel(channel) }}\\n                </el-tag>\\n              </template>\\n            </el-table-column>\\n            <el-table-column prop=\\\"scheduledAt\\\" label=\\\"计划发送时间\\\" width=\\\"150\\\">\\n              <template #default=\\\"{ row }\\\">\\n                {{ formatDateTime(row.scheduledAt) }}\\n              </template>\\n            </el-table-column>\\n            <el-table-column prop=\\\"status\\\" label=\\\"状态\\\" width=\\\"100\\\">\\n              <template #default=\\\"{ row }\\\">\\n                <el-tag :type=\\\"getCareStatusType(row.status)\\\">\\n                  {{ getCareStatusLabel(row.status) }}\\n                </el-tag>\\n              </template>\\n            </el-table-column>\\n            <el-table-column label=\\\"操作\\\" width=\\\"150\\\">\\n              <template #default=\\\"{ row }\\\">\\n                <el-button\\n                  v-if=\\\"row.status === 'pending'\\\"\\n                  type=\\\"primary\\\"\\n                  size=\\\"small\\\"\\n                  @click=\\\"sendCareReminder(row)\\\"\\n                >\\n                  发送\\n                </el-button>\\n                <el-button\\n                  size=\\\"small\\\"\\n                  @click=\\\"viewReminderDetail(row)\\\"\\n                >\\n                  查看\\n                </el-button>\\n              </template>\\n            </el-table-column>\\n          </el-table>\\n        </el-card>\\n      </el-col>\\n    </el-row>\\n\\n    <el-dialog v-model=\\\"showAssignDialog\\\" title=\\\"分配流失预警\\\" width=\\\"500px\\\">\\n      <el-form :model=\\\"assignForm\\\" label-width=\\\"100px\\\">\\n        <el-form-item label=\\\"客户名称\\\">\\n          <el-input v-model=\\\"assignForm.customerName\\\" disabled />\\n        </el-form-item>\\n        <el-form-item label=\\\"处理人员\\\">\\n          <el-select v-model=\\\"assignForm.assignedTo\\\" placeholder=\\\"请选择处理人员\\\">\\n            <el-option\\n              v-for=\\\"user in staffList\\\"\\n              :key=\\\"user.id\\\"\\n              :label=\\\"user.name\\\"\\n              :value=\\\"user.id\\\"\\n            />\\n          </el-select>\\n        </el-form-item>\\n        <el-form-item label=\\\"备注\\\">\\n          <el-input\\n            v-model=\\\"assignForm.notes\\\"\\n            type=\\\"textarea\\\"\\n            :rows=\\\"3\\\"\\n            placeholder=\\\"请输入备注信息\\\"\\n          />\\n        </el-form-item>\\n      </el-form>\\n      <template #footer>\\n        <el-button @click=\\\"showAssignDialog = false\\\">取消</el-button>\\n        <el-button type=\\\"primary\\\" @click=\\\"confirmAssign\\\">确认分配</el-button>\\n      </template>\\n    </el-dialog>\\n\\n    <el-dialog v-model=\\\"showResolveDialog\\\" title=\\\"标记预警已解决\\\" width=\\\"500px\\\">\\n      <el-form :model=\\\"resolveForm\\\" label-width=\\\"100px\\\">\\n        <el-form-item label=\\\"客户名称\\\">\\n          <el-input v-model=\\\"resolveForm.customerName\\\" disabled />\\n        </el-form-item>\\n        <el-form-item label=\\\"解决说明\\\">\\n          <el-input\\n            v-model=\\\"resolveForm.resolutionNotes\\\"\\n            type=\\\"textarea\\\"\\n            :rows=\\\"4\\\"\\n            placeholder=\\\"请输入解决说明\\\"\\n          />\\n        </el-form-item>\\n      </el-form>\\n      <template #footer>\\n        <el-button @click=\\\"showResolveDialog = false\\\">取消</el-button>\\n        <el-button type=\\\"primary\\\" @click=\\\"confirmResolve\\\">确认解决</el-button>\\n      </template>\\n    </el-dialog>\\n  </div>\\n</template>\\n\\n<script setup lang=\\\"ts\\\">\\nimport { ref, computed, onMounted, onBeforeUnmount, nextTick } from 'vue'\\nimport { ElMessage } from 'element-plus'\\nimport * as echarts from 'echarts'\\nimport {\\n  Refresh,\\n  Download,\\n  User,\\n  TrendCharts,\\n  Warning,\\n  ArrowUp,\\n  ArrowDown\\n} from '@element-plus/icons-vue'\\nimport { useLifecycleRuleEngine } from '@/composables/useLifecycleRuleEngine'\\nimport { useRFMModel } from '@/composables/useRFMModel'\\nimport { useCareReminder } from '@/composables/useCareReminder'\\nimport { useChurnPrediction } from '@/composables/useChurnPrediction'\\n\\nconst { loadRules } = useLifecycleRuleEngine()\\nconst { batchAnalyze, getScoreColor } = useRFMModel()\\nconst {\\n  pendingReminders,\\n  sentReminders,\\n  loadPendingReminders,\\n  loadSentReminders,\\n  sendReminder,\\n  getCareTypeLabel,\\n  getChannelLabel\\n} = useCareReminder()\\nconst {\\n  churnPredictions,\\n  batchPredictChurn,\\n  assignAlert,\\n  resolveAlert,\\n  getRiskLevelLabel,\\n  getRiskLevelColor,\\n  getStatusLabel,\\n  getStatusColor,\\n  getUrgency\\n} = useChurnPrediction()\\n\\nconst loading = ref(false)\\nconst dateRange = ref<[Date, Date] | null>(null)\\nconst stageViewType = ref('pie')\\nconst alertRiskLevel = ref('all')\\nconst careReminderStatus = ref('pending')\\nconst showAssignDialog = ref(false)\\nconst showResolveDialog = ref(false)\\n\\nconst stageDistributionChart = ref<HTMLElement | null>(null)\\nconst valueDistributionChart = ref<HTMLElement | null>(null)\\nconst flowTrendChart = ref<HTMLElement | null>(null)\\nconst retentionRateChart = ref<HTMLElement | null>(null)\\nconst clvDistributionChart = ref<HTMLElement | null>(null)\\n\\nlet stageChartInstance: echarts.ECharts | null = null\\nlet valueChartInstance: echarts.ECharts | null = null\\nlet flowChartInstance: echarts.ECharts | null = null\\nlet retentionChartInstance: echarts.ECharts | null = null\\nlet clvChartInstance: echarts.ECharts | null = null\\n\\nconst overviewMetrics = computed(() => [\\n  {\\n    key: 'total',\\n    label: '总客户数',\\n    value: '12,580',\\n    icon: User,\\n    type: 'primary',\\n    color: '#409EFF',\\n    trend: 8.5,\\n    trendType: 'up'\\n  },\\n  {\\n    key: 'active',\\n    label: '活跃客户',\\n    value: '8,245',\\n    icon: TrendCharts,\\n    type: 'success',\\n    color: '#67C23A',\\n    trend: 12.3,\\n    trendType: 'up'\\n  },\\n  {\\n    key: 'churned',\\n    label: '流失客户',\\n    value: '425',\\n    icon: Warning,\\n    type: 'danger',\\n    color: '#F56C6C',\\n    trend: -5.2,\\n    trendType: 'down'\\n  },\\n  {\\n    key: 'retention',\\n    label: '客户留存率',\\n    value: '96.6%',\\n    icon: TrendCharts,\\n    type: 'warning',\\n    color: '#E6A23C',\\n    trend: 2.1,\\n    trendType: 'up'\\n  },\\n  {\\n    key: 'clv',\\n    label: '平均CLV',\\n    value: '¥2,580',\\n    icon: TrendCharts,\\n    type: 'info',\\n    color: '#909399',\\n    trend: 15.8,\\n    trendType: 'up'\\n  },\\n  {\\n    key: 'satisfaction',\\n    label: '客户满意度',\\n    value: '4.3',\\n    icon: TrendCharts,\\n    type: 'success',\\n    color: '#67C23A',\\n    trend: 3.5,\\n    trendType: 'up'\\n  }\\n])\\n\\nconst filteredAlerts = computed(() => {\\n  let alerts = churnPredictions.value\\n  if (alertRiskLevel.value !== 'all') {\\n    alerts = alerts.filter(a => a.riskLevel === alertRiskLevel.value)\\n  }\\n  return alerts\\n})\\n\\nconst filteredCareReminders = computed(() => {\\n  if (careReminderStatus.value === 'pending') {\\n    return pendingReminders.value\\n  } else if (careReminderStatus.value === 'sent') {\\n    return sentReminders.value\\n  }\\n  return [...pendingReminders.value, ...sentReminders.value]\\n})\\n\\nconst assignForm = ref({\\n  customerId: '',\\n  customerName: '',\\n  assignedTo: '',\\n  notes: ''\\n})\\n\\nconst resolveForm = ref({\\n  customerId: '',\\n  customerName: '',\\n  resolutionNotes: ''\\n})\\n\\nconst staffList = ref([\\n  { id: '1', name: '张三' },\\n  { id: '2', name: '李四' },\\n  { id: '3', name: '王五' }\\n])\\n\\nconst loadDashboardData = async () => {\\n  loading.value = true\\n  try {\\n    await Promise.all([\\n      loadPendingReminders(),\\n      loadSentReminders()\\n    ])\\n\\n    await nextTick()\\n    initCharts()\\n  } catch (error) {\\n    console.error('Load dashboard data failed:', error)\\n    ElMessage.error('加载看板数据失败')\\n  } finally {\\n    loading.value = false\\n  }\\n}\\n\\nconst initCharts = () => {\\n  initStageDistributionChart()\\n  initValueDistributionChart()\\n  initFlowTrendChart()\\n  initRetentionRateChart()\\n  initCLVDistributionChart()\\n}\\n\\nconst initStageDistributionChart = () => {\\n  if (!stageDistributionChart.value) return\\n\\n  if (stageChartInstance) {\\n    stageChartInstance.dispose()\\n  }\\n\\n  stageChartInstance = echarts.init(stageDistributionChart.value)\\n\\n  const option = {\\n    tooltip: {\\n      trigger: 'item',\\n      formatter: '{b}: {c} ({d}%)'\\n    },\\n    legend: {\\n      orient: 'vertical',\\n      left: 'left'\\n    },\\n    series: [\\n      {\\n        name: '生命周期阶段',\\n        type: 'pie',\\n        radius: ['40%', '70%'],\\n        avoidLabelOverlap: false,\\n        itemStyle: {\\n          borderRadius: 10,\\n          borderColor: '#fff',\\n          borderWidth: 2\\n        },\\n        label: {\\n          show: false,\\n          position: 'center'\\n        },\\n        emphasis: {\\n          label: {\\n            show: true,\\n            fontSize: 20,\\n            fontWeight: 'bold'\\n          }\\n        },\\n        labelLine: {\\n          show: false\\n        },\\n        data: [\\n          { value: 2500, name: '潜在客户', itemStyle: { color: '#909399' } },\\n          { value: 1887, name: '新客户', itemStyle: { color: '#409EFF' } },\\n          { value: 5032, name: '活跃客户', itemStyle: { color: '#67C23A' } },\\n          { value: 1887, name: '忠诚客户', itemStyle: { color: '#E6A23C' } },\\n          { value: 1005, name: '休眠客户', itemStyle: { color: '#F56C6C' } },\\n          { value: 269, name: '流失客户', itemStyle: { color: '#909399' } }\\n        ]\\n      }\\n    ]\\n  }\\n\\n  stageChartInstance.setOption(option)\\n}\\n\\nconst initValueDistributionChart = () => {\\n  if (!valueDistributionChart.value) return\\n\\n  if (valueChartInstance) {\\n    valueChartInstance.dispose()\\n  }\\n\\n  valueChartInstance = echarts.init(valueDistributionChart.value)\\n\\n  const option = {\\n    tooltip: {\\n      trigger: 'axis',\\n      axisPointer: {\\n        type: 'shadow'\\n      }\\n    },\\n    grid: {\\n      left: '3%',\\n      right: '4%',\\n      bottom: '3%',\\n      containLabel: true\\n    },\\n    xAxis: [\\n      {\\n        type: 'category',\\n        data: ['超级VIP', 'VIP', '会员', '普通', '低价值'],\\n        axisTick: {\\n          alignWithLabel: true\\n        }\\n      }\\n    ],\\n    yAxis: [\\n      {\\n        type: 'value'\\n      }\\n    ],\\n    series: [\\n      {\\n        name: '客户数量',\\n        type: 'bar',\\n        barWidth: '60%',\\n        data: [\\n          { value: 629, itemStyle: { color: '#F56C6C' } },\\n          { value: 1887, itemStyle: { color: '#E6A23C' } },\\n          { value: 3774, itemStyle: { color: '#409EFF' } },\\n          { value: 5032, itemStyle: { color: '#67C23A' } },\\n          { value: 1258, itemStyle: { color: '#909399' } }\\n        ]\\n      }\\n    ]\\n  }\\n\\n  valueChartInstance.setOption(option)\\n}\\n\\nconst initFlowTrendChart = () => {\\n  if (!flowTrendChart.value) return\\n\\n  if (flowChartInstance) {\\n    flowChartInstance.dispose()\\n  }\\n\\n  flowChartInstance = echarts.init(flowTrendChart.value)\\n\\n  const option = {\\n    tooltip: {\\n      trigger: 'axis'\\n    },\\n    legend: {\\n      data: ['流入', '流出']\\n    },\\n    grid: {\\n      left: '3%',\\n      right: '4%',\\n      bottom: '3%',\\n      containLabel: true\\n    },\\n    xAxis: {\\n      type: 'category',\\n      boundaryGap: false,\\n      data: ['1月', '2月', '3月', '4月', '5月', '6月']\\n    },\\n    yAxis: {\\n      type: 'value'\\n    },\\n    series: [\\n      {\\n        name: '流入',\\n        type: 'line',\\n        stack: 'Total',\\n        areaStyle: {\\n          color: '#67C23A'\\n        },\\n        lineStyle: {\\n          width: 1\\n        },\\n        showSymbol: false,\\n        data: [820, 932, 901, 934, 1290, 1330]\\n      },\\n      {\\n        name: '流出',\\n        type: 'line',\\n        stack: 'Total',\\n        areaStyle: {\\n          color: '#F56C6C'\\n        },\\n        lineStyle: {\\n          width: 1\\n        },\\n        showSymbol: false,\\n        data: [120, 132, 101, 134, 90, 230]\\n      }\\n    ]\\n  }\\n\\n  flowChartInstance.setOption(option)\\n}\\n\\nconst initRetentionRateChart = () => {\\n  if (!retentionRateChart.value) return\\n\\n  if (retentionChartInstance) {\\n    retentionChartInstance.dispose()\\n  }\\n\\n  retentionChartInstance = echarts.init(retentionRateChart.value)\\n\\n  const option = {\\n    tooltip: {\\n      trigger: 'axis',\\n      formatter: '{b}: {c}%'\\n    },\\n    grid: {\\n      left: '3%',\\n      right: '4%',\\n      bottom: '3%',\\n      containLabel: true\\n    },\\n    xAxis: {\\n      type: 'category',\\n      boundaryGap: false,\\n      data: ['1月', '2月', '3月', '4月', '5月', '6月']\\n    },\\n    yAxis: {\\n      type: 'value',\\n      axisLabel: {\\n        formatter: '{value}%'\\n      }\\n    },\\n    series: [\\n      {\\n        name: '留存率',\\n        type: 'line',\\n        data: [95.2, 96.1, 95.8, 96.5, 97.2, 96.6],\\n        smooth: true,\\n        lineStyle: {\\n          width: 3,\\n          color: '#409EFF'\\n        },\\n        areaStyle: {\\n          color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [\\n            { offset: 0, color: 'rgba(64, 158, 255, 0.3)' },\\n            { offset: 1, color: 'rgba(64, 158, 255, 0.05)' }\\n          ])\\n        }\\n      }\\n    ]\\n  }\\n\\n  retentionChartInstance.setOption(option)\\n}\\n\\nconst initCLVDistributionChart = () => {\\n  if (!clvDistributionChart.value) return\\n\\n  if (clvChartInstance) {\\n    clvChartInstance.dispose()\\n  }\\n\\n  clvChartInstance = echarts.init(clvDistributionChart.value)\\n\\n  const option = {\\n    tooltip: {\\n      trigger: 'item',\\n      formatter: '{b}: ¥{c}'\\n    },\\n    grid: {\\n      left: '3%',\\n      right: '4%',\\n      bottom: '3%',\\n      containLabel: true\\n    },\\n    xAxis: {\\n      type: 'category',\\n      data: ['<1000', '1000-2000', '2000-3000', '3000-4000', '4000-5000', '>5000'],\\n      axisTick: {\\n        alignWithLabel: true\\n      }\\n    },\\n    yAxis: {\\n      type: 'value',\\n      axisLabel: {\\n        formatter: '¥{value}'\\n      }\\n    },\\n    series: [\\n      {\\n        name: '客户数量',\\n        type: 'bar',\\n        barWidth: '60%',\\n        data: [\\n          { value: 2516, itemStyle: { color: '#909399' } },\\n          { value: 3774, itemStyle: { color: '#67C23A' } },\\n          { value: 3145, itemStyle: { color: '#409EFF' } },\\n          { value: 1887, itemStyle: { color: '#E6A23C' } },\\n          { value: 942, itemStyle: { color: '#F56C6C' } },\\n          { value: 316, itemStyle: { color: '#E6A23C' } }\\n        ]\\n      }\\n    ]\\n  }\\n\\n  clvChartInstance.setOption(option)\\n}\\n\\nconst filterAlerts = () => {\\n}\\n\\nconst filterCareReminders = () => {\\n}\\n\\nconst assignAlert = (alert: any) => {\\n  assignForm.value = {\\n    customerId: alert.customerId,\\n    customerName: alert.customerName,\\n    assignedTo: '',\\n    notes: ''\\n  }\\n  showAssignDialog.value = true\\n}\\n\\nconst confirmAssign = () => {\\n  if (!assignForm.value.assignedTo) {\\n    ElMessage.warning('请选择处理人员')\\n    return\\n  }\\n\\n  assignAlert(assignForm.value.customerId, assignForm.value.assignedTo)\\n  showAssignDialog.value = false\\n  ElMessage.success('分配成功')\\n}\\n\\nconst resolveAlert = (alert: any) => {\\n  resolveForm.value = {\\n    customerId: alert.customerId,\\n    customerName: alert.customerName,\\n    resolutionNotes: ''\\n  }\\n  showResolveDialog.value = true\\n}\\n\\nconst confirmResolve = () => {\\n  if (!resolveForm.value.resolutionNotes) {\\n    ElMessage.warning('请输入解决说明')\\n    return\\n  }\\n\\n  resolveAlert(resolveForm.value.customerId, resolveForm.value.resolutionNotes)\\n  showResolveDialog.value = false\\n  ElMessage.success('标记成功')\\n}\\n\\nconst sendCareReminder = async (reminder: any) => {\\n  try {\\n    await sendReminder(reminder)\\n  } catch (error) {\\n    console.error('Send care reminder failed:', error)\\n  }\\n}\\n\\nconst viewCustomerDetail = (alert: any) => {\\n  ElMessage.info('查看客户详情功能开发中')\\n}\\n\\nconst viewReminderDetail = (reminder: any) => {\\n  ElMessage.info('查看提醒详情功能开发中')\\n}\\n\\nconst exportDashboard = () => {\\n  ElMessage.info('导出报告功能开发中')\\n}\\n\\nconst getTrendColor = (trendType: string): string => {\\n  return trendType === 'up' ? '#67C23A' : '#F56C6C'\\n}\\n\\nconst getTrendIcon = (trendType: string): any => {\\n  return trendType === 'up' ? ArrowUp : ArrowDown\\n}\\n\\nconst getChurnProbabilityType = (probability: number): string => {\\n  if (probability >= 0.7) return 'danger'\\n  if (probability >= 0.4) return 'warning'\\n  return 'info'\\n}\\n\\nconst getRiskLevelType = (riskLevel: string): string => {\\n  if (riskLevel === 'high') return 'danger'\\n  if (riskLevel === 'medium') return 'warning'\\n  return 'info'\\n}\\n\\nconst getStatusType = (status: string): string => {\\n  if (status === 'pending') return 'warning'\\n  if (status === 'in_progress') return 'primary'\\n  if (status === 'resolved') return 'success'\\n  return 'info'\\n}\\n\\nconst getCareStatusType = (status: string): string => {\\n  if (status === 'pending') return 'warning'\\n  if (status === 'sent') return 'success'\\n  return 'info'\\n}\\n\\nconst getCareStatusLabel = (status: string): string => {\\n  const labels: Record<string, string> = {\\n    pending: '待发送',\\n    sent: '已发送',\\n    failed: '发送失败'\\n  }\\n  return labels[status] || '未知'\\n}\\n\\nconst formatDate = (date: Date): string => {\\n  return new Date(date).toLocaleDateString('zh-CN')\\n}\\n\\nconst formatDateTime = (date: Date): string => {\\n  return new Date(date).toLocaleString('zh-CN')\\n}\\n\\nonMounted(() => {\\n  loadDashboardData()\\n})\\n\\nonBeforeUnmount(() => {\\n  if (stageChartInstance) stageChartInstance.dispose()\\n  if (valueChartInstance) valueChartInstance.dispose()\\n  if (flowChartInstance) flowChartInstance.dispose()\\n  if (retentionChartInstance) retentionChartInstance.dispose()\\n  if (clvChartInstance) clvChartInstance.dispose()\\n})\\n</script>\\n\\n<style scoped>\\n.customer-lifecycle-dashboard {\\n  padding: 20px;\\n  background: #f5f7fa;\\n  min-height: 100vh;\\n}\\n\\n.dashboard-header {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n  margin-bottom: 20px;\\n  padding: 20px;\\n  background: white;\\n  border-radius: 8px;\\n  box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.1);\\n}\\n\\n.dashboard-header h1 {\\n  margin: 0;\\n  font-size: 24px;\\n  font-weight: bold;\\n  color: #303133;\\n}\\n\\n.header-actions {\\n  display: flex;\\n  gap: 10px;\\n}\\n\\n.metrics-row,\\n.charts-row,\\n.alerts-row,\\n.care-reminders-row {\\n  margin-bottom: 20px;\\n}\\n\\n.metric-card {\\n  cursor: pointer;\\n  transition: all 0.3s;\\n}\\n\\n.metric-card:hover {\\n  transform: translateY(-5px);\\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);\\n}\\n\\n.metric-content {\\n  display: flex;\\n  align-items: center;\\n  gap: 15px;\\n}\\n\\n.metric-icon {\\n  width: 60px;\\n  height: 60px;\\n  border-radius: 12px;\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  color: white;\\n}\\n\\n.metric-info {\\n  flex: 1;\\n}\\n\\n.metric-value {\\n  font-size: 28px;\\n  font-weight: bold;\\n  color: #303133;\\n  margin-bottom: 5px;\\n}\\n\\n.metric-label {\\n  font-size: 14px;\\n  color: #909399;\\n  margin-bottom: 5px;\\n}\\n\\n.metric-trend {\\n  display: flex;\\n  align-items: center;\\n  gap: 5px;\\n  font-size: 12px;\\n}\\n\\n.chart-card {\\n  height: 400px;\\n}\\n\\n.card-header {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n}\\n\\n.chart-container {\\n  width: 100%;\\n  height: 320px;\\n}\\n\\n.alerts-card,\\n.care-reminders-card {\\n  min-height: 500px;\\n}\\n\\n.header-actions {\\n  display: flex;\\n  gap: 10px;\\n}\\n</style>\\n\",\"originTextLength\":26692,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768911102102}]",
