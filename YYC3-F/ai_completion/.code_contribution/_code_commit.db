26,\"character\":0},\"end\":{\"line\":1027,\"character\":23}},\"action\":\"None\",\"isLine\":false,\"originText\":\"    const prediction: ChurnPrediction = {\\\\n      id: generateId(),\",\"originAcceptText\":\"    const prediction: ChurnPrediction = {\\n      id: generateId(),\",\"originTextLength\":65,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768914454761},{\"originRange\":{\"start\":{\"line\":1041,\"character\":0},\"end\":{\"line\":1140,\"character\":16}},\"modifyRange\":{\"start\":{\"line\":1041,\"character\":0},\"end\":{\"line\":1140,\"character\":16}},\"action\":\"None\",\"isLine\":false,\"originText\":\"\\\\n    await this.churnRepository.save(prediction)\\\\n    return prediction\\\\n  }\\\\n\\\\n  async batchPredictChurn(customerIds: string[]): Promise<ChurnPrediction[]> {\\\\n    const results: ChurnPrediction[] = []\\\\n\\\\n    for (const customerId of customerIds) {\\\\n      const customer = await this.customerRepository.findById(customerId)\\\\n      if (customer) {\\\\n        const prediction = await this.predictChurn(customer)\\\\n        results.push(prediction)\\\\n      }\\\\n    }\\\\n\\\\n    return results\\\\n  }\\\\n\\\\n  private getRiskLevel(churnProbability: number): \\\\'high\\\\' | \\\\'medium\\\\' | \\\\'low\\\\' {\\\\n    if (churnProbability >= 0.7) return \\\\'high\\\\'\\\\n    if (churnProbability >= 0.4) return \\\\'medium\\\\'\\\\n    return \\\\'low\\\\'\\\\n  }\\\\n\\\\n  private predictChurnDate(churnProbability: number, daysSinceLastOrder: number): Date {\\\\n    const daysToChurn = Math.ceil((1 - churnProbability) * 90)\\\\n    const predictedDate = new Date()\\\\n    predictedDate.setDate(predictedDate.getDate() + daysToChurn)\\\\n    return predictedDate\\\\n  }\\\\n\\\\n  private generateRecommendations(riskFactors: string[], riskLevel: string): string[] {\\\\n    const recommendations: string[] = []\\\\n\\\\n    if (riskFactors.includes(\\\\'30天未消费\\\\')) {\\\\n      recommendations.push(\\\\'发送关怀短信\\\\')\\\\n      recommendations.push(\\\\'提供专属优惠券\\\\')\\\\n    }\\\\n\\\\n    if (riskFactors.includes(\\\\'60天未消费\\\\')) {\\\\n      recommendations.push(\\\\'安排客户回访\\\\')\\\\n      recommendations.push(\\\\'提供会员优惠\\\\')\\\\n    }\\\\n\\\\n    if (riskFactors.includes(\\\\'90天未消费\\\\')) {\\\\n      recommendations.push(\\\\'立即联系客户了解情况\\\\')\\\\n      recommendations.push(\\\\'提供专属优惠套餐\\\\')\\\\n    }\\\\n\\\\n    if (riskFactors.some(f => f.includes(\\\\'下降\\\\'))) {\\\\n      recommendations.push(\\\\'了解客户需求变化\\\\')\\\\n      recommendations.push(\\\\'优化产品和服务\\\\')\\\\n    }\\\\n\\\\n    if (riskLevel === \\\\'high\\\\') {\\\\n      recommendations.unshift(\\\\'立即联系客户了解情况\\\\')\\\\n    }\\\\n\\\\n    return [...new Set(recommendations)]\\\\n  }\\\\n\\\\n  async getChurnStatistics(startDate?: Date, endDate?: Date): Promise<ChurnStatistics> {\\\\n    const predictions = await this.churnRepository.findByDateRange(startDate, endDate)\\\\n\\\\n    const totalPredictions = predictions.length\\\\n    const highRiskCount = predictions.filter(p => p.riskLevel === \\\\'high\\\\').length\\\\n    const mediumRiskCount = predictions.filter(p => p.riskLevel === \\\\'medium\\\\').length\\\\n    const lowRiskCount = predictions.filter(p => p.riskLevel === \\\\'low\\\\').length\\\\n\\\\n    const pendingCount = predictions.filter(p => p.status === \\\\'pending\\\\').length\\\\n    const inProgressCount = predictions.filter(p => p.status === \\\\'in_progress\\\\').length\\\\n    const resolvedCount = predictions.filter(p => p.status === \\\\'resolved\\\\').length\\\\n    const closedCount = predictions.filter(p => p.status === \\\\'closed\\\\').length\\\\n\\\\n    const averageChurnProbability = predictions.reduce((sum, p) => sum + p.churnProbability, 0) / totalPredictions\\\\n\\\\n    const churnTrend = await this.calculateChurnTrend(startDate, endDate)\\\\n\\\\n    return {\\\\n      totalPredictions,\\\\n      highRiskCount,\\\\n      mediumRiskCount,\\\\n      lowRiskCount,\\\\n      pendingCount,\\\\n      inProgressCount,\\\\n      resolvedCount,\\\\n      closedCount,\\\\n      averageChurnProbability,\\\\n      churnTrend\\\\n    }\\\\n  }\\\\n\\\\n  private async calculateChurnTrend(startDate?: Date, endDate?: Date): Promise<any[]> {\\\\n    const predictions = await this.churnRepository.findByDateRange(startDate, endDate)\\\\n    const trendMap = new Map<string, any>()\\\\n\\\\n    predictions.forEach(prediction => {\\\\n      const date = prediction.createdAt.toISOString().split(\\\\'T\\\\')[0]\\\\n\\\\n      if (!trendMap.has(date)) {\\\\n        trendMap.set(date, {\\\\n          date,\\\\n          highRiskCount: 0,\\\\n          mediumRiskCount: 0,\\\\n          lowRiskCount: 0,\\\\n          totalChurned: 0,\\\\n          churnRate: 0\\\\n        })\\\\n      }\\\\n\\\\n      const trend = trendMap.get(date)\\\\n      trend.highRiskCount += prediction.riskLevel === \\\\'high\\\\' ? 1 : 0\\\\n      trend.mediumRiskCount += prediction.riskLevel === \\\\'medium\\\\' ? 1 : 0\\\\n      trend.lowRiskCount += prediction.riskLevel === \\\\'low\\\\' ? 1 : 0\\\\n      trend.totalChurned += prediction.status === \\\\'resolved\\\\' ? 1 : 0\\\\n    })\\\\n\\\\n    const trend = Array.from(trendMap.values()).sort((a, b) => a.date.localeCompare(b.date))\\\\n\\\\n    trend.forEach(t => {\\\\n      t.churnRate = t.totalChurned / (t.highRiskCount + t.mediumRiskCount + t.lowRiskCount)\\\\n    })\\\\n\\\\n    return trend\",\"originAcceptText\":\"\\n    await this.churnRepository.save(prediction)\\n    return prediction\\n  }\\n\\n  async batchPredictChurn(customerIds: string[]): Promise<ChurnPrediction[]> {\\n    const results: ChurnPrediction[] = []\\n\\n    for (const customerId of customerIds) {\\n      const customer = await this.customerRepository.findById(customerId)\\n      if (customer) {\\n        const prediction = await this.predictChurn(customer)\\n        results.push(prediction)\\n      }\\n    }\\n\\n    return results\\n  }\\n\\n  private getRiskLevel(churnProbability: number): 'high' | 'medium' | 'low' {\\n    if (churnProbability >= 0.7) return 'high'\\n    if (churnProbability >= 0.4) return 'medium'\\n    return 'low'\\n  }\\n\\n  private predictChurnDate(churnProbability: number, daysSinceLastOrder: number): Date {\\n    const daysToChurn = Math.ceil((1 - churnProbability) * 90)\\n    const predictedDate = new Date()\\n    predictedDate.setDate(predictedDate.getDate() + daysToChurn)\\n    return predictedDate\\n  }\\n\\n  private generateRecommendations(riskFactors: string[], riskLevel: string): string[] {\\n    const recommendations: string[] = []\\n\\n    if (riskFactors.includes('30天未消费')) {\\n      recommendations.push('发送关怀短信')\\n      recommendations.push('提供专属优惠券')\\n    }\\n\\n    if (riskFactors.includes('60天未消费')) {\\n      recommendations.push('安排客户回访')\\n      recommendations.push('提供会员优惠')\\n    }\\n\\n    if (riskFactors.includes('90天未消费')) {\\n      recommendations.push('立即联系客户了解情况')\\n      recommendations.push('提供专属优惠套餐')\\n    }\\n\\n    if (riskFactors.some(f => f.includes('下降'))) {\\n      recommendations.push('了解客户需求变化')\\n      recommendations.push('优化产品和服务')\\n    }\\n\\n    if (riskLevel === 'high') {\\n      recommendations.unshift('立即联系客户了解情况')\\n    }\\n\\n    return [...new Set(recommendations)]\\n  }\\n\\n  async getChurnStatistics(startDate?: Date, endDate?: Date): Promise<ChurnStatistics> {\\n    const predictions = await this.churnRepository.findByDateRange(startDate, endDate)\\n\\n    const totalPredictions = predictions.length\\n    const highRiskCount = predictions.filter(p => p.riskLevel === 'high').length\\n    const mediumRiskCount = predictions.filter(p => p.riskLevel === 'medium').length\\n    const lowRiskCount = predictions.filter(p => p.riskLevel === 'low').length\\n\\n    const pendingCount = predictions.filter(p => p.status === 'pending').length\\n    const inProgressCount = predictions.filter(p => p.status === 'in_progress').length\\n    const resolvedCount = predictions.filter(p => p.status === 'resolved').length\\n    const closedCount = predictions.filter(p => p.status === 'closed').length\\n\\n    const averageChurnProbability = predictions.reduce((sum, p) => sum + p.churnProbability, 0) / totalPredictions\\n\\n    const churnTrend = await this.calculateChurnTrend(startDate, endDate)\\n\\n    return {\\n      totalPredictions,\\n      highRiskCount,\\n      mediumRiskCount,\\n      lowRiskCount,\\n      pendingCount,\\n      inProgressCount,\\n      resolvedCount,\\n      closedCount,\\n      averageChurnProbability,\\n      churnTrend\\n    }\\n  }\\n\\n  private async calculateChurnTrend(startDate?: Date, endDate?: Date): Promise<any[]> {\\n    const predictions = await this.churnRepository.findByDateRange(startDate, endDate)\\n    const trendMap = new Map<string, any>()\\n\\n    predictions.forEach(prediction => {\\n      const date = prediction.createdAt.toISOString().split('T')[0]\\n\\n      if (!trendMap.has(date)) {\\n        trendMap.set(date, {\\n          date,\\n          highRiskCount: 0,\\n          mediumRiskCount: 0,\\n          lowRiskCount: 0,\\n          totalChurned: 0,\\n          churnRate: 0\\n        })\\n      }\\n\\n      const trend = trendMap.get(date)\\n      trend.highRiskCount += prediction.riskLevel === 'high' ? 1 : 0\\n      trend.mediumRiskCount += prediction.riskLevel === 'medium' ? 1 : 0\\n      trend.lowRiskCount += prediction.riskLevel === 'low' ? 1 : 0\\n      trend.totalChurned += prediction.status === 'resolved' ? 1 : 0\\n    })\\n\\n    const trend = Array.from(trendMap.values()).sort((a, b) => a.date.localeCompare(b.date))\\n\\n    trend.forEach(t => {\\n      t.churnRate = t.totalChurned / (t.highRiskCount + t.mediumRiskCount + t.lowRiskCount)\\n    })\\n\\n    return trend\",\"originTextLength\":4076,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768914454787},{\"originRange\":{\"start\":{\"line\":1050,\"character\":0},\"end\"