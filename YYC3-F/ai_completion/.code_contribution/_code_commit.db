>\\\\n                  <el-option label=\\\\\\\"金额\\\\\\\" value=\\\\\\\"amount\\\\\\\" />\\\\n                </el-select>\\\\n              </el-form-item>\\\\n              <el-form-item label=\\\\\\\"格式规则\\\\\\\">\\\\n                <el-select v-model=\\\\\\\"ruleForm.ruleConfig.format\\\\\\\" placeholder=\\\\\\\"请选择格式规则\\\\\\\">\\\\n                  <el-option label=\\\\\\\"手机号格式\\\\\\\" value=\\\\\\\"phone\\\\\\\" />\\\\n                  <el-option label=\\\\\\\"邮箱格式\\\\\\\" value=\\\\\\\"email\\\\\\\" />\\\\n                  <el-option label=\\\\\\\"日期格式\\\\\\\" value=\\\\\\\"date\\\\\\\" />\\\\n                  <el-option label=\\\\\\\"数字格式\\\\\\\" value=\\\\\\\"number\\\\\\\" />\\\\n                </el-select>\\\\n              </el-form-item>\\\\n            </div>\\\\n\\\\n            <div v-else-if=\\\\\\\"ruleForm.ruleType === \\\\'duplicate\\\\'\\\\\\\" class=\\\\\\\"config-section\\\\\\\">\\\\n              <el-form-item label=\\\\\\\"数据表\\\\\\\">\\\\n                <el-input v-model=\\\\\\\"ruleForm.ruleConfig.table\\\\\\\" placeholder=\\\\\\\"请输入数据表名\\\\\\\" />\\\\n              </el-form-item>\\\\n              <el-form-item label=\\\\\\\"去重字段\\\\\\\">\\\\n                <el-select v-model=\\\\\\\"ruleForm.ruleConfig.fields\\\\\\\" multiple placeholder=\\\\\\\"请选择去重字段\\\\\\\">\\\\n                  <el-option label=\\\\\\\"订单号\\\\\\\" value=\\\\\\\"order_number\\\\\\\" />\\\\n                  <el-option label=\\\\\\\"客户ID\\\\\\\" value=\\\\\\\"customer_id\\\\\\\" />\\\\n                  <el-option label=\\\\\\\"菜品ID\\\\\\\" value=\\\\\\\"dish_id\\\\\\\" />\\\\n                </el-select>\\\\n              </el-form-item>\\\\n              <el-form-item label=\\\\\\\"保留策略\\\\\\\">\\\\n                <el-radio-group v-model=\\\\\\\"ruleForm.ruleConfig.strategy\\\\\\\">\\\\n                  <el-radio label=\\\\\\\"first\\\\\\\">保留第一条</el-radio>\\\\n                  <el-radio label=\\\\\\\"last\\\\\\\">保留最后一条</el-radio>\\\\n                  <el-radio label=\\\\\\\"latest\\\\\\\">保留最新的一条</el-radio>\\\\n                </el-radio-group>\\\\n              </el-form-item>\\\\n            </div>\\\\n\\\\n            <div v-else-if=\\\\\\\"ruleForm.ruleType === \\\\'outlier\\\\'\\\\\\\" class=\\\\\\\"config-section\\\\\\\">\\\\n              <el-form-item label=\\\\\\\"数据表\\\\\\\">\\\\n                <el-input v-model=\\\\\\\"ruleForm.ruleConfig.table\\\\\\\" placeholder=\\\\\\\"请输入数据表名\\\\\\\" />\\\\n              </el-form-item>\\\\n              <el-form-item label=\\\\\\\"检测字段\\\\\\\">\\\\n                <el-select v-model=\\\\\\\"ruleForm.ruleConfig.field\\\\\\\" placeholder=\\\\\\\"请选择检测字段\\\\\\\">\\\\n                  <el-option label=\\\\\\\"订单金额\\\\\\\" value=\\\\\\\"order_amount\\\\\\\" />\\\\n                  <el-option label=\\\\\\\"菜品价格\\\\\\\" value=\\\\\\\"dish_price\\\\\\\" />\\\\n                  <el-option label=\\\\\\\"客户消费\\\\\\\" value=\\\\\\\"customer_spent\\\\\\\" />\\\\n                </el-select>\\\\n              </el-form-item>\\\\n              <el-form-item label=\\\\\\\"检测方法\\\\\\\">\\\\n                <el-select v-model=\\\\\\\"ruleForm.ruleConfig.method\\\\\\\" placeholder=\\\\\\\"请选择检测方法\\\\\\\">\\\\n                  <el-option label=\\\\\\\"标准差法\\\\\\\" value=\\\\\\\"std\\\\\\\" />\\\\n                  <el-option label=\\\\\\\"四分位距法\\\\\\\" value=\\\\\\\"iqr\\\\\\\" />\\\\n                  <el-option label=\\\\\\\"Z-Score法\\\\\\\" value=\\\\\\\"zscore\\\\\\\" />\\\\n                </el-select>\\\\n              </el-form-item>\\\\n              <el-form-item label=\\\\\\\"阈值倍数\\\\\\\">\\\\n                <el-input-number v-model=\\\\\\\"ruleForm.ruleConfig.threshold\\\\\\\" :min=\\\\\\\"1\\\\\\\" :max=\\\\\\\"5\\\\\\\" :step=\\\\\\\"0.5\\\\\\\" />\\\\n              </el-form-item>\\\\n            </div>\\\\n\\\\n            <div v-else-if=\\\\\\\"ruleForm.ruleType === \\\\'completeness\\\\'\\\\\\\" class=\\\\\\\"config-section\\\\\\\">\\\\n              <el-form-item label=\\\\\\\"数据表\\\\\\\">\\\\n                <el-input v-model=\\\\\\\"ruleForm.ruleConfig.table\\\\\\\" placeholder=\\\\\\\"请输入数据表名\\\\\\\" />\\\\n              </el-form-item>\\\\n              <el-form-item label=\\\\\\\"必填字段\\\\\\\">\\\\n                <el-select v-model=\\\\\\\"ruleForm.ruleConfig.fields\\\\\\\" multiple placeholder=\\\\\\\"请选择必填字段\\\\\\\">\\\\n                  <el-option label=\\\\\\\"订单号\\\\\\\" value=\\\\\\\"order_number\\\\\\\" />\\\\n                  <el-option label=\\\\\\\"客户ID\\\\\\\" value=\\\\\\\"customer_id\\\\\\\" />\\\\n                  <el-option label=\\\\\\\"菜品ID\\\\\\\" value=\\\\\\\"dish_id\\\\\\\" />\\\\n                  <el-option label=\\\\\\\"金额\\\\\\\" value=\\\\\\\"amount\\\\\\\" />\\\\n                </el-select>\\\\n              </el-form-item>\\\\n              <el-form-item label=\\\\\\\"缺失处理\\\\\\\">\\\\n                <el-radio-group v-model=\\\\\\\"ruleForm.ruleConfig.action\\\\\\\">\\\\n                  <el-radio label=\\\\\\\"delete\\\\\\\">删除记录</el-radio>\\\\n                  <el-radio label=\\\\\\\"fill\\\\\\\">填充默认值</el-radio>\\\\n                  <el-radio label=\\\\\\\"mark\\\\\\\">标记异常</el-radio>\\\\n                </el-radio-group>\\\\n              </el-form-item>\\\\n            </div>\\\\n\\\\n            <div v-else-if=\\\\\\\"ruleForm.ruleType === \\\\'consistency\\\\'\\\\\\\" class=\\\\\\\"config-section\\\\\\\">\\\\n              <el-form-item label=\\\\\\\"数据表\\\\\\\">\\\\n                <el-input v-model=\\\\\\\"ruleForm.ruleConfig.table\\\\\\\" placeholder=\\\\\\\"请输入数据表名\\\\\\\" />\\\\n              </el-form-item>\\\\n              <el-form-item label=\\\\\\\"检查规则\\\\\\\">\\\\n                <el-input\\\\n                  v-model=\\\\\\\"ruleForm.ruleConfig.sql\\\\\\\"\\\\n                  type=\\\\\\\"textarea\\\\\\\"\\\\n                  :rows=\\\\\\\"4\\\\\\\"\\\\n                  placeholder=\\\\\\\"请输入SQL检查规则，例如：SELECT * FROM orders WHERE order_amount < 0\\\\\\\"\\\\n                />\\\\n              </el-form-item>\\\\n            </div>\\\\n          </div>\\\\n        </el-form-item>\\\\n\\\\n        <el-form-item label=\\\\\\\"优先级\\\\\\\" prop=\\\\\\\"priority\\\\\\\">\\\\n          <el-input-number v-model=\\\\\\\"ruleForm.priority\\\\\\\" :min=\\\\\\\"0\\\\\\\" :max=\\\\\\\"100\\\\\\\" />\\\\n        </el-form-item>\\\\n\\\\n        <el-form-item label=\\\\\\\"启用状态\\\\\\\">\\\\n          <el-switch v-model=\\\\\\\"ruleForm.enabled\\\\\\\" />\\\\n        </el-form-item>\\\\n      </el-form>\\\\n\\\\n      <template #footer>\\\\n        <span class=\\\\\\\"dialog-footer\\\\\\\">\\\\n          <el-button @click=\\\\\\\"showAddDialog = false\\\\\\\">取消</el-button>\\\\n          <el-button type=\\\\\\\"primary\\\\\\\" @click=\\\\\\\"handleSaveRule\\\\\\\">保存</el-button>\\\\n        </span>\\\\n      </template>\\\\n    </el-dialog>\\\\n\\\\n    <el-dialog v-model=\\\\\\\"showExecuteDialog\\\\\\\" title=\\\\\\\"执行数据清洗\\\\\\\" width=\\\\\\\"60%\\\\\\\">\\\\n      <el-form :model=\\\\\\\"executeForm\\\\\\\" label-width=\\\\\\\"120px\\\\\\\">\\\\n        <el-form-item label=\\\\\\\"执行范围\\\\\\\">\\\\n          <el-radio-group v-model=\\\\\\\"executeForm.scope\\\\\\\">\\\\n            <el-radio label=\\\\\\\"all\\\\\\\">全部数据</el-radio>\\\\n            <el-radio label=\\\\\\\"date\\\\\\\">指定日期范围</el-radio>\\\\n          </el-radio-group>\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"日期范围\\\\\\\" v-if=\\\\\\\"executeForm.scope === \\\\'date\\\\'\\\\\\\">\\\\n          <el-date-picker\\\\n            v-model=\\\\\\\"executeForm.dateRange\\\\\\\"\\\\n            type=\\\\\\\"daterange\\\\\\\"\\\\n            range-separator=\\\\\\\"至\\\\\\\"\\\\n            start-placeholder=\\\\\\\"开始日期\\\\\\\"\\\\n            end-placeholder=\\\\\\\"结束日期\\\\\\\"\\\\n          />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"选择规则\\\\\\\">\\\\n          <el-select v-model=\\\\\\\"executeForm.ruleIds\\\\\\\" multiple placeholder=\\\\\\\"选择要执行的规则（默认全部）\\\\\\\">\\\\n            <el-option\\\\n              v-for=\\\\\\\"rule in cleaningRules\\\\\\\"\\\\n              :key=\\\\\\\"rule.id\\\\\\\"\\\\n              :label=\\\\\\\"rule.ruleName\\\\\\\"\\\\n              :value=\\\\\\\"rule.id\\\\\\\"\\\\n            />\\\\n          </el-select>\\\\n        </el-form-item>\\\\n      </el-form>\\\\n\\\\n      <template #footer>\\\\n        <span class=\\\\\\\"dialog-footer\\\\\\\">\\\\n          <el-button @click=\\\\\\\"showExecuteDialog = false\\\\\\\">取消</el-button>\\\\n          <el-button type=\\\\\\\"primary\\\\\\\" @click=\\\\\\\"handleExecuteCleaning\\\\\\\" :loading=\\\\\\\"executing\\\\\\\">\\\\n            执行清洗\\\\n          </el-button>\\\\n        </span>\\\\n      </template>\\\\n    </el-dialog>\\\\n\\\\n    <el-dialog v-model=\\\\\\\"showResultsDialog\\\\\\\" title=\\\\\\\"清洗结果\\\\\\\" width=\\\\\\\"80%\\\\\\\">\\\\n      <el-alert\\\\n        :title=\\\\\\\"`清洗完成，共处理 ${cleaningResult.totalRecords} 条记录`\\\\\\\"\\\\n        type=\\\\\\\"success\\\\\\\"\\\\n        :closable=\\\\\\\"false\\\\\\\"\\\\n        style=\\\\\\\"margin-bottom: 20px;\\\\\\\"\\\\n      />\\\\n\\\\n      <el-table :data=\\\\\\\"cleaningResult.issues\\\\\\\" stripe max-height=\\\\\\\"500\\\\\\\">\\\\n        <el-table-column prop=\\\\\\\"ruleName\\\\\\\" label=\\\\\\\"规则名称\\\\\\\" width=\\\\\\\"150\\\\\\\" />\\\\n        <el-table-column prop=\\\\\\\"issueType\\\\\\\" label=\\\\\\\"问题类型\\\\\\\" width=\\\\\\\"120\\\\\\\">\\\\n          <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n            <el-tag :type=\\\\\\\"getIssueTypeTagType(row.issueType)\\\\\\\" size=\\\\\\\"small\\\\\\\">\\\\n              {{ getIssueTypeText(row.issueType) }}\\\\n            </el-tag>\\\\n          </template>\\\\n        </el-table-column>\\\\n        <el-table-column prop=\\\\\\\"recordCount\\\\\\\" label=\\\\\\\"问题记录数\\\\\\\" width=\\\\\\\"120\\\\\\\" />\\\\n        <el-table-column prop=\\\\\\\"description\\\\\\\" label=\\\\\\\"问题描述\\\\\\\" min-width=\\\\\\\"200\\\\\\\" />\\\\n        <el-table-column prop=\\\\\\\"action\\\\\\\" label=\\\\\\\"处理动作\\\\\\\" width=\\\\\\\"120\\\\\\\" />\\\\n        <el-table-column label=\\\\\\\"操作\\\\\\\" width=\\\\\\\"120\\\\\\\">\\\\n          <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n            <el-button size=\\\\\\\"small\\\\\\\" text type=\\\\\\\"primary\\\\\\\" @click=\\\\\\\"handleViewDetail(row)\\\\\\\">\\\\n              查看详情\\\\n            </el-button>\\\\n          </template>\\\\n        </el-table-column>\\\\n      </el-table>\\\\n    </el-dialog>\\\\n  </div>\\\\n</template>\\\\n\\\\n<script setup lang=\\\\\\\"ts\\\\\\\">\\\\nimport { ref, reactive, onMounted } from \\\\'vue\\\\'\\\\nimport { ElMessage, ElMessageBox } from \\\\'element-plus\\\\'\\\\nimport {\\\\n  Refresh,\\\\n  Plus,\\\\n  Search,\\\\n  RefreshLeft,\\\\n  PlayArrow,\\\\n  Document,\\\\n  Brush,\\\\n  SuccessFilled,\\\\n  WarningFilled,\\\\n  CircleCloseFilled\\\\n} from \\\\'@element-plus/icons-vue\\\\'\\\\n\\\\ninterface CleaningRule {\\\\n  id: string\\\\n  ruleName: string\\\\n  ruleType: string\\\\n  ruleConfig: object\\\\n  priority: number\\\\n  enabled: boolean\\\\n  executionCount?: number\\\\n  lastExecutedAt?: string\\\\n  tenantId: string\\\\n  createdAt: string\\\\n  updatedAt: string\\\\n}\\\\n\\\\ninterface CleaningResult {\\\\n  totalRecords: number\\\\n  cleanedRecords: number\\\\n  invalidRecords: number\\\\n  issues: CleaningIssue[]\\\\n}\\\\n\\\\ninterface CleaningIssue {\\\\n  ruleName: string\\\\n  issueType: string\\\\n  recordCount: number\\\\n  description: string\\\\n  action: string\\\\n  details?: object\\\\n}\\\\n\\\\nconst loading = ref(false)\\\\nconst executing = ref(false)\\\\nconst showAddDialog = ref(false)\\\\nconst showExecuteDialog = ref(false)\\\\nconst showResultsDialog = ref(false)\\\\nconst editingRule = ref<CleaningRule | null>(null)\\\\nconst ruleFormRef = ref()\\\\n\\\\nconst filters = reactive({\\\\n  ruleType: \\\\'\\\\',\\\\n  enabled: \\\\'\\\\'\\\\n})\\\\n\\\\nconst ruleForm = reactive({\\\\n  id: \\\\'\\\\',\\\\n  ruleName: \\\\'\\\\',\\\\n  ruleType: \\\\'\\\\',\\\\n  ruleConfig: {} as any,\\\\n  priority: 0,\\\\n  enabled: true\\\\n})\\\\n\\\\nconst ruleFormRules = {\\\\n  ruleName: [\\\\n    { required: true, message: \\\\'请输入规则名称\\\\', trigger: \\\\'blur\\\\' }\\\\n  ],\\\\n  ruleType: [\\\\n    { required: true, message: \\\\'请选择规则类型\\\\', trigger: \\\\'change\\\\' }\\\\n  ]\\\\n}\\\\n\\\\nconst executeForm = reactive({\\\\n  scope: \\\\'all\\\\',\\\\n  dateRange: null as [Date, Date] | null,\\\\n  ruleIds: [] as string[]\\\\n})\\\\n\\\\nconst cleaningResult = reactive<CleaningResult>({\\\\n  totalRecords: 0,\\\\n  cleanedRecords: 0,\\\\n  invalidRecords: 0,\\\\n  issues: []\\\\n})\\\\n\\\\nconst pagination = reactive({\\\\n  page: 1,\\\\n  size: 20,\\\\n  total: 0\\\\n})\\\\n\\\\nconst cleaningMetrics = ref([\\\\n  {\\\\n    key: \\\\'total\\\\',\\\\n    label: \\\\'规则总数\\\\',\\\\n    value: 12,\\\\n    icon: \\\\'Document\\\\',\\\\n    color: \\\\'#409EFF\\\\'\\\\n  },\\\\n  {\\\\n    key: \\\\'active\\\\',\\\\n    label: \\\\'启用规则\\\\',\\\\n    value: 8,\\\\n    icon: \\\\'SuccessFilled\\\\',\\\\n    color: \\\\'#67C23A\\\\'\\\\n  },\\\\n  {\\\\n    key: \\\\'executed\\\\',\\\\n    label: \\\\'今日执行\\\\',\\\\n    value: 45,\\\\n    icon: \\\\'Brush\\\\',\\\\n    color: \\\\'#67C23A\\\\'\\\\n  },\\\\n  {\\\\n    key: \\\\'issues\\\\',\\\\n    label: \\\\'发现问题\\\\',\\\\n    value: 156,\\\\n    icon: \\\\'WarningFilled\\\\',\\\\n    color: \\\\'#E6A23C\\\\'\\\\n  }\\\\n])\\\\n\\\\nconst cleaningRules = ref<CleaningRule[]>([])\\\\n\\\\nconst getRuleTypeText = (type: string) => {\\\\n  const typeMap: Record<string, string> = {\\\\n    format: \\\\'格式校验\\\\',\\\\n    duplicate: \\\\'重复数据\\\\',\\\\n    outlier: \\\\'异常值检测\\\\',\\\\n    completeness: \\\\'完整性检查\\\\',\\\\n    consistency: \\\\'一致性检查\\\\'\\\\n  }\\\\n  return typeMap[type] || type\\\\n}\\\\n\\\\nconst getRuleTypeTagType = (type: string) => {\\\\n  const typeMap: Record<string, any> = {\\\\n    format: \\\\'primary\\\\',\\\\n    duplicate: \\\\'success\\\\',\\\\n    outlier: \\\\'warning\\\\',\\\\n    completeness: \\\\'danger\\\\',\\\\n    consistency: \\\\'info\\\\'\\\\n  }\\\\n  return typeMap[type] || \\\\'\\\\'\\\\n}\\\\n\\\\nconst getIssueTypeText = (type: string) => {\\\\n  const typeMap: Record<string, string> = {\\\\n    format_error: \\\\'格式错误\\\\',\\\\n    duplicate: \\\\'重复数据\\\\',\\\\n    outlier: \\\\'异常值\\\\',\\\\n    missing: \\\\'数据缺失\\\\',\\\\n    inconsistency: \\\\'数据不一致\\\\'\\\\n  }\\\\n  return typeMap[type] || type\\\\n}\\\\n\\\\nconst getIssueTypeTagType = (type: string) => {\\\\n  const typeMap: Record<string, any> = {\\\\n    format_error: \\\\'danger\\\\',\\\\n    duplicate: \\\\'warning\\\\',\\\\n    outlier: \\\\'warning\\\\',\\\\n    missing: \\\\'danger\\\\',\\\\n    inconsistency: \\\\'info\\\\'\\\\n  }\\\\n  return typeMap[type] || \\\\'\\\\'\\\\n}\\\\n\\\\nconst formatRuleConfig = (config: object) => {\\\\n  return JSON.stringify(config, null, 2)\\\\n}\\\\n\\\\nconst formatDateTime = (dateTime?: string) => {\\\\n  if (!dateTime) return \\\\'-\\\\'\\\\n  return new Date(dateTime).toLocaleString(\\\\'zh-CN\\\\')\\\\n}\\\\n\\\\nconst loadRules = async () => {\\\\n  loading.value = true\\\\n  try {\\\\n    const response = await fetch(\\\\'/api/analytics/cleaning-rules\\\\', {\\\\n      method: \\\\'POST\\\\',\\\\n      headers: {\\\\n        \\\\'Content-Type\\\\': \\\\'application/json\\\\'\\\\n      },\\\\n      body: JSON.stringify({\\\\n        ...filters,\\\\n        page: pagination.page,\\\\n        size: pagination.size\\\\n      })\\\\n    })\\\\n    const data = await response.json()\\\\n    if (data.success) {\\\\n      cleaningRules.value = data.data.items\\\\n      pagination.total = data.data.total\\\\n    }\\\\n  } catch (error) {\\\\n    ElMessage.error(\\\\'加载规则失败\\\\')\\\\n  } finally {\\\\n    loading.value = false\\\\n  }\\\\n}\\\\n\\\\nconst refreshRules = () => {\\\\n  loadRules()\\\\n}\\\\n\\\\nconst resetFilters = () => {\\\\n  filters.ruleType = \\\\'\\\\'\\\\n  filters.enabled = \\\\'\\\\'\\\\n  pagination.page = 1\\\\n  loadRules()\\\\n}\\\\n\\\\nconst handleSizeChange = (size: number) => {\\\\n  pagination.size = size\\\\n  pagination.page = 1\\\\n  loadRules()\\\\n}\\\\n\\\\nconst handlePageChange = (page: number) => {\\\\n  pagination.page = page\\\\n  loadRules()\\\\n}\\\\n\\\\nconst handleToggleEnabled = async (row: CleaningRule) => {\\\\n  try {\\\\n    const response = await fetch(`/api/analytics/cleaning-rules/${row.id}`, {\\\\n      method: \\\\'PUT\\\\',\\\\n      headers: {\\\\n        \\\\'Content-Type\\\\': \\\\'application/json\\\\'\\\\n      },\\\\n      body: JSON.stringify({ enabled: row.enabled })\\\\n    })\\\\n    const data = await response.json()\\\\n    if (data.success) {\\\\n      ElMessage.success(row.enabled ? \\\\'规则已启用\\\\' : \\\\'规则已禁用\\\\')\\\\n    } else {\\\\n      row.enabled = !row.enabled\\\\n      ElMessage.error(\\\\'操作失败\\\\')\\\\n    }\\\\n  } catch (error) {\\\\n    row.enabled = !row.enabled\\\\n    ElMessage.error(\\\\'操作失败\\\\')\\\\n  }\\\\n}\\\\n\\\\nconst handleRuleTypeChange = () => {\\\\n  ruleForm.ruleConfig = {}\\\\n}\\\\n\\\\nconst handleTestRule = async (row: CleaningRule) => {\\\\n  try {\\\\n    ElMessage.info(\\\\'正在测试规则...\\\\')\\\\n    const response = await fetch(`/api/analytics/cleaning-rules/${row.id}/test`, {\\\\n      method: \\\\'POST\\\\'\\\\n    })\\\\n    const data = await response.json()\\\\n    if (data.success) {\\\\n      ElMessage.success(`规则测试成功，发现问题记录数：${data.data.issueCount}`)\\\\n    } else {\\\\n      ElMessage.error(\\\\'规则测试失败\\\\')\\\\n    }\\\\n  } catch (error) {\\\\n    ElMessage.error(\\\\'规则测试失败\\\\')\\\\n  }\\\\n}\\\\n\\\\nconst handleEdit = (row: CleaningRule) => {\\\\n  editingRule.value = row\\\\n  ruleForm.id = row.id\\\\n  ruleForm.ruleName = row.ruleName\\\\n  ruleForm.ruleType = row.ruleType\\\\n  ruleForm.ruleConfig = { ...row.ruleConfig }\\\\n  ruleForm.priority = row.priority\\\\n  ruleForm.enabled = row.enabled\\\\n  showAddDialog.value = true\\\\n}\\\\n\\\\nconst handleSaveRule = async () => {\\\\n  try {\\\\n    await ruleFormRef.value.validate()\\\\n    \\\\n    const payload = {\\\\n      ruleName: ruleForm.ruleName,\\\\n      ruleType: ruleForm.ruleType,\\\\n      ruleConfig: ruleForm.ruleConfig,\\\\n      priority: ruleForm.priority,\\\\n      enabled: ruleForm.enabled\\\\n    }\\\\n\\\\n    const url = editingRule.value \\\\n      ? `/api/analytics/cleaning-rules/${editingRule.value.id}`\\\\n      : \\\\'/api/analytics/cleaning-rules\\\\'\\\\n    \\\\n    const method = editingRule.value ? \\\\'PUT\\\\' : \\\\'POST\\\\'\\\\n    \\\\n    const response = await fetch(url, {\\\\n      method,\\\\n      headers: {\\\\n        \\\\'Content-Type\\\\': \\\\'application/json\\\\'\\\\n      },\\\\n      body: JSON.stringify(payload)\\\\n    })\\\\n    \\\\n    const data = await response.json()\\\\n    if (data.success) {\\\\n      ElMessage.success(editingRule.value ? \\\\'规则更新成功\\\\' : \\\\'规则创建成功\\\\')\\\\n      showAddDialog.value = false\\\\n      editingRule.value = null\\\\n      loadRules()\\\\n    } else {\\\\n      ElMessage.error(data.message || \\\\'操作失败\\\\')\\\\n    }\\\\n  } catch (error) {\\\\n    if (error !== false) {\\\\n      ElMessage.error(\\\\'操作失败\\\\')\\\\n    }\\\\n  }\\\\n}\\\\n\\\\nconst handleViewResults = async (row: CleaningRule) => {\\\\n  try {\\\\n    const response = await fetch(`/api/analytics/cleaning-rules/${row.id}/results`)\\\\n    const data = await response.json()\\\\n    if (data.success) {\\\\n      cleaningResult.totalRecords = data.data.totalRecords\\\\n      cleaningResult.cleanedRecords = data.data.cleanedRecords\\\\n      cleaningResult.invalidRecords = data.data.invalidRecords\\\\n      cleaningResult.issues = data.data.issues\\\\n      showResultsDialog.value = true\\\\n    }\\\\n  } catch (error) {\\\\n    ElMessage.error(\\\\'加载结果失败\\\\')\\\\n  }\\\\n}\\\\n\\\\nconst handleViewDetail = (issue: CleaningIssue) => {\\\\n  ElMessageBox.alert(\\\\n    JSON.stringify(issue.details, null, 2),\\\\n    \\\\'问题详情\\\\',\\\\n    {\\\\n      confirmButtonText: \\\\'确定\\\\',\\\\n      customClass: \\\\'detail-dialog\\\\'\\\\n    }\\\\n  )\\\\n}\\\\n\\\\nconst handleDelete = async (row: CleaningRule) => {\\\\n  try {\\\\n    await ElMessageBox.confirm(\\\\n      `确定要删除规则\\\\\\\"${row.ruleName}\\\\\\\"吗？`,\\\\n      \\\\'确认删除\\\\',\\\\n      {\\\\n        confirmButtonText: \\\\'确定\\\\',\\\\n        cancelButtonText: \\\\'取消\\\\',\\\\n        type: \\\\'warning\\\\'\\\\n      }\\\\n    )\\\\n    \\\\n    const response = await fetch(`/api/analytics/cleaning-rules/${row.id}`, {\\\\n      method: \\\\'DELETE\\\\'\\\\n    })\\\\n    const data = await response.json()\\\\n    if (data.success) {\\\\n      ElMessage.success(\\\\'规则删除成功\\\\')\\\\n      loadRules()\\\\n    } else {\\\\n      ElMessage.error(\\\\'删除失败\\\\')\\\\n    }\\\\n  } catch (error) {\\\\n    if (error !== \\\\'cancel\\\\') {\\\\n      ElMessage.error(\\\\'删除失败\\\\')\\\\n    }\\\\n  }\\\\n}\\\\n\\\\nconst executeCleaning = () => {\\\\n  showExecuteDialog.value = true\\\\n}\\\\n\\\\nconst handleExecuteCleaning = async () => {\\\\n  executing.value = true\\\\n  try {\\\\n    const payload: any = {\\\\n      scope: executeForm.scope\\\\n    }\\\\n    \\\\n    if (executeForm.scope === \\\\'date\\\\' && executeForm.dateRange) {\\\\n      payload.startDate = executeForm.dateRange[0].toISOString()\\\\n      payload.endDate = executeForm.dateRange[1].toISOString()\\\\n    }\\\\n    \\\\n    if (executeForm.ruleIds.length > 0) {\\\\n      payload.ruleIds = executeForm.ruleIds\\\\n    }\\\\n    \\\\n    const response = await fetch(\\\\'/api/analytics/cleaning/execute\\\\', {\\\\n      method: \\\\'POST\\\\',\\\\n      headers: {\\\\n        \\\\'Content-Type\\\\': \\\\'application/json\\\\'\\\\n      },\\\\n      body: JSON.stringify(payload)\\\\n    })\\\\n    \\\\n    const data = await response.json()\\\\n    if (data.success) {\\\\n      ElMessage.success(\\\\'数据清洗执行成功\\\\')\\\\n      cleaningResult.totalRecords = data.data.totalRecords\\\\n      cleaningResult.cleanedRecords = data.data.cleanedRecords\\\\n      cleaningResult.invalidRecords = data.data.invalidRecords\\\\n      cleaningResult.issues = data.data.issues\\\\n      showExecuteDialog.value = false\\\\n      showResultsDialog.value = true\\\\n    } else {\\\\n      ElMessage.error(data.message || \\\\'执行失败\\\\')\\\\n    }\\\\n  } catch (error) {\\\\n    ElMessage.error(\\\\'执行失败\\\\')\\\\n  } finally {\\\\n    executing.value = false\\\\n  }\\\\n}\\\\n\\\\nonMounted(() => {\\\\n  loadRules()\\\\n})\\\\n</script>\\\\n\\\\n<style scoped lang=\\\\\\\"scss\\\\\\\">\\\\n.data-cleaning-manager {\\\\n  .cleaning-card {\\\\n    .card-header {\\\\n      display: flex;\\\\n      justify-content: space-between;\\\\n      align-items: center;\\\\n    }\\\\n  }\\\\n\\\\n  .cleaning-overview {\\\\n    margin-bottom: 20px;\\\\n    \\\\n    .metric-item {\\\\n      display: flex;\\\\n      align-items: center;\\\\n      padding: 15px;\\\\n      background: #f5f7fa;\\\\n      border-radius: 8px;\\\\n      \\\\n      .metric-icon {\\\\n        width: 50px;\\\\n        height: 50px;\\\\n        border-radius: 8px;\\\\n        display: flex;\\\\n        align-items: center;\\\\n        justify-content: center;\\\\n        color: white;\\\\n        margin-right: 15px;\\\\n      }\\\\n      \\\\n      .metric-info {\\\\n        flex: 1;\\\\n        \\\\n        .metric-value {\\\\n          font-size: 24px;\\\\n          font-weight: bold;\\\\n          color: #303133;\\\\n          margin-bottom: 5px;\\\\n        }\\\\n        \\\\n        .metric-label {\\\\n          font-size: 14px;\\\\n          color: #606266;\\\\n        }\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  .cleaning-filters {\\\\n    margin-bottom: 20px;\\\\n    \\\\n    .filter-form {\\\\n      display: flex;\\\\n      flex-wrap: wrap;\\\\n      gap: 10px;\\\\n    }\\\\n  }\\\\n\\\\n  .rule-config {\\\\n    max-width: 400px;\\\\n    overflow: hidden;\\\\n    text-overflow: ellipsis;\\\\n    white-space: nowrap;\\\\n    display: inline-block;\\\\n  }\\\\n\\\\n  .rule-config-editor {\\\\n    .config-section {\\\\n      padding: 15px;\\\\n      background: #f5f7fa;\\\\n      border-radius: 8px;\\\\n      margin-bottom: 15px;\\\\n    }\\\\n  }\\\\n\\\\n  .pagination-container {\\\\n    margin-top: 20px;\\\\n    display: flex;\\\\n    justify-content: flex-end;\\\\n  }\\\\n}\\\\n</style>\\\\n\",\"originAcceptText\":\"<template>\\n  <div class=\\\"data-cleaning-manager\\\">\\n    <el-card class=\\\"cleaning-card\\\">\\n      <template #header>\\n        <div class=\\\"card-header\\\">\\n          <span>数据清洗规则管理</span>\\n          <el-button-group>\\n            <el-button size=\\\"small\\\" @click=\\\"refreshRules\\\">\\n              <el-icon><Refresh /></el-icon>\\n              刷新\\n            </el-button>\\n            <el-button type=\\\"primary\\\" size=\\\"small\\\" @click=\\\"showAddDialog = true\\\">\\n              <el-icon><Plus /></el-icon>\\n              新建规则\\n            </el-button>\\n            <el-button size=\\\"small\\\" @click=\\\"executeCleaning\\\">\\n              <el-icon><PlayArrow /></el-icon>\\n              执行清洗\\n            </el-button>\\n          </el-button-group>\\n        </div>\\n      </template>\\n\\n      <div class=\\\"cleaning-overview\\\">\\n        <el-row :gutter=\\\"20\\\">\\n          <el-col :span=\\\"6\\\" v-for=\\\"metric in cleaningMetrics\\\" :key=\\\"metric.key\\\">\\n            <div class=\\\"metric-item\\\">\\n              <div class=\\\"metric-icon\\\" :style=\\\"{ backgroundColor: metric.color }\\\">\\n                <el-icon :size=\\\"24\\\">\\n                  <component :is=\\\"metric.icon\\\" />\\n                </el-icon>\\n              </div>\\n              <div class=\\\"metric-info\\\">\\n                <div class=\\\"metric-value\\\">{{ metric.value }}</div>\\n                <div class=\\\"metric-label\\\">{{ metric.label }}</div>\\n              </div>\\n            </div>\\n          </el-col>\\n        </el-row>\\n      </div>\\n\\n      <div class=\\\"cleaning-filters\\\">\\n        <el-form :inline=\\\"true\\\" :model=\\\"filters\\\" class=\\\"filter-form\\\">\\n          <el-form-item label=\\\"规则类型\\\">\\n            <el-select v-model=\\\"filters.ruleType\\\" placeholder=\\\"全部\\\" clearable>\\n              <el-option label=\\\"格式校验\\\" value=\\\"format\\\" />\\n              <el-option label=\\\"重复数据\\\" value=\\\"duplicate\\\" />\\n              <el-option label=\\\"异常值检测\\\" value=\\\"outlier\\\" />\\n              <el-option label=\\\"完整性检查\\\" value=\\\"completeness\\\" />\\n              <el-option label=\\\"一致性检查\\\" value=\\\"consistency\\\" />\\n            </el-select>\\n          </el-form-item>\\n          <el-form-item label=\\\"启用状态\\\">\\n            <el-select v-model=\\\"filters.enabled\\\" placeholder=\\\"全部\\\" clearable>\\n              <el-option label=\\\"启用\\\" :value=\\\"true\\\" />\\n              <el-option label=\\\"禁用\\\" :value=\\\"false\\\" />\\n            </el-select>\\n          </el-form-item>\\n          <el-form-item>\\n            <el-button type=\\\"primary\\\" @click=\\\"loadRules\\\">\\n              <el-icon><Search /></el-icon>\\n              查询\\n            </el-button>\\n            <el-button @click=\\\"resetFilters\\\">\\n              <el-icon><RefreshLeft /></el-icon>\\n              重置\\n            </el-button>\\n          </el-form-item>\\n        </el-form>\\n      </div>\\n\\n      <el-table :data=\\\"cleaningRules\\\" stripe v-loading=\\\"loading\\\">\\n        <el-table-column type=\\\"index\\\" label=\\\"序号\\\" width=\\\"80\\\" />\\n        <el-table-column prop=\\\"ruleName\\\" label=\\\"规则名称\\\" min-width=\\\"150\\\" />\\n        <el-table-column label=\\\"规则类型\\\" width=\\\"120\\\">\\n          <template #default=\\\"{ row }\\\">\\n            <el-tag :type=\\\"getRuleTypeTagType(row.ruleType)\\\" size=\\\"small\\\">\\n              {{ getRuleTypeText(row.ruleType) }}\\n            </el-tag>\\n          </template>\\n        </el-table-column>\\n        <el-table-column label=\\\"规则配置\\\" min-width=\\\"200\\\">\\n          <template #default=\\\"{ row }\\\">\\n            <el-tooltip :content=\\\"formatRuleConfig(row.ruleConfig)\\\" placement=\\\"top\\\">\\n              <span class=\\\"rule-config\\\">{{ formatRuleConfig(row.ruleConfig) }}</span>\\n            </el-tooltip>\\n          </template>\\n        </el-table-column>\\n        <el-table-column prop=\\\"priority\\\" label=\\\"优先级\\\" width=\\\"100\\\" sortable />\\n        <el-table-column label=\\\"启用状态\\\" width=\\\"100\\\">\\n          <template #default=\\\"{ row }\\\">\\n            <el-switch\\n              v-model=\\\"row.enabled\\\"\\n              @change=\\\"handleToggleEnabled(row)\\\"\\n            />\\n          </template>\\n        </el-table-column>\\n        <el-table-column label=\\\"执行次数\\\" width=\\\"100\\\">\\n          <template #default=\\\"{ row }\\\">\\n            {{ row.executionCount || 0 }}\\n          </template>\\n        </el-table-column>\\n        <el-table-column label=\\\"最后执行\\\" width=\\\"180\\\">\\n          <template #default=\\\"{ row }\\\">\\n            {{ formatDateTime(row.lastExecutedAt) }}\\n          </template>\\n        </el-table-column>\\n        <el-table-column label=\\\"操作\\\" width=\\\"200\\\" fixed=\\\"right\\\">\\n          <template #default=\\\"{ row }\\\">\\n            <el-button size=\\\"small\\\" text type=\\\"primary\\\" @click=\\\"handleTestRule(row)\\\">\\n              测试\\n            </el-button>\\n            <el-button size=\\\"small\\\" text type=\\\"primary\\\" @click=\\\"handleEdit(row)\\\">\\n              编辑\\n            </el-button>\\n            <el-button size=\\\"small\\\" text type=\\\"primary\\\" @click=\\\"handleViewResults(row)\\\">\\n              结果\\n            </el-button>\\n            <el-button size=\\\"small\\\" text type=\\\"danger\\\" @click=\\\"handleDelete(row)\\\">\\n              删除\\n            </el-button>\\n          </template>\\n        </el-table-column>\\n      </el-table>\\n\\n      <div class=\\\"pagination-container\\\">\\n        <el-pagination\\n          v-model:current-page=\\\"pagination.page\\\"\\n          v-model:page-size=\\\"pagination.size\\\"\\n          :page-sizes=\\\"[10, 20, 50, 100]\\\"\\n          :total=\\\"pagination.total\\\"\\n          layout=\\\"total, sizes, prev, pager, next, jumper\\\"\\n          @size-change=\\\"handleSizeChange\\\"\\n          @current-change=\\\"handlePageChange\\\"\\n        />\\n      </div>\\n    </el-card>\\n\\n    <el-dialog v-model=\\\"showAddDialog\\\" :title=\\\"editingRule ? '编辑规则' : '新建规则'\\\" width=\\\"70%\\\">\\n      <el-form :model=\\\"ruleForm\\\" :rules=\\\"ruleFormRules\\\" ref=\\\"ruleFormRef\\\" label-width=\\\"120px\\\">\\n        <el-form-item label=\\\"规则名称\\\" prop=\\\"ruleName\\\">\\n          <el-input v-model=\\\"ruleForm.ruleName\\\" placeholder=\\\"请输入规则名称\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"规则类型\\\" prop=\\\"ruleType\\\">\\n          <el-select v-model=\\\"ruleForm.ruleType\\\" placeholder=\\\"请选择规则类型\\\" @change=\\\"handleRuleTypeChange\\\">\\n            <el-option label=\\\"格式校验\\\" value=\\\"format\\\" />\\n            <el-option label=\\\"重复数据\\\" value=\\\"duplicate\\\" />\\n            <el-option label=\\\"异常值检测\\\" value=\\\"outlier\\\" />\\n            <el-option label=\\\"完整性检查\\\" value=\\\"completeness\\\" />\\n            <el-option label=\\\"一致性检查\\\" value=\\\"consistency\\\" />\\n          </el-select>\\n        </el-form-item>\\n        \\n        <el-form-item label=\\\"规则配置\\\" prop=\\\"ruleConfig\\\">\\n          <div class=\\\"rule-config-editor\\\">\\n            <div v-if=\\\"ruleForm.ruleType === 'format'\\\" class=\\\"config-section\\\">\\n              <el-form-item label=\\\"数据表\\\">\\n                <el-input v-model=\\\"ruleForm.ruleConfig.table\\\" placeholder=\\\"请输入数据表名\\\" />\\n              </el-form-item>\\n              <el-form-item label=\\\"字段\\\">\\n                <el-select v-model=\\\"ruleForm.ruleConfig.field\\\" multiple placeholder=\\\"请选择字段\\\">\\n                  <el-option label=\\\"订单号\\\" value=\\\"order_number\\\" />\\n                  <el-option label=\\\"手机号\\\" value=\\\"phone\\\" />\\n                  <el-option label=\\\"邮箱\\\" value=\\\"email\\\" />\\n                  <el-option label=\\\"日期\\\" value=\\\"date\\\" />\\n                  <el-option label=\\\"金额\\\" value=\\\"amount\\\" />\\n                </el-select>\\n              </el-form-item>\\n              <el-form-item label=\\\"格式规则\\\">\\n                <el-select v-model=\\\"ruleForm.ruleConfig.format\\\" placeholder=\\\"请选择格式规则\\\">\\n                  <el-option label=\\\"手机号格式\\\" value=\\\"phone\\\" />\\n                  <el-option label=\\\"邮箱格式\\\" value=\\\"email\\\" />\\n                  <el-option label=\\\"日期格式\\\" value=\\\"date\\\" />\\n                  <el-option label=\\\"数字格式\\\" value=\\\"number\\\" />\\n                </el-select>\\n              </el-form-item>\\n            </div>\\n\\n            <div v-else-if=\\\"ruleForm.ruleType === 'duplicate'\\\" class=\\\"config-section\\\">\\n              <el-form-item label=\\\"数据表\\\">\\n                <el-input v-model=\\\"ruleForm.ruleConfig.table\\\" placeholder=\\\"请输入数据表名\\\" />\\n              </el-form-item>\\n              <el-form-item label=\\\"去重字段\\\">\\n                <el-select v-model=\\\"ruleForm.ruleConfig.fields\\\" multiple placeholder=\\\"请选择去重字段\\\">\\n                  <el-option label=\\\"订单号\\\" value=\\\"order_number\\\" />\\n                  <el-option label=\\\"客户ID\\\" value=\\\"customer_id\\\" />\\n                  <el-option label=\\\"菜品ID\\\" value=\\\"dish_id\\\" />\\n                </el-select>\\n              </el-form-item>\\n              <el-form-item label=\\\"保留策略\\\">\\n                <el-radio-group v-model=\\\"ruleForm.ruleConfig.strategy\\\">\\n                  <el-radio label=\\\"first\\\">保留第一条</el-radio>\\n                  <el-radio label=\\\"last\\\">保留最后一条</el-radio>\\n                  <el-radio label=\\\"latest\\\">保留最新的一条</el-radio>\\n                </el-radio-group>\\n              </el-form-item>\\n            </div>\\n\\n            <div v-else-if=\\\"ruleForm.ruleType === 'outlier'\\\" class=\\\"config-section\\\">\\n              <el-form-item label=\\\"数据表\\\">\\n                <el-input v-model=\\\"ruleForm.ruleConfig.table\\\" placeholder=\\\"请输入数据表名\\\" />\\n              </el-form-item>\\n              <el-form-item label=\\\"检测字段\\\">\\n                <el-select v-model=\\\"ruleForm.ruleConfig.field\\\" placeholder=\\\"请选择检测字段\\\">\\n                  <el-option label=\\\"订单金额\\\" value=\\\"order_amount\\\" />\\n                  <el-option label=\\\"菜品价格\\\" value=\\\"dish_price\\\" />\\n                  <el-option label=\\\"客户消费\\\" value=\\\"customer_spent\\\" />\\n                </el-select>\\n              </el-form-item>\\n              <el-form-item label=\\\"检测方法\\\">\\n                <el-select v-model=\\\"ruleForm.ruleConfig.method\\\" placeholder=\\\"请选择检测方法\\\">\\n                  <el-option label=\\\"标准差法\\\" value=\\\"std\\\" />\\n                  <el-option label=\\\"四分位距法\\\" value=\\\"iqr\\\" />\\n                  <el-option label=\\\"Z-Score法\\\" value=\\\"zscore\\\" />\\n                </el-select>\\n              </el-form-item>\\n              <el-form-item label=\\\"阈值倍数\\\">\\n                <el-input-number v-model=\\\"ruleForm.ruleConfig.threshold\\\" :min=\\\"1\\\" :max=\\\"5\\\" :step=\\\"0.5\\\" />\\n              </el-form-item>\\n            </div>\\n\\n            <div v-else-if=\\\"ruleForm.ruleType === 'completeness'\\\" class=\\\"config-section\\\">\\n              <el-form-item label=\\\"数据表\\\">\\n                <el-input v-model=\\\"ruleForm.ruleConfig.table\\\" placeholder=\\\"请输入数据表名\\\" />\\n              </el-form-item>\\n              <el-form-item label=\\\"必填字段\\\">\\n                <el-select v-model=\\\"ruleForm.ruleConfig.fields\\\" multiple placeholder=\\\"请选择必填字段\\\">\\n                  <el-option label=\\\"订单号\\\" value=\\\"order_number\\\" />\\n                  <el-option label=\\\"客户ID\\\" value=\\\"customer_id\\\" />\\n                  <el-option label=\\\"菜品ID\\\" value=\\\"dish_id\\\" />\\n                  <el-option label=\\\"金额\\\" value=\\\"amount\\\" />\\n                </el-select>\\n              </el-form-item>\\n              <el-form-item label=\\\"缺失处理\\\">\\n                <el-radio-group v-model=\\\"ruleForm.ruleConfig.action\\\">\\n                  <el-radio label=\\\"delete\\\">删除记录</el-radio>\\n                  <el-radio label=\\\"fill\\\">填充默认值</el-radio>\\n                  <el-radio label=\\\"mark\\\">标记异常</el-radio>\\n                </el-radio-group>\\n              </el-form-item>\\n            </div>\\n\\n            <div v-else-if=\\\"ruleForm.ruleType === 'consistency'\\\" class=\\\"config-section\\\">\\n              <el-form-item label=\\\"数据表\\\">\\n                <el-input v-model=\\\"ruleForm.ruleConfig.table\\\" placeholder=\\\"请输入数据表名\\\" />\\n              </el-form-item>\\n              <el-form-item label=\\\"检查规则\\\">\\n                <el-input\\n                  v-model=\\\"ruleForm.ruleConfig.sql\\\"\\n                  type=\\\"textarea\\\"\\n                  :rows=\\\"4\\\"\\n                  placeholder=\\\"请输入SQL检查规则，例如：SELECT * FROM orders WHERE order_amount < 0\\\"\\n                />\\n              </el-form-item>\\n            </div>\\n          </div>\\n        </el-form-item>\\n\\n        <el-form-item label=\\\"优先级\\\" prop=\\\"priority\\\">\\n          <el-input-number v-model=\\\"ruleForm.priority\\\" :min=\\\"0\\\" :max=\\\"100\\\" />\\n        </el-form-item>\\n\\n        <el-form-item label=\\\"启用状态\\\">\\n          <el-switch v-model=\\\"ruleForm.enabled\\\" />\\n        </el-form-item>\\n      </el-form>\\n\\n      <template #footer>\\n        <span class=\\\"dialog-footer\\\">\\n          <el-button @click=\\\"showAddDialog = false\\\">取消</el-button>\\n          <el-button type=\\\"primary\\\" @click=\\\"handleSaveRule\\\">保存</el-button>\\n        </span>\\n      </template>\\n    </el-dialog>\\n\\n    <el-dialog v-model=\\\"showExecuteDialog\\\" title=\\\"执行数据清洗\\\" width=\\\"60%\\\">\\n      <el-form :model=\\\"executeForm\\\" label-width=\\\"120px\\\">\\n        <el-form-item label=\\\"执行范围\\\">\\n          <el-radio-group v-model=\\\"executeForm.scope\\\">\\n            <el-radio label=\\\"all\\\">全部数据</el-radio>\\n            <el-radio label=\\\"date\\\">指定日期范围</el-radio>\\n          </el-radio-group>\\n        </el-form-item>\\n        <el-form-item label=\\\"日期范围\\\" v-if=\\\"executeForm.scope === 'date'\\\">\\n          <el-date-picker\\n            v-model=\\\"executeForm.dateRange\\\"\\n            type=\\\"daterange\\\"\\n            range-separator=\\\"至\\\"\\n            start-placeholder=\\\"开始日期\\\"\\n            end-placeholder=\\\"结束日期\\\"\\n          />\\n        </el-form-item>\\n        <el-form-item label=\\\"选择规则\\\">\\n          <el-select v-model=\\\"executeForm.ruleIds\\\" multiple placeholder=\\\"选择要执行的规则（默认全部）\\\">\\n            <el-option\\n              v-for=\\\"rule in cleaningRules\\\"\\n              :key=\\\"rule.id\\\"\\n              :label=\\\"rule.ruleName\\\"\\n              :value=\\\"rule.id\\\"\\n            />\\n          </el-select>\\n        </el-form-item>\\n      </el-form>\\n\\n      <template #footer>\\n        <span class=\\\"dialog-footer\\\">\\n          <el-button @click=\\\"showExecuteDialog = false\\\">取消</el-button>\\n          <el-button type=\\\"primary\\\" @click=\\\"handleExecuteCleaning\\\" :loading=\\\"executing\\\">\\n            执行清洗\\n          </el-button>\\n        </span>\\n      </template>\\n    </el-dialog>\\n\\n    <el-dialog v-model=\\\"showResultsDialog\\\" title=\\\"清洗结果\\\" width=\\\"80%\\\">\\n      <el-alert\\n        :title=\\\"`清洗完成，共处理 ${cleaningResult.totalRecords} 条记录`\\\"\\n        type=\\\"success\\\"\\n        :closable=\\\"false\\\"\\n        style=\\\"margin-bottom: 20px;\\\"\\n      />\\n\\n      <el-table :data=\\\"cleaningResult.issues\\\" stripe max-height=\\\"500\\\">\\n        <el-table-column prop=\\\"ruleName\\\" label=\\\"规则名称\\\" width=\\\"150\\\" />\\n        <el-table-column prop=\\\"issueType\\\" label=\\\"问题类型\\\" width=\\\"120\\\">\\n          <template #default=\\\"{ row }\\\">\\n            <el-tag :type=\\\"getIssueTypeTagType(row.issueType)\\\" size=\\\"small\\\">\\n              {{ getIssueTypeText(row.issueType) }}\\n            </el-tag>\\n          </template>\\n        </el-table-column>\\n        <el-table-column prop=\\\"recordCount\\\" label=\\\"问题记录数\\\" width=\\\"120\\\" />\\n        <el-table-column prop=\\\"description\\\" label=\\\"问题描述\\\" min-width=\\\"200\\\" />\\n        <el-table-column prop=\\\"action\\\" label=\\\"处理动作\\\" width=\\\"120\\\" />\\n        <el-table-column label=\\\"操作\\\" width=\\\"120\\\">\\n          <template #default=\\\"{ row }\\\">\\n            <el-button size=\\\"small\\\" text type=\\\"primary\\\" @click=\\\"handleViewDetail(row)\\\">\\n              查看详情\\n            </el-button>\\n          </template>\\n        </el-table-column>\\n      </el-table>\\n    </el-dialog>\\n  </div>\\n</template>\\n\\n<script setup lang=\\\"ts\\\">\\nimport { ref, reactive, onMounted } from 'vue'\\nimport { ElMessage, ElMessageBox } from 'element-plus'\\nimport {\\n  Refresh,\\n  Plus,\\n  Search,\\n  RefreshLeft,\\n  PlayArrow,\\n  Document,\\n  Brush,\\n  SuccessFilled,\\n  WarningFilled,\\n  CircleCloseFilled\\n} from '@element-plus/icons-vue'\\n\\ninterface CleaningRule {\\n  id: string\\n  ruleName: string\\n  ruleType: string\\n  ruleConfig: object\\n  priority: number\\n  enabled: boolean\\n  executionCount?: number\\n  lastExecutedAt?: string\\n  tenantId: string\\n  createdAt: string\\n  updatedAt: string\\n}\\n\\ninterface CleaningResult {\\n  totalRecords: number\\n  cleanedRecords: number\\n  invalidRecords: number\\n  issues: CleaningIssue[]\\n}\\n\\ninterface CleaningIssue {\\n  ruleName: string\\n  issueType: string\\n  recordCount: number\\n  description: string\\n  action: string\\n  details?: object\\n}\\n\\nconst loading = ref(false)\\nconst executing = ref(false)\\nconst showAddDialog = ref(false)\\nconst showExecuteDialog = ref(false)\\nconst showResultsDialog = ref(false)\\nconst editingRule = ref<CleaningRule | null>(null)\\nconst ruleFormRef = ref()\\n\\nconst filters = reactive({\\n  ruleType: '',\\n  enabled: ''\\n})\\n\\nconst ruleForm = reactive({\\n  id: '',\\n  ruleName: '',\\n  ruleType: '',\\n  ruleConfig: {} as any,\\n  priority: 0,\\n  enabled: true\\n})\\n\\nconst ruleFormRules = {\\n  ruleName: [\\n    { required: true, message: '请输入规则名称', trigger: 'blur' }\\n  ],\\n  ruleType: [\\n    { required: true, message: '请选择规则类型', trigger: 'change' }\\n  ]\\n}\\n\\nconst executeForm = reactive({\\n  scope: 'all',\\n  dateRange: null as [Date, Date] | null,\\n  ruleIds: [] as string[]\\n})\\n\\nconst cleaningResult = reactive<CleaningResult>({\\n  totalRecords: 0,\\n  cleanedRecords: 0,\\n  invalidRecords: 0,\\n  issues: []\\n})\\n\\nconst pagination = reactive({\\n  page: 1,\\n  size: 20,\\n  total: 0\\n})\\n\\nconst cleaningMetrics = ref([\\n  {\\n    key: 'total',\\n    label: '规则总数',\\n    value: 12,\\n    icon: 'Document',\\n    color: '#409EFF'\\n  },\\n  {\\n    key: 'active',\\n    label: '启用规则',\\n    value: 8,\\n    icon: 'SuccessFilled',\\n    color: '#67C23A'\\n  },\\n  {\\n    key: 'executed',\\n    label: '今日执行',\\n    value: 45,\\n    icon: 'Brush',\\n    color: '#67C23A'\\n  },\\n  {\\n    key: 'issues',\\n    label: '发现问题',\\n    value: 156,\\n    icon: 'WarningFilled',\\n    color: '#E6A23C'\\n  }\\n])\\n\\nconst cleaningRules = ref<CleaningRule[]>([])\\n\\nconst getRuleTypeText = (type: string) => {\\n  const typeMap: Record<string, string> = {\\n    format: '格式校验',\\n    duplicate: '重复数据',\\n    outlier: '异常值检测',\\n    completeness: '完整性检查',\\n    consistency: '一致性检查'\\n  }\\n  return typeMap[type] || type\\n}\\n\\nconst getRuleTypeTagType = (type: string) => {\\n  const typeMap: Record<string, any> = {\\n    format: 'primary',\\n    duplicate: 'success',\\n    outlier: 'warning',\\n    completeness: 'danger',\\n    consistency: 'info'\\n  }\\n  return typeMap[type] || ''\\n}\\n\\nconst getIssueTypeText = (type: string) => {\\n  const typeMap: Record<string, string> = {\\n    format_error: '格式错误',\\n    duplicate: '重复数据',\\n    outlier: '异常值',\\n    missing: '数据缺失',\\n    inconsistency: '数据不一致'\\n  }\\n  return typeMap[type] || type\\n}\\n\\nconst getIssueTypeTagType = (type: string) => {\\n  const typeMap: Record<string, any> = {\\n    format_error: 'danger',\\n    duplicate: 'warning',\\n    outlier: 'warning',\\n    missing: 'danger',\\n    inconsistency: 'info'\\n  }\\n  return typeMap[type] || ''\\n}\\n\\nconst formatRuleConfig = (config: object) => {\\n  return JSON.stringify(config, null, 2)\\n}\\n\\nconst formatDateTime = (dateTime?: string) => {\\n  if (!dateTime) return '-'\\n  return new Date(dateTime).toLocaleString('zh-CN')\\n}\\n\\nconst loadRules = async () => {\\n  loading.value = true\\n  try {\\n    const response = await fetch('/api/analytics/cleaning-rules', {\\n      method: 'POST',\\n      headers: {\\n        'Content-Type': 'application/json'\\n      },\\n      body: JSON.stringify({\\n        ...filters,\\n        page: pagination.page,\\n        size: pagination.size\\n      })\\n    })\\n    const data = await response.json()\\n    if (data.success) {\\n      cleaningRules.value = data.data.items\\n      pagination.total = data.data.total\\n    }\\n  } catch (error) {\\n    ElMessage.error('加载规则失败')\\n  } finally {\\n    loading.value = false\\n  }\\n}\\n\\nconst refreshRules = () => {\\n  loadRules()\\n}\\n\\nconst resetFilters = () => {\\n  filters.ruleType = ''\\n  filters.enabled = ''\\n  pagination.page = 1\\n  loadRules()\\n}\\n\\nconst handleSizeChange = (size: number) => {\\n  pagination.size = size\\n  pagination.page = 1\\n  loadRules()\\n}\\n\\nconst handlePageChange = (page: number) => {\\n  pagination.page = page\\n  loadRules()\\n}\\n\\nconst handleToggleEnabled = async (row: CleaningRule) => {\\n  try {\\n    const response = await fetch(`/api/analytics/cleaning-rules/${row.id}`, {\\n      method: 'PUT',\\n      headers: {\\n        'Content-Type': 'application/json'\\n      },\\n      body: JSON.stringify({ enabled: row.enabled })\\n    })\\n    const data = await response.json()\\n    if (data.success) {\\n      ElMessage.success(row.enabled ? '规则已启用' : '规则已禁用')\\n    } else {\\n      row.enabled = !row.enabled\\n      ElMessage.error('操作失败')\\n    }\\n  } catch (error) {\\n    row.enabled = !row.enabled\\n    ElMessage.error('操作失败')\\n  }\\n}\\n\\nconst handleRuleTypeChange = () => {\\n  ruleForm.ruleConfig = {}\\n}\\n\\nconst handleTestRule = async (row: CleaningRule) => {\\n  try {\\n    ElMessage.info('正在测试规则...')\\n    const response = await fetch(`/api/analytics/cleaning-rules/${row.id}/test`, {\\n      method: 'POST'\\n    })\\n    const data = await response.json()\\n    if (data.success) {\\n      ElMessage.success(`规则测试成功，发现问题记录数：${data.data.issueCount}`)\\n    } else {\\n      ElMessage.error('规则测试失败')\\n    }\\n  } catch (error) {\\n    ElMessage.error('规则测试失败')\\n  }\\n}\\n\\nconst handleEdit = (row: CleaningRule) => {\\n  editingRule.value = row\\n  ruleForm.id = row.id\\n  ruleForm.ruleName = row.ruleName\\n  ruleForm.ruleType = row.ruleType\\n  ruleForm.ruleConfig = { ...row.ruleConfig }\\n  ruleForm.priority = row.priority\\n  ruleForm.enabled = row.enabled\\n  showAddDialog.value = true\\n}\\n\\nconst handleSaveRule = async () => {\\n  try {\\n    await ruleFormRef.value.validate()\\n    \\n    const payload = {\\n      ruleName: ruleForm.ruleName,\\n      ruleType: ruleForm.ruleType,\\n      ruleConfig: ruleForm.ruleConfig,\\n      priority: ruleForm.priority,\\n      enabled: ruleForm.enabled\\n    }\\n\\n    const url = editingRule.value \\n      ? `/api/analytics/cleaning-rules/${editingRule.value.id}`\\n      : '/api/analytics/cleaning-rules'\\n    \\n    const method = editingRule.value ? 'PUT' : 'POST'\\n    \\n    const response = await fetch(url, {\\n      method,\\n      headers: {\\n        'Content-Type': 'application/json'\\n      },\\n      body: JSON.stringify(payload)\\n    })\\n    \\n    const data = await response.json()\\n    if (data.success) {\\n      ElMessage.success(editingRule.value ? '规则更新成功' : '规则创建成功')\\n      showAddDialog.value = false\\n      editingRule.value = null\\n      loadRules()\\n    } else {\\n      ElMessage.error(data.message || '操作失败')\\n    }\\n  } catch (error) {\\n    if (error !== false) {\\n      ElMessage.error('操作失败')\\n    }\\n  }\\n}\\n\\nconst handleViewResults = async (row: CleaningRule) => {\\n  try {\\n    const response = await fetch(`/api/analytics/cleaning-rules/${row.id}/results`)\\n    const data = await response.json()\\n    if (data.success) {\\n      cleaningResult.totalRecords = data.data.totalRecords\\n      cleaningResult.cleanedRecords = data.data.cleanedRecords\\n      cleaningResult.invalidRecords = data.data.invalidRecords\\n      cleaningResult.issues = data.data.issues\\n      showResultsDialog.value = true\\n    }\\n  } catch (error) {\\n    ElMessage.error('加载结果失败')\\n  }\\n}\\n\\nconst handleViewDetail = (issue: CleaningIssue) => {\\n  ElMessageBox.alert(\\n    JSON.stringify(issue.details, null, 2),\\n    '问题详情',\\n    {\\n      confirmButtonText: '确定',\\n      customClass: 'detail-dialog'\\n    }\\n  )\\n}\\n\\nconst handleDelete = async (row: CleaningRule) => {\\n  try {\\n    await ElMessageBox.confirm(\\n      `确定要删除规则\\\"${row.ruleName}\\\"吗？`,\\n      '确认删除',\\n      {\\n        confirmButtonText: '确定',\\n        cancelButtonText: '取消',\\n        type: 'warning'\\n      }\\n    )\\n    \\n    const response = await fetch(`/api/analytics/cleaning-rules/${row.id}`, {\\n      method: 'DELETE'\\n    })\\n    const data = await response.json()\\n    if (data.success) {\\n      ElMessage.success('规则删除成功')\\n      loadRules()\\n    } else {\\n      ElMessage.error('删除失败')\\n    }\\n  } catch (error) {\\n    if (error !== 'cancel') {\\n      ElMessage.error('删除失败')\\n    }\\n  }\\n}\\n\\nconst executeCleaning = () => {\\n  showExecuteDialog.value = true\\n}\\n\\nconst handleExecuteCleaning = async () => {\\n  executing.value = true\\n  try {\\n    const payload: any = {\\n      scope: executeForm.scope\\n    }\\n    \\n    if (executeForm.scope === 'date' && executeForm.dateRange) {\\n      payload.startDate = executeForm.dateRange[0].toISOString()\\n      payload.endDate = executeForm.dateRange[1].toISOString()\\n    }\\n    \\n    if (executeForm.ruleIds.length > 0) {\\n      payload.ruleIds = executeForm.ruleIds\\n    }\\n    \\n    const response = await fetch('/api/analytics/cleaning/execute', {\\n      method: 'POST',\\n      headers: {\\n        'Content-Type': 'application/json'\\n      },\\n      body: JSON.stringify(payload)\\n    })\\n    \\n    const data = await response.json()\\n    if (data.success) {\\n      ElMessage.success('数据清洗执行成功')\\n      cleaningResult.totalRecords = data.data.totalRecords\\n      cleaningResult.cleanedRecords = data.data.cleanedRecords\\n      cleaningResult.invalidRecords = data.data.invalidRecords\\n      cleaningResult.issues = data.data.issues\\n      showExecuteDialog.value = false\\n      showResultsDialog.value = true\\n    } else {\\n      ElMessage.error(data.message || '执行失败')\\n    }\\n  } catch (error) {\\n    ElMessage.error('执行失败')\\n  } finally {\\n    executing.value = false\\n  }\\n}\\n\\nonMounted(() => {\\n  loadRules()\\n})\\n</script>\\n\\n<style scoped lang=\\\"scss\\\">\\n.data-cleaning-manager {\\n  .cleaning-card {\\n    .card-header {\\n      display: flex;\\n      justify-content: space-between;\\n      align-items: center;\\n    }\\n  }\\n\\n  .cleaning-overview {\\n    margin-bottom: 20px;\\n    \\n    .metric-item {\\n      display: flex;\\n      align-items: center;\\n      padding: 15px;\\n      background: #f5f7fa;\\n      border-radius: 8px;\\n      \\n      .metric-icon {\\n        width: 50px;\\n        height: 50px;\\n        border-radius: 8px;\\n        display: flex;\\n        align-items: center;\\n        justify-content: center;\\n        color: white;\\n        margin-right: 15px;\\n      }\\n      \\n      .metric-info {\\n        flex: 1;\\n        \\n        .metric-value {\\n          font-size: 24px;\\n          font-weight: bold;\\n          color: #303133;\\n          margin-bottom: 5px;\\n        }\\n        \\n        .metric-label {\\n          font-size: 14px;\\n          color: #606266;\\n        }\\n      }\\n    }\\n  }\\n\\n  .cleaning-filters {\\n    margin-bottom: 20px;\\n    \\n    .filter-form {\\n      display: flex;\\n      flex-wrap: wrap;\\n      gap: 10px;\\n    }\\n  }\\n\\n  .rule-config {\\n    max-width: 400px;\\n    overflow: hidden;\\n    text-overflow: ellipsis;\\n    white-space: nowrap;\\n    display: inline-block;\\n  }\\n\\n  .rule-config-editor {\\n    .config-section {\\n      padding: 15px;\\n      background: #f5f7fa;\\n      border-radius: 8px;\\n      margin-bottom: 15px;\\n    }\\n  }\\n\\n  .pagination-container {\\n    margin-top: 20px;\\n    display: flex;\\n    justify-content: flex-end;\\n  }\\n}\\n</style>\\n\",\"originTextLength\":25492,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768858676930}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/components/analytics/SalesAnalytics.vue": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":801,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":801,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"<template>\\\\n  <div class=\\\\\\\"sales-analytics\\\\\\\">\\\\n    <div class=\\\\\\\"analytics-header\\\\\\\">\\\\n      <div class=\\\\\\\"header-title\\\\\\\">\\\\n        <h3>销售分析</h3>\\\\n        <p>深入了解销售趋势和收入表现</p>\\\\n      </div>\\\\n      <div class=\\\\\\\"header-actions\\\\\\\">\\\\n        <el-button-group>\\\\n          <el-button :type=\\\\\\\"viewMode === \\\\'overview\\\\' ? \\\\'primary\\\\' : \\\\'default\\\\'\\\\\\\" @click=\\\\\\\"viewMode = \\\\'overview\\\\'\\\\\\\">\\\\n            总览\\\\n          </el-button>\\\\n          <el-button :type=\\\\\\\"viewMode === \\\\'trends\\\\' ? \\\\'primary\\\\' : \\\\'default\\\\'\\\\\\\" @click=\\\\\\\"viewMode = \\\\'trends\\\\'\\\\\\\">\\\\n            趋势\\\\n          </el-button>\\\\n          <el-button :type=\\\\\\\"viewMode === \\\\'products\\\\' ? \\\\'primary\\\\' : \\\\'default\\\\'\\\\\\\" @click=\\\\\\\"viewMode = \\\\'products\\\\'\\\\\\\">\\\\n            商品\\\\n          </el-button>\\\\n          <el-button :type=\\\\\\\"viewMode === \\\\'forecast\\\\' ? \\\\'primary\\\\' : \\\\'default\\\\'\\\\\\\" @click=\\\\\\\"viewMode = \\\\'forecast\\\\'\\\\\\\">\\\\n            预测\\\\n          </el-button>\\\\n        </el-button-group>\\\\n      </div>\\\\n    </div>\\\\n\\\\n    <div class=\\\\\\\"analytics-content\\\\\\\">\\\\n      <div v-if=\\\\\\\"viewMode === \\\\'overview\\\\'\\\\\\\" class=\\\\\\\"overview-view\\\\\\\">\\\\n        <el-row :gutter=\\\\\\\"20\\\\\\\">\\\\n          <el-col :span=\\\\\\\"16\\\\\\\">\\\\n            <el-card title=\\\\\\\"销售收入趋势\\\\\\\">\\\\n              <div ref=\\\\\\\"revenueChart\\\\\\\" class=\\\\\\\"chart-container\\\\\\\"></div>\\\\n            </el-card>\\\\n          </el-col>\\\\n          <el-col :span=\\\\\\\"8\\\\\\\">\\\\n            <el-card title=\\\\\\\"销售分布\\\\\\\">\\\\n              <div ref=\\\\\\\"distributionChart\\\\\\\" class=\\\\\\\"chart-container\\\\\\\"></div>\\\\n            </el-card>\\\\n          </el-col>\\\\n        </el-row>\\\\n\\\\n        <el-row :gutter=\\\\\\\"20\\\\\\\" style=\\\\\\\"margin-top: 20px;\\\\\\\">\\\\n          <el-col :span=\\\\\\\"12\\\\\\\">\\\\n            <el-card title=\\\\\\\"按小时销售分析\\\\\\\">\\\\n              <div ref=\\\\\\\"hourlyChart\\\\\\\" class=\\\\\\\"chart-container\\\\\\\"></div>\\\\n            </el-card>\\\\n          </el-col>\\\\n          <el-col :span=\\\\\\\"12\\\\\\\">\\\\n            <el-card title=\\\\\\\"支付方式分布\\\\\\\">\\\\n              <div ref=\\\\\\\"paymentChart\\\\\\\" class=\\\\\\\"chart-container\\\\\\\"></div>\\\\n            </el-card>\\\\n          </el-col>\\\\n        </el-row>\\\\n      </div>\\\\n\\\\n      <div v-else-if=\\\\\\\"viewMode === \\\\'trends\\\\'\\\\\\\" class=\\\\\\\"trends-view\\\\\\\">\\\\n        <el-row :gutter=\\\\\\\"20\\\\\\\">\\\\n          <el-col :span=\\\\\\\"24\\\\\\\">\\\\n            <el-card title=\\\\\\\"销售趋势分析\\\\\\\">\\\\n              <div class=\\\\\\\"trend-controls\\\\\\\">\\\\n                <el-radio-group v-model=\\\\\\\"trendGranularity\\\\\\\" @change=\\\\\\\"loadTrendData\\\\\\\">\\\\n                  <el-radio-button label=\\\\\\\"day\\\\\\\">日趋势</el-radio-button>\\\\n                  <el-radio-button label=\\\\\\\"week\\\\\\\">周趋势</el-radio-button>\\\\n                  <el-radio-button label=\\\\\\\"month\\\\\\\">月趋势</el-radio-button>\\\\n                </el-radio-group>\\\\n              </div>\\\\n              <div ref=\\\\\\\"trendsChart\\\\\\\" class=\\\\\\\"large-chart-container\\\\\\\"></div>\\\\n            </el-card>\\\\n          </el-col>\\\\n        </el-row>\\\\n\\\\n        <el-row :gutter=\\\\\\\"20\\\\\\\" style=\\\\\\\"margin-top: 20px;\\\\\\\">\\\\n          <el-col :span=\\\\\\\"12\\\\\\\">\\\\n            <el-card title=\\\\\\\"同比增长分析\\\\\\\">\\\\n              <div ref=\\\\\\\"yoyChart\\\\\\\" class=\\\\\\\"chart-container\\\\\\\"></div>\\\\n            </el-card>\\\\n          </el-col>\\\\n          <el-col :span=\\\\\\\"12\\\\\\\">\\\\n            <el-card title=\\\\\\\"环比增长分析\\\\\\\">\\\\n              <div ref=\\\\\\\"momChart\\\\\\\" class=\\\\\\\"chart-container\\\\\\\"></div>\\\\n            </el-card>\\\\n          </el-col>\\\\n        </el-row>\\\\n      </div>\\\\n\\\\n      <div v-else-if=\\\\\\\"viewMode === \\\\'products\\\\'\\\\\\\" class=\\\\\\\"products-view\\\\\\\">\\\\n        <el-row :gutter=\\\\\\\"20\\\\\\\">\\\\n          <el-col :span=\\\\\\\"16\\\\\\\">\\\\n            <el-card title=\\\\\\\"热销商品排行\\\\\\\">\\\\n              <el-table :data=\\\\\\\"topProducts\\\\\\\" style=\\\\\\\"width: 100%\\\\\\\" v-loading=\\\\\\\"loading\\\\\\\">\\\\n                <el-table-column type=\\\\\\\"index\\\\\\\" label=\\\\\\\"排名\\\\\\\" width=\\\\\\\"80\\\\\\\" />\\\\n                <el-table-column prop=\\\\\\\"itemName\\\\\\\" label=\\\\\\\"商品名称\\\\\\\" />\\\\n                <el-table-column prop=\\\\\\\"categoryName\\\\\\\" label=\\\\\\\"类别\\\\\\\" width=\\\\\\\"120\\\\\\\" />\\\\n                <el-table-column prop=\\\\\\\"quantity\\\\\\\" label=\\\\\\\"销量\\\\\\\" width=\\\\\\\"100\\\\\\\" sortable />\\\\n                <el-table-column prop=\\\\\\\"revenue\\\\\\\" label=\\\\\\\"收入\\\\\\\" width=\\\\\\\"120\\\\\\\" sortable>\\\\n                  <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                    ¥{{ row.revenue.toLocaleString() }}\\\\n                  </template>\\\\n                </el-table-column>\\\\n                <el-table-column prop=\\\\\\\"profit\\\\\\\" label=\\\\\\\"利润\\\\\\\" width=\\\\\\\"120\\\\\\\" sortable>\\\\n                  <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                    ¥{{ row.profit.toLocaleString() }}\\\\n                  </template>\\\\n                </el-table-column>\\\\n                <el-table-column prop=\\\\\\\"growth\\\\\\\" label=\\\\\\\"增长率\\\\\\\" width=\\\\\\\"100\\\\\\\" sortable>\\\\n                  <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                    <span :class=\\\\\\\"row.growth >= 0 ? \\\\'text-success\\\\' : \\\\'text-danger\\\\'\\\\\\\">\\\\n                      {{ row.growth >= 0 ? \\\\'+\\\\' : \\\\'\\\\' }}{{ row.growth }}%\\\\n                    </span>\\\\n                  </template>\\\\n                </el-table-column>\\\\n              </el-table>\\\\n            </el-card>\\\\n          </el-col>\\\\n          <el-col :span=\\\\\\\"8\\\\\\\">\\\\n            <el-card title=\\\\\\\"类别销售对比\\\\\\\">\\\\n              <div ref=\\\\\\\"categoryChart\\\\\\\" class=\\\\\\\"chart-container\\\\\\\"></div>\\\\n            </el-card>\\\\n          </el-col>\\\\n        </el-row>\\\\n\\\\n        <el-row :gutter=\\\\\\\"20\\\\\\\" style=\\\\\\\"margin-top: 20px;\\\\\\\">\\\\n          <el-col :span=\\\\\\\"24\\\\\\\">\\\\n            <el-card title=\\\\\\\"商品关联分析\\\\\\\">\\\\n              <div ref=\\\\\\\"associationChart\\\\\\\" class=\\\\\\\"large-chart-container\\\\\\\"></div>\\\\n            </el-card>\\\\n          </el-col>\\\\n        </el-row>\\\\n      </div>\\\\n\\\\n      <div v-else-if=\\\\\\\"viewMode === \\\\'forecast\\\\'\\\\\\\" class=\\\\\\\"forecast-view\\\\\\\">\\\\n        <el-row :gutter=\\\\\\\"20\\\\\\\">\\\\n          <el-col :span=\\\\\\\"24\\\\\\\">\\\\n            <el-card title=\\\\\\\"销售预测\\\\\\\">\\\\n              <div class=\\\\\\\"forecast-controls\\\\\\\">\\\\n                <el-form :inline=\\\\\\\"true\\\\\\\">\\\\n                  <el-form-item label=\\\\\\\"预测周期\\\\\\\">\\\\n                    <el-select v-model=\\\\\\\"forecastDays\\\\\\\" @change=\\\\\\\"loadForecastData\\\\\\\">\\\\n                      <el-option label=\\\\\\\"7天\\\\\\\" :value=\\\\\\\"7\\\\\\\" />\\\\n                      <el-option label=\\\\\\\"15天\\\\\\\" :value=\\\\\\\"15\\\\\\\" />\\\\n                      <el-option label=\\\\\\\"30天\\\\\\\" :value=\\\\\\\"30\\\\\\\" />\\\\n                      <el-option label=\\\\\\\"60天\\\\\\\" :value=\\\\\\\"60\\\\\\\" />\\\\n                      <el-option label=\\\\\\\"90天\\\\\\\" :value=\\\\\\\"90\\\\\\\" />\\\\n                    </el-select>\\\\n                  </el-form-item>\\\\n                  <el-form-item label=\\\\\\\"预测模型\\\\\\\">\\\\n                    <el-select v-model=\\\\\\\"forecastModel\\\\\\\" @change=\\\\\\\"loadForecastData\\\\\\\">\\\\n                      <el-option label=\\\\\\\"ARIMA\\\\\\\" value=\\\\\\\"arima\\\\\\\" />\\\\n                      <el-option label=\\\\\\\"Prophet\\\\\\\" value=\\\\\\\"prophet\\\\\\\" />\\\\n                      <el-option label=\\\\\\\"LSTM\\\\\\\" value=\\\\\\\"lstm\\\\\\\" />\\\\n                      <el-option label=\\\\\\\"集成模型\\\\\\\" value=\\\\\\\"ensemble\\\\\\\" />\\\\n                    </el-select>\\\\n                  </el-form-item>\\\\n                </el-form>\\\\n              </div>\\\\n              <div ref=\\\\\\\"forecastChart\\\\\\\" class=\\\\\\\"large-chart-container\\\\\\\"></div>\\\\n            </el-card>\\\\n          </el-col>\\\\n        </el-row>\\\\n\\\\n        <el-row :gutter=\\\\\\\"20\\\\\\\" style=\\\\\\\"margin-top: 20px;\\\\\\\">\\\\n          <el-col :span=\\\\\\\"12\\\\\\\">\\\\n            <el-card title=\\\\\\\"预测准确度\\\\\\\">\\\\n              <div class=\\\\\\\"accuracy-metrics\\\\\\\">\\\\n                <div class=\\\\\\\"metric-item\\\\\\\">\\\\n                  <div class=\\\\\\\"metric-label\\\\\\\">MAE (平均绝对误差)</div>\\\\n                  <div class=\\\\\\\"metric-value\\\\\\\">{{ forecastAccuracy.mae }}</div>\\\\n                </div>\\\\n                <div class=\\\\\\\"metric-item\\\\\\\">\\\\n                  <div class=\\\\\\\"metric-label\\\\\\\">RMSE (均方根误差)</div>\\\\n                  <div class=\\\\\\\"metric-value\\\\\\\">{{ forecastAccuracy.rmse }}</div>\\\\n                </div>\\\\n                <div class=\\\\\\\"metric-item\\\\\\\">\\\\n                  <div class=\\\\\\\"metric-label\\\\\\\">MAPE (平均绝对百分比误差)</div>\\\\n                  <div class=\\\\\\\"metric-value\\\\\\\">{{ forecastAccuracy.mape }}%</div>\\\\n                </div>\\\\n                <div class=\\\\\\\"metric-item\\\\\\\">\\\\n                  <div class=\\\\\\\"metric-label\\\\\\\">R² (决定系数)</div>\\\\n                  <div class=\\\\\\\"metric-value\\\\\\\">{{ forecastAccuracy.r2 }}</div>\\\\n                </div>\\\\n              </div>\\\\n            </el-card>\\\\n          </el-col>\\\\n          <el-col :span=\\\\\\\"12\\\\\\\">\\\\n            <el-card title=\\\\\\\"预测建议\\\\\\\">\\\\n              <div class=\\\\\\\"forecast-suggestions\\\\\\\">\\\\n                <el-alert\\\\n                  v-for=\\\\\\\"(suggestion, index) in forecastSuggestions\\\\\\\"\\\\n                  :key=\\\\\\\"index\\\\\\\"\\\\n                  :title=\\\\\\\"suggestion.title\\\\\\\"\\\\n                  :type=\\\\\\\"suggestion.type\\\\\\\"\\\\n                  :description=\\\\\\\"suggestion.description\\\\\\\"\\\\n                  :closable=\\\\\\\"false\\\\\\\"\\\\n                  style=\\\\\\\"margin-bottom: 10px;\\\\\\\"\\\\n                />\\\\n              </div>\\\\n            </el-card>\\\\n          </el-col>\\\\n        </el-row>\\\\n      </div>\\\\n    </div>\\\\n  </div>\\\\n</template>\\\\n\\\\n<script setup lang=\\\\\\\"ts\\\\\\\">\\\\nimport { ref, reactive, onMounted, nextTick, watch } from \\\\'vue\\\\'\\\\nimport { ElMessage } from \\\\'element-plus\\\\'\\\\nimport * as echarts from \\\\'echarts\\\\'\\\\n\\\\ninterface ProductSales {\\\\n  rank: number\\\\n  itemName: string\\\\n  categoryName: string\\\\n  quantity: number\\\\n  revenue: number\\\\n  profit: number\\\\n  growth: number\\\\n}\\\\n\\\\ninterface ForecastAccuracy {\\\\n  mae: number\\\\n  rmse: number\\\\n  mape: number\\\\n  r2: number\\\\n}\\\\n\\\\ninterface ForecastSuggestion {\\\\n  title: string\\\\n  type: \\\\'success\\\\' | \\\\'warning\\\\' | \\\\'info\\\\'\\\\n  description: string\\\\n}\\\\n\\\\nconst loading = ref(false)\\\\nconst viewMode = ref(\\\\'overview\\\\')\\\\nconst trendGranularity = ref(\\\\'day\\\\')\\\\nconst forecastDays = ref(30)\\\\nconst forecastModel = ref(\\\\'ensemble\\\\')\\\\n\\\\nconst revenueChart = ref()\\\\nconst distributionChart = ref()\\\\nconst hourlyChart = ref()\\\\nconst paymentChart = ref()\\\\nconst trendsChart = ref()\\\\nconst yoyChart = ref()\\\\nconst momChart = ref()\\\\nconst categoryChart = ref()\\\\nconst associationChart = ref()\\\\nconst forecastChart = ref()\\\\n\\\\nconst topProducts = ref<ProductSales[]>([])\\\\nconst forecastAccuracy = reactive<ForecastAccuracy>({\\\\n  mae: 1250,\\\\n  rmse: 1890,\\\\n  mape: 8.5,\\\\n  r2: 0.92\\\\n})\\\\n\\\\nconst forecastSuggestions = ref<ForecastSuggestion[]>([\\\\n  {\\\\n    title: \\\\'预计下周销量增长15%\\\\',\\\\n    type: \\\\'success\\\\',\\\\n    description: \\\\'基于历史数据和当前趋势，建议增加库存准备\\\\'\\\\n  },\\\\n  {\\\\n    title: \\\\'热销商品库存预警\\\\',\\\\n    type: \\\\'warning\\\\',\\\\n    description: \\\\'红烧肉套餐预计3天后库存不足，建议提前补货\\\\'\\\\n  },\\\\n  {\\\\n    title: \\\\'新菜品推广建议\\\\',\\\\n    type: \\\\'info\\\\',\\\\n    description: \\\\'根据客户偏好分析，建议推出春季特色菜品\\\\'\\\\n  }\\\\n])\\\\n\\\\nconst initRevenueChart = () => {\\\\n  if (!revenueChart.value) return\\\\n  \\\\n  const chart = echarts.init(revenueChart.value)\\\\n  const option = {\\\\n    tooltip: {\\\\n      trigger: \\\\'axis\\\\',\\\\n      formatter: (params: any) => {\\\\n        let result = params[0].axisValue + \\\\'<br/>\\\\'\\\\n        params.forEach((item: any) => {\\\\n          result += `${item.marker}${item.seriesName}: ¥${item.value.toLocaleString()}<br/>`\\\\n        })\\\\n        return result\\\\n      }\\\\n    },\\\\n    legend: {\\\\n      data: [\\\\'收入\\\\', \\\\'利润\\\\']\\\\n    },\\\\n    grid: {\\\\n      left: \\\\'3%\\\\',\\\\n      right: \\\\'4%\\\\',\\\\n      bottom: \\\\'3%\\\\',\\\\n      containLabel: true\\\\n    },\\\\n    xAxis: {\\\\n      type: \\\\'category\\\\',\\\\n      data: [\\\\'周一\\\\', \\\\'周二\\\\', \\\\'周三\\\\', \\\\'周四\\\\', \\\\'周五\\\\', \\\\'周六\\\\', \\\\'周日\\\\']\\\\n    },\\\\n    yAxis: {\\\\n      type: \\\\'value\\\\',\\\\n      axisLabel: {\\\\n        formatter: \\\\'¥{value}\\\\'\\\\n      }\\\\n    },\\\\n    series: [\\\\n      {\\\\n        name: \\\\'收入\\\\',\\\\n        type: \\\\'line\\\\',\\\\n        smooth: true,\\\\n        data: [12500, 13200, 11800, 14500, 16800, 19200, 18500],\\\\n        itemStyle: { color: \\\\'#409EFF\\\\' }\\\\n      },\\\\n      {\\\\n        name: \\\\'利润\\\\',\\\\n        type: \\\\'line\\\\',\\\\n        smooth: true,\\\\n        data: [3750, 3960, 3540, 4350, 5040, 5760, 5550],\\\\n        itemStyle: { color: \\\\'#67C23A\\\\' }\\\\n      }\\\\n    ]\\\\n  }\\\\n  chart.setOption(option)\\\\n}\\\\n\\\\nconst initDistributionChart = () => {\\\\n  if (!distributionChart.value) return\\\\n  \\\\n  const chart = echarts.init(distributionChart.value)\\\\n  const option = {\\\\n    tooltip: {\\\\n      trigger: \\\\'item\\\\',\\\\n      formatter: \\\\'{b}: {c} ({d}%)\\\\'\\\\n    },\\\\n    legend: {\\\\n      orient: \\\\'vertical\\\\',\\\\n      left: \\\\'left\\\\'\\\\n    },\\\\n    series: [\\\\n      {\\\\n        name: \\\\'销售分布\\\\',\\\\n        type: \\\\'pie\\\\',\\\\n        radius: [\\\\'40%\\\\', \\\\'70%\\\\'],\\\\n        avoidLabelOverlap: false,\\\\n        itemStyle: {\\\\n          borderRadius: 10,\\\\n          borderColor: \\\\'#fff\\\\',\\\\n          borderWidth: 2\\\\n        },\\\\n        label: {\\\\n          show: false,\\\\n          position: \\\\'center\\\\'\\\\n        },\\\\n        emphasis: {\\\\n          label: {\\\\n            show: true,\\\\n            fontSize: 20,\\\\n            fontWeight: \\\\'bold\\\\'\\\\n          }\\\\n        },\\\\n        labelLine: {\\\\n          show: false\\\\n        },\\\\n        data: [\\\\n          { value: 45000, name: \\\\'堂食\\\\', itemStyle: { color: \\\\'#409EFF\\\\' } },\\\\n          { value: 32000, name: \\\\'外卖\\\\', itemStyle: { color: \\\\'#67C23A\\\\' } },\\\\n          { value: 18000, name: \\\\'打包\\\\', itemStyle: { color: \\\\'#E6A23C\\\\' } },\\\\n          { value: 12000, name: \\\\'团购\\\\', itemStyle: { color: \\\\'#F56C6C\\\\' } }\\\\n        ]\\\\n      }\\\\n    ]\\\\n  }\\\\n  chart.setOption(option)\\\\n}\\\\n\\\\nconst initHourlyChart = () => {\\\\n  if (!hourlyChart.value) return\\\\n  \\\\n  const chart = echarts.init(hourlyChart.value)\\\\n  const option = {\\\\n    tooltip: {\\\\n      trigger: \\\\'axis\\\\',\\\\n      formatter: (params: any) => {\\\\n        let result = params[0].axisValue + \\\\':00<br/>\\\\'\\\\n        params.forEach((item: any) => {\\\\n          result += `${item.marker}${item.seriesName}: ${item.value}单<br/>`\\\\n        })\\\\n        return result\\\\n      }\\\\n    },\\\\n    grid: {\\\\n      left: \\\\'3%\\\\',\\\\n      right: \\\\'4%\\\\',\\\\n      bottom: \\\\'3%\\\\',\\\\n      containLabel: true\\\\n    },\\\\n    xAxis: {\\\\n      type: \\\\'category\\\\',\\\\n      data: Array.from({ length: 24 }, (_, i) => i)\\\\n    },\\\\n    yAxis: {\\\\n      type: \\\\'value\\\\'\\\\n    },\\\\n    series: [\\\\n      {\\\\n        name: \\\\'订单数\\\\',\\\\n        type: \\\\'bar\\\\',\\\\n        data: [5, 3, 2, 1, 2, 8, 25, 45, 68, 85, 92, 88, 95, 90, 82, 78, 85, 92, 88, 75, 55, 35, 15, 8],\\\\n        itemStyle: {\\\\n          color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [\\\\n            { offset: 0, color: \\\\'#83bff6\\\\' },\\\\n            { offset: 0.5, color: \\\\'#188df0\\\\' },\\\\n            { offset: 1, color: \\\\'#188df0\\\\' }\\\\n          ])\\\\n        }\\\\n      }\\\\n    ]\\\\n  }\\\\n  chart.setOption(option)\\\\n}\\\\n\\\\nconst initPaymentChart = () => {\\\\n  if (!paymentChart.value) return\\\\n  \\\\n  const chart = echarts.init(paymentChart.value)\\\\n  const option = {\\\\n    tooltip: {\\\\n      trigger: \\\\'item\\\\',\\\\n      formatter: \\\\'{b}: ¥{c} ({d}%)\\\\'\\\\n    },\\\\n    legend: {\\\\n      orient: \\\\'vertical\\\\',\\\\n      left: \\\\'left\\\\'\\\\n    },\\\\n    series: [\\\\n      {\\\\n        name: \\\\'支付方式\\\\',\\\\n        type: \\\\'pie\\\\',\\\\n        radius: \\\\'70%\\\\',\\\\n        data: [\\\\n          { value: 52000, name: \\\\'微信支付\\\\', itemStyle: { color: \\\\'#09BB07\\\\' } },\\\\n          { value: 38000, name: \\\\'支付宝\\\\', itemStyle: { color: \\\\'#1677FF\\\\' } },\\\\n          { value: 15000, name: \\\\'现金\\\\', itemStyle: { color: \\\\'#E6A23C\\\\' } },\\\\n          { value: 2000, name: \\\\'其他\\\\', itemStyle: { color: \\\\'#909399\\\\' } }\\\\n        ],\\\\n        emphasis: {\\\\n          itemStyle: {\\\\n            shadowBlur: 10,\\\\n            shadowOffsetX: 0,\\\\n            shadowColor: \\\\'rgba(0, 0, 0, 0.5)\\\\'\\\\n          }\\\\n        }\\\\n      }\\\\n    ]\\\\n  }\\\\n  chart.setOption(option)\\\\n}\\\\n\\\\nconst initTrendsChart = () => {\\\\n  if (!trendsChart.value) return\\\\n  \\\\n  const chart = echarts.init(trendsChart.value)\\\\n  const option = {\\\\n    tooltip: {\\\\n      trigger: \\\\'axis\\\\'\\\\n    },\\\\n    legend: {\\\\n      data: [\\\\'收入\\\\', \\\\'订单数\\\\', \\\\'客单价\\\\']\\\\n    },\\\\n    grid: {\\\\n      left: \\\\'3%\\\\',\\\\n      right: \\\\'4%\\\\',\\\\n      bottom: \\\\'3%\\\\',\\\\n      containLabel: true\\\\n    },\\\\n    xAxis: {\\\\n      type: \\\\'category\\\\',\\\\n      boundaryGap: false,\\\\n      data: [\\\\'1月\\\\', \\\\'2月\\\\', \\\\'3月\\\\', \\\\'4月\\\\', \\\\'5月\\\\', \\\\'6月\\\\', \\\\'7月\\\\', \\\\'8月\\\\', \\\\'9月\\\\', \\\\'10月\\\\', \\\\'11月\\\\', \\\\'12月\\\\']\\\\n    },\\\\n    yAxis: [\\\\n      {\\\\n        type: \\\\'value\\\\',\\\\n        name: \\\\'收入\\\\',\\\\n        position: \\\\'left\\\\',\\\\n        axisLabel: {\\\\n          formatter: \\\\'¥{value}\\\\'\\\\n        }\\\\n      },\\\\n      {\\\\n        type: \\\\'value\\\\',\\\\n        name: \\\\'订单数\\\\',\\\\n        position: \\\\'right\\\\'\\\\n      }\\\\n    ],\\\\n    series: [\\\\n      {\\\\n        name: \\\\'收入\\\\',\\\\n        type: \\\\'line\\\\',\\\\n        smooth: true,\\\\n        data: [125000, 132000, 145000, 138000, 152000, 168000, 175000, 182000, 178000, 195000, 210000, 225000],\\\\n        itemStyle: { color: \\\\'#409EFF\\\\' }\\\\n      },\\\\n      {\\\\n        name: \\\\'订单数\\\\',\\\\n        type: \\\\'line\\\\',\\\\n        smooth: true,\\\\n        yAxisIndex: 1,\\\\n        data: [2500, 2640, 2900, 2760, 3040, 3360, 3500, 3640, 3560, 3900, 4200, 4500],\\\\n        itemStyle: { color: \\\\'#67C23A\\\\' }\\\\n      },\\\\n      {\\\\n        name: \\\\'客单价\\\\',\\\\n        type: \\\\'line\\\\',\\\\n        smooth: true,\\\\n        data: [50, 50, 50, 50, 50, 50, 50, 50, 50, 50, 50, 50],\\\\n        itemStyle: { color: \\\\'#E6A23C\\\\' }\\\\n      }\\\\n    ]\\\\n  }\\\\n  chart.setOption(option)\\\\n}\\\\n\\\\nconst initCategoryChart = () => {\\\\n  if (!categoryChart.value) return\\\\n  \\\\n  const chart = echarts.init(categoryChart.value)\\\\n  const option = {\\\\n    tooltip: {\\\\n      trigger: \\\\'axis\\\\',\\\\n      axisPointer: {\\\\n        type: \\\\'shadow\\\\'\\\\n      }\\\\n    },\\\\n    grid: {\\\\n      left: \\\\'3%\\\\',\\\\n      right: \\\\'4%\\\\',\\\\n      bottom: \\\\'3%\\\\',\\\\n      containLabel: true\\\\n    },\\\\n    xAxis: {\\\\n      type: \\\\'value\\\\'\\\\n    },\\\\n    yAxis: {\\\\n      type: \\\\'category\\\\',\\\\n      data: [\\\\'凉菜\\\\', \\\\'汤品\\\\', \\\\'主食\\\\', \\\\'热菜\\\\', \\\\'饮品\\\\', \\\\'甜点\\\\']\\\\n    },\\\\n    series: [\\\\n      {\\\\n        name: \\\\'销量\\\\',\\\\n        type: \\\\'bar\\\\',\\\\n        data: [850, 920, 1250, 1580, 680, 520],\\\\n        itemStyle: {\\\\n          color: new echarts.graphic.LinearGradient(1, 0, 0, 0, [\\\\n            { offset: 0, color: \\\\'#83bff6\\\\' },\\\\n            { offset: 0.5, color: \\\\'#188df0\\\\' },\\\\n            { offset: 1, color: \\\\'#188df0\\\\' }\\\\n          ])\\\\n        }\\\\n      }\\\\n    ]\\\\n  }\\\\n  chart.setOption(option)\\\\n}\\\\n\\\\nconst initAssociationChart = () => {\\\\n  if (!associationChart.value) return\\\\n  \\\\n  const chart = echarts.init(associationChart.value)\\\\n  const option = {\\\\n    title: {\\\\n      text: \\\\'商品关联网络\\\\',\\\\n      left: \\\\'center\\\\'\\\\n    },\\\\n    tooltip: {},\\\\n    animationDurationUpdate: 1500,\\\\n    animationEasingUpdate: \\\\'quinticInOut\\\\',\\\\n    series: [\\\\n      {\\\\n        type: \\\\'graph\\\\',\\\\n        layout: \\\\'force\\\\',\\\\n        symbolSize: 50,\\\\n        roam: true,\\\\n        label: {\\\\n          show: true\\\\n        },\\\\n        edgeSymbol: [\\\\'circle\\\\', \\\\'arrow\\\\'],\\\\n        edgeSymbolSize: [4, 10],\\\\n        edgeLabel: {\\\\n          fontSize: 20\\\\n        },\\\\n        data: [\\\\n          { name: \\\\'红烧肉\\\\', itemStyle: { color: \\\\'#409EFF\\\\' } },\\\\n          { name: \\\\'米饭\\\\', itemStyle: { color: \\\\'#67C23A\\\\' } },\\\\n          { name: \\\\'宫保鸡丁\\\\', itemStyle: { color: \\\\'#E6A23C\\\\' } },\\\\n          { name: \\\\'麻婆豆腐\\\\', itemStyle: { color: \\\\'#F56C6C\\\\' } },\\\\n          { name: \\\\'清蒸鱼\\\\', itemStyle: { color: \\\\'#909399\\\\' } },\\\\n          { name: \\\\'青菜\\\\', itemStyle: { color: \\\\'#C0C4CC\\\\' } }\\\\n        ],\\\\n        links: [\\\\n          { source: \\\\'红烧肉\\\\', target: \\\\'米饭\\\\', value: 0.8 },\\\\n          { source: \\\\'宫保鸡丁\\\\', target: \\\\'米饭\\\\', value: 0.7 },\\\\n          { source: \\\\'麻婆豆腐\\\\', target: \\\\'米饭\\\\', value: 0.6 },\\\\n          { source: \\\\'清蒸鱼\\\\', target: \\\\'青菜\\\\', value: 0.5 },\\\\n          { source: \\\\'红烧肉\\\\', target: \\\\'青菜\\\\', value: 0.4 }\\\\n        ],\\\\n        lineStyle: {\\\\n          opacity: 0.9,\\\\n          width: 2,\\\\n          curveness: 0\\\\n        }\\\\n      }\\\\n    ]\\\\n  }\\\\n  chart.setOption(option)\\\\n}\\\\n\\\\nconst initForecastChart = () => {\\\\n  if (!forecastChart.value) return\\\\n  \\\\n  const chart = echarts.init(forecastChart.value)\\\\n  \\\\n  const dates = Array.from({ length: 30 }, (_, i) => {\\\\n    const date = new Date()\\\\n    date.setDate(date.getDate() - 15 + i)\\\\n    return date.toLocaleDateString(\\\\'zh-CN\\\\', { month: \\\\'2-digit\\\\', day: \\\\'2-digit\\\\' })\\\\n  })\\\\n  \\\\n  const historicalData = Array.from({ length: 15 }, () => Math.floor(Math.random() * 5000) + 10000)\\\\n  const forecastData = Array.from({ length: 15 }, (_, i) => {\\\\n    const base = historicalData[historicalData.length - 1]\\\\n    const trend = (i + 1) * 100\\\\n    const noise = Math.floor(Math.random() * 500) - 250\\\\n    return base + trend + noise\\\\n  })\\\\n  \\\\n  const lowerBound = forecastData.map(v => v * 0.9)\\\\n  const upperBound = forecastData.map(v => v * 1.1)\\\\n  \\\\n  const option = {\\\\n    tooltip: {\\\\n      trigger: \\\\'axis\\\\',\\\\n      formatter: (params: any) => {\\\\n        let result = params[0].axisValue + \\\\'<br/>\\\\'\\\\n        params.forEach((item: any) => {\\\\n          if (item.seriesName === \\\\'历史数据\\\\' || item.seriesName === \\\\'预测数据\\\\') {\\\\n            result += `${item.marker}${item.seriesName}: ¥${item.value.toLocaleString()}<br/>`\\\\n          }\\\\n        })\\\\n        return result\\\\n      }\\\\n    },\\\\n    legend: {\\\\n      data: [\\\\'历史数据\\\\', \\\\'预测数据\\\\', \\\\'置信区间\\\\']\\\\n    },\\\\n    grid: {\\\\n      left: \\\\'3%\\\\',\\\\n      right: \\\\'4%\\\\',\\\\n      bottom: \\\\'3%\\\\',\\\\n      containLabel: true\\\\n    },\\\\n    xAxis: {\\\\n      type: \\\\'category\\\\',\\\\n      data: dates\\\\n    },\\\\n    yAxis: {\\\\n      type: \\\\'value\\\\',\\\\n      axisLabel: {\\\\n        formatter: \\\\'¥{value}\\\\'\\\\n      }\\\\n    },\\\\n    series: [\\\\n      {\\\\n        name: \\\\'历史数据\\\\',\\\\n        type: \\\\'line\\\\',\\\\n        data: [...historicalData, ...Array(15).fill(null)],\\\\n        itemStyle: { color: \\\\'#409EFF\\\\' },\\\\n        lineStyle: { width: 3 }\\\\n      },\\\\n      {\\\\n        name: \\\\'预测数据\\\\',\\\\n        type: \\\\'line\\\\',\\\\n        data: [...Array(15).fill(null), ...forecastData],\\\\n        itemStyle: { color: \\\\'#67C23A\\\\' },\\\\n        lineStyle: { type: \\\\'dashed\\\\', width: 3 }\\\\n      },\\\\n      {\\\\n        name: \\\\'置信区间\\\\',\\\\n        type: \\\\'line\\\\',\\\\n        data: [...Array(15).fill(null), ...upperBound],\\\\n        lineStyle: { opacity: 0 },\\\\n        markArea: {\\\\n          silent: true,\\\\n          itemStyle: {\\\\n            color: \\\\'rgba(103, 194, 58, 0.1)\\\\'\\\\n          },\\\\n          data: [[\\\\n            {\\\\n              xAxis: dates[15]\\\\n            },\\\\n            {\\\\n              xAxis: dates[29]\\\\n            }\\\\n          ]]\\\\n        }\\\\n      }\\\\n    ]\\\\n  }\\\\n  chart.setOption(option)\\\\n}\\\\n\\\\nconst loadTopProducts = async () => {\\\\n  loading.value = true\\\\n  try {\\\\n    const response = await fetch(\\\\'/api/analytics/sales/products\\\\')\\\\n    const data = await response.json()\\\\n    if (data.success) {\\\\n      topProducts.value = data.data.items\\\\n    }\\\\n  } catch (error) {\\\\n    ElMessage.error(\\\\'加载商品数据失败\\\\')\\\\n  } finally {\\\\n    loading.value = false\\\\n  }\\\\n}\\\\n\\\\nconst loadTrendData = async () => {\\\\n  ElMessage.info(\\\\'加载趋势数据...\\\\')\\\\n}\\\\n\\\\nconst loadForecastData = async () => {\\\\n  ElMessage.info(\\\\'加载预测数据...\\\\')\\\\n  await nextTick()\\\\n  initForecastChart()\\\\n}\\\\n\\\\nwatch(viewMode, async (newMode) => {\\\\n  await nextTick()\\\\n  \\\\n  if (newMode === \\\\'overview\\\\') {\\\\n    initRevenueChart()\\\\n    initDistributionChart()\\\\n    initHourlyChart()\\\\n    initPaymentChart()\\\\n  } else if (newMode === \\\\'trends\\\\') {\\\\n    initTrendsChart()\\\\n  } else if (newMode === \\\\'products\\\\') {\\\\n    loadTopProducts()\\\\n    initCategoryChart()\\\\n    initAssociationChart()\\\\n  } else if (newMode === \\\\'forecast\\\\') {\\\\n    loadForecastData()\\\\n  }\\\\n})\\\\n\\\\nonMounted(async () => {\\\\n  await nextTick()\\\\n  initRevenueChart()\\\\n  initDistributionChart()\\\\n  initHourlyChart()\\\\n  initPaymentChart()\\\\n})\\\\n</script>\\\\n\\\\n<style scoped lang=\\\\\\\"scss\\\\\\\">\\\\n.sales-analytics {\\\\n  .analytics-header {\\\\n    display: flex;\\\\n    justify-content: space-between;\\\\n    align-items: center;\\\\n    margin-bottom: 20px;\\\\n    \\\\n    .header-title {\\\\n      h3 {\\\\n        margin: 0 0 5px 0;\\\\n        font-size: 20px;\\\\n        color: #303133;\\\\n      }\\\\n      \\\\n      p {\\\\n        margin: 0;\\\\n        font-size: 14px;\\\\n        color: #909399;\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  .analytics-content {\\\\n    .chart-container {\\\\n      width: 100%;\\\\n      height: 350px;\\\\n    }\\\\n\\\\n    .large-chart-container {\\\\n      width: 100%;\\\\n      height: 500px;\\\\n    }\\\\n\\\\n    .trend-controls,\\\\n    .forecast-controls {\\\\n      margin-bottom: 20px;\\\\n      text-align: center;\\\\n    }\\\\n\\\\n    .accuracy-metrics {\\\\n      .metric-item {\\\\n        display: flex;\\\\n        justify-content: space-between;\\\\n        padding: 15px;\\\\n        background: #f5f7fa;\\\\n        border-radius: 8px;\\\\n        margin-bottom: 10px;\\\\n\\\\n        .metric-label {\\\\n          font-size: 14px;\\\\n          color: #606266;\\\\n        }\\\\n\\\\n        .metric-value {\\\\n          font-size: 16px;\\\\n          font-weight: bold;\\\\n          color: #303133;\\\\n        }\\\\n      }\\\\n    }\\\\n\\\\n    .text-success {\\\\n      color: #67c23a;\\\\n    }\\\\n\\\\n    .text-danger {\\\\n      color: #f56c6c;\\\\n    }\\\\n  }\\\\n}\\\\n</style>\\\\n\",\"originAcceptText\":\"<template>\\n  <div class=\\\"sales-analytics\\\">\\n    <div class=\\\"analytics-header\\\">\\n      <div class=\\\"header-title\\\">\\n        <h3>销售分析</h3>\\n        <p>深入了解销售趋势和收入表现</p>\\n      </div>\\n      <div class=\\\"header-actions\\\">\\n        <el-button-group>\\n          <el-button :type=\\\"viewMode === 'overview' ? 'primary' : 'default'\\\" @click=\\\"viewMode = 'overview'\\\">\\n            总览\\n          </el-button>\\n          <el-button :type=\\\"viewMode === 'trends' ? 'primary' : 'default'\\\" @click=\\\"viewMode = 'trends'\\\">\\n            趋势\\n          </el-button>\\n          <el-button :type=\\\"viewMode === 'products' ? 'primary' : 'default'\\\" @click=\\\"viewMode = 'products'\\\">\\n            商品\\n          </el-button>\\n          <el-button :type=\\\"viewMode === 'forecast' ? 'primary' : 'default'\\\" @click=\\\"viewMode = 'forecast'\\\">\\n            预测\\n          </el-button>\\n        </el-button-group>\\n      </div>\\n    </div>\\n\\n    <div class=\\\"analytics-content\\\">\\n      <div v-if=\\\"viewMode === 'overview'\\\" class=\\\"overview-view\\\">\\n        <el-row :gutter=\\\"20\\\">\\n          <el-col :span=\\\"16\\\">\\n            <el-card title=\\\"销售收入趋势\\\">\\n              <div ref=\\\"revenueChart\\\" class=\\\"chart-container\\\"></div>\\n            </el-card>\\n          </el-col>\\n          <el-col :span=\\\"8\\\">\\n            <el-card title=\\\"销售分布\\\">\\n              <div ref=\\\"distributionChart\\\" class=\\\"chart-container\\\"></div>\\n            </el-card>\\n          </el-col>\\n        </el-row>\\n\\n        <el-row :gutter=\\\"20\\\" style=\\\"margin-top: 20px;\\\">\\n          <el-col :span=\\\"12\\\">\\n            <el-card title=\\\"按小时销售分析\\\">\\n              <div ref=\\\"hourlyChart\\\" class=\\\"chart-container\\\"></div>\\n            </el-card>\\n          </el-col>\\n          <el-col :span=\\\"12\\\">\\n            <el-card title=\\\"支付方式分布\\\">\\n              <div ref=\\\"paymentChart\\\" class=\\\"chart-container\\\"></div>\\n            </el-card>\\n          </el-col>\\n        </el-row>\\n      </div>\\n\\n      <div v-else-if=\\\"viewMode === 'trends'\\\" class=\\\"trends-view\\\">\\n        <el-row :gutter=\\\"20\\\">\\n          <el-col :span=\\\"24\\\">\\n            <el-card title=\\\"销售趋势分析\\\">\\n              <div class=\\\"trend-controls\\\">\\n                <el-radio-group v-model=\\\"trendGranularity\\\" @change=\\\"loadTrendData\\\">\\n                  <el-radio-button label=\\\"day\\\">日趋势</el-radio-button>\\n                  <el-radio-button label=\\\"week\\\">周趋势</el-radio-button>\\n                  <el-radio-button label=\\\"month\\\">月趋势</el-radio-button>\\n                </el-radio-group>\\n              </div>\\n              <div ref=\\\"trendsChart\\\" class=\\\"large-chart-container\\\"></div>\\n            </el-card>\\n          </el-col>\\n        </el-row>\\n\\n        <el-row :gutter=\\\"20\\\" style=\\\"margin-top: 20px;\\\">\\n          <el-col :span=\\\"12\\\">\\n            <el-card title=\\\"同比增长分析\\\">\\n              <div ref=\\\"yoyChart\\\" class=\\\"chart-container\\\"></div>\\n            </el-card>\\n          </el-col>\\n          <el-col :span=\\\"12\\\">\\n            <el-card title=\\\"环比增长分析\\\">\\n              <div ref=\\\"momChart\\\" class=\\\"chart-container\\\"></div>\\n            </el-card>\\n          </el-col>\\n        </el-row>\\n      </div>\\n\\n      <div v-else-if=\\\"viewMode === 'products'\\\" class=\\\"products-view\\\">\\n        <el-row :gutter=\\\"20\\\">\\n          <el-col :span=\\\"16\\\">\\n            <el-card title=\\\"热销商品排行\\\">\\n              <el-table :data=\\\"topProducts\\\" style=\\\"width: 100%\\\" v-loading=\\\"loading\\\">\\n                <el-table-column type=\\\"index\\\" label=\\\"排名\\\" width=\\\"80\\\" />\\n                <el-table-column prop=\\\"itemName\\\" label=\\\"商品名称\\\" />\\n                <el-table-column prop=\\\"categoryName\\\" label=\\\"类别\\\" width=\\\"120\\\" />\\n                <el-table-column prop=\\\"quantity\\\" label=\\\"销量\\\" width=\\\"100\\\" sortable />\\n                <el-table-column prop=\\\"revenue\\\" label=\\\"收入\\\" width=\\\"120\\\" sortable>\\n                  <template #default=\\\"{ row }\\\">\\n                    ¥{{ row.revenue.toLocaleString() }}\\n                  </template>\\n                </el-table-column>\\n                <el-table-column prop=\\\"profit\\\" label=\\\"利润\\\" width=\\\"120\\\" sortable>\\n                  <template #default=\\\"{ row }\\\">\\n                    ¥{{ row.profit.toLocaleString() }}\\n                  </template>\\n                </el-table-column>\\n                <el-table-column prop=\\\"growth\\\" label=\\\"增长率\\\" width=\\\"100\\\" sortable>\\n                  <template #default=\\\"{ row }\\\">\\n                    <span :class=\\\"row.growth >= 0 ? 'text-success' : 'text-danger'\\\">\\n                      {{ row.growth >= 0 ? '+' : '' }}{{ row.growth }}%\\n                    </span>\\n                  </template>\\n                </el-table-column>\\n              </el-table>\\n            </el-card>\\n          </el-col>\\n          <el-col :span=\\\"8\\\">\\n            <el-card title=\\\"类别销售对比\\\">\\n              <div ref=\\\"categoryChart\\\" class=\\\"chart-container\\\"></div>\\n            </el-card>\\n          </el-col>\\n        </el-row>\\n\\n        <el-row :gutter=\\\"20\\\" style=\\\"margin-top: 20px;\\\">\\n          <el-col :span=\\\"24\\\">\\n            <el-card title=\\\"商品关联分析\\\">\\n              <div ref=\\\"associationChart\\\" class=\\\"large-chart-container\\\"></div>\\n            </el-card>\\n          </el-col>\\n        </el-row>\\n      </div>\\n\\n      <div v-else-if=\\\"viewMode === 'forecast'\\\" class=\\\"forecast-view\\\">\\n        <el-row :gutter=\\\"20\\\">\\n          <el-col :span=\\\"24\\\">\\n            <el-card title=\\\"销售预测\\\">\\n              <div class=\\\"forecast-controls\\\">\\n                <el-form :inline=\\\"true\\\">\\n                  <el-form-item label=\\\"预测周期\\\">\\n                    <el-select v-model=\\\"forecastDays\\\" @change=\\\"loadForecastData\\\">\\n                      <el-option label=\\\"7天\\\" :value=\\\"7\\\" />\\n                      <el-option label=\\\"15天\\\" :value=\\\"15\\\" />\\n                      <el-option label=\\\"30天\\\" :value=\\\"30\\\" />\\n                      <el-option label=\\\"60天\\\" :value=\\\"60\\\" />\\n                      <el-option label=\\\"90天\\\" :value=\\\"90\\\" />\\n                    </el-select>\\n                  </el-form-item>\\n                  <el-form-item label=\\\"预测模型\\\">\\n                    <el-select v-model=\\\"forecastModel\\\" @change=\\\"loadForecastData\\\">\\n                      <el-option label=\\\"ARIMA\\\" value=\\\"arima\\\" />\\n                      <el-option label=\\\"Prophet\\\" value=\\\"prophet\\\" />\\n                      <el-option label=\\\"LSTM\\\" value=\\\"lstm\\\" />\\n                      <el-option label=\\\"集成模型\\\" value=\\\"ensemble\\\" />\\n                    </el-select>\\n                  </el-form-item>\\n                </el-form>\\n              </div>\\n              <div ref=\\\"forecastChart\\\" class=\\\"large-chart-container\\\"></div>\\n            </el-card>\\n          </el-col>\\n        </el-row>\\n\\n        <el-row :gutter=\\\"20\\\" style=\\\"margin-top: 20px;\\\">\\n          <el-col :span=\\\"12\\\">\\n            <el-card title=\\\"预测准确度\\\">\\n              <div class=\\\"accuracy-metrics\\\">\\n                <div class=\\\"metric-item\\\">\\n                  <div class=\\\"metric-label\\\">MAE (平均绝对误差)</div>\\n                  <div class=\\\"metric-value\\\">{{ forecastAccuracy.mae }}</div>\\n                </div>\\n                <div class=\\\"metric-item\\\">\\n                  <div class=\\\"metric-label\\\">RMSE (均方根误差)</div>\\n                  <div class=\\\"metric-value\\\">{{ forecastAccuracy.rmse }}</div>\\n                </div>\\n                <div class=\\\"metric-item\\\">\\n                  <div class=\\\"metric-label\\\">MAPE (平均绝对百分比误差)</div>\\n                  <div class=\\\"metric-value\\\">{{ forecastAccuracy.mape }}%</div>\\n                </div>\\n                <div class=\\\"metric-item\\\">\\n                  <div class=\\\"metric-label\\\">R² (决定系数)</div>\\n                  <div class=\\\"metric-value\\\">{{ forecastAccuracy.r2 }}</div>\\n                </div>\\n              </div>\\n            </el-card>\\n          </el-col>\\n          <el-col :span=\\\"12\\\">\\n            <el-card title=\\\"预测建议\\\">\\n              <div class=\\\"forecast-suggestions\\\">\\n                <el-alert\\n                  v-for=\\\"(suggestion, index) in forecastSuggestions\\\"\\n                  :key=\\\"index\\\"\\n                  :title=\\\"suggestion.title\\\"\\n                  :type=\\\"suggestion.type\\\"\\n                  :description=\\\"suggestion.description\\\"\\n                  :closable=\\\"false\\\"\\n                  style=\\\"margin-bottom: 10px;\\\"\\n                />\\n              </div>\\n            </el-card>\\n          </el-col>\\n        </el-row>\\n      </div>\\n    </div>\\n  </div>\\n</template>\\n\\n<script setup lang=\\\"ts\\\">\\nimport { ref, reactive, onMounted, nextTick, watch } from 'vue'\\nimport { ElMessage } from 'element-plus'\\nimport * as echarts from 'echarts'\\n\\ninterface ProductSales {\\n  rank: number\\n  itemName: string\\n  categoryName: string\\n  quantity: number\\n  revenue: number\\n  profit: number\\n  growth: number\\n}\\n\\ninterface ForecastAccuracy {\\n  mae: number\\n  rmse: number\\n  mape: number\\n  r2: number\\n}\\n\\ninterface ForecastSuggestion {\\n  title: string\\n  type: 'success' | 'warning' | 'info'\\n  description: string\\n}\\n\\nconst loading = ref(false)\\nconst viewMode = ref('overview')\\nconst trendGranularity = ref('day')\\nconst forecastDays = ref(30)\\nconst forecastModel = ref('ensemble')\\n\\nconst revenueChart = ref()\\nconst distributionChart = ref()\\nconst hourlyChart = ref()\\nconst paymentChart = ref()\\nconst trendsChart = ref()\\nconst yoyChart = ref()\\nconst momChart = ref()\\nconst categoryChart = ref()\\nconst associationChart = ref()\\nconst forecastChart = ref()\\n\\nconst topProducts = ref<ProductSales[]>([])\\nconst forecastAccuracy = reactive<ForecastAccuracy>({\\n  mae: 1250,\\n  rmse: 1890,\\n  mape: 8.5,\\n  r2: 0.92\\n})\\n\\nconst forecastSuggestions = ref<ForecastSuggestion[]>([\\n  {\\n    title: '预计下周销量增长15%',\\n    type: 'success',\\n    description: '基于历史数据和当前趋势，建议增加库存准备'\\n  },\\n  {\\n    title: '热销商品库存预警',\\n    type: 'warning',\\n    description: '红烧肉套餐预计3天后库存不足，建议提前补货'\\n  },\\n  {\\n    title: '新菜品推广建议',\\n    type: 'info',\\n    description: '根据客户偏好分析，建议推出春季特色菜品'\\n  }\\n])\\n\\nconst initRevenueChart = () => {\\n  if (!revenueChart.value) return\\n  \\n  const chart = echarts.init(revenueChart.value)\\n  const option = {\\n    tooltip: {\\n      trigger: 'axis',\\n      formatter: (params: any) => {\\n        let result = params[0].axisValue + '<br/>'\\n        params.forEach((item: any) => {\\n          result += `${item.marker}${item.seriesName}: ¥${item.value.toLocaleString()}<br/>`\\n        })\\n        return result\\n      }\\n    },\\n    legend: {\\n      data: ['收入', '利润']\\n    },\\n    grid: {\\n      left: '3%',\\n      right: '4%',\\n      bottom: '3%',\\n      containLabel: true\\n    },\\n    xAxis: {\\n      type: 'category',\\n      data: ['周一', '周二', '周三', '周四', '周五', '周六', '周日']\\n    },\\n    yAxis: {\\n      type: 'value',\\n      axisLabel: {\\n        formatter: '¥{value}'\\n      }\\n    },\\n    series: [\\n      {\\n        name: '收入',\\n        type: 'line',\\n        smooth: true,\\n        data: [12500, 13200, 11800, 14500, 16800, 19200, 18500],\\n        itemStyle: { color: '#409EFF' }\\n      },\\n      {\\n        name: '利润',\\n        type: 'line',\\n        smooth: true,\\n        data: [3750, 3960, 3540, 4350, 5040, 5760, 5550],\\n        itemStyle: { color: '#67C23A' }\\n      }\\n    ]\\n  }\\n  chart.setOption(option)\\n}\\n\\nconst initDistributionChart = () => {\\n  if (!distributionChart.value) return\\n  \\n  const chart = echarts.init(distributionChart.value)\\n  const option = {\\n    tooltip: {\\n      trigger: 'item',\\n      formatter: '{b}: {c} ({d}%)'\\n    },\\n    legend: {\\n      orient: 'vertical',\\n      left: 'left'\\n    },\\n    series: [\\n      {\\n        name: '销售分布',\\n        type: 'pie',\\n        radius: ['40%', '70%'],\\n        avoidLabelOverlap: false,\\n        itemStyle: {\\n          borderRadius: 10,\\n          borderColor: '#fff',\\n          borderWidth: 2\\n        },\\n        label: {\\n          show: false,\\n          position: 'center'\\n        },\\n        emphasis: {\\n          label: {\\n            show: true,\\n            fontSize: 20,\\n            fontWeight: 'bold'\\n          }\\n        },\\n        labelLine: {\\n          show: false\\n        },\\n        data: [\\n          { value: 45000, name: '堂食', itemStyle: { color: '#409EFF' } },\\n          { value: 32000, name: '外卖', itemStyle: { color: '#67C23A' } },\\n          { value: 18000, name: '打包', itemStyle: { color: '#E6A23C' } },\\n          { value: 12000, name: '团购', itemStyle: { color: '#F56C6C' } }\\n        ]\\n      }\\n    ]\\n  }\\n  chart.setOption(option)\\n}\\n\\nconst initHourlyChart = () => {\\n  if (!hourlyChart.value) return\\n  \\n  const chart = echarts.init(hourlyChart.value)\\n  const option = {\\n    tooltip: {\\n      trigger: 'axis',\\n      formatter: (params: any) => {\\n        let result = params[0].axisValue + ':00<br/>'\\n        params.forEach((item: any) => {\\n          result += `${item.marker}${item.seriesName}: ${item.value}单<br/>`\\n        })\\n        return result\\n      }\\n    },\\n    grid: {\\n      left: '3%',\\n      right: '4%',\\n      bottom: '3%',\\n      containLabel: true\\n    },\\n    xAxis: {\\n      type: 'category',\\n      data: Array.from({ length: 24 }, (_, i) => i)\\n    },\\n    yAxis: {\\n      type: 'value'\\n    },\\n    series: [\\n      {\\n        name: '订单数',\\n        type: 'bar',\\n        data: [5, 3, 2, 1, 2, 8, 25, 45, 68, 85, 92, 88, 95, 90, 82, 78, 85, 92, 88, 75, 55, 35, 15, 8],\\n        itemStyle: {\\n          color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [\\n            { offset: 0, color: '#83bff6' },\\n            { offset: 0.5, color: '#188df0' },\\n            { offset: 1, color: '#188df0' }\\n          ])\\n        }\\n      }\\n    ]\\n  }\\n  chart.setOption(option)\\n}\\n\\nconst initPaymentChart = () => {\\n  if (!paymentChart.value) return\\n  \\n  const chart = echarts.init(paymentChart.value)\\n  const option = {\\n    tooltip: {\\n      trigger: 'item',\\n      formatter: '{b}: ¥{c} ({d}%)'\\n    },\\n    legend: {\\n      orient: 'vertical',\\n      left: 'left'\\n    },\\n    series: [\\n      {\\n        name: '支付方式',\\n        type: 'pie',\\n        radius: '70%',\\n        data: [\\n          { value: 52000, name: '微信支付', itemStyle: { color: '#09BB07' } },\\n          { value: 38000, name: '支付宝', itemStyle: { color: '#1677FF' } },\\n          { value: 15000, name: '现金', itemStyle: { color: '#E6A23C' } },\\n          { value: 2000, name: '其他', itemStyle: { color: '#909399' } }\\n        ],\\n        emphasis: {\\n          itemStyle: {\\n            shadowBlur: 10,\\n            shadowOffsetX: 0,\\n            shadowColor: 'rgba(0, 0, 0, 0.5)'\\n          }\\n        }\\n      }\\n    ]\\n  }\\n  chart.setOption(option)\\n}\\n\\nconst initTrendsChart = () => {\\n  if (!trendsChart.value) return\\n  \\n  const chart = echarts.init(trendsChart.value)\\n  const option = {\\n    tooltip: {\\n      trigger: 'axis'\\n    },\\n    legend: {\\n      data: ['收入', '订单数', '客单价']\\n    },\\n    grid: {\\n      left: '3%',\\n      right: '4%',\\n      bottom: '3%',\\n      containLabel: true\\n    },\\n    xAxis: {\\n      type: 'category',\\n      boundaryGap: false,\\n      data: ['1月', '2月', '3月', '4月', '5月', '6月', '7月', '8月', '9月', '10月', '11月', '12月']\\n    },\\n    yAxis: [\\n      {\\n        type: 'value',\\n        name: '收入',\\n        position: 'left',\\n        axisLabel: {\\n          formatter: '¥{value}'\\n        }\\n      },\\n      {\\n        type: 'value',\\n        name: '订单数',\\n        position: 'right'\\n      }\\n    ],\\n    series: [\\n      {\\n        name: '收入',\\n        type: 'line',\\n        smooth: true,\\n        data: [125000, 132000, 145000, 138000, 152000, 168000, 175000, 182000, 178000, 195000, 210000, 225000],\\n        itemStyle: { color: '#409EFF' }\\n      },\\n      {\\n        name: '订单数',\\n        type: 'line',\\n        smooth: true,\\n        yAxisIndex: 1,\\n        data: [2500, 2640, 2900, 2760, 3040, 3360, 3500, 3640, 3560, 3900, 4200, 4500],\\n        itemStyle: { color: '#67C23A' }\\n      },\\n      {\\n        name: '客单价',\\n        type: 'line',\\n        smooth: true,\\n        data: [50, 50, 50, 50, 50, 50, 50, 50, 50, 50, 50, 50],\\n        itemStyle: { color: '#E6A23C' }\\n      }\\n    ]\\n  }\\n  chart.setOption(option)\\n}\\n\\nconst initCategoryChart = () => {\\n  if (!categoryChart.value) return\\n  \\n  const chart = echarts.init(categoryChart.value)\\n  const option = {\\n    tooltip: {\\n      trigger: 'axis',\\n      axisPointer: {\\n        type: 'shadow'\\n      }\\n    },\\n    grid: {\\n      left: '3%',\\n      right: '4%',\\n      bottom: '3%',\\n      containLabel: true\\n    },\\n    xAxis: {\\n      type: 'value'\\n    },\\n    yAxis: {\\n      type: 'category',\\n      data: ['凉菜', '汤品', '主食', '热菜', '饮品', '甜点']\\n    },\\n    series: [\\n      {\\n        name: '销量',\\n        type: 'bar',\\n        data: [850, 920, 1250, 1580, 680, 520],\\n        itemStyle: {\\n          color: new echarts.graphic.LinearGradient(1, 0, 0, 0, [\\n            { offset: 0, color: '#83bff6' },\\n            { offset: 0.5, color: '#188df0' },\\n            { offset: 1, color: '#188df0' }\\n          ])\\n        }\\n      }\\n    ]\\n  }\\n  chart.setOption(option)\\n}\\n\\nconst initAssociationChart = () => {\\n  if (!associationChart.value) return\\n  \\n  const chart = echarts.init(associationChart.value)\\n  const option = {\\n    title: {\\n      text: '商品关联网络',\\n      left: 'center'\\n    },\\n    tooltip: {},\\n    animationDurationUpdate: 1500,\\n    animationEasingUpdate: 'quinticInOut',\\n    series: [\\n      {\\n        type: 'graph',\\n        layout: 'force',\\n        symbolSize: 50,\\n        roam: true,\\n        label: {\\n          show: true\\n        },\\n        edgeSymbol: ['circle', 'arrow'],\\n        edgeSymbolSize: [4, 10],\\n        edgeLabel: {\\n          fontSize: 20\\n        },\\n        data: [\\n          { name: '红烧肉', itemStyle: { color: '#409EFF' } },\\n          { name: '米饭', itemStyle: { color: '#67C23A' } },\\n          { name: '宫保鸡丁', itemStyle: { color: '#E6A23C' } },\\n          { name: '麻婆豆腐', itemStyle: { color: '#F56C6C' } },\\n          { name: '清蒸鱼', itemStyle: { color: '#909399' } },\\n          { name: '青菜', itemStyle: { color: '#C0C4CC' } }\\n        ],\\n        links: [\\n          { source: '红烧肉', target: '米饭', value: 0.8 },\\n          { source: '宫保鸡丁', target: '米饭', value: 0.7 },\\n          { source: '麻婆豆腐', target: '米饭', value: 0.6 },\\n          { source: '清蒸鱼', target: '青菜', value: 0.5 },\\n          { source: '红烧肉', target: '青菜', value: 0.4 }\\n        ],\\n        lineStyle: {\\n          opacity: 0.9,\\n          width: 2,\\n          curveness: 0\\n        }\\n      }\\n    ]\\n  }\\n  chart.setOption(option)\\n}\\n\\nconst initForecastChart = () => {\\n  if (!forecastChart.value) return\\n  \\n  const chart = echarts.init(forecastChart.value)\\n  \\n  const dates = Array.from({ length: 30 }, (_, i) => {\\n    const date = new Date()\\n    date.setDate(date.getDate() - 15 + i)\\n    return date.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' })\\n  })\\n  \\n  const historicalData = Array.from({ length: 15 }, () => Math.floor(Math.random() * 5000) + 10000)\\n  const forecastData = Array.from({ length: 15 }, (_, i) => {\\n    const base = historicalData[historicalData.length - 1]\\n    const trend = (i + 1) * 100\\n    const noise = Math.floor(Math.random() * 500) - 250\\n    return base + trend + noise\\n  })\\n  \\n  const lowerBound = forecastData.map(v => v * 0.9)\\n  const upperBound = forecastData.map(v => v * 1.1)\\n  \\n  const option = {\\n    tooltip: {\\n      trigger: 'axis',\\n      formatter: (params: any) => {\\n        let result = params[0].axisValue + '<br/>'\\n        params.forEach((item: any) => {\\n          if (item.seriesName === '历史数据' || item.seriesName === '预测数据') {\\n            result += `${item.marker}${item.seriesName}: ¥${item.value.toLocaleString()}<br/>`\\n          }\\n        })\\n        return result\\n      }\\n    },\\n    legend: {\\n      data: ['历史数据', '预测数据', '置信区间']\\n    },\\n    grid: {\\n      left: '3%',\\n      right: '4%',\\n      bottom: '3%',\\n      containLabel: true\\n    },\\n    xAxis: {\\n      type: 'category',\\n      data: dates\\n    },\\n    yAxis: {\\n      type: 'value',\\n      axisLabel: {\\n        formatter: '¥{value}'\\n      }\\n    },\\n    series: [\\n      {\\n        name: '历史数据',\\n        type: 'line',\\n        data: [...historicalData, ...Array(15).fill(null)],\\n        itemStyle: { color: '#409EFF' },\\n        lineStyle: { width: 3 }\\n      },\\n      {\\n        name: '预测数据',\\n        type: 'line',\\n        data: [...Array(15).fill(null), ...forecastData],\\n        itemStyle: { color: '#67C23A' },\\n        lineStyle: { type: 'dashed', width: 3 }\\n      },\\n      {\\n        name: '置信区间',\\n        type: 'line',\\n        data: [...Array(15).fill(null), ...upperBound],\\n        lineStyle: { opacity: 0 },\\n        markArea: {\\n          silent: true,\\n          itemStyle: {\\n            color: 'rgba(103, 194, 58, 0.1)'\\n          },\\n          data: [[\\n            {\\n              xAxis: dates[15]\\n            },\\n            {\\n              xAxis: dates[29]\\n            }\\n          ]]\\n        }\\n      }\\n    ]\\n  }\\n  chart.setOption(option)\\n}\\n\\nconst loadTopProducts = async () => {\\n  loading.value = true\\n  try {\\n    const response = await fetch('/api/analytics/sales/products')\\n    const data = await response.json()\\n    if (data.success) {\\n      topProducts.value = data.data.items\\n    }\\n  } catch (error) {\\n    ElMessage.error('加载商品数据失败')\\n  } finally {\\n    loading.value = false\\n  }\\n}\\n\\nconst loadTrendData = async () => {\\n  ElMessage.info('加载趋势数据...')\\n}\\n\\nconst loadForecastData = async () => {\\n  ElMessage.info('加载预测数据...')\\n  await nextTick()\\n  initForecastChart()\\n}\\n\\nwatch(viewMode, async (newMode) => {\\n  await nextTick()\\n  \\n  if (newMode === 'overview') {\\n    initRevenueChart()\\n    initDistributionChart()\\n    initHourlyChart()\\n    initPaymentChart()\\n  } else if (newMode === 'trends') {\\n    initTrendsChart()\\n  } else if (newMode === 'products') {\\n    loadTopProducts()\\n    initCategoryChart()\\n    initAssociationChart()\\n  } else if (newMode === 'forecast') {\\n    loadForecastData()\\n  }\\n})\\n\\nonMounted(async () => {\\n  await nextTick()\\n  initRevenueChart()\\n  initDistributionChart()\\n  initHourlyChart()\\n  initPaymentChart()\\n})\\n</script>\\n\\n<style scoped lang=\\\"scss\\\">\\n.sales-analytics {\\n  .analytics-header {\\n    display: flex;\\n    justify-content: space-between;\\n    align-items: center;\\n    margin-bottom: 20px;\\n    \\n    .header-title {\\n      h3 {\\n        margin: 0 0 5px 0;\\n        font-size: 20px;\\n        color: #303133;\\n      }\\n      \\n      p {\\n        margin: 0;\\n        font-size: 14px;\\n        color: #909399;\\n      }\\n    }\\n  }\\n\\n  .analytics-content {\\n    .chart-container {\\n      width: 100%;\\n      height: 350px;\\n    }\\n\\n    .large-chart-container {\\n      width: 100%;\\n      height: 500px;\\n    }\\n\\n    .trend-controls,\\n    .forecast-controls {\\n      margin-bottom: 20px;\\n      text-align: center;\\n    }\\n\\n    .accuracy-metrics {\\n      .metric-item {\\n        display: flex;\\n        justify-content: space-between;\\n        padding: 15px;\\n        background: #f5f7fa;\\n        border-radius: 8px;\\n        margin-bottom: 10px;\\n\\n        .metric-label {\\n          font-size: 14px;\\n          color: #606266;\\n        }\\n\\n        .metric-value {\\n          font-size: 16px;\\n          font-weight: bold;\\n          color: #303133;\\n        }\\n      }\\n    }\\n\\n    .text-success {\\n      color: #67c23a;\\n    }\\n\\n    .text-danger {\\n      color: #f56c6c;\\n    }\\n  }\\n}\\n</style>\\n\",\"originTextLength\":22359,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768858748868}]",
