\\n      }\",\"originTextLength\":227,\"aiScene\":\"Completion\",\"behaviorType\":\"accept\",\"updateTime\":1766162510052},{\"originRange\":{\"start\":{\"line\":209,\"character\":0},\"end\":{\"line\":209,\"character\":68}},\"modifyRange\":{\"start\":{\"line\":209,\"character\":0},\"end\":{\"line\":209,\"character\":68}},\"action\":\"None\",\"isLine\":false,\"originText\":\"        deletedOrder = this.orders.splice(orderIndex, 1)[0] || null;\",\"originAcceptText\":\"        deletedOrder = this.orders.splice(orderIndex, 1)[0] || null;\",\"originTextLength\":68,\"aiScene\":\"Completion\",\"behaviorType\":\"accept\",\"updateTime\":1766162510053}]",
  "range-cache-file:///Users/my/Downloads/%E6%99%BA%E6%9E%A2%E6%9C%8D%E5%8A%A1%E5%B9%B3%E5%8F%B0/services/laundry-orders-service/services/recommendation.service.ts": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":147,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":147,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"/**\\\\n * @file 智能推荐服务\\\\n * @description 基于订单数据提供洗衣项目推荐功能\\\\n * @author YYC\\\\n * @version 1.0.0\\\\n */\\\\n\\\\nimport { LaundryOrder } from \\\\'../models/laundry-order.model\\\\';\\\\nimport { redisCacheService } from \\\\'../../../lib/cache/redis.service\\\\';\\\\nimport { orderService } from \\\\'./order.service\\\\';\\\\n\\\\n/**\\\\n * 智能推荐服务类\\\\n */\\\\nexport class RecommendationService {\\\\n  private readonly CACHE_KEY_PREFIX = \\\\'recommendations:\\\\';\\\\n  private readonly CACHE_TTL = 3600; // 1小时\\\\n\\\\n  /**\\\\n   * 基于顾客历史订单推荐洗衣项目\\\\n   * @param customerId 顾客ID\\\\n   * @returns 推荐的洗衣项目列表\\\\n   */\\\\n  async getRecommendationsForCustomer(customerId: string): Promise<Array<{ type: string; confidence: number }>> {\\\\n    const cacheKey = `${this.CACHE_KEY_PREFIX}customer:${customerId}`;\\\\n\\\\n    return await redisCacheService.getWithCache(\\\\n      cacheKey,\\\\n      async () => {\\\\n        // 获取顾客历史订单\\\\n        const allOrders = await orderService.getAllOrders();\\\\n        const customerOrders = allOrders.filter(order => order.customerId === customerId);\\\\n\\\\n        if (customerOrders.length === 0) {\\\\n          // 如果没有历史订单，返回热门推荐\\\\n          return this.getPopularRecommendations();\\\\n        }\\\\n\\\\n        // 分析顾客的洗衣项目偏好\\\\n        const itemFrequency = this.analyzeItemFrequency(customerOrders);\\\\n        \\\\n        // 生成推荐\\\\n        const recommendations = this.generateRecommendations(itemFrequency);\\\\n        \\\\n        return recommendations;\\\\n      },\\\\n      this.CACHE_TTL\\\\n    );\\\\n  }\\\\n\\\\n  /**\\\\n   * 获取热门推荐\\\\n   * @returns 热门洗衣项目列表\\\\n   */\\\\n  async getPopularRecommendations(): Promise<Array<{ type: string; confidence: number }>> {\\\\n    const cacheKey = `${this.CACHE_KEY_PREFIX}popular`;\\\\n\\\\n    return await redisCacheService.getWithCache(\\\\n      cacheKey,\\\\n      async () => {\\\\n        // 获取所有订单\\\\n        const allOrders = await orderService.getAllOrders();\\\\n        \\\\n        // 分析所有订单的洗衣项目频率\\\\n        const itemFrequency = this.analyzeItemFrequency(allOrders);\\\\n        \\\\n        // 生成热门推荐\\\\n        const popularItems = Object.entries(itemFrequency)\\\\n          .map(([type, frequency]) => ({ type, confidence: frequency }))\\\\n          .sort((a, b) => b.confidence - a.confidence)\\\\n          .slice(0, 5); // 取前5个热门项目\\\\n\\\\n        return popularItems;\\\\n      },\\\\n      this.CACHE_TTL * 2 // 热门推荐缓存2小时\\\\n    );\\\\n  }\\\\n\\\\n  /**\\\\n   * 分析订单中的洗衣项目频率\\\\n   * @param orders 订单列表\\\\n   * @returns 洗衣项目频率映射\\\\n   */\\\\n  private analyzeItemFrequency(orders: LaundryOrder[]): Record<string, number> {\\\\n    const frequency: Record<string, number> = {};\\\\n\\\\n    orders.forEach(order => {\\\\n      order.items.forEach(item => {\\\\n        frequency[item.type] = (frequency[item.type] || 0) + item.quantity;\\\\n      });\\\\n    });\\\\n\\\\n    return frequency;\\\\n  }\\\\n\\\\n  /**\\\\n   * 生成推荐列表\\\\n   * @param itemFrequency 项目频率映射\\\\n   * @returns 推荐列表\\\\n   */\\\\n  private generateRecommendations(itemFrequency: Record<string, number>): Array<{ type: string; confidence: number }> {\\\\n    // 计算总频率\\\\n    const totalFrequency = Object.values(itemFrequency).reduce((sum, freq) => sum + freq, 0);\\\\n    \\\\n    // 生成推荐，包含置信度（相对频率）\\\\n    const recommendations = Object.entries(itemFrequency)\\\\n      .map(([type, frequency]) => ({\\\\n        type,\\\\n        confidence: parseFloat((frequency / totalFrequency).toFixed(3))\\\\n      }))\\\\n      .sort((a, b) => b.confidence - a.confidence)\\\\n      .slice(0, 5); // 取前5个推荐\\\\n\\\\n    return recommendations;\\\\n  }\\\\n\\\\n  /**\\\\n   * 基于当前购物车推荐相关项目\\\\n   * @param currentItems 当前购物车项目\\\\n   * @returns 相关推荐项目列表\\\\n   */\\\\n  async getRelatedRecommendations(currentItems: Array<{ type: string; quantity: number }>): Promise<Array<{ type: string; confidence: number }>> {\\\\n    const cacheKey = `${this.CACHE_KEY_PREFIX}related:${JSON.stringify(currentItems.map(item => item.type).sort())}`;\\\\n\\\\n    return await redisCacheService.getWithCache(\\\\n      cacheKey,\\\\n      async () => {\\\\n        // 获取所有订单\\\\n        const allOrders = await orderService.getAllOrders();\\\\n        \\\\n        // 分析与当前项目相关的项目\\\\n        const currentTypes = new Set(currentItems.map(item => item.type));\\\\n        const relatedItems: Record<string, number> = {};\\\\n\\\\n        allOrders.forEach(order => {\\\\n          const orderTypes = new Set(order.items.map(item => item.type));\\\\n          \\\\n          // 检查订单是否包含当前项目\\\\n          const hasCurrentItems = [...currentTypes].some(type => orderTypes.has(type));\\\\n          \\\\n          if (hasCurrentItems) {\\\\n            // 统计相关项目\\\\n            order.items.forEach(item => {\\\\n              if (!currentTypes.has(item.type)) {\\\\n                relatedItems[item.type] = (relatedItems[item.type] || 0) + item.quantity;\\\\n              }\\\\n            });\\\\n          }\\\\n        });\\\\n\\\\n        // 生成相关推荐\\\\n        const relatedRecommendations = Object.entries(relatedItems)\\\\n          .map(([type, frequency]) => ({ type, confidence: frequency }))\\\\n          .sort((a, b) => b.confidence - a.confidence)\\\\n          .slice(0, 3); // 取前3个相关项目\\\\n\\\\n        return relatedRecommendations;\\\\n      },\\\\n      this.CACHE_TTL\\\\n    );\\\\n  }\\\\n}\\\\n\\\\n/**\\\\n * 推荐服务实例\\\\n */\\\\nexport const recommendationService = new RecommendationService();\\\\n\",\"originAcceptText\":\"/**\\n * @file 智能推荐服务\\n * @description 基于订单数据提供洗衣项目推荐功能\\n * @author YYC\\n * @version 1.0.0\\n */\\n\\nimport { LaundryOrder } from '../models/laundry-order.model';\\nimport { redisCacheService } from '../../../lib/cache/redis.service';\\nimport { orderService } from './order.service';\\n\\n/**\\n * 智能推荐服务类\\n */\\nexport class RecommendationService {\\n  private readonly CACHE_KEY_PREFIX = 'recommendations:';\\n  private readonly CACHE_TTL = 3600; // 1小时\\n\\n  /**\\n   * 基于顾客历史订单推荐洗衣项目\\n   * @param customerId 顾客ID\\n   * @returns 推荐的洗衣项目列表\\n   */\\n  async getRecommendationsForCustomer(customerId: string): Promise<Array<{ type: string; confidence: number }>> {\\n    const cacheKey = `${this.CACHE_KEY_PREFIX}customer:${customerId}`;\\n\\n    return await redisCacheService.getWithCache(\\n      cacheKey,\\n      async () => {\\n        // 获取顾客历史订单\\n        const allOrders = await orderService.getAllOrders();\\n        const customerOrders = allOrders.filter(order => order.customerId === customerId);\\n\\n        if (customerOrders.length === 0) {\\n          // 如果没有历史订单，返回热门推荐\\n          return this.getPopularRecommendations();\\n        }\\n\\n        // 分析顾客的洗衣项目偏好\\n        const itemFrequency = this.analyzeItemFrequency(customerOrders);\\n        \\n        // 生成推荐\\n        const recommendations = this.generateRecommendations(itemFrequency);\\n        \\n        return recommendations;\\n      },\\n      this.CACHE_TTL\\n    );\\n  }\\n\\n  /**\\n   * 获取热门推荐\\n   * @returns 热门洗衣项目列表\\n   */\\n  async getPopularRecommendations(): Promise<Array<{ type: string; confidence: number }>> {\\n    const cacheKey = `${this.CACHE_KEY_PREFIX}popular`;\\n\\n    return await redisCacheService.getWithCache(\\n      cacheKey,\\n      async () => {\\n        // 获取所有订单\\n        const allOrders = await orderService.getAllOrders();\\n        \\n        // 分析所有订单的洗衣项目频率\\n        const itemFrequency = this.analyzeItemFrequency(allOrders);\\n        \\n        // 生成热门推荐\\n        const popularItems = Object.entries(itemFrequency)\\n          .map(([type, frequency]) => ({ type, confidence: frequency }))\\n          .sort((a, b) => b.confidence - a.confidence)\\n          .slice(0, 5); // 取前5个热门项目\\n\\n        return popularItems;\\n      },\\n      this.CACHE_TTL * 2 // 热门推荐缓存2小时\\n    );\\n  }\\n\\n  /**\\n   * 分析订单中的洗衣项目频率\\n   * @param orders 订单列表\\n   * @returns 洗衣项目频率映射\\n   */\\n  private analyzeItemFrequency(orders: LaundryOrder[]): Record<string, number> {\\n    const frequency: Record<string, number> = {};\\n\\n    orders.forEach(order => {\\n      order.items.forEach(item => {\\n        frequency[item.type] = (frequency[item.type] || 0) + item.quantity;\\n      });\\n    });\\n\\n    return frequency;\\n  }\\n\\n  /**\\n   * 生成推荐列表\\n   * @param itemFrequency 项目频率映射\\n   * @returns 推荐列表\\n   */\\n  private generateRecommendations(itemFrequency: Record<string, number>): Array<{ type: string; confidence: number }> {\\n    // 计算总频率\\n    const totalFrequency = Object.values(itemFrequency).reduce((sum, freq) => sum + freq, 0);\\n    \\n    // 生成推荐，包含置信度（相对频率）\\n    const recommendations = Object.entries(itemFrequency)\\n      .map(([type, frequency]) => ({\\n        type,\\n        confidence: parseFloat((frequency / totalFrequency).toFixed(3))\\n      }))\\n      .sort((a, b) => b.confidence - a.confidence)\\n      .slice(0, 5); // 取前5个推荐\\n\\n    return recommendations;\\n  }\\n\\n  /**\\n   * 基于当前购物车推荐相关项目\\n   * @param currentItems 当前购物车项目\\n   * @returns 相关推荐项目列表\\n   */\\n  async getRelatedRecommendations(currentItems: Array<{ type: string; quantity: number }>): Promise<Array<{ type: string; confidence: number }>> {\\n    const cacheKey = `${this.CACHE_KEY_PREFIX}related:${JSON.stringify(currentItems.map(item => item.type).sort())}`;\\n\\n    return await redisCacheService.getWithCache(\\n      cacheKey,\\n      async () => {\\n        // 获取所有订单\\n        const allOrders = await orderService.getAllOrders();\\n        \\n        // 分析与当前项目相关的项目\\n        const currentTypes = new Set(currentItems.map(item => item.type));\\n        const relatedItems: Record<string, number> = {};\\n\\n        allOrders.forEach(order => {\\n          const orderTypes = new Set(order.items.map(item => item.type));\\n          \\n          // 检查订单是否包含当前项目\\n          const hasCurrentItems = [...currentTypes].some(type => orderTypes.has(type));\\n          \\n          if (hasCurrentItems) {\\n            // 统计相关项目\\n            order.items.forEach(item => {\\n              if (!currentTypes.has(item.type)) {\\n                relatedItems[item.type] = (relatedItems[item.type] || 0) + item.quantity;\\n              }\\n            });\\n          }\\n        });\\n\\n        // 生成相关推荐\\n        const relatedRecommendations = Object.entries(relatedItems)\\n          .map(([type, frequency]) => ({ type, confidence: frequency }))\\n          .sort((a, b) => b.confidence - a.confidence)\\n          .slice(0, 3); // 取前3个相关项目\\n\\n        return relatedRecommendations;\\n      },\\n      this.CACHE_TTL\\n    );\\n  }\\n}\\n\\n/**\\n * 推荐服务实例\\n */\\nexport const recommendationService = new RecommendationService();\\n\",\"originTextLength\":4852,\"aiScene\":\"Completion\",\"behaviorType\":\"accept\",\"updateTime\":1766162510053}]",
