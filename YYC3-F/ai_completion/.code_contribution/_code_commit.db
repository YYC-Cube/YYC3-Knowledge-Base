haracter\":0},\"end\":{\"line\":386,\"character\":53}},\"modifyRange\":{\"start\":{\"line\":386,\"character\":0},\"end\":{\"line\":386,\"character\":53}},\"action\":\"None\",\"isLine\":false,\"originText\":\"      expect(mockAPI.updateOrderStatus).toBeDefined()\",\"originAcceptText\":\"      expect(mockAPI.updateOrderStatus).toBeDefined()\",\"originTextLength\":53,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768893783300},{\"originRange\":{\"start\":{\"line\":396,\"character\":0},\"end\":{\"line\":396,\"character\":47}},\"modifyRange\":{\"start\":{\"line\":396,\"character\":0},\"end\":{\"line\":396,\"character\":47}},\"action\":\"None\",\"isLine\":false,\"originText\":\"      expect(mockAPI.cancelOrder).toBeDefined()\",\"originAcceptText\":\"      expect(mockAPI.cancelOrder).toBeDefined()\",\"originTextLength\":47,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768893783347},{\"originRange\":{\"start\":{\"line\":406,\"character\":0},\"end\":{\"line\":406,\"character\":46}},\"modifyRange\":{\"start\":{\"line\":406,\"character\":0},\"end\":{\"line\":406,\"character\":46}},\"action\":\"None\",\"isLine\":false,\"originText\":\"      expect(mockAPI.printOrder).toBeDefined()\",\"originAcceptText\":\"      expect(mockAPI.printOrder).toBeDefined()\",\"originTextLength\":46,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768893783379},{\"originRange\":{\"start\":{\"line\":237,\"character\":0},\"end\":{\"line\":237,\"character\":39}},\"modifyRange\":{\"start\":{\"line\":237,\"character\":0},\"end\":{\"line\":237,\"character\":39}},\"action\":\"None\",\"isLine\":false,\"originText\":\"      const mockAPI = OrderAPI.orderAPI\",\"originAcceptText\":\"      const mockAPI = OrderAPI.orderAPI\",\"originTextLength\":39,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768893829063},{\"originRange\":{\"start\":{\"line\":248,\"character\":0},\"end\":{\"line\":248,\"character\":45}},\"modifyRange\":{\"start\":{\"line\":248,\"character\":0},\"end\":{\"line\":248,\"character\":45}},\"action\":\"None\",\"isLine\":false,\"originText\":\"      expect(mockAPI.getOrders).toBeDefined()\",\"originAcceptText\":\"      expect(mockAPI.getOrders).toBeDefined()\",\"originTextLength\":45,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768893829129},{\"originRange\":{\"start\":{\"line\":195,\"character\":0},\"end\":{\"line\":195,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":195,\"character\":0},\"end\":{\"line\":195,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"\",\"originAcceptText\":\"\",\"originTextLength\":0,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768893870034}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/docs/YYC3-Cater-Platform-%E6%96%87%E6%A1%A3%E9%97%AD%E7%8E%AF/YYC3-Cater-%E9%9C%80%E6%B1%82%E8%AE%BE%E8%AE%A1%E6%96%87%E6%A1%A3/%E6%95%B0%E6%8D%AE%E5%88%86%E6%9E%90%E5%8A%9F%E8%83%BD%E6%A8%A1%E5%9D%97%E9%9C%80%E6%B1%82%E5%88%86%E6%9E%90%E4%B8%8E%E8%AE%BE%E8%AE%A1%E6%96%87%E6%A1%A3.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":1299,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":1299,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# 数据分析功能模块需求分析与设计文档\\\\n\\\\n## 1. 模块概述\\\\n\\\\n### 1.1 模块简介\\\\n\\\\n数据分析功能模块是YYC³餐饮平台的核心智能分析系统，提供全方位的业务数据洞察与分析能力。该模块通过收集、处理和分析餐厅运营数据，为管理者提供数据驱动的决策支持，帮助优化运营效率、提升客户满意度、增加营收。\\\\n\\\\n### 1.2 模块目标\\\\n\\\\n- **实时监控**：提供实时业务数据监控，及时掌握运营状态\\\\n- **趋势分析**：分析历史数据趋势，识别业务发展规律\\\\n- **预测分析**：基于机器学习算法预测未来业务趋势\\\\n- **异常预警**：自动识别异常情况，及时预警风险\\\\n- **决策支持**：提供数据驱动的决策建议和优化方案\\\\n- **可视化展示**：通过图表、仪表板直观展示数据分析结果\\\\n\\\\n### 1.3 适用范围\\\\n\\\\n- 餐厅管理者：监控整体运营状况，制定战略决策\\\\n- 运营经理：分析日常运营数据，优化业务流程\\\\n- 市场营销人员：分析客户行为，制定营销策略\\\\n- 财务人员：分析财务数据，进行成本控制\\\\n- 厨房管理人员：分析厨房效率，优化菜品制作\\\\n\\\\n## 2. 功能需求\\\\n\\\\n### 2.1 核心指标展示\\\\n\\\\n#### 2.1.1 收入指标\\\\n\\\\n**功能描述**：展示餐厅收入相关核心指标。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：今天、昨天、本周、上周、本月、上月、本季度、上季度、本年、上年、自定义\\\\n\\\\n**输出结果**：\\\\n- 总收入：选定时间范围内的总收入\\\\n- 日均收入：平均每日收入\\\\n- 收入增长率：与上期相比的增长率\\\\n- 收入趋势：收入变化趋势图\\\\n\\\\n**业务规则**：\\\\n- 支持多币种显示\\\\n- 自动计算增长率\\\\n- 实时更新数据\\\\n- 支持数据导出\\\\n\\\\n#### 2.1.2 订单指标\\\\n\\\\n**功能描述**：展示订单相关核心指标。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：同收入指标\\\\n\\\\n**输出结果**：\\\\n- 订单总数：选定时间范围内的订单总数\\\\n- 日均订单：平均每日订单数\\\\n- 订单增长率：与上期相比的增长率\\\\n- 订单趋势：订单变化趋势图\\\\n- 订单类型分布：堂食、外卖、自提订单占比\\\\n\\\\n**业务规则**：\\\\n- 按订单状态分类统计\\\\n- 支持订单类型筛选\\\\n- 显示订单完成率\\\\n\\\\n#### 2.1.3 客户指标\\\\n\\\\n**功能描述**：展示客户相关核心指标。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：同收入指标\\\\n\\\\n**输出结果**：\\\\n- 客户总数：总客户数\\\\n- 新增客户：新增客户数\\\\n- 活跃客户：活跃客户数\\\\n- 客户增长率：与上期相比的增长率\\\\n- 客户留存率：客户留存率\\\\n\\\\n**业务规则**：\\\\n- 区分新老客户\\\\n- 计算客户活跃度\\\\n- 分析客户生命周期\\\\n\\\\n#### 2.1.4 转化率指标\\\\n\\\\n**功能描述**：展示转化率相关核心指标。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：同收入指标\\\\n\\\\n**输出结果**：\\\\n- 访问转化率：访客到客户的转化率\\\\n- 订单转化率：浏览到下单的转化率\\\\n- 复购率：客户复购率\\\\n- 转化率趋势：转化率变化趋势\\\\n\\\\n**业务规则**：\\\\n- 多维度转化漏斗分析\\\\n- 识别转化瓶颈\\\\n- 提供优化建议\\\\n\\\\n#### 2.1.5 满意度指标\\\\n\\\\n**功能描述**：展示客户满意度相关核心指标。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：同收入指标\\\\n\\\\n**输出结果**：\\\\n- 平均评分：客户平均评分\\\\n- 好评率：好评占比\\\\n- 中评率：中评占比\\\\n- 差评率：差评占比\\\\n- 满意度趋势：满意度变化趋势\\\\n\\\\n**业务规则**：\\\\n- 实时计算满意度\\\\n- 分析评价内容\\\\n- 识别满意度影响因素\\\\n\\\\n#### 2.1.6 效率指标\\\\n\\\\n**功能描述**：展示运营效率相关核心指标。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：同收入指标\\\\n\\\\n**输出结果**：\\\\n- 平均出餐时间：平均出餐时长\\\\n- 订单完成率：订单完成比例\\\\n- 员工效率：员工平均效率\\\\n- 设备利用率：设备使用率\\\\n- 效率趋势：效率变化趋势\\\\n\\\\n**业务规则**：\\\\n- 实时监控效率指标\\\\n- 识别效率瓶颈\\\\n- 提供效率优化建议\\\\n\\\\n### 2.2 销售分析\\\\n\\\\n#### 2.2.1 销售趋势分析\\\\n\\\\n**功能描述**：分析销售数据的时间趋势。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：天、周、月、季、年\\\\n- 对比周期：同比、环比\\\\n- 数据维度：收入、订单量、客单价\\\\n\\\\n**输出结果**：\\\\n- 销售趋势图：折线图展示销售变化\\\\n- 同比分析：与去年同期对比\\\\n- 环比分析：与上期对比\\\\n- 峰值识别：识别销售高峰和低谷\\\\n- 趋势预测：预测未来销售趋势\\\\n\\\\n**业务规则**：\\\\n- 支持多维度对比\\\\n- 自动识别异常点\\\\n- 提供趋势解释\\\\n\\\\n#### 2.2.2 菜品销售排行\\\\n\\\\n**功能描述**：统计菜品销售排行。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：同销售趋势分析\\\\n- 排序方式：销量、收入、利润\\\\n- 分类筛选：菜品分类\\\\n\\\\n**输出结果**：\\\\n- 销量排行：按销量排序的菜品列表\\\\n- 收入排行：按收入排序的菜品列表\\\\n- 利润排行：按利润排序的菜品列表\\\\n- 销售占比：各菜品销售占比\\\\n- 趋势分析：菜品销售趋势\\\\n\\\\n**业务规则**：\\\\n- 实时更新排行\\\\n- 支持多维度排序\\\\n- 分析菜品生命周期\\\\n\\\\n#### 2.2.3 客单价分析\\\\n\\\\n**功能描述**：分析客单价数据。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：同销售趋势分析\\\\n- 客户类型：新客户、老客户、全部客户\\\\n- 订单类型：堂食、外卖、自提\\\\n\\\\n**输出结果**：\\\\n- 平均客单价：平均每单金额\\\\n- 客单价分布：客单价区间分布\\\\n- 客单价趋势：客单价变化趋势\\\\n- 客单价对比：不同类型客单价对比\\\\n\\\\n**业务规则**：\\\\n- 分客户类型分析\\\\n- 分订单类型分析\\\\n- 提供提升客单价建议\\\\n\\\\n#### 2.2.4 促销效果分析\\\\n\\\\n**功能描述**：分析促销活动效果。\\\\n\\\\n**输入参数**：\\\\n- 活动ID：选择促销活动\\\\n- 时间范围：活动时间范围\\\\n- 对比基准：活动前、活动后\\\\n\\\\n**输出结果**：\\\\n- 活动收入：活动期间收入\\\\n- 收入增长：与基准对比增长\\\\n- 订单增长：与基准对比增长\\\\n- ROI分析：投资回报率\\\\n- 客户获取：新客户获取数\\\\n\\\\n**业务规则**：\\\\n- 自动计算ROI\\\\n- 分析活动效果\\\\n- 提供优化建议\\\\n\\\\n#### 2.2.5 销售渠道分析\\\\n\\\\n**功能描述**：分析不同销售渠道表现。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：同销售趋势分析\\\\n- 渠道类型：堂食、外卖、自提、线上\\\\n\\\\n**输出结果**：\\\\n- 渠道收入：各渠道收入\\\\n- 渠道占比：各渠道收入占比\\\\n- 渠道趋势：各渠道收入趋势\\\\n- 渠道效率：各渠道效率对比\\\\n\\\\n**业务规则**：\\\\n- 多渠道对比分析\\\\n- 识别最优渠道\\\\n- 提供渠道优化建议\\\\n\\\\n### 2.3 客户分析\\\\n\\\\n#### 2.3.1 客户画像分析\\\\n\\\\n**功能描述**：构建和分析客户画像。\\\\n\\\\n**输入参数**：\\\\n- 客户ID：选择特定客户\\\\n- 客户群体：按条件筛选客户群体\\\\n- 时间范围：分析时间范围\\\\n\\\\n**输出结果**：\\\\n- 基本信息：年龄、性别、地区\\\\n- 消费习惯：消费频次、消费金额\\\\n- 偏好分析：菜品偏好、口味偏好\\\\n- 行为特征：就餐时间、就餐方式\\\\n- 客户标签：自动生成的客户标签\\\\n\\\\n**业务规则**：\\\\n- 自动生成客户画像\\\\n- 支持群体画像\\\\n- 动态更新画像\\\\n\\\\n#### 2.3.2 客户行为分析\\\\n\\\\n**功能描述**：分析客户行为模式。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：分析时间范围\\\\n- 行为类型：浏览、下单、评价、分享\\\\n- 客户类型：新客户、老客户\\\\n\\\\n**输出结果**：\\\\n- 行为路径：客户行为路径\\\\n- 转化漏斗：行为转化漏斗\\\\n- 留存分析：客户留存率\\\\n- 流失分析：客户流失原因\\\\n\\\\n**业务规则**：\\\\n- 追踪完整行为链\\\\n- 识别关键转化点\\\\n- 分析流失原因\\\\n\\\\n#### 2.3.3 客户分层分析\\\\n\\\\n**功能描述**：对客户进行分层管理。\\\\n\\\\n**输入参数**：\\\\n- 分层模型：RFM模型、自定义模型\\\\n- 分层数量：3层、5层、10层\\\\n- 时间范围：分析时间范围\\\\n\\\\n**输出结果**：\\\\n- 客户分层：各层级客户数量\\\\n- 层级特征：各层级客户特征\\\\n- 贡献分析：各层级贡献度\\\\n- 策略建议：各层级管理策略\\\\n\\\\n**业务规则**：\\\\n- 支持多种分层模型\\\\n- 自动计算分层\\\\n- 提供分层策略\\\\n\\\\n#### 2.3.4 客户生命周期分析\\\\n\\\\n**功能描述**：分析客户生命周期价值。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：分析时间范围\\\\n- 生命周期阶段：获取、激活、留存、流失\\\\n\\\\n**输出结果**：\\\\n- 生命周期分布：各阶段客户数\\\\n- 转化率：阶段间转化率\\\\n- 生命周期价值：客户平均生命周期价值\\\\n- 流失预测：客户流失预测\\\\n\\\\n**业务规则**：\\\\n- 计算CLV（客户生命周期价值）\\\\n- 识别流失风险\\\\n- 提供挽留策略\\\\n\\\\n#### 2.3.5 客户满意度分析\\\\n\\\\n**功能描述**：分析客户满意度数据。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：分析时间范围\\\\n- 评价类型：评分、文字、图片\\\\n- 评价维度：菜品、服务、环境、价格\\\\n\\\\n**输出结果**：\\\\n- 满意度评分：平均满意度评分\\\\n- 评分分布：评分分布情况\\\\n- 情感分析：评价情感倾向\\\\n- 关键词分析：评价关键词提取\\\\n- 问题识别：识别常见问题\\\\n\\\\n**业务规则**：\\\\n- 实时情感分析\\\\n- 自动提取关键词\\\\n- 识别改进点\\\\n\\\\n### 2.4 菜单分析\\\\n\\\\n#### 2.4.1 菜品销售分析\\\\n\\\\n**功能描述**：分析菜品销售数据。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：分析时间范围\\\\n- 菜品分类：按分类筛选\\\\n- 排序方式：销量、收入、利润\\\\n\\\\n**输出结果**：\\\\n- 销售数据：各菜品销售数据\\\\n- 销售趋势：销售趋势图\\\\n- 热销菜品：热销菜品排行\\\\n- 滞销菜品：滞销菜品排行\\\\n- 季节性分析：季节性销售规律\\\\n\\\\n**业务规则**：\\\\n- 实时更新销售数据\\\\n- 识别季节性规律\\\\n- 提供菜单优化建议\\\\n\\\\n#### 2.4.2 菜品利润分析\\\\n\\\\n**功能描述**：分析菜品利润情况。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：分析时间范围\\\\n- 利润类型：毛利、净利\\\\n- 菜品分类：按分类筛选\\\\n\\\\n**输出结果**：\\\\n- 利润数据：各菜品利润数据\\\\n- 利润率：各菜品利润率\\\\n- 利润贡献：各菜品利润贡献度\\\\n- 成本分析：各菜品成本构成\\\\n\\\\n**业务规则**：\\\\n- 计算菜品毛利和净利\\\\n- 分析成本构成\\\\n- 识别高利润菜品\\\\n\\\\n#### 2.4.3 菜品组合分析\\\\n\\\\n**功能描述**：分析菜品组合销售情况。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：分析时间范围\\\\n- 组合类型：搭配、套餐\\\\n\\\\n**输出结果**：\\\\n- 组合销售：菜品组合销售数据\\\\n- 关联规则：菜品关联规则\\\\n- 推荐组合：推荐菜品组合\\\\n- 套餐优化：套餐优化建议\\\\n\\\\n**业务规则**：\\\\n- 使用关联规则算法\\\\n- 识别菜品搭配规律\\\\n- 优化套餐设计\\\\n\\\\n#### 2.4.4 菜品评价分析\\\\n\\\\n**功能描述**：分析菜品评价数据。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：分析时间范围\\\\n- 评价维度：口味、分量、价格、外观\\\\n\\\\n**输出结果**：\\\\n- 评分数据：各菜品评分\\\\n- 评价趋势：评价趋势\\\\n- 好评菜品：好评菜品排行\\\\n- 差评菜品：差评菜品排行\\\\n- 改进建议：菜品改进建议\\\\n\\\\n**业务规则**：\\\\n- 实时分析评价\\\\n- 识别问题菜品\\\\n- 提供改进建议\\\\n\\\\n#### 2.4.5 菜单优化建议\\\\n\\\\n**功能描述**：提供菜单优化建议。\\\\n\\\\n**输入参数**：\\\\n- 优化目标：提升销量、提升利润、提升满意度\\\\n- 限制条件：成本、库存、季节\\\\n\\\\n**输出结果**：\\\\n- 新增建议：建议新增菜品\\\\n- 删除建议：建议删除菜品\\\\n- 调整建议：建议调整菜品\\\\n- 定价建议：建议定价策略\\\\n- 推广建议：建议推广菜品\\\\n\\\\n**业务规则**：\\\\n- 基于数据分析\\\\n- 考虑多种因素\\\\n- 提供可执行建议\\\\n\\\\n### 2.5 运营分析\\\\n\\\\n#### 2.5.1 订单完成时间分析\\\\n\\\\n**功能描述**：分析订单完成时间。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：分析时间范围\\\\n- 订单类型：堂食、外卖、自提\\\\n- 时间段：按时间段分析\\\\n\\\\n**输出结果**：\\\\n- 平均完成时间：平均订单完成时长\\\\n- 时间分布：完成时间分布\\\\n- 超时分析：超时订单分析\\\\n- 效率对比：不同类型订单效率对比\\\\n- 改进建议：效率改进建议\\\\n\\\\n**业务规则**：\\\\n- 实时监控完成时间\\\\n- 识别超时订单\\\\n- 分析效率瓶颈\\\\n\\\\n#### 2.5.2 厨房效率分析\\\\n\\\\n**功能描述**：分析厨房运营效率。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：分析时间范围\\\\n- 工作站：按工作站分析\\\\n- 员工：按员工分析\\\\n\\\\n**输出结果**：\\\\n- 工作站效率：各工作站效率\\\\n- 员工效率：各员工效率\\\\n- 任务分布：任务分布情况\\\\n- 瓶颈识别：识别效率瓶颈\\\\n- 优化建议：效率优化建议\\\\n\\\\n**业务规则**：\\\\n- 实时监控效率\\\\n- 识别瓶颈环节\\\\n- 提供优化方案\\\\n\\\\n#### 2.5.3 库存周转分析\\\\n\\\\n**功能描述**：分析库存周转情况。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：分析时间范围\\\\n- 物料类型：按物料类型分析\\\\n\\\\n**输出结果**：\\\\n- 周转率：库存周转率\\\\n- 周转天数：库存周转天数\\\\n- 库存结构：库存结构分析\\\\n- 滞销物料：滞销物料识别\\\\n- 补货建议：补货建议\\\\n\\\\n**业务规则**：\\\\n- 计算周转率\\\\n- 识别滞销物料\\\\n- 优化库存结构\\\\n\\\\n#### 2.5.4 人员效率分析\\\\n\\\\n**功能描述**：分析员工工作效率。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：分析时间范围\\\\n- 员工类型：厨师、服务员、收银员\\\\n- 考核指标：任务完成、客户满意度\\\\n\\\\n**输出结果**：\\\\n- 效率排名：员工效率排名\\\\n- 任务完成：任务完成情况\\\\n- 客户评价：客户评价数据\\\\n- 工作时长：工作时长统计\\\\n- 培训建议：培训需求建议\\\\n\\\\n**业务规则**：\\\\n- 多维度评估员工\\\\n- 识别优秀员工\\\\n- 提供培训建议\\\\n\\\\n#### 2.5.5 成本分析\\\\n\\\\n**功能描述**：分析运营成本。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：分析时间范围\\\\n- 成本类型：食材成本、人工成本、运营成本\\\\n- 对比基准：预算、上期\\\\n\\\\n**输出结果**：\\\\n- 成本总额：总成本\\\\n- 成本结构：成本构成分析\\\\n- 成本率：成本率分析\\\\n- 成本趋势：成本变化趋势\\\\n- 节约建议：成本节约建议\\\\n\\\\n**业务规则**：\\\\n- 分类统计成本\\\\n- 计算成本率\\\\n- 识别节约空间\\\\n\\\\n### 2.6 预测分析\\\\n\\\\n#### 2.6.1 销量预测\\\\n\\\\n**功能描述**：预测未来销量。\\\\n\\\\n**输入参数**：\\\\n- 预测周期：天、周、月、季\\\\n- 预测对象：整体销量、菜品销量\\\\n- 影响因素：节假日、促销、天气\\\\n\\\\n**输出结果**：\\\\n- 预测销量：预测的销量数据\\\\n- 置信区间：预测置信区间\\\\n- 影响因素：影响因素分析\\\\n- 准确度：历史预测准确度\\\\n\\\\n**业务规则**：\\\\n- 使用机器学习模型\\\\n- 考虑多种因素\\\\n- 提供置信区间\\\\n\\\\n#### 2.6.2 客户预测\\\\n\\\\n**功能描述**：预测客户行为。\\\\n\\\\n**输入参数**：\\\\n- 预测类型：新增客户、流失客户、活跃客户\\\\n- 预测周期：天、周、月\\\\n- 客户群体：按群体预测\\\\n\\\\n**输出结果**：\\\\n- 预测数量：预测的客户数量\\\\n- 流失风险：客户流失风险\\\\n- 活跃度预测：客户活跃度预测\\\\n- 挽留建议：客户挽留建议\\\\n\\\\n**业务规则**：\\\\n- 预测客户行为\\\\n- 识别流失风险\\\\n- 提供挽留策略\\\\n\\\\n#### 2.6.3 需求预测\\\\n\\\\n**功能描述**：预测物料需求。\\\\n\\\\n**输入参数**：\\\\n- 预测周期：天、周、月\\\\n- 物料类型：按物料类型预测\\\\n- 影响因素：销量、季节、促销\\\\n\\\\n**输出结果**：\\\\n- 需求量：预测的物料需求量\\\\n- 采购建议：采购建议\\\\n- 库存建议：库存建议\\\\n- 成本预测：成本预测\\\\n\\\\n**业务规则**：\\\\n- 基于销量预测\\\\n- 考虑安全库存\\\\n- 优化采购计划\\\\n\\\\n#### 2.6.4 收入预测\\\\n\\\\n**功能描述**：预测未来收入。\\\\n\\\\n**输入参数**：\\\\n- 预测周期：天、周、月、季\\\\n- 收入类型：总收入、各渠道收入\\\\n- 影响因素：促销、季节、节假日\\\\n\\\\n**输出结果**：\\\\n- 预测收入：预测的收入数据\\\\n- 收入趋势：收入趋势预测\\\\n- 达成率：目标达成率预测\\\\n- 策略建议：达成策略建议\\\\n\\\\n**业务规则**：\\\\n- 综合多种因素\\\\n- 提供达成策略\\\\n- 支持目标管理\\\\n\\\\n### 2.7 异常预警\\\\n\\\\n#### 2.7.1 销售异常预警\\\\n\\\\n**功能描述**：监控销售数据异常。\\\\n\\\\n**输入参数**：\\\\n- 监控指标：收入、订单量、客单价\\\\n- 异常阈值：自定义阈值\\\\n- 通知方式：邮件、短信、系统通知\\\\n\\\\n**输出结果**：\\\\n- 异常识别：识别异常数据\\\\n- 异常类型：异常类型分类\\\\n- 异常原因：异常原因分析\\\\n- 处理建议：异常处理建议\\\\n\\\\n**业务规则**：\\\\n- 实时监控数据\\\\n- 自动识别异常\\\\n- 及时发送预警\\\\n\\\\n#### 2.7.2 库存异常预警\\\\n\\\\n**功能描述**：监控库存异常情况。\\\\n\\\\n**输入参数**：\\\\n- 监控指标：库存量、周转率、过期\\\\n- 异常阈值：自定义阈值\\\\n- 通知方式：邮件、短信、系统通知\\\\n\\\\n**输出结果**：\\\\n- 异常识别：识别库存异常\\\\n- 异常类型：缺货、积压、过期\\\\n- 处理建议：处理建议\\\\n\\\\n**业务规则**：\\\\n- 实时监控库存\\\\n- 识别风险物料\\\\n- 及时预警处理\\\\n\\\\n#### 2.7.3 客户异常预警\\\\n\\\\n**功能描述**：监控客户异常行为。\\\\n\\\\n**输入参数**：\\\\n- 监控指标：流失、投诉、异常订单\\\\n- 异常阈值：自定义阈值\\\\n- 通知方式：邮件、短信、系统通知\\\\n\\\\n**输出结果**：\\\\n- 异常识别：识别客户异常\\\\n- 风险评估：客户风险评估\\\\n- 挽留建议：客户挽留建议\\\\n\\\\n**业务规则**：\\\\n- 监控客户行为\\\\n- 识别流失风险\\\\n- 及时挽留客户\\\\n\\\\n#### 2.7.4 运营异常预警\\\\n\\\\n**功能描述**：监控运营异常情况。\\\\n\\\\n**输入参数**：\\\\n- 监控指标：效率、质量、成本\\\\n- 异常阈值：自定义阈值\\\\n- 通知方式：邮件、短信、系统通知\\\\n\\\\n**输出结果**：\\\\n- 异常识别：识别运营异常\\\\n- 异常类型：效率异常、质量异常、成本异常\\\\n- 处理建议：处理建议\\\\n\\\\n**业务规则**：\\\\n- 实时监控运营\\\\n- 识别异常情况\\\\n- 及时处理问题\\\\n\\\\n### 2.8 自定义仪表板\\\\n\\\\n#### 2.8.1 仪表板配置\\\\n\\\\n**功能描述**：自定义仪表板布局。\\\\n\\\\n**输入参数**：\\\\n- 仪表板名称：自定义名称\\\\n- 布局方式：网格布局、自由布局\\\\n- 组件选择：选择显示组件\\\\n- 组件配置：配置组件参数\\\\n\\\\n**输出结果**：\\\\n- 自定义仪表板：个性化仪表板\\\\n- 组件展示：按配置展示组件\\\\n- 数据刷新：按配置刷新数据\\\\n\\\\n**业务规则**：\\\\n- 支持多个仪表板\\\\n- 灵活布局组件\\\\n- 保存配置方案\\\\n\\\\n#### 2.8.2 组件管理\\\\n\\\\n**功能描述**：管理仪表板组件。\\\\n\\\\n**输入参数**：\\\\n- 组件类型：图表、指标、表格\\\\n- 组件配置：配置组件参数\\\\n- 数据源：选择数据源\\\\n\\\\n**输出结果**：\\\\n- 组件列表：可用组件列表\\\\n- 组件预览：组件预览效果\\\\n- 组件配置：配置组件参数\\\\n\\\\n**业务规则**：\\\\n- 提供丰富组件\\\\n- 支持灵活配置\\\\n- 实时预览效果\\\\n\\\\n#### 2.8.3 数据导出\\\\n\\\\n**功能描述**：导出分析数据。\\\\n\\\\n**输入参数**：\\\\n- 导出格式：Excel、PDF、CSV\\\\n- 导出范围：当前视图、自定义范围\\\\n- 数据内容：选择导出数据\\\\n\\\\n**输出结果**：\\\\n- 导出文件：生成的导出文件\\\\n- 导出记录：导出历史记录\\\\n\\\\n**业务规则**：\\\\n- 支持多种格式\\\\n- 灵活选择数据\\\\n- 记录导出历史\\\\n\\\\n## 3. 非功能需求\\\\n\\\\n### 3.1 性能需求\\\\n\\\\n- **响应时间**：页面加载时间不超过2秒，数据查询响应时间不超过1秒\\\\n- **并发处理**：支持至少100个并发用户同时访问\\\\n- **数据处理**：支持处理百万级数据量\\\\n- **实时性**：数据延迟不超过5秒\\\\n\\\\n### 3.2 可用性需求\\\\n\\\\n- **易用性**：界面简洁直观，操作流程清晰\\\\n- **可访问性**：支持键盘导航和屏幕阅读器\\\\n- **多语言**：支持中英文切换\\\\n- **响应式设计**：支持PC、平板、手机访问\\\\n\\\\n### 3.3 安全需求\\\\n\\\\n- **数据加密**：敏感数据加密存储\\\\n- **访问控制**：基于角色的访问控制\\\\n- **审计日志**：记录所有操作日志\\\\n- **数据备份**：定期备份数据\\\\n\\\\n### 3.4 兼容性需求\\\\n\\\\n- **浏览器兼容**：支持Chrome、Firefox、Safari、Edge最新版本\\\\n- **设备兼容**：支持Windows、macOS、iOS、Android\\\\n- **分辨率**：支持1920x1080及以上分辨率\\\\n\\\\n## 4. 接口设计\\\\n\\\\n### 4.1 核心指标接口\\\\n\\\\n```typescript\\\\n// 获取核心指标\\\\nGET /api/v1/analytics/metrics\\\\nQuery Parameters:\\\\n  - dateRange: string (today, yesterday, this_week, last_week, this_month, last_month, this_quarter, last_quarter, this_year, last_year, custom)\\\\n  - startDate: string (当dateRange为custom时必填)\\\\n  - endDate: string (当dateRange为custom时必填)\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"revenue\\\\\\\": {\\\\n      \\\\\\\"total\\\\\\\": 100000,\\\\n      \\\\\\\"daily\\\\\\\": 3333.33,\\\\n      \\\\\\\"growth\\\\\\\": 15.5\\\\n    },\\\\n    \\\\\\\"orders\\\\\\\": {\\\\n      \\\\\\\"total\\\\\\\": 500,\\\\n      \\\\\\\"daily\\\\\\\": 16.67,\\\\n      \\\\\\\"growth\\\\\\\": 8.2\\\\n    },\\\\n    \\\\\\\"customers\\\\\\\": {\\\\n      \\\\\\\"total\\\\\\\": 200,\\\\n      \\\\\\\"new\\\\\\\": 50,\\\\n      \\\\\\\"growth\\\\\\\": 12.3\\\\n    },\\\\n    \\\\\\\"conversion\\\\\\\": {\\\\n      \\\\\\\"rate\\\\\\\": 3.5,\\\\n      \\\\\\\"growth\\\\\\\": 2.1\\\\n    },\\\\n    \\\\\\\"satisfaction\\\\\\\": {\\\\n      \\\\\\\"score\\\\\\\": 4.5,\\\\n      \\\\\\\"positiveRate\\\\\\\": 85,\\\\n      \\\\\\\"growth\\\\\\\": 5.6\\\\n    },\\\\n    \\\\\\\"efficiency\\\\\\\": {\\\\n      \\\\\\\"prepTime\\\\\\\": 15,\\\\n      \\\\\\\"completionRate\\\\\\\": 98,\\\\n      \\\\\\\"growth\\\\\\\": 3.2\\\\n    }\\\\n  }\\\\n}\\\\n```\\\\n\\\\n### 4.2 销售分析接口\\\\n\\\\n```typescript\\\\n// 获取销售趋势\\\\nGET /api/v1/analytics/sales/trend\\\\nQuery Parameters:\\\\n  - dateRange: string\\\\n  - startDate: string\\\\n  - endDate: string\\\\n  - dimension: string (revenue, orders, average_order_value)\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"trend\\\\\\\": [\\\\n      { \\\\\\\"date\\\\\\\": \\\\\\\"2025-01-01\\\\\\\", \\\\\\\"value\\\\\\\": 10000 },\\\\n      { \\\\\\\"date\\\\\\\": \\\\\\\"2025-01-02\\\\\\\", \\\\\\\"value\\\\\\\": 12000 }\\\\n    ],\\\\n    \\\\\\\"comparison\\\\\\\": {\\\\n      \\\\\\\"yoy\\\\\\\": 15.5,\\\\n      \\\\\\\"mom\\\\\\\": 8.2\\\\n    }\\\\n  }\\\\n}\\\\n\\\\n// 获取菜品销售排行\\\\nGET /api/v1/analytics/sales/menu-ranking\\\\nQuery Parameters:\\\\n  - dateRange: string\\\\n  - sortBy: string (quantity, revenue, profit)\\\\n  - category: string\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"items\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"menuId\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n        \\\\\\\"name\\\\\\\": \\\\\\\"宫保鸡丁\\\\\\\",\\\\n        \\\\\\\"quantity\\\\\\\": 500,\\\\n        \\\\\\\"revenue\\\\\\\": 25000,\\\\n        \\\\\\\"profit\\\\\\\": 12500,\\\\n        \\\\\\\"growth\\\\\\\": 15.5\\\\n      }\\\\n    ]\\\\n  }\\\\n}\\\\n```\\\\n\\\\n### 4.3 客户分析接口\\\\n\\\\n```typescript\\\\n// 获取客户画像\\\\nGET /api/v1/analytics/customer/profile\\\\nQuery Parameters:\\\\n  - customerId: string\\\\n  - segment: string\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"basicInfo\\\\\\\": {\\\\n      \\\\\\\"age\\\\\\\": 30,\\\\n      \\\\\\\"gender\\\\\\\": \\\\\\\"male\\\\\\\",\\\\n      \\\\\\\"location\\\\\\\": \\\\\\\"北京\\\\\\\"\\\\n    },\\\\n    \\\\\\\"consumption\\\\\\\": {\\\\n      \\\\\\\"frequency\\\\\\\": 10,\\\\n      \\\\\\\"amount\\\\\\\": 5000,\\\\n      \\\\\\\"avgOrderValue\\\\\\\": 500\\\\n    },\\\\n    \\\\\\\"preferences\\\\\\\": {\\\\n      \\\\\\\"favoriteDishes\\\\\\\": [\\\\\\\"宫保鸡丁\\\\\\\", \\\\\\\"麻婆豆腐\\\\\\\"],\\\\n      \\\\\\\"taste\\\\\\\": \\\\\\\"medium\\\\\\\",\\\\n      \\\\\\\"dietary\\\\\\\": \\\\\\\"none\\\\\\\"\\\\n    },\\\\n    \\\\\\\"tags\\\\\\\": [\\\\\\\"高价值客户\\\\\\\", \\\\\\\"忠诚客户\\\\\\\"]\\\\n  }\\\\n}\\\\n\\\\n// 获取客户分层\\\\nGET /api/v1/analytics/customer/segmentation\\\\nQuery Parameters:\\\\n  - model: string (rfm, custom)\\\\n  - segments: number\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"segments\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"name\\\\\\\": \\\\\\\"VIP客户\\\\\\\",\\\\n        \\\\\\\"count\\\\\\\": 50,\\\\n        \\\\\\\"characteristics\\\\\\\": \\\\\\\"高消费、高频率\\\\\\\",\\\\n        \\\\\\\"strategy\\\\\\\": \\\\\\\"提供专属服务\\\\\\\"\\\\n      }\\\\n    ]\\\\n  }\\\\n}\\\\n```\\\\n\\\\n### 4.4 菜单分析接口\\\\n\\\\n```typescript\\\\n// 获取菜品分析\\\\nGET /api/v1/analytics/menu/analysis\\\\nQuery Parameters:\\\\n  - dateRange: string\\\\n  - category: string\\\\n  - sortBy: string\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"items\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"menuId\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n        \\\\\\\"name\\\\\\\": \\\\\\\"宫保鸡丁\\\\\\\",\\\\n        \\\\\\\"quantity\\\\\\\": 500,\\\\n        \\\\\\\"revenue\\\\\\\": 25000,\\\\n        \\\\\\\"profit\\\\\\\": 12500,\\\\n        \\\\\\\"profitRate\\\\\\\": 50,\\\\n        \\\\\\\"rating\\\\\\\": 4.5,\\\\n        \\\\\\\"trend\\\\\\\": \\\\\\\"up\\\\\\\"\\\\n      }\\\\n    ]\\\\n  }\\\\n}\\\\n\\\\n// 获取菜单优化建议\\\\nGET /api/v1/analytics/menu/optimization\\\\nQuery Parameters:\\\\n  - goal: string (increase_sales, increase_profit, increase_satisfaction)\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"add\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"name\\\\\\\": \\\\\\\"新菜品A\\\\\\\",\\\\n        \\\\\\\"reason\\\\\\\": \\\\\\\"市场需求高\\\\\\\",\\\\n        \\\\\\\"expectedRevenue\\\\\\\": 5000\\\\n      }\\\\n    ],\\\\n    \\\\\\\"remove\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"name\\\\\\\": \\\\\\\"滞销菜品B\\\\\\\",\\\\n        \\\\\\\"reason\\\\\\\": \\\\\\\"销量低、利润低\\\\\\\",\\\\n        \\\\\\\"impact\\\\\\\": \\\\\\\"minimal\\\\\\\"\\\\n      }\\\\n    ],\\\\n    \\\\\\\"adjust\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"name\\\\\\\": \\\\\\\"菜品C\\\\\\\",\\\\n        \\\\\\\"adjustment\\\\\\\": \\\\\\\"降低价格\\\\\\\",\\\\n        \\\\\\\"reason\\\\\\\": \\\\\\\"价格偏高\\\\\\\"\\\\n      }\\\\n    ]\\\\n  }\\\\n}\\\\n```\\\\n\\\\n### 4.5 运营分析接口\\\\n\\\\n```typescript\\\\n// 获取运营效率\\\\nGET /api/v1/analytics/operational/efficiency\\\\nQuery Parameters:\\\\n  - dateRange: string\\\\n  - type: string (kitchen, staff, inventory)\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"kitchen\\\\\\\": {\\\\n      \\\\\\\"avgPrepTime\\\\\\\": 15,\\\\n      \\\\\\\"completionRate\\\\\\\": 98,\\\\n      \\\\\\\"stations\\\\\\\": [\\\\n        {\\\\n          \\\\\\\"name\\\\\\\": \\\\\\\"热菜\\\\\\\",\\\\n          \\\\\\\"efficiency\\\\\\\": 95,\\\\n          \\\\\\\"bottleneck\\\\\\\": false\\\\n        }\\\\n      ]\\\\n    },\\\\n    \\\\\\\"staff\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"staffId\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n        \\\\\\\"name\\\\\\\": \\\\\\\"张三\\\\\\\",\\\\n        \\\\\\\"efficiency\\\\\\\": 95,\\\\n        \\\\\\\"tasksCompleted\\\\\\\": 100,\\\\n        \\\\\\\"rating\\\\\\\": 4.5\\\\n      }\\\\n    ],\\\\n    \\\\\\\"inventory\\\\\\\": {\\\\n      \\\\\\\"turnoverRate\\\\\\\": 12,\\\\n      \\\\\\\"turnoverDays\\\\\\\": 30,\\\\n      \\\\\\\"slowMoving\\\\\\\": [\\\\n        {\\\\n          \\\\\\\"itemId\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n          \\\\\\\"name\\\\\\\": \\\\\\\"物料A\\\\\\\",\\\\n          \\\\\\\"turnoverDays\\\\\\\": 90\\\\n        }\\\\n      ]\\\\n    }\\\\n  }\\\\n}\\\\n```\\\\n\\\\n### 4.6 预测分析接口\\\\n\\\\n```typescript\\\\n// 获取销量预测\\\\nGET /api/v1/analytics/prediction/sales\\\\nQuery Parameters:\\\\n  - period: string (day, week, month, quarter)\\\\n  - horizon: number\\\\n  - factors: array\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"predictions\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"date\\\\\\\": \\\\\\\"2025-01-21\\\\\\\",\\\\n        \\\\\\\"value\\\\\\\": 10000,\\\\n        \\\\\\\"confidence\\\\\\\": {\\\\n          \\\\\\\"lower\\\\\\\": 9000,\\\\n          \\\\\\\"upper\\\\\\\": 11000\\\\n        }\\\\n      }\\\\n    ],\\\\n    \\\\\\\"accuracy\\\\\\\": 85,\\\\n    \\\\\\\"factors\\\\\\\": {\\\\n      \\\\\\\"holiday\\\\\\\": 0.1,\\\\n      \\\\\\\"promotion\\\\\\\": 0.15,\\\\n      \\\\\\\"weather\\\\\\\": 0.05\\\\n    }\\\\n  }\\\\n}\\\\n\\\\n// 获取需求预测\\\\nGET /api/v1/analytics/prediction/demand\\\\nQuery Parameters:\\\\n  - period: string\\\\n  - itemId: string\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"demand\\\\\\\": 1000,\\\\n    \\\\\\\"recommendation\\\\\\\": {\\\\n      \\\\\\\"purchase\\\\\\\": 1200,\\\\n      \\\\\\\"safetyStock\\\\\\\": 200,\\\\n      \\\\\\\"expectedCost\\\\\\\": 6000\\\\n    }\\\\n  }\\\\n}\\\\n```\\\\n\\\\n### 4.7 异常预警接口\\\\n\\\\n```typescript\\\\n// 获取异常预警\\\\nGET /api/v1/analytics/alerts\\\\nQuery Parameters:\\\\n  - type: string (sales, inventory, customer, operational)\\\\n  - status: string (active, resolved, all)\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"alerts\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"id\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n        \\\\\\\"type\\\\\\\": \\\\\\\"sales\\\\\\\",\\\\n        \\\\\\\"severity\\\\\\\": \\\\\\\"high\\\\\\\",\\\\n        \\\\\\\"message\\\\\\\": \\\\\\\"销售额下降30%\\\\\\\",\\\\n        \\\\\\\"timestamp\\\\\\\": \\\\\\\"2025-01-20T10:00:00Z\\\\\\\",\\\\n        \\\\\\\"cause\\\\\\\": \\\\\\\"促销活动结束\\\\\\\",\\\\n        \\\\\\\"recommendation\\\\\\\": \\\\\\\"启动新促销活动\\\\\\\"\\\\n      }\\\\n    ]\\\\n  }\\\\n}\\\\n\\\\n// 更新预警状态\\\\nPATCH /api/v1/analytics/alerts/:id\\\\nBody:\\\\n{\\\\n  \\\\\\\"status\\\\\\\": \\\\\\\"resolved\\\\\\\",\\\\n  \\\\\\\"note\\\\\\\": \\\\\\\"已处理\\\\\\\"\\\\n}\\\\n```\\\\n\\\\n## 5. 数据模型\\\\n\\\\n### 5.1 核心指标模型\\\\n\\\\n```typescript\\\\ninterface CoreMetrics {\\\\n  revenue: RevenueMetrics;\\\\n  orders: OrderMetrics;\\\\n  customers: CustomerMetrics;\\\\n  conversion: ConversionMetrics;\\\\n  satisfaction: SatisfactionMetrics;\\\\n  efficiency: EfficiencyMetrics;\\\\n}\\\\n\\\\ninterface RevenueMetrics {\\\\n  total: number;\\\\n  daily: number;\\\\n  growth: number;\\\\n  trend: TrendData[];\\\\n}\\\\n\\\\ninterface OrderMetrics {\\\\n  total: number;\\\\n  daily: number;\\\\n  growth: number;\\\\n  typeDistribution: OrderTypeDistribution;\\\\n  trend: TrendData[];\\\\n}\\\\n\\\\ninterface CustomerMetrics {\\\\n  total: number;\\\\n  new: number;\\\\n  active: number;\\\\n  growth: number;\\\\n  retentionRate: number;\\\\n}\\\\n\\\\ninterface ConversionMetrics {\\\\n  rate: number;\\\\n  visitToOrder: number;\\\\n  repeatRate: number;\\\\n  trend: TrendData[];\\\\n}\\\\n\\\\ninterface SatisfactionMetrics {\\\\n  score: number;\\\\n  positiveRate: number;\\\\n  neutralRate: number;\\\\n  negativeRate: number;\\\\n  trend: TrendData[];\\\\n}\\\\n\\\\ninterface EfficiencyMetrics {\\\\n  avgPrepTime: number;\\\\n  completionRate: number;\\\\n  staffEfficiency: number;\\\\n  equipmentUtilization: number;\\\\n  trend: TrendData[];\\\\n}\\\\n```\\\\n\\\\n### 5.2 销售分析模型\\\\n\\\\n```typescript\\\\ninterface SalesTrend {\\\\n  date: string;\\\\n  value: number;\\\\n  comparison?: {\\\\n    yoy: number;\\\\n    mom: number;\\\\n  };\\\\n}\\\\n\\\\ninterface MenuRanking {\\\\n  menuId: string;\\\\n  name: string;\\\\n  quantity: number;\\\\n  revenue: number;\\\\n  profit: number;\\\\n  growth: number;\\\\n  rank: number;\\\\n}\\\\n\\\\ninterface PromotionEffect {\\\\n  promotionId: string;\\\\n  name: string;\\\\n  revenue: number;\\\\n  revenueGrowth: number;\\\\n  orderGrowth: number;\\\\n  roi: number;\\\\n  newCustomers: number;\\\\n}\\\\n```\\\\n\\\\n### 5.3 客户分析模型\\\\n\\\\n```typescript\\\\ninterface CustomerProfile {\\\\n  customerId: string;\\\\n  basicInfo: BasicInfo;\\\\n  consumption: ConsumptionInfo;\\\\n  preferences: PreferenceInfo;\\\\n  behavior: BehaviorInfo;\\\\n  tags: string[];\\\\n  lifecycle: LifecycleInfo;\\\\n}\\\\n\\\\ninterface BasicInfo {\\\\n  age?: number;\\\\n  gender?: string;\\\\n  location?: string;\\\\n  registerDate: string;\\\\n}\\\\n\\\\ninterface ConsumptionInfo {\\\\n  totalAmount: number;\\\\n  orderCount: number;\\\\n  avgOrderValue: number;\\\\n  frequency: number;\\\\n  lastOrderDate: string;\\\\n}\\\\n\\\\ninterface PreferenceInfo {\\\\n  favoriteDishes: string[];\\\\n  taste: string;\\\\n  dietary: string[];\\\\n  priceRange: string;\\\\n}\\\\n\\\\ninterface BehaviorInfo {\\\\n  visitPatterns: VisitPattern[];\\\\n  orderTypes: OrderType[];\\\\n  peakHours: number[];\\\\n}\\\\n\\\\ninterface LifecycleInfo {\\\\n  stage: string;\\\\n  value: number;\\\\n  churnRisk: number;\\\\n  predictedLifetime: number;\\\\n}\\\\n```\\\\n\\\\n### 5.4 菜单分析模型\\\\n\\\\n```typescript\\\\ninterface MenuAnalysis {\\\\n  menuId: string;\\\\n  name: string;\\\\n  category: string;\\\\n  quantity: number;\\\\n  revenue: number;\\\\n  profit: number;\\\\n  profitRate: number;\\\\n  cost: number;\\\\n  rating: number;\\\\n  trend: string;\\\\n  seasonality: SeasonalityInfo;\\\\n}\\\\n\\\\ninterface MenuCombination {\\\\n  items: string[];\\\\n  frequency: number;\\\\n  confidence: number;\\\\n  revenue: number;\\\\n}\\\\n\\\\ninterface MenuOptimization {\\\\n  add: OptimizationSuggestion[];\\\\n  remove: OptimizationSuggestion[];\\\\n  adjust: OptimizationSuggestion[];\\\\n  pricing: PricingSuggestion[];\\\\n}\\\\n\\\\ninterface OptimizationSuggestion {\\\\n  name: string;\\\\n  reason: string;\\\\n  impact: string;\\\\n  expectedRevenue?: number;\\\\n}\\\\n```\\\\n\\\\n### 5.5 预测分析模型\\\\n\\\\n```typescript\\\\ninterface SalesPrediction {\\\\n  date: string;\\\\n  value: number;\\\\n  confidence: {\\\\n    lower: number;\\\\n    upper: number;\\\\n  };\\\\n  factors: FactorAnalysis;\\\\n}\\\\n\\\\ninterface CustomerPrediction {\\\\n  type: string;\\\\n  count: number;\\\\n  confidence: number;\\\\n  riskLevel: string;\\\\n  recommendations: string[];\\\\n}\\\\n\\\\ninterface DemandPrediction {\\\\n  itemId: string;\\\\n  itemName: string;\\\\n  demand: number;\\\\n  recommendation: {\\\\n    purchase: number;\\\\n    safetyStock: number;\\\\n    expectedCost: number;\\\\n  };\\\\n}\\\\n\\\\ninterface FactorAnalysis {\\\\n  holiday: number;\\\\n  promotion: number;\\\\n  weather: number;\\\\n  season: number;\\\\n  other: number;\\\\n}\\\\n```\\\\n\\\\n### 5.6 异常预警模型\\\\n\\\\n```typescript\\\\ninterface Alert {\\\\n  id: string;\\\\n  type: AlertType;\\\\n  severity: AlertSeverity;\\\\n  message: string;\\\\n  timestamp: string;\\\\n  cause?: string;\\\\n  recommendation?: string;\\\\n  status: AlertStatus;\\\\n  resolvedAt?: string;\\\\n  resolvedBy?: string;\\\\n  note?: string;\\\\n}\\\\n\\\\nenum AlertType {\\\\n  SALES = \\\\'sales\\\\',\\\\n  INVENTORY = \\\\'inventory\\\\',\\\\n  CUSTOMER = \\\\'customer\\\\',\\\\n  OPERATIONAL = \\\\'operational\\\\'\\\\n}\\\\n\\\\nenum AlertSeverity {\\\\n  LOW = \\\\'low\\\\',\\\\n  MEDIUM = \\\\'medium\\\\',\\\\n  HIGH = \\\\'high\\\\',\\\\n  CRITICAL = \\\\'critical\\\\'\\\\n}\\\\n\\\\nenum AlertStatus {\\\\n  ACTIVE = \\\\'active\\\\',\\\\n  RESOLVED = \\\\'resolved\\\\',\\\\n  DISMISSED = \\\\'dismissed\\\\'\\\\n}\\\\n```\\\\n\\\\n## 6. 用户界面设计\\\\n\\\\n### 6.1 主界面布局\\\\n\\\\n```\\\\n┌─────────────────────────────────────────────────────────────┐\\\\n│  数据分析                                              │\\\\n│  全方位的业务数据洞察与分析                                │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  [今天▼] [刷新数据] [导出报告] [仪表板设置]            │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  ┌─────────┐ ┌─────────┐ ┌─────────┐ ┌─────────┐    │\\\\n│  │ ¥100,000│ │ 500     │ │ 200     │ │ 3.5%    │    │\\\\n│  │ 收入    │ │ 订单    │ │ 客户    │ │ 转化率  │    │\\\\n│  │ ↑15.5%  │ │ ↑8.2%   │ │ ↑12.3%  │ │ ↑2.1%   │    │\\\\n│  └─────────┘ └─────────┘ └─────────┘ └─────────┘    │\\\\n│  ┌─────────┐ ┌─────────┐                              │\\\\n│  │ 4.5     │ │ 15分钟  │                              │\\\\n│  │ 满意度  │ │ 平均出餐│                              │\\\\n│  │ ↑5.6%   │ │ ↑3.2%   │                              │\\\\n│  └─────────┘ └─────────┘                              │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  [销售分析] [客户分析] [菜单分析] [运营分析]           │\\\\n│  [预测分析] [异常预警] [自定义仪表板]                   │\\\\n└─────────────────────────────────────────────────────────────┘\\\\n```\\\\n\\\\n### 6.2 销售分析界面\\\\n\\\\n```\\\\n┌─────────────────────────────────────────────────────────────┐\\\\n│  销售分析                                              │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  [本周▼] [收入▼] [对比▼]                              │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  ┌─────────────────────────────────────────────────────┐   │\\\\n│  │  销售趋势图                                    │   │\\\\n│  │  ¥100k ┤                                     │   │\\\\n│  │         │    ╭────╮                             │   │\\\\n│  │  ¥80k  │   ╱      ╲                            │   │\\\\n│  │         │  ╱        ╲                           │   │\\\\n│  │  ¥60k  │ ╱          ╲                          │   │\\\\n│  │         │╱            ╲                         │   │\\\\n│  │  ¥40k  ┼──────────────╲                        │   │\\\\n│  │         │              ╲                       │   │\\\\n│  │  ¥20k  │               ╲                      │   │\\\\n│  │         └─────────────────────────────────────      │   │\\\\n│  └─────────────────────────────────────────────────────┘   │\\\\n│  同比: ↑15.5%  环比: ↑8.2%                           │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  菜品销售排行                                          │\\\\n│  ┌─────────────────────────────────────────────────────┐   │\\\\n│  │ 排名  菜品名称      销量    收入    增长率   │   │\\\\n│  │  1     宫保鸡丁      500     ¥25,000 ↑15.5%  │   │\\\\n│  │  2     麻婆豆腐      450     ¥22,500 ↑12.3%  │   │\\\\n│  │  3     糖醋里脊      400     ¥20,000 ↑8.2%   │   │\\\\n│  └─────────────────────────────────────────────────────┘   │\\\\n└─────────────────────────────────────────────────────────────┘\\\\n```\\\\n\\\\n### 6.3 客户分析界面\\\\n\\\\n```\\\\n┌─────────────────────────────────────────────────────────────┐\\\\n│  客户分析                                              │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  [本周▼] [全部客户▼]                                   │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  客户分层                                              │\\\\n│  ┌─────────────────────────────────────────────────────┐   │\\\\n│  │  VIP客户: 50人 (25%)  ████████████████░░░░░░  │   │\\\\n│  │  高价值: 80人 (40%)  ███████████████████████░░  │   │\\\\n│  │  普通客户: 60人 (30%)  ████████████████░░░░░░  │   │\\\\n│  │  低价值: 10人 (5%)    ██████░░░░░░░░░░░░░░░  │   │\\\\n│  └─────────────────────────────────────────────────────┘   │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  客户画像                                              │\\\\n│  ┌─────────────────────────────────────────────────────┐   │\\\\n│  │  基本信息: 30岁, 男性, 北京                      │   │\\\\n│  │  消费习惯: 月消费¥5000, 订单10次, 客单价¥500   │   │\\\\n│  │  偏好分析: 宫保鸡丁, 麻婆豆腐, 中辣          │   │\\\\n│  │  客户标签: 高价值客户, 忠诚客户, 活跃客户       │   │\\\\n│  └─────────────────────────────────────────────────────┘   │\\\\n└─────────────────────────────────────────────────────────────┘\\\\n```\\\\n\\\\n### 6.4 预测分析界面\\\\n\\\\n```\\\\n┌─────────────────────────────────────────────────────────────┐\\\\n│  预测分析                                              │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  [未来7天▼] [销量▼]                                   │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  ┌─────────────────────────────────────────────────────┐   │\\\\n│  │  销量预测                                      │   │\\\\n│  │  500 ┤     ╭──────╮                           │   │\\\\n│  │      │    ╱        ╲                          │   │\\\\n│  │  400 ┤   ╱          ╲                         │   │\\\\n│  │      │  ╱            ╲                        │   │\\\\n│  │  300 ┤ ╱              ╲                       │   │\\\\n│  │      │╱                ╲                      │   │\\\\n│  │  200 ┼──────────────────╲                     │   │\\\\n│  │      │                  ╲                    │   │\\\\n│  │  100 ┤                   ╲                   │   │\\\\n│  │      └─────────────────────────────────────      │   │\\\\n│  └─────────────────────────────────────────────────────┘   │\\\\n│  预测准确度: 85%  置信区间: ±10%                      │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  影响因素分析                                          │\\\\n│  ┌─────────────────────────────────────────────────────┐   │\\\\n│  │  节假日: 10%  ████████████░░░░░░░░░░░░░░░  │   │\\\\n│  │  促销活动: 15% ████████████████░░░░░░░░░░░░  │   │\\\\n│  │  天气因素: 5%  ██████░░░░░░░░░░░░░░░░░░░░  │   │\\\\n│  │  其他因素: 70% ████████████████████████████████  │   │\\\\n│  └─────────────────────────────────────────────────────┘   │\\\\n└─────────────────────────────────────────────────────────────┘\\\\n```\\\\n\\\\n## 7. 测试需求\\\\n\\\\n### 7.1 单元测试\\\\n\\\\n- 核心指标计算测试\\\\n- 数据分析算法测试\\\\n- 预测模型测试\\\\n- 异常检测测试\\\\n- 数据导出测试\\\\n\\\\n### 7.2 集成测试\\\\n\\\\n- API接口集成测试\\\\n- 数据流转测试\\\\n- 实时更新测试\\\\n- 多用户并发测试\\\\n\\\\n### 7.3 性能测试\\\\n\\\\n- 大数据量处理测试\\\\n- 并发访问测试\\\\n- 响应时间测试\\\\n- 内存使用测试\\\\n\\\\n### 7.4 用户验收测试\\\\n\\\\n- 功能完整性测试\\\\n- 易用性测试\\\\n- 兼容性测试\\\\n- 安全性测试\\\\n\\\\n## 8. 部署和维护\\\\n\\\\n### 8.1 部署要求\\\\n\\\\n- 服务器配置：8核CPU、16GB内存、500GB SSD\\\\n- 数据库：PostgreSQL 13+\\\\n- 缓存：Redis 6+\\\\n- 消息队列：RabbitMQ 3.8+\\\\n\\\\n### 8.2 监控要求\\\\n\\\\n- 系统监控：CPU、内存、磁盘、网络\\\\n- 应用监控：响应时间、错误率、吞吐量\\\\n- 业务监控：数据准确性、预测准确度、预警及时性\\\\n\\\\n### 8.3 备份策略\\\\n\\\\n- 数据库备份：每日全量备份，每小时增量备份\\\\n- 配置备份：每次配置变更后备份\\\\n- 日志备份：每日备份，保留30天\\\\n\\\\n### 8.4 维护计划\\\\n\\\\n- 定期更新：每月更新预测模型\\\\n- 性能优化：每季度进行性能优化\\\\n- 安全检查：每周进行安全检查\\\\n- 功能迭代：根据用户反馈持续优化\\\\n\\\\n## 9. 版本历史\\\\n\\\\n| 版本 | 日期 | 作者 | 变更说明 |\\\\n|------|------|------|---------|\\\\n| 1.0.0 | 2025-01-20 | YYC³ | 初始版本 |\\\\n\",\"originAcceptText\":\"# 数据分析功能模块需求分析与设计文档\\n\\n## 1. 模块概述\\n\\n### 1.1 模块简介\\n\\n数据分析功能模块是YYC³餐饮平台的核心智能分析系统，提供全方位的业务数据洞察与分析能力。该模块通过收集、处理和分析餐厅运营数据，为管理者提供数据驱动的决策支持，帮助优化运营效率、提升客户满意度、增加营收。\\n\\n### 1.2 模块目标\\n\\n- **实时监控**：提供实时业务数据监控，及时掌握运营状态\\n- **趋势分析**：分析历史数据趋势，识别业务发展规律\\n- **预测分析**：基于机器学习算法预测未来业务趋势\\n- **异常预警**：自动识别异常情况，及时预警风险\\n- **决策支持**：提供数据驱动的决策建议和优化方案\\n- **可视化展示**：通过图表、仪表板直观展示数据分析结果\\n\\n### 1.3 适用范围\\n\\n- 餐厅管理者：监控整体运营状况，制定战略决策\\n- 运营经理：分析日常运营数据，优化业务流程\\n- 市场营销人员：分析客户行为，制定营销策略\\n- 财务人员：分析财务数据，进行成本控制\\n- 厨房管理人员：分析厨房效率，优化菜品制作\\n\\n## 2. 功能需求\\n\\n### 2.1 核心指标展示\\n\\n#### 2.1.1 收入指标\\n\\n**功能描述**：展示餐厅收入相关核心指标。\\n\\n**输入参数**：\\n- 时间范围：今天、昨天、本周、上周、本月、上月、本季度、上季度、本年、上年、自定义\\n\\n**输出结果**：\\n- 总收入：选定时间范围内的总收入\\n- 日均收入：平均每日收入\\n- 收入增长率：与上期相比的增长率\\n- 收入趋势：收入变化趋势图\\n\\n**业务规则**：\\n- 支持多币种显示\\n- 自动计算增长率\\n- 实时更新数据\\n- 支持数据导出\\n\\n#### 2.1.2 订单指标\\n\\n**功能描述**：展示订单相关核心指标。\\n\\n**输入参数**：\\n- 时间范围：同收入指标\\n\\n**输出结果**：\\n- 订单总数：选定时间范围内的订单总数\\n- 日均订单：平均每日订单数\\n- 订单增长率：与上期相比的增长率\\n- 订单趋势：订单变化趋势图\\n- 订单类型分布：堂食、外卖、自提订单占比\\n\\n**业务规则**：\\n- 按订单状态分类统计\\n- 支持订单类型筛选\\n- 显示订单完成率\\n\\n#### 2.1.3 客户指标\\n\\n**功能描述**：展示客户相关核心指标。\\n\\n**输入参数**：\\n- 时间范围：同收入指标\\n\\n**输出结果**：\\n- 客户总数：总客户数\\n- 新增客户：新增客户数\\n- 活跃客户：活跃客户数\\n- 客户增长率：与上期相比的增长率\\n- 客户留存率：客户留存率\\n\\n**业务规则**：\\n- 区分新老客户\\n- 计算客户活跃度\\n- 分析客户生命周期\\n\\n#### 2.1.4 转化率指标\\n\\n**功能描述**：展示转化率相关核心指标。\\n\\n**输入参数**：\\n- 时间范围：同收入指标\\n\\n**输出结果**：\\n- 访问转化率：访客到客户的转化率\\n- 订单转化率：浏览到下单的转化率\\n- 复购率：客户复购率\\n- 转化率趋势：转化率变化趋势\\n\\n**业务规则**：\\n- 多维度转化漏斗分析\\n- 识别转化瓶颈\\n- 提供优化建议\\n\\n#### 2.1.5 满意度指标\\n\\n**功能描述**：展示客户满意度相关核心指标。\\n\\n**输入参数**：\\n- 时间范围：同收入指标\\n\\n**输出结果**：\\n- 平均评分：客户平均评分\\n- 好评率：好评占比\\n- 中评率：中评占比\\n- 差评率：差评占比\\n- 满意度趋势：满意度变化趋势\\n\\n**业务规则**：\\n- 实时计算满意度\\n- 分析评价内容\\n- 识别满意度影响因素\\n\\n#### 2.1.6 效率指标\\n\\n**功能描述**：展示运营效率相关核心指标。\\n\\n**输入参数**：\\n- 时间范围：同收入指标\\n\\n**输出结果**：\\n- 平均出餐时间：平均出餐时长\\n- 订单完成率：订单完成比例\\n- 员工效率：员工平均效率\\n- 设备利用率：设备使用率\\n- 效率趋势：效率变化趋势\\n\\n**业务规则**：\\n- 实时监控效率指标\\n- 识别效率瓶颈\\n- 提供效率优化建议\\n\\n### 2.2 销售分析\\n\\n#### 2.2.1 销售趋势分析\\n\\n**功能描述**：分析销售数据的时间趋势。\\n\\n**输入参数**：\\n- 时间范围：天、周、月、季、年\\n- 对比周期：同比、环比\\n- 数据维度：收入、订单量、客单价\\n\\n**输出结果**：\\n- 销售趋势图：折线图展示销售变化\\n- 同比分析：与去年同期对比\\n- 环比分析：与上期对比\\n- 峰值识别：识别销售高峰和低谷\\n- 趋势预测：预测未来销售趋势\\n\\n**业务规则**：\\n- 支持多维度对比\\n- 自动识别异常点\\n- 提供趋势解释\\n\\n#### 2.2.2 菜品销售排行\\n\\n**功能描述**：统计菜品销售排行。\\n\\n**输入参数**：\\n- 时间范围：同销售趋势分析\\n- 排序方式：销量、收入、利润\\n- 分类筛选：菜品分类\\n\\n**输出结果**：\\n- 销量排行：按销量排序的菜品列表\\n- 收入排行：按收入排序的菜品列表\\n- 利润排行：按利润排序的菜品列表\\n- 销售占比：各菜品销售占比\\n- 趋势分析：菜品销售趋势\\n\\n**业务规则**：\\n- 实时更新排行\\n- 支持多维度排序\\n- 分析菜品生命周期\\n\\n#### 2.2.3 客单价分析\\n\\n**功能描述**：分析客单价数据。\\n\\n**输入参数**：\\n- 时间范围：同销售趋势分析\\n- 客户类型：新客户、老客户、全部客户\\n- 订单类型：堂食、外卖、自提\\n\\n**输出结果**：\\n- 平均客单价：平均每单金额\\n- 客单价分布：客单价区间分布\\n- 客单价趋势：客单价变化趋势\\n- 客单价对比：不同类型客单价对比\\n\\n**业务规则**：\\n- 分客户类型分析\\n- 分订单类型分析\\n- 提供提升客单价建议\\n\\n#### 2.2.4 促销效果分析\\n\\n**功能描述**：分析促销活动效果。\\n\\n**输入参数**：\\n- 活动ID：选择促销活动\\n- 时间范围：活动时间范围\\n- 对比基准：活动前、活动后\\n\\n**输出结果**：\\n- 活动收入：活动期间收入\\n- 收入增长：与基准对比增长\\n- 订单增长：与基准对比增长\\n- ROI分析：投资回报率\\n- 客户获取：新客户获取数\\n\\n**业务规则**：\\n- 自动计算ROI\\n- 分析活动效果\\n- 提供优化建议\\n\\n#### 2.2.5 销售渠道分析\\n\\n**功能描述**：分析不同销售渠道表现。\\n\\n**输入参数**：\\n- 时间范围：同销售趋势分析\\n- 渠道类型：堂食、外卖、自提、线上\\n\\n**输出结果**：\\n- 渠道收入：各渠道收入\\n- 渠道占比：各渠道收入占比\\n- 渠道趋势：各渠道收入趋势\\n- 渠道效率：各渠道效率对比\\n\\n**业务规则**：\\n- 多渠道对比分析\\n- 识别最优渠道\\n- 提供渠道优化建议\\n\\n### 2.3 客户分析\\n\\n#### 2.3.1 客户画像分析\\n\\n**功能描述**：构建和分析客户画像。\\n\\n**输入参数**：\\n- 客户ID：选择特定客户\\n- 客户群体：按条件筛选客户群体\\n- 时间范围：分析时间范围\\n\\n**输出结果**：\\n- 基本信息：年龄、性别、地区\\n- 消费习惯：消费频次、消费金额\\n- 偏好分析：菜品偏好、口味偏好\\n- 行为特征：就餐时间、就餐方式\\n- 客户标签：自动生成的客户标签\\n\\n**业务规则**：\\n- 自动生成客户画像\\n- 支持群体画像\\n- 动态更新画像\\n\\n#### 2.3.2 客户行为分析\\n\\n**功能描述**：分析客户行为模式。\\n\\n**输入参数**：\\n- 时间范围：分析时间范围\\n- 行为类型：浏览、下单、评价、分享\\n- 客户类型：新客户、老客户\\n\\n**输出结果**：\\n- 行为路径：客户行为路径\\n- 转化漏斗：行为转化漏斗\\n- 留存分析：客户留存率\\n- 流失分析：客户流失原因\\n\\n**业务规则**：\\n- 追踪完整行为链\\n- 识别关键转化点\\n- 分析流失原因\\n\\n#### 2.3.3 客户分层分析\\n\\n**功能描述**：对客户进行分层管理。\\n\\n**输入参数**：\\n- 分层模型：RFM模型、自定义模型\\n- 分层数量：3层、5层、10层\\n- 时间范围：分析时间范围\\n\\n**输出结果**：\\n- 客户分层：各层级客户数量\\n- 层级特征：各层级客户特征\\n- 贡献分析：各层级贡献度\\n- 策略建议：各层级管理策略\\n\\n**业务规则**：\\n- 支持多种分层模型\\n- 自动计算分层\\n- 提供分层策略\\n\\n#### 2.3.4 客户生命周期分析\\n\\n**功能描述**：分析客户生命周期价值。\\n\\n**输入参数**：\\n- 时间范围：分析时间范围\\n- 生命周期阶段：获取、激活、留存、流失\\n\\n**输出结果**：\\n- 生命周期分布：各阶段客户数\\n- 转化率：阶段间转化率\\n- 生命周期价值：客户平均生命周期价值\\n- 流失预测：客户流失预测\\n\\n**业务规则**：\\n- 计算CLV（客户生命周期价值）\\n- 识别流失风险\\n- 提供挽留策略\\n\\n#### 2.3.5 客户满意度分析\\n\\n**功能描述**：分析客户满意度数据。\\n\\n**输入参数**：\\n- 时间范围：分析时间范围\\n- 评价类型：评分、文字、图片\\n- 评价维度：菜品、服务、环境、价格\\n\\n**输出结果**：\\n- 满意度评分：平均满意度评分\\n- 评分分布：评分分布情况\\n- 情感分析：评价情感倾向\\n- 关键词分析：评价关键词提取\\n- 问题识别：识别常见问题\\n\\n**业务规则**：\\n- 实时情感分析\\n- 自动提取关键词\\n- 识别改进点\\n\\n### 2.4 菜单分析\\n\\n#### 2.4.1 菜品销售分析\\n\\n**功能描述**：分析菜品销售数据。\\n\\n**输入参数**：\\n- 时间范围：分析时间范围\\n- 菜品分类：按分类筛选\\n- 排序方式：销量、收入、利润\\n\\n**输出结果**：\\n- 销售数据：各菜品销售数据\\n- 销售趋势：销售趋势图\\n- 热销菜品：热销菜品排行\\n- 滞销菜品：滞销菜品排行\\n- 季节性分析：季节性销售规律\\n\\n**业务规则**：\\n- 实时更新销售数据\\n- 识别季节性规律\\n- 提供菜单优化建议\\n\\n#### 2.4.2 菜品利润分析\\n\\n**功能描述**：分析菜品利润情况。\\n\\n**输入参数**：\\n- 时间范围：分析时间范围\\n- 利润类型：毛利、净利\\n- 菜品分类：按分类筛选\\n\\n**输出结果**：\\n- 利润数据：各菜品利润数据\\n- 利润率：各菜品利润率\\n- 利润贡献：各菜品利润贡献度\\n- 成本分析：各菜品成本构成\\n\\n**业务规则**：\\n- 计算菜品毛利和净利\\n- 分析成本构成\\n- 识别高利润菜品\\n\\n#### 2.4.3 菜品组合分析\\n\\n**功能描述**：分析菜品组合销售情况。\\n\\n**输入参数**：\\n- 时间范围：分析时间范围\\n- 组合类型：搭配、套餐\\n\\n**输出结果**：\\n- 组合销售：菜品组合销售数据\\n- 关联规则：菜品关联规则\\n- 推荐组合：推荐菜品组合\\n- 套餐优化：套餐优化建议\\n\\n**业务规则**：\\n- 使用关联规则算法\\n- 识别菜品搭配规律\\n- 优化套餐设计\\n\\n#### 2.4.4 菜品评价分析\\n\\n**功能描述**：分析菜品评价数据。\\n\\n**输入参数**：\\n- 时间范围：分析时间范围\\n- 评价维度：口味、分量、价格、外观\\n\\n**输出结果**：\\n- 评分数据：各菜品评分\\n- 评价趋势：评价趋势\\n- 好评菜品：好评菜品排行\\n- 差评菜品：差评菜品排行\\n- 改进建议：菜品改进建议\\n\\n**业务规则**：\\n- 实时分析评价\\n- 识别问题菜品\\n- 提供改进建议\\n\\n#### 2.4.5 菜单优化建议\\n\\n**功能描述**：提供菜单优化建议。\\n\\n**输入参数**：\\n- 优化目标：提升销量、提升利润、提升满意度\\n- 限制条件：成本、库存、季节\\n\\n**输出结果**：\\n- 新增建议：建议新增菜品\\n- 删除建议：建议删除菜品\\n- 调整建议：建议调整菜品\\n- 定价建议：建议定价策略\\n- 推广建议：建议推广菜品\\n\\n**业务规则**：\\n- 基于数据分析\\n- 考虑多种因素\\n- 提供可执行建议\\n\\n### 2.5 运营分析\\n\\n#### 2.5.1 订单完成时间分析\\n\\n**功能描述**：分析订单完成时间。\\n\\n**输入参数**：\\n- 时间范围：分析时间范围\\n- 订单类型：堂食、外卖、自提\\n- 时间段：按时间段分析\\n\\n**输出结果**：\\n- 平均完成时间：平均订单完成时长\\n- 时间分布：完成时间分布\\n- 超时分析：超时订单分析\\n- 效率对比：不同类型订单效率对比\\n- 改进建议：效率改进建议\\n\\n**业务规则**：\\n- 实时监控完成时间\\n- 识别超时订单\\n- 分析效率瓶颈\\n\\n#### 2.5.2 厨房效率分析\\n\\n**功能描述**：分析厨房运营效率。\\n\\n**输入参数**：\\n- 时间范围：分析时间范围\\n- 工作站：按工作站分析\\n- 员工：按员工分析\\n\\n**输出结果**：\\n- 工作站效率：各工作站效率\\n- 员工效率：各员工效率\\n- 任务分布：任务分布情况\\n- 瓶颈识别：识别效率瓶颈\\n- 优化建议：效率优化建议\\n\\n**业务规则**：\\n- 实时监控效率\\n- 识别瓶颈环节\\n- 提供优化方案\\n\\n#### 2.5.3 库存周转分析\\n\\n**功能描述**：分析库存周转情况。\\n\\n**输入参数**：\\n- 时间范围：分析时间范围\\n- 物料类型：按物料类型分析\\n\\n**输出结果**：\\n- 周转率：库存周转率\\n- 周转天数：库存周转天数\\n- 库存结构：库存结构分析\\n- 滞销物料：滞销物料识别\\n- 补货建议：补货建议\\n\\n**业务规则**：\\n- 计算周转率\\n- 识别滞销物料\\n- 优化库存结构\\n\\n#### 2.5.4 人员效率分析\\n\\n**功能描述**：分析员工工作效率。\\n\\n**输入参数**：\\n- 时间范围：分析时间范围\\n- 员工类型：厨师、服务员、收银员\\n- 考核指标：任务完成、客户满意度\\n\\n**输出结果**：\\n- 效率排名：员工效率排名\\n- 任务完成：任务完成情况\\n- 客户评价：客户评价数据\\n- 工作时长：工作时长统计\\n- 培训建议：培训需求建议\\n\\n**业务规则**：\\n- 多维度评估员工\\n- 识别优秀员工\\n- 提供培训建议\\n\\n#### 2.5.5 成本分析\\n\\n**功能描述**：分析运营成本。\\n\\n**输入参数**：\\n- 时间范围：分析时间范围\\n- 成本类型：食材成本、人工成本、运营成本\\n- 对比基准：预算、上期\\n\\n**输出结果**：\\n- 成本总额：总成本\\n- 成本结构：成本构成分析\\n- 成本率：成本率分析\\n- 成本趋势：成本变化趋势\\n- 节约建议：成本节约建议\\n\\n**业务规则**：\\n- 分类统计成本\\n- 计算成本率\\n- 识别节约空间\\n\\n### 2.6 预测分析\\n\\n#### 2.6.1 销量预测\\n\\n**功能描述**：预测未来销量。\\n\\n**输入参数**：\\n- 预测周期：天、周、月、季\\n- 预测对象：整体销量、菜品销量\\n- 影响因素：节假日、促销、天气\\n\\n**输出结果**：\\n- 预测销量：预测的销量数据\\n- 置信区间：预测置信区间\\n- 影响因素：影响因素分析\\n- 准确度：历史预测准确度\\n\\n**业务规则**：\\n- 使用机器学习模型\\n- 考虑多种因素\\n- 提供置信区间\\n\\n#### 2.6.2 客户预测\\n\\n**功能描述**：预测客户行为。\\n\\n**输入参数**：\\n- 预测类型：新增客户、流失客户、活跃客户\\n- 预测周期：天、周、月\\n- 客户群体：按群体预测\\n\\n**输出结果**：\\n- 预测数量：预测的客户数量\\n- 流失风险：客户流失风险\\n- 活跃度预测：客户活跃度预测\\n- 挽留建议：客户挽留建议\\n\\n**业务规则**：\\n- 预测客户行为\\n- 识别流失风险\\n- 提供挽留策略\\n\\n#### 2.6.3 需求预测\\n\\n**功能描述**：预测物料需求。\\n\\n**输入参数**：\\n- 预测周期：天、周、月\\n- 物料类型：按物料类型预测\\n- 影响因素：销量、季节、促销\\n\\n**输出结果**：\\n- 需求量：预测的物料需求量\\n- 采购建议：采购建议\\n- 库存建议：库存建议\\n- 成本预测：成本预测\\n\\n**业务规则**：\\n- 基于销量预测\\n- 考虑安全库存\\n- 优化采购计划\\n\\n#### 2.6.4 收入预测\\n\\n**功能描述**：预测未来收入。\\n\\n**输入参数**：\\n- 预测周期：天、周、月、季\\n- 收入类型：总收入、各渠道收入\\n- 影响因素：促销、季节、节假日\\n\\n**输出结果**：\\n- 预测收入：预测的收入数据\\n- 收入趋势：收入趋势预测\\n- 达成率：目标达成率预测\\n- 策略建议：达成策略建议\\n\\n**业务规则**：\\n- 综合多种因素\\n- 提供达成策略\\n- 支持目标管理\\n\\n### 2.7 异常预警\\n\\n#### 2.7.1 销售异常预警\\n\\n**功能描述**：监控销售数据异常。\\n\\n**输入参数**：\\n- 监控指标：收入、订单量、客单价\\n- 异常阈值：自定义阈值\\n- 通知方式：邮件、短信、系统通知\\n\\n**输出结果**：\\n- 异常识别：识别异常数据\\n- 异常类型：异常类型分类\\n- 异常原因：异常原因分析\\n- 处理建议：异常处理建议\\n\\n**业务规则**：\\n- 实时监控数据\\n- 自动识别异常\\n- 及时发送预警\\n\\n#### 2.7.2 库存异常预警\\n\\n**功能描述**：监控库存异常情况。\\n\\n**输入参数**：\\n- 监控指标：库存量、周转率、过期\\n- 异常阈值：自定义阈值\\n- 通知方式：邮件、短信、系统通知\\n\\n**输出结果**：\\n- 异常识别：识别库存异常\\n- 异常类型：缺货、积压、过期\\n- 处理建议：处理建议\\n\\n**业务规则**：\\n- 实时监控库存\\n- 识别风险物料\\n- 及时预警处理\\n\\n#### 2.7.3 客户异常预警\\n\\n**功能描述**：监控客户异常行为。\\n\\n**输入参数**：\\n- 监控指标：流失、投诉、异常订单\\n- 异常阈值：自定义阈值\\n- 通知方式：邮件、短信、系统通知\\n\\n**输出结果**：\\n- 异常识别：识别客户异常\\n- 风险评估：客户风险评估\\n- 挽留建议：客户挽留建议\\n\\n**业务规则**：\\n- 监控客户行为\\n- 识别流失风险\\n- 及时挽留客户\\n\\n#### 2.7.4 运营异常预警\\n\\n**功能描述**：监控运营异常情况。\\n\\n**输入参数**：\\n- 监控指标：效率、质量、成本\\n- 异常阈值：自定义阈值\\n- 通知方式：邮件、短信、系统通知\\n\\n**输出结果**：\\n- 异常识别：识别运营异常\\n- 异常类型：效率异常、质量异常、成本异常\\n- 处理建议：处理建议\\n\\n**业务规则**：\\n- 实时监控运营\\n- 识别异常情况\\n- 及时处理问题\\n\\n### 2.8 自定义仪表板\\n\\n#### 2.8.1 仪表板配置\\n\\n**功能描述**：自定义仪表板布局。\\n\\n**输入参数**：\\n- 仪表板名称：自定义名称\\n- 布局方式：网格布局、自由布局\\n- 组件选择：选择显示组件\\n- 组件配置：配置组件参数\\n\\n**输出结果**：\\n- 自定义仪表板：个性化仪表板\\n- 组件展示：按配置展示组件\\n- 数据刷新：按配置刷新数据\\n\\n**业务规则**：\\n- 支持多个仪表板\\n- 灵活布局组件\\n- 保存配置方案\\n\\n#### 2.8.2 组件管理\\n\\n**功能描述**：管理仪表板组件。\\n\\n**输入参数**：\\n- 组件类型：图表、指标、表格\\n- 组件配置：配置组件参数\\n- 数据源：选择数据源\\n\\n**输出结果**：\\n- 组件列表：可用组件列表\\n- 组件预览：组件预览效果\\n- 组件配置：配置组件参数\\n\\n**业务规则**：\\n- 提供丰富组件\\n- 支持灵活配置\\n- 实时预览效果\\n\\n#### 2.8.3 数据导出\\n\\n**功能描述**：导出分析数据。\\n\\n**输入参数**：\\n- 导出格式：Excel、PDF、CSV\\n- 导出范围：当前视图、自定义范围\\n- 数据内容：选择导出数据\\n\\n**输出结果**：\\n- 导出文件：生成的导出文件\\n- 导出记录：导出历史记录\\n\\n**业务规则**：\\n- 支持多种格式\\n- 灵活选择数据\\n- 记录导出历史\\n\\n## 3. 非功能需求\\n\\n### 3.1 性能需求\\n\\n- **响应时间**：页面加载时间不超过2秒，数据查询响应时间不超过1秒\\n- **并发处理**：支持至少100个并发用户同时访问\\n- **数据处理**：支持处理百万级数据量\\n- **实时性**：数据延迟不超过5秒\\n\\n### 3.2 可用性需求\\n\\n- **易用性**：界面简洁直观，操作流程清晰\\n- **可访问性**：支持键盘导航和屏幕阅读器\\n- **多语言**：支持中英文切换\\n- **响应式设计**：支持PC、平板、手机访问\\n\\n### 3.3 安全需求\\n\\n- **数据加密**：敏感数据加密存储\\n- **访问控制**：基于角色的访问控制\\n- **审计日志**：记录所有操作日志\\n- **数据备份**：定期备份数据\\n\\n### 3.4 兼容性需求\\n\\n- **浏览器兼容**：支持Chrome、Firefox、Safari、Edge最新版本\\n- **设备兼容**：支持Windows、macOS、iOS、Android\\n- **分辨率**：支持1920x1080及以上分辨率\\n\\n## 4. 接口设计\\n\\n### 4.1 核心指标接口\\n\\n```typescript\\n// 获取核心指标\\nGET /api/v1/analytics/metrics\\nQuery Parameters:\\n  - dateRange: string (today, yesterday, this_week, last_week, this_month, last_month, this_quarter, last_quarter, this_year, last_year, custom)\\n  - startDate: string (当dateRange为custom时必填)\\n  - endDate: string (当dateRange为custom时必填)\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"revenue\\\": {\\n      \\\"total\\\": 100000,\\n      \\\"daily\\\": 3333.33,\\n      \\\"growth\\\": 15.5\\n    },\\n    \\\"orders\\\": {\\n      \\\"total\\\": 500,\\n      \\\"daily\\\": 16.67,\\n      \\\"growth\\\": 8.2\\n    },\\n    \\\"customers\\\": {\\n      \\\"total\\\": 200,\\n      \\\"new\\\": 50,\\n      \\\"growth\\\": 12.3\\n    },\\n    \\\"conversion\\\": {\\n      \\\"rate\\\": 3.5,\\n      \\\"growth\\\": 2.1\\n    },\\n    \\\"satisfaction\\\": {\\n      \\\"score\\\": 4.5,\\n      \\\"positiveRate\\\": 85,\\n      \\\"growth\\\": 5.6\\n    },\\n    \\\"efficiency\\\": {\\n      \\\"prepTime\\\": 15,\\n      \\\"completionRate\\\": 98,\\n      \\\"growth\\\": 3.2\\n    }\\n  }\\n}\\n```\\n\\n### 4.2 销售分析接口\\n\\n```typescript\\n// 获取销售趋势\\nGET /api/v1/analytics/sales/trend\\nQuery Parameters:\\n  - dateRange: string\\n  - startDate: string\\n  - endDate: string\\n  - dimension: string (revenue, orders, average_order_value)\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"trend\\\": [\\n      { \\\"date\\\": \\\"2025-01-01\\\", \\\"value\\\": 10000 },\\n      { \\\"date\\\": \\\"2025-01-02\\\", \\\"value\\\": 12000 }\\n    ],\\n    \\\"comparison\\\": {\\n      \\\"yoy\\\": 15.5,\\n      \\\"mom\\\": 8.2\\n    }\\n  }\\n}\\n\\n// 获取菜品销售排行\\nGET /api/v1/analytics/sales/menu-ranking\\nQuery Parameters:\\n  - dateRange: string\\n  - sortBy: string (quantity, revenue, profit)\\n  - category: string\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"items\\\": [\\n      {\\n        \\\"menuId\\\": \\\"1\\\",\\n        \\\"name\\\": \\\"宫保鸡丁\\\",\\n        \\\"quantity\\\": 500,\\n        \\\"revenue\\\": 25000,\\n        \\\"profit\\\": 12500,\\n        \\\"growth\\\": 15.5\\n      }\\n    ]\\n  }\\n}\\n```\\n\\n### 4.3 客户分析接口\\n\\n```typescript\\n// 获取客户画像\\nGET /api/v1/analytics/customer/profile\\nQuery Parameters:\\n  - customerId: string\\n  - segment: string\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"basicInfo\\\": {\\n      \\\"age\\\": 30,\\n      \\\"gender\\\": \\\"male\\\",\\n      \\\"location\\\": \\\"北京\\\"\\n    },\\n    \\\"consumption\\\": {\\n      \\\"frequency\\\": 10,\\n      \\\"amount\\\": 5000,\\n      \\\"avgOrderValue\\\": 500\\n    },\\n    \\\"preferences\\\": {\\n      \\\"favoriteDishes\\\": [\\\"宫保鸡丁\\\", \\\"麻婆豆腐\\\"],\\n      \\\"taste\\\": \\\"medium\\\",\\n      \\\"dietary\\\": \\\"none\\\"\\n    },\\n    \\\"tags\\\": [\\\"高价值客户\\\", \\\"忠诚客户\\\"]\\n  }\\n}\\n\\n// 获取客户分层\\nGET /api/v1/analytics/customer/segmentation\\nQuery Parameters:\\n  - model: string (rfm, custom)\\n  - segments: number\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"segments\\\": [\\n      {\\n        \\\"name\\\": \\\"VIP客户\\\",\\n        \\\"count\\\": 50,\\n        \\\"characteristics\\\": \\\"高消费、高频率\\\",\\n        \\\"strategy\\\": \\\"提供专属服务\\\"\\n      }\\n    ]\\n  }\\n}\\n```\\n\\n### 4.4 菜单分析接口\\n\\n```typescript\\n// 获取菜品分析\\nGET /api/v1/analytics/menu/analysis\\nQuery Parameters:\\n  - dateRange: string\\n  - category: string\\n  - sortBy: string\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"items\\\": [\\n      {\\n        \\\"menuId\\\": \\\"1\\\",\\n        \\\"name\\\": \\\"宫保鸡丁\\\",\\n        \\\"quantity\\\": 500,\\n        \\\"revenue\\\": 25000,\\n        \\\"profit\\\": 12500,\\n        \\\"profitRate\\\": 50,\\n        \\\"rating\\\": 4.5,\\n        \\\"trend\\\": \\\"up\\\"\\n      }\\n    ]\\n  }\\n}\\n\\n// 获取菜单优化建议\\nGET /api/v1/analytics/menu/optimization\\nQuery Parameters:\\n  - goal: string (increase_sales, increase_profit, increase_satisfaction)\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"add\\\": [\\n      {\\n        \\\"name\\\": \\\"新菜品A\\\",\\n        \\\"reason\\\": \\\"市场需求高\\\",\\n        \\\"expectedRevenue\\\": 5000\\n      }\\n    ],\\n    \\\"remove\\\": [\\n      {\\n        \\\"name\\\": \\\"滞销菜品B\\\",\\n        \\\"reason\\\": \\\"销量低、利润低\\\",\\n        \\\"impact\\\": \\\"minimal\\\"\\n      }\\n    ],\\n    \\\"adjust\\\": [\\n      {\\n        \\\"name\\\": \\\"菜品C\\\",\\n        \\\"adjustment\\\": \\\"降低价格\\\",\\n        \\\"reason\\\": \\\"价格偏高\\\"\\n      }\\n    ]\\n  }\\n}\\n```\\n\\n### 4.5 运营分析接口\\n\\n```typescript\\n// 获取运营效率\\nGET /api/v1/analytics/operational/efficiency\\nQuery Parameters:\\n  - dateRange: string\\n  - type: string (kitchen, staff, inventory)\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"kitchen\\\": {\\n      \\\"avgPrepTime\\\": 15,\\n      \\\"completionRate\\\": 98,\\n      \\\"stations\\\": [\\n        {\\n          \\\"name\\\": \\\"热菜\\\",\\n          \\\"efficiency\\\": 95,\\n          \\\"bottleneck\\\": false\\n        }\\n      ]\\n    },\\n    \\\"staff\\\": [\\n      {\\n        \\\"staffId\\\": \\\"1\\\",\\n        \\\"name\\\": \\\"张三\\\",\\n        \\\"efficiency\\\": 95,\\n        \\\"tasksCompleted\\\": 100,\\n        \\\"rating\\\": 4.5\\n      }\\n    ],\\n    \\\"inventory\\\": {\\n      \\\"turnoverRate\\\": 12,\\n      \\\"turnoverDays\\\": 30,\\n      \\\"slowMoving\\\": [\\n        {\\n          \\\"itemId\\\": \\\"1\\\",\\n          \\\"name\\\": \\\"物料A\\\",\\n          \\\"turnoverDays\\\": 90\\n        }\\n      ]\\n    }\\n  }\\n}\\n```\\n\\n### 4.6 预测分析接口\\n\\n```typescript\\n// 获取销量预测\\nGET /api/v1/analytics/prediction/sales\\nQuery Parameters:\\n  - period: string (day, week, month, quarter)\\n  - horizon: number\\n  - factors: array\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"predictions\\\": [\\n      {\\n        \\\"date\\\": \\\"2025-01-21\\\",\\n        \\\"value\\\": 10000,\\n        \\\"confidence\\\": {\\n          \\\"lower\\\": 9000,\\n          \\\"upper\\\": 11000\\n        }\\n      }\\n    ],\\n    \\\"accuracy\\\": 85,\\n    \\\"factors\\\": {\\n      \\\"holiday\\\": 0.1,\\n      \\\"promotion\\\": 0.15,\\n      \\\"weather\\\": 0.05\\n    }\\n  }\\n}\\n\\n// 获取需求预测\\nGET /api/v1/analytics/prediction/demand\\nQuery Parameters:\\n  - period: string\\n  - itemId: string\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"demand\\\": 1000,\\n    \\\"recommendation\\\": {\\n      \\\"purchase\\\": 1200,\\n      \\\"safetyStock\\\": 200,\\n      \\\"expectedCost\\\": 6000\\n    }\\n  }\\n}\\n```\\n\\n### 4.7 异常预警接口\\n\\n```typescript\\n// 获取异常预警\\nGET /api/v1/analytics/alerts\\nQuery Parameters:\\n  - type: string (sales, inventory, customer, operational)\\n  - status: string (active, resolved, all)\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"alerts\\\": [\\n      {\\n        \\\"id\\\": \\\"1\\\",\\n        \\\"type\\\": \\\"sales\\\",\\n        \\\"severity\\\": \\\"high\\\",\\n        \\\"message\\\": \\\"销售额下降30%\\\",\\n        \\\"timestamp\\\": \\\"2025-01-20T10:00:00Z\\\",\\n        \\\"cause\\\": \\\"促销活动结束\\\",\\n        \\\"recommendation\\\": \\\"启动新促销活动\\\"\\n      }\\n    ]\\n  }\\n}\\n\\n// 更新预警状态\\nPATCH /api/v1/analytics/alerts/:id\\nBody:\\n{\\n  \\\"status\\\": \\\"resolved\\\",\\n  \\\"note\\\": \\\"已处理\\\"\\n}\\n```\\n\\n## 5. 数据模型\\n\\n### 5.1 核心指标模型\\n\\n```typescript\\ninterface CoreMetrics {\\n  revenue: RevenueMetrics;\\n  orders: OrderMetrics;\\n  customers: CustomerMetrics;\\n  conversion: ConversionMetrics;\\n  satisfaction: SatisfactionMetrics;\\n  efficiency: EfficiencyMetrics;\\n}\\n\\ninterface RevenueMetrics {\\n  total: number;\\n  daily: number;\\n  growth: number;\\n  trend: TrendData[];\\n}\\n\\ninterface OrderMetrics {\\n  total: number;\\n  daily: number;\\n  growth: number;\\n  typeDistribution: OrderTypeDistribution;\\n  trend: TrendData[];\\n}\\n\\ninterface CustomerMetrics {\\n  total: number;\\n  new: number;\\n  active: number;\\n  growth: number;\\n  retentionRate: number;\\n}\\n\\ninterface ConversionMetrics {\\n  rate: number;\\n  visitToOrder: number;\\n  repeatRate: number;\\n  trend: TrendData[];\\n}\\n\\ninterface SatisfactionMetrics {\\n  score: number;\\n  positiveRate: number;\\n  neutralRate: number;\\n  negativeRate: number;\\n  trend: TrendData[];\\n}\\n\\ninterface EfficiencyMetrics {\\n  avgPrepTime: number;\\n  completionRate: number;\\n  staffEfficiency: number;\\n  equipmentUtilization: number;\\n  trend: TrendData[];\\n}\\n```\\n\\n### 5.2 销售分析模型\\n\\n```typescript\\ninterface SalesTrend {\\n  date: string;\\n  value: number;\\n  comparison?: {\\n    yoy: number;\\n    mom: number;\\n  };\\n}\\n\\ninterface MenuRanking {\\n  menuId: string;\\n  name: string;\\n  quantity: number;\\n  revenue: number;\\n  profit: number;\\n  growth: number;\\n  rank: number;\\n}\\n\\ninterface PromotionEffect {\\n  promotionId: string;\\n  name: string;\\n  revenue: number;\\n  revenueGrowth: number;\\n  orderGrowth: number;\\n  roi: number;\\n  newCustomers: number;\\n}\\n```\\n\\n### 5.3 客户分析模型\\n\\n```typescript\\ninterface CustomerProfile {\\n  customerId: string;\\n  basicInfo: BasicInfo;\\n  consumption: ConsumptionInfo;\\n  preferences: PreferenceInfo;\\n  behavior: BehaviorInfo;\\n  tags: string[];\\n  lifecycle: LifecycleInfo;\\n}\\n\\ninterface BasicInfo {\\n  age?: number;\\n  gender?: string;\\n  location?: string;\\n  registerDate: string;\\n}\\n\\ninterface ConsumptionInfo {\\n  totalAmount: number;\\n  orderCount: number;\\n  avgOrderValue: number;\\n  frequency: number;\\n  lastOrderDate: string;\\n}\\n\\ninterface PreferenceInfo {\\n  favoriteDishes: string[];\\n  taste: string;\\n  dietary: string[];\\n  priceRange: string;\\n}\\n\\ninterface BehaviorInfo {\\n  visitPatterns: VisitPattern[];\\n  orderTypes: OrderType[];\\n  peakHours: number[];\\n}\\n\\ninterface LifecycleInfo {\\n  stage: string;\\n  value: number;\\n  churnRisk: number;\\n  predictedLifetime: number;\\n}\\n```\\n\\n### 5.4 菜单分析模型\\n\\n```typescript\\ninterface MenuAnalysis {\\n  menuId: string;\\n  name: string;\\n  category: string;\\n  quantity: number;\\n  revenue: number;\\n  profit: number;\\n  profitRate: number;\\n  cost: number;\\n  rating: number;\\n  trend: string;\\n  seasonality: SeasonalityInfo;\\n}\\n\\ninterface MenuCombination {\\n  items: string[];\\n  frequency: number;\\n  confidence: number;\\n  revenue: number;\\n}\\n\\ninterface MenuOptimization {\\n  add: OptimizationSuggestion[];\\n  remove: OptimizationSuggestion[];\\n  adjust: OptimizationSuggestion[];\\n  pricing: PricingSuggestion[];\\n}\\n\\ninterface OptimizationSuggestion {\\n  name: string;\\n  reason: string;\\n  impact: string;\\n  expectedRevenue?: number;\\n}\\n```\\n\\n### 5.5 预测分析模型\\n\\n```typescript\\ninterface SalesPrediction {\\n  date: string;\\n  value: number;\\n  confidence: {\\n    lower: number;\\n    upper: number;\\n  };\\n  factors: FactorAnalysis;\\n}\\n\\ninterface CustomerPrediction {\\n  type: string;\\n  count: number;\\n  confidence: number;\\n  riskLevel: string;\\n  recommendations: string[];\\n}\\n\\ninterface DemandPrediction {\\n  itemId: string;\\n  itemName: string;\\n  demand: number;\\n  recommendation: {\\n    purchase: number;\\n    safetyStock: number;\\n    expectedCost: number;\\n  };\\n}\\n\\ninterface FactorAnalysis {\\n  holiday: number;\\n  promotion: number;\\n  weather: number;\\n  season: number;\\n  other: number;\\n}\\n```\\n\\n### 5.6 异常预警模型\\n\\n```typescript\\ninterface Alert {\\n  id: string;\\n  type: AlertType;\\n  severity: AlertSeverity;\\n  message: string;\\n  timestamp: string;\\n  cause?: string;\\n  recommendation?: string;\\n  status: AlertStatus;\\n  resolvedAt?: string;\\n  resolvedBy?: string;\\n  note?: string;\\n}\\n\\nenum AlertType {\\n  SALES = 'sales',\\n  INVENTORY = 'inventory',\\n  CUSTOMER = 'customer',\\n  OPERATIONAL = 'operational'\\n}\\n\\nenum AlertSeverity {\\n  LOW = 'low',\\n  MEDIUM = 'medium',\\n  HIGH = 'high',\\n  CRITICAL = 'critical'\\n}\\n\\nenum AlertStatus {\\n  ACTIVE = 'active',\\n  RESOLVED = 'resolved',\\n  DISMISSED = 'dismissed'\\n}\\n```\\n\\n## 6. 用户界面设计\\n\\n### 6.1 主界面布局\\n\\n```\\n┌─────────────────────────────────────────────────────────────┐\\n│  数据分析                                              │\\n│  全方位的业务数据洞察与分析                                │\\n├─────────────────────────────────────────────────────────────┤\\n│  [今天▼] [刷新数据] [导出报告] [仪表板设置]            │\\n├─────────────────────────────────────────────────────────────┤\\n│  ┌─────────┐ ┌─────────┐ ┌─────────┐ ┌─────────┐    │\\n│  │ ¥100,000│ │ 500     │ │ 200     │ │ 3.5%    │    │\\n│  │ 收入    │ │ 订单    │ │ 客户    │ │ 转化率  │    │\\n│  │ ↑15.5%  │ │ ↑8.2%   │ │ ↑12.3%  │ │ ↑2.1%   │    │\\n│  └─────────┘ └─────────┘ └─────────┘ └─────────┘    │\\n│  ┌─────────┐ ┌─────────┐                              │\\n│  │ 4.5     │ │ 15分钟  │                              │\\n│  │ 满意度  │ │ 平均出餐│                              │\\n│  │ ↑5.6%   │ │ ↑3.2%   │                              │\\n│  └─────────┘ └─────────┘                              │\\n├─────────────────────────────────────────────────────────────┤\\n│  [销售分析] [客户分析] [菜单分析] [运营分析]           │\\n│  [预测分析] [异常预警] [自定义仪表板]                   │\\n└─────────────────────────────────────────────────────────────┘\\n```\\n\\n### 6.2 销售分析界面\\n\\n```\\n┌─────────────────────────────────────────────────────────────┐\\n│  销售分析                                              │\\n├─────────────────────────────────────────────────────────────┤\\n│  [本周▼] [收入▼] [对比▼]                              │\\n├─────────────────────────────────────────────────────────────┤\\n│  ┌─────────────────────────────────────────────────────┐   │\\n│  │  销售趋势图                                    │   │\\n│  │  ¥100k ┤                                     │   │\\n│  │         │    ╭────╮                             │   │\\n│  │  ¥80k  │   ╱      ╲                            │   │\\n│  │         │  ╱        ╲                           │   │\\n│  │  ¥60k  │ ╱          ╲                          │   │\\n│  │         │╱            ╲                         │   │\\n│  │  ¥40k  ┼──────────────╲                        │   │\\n│  │         │              ╲                       │   │\\n│  │  ¥20k  │               ╲                      │   │\\n│  │         └─────────────────────────────────────      │   │\\n│  └─────────────────────────────────────────────────────┘   │\\n│  同比: ↑15.5%  环比: ↑8.2%                           │\\n├─────────────────────────────────────────────────────────────┤\\n│  菜品销售排行                                          │\\n│  ┌─────────────────────────────────────────────────────┐   │\\n│  │ 排名  菜品名称      销量    收入    增长率   │   │\\n│  │  1     宫保鸡丁      500     ¥25,000 ↑15.5%  │   │\\n│  │  2     麻婆豆腐      450     ¥22,500 ↑12.3%  │   │\\n│  │  3     糖醋里脊      400     ¥20,000 ↑8.2%   │   │\\n│  └─────────────────────────────────────────────────────┘   │\\n└─────────────────────────────────────────────────────────────┘\\n```\\n\\n### 6.3 客户分析界面\\n\\n```\\n┌─────────────────────────────────────────────────────────────┐\\n│  客户分析                                              │\\n├─────────────────────────────────────────────────────────────┤\\n│  [本周▼] [全部客户▼]                                   │\\n├─────────────────────────────────────────────────────────────┤\\n│  客户分层                                              │\\n│  ┌─────────────────────────────────────────────────────┐   │\\n│  │  VIP客户: 50人 (25%)  ████████████████░░░░░░  │   │\\n│  │  高价值: 80人 (40%)  ███████████████████████░░  │   │\\n│  │  普通客户: 60人 (30%)  ████████████████░░░░░░  │   │\\n│  │  低价值: 10人 (5%)    ██████░░░░░░░░░░░░░░░  │   │\\n│  └─────────────────────────────────────────────────────┘   │\\n├─────────────────────────────────────────────────────────────┤\\n│  客户画像                                              │\\n│  ┌─────────────────────────────────────────────────────┐   │\\n│  │  基本信息: 30岁, 男性, 北京                      │   │\\n│  │  消费习惯: 月消费¥5000, 订单10次, 客单价¥500   │   │\\n│  │  偏好分析: 宫保鸡丁, 麻婆豆腐, 中辣          │   │\\n│  │  客户标签: 高价值客户, 忠诚客户, 活跃客户       │   │\\n│  └─────────────────────────────────────────────────────┘   │\\n└─────────────────────────────────────────────────────────────┘\\n```\\n\\n### 6.4 预测分析界面\\n\\n```\\n┌─────────────────────────────────────────────────────────────┐\\n│  预测分析                                              │\\n├─────────────────────────────────────────────────────────────┤\\n│  [未来7天▼] [销量▼]                                   │\\n├─────────────────────────────────────────────────────────────┤\\n│  ┌─────────────────────────────────────────────────────┐   │\\n│  │  销量预测                                      │   │\\n│  │  500 ┤     ╭──────╮                           │   │\\n│  │      │    ╱        ╲                          │   │\\n│  │  400 ┤   ╱          ╲                         │   │\\n│  │      │  ╱            ╲                        │   │\\n│  │  300 ┤ ╱              ╲                       │   │\\n│  │      │╱                ╲                      │   │\\n│  │  200 ┼──────────────────╲                     │   │\\n│  │      │                  ╲                    │   │\\n│  │  100 ┤                   ╲                   │   │\\n│  │      └─────────────────────────────────────      │   │\\n│  └─────────────────────────────────────────────────────┘   │\\n│  预测准确度: 85%  置信区间: ±10%                      │\\n├─────────────────────────────────────────────────────────────┤\\n│  影响因素分析                                          │\\n│  ┌─────────────────────────────────────────────────────┐   │\\n│  │  节假日: 10%  ████████████░░░░░░░░░░░░░░░  │   │\\n│  │  促销活动: 15% ████████████████░░░░░░░░░░░░  │   │\\n│  │  天气因素: 5%  ██████░░░░░░░░░░░░░░░░░░░░  │   │\\n│  │  其他因素: 70% ████████████████████████████████  │   │\\n│  └─────────────────────────────────────────────────────┘   │\\n└─────────────────────────────────────────────────────────────┘\\n```\\n\\n## 7. 测试需求\\n\\n### 7.1 单元测试\\n\\n- 核心指标计算测试\\n- 数据分析算法测试\\n- 预测模型测试\\n- 异常检测测试\\n- 数据导出测试\\n\\n### 7.2 集成测试\\n\\n- API接口集成测试\\n- 数据流转测试\\n- 实时更新测试\\n- 多用户并发测试\\n\\n### 7.3 性能测试\\n\\n- 大数据量处理测试\\n- 并发访问测试\\n- 响应时间测试\\n- 内存使用测试\\n\\n### 7.4 用户验收测试\\n\\n- 功能完整性测试\\n- 易用性测试\\n- 兼容性测试\\n- 安全性测试\\n\\n## 8. 部署和维护\\n\\n### 8.1 部署要求\\n\\n- 服务器配置：8核CPU、16GB内存、500GB SSD\\n- 数据库：PostgreSQL 13+\\n- 缓存：Redis 6+\\n- 消息队列：RabbitMQ 3.8+\\n\\n### 8.2 监控要求\\n\\n- 系统监控：CPU、内存、磁盘、网络\\n- 应用监控：响应时间、错误率、吞吐量\\n- 业务监控：数据准确性、预测准确度、预警及时性\\n\\n### 8.3 备份策略\\n\\n- 数据库备份：每日全量备份，每小时增量备份\\n- 配置备份：每次配置变更后备份\\n- 日志备份：每日备份，保留30天\\n\\n### 8.4 维护计划\\n\\n- 定期更新：每月更新预测模型\\n- 性能优化：每季度进行性能优化\\n- 安全检查：每周进行安全检查\\n- 功能迭代：根据用户反馈持续优化\\n\\n## 9. 版本历史\\n\\n| 版本 | 日期 | 作者 | 变更说明 |\\n|------|------|------|---------|\\n| 1.0.0 | 2025-01-20 | YYC³ | 初始版本 |\\n\",\"originTextLength\":25038,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768895041368}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/docs/YYC3-Cater-Platform-%E6%96%87%E6%A1%A3%E9%97%AD%E7%8E%AF/YYC3-Cater-%E9%9C%80%E6%B1%82%E8%AE%BE%E8%AE%A1%E6%96%87%E6%A1%A3/%E8%8F%9C%E5%8D%95%E7%AE%A1%E7%90%86%E5%8A%9F%E8%83%BD%E6%A8%A1%E5%9D%97%E9%9C%80%E6%B1%82%E5%88%86%E6%9E%90%E4%B8%8E%E8%AE%BE%E8%AE%A1%E6%96%87%E6%A1%A3.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":1014,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":1014,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# 菜单管理功能模块需求分析与设计文档\\\\n\\\\n## 1. 模块概述\\\\n\\\\n### 1.1 模块简介\\\\n\\\\n菜单管理功能模块是YYC³餐饮平台的核心业务模块，负责管理餐厅的所有菜品信息，包括菜品的创建、编辑、删除、分类管理、价格管理、库存关联等功能。该模块为餐厅提供完整的菜单管理能力，确保菜单信息的准确性和实时性。\\\\n\\\\n### 1.2 模块目标\\\\n\\\\n- **集中管理**：统一管理所有菜品信息，确保数据一致性\\\\n- **灵活分类**：支持多层级分类管理，便于菜品组织\\\\n- **实时更新**：支持菜品上下架、价格调整等实时操作\\\\n- **库存联动**：与库存系统联动，确保菜品可售性\\\\n- **成本控制**：记录菜品成本，支持成本分析\\\\n- **多语言**：支持多语言菜品名称和描述\\\\n\\\\n### 1.3 适用范围\\\\n\\\\n- 餐厅管理者：管理菜单、调整价格、控制菜品上下架\\\\n- 厨房管理人员：查看菜品信息、了解制作要求\\\\n- 财务人员：分析菜品成本、计算利润\\\\n- 市场营销人员：了解菜品信息、制定促销策略\\\\n- 客户服务人员：查看菜品详情、解答客户疑问\\\\n\\\\n## 2. 功能需求\\\\n\\\\n### 2.1 菜品管理\\\\n\\\\n#### 2.1.1 菜品创建\\\\n\\\\n**功能描述**：创建新的菜品。\\\\n\\\\n**输入参数**：\\\\n- 菜品名称：必填，支持中英文\\\\n- 菜品分类：必填，从分类列表选择\\\\n- 价格：必填，支持小数点后两位\\\\n- 成本：必填，用于计算利润\\\\n- 菜品图片：可选，支持上传\\\\n- 菜品描述：可选，支持富文本\\\\n- 制作时间：可选，单位为分钟\\\\n- 菜品标签：可选，多个标签\\\\n- 菜品规格：可选，如大份、中份、小份\\\\n- 菜品属性：可选，如辣度、温度等\\\\n- 菜品材料：可选，关联库存材料\\\\n- 菜品营养：可选，营养成分信息\\\\n\\\\n**输出结果**：\\\\n- 菜品ID：系统生成的唯一标识\\\\n- 创建时间：菜品创建时间\\\\n- 操作状态：创建成功或失败\\\\n\\\\n**业务规则**：\\\\n- 菜品名称不能重复\\\\n- 价格必须大于0\\\\n- 成本必须小于价格\\\\n- 图片大小不超过5MB\\\\n- 支持批量创建\\\\n\\\\n#### 2.1.2 菜品编辑\\\\n\\\\n**功能描述**：编辑已有菜品信息。\\\\n\\\\n**输入参数**：\\\\n- 菜品ID：必填，标识要编辑的菜品\\\\n- 其他参数：同菜品创建\\\\n\\\\n**输出结果**：\\\\n- 更新时间：菜品更新时间\\\\n- 操作状态：更新成功或失败\\\\n\\\\n**业务规则**：\\\\n- 编辑后自动更新相关订单\\\\n- 价格变更记录历史\\\\n- 支持部分字段编辑\\\\n- 编辑记录可追溯\\\\n\\\\n#### 2.1.3 菜品删除\\\\n\\\\n**功能描述**：删除已有菜品。\\\\n\\\\n**输入参数**：\\\\n- 菜品ID：必填，标识要删除的菜品\\\\n\\\\n**输出结果**：\\\\n- 删除状态：删除成功或失败\\\\n\\\\n**业务规则**：\\\\n- 删除前检查是否有关联订单\\\\n- 有关联订单时提示确认\\\\n- 删除后不可恢复\\\\n- 删除记录保留\\\\n\\\\n#### 2.1.4 菜品上下架\\\\n\\\\n**功能描述**：控制菜品的上架和下架状态。\\\\n\\\\n**输入参数**：\\\\n- 菜品ID：必填\\\\n- 状态：上架或下架\\\\n\\\\n**输出结果**：\\\\n- 状态更新结果\\\\n\\\\n**业务规则**：\\\\n- 下架后订单中不可选择\\\\n- 上架后立即可用\\\\n- 支持批量上下架\\\\n- 上下架记录可追溯\\\\n\\\\n#### 2.1.5 菜品复制\\\\n\\\\n**功能描述**：复制已有菜品创建新菜品。\\\\n\\\\n**输入参数**：\\\\n- 源菜品ID：必填\\\\n- 新菜品名称：必填\\\\n\\\\n**输出结果**：\\\\n- 新菜品ID：复制的菜品ID\\\\n- 复制状态：成功或失败\\\\n\\\\n**业务规则**：\\\\n- 复制所有属性\\\\n- 自动生成新ID\\\\n- 可修改复制的菜品\\\\n- 支持批量复制\\\\n\\\\n### 2.2 分类管理\\\\n\\\\n#### 2.2.1 分类创建\\\\n\\\\n**功能描述**：创建菜品分类。\\\\n\\\\n**输入参数**：\\\\n- 分类名称：必填\\\\n- 父分类：可选，支持多级分类\\\\n- 分类图标：可选\\\\n- 分类排序：可选，控制显示顺序\\\\n- 分类描述：可选\\\\n\\\\n**输出结果**：\\\\n- 分类ID：系统生成的唯一标识\\\\n- 创建时间：分类创建时间\\\\n\\\\n**业务规则**：\\\\n- 同级分类名称不能重复\\\\n- 支持多级分类（最多3级）\\\\n- 分类排序数字越小越靠前\\\\n\\\\n#### 2.2.2 分类编辑\\\\n\\\\n**功能描述**：编辑已有分类。\\\\n\\\\n**输入参数**：\\\\n- 分类ID：必填\\\\n- 其他参数：同分类创建\\\\n\\\\n**输出结果**：\\\\n- 更新状态：成功或失败\\\\n\\\\n**业务规则**：\\\\n- 编辑后自动更新关联菜品\\\\n- 支持拖拽调整顺序\\\\n- 修改父分类时自动移动子分类\\\\n\\\\n#### 2.2.3 分类删除\\\\n\\\\n**功能描述**：删除已有分类。\\\\n\\\\n**输入参数**：\\\\n- 分类ID：必填\\\\n\\\\n**输出结果**：\\\\n- 删除状态：成功或失败\\\\n\\\\n**业务规则**：\\\\n- 删除前检查是否有关联菜品\\\\n- 有关联菜品时提示确认\\\\n- 删除父分类时需处理子分类\\\\n- 删除后不可恢复\\\\n\\\\n#### 2.2.4 分类排序\\\\n\\\\n**功能描述**：调整分类显示顺序。\\\\n\\\\n**输入参数**：\\\\n- 分类ID：必填\\\\n- 新位置：必填\\\\n\\\\n**输出结果**：\\\\n- 排序状态：成功或失败\\\\n\\\\n**业务规则**：\\\\n- 支持拖拽排序\\\\n- 支持上移下移\\\\n- 支持置顶置底\\\\n\\\\n### 2.3 价格管理\\\\n\\\\n#### 2.3.1 价格设置\\\\n\\\\n**功能描述**：设置菜品价格。\\\\n\\\\n**输入参数**：\\\\n- 菜品ID：必填\\\\n- 价格：必填，支持小数点后两位\\\\n- 价格类型：标准价、会员价、促销价\\\\n\\\\n**输出结果**：\\\\n- 价格设置状态：成功或失败\\\\n\\\\n**业务规则**：\\\\n- 价格必须大于0\\\\n- 会员价不能高于标准价\\\\n- 促销价不能高于会员价\\\\n- 价格变更记录历史\\\\n\\\\n#### 2.3.2 价格调整\\\\n\\\\n**功能描述**：批量调整菜品价格。\\\\n\\\\n**输入参数**：\\\\n- 菜品ID列表：必填\\\\n- 调整方式：固定金额、百分比\\\\n- 调整值：必填\\\\n- 调整原因：可选\\\\n\\\\n**输出结果**：\\\\n- 调整结果：成功或失败\\\\n- 影响菜品数：调整的菜品数量\\\\n\\\\n**业务规则**：\\\\n- 支持正向和负向调整\\\\n- 调整后价格不能小于0\\\\n- 记录调整历史\\\\n- 支持预览调整结果\\\\n\\\\n#### 2.3.3 价格历史\\\\n\\\\n**功能描述**：查看菜品价格变更历史。\\\\n\\\\n**输入参数**：\\\\n- 菜品ID：必填\\\\n- 时间范围：可选\\\\n\\\\n**输出结果**：\\\\n- 价格历史记录：时间、价格、操作人、原因\\\\n\\\\n**业务规则**：\\\\n- 记录所有价格变更\\\\n- 显示变更前后价格\\\\n- 支持导出历史记录\\\\n\\\\n### 2.4 库存关联\\\\n\\\\n#### 2.4.1 材料关联\\\\n\\\\n**功能描述**：关联菜品与库存材料。\\\\n\\\\n**输入参数**：\\\\n- 菜品ID：必填\\\\n- 材料ID：必填\\\\n- 用量：必填，单位与材料一致\\\\n- 损耗率：可选，默认0\\\\n\\\\n**输出结果**：\\\\n- 关联状态：成功或失败\\\\n\\\\n**业务规则**：\\\\n- 一个菜品可关联多个材料\\\\n- 记录材料用量和损耗率\\\\n- 关联后自动计算成本\\\\n- 支持批量关联\\\\n\\\\n#### 2.4.2 材料解绑\\\\n\\\\n**功能描述**：解除菜品与材料的关联。\\\\n\\\\n**输入参数**：\\\\n- 菜品ID：必填\\\\n- 材料ID：必填\\\\n\\\\n**输出结果**：\\\\n- 解绑状态：成功或失败\\\\n\\\\n**业务规则**：\\\\n- 解绑后重新计算成本\\\\n- 记录解绑操作\\\\n- 支持批量解绑\\\\n\\\\n#### 2.4.3 成本计算\\\\n\\\\n**功能描述**：自动计算菜品成本。\\\\n\\\\n**输入参数**：\\\\n- 菜品ID：必填\\\\n\\\\n**输出结果**：\\\\n- 菜品成本：计算出的成本\\\\n- 成本明细：各材料成本明细\\\\n\\\\n**业务规则**：\\\\n- 成本 = Σ(材料单价 × 用量 × (1 + 损耗率))\\\\n- 实时更新成本\\\\n- 支持手动调整成本\\\\n\\\\n### 2.5 图片管理\\\\n\\\\n#### 2.5.1 图片上传\\\\n\\\\n**功能描述**：上传菜品图片。\\\\n\\\\n**输入参数**：\\\\n- 菜品ID：必填\\\\n- 图片文件：必填，支持JPG、PNG、WEBP\\\\n- 图片类型：主图、副图\\\\n\\\\n**输出结果**：\\\\n- 图片URL：上传后的图片地址\\\\n- 上传状态：成功或失败\\\\n\\\\n**业务规则**：\\\\n- 图片大小不超过5MB\\\\n- 支持多张图片\\\\n- 自动生成缩略图\\\\n- 主图只能有一张\\\\n\\\\n#### 2.5.2 图片删除\\\\n\\\\n**功能描述**：删除菜品图片。\\\\n\\\\n**输入参数**：\\\\n- 图片ID：必填\\\\n\\\\n**输出结果**：\\\\n- 删除状态：成功或失败\\\\n\\\\n**业务规则**：\\\\n- 删除主图时需设置新主图\\\\n- 删除后不可恢复\\\\n- 同时删除缩略图\\\\n\\\\n#### 2.5.3 图片排序\\\\n\\\\n**功能描述**：调整菜品图片显示顺序。\\\\n\\\\n**输入参数**：\\\\n- 菜品ID：必填\\\\n- 图片ID列表：必填，按顺序排列\\\\n\\\\n**输出结果**：\\\\n- 排序状态：成功或失败\\\\n\\\\n**业务规则**：\\\\n- 第一张为主图\\\\n- 支持拖拽排序\\\\n- 实时更新显示\\\\n\\\\n### 2.6 规格管理\\\\n\\\\n#### 2.6.1 规格创建\\\\n\\\\n**功能描述**：创建菜品规格。\\\\n\\\\n**输入参数**：\\\\n- 菜品ID：必填\\\\n- 规格名称：必填，如大份、中份、小份\\\\n- 规格价格：必填\\\\n- 规格描述：可选\\\\n\\\\n**输出结果**：\\\\n- 规格ID：系统生成的唯一标识\\\\n- 创建状态：成功或失败\\\\n\\\\n**业务规则**：\\\\n- 一个菜品可有多个规格\\\\n- 规格名称不能重复\\\\n- 规格价格可不同\\\\n- 支持默认规格设置\\\\n\\\\n#### 2.6.2 规格编辑\\\\n\\\\n**功能描述**：编辑已有规格。\\\\n\\\\n**输入参数**：\\\\n- 规格ID：必填\\\\n- 其他参数：同规格创建\\\\n\\\\n**输出结果**：\\\\n- 更新状态：成功或失败\\\\n\\\\n**业务规则**：\\\\n- 编辑后自动更新价格\\\\n- 支持禁用规格\\\\n- 记录编辑历史\\\\n\\\\n#### 2.6.3 规格删除\\\\n\\\\n**功能描述**：删除已有规格。\\\\n\\\\n**输入参数**：\\\\n- 规格ID：必填\\\\n\\\\n**输出结果**：\\\\n- 删除状态：成功或失败\\\\n\\\\n**业务规则**：\\\\n- 删除前检查是否有关联订单\\\\n- 删除默认规格时需设置新默认\\\\n- 删除后不可恢复\\\\n\\\\n### 2.7 标签管理\\\\n\\\\n#### 2.7.1 标签创建\\\\n\\\\n**功能描述**：创建菜品标签。\\\\n\\\\n**输入参数**：\\\\n- 标签名称：必填\\\\n- 标签颜色：可选\\\\n- 标签类型：可选，如推荐、新品、热销\\\\n\\\\n**输出结果**：\\\\n- 标签ID：系统生成的唯一标识\\\\n- 创建状态：成功或失败\\\\n\\\\n**业务规则**：\\\\n- 标签名称不能重复\\\\n- 支持自定义颜色\\\\n- 一个菜品可有多个标签\\\\n\\\\n#### 2.7.2 标签分配\\\\n\\\\n**功能描述**：为菜品分配标签。\\\\n\\\\n**输入参数**：\\\\n- 菜品ID：必填\\\\n- 标签ID列表：必填\\\\n\\\\n**输出结果**：\\\\n- 分配状态：成功或失败\\\\n\\\\n**业务规则**：\\\\n- 支持批量分配\\\\n- 自动更新显示\\\\n- 记录分配历史\\\\n\\\\n#### 2.7.3 标签删除\\\\n\\\\n**功能描述**：删除已有标签。\\\\n\\\\n**输入参数**：\\\\n- 标签ID：必填\\\\n\\\\n**输出结果**：\\\\n- 删除状态：成功或失败\\\\n\\\\n**业务规则**：\\\\n- 删除前检查使用情况\\\\n- 删除后自动移除关联\\\\n- 删除后不可恢复\\\\n\\\\n### 2.8 营养管理\\\\n\\\\n#### 2.8.1 营养信息录入\\\\n\\\\n**功能描述**：录入菜品营养信息。\\\\n\\\\n**输入参数**：\\\\n- 菜品ID：必填\\\\n- 热量：可选，单位为千卡\\\\n- 蛋白质：可选，单位为克\\\\n- 脂肪：可选，单位为克\\\\n- 碳水化合物：可选，单位为克\\\\n- 钠：可选，单位为毫克\\\\n- 其他营养素：可选\\\\n\\\\n**输出结果**：\\\\n- 录入状态：成功或失败\\\\n\\\\n**业务规则**：\\\\n- 支持部分营养信息\\\\n- 自动计算总热量\\\\n- 支持自定义营养素\\\\n\\\\n#### 2.8.2 营养标签生成\\\\n\\\\n**功能描述**：根据营养信息生成营养标签。\\\\n\\\\n**输入参数**：\\\\n- 菜品ID：必填\\\\n- 标签格式：可选，如标准、简化\\\\n\\\\n**输出结果**：\\\\n- 营养标签：生成的标签图片或文本\\\\n\\\\n**业务规则**：\\\\n- 符合食品安全标准\\\\n- 自动计算每日摄入百分比\\\\n- 支持多语言标签\\\\n\\\\n### 2.9 搜索和筛选\\\\n\\\\n#### 2.9.1 菜品搜索\\\\n\\\\n**功能描述**：搜索菜品。\\\\n\\\\n**输入参数**：\\\\n- 搜索关键词：必填\\\\n- 搜索范围：可选，如名称、描述、材料\\\\n- 搜索方式：可选，如模糊、精确\\\\n\\\\n**输出结果**：\\\\n- 搜索结果：匹配的菜品列表\\\\n- 结果数量：匹配的菜品数量\\\\n\\\\n**业务规则**：\\\\n- 支持拼音搜索\\\\n- 支持同义词搜索\\\\n- 高亮显示匹配内容\\\\n- 记录搜索历史\\\\n\\\\n#### 2.9.2 菜品筛选\\\\n\\\\n**功能描述**：按条件筛选菜品。\\\\n\\\\n**输入参数**：\\\\n- 分类：可选\\\\n- 价格区间：可选\\\\n- 状态：可选\\\\n- 标签：可选\\\\n- 创建时间：可选\\\\n\\\\n**输出结果**：\\\\n- 筛选结果：符合条件的菜品列表\\\\n- 结果数量：符合条件的菜品数量\\\\n\\\\n**业务规则**：\\\\n- 支持多条件组合\\\\n- 实时更新结果\\\\n- 保存筛选条件\\\\n\\\\n#### 2.9.3 高级筛选\\\\n\\\\n**功能描述**：使用高级条件筛选菜品。\\\\n\\\\n**输入参数**：\\\\n- 销量区间：可选\\\\n- 利润区间：可选\\\\n- 评分区间：可选\\\\n- 材料列表：可选\\\\n- 自定义条件：可选\\\\n\\\\n**输出结果**：\\\\n- 筛选结果：符合条件的菜品列表\\\\n\\\\n**业务规则**：\\\\n- 支持自定义筛选条件\\\\n- 支持保存筛选方案\\\\n- 支持导出筛选结果\\\\n\\\\n### 2.10 批量操作\\\\n\\\\n#### 2.10.1 批量编辑\\\\n\\\\n**功能描述**：批量编辑菜品。\\\\n\\\\n**输入参数**：\\\\n- 菜品ID列表：必填\\\\n- 编辑字段：可选，如价格、分类、状态\\\\n- 编辑值：必填\\\\n\\\\n**输出结果**：\\\\n- 编辑结果：成功或失败\\\\n- 影响菜品数：编辑的菜品数量\\\\n\\\\n**业务规则**：\\\\n- 支持多字段同时编辑\\\\n- 记录批量操作历史\\\\n- 支持预览编辑结果\\\\n\\\\n#### 2.10.2 批量上下架\\\\n\\\\n**功能描述**：批量上下架菜品。\\\\n\\\\n**输入参数**：\\\\n- 菜品ID列表：必填\\\\n- 操作：上架或下架\\\\n\\\\n**输出结果**：\\\\n- 操作结果：成功或失败\\\\n- 影响菜品数：操作的菜品数量\\\\n\\\\n**业务规则**：\\\\n- 支持全选上下架\\\\n- 操作前确认\\\\n- 记录操作历史\\\\n\\\\n#### 2.10.3 批量删除\\\\n\\\\n**功能描述**：批量删除菜品。\\\\n\\\\n**输入参数**：\\\\n- 菜品ID列表：必填\\\\n\\\\n**输出结果**：\\\\n- 删除结果：成功或失败\\\\n- 影响菜品数：删除的菜品数量\\\\n\\\\n**业务规则**：\\\\n- 删除前检查关联订单\\\\n- 需要二次确认\\\\n- 删除后不可恢复\\\\n\\\\n#### 2.10.4 批量导入\\\\n\\\\n**功能描述**：批量导入菜品。\\\\n\\\\n**输入参数**：\\\\n- 导入文件：必填，支持Excel、CSV\\\\n- 导入模板：可选\\\\n\\\\n**输出结果**：\\\\n- 导入结果：成功或失败\\\\n- 成功数量：成功导入的菜品数\\\\n- 失败数量：导入失败的菜品数\\\\n- 失败原因：导入失败的原因\\\\n\\\\n**业务规则**：\\\\n- 提供导入模板\\\\n- 验证数据格式\\\\n- 支持预览导入数据\\\\n- 记录导入历史\\\\n\\\\n#### 2.10.5 批量导出\\\\n\\\\n**功能描述**：批量导出菜品。\\\\n\\\\n**输入参数**：\\\\n- 导出格式：可选，如Excel、CSV、PDF\\\\n- 导出字段：可选，选择要导出的字段\\\\n- 导出范围：可选，全部或筛选结果\\\\n\\\\n**输出结果**：\\\\n- 导出文件：生成的导出文件\\\\n\\\\n**业务规则**：\\\\n- 支持自定义导出字段\\\\n- 支持多格式导出\\\\n- 记录导出历史\\\\n\\\\n## 3. 非功能需求\\\\n\\\\n### 3.1 性能需求\\\\n\\\\n- **响应时间**：菜品列表加载时间不超过1秒，搜索响应时间不超过500ms\\\\n- **并发处理**：支持至少50个并发用户同时操作\\\\n- **数据处理**：支持处理10万级菜品数据\\\\n- **图片加载**：菜品图片加载时间不超过2秒\\\\n\\\\n### 3.2 可用性需求\\\\n\\\\n- **易用性**：界面简洁直观，操作流程清晰\\\\n- **可访问性**：支持键盘导航和屏幕阅读器\\\\n- **多语言**：支持中英文切换\\\\n- **响应式设计**：支持PC、平板、手机访问\\\\n\\\\n### 3.3 安全需求\\\\n\\\\n- **数据加密**：敏感数据加密存储\\\\n- **访问控制**：基于角色的访问控制\\\\n- **操作审计**：记录所有操作日志\\\\n- **数据备份**：定期备份数据\\\\n\\\\n### 3.4 兼容性需求\\\\n\\\\n- **浏览器兼容**：支持Chrome、Firefox、Safari、Edge最新版本\\\\n- **设备兼容**：支持Windows、macOS、iOS、Android\\\\n- **分辨率**：支持1920x1080及以上分辨率\\\\n\\\\n## 4. 接口设计\\\\n\\\\n### 4.1 菜品管理接口\\\\n\\\\n```typescript\\\\n// 获取菜品列表\\\\nGET /api/v1/menu/items\\\\nQuery Parameters:\\\\n  - page: number\\\\n  - limit: number\\\\n  - category: string\\\\n  - available: boolean\\\\n  - search: string\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"items\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"id\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n        \\\\\\\"name\\\\\\\": \\\\\\\"宫保鸡丁\\\\\\\",\\\\n        \\\\\\\"category\\\\\\\": \\\\\\\"主食\\\\\\\",\\\\n        \\\\\\\"price\\\\\\\": 48.00,\\\\n        \\\\\\\"cost\\\\\\\": 24.00,\\\\n        \\\\\\\"description\\\\\\\": \\\\\\\"经典川菜\\\\\\\",\\\\n        \\\\\\\"images\\\\\\\": [\\\\\\\"url1\\\\\\\", \\\\\\\"url2\\\\\\\"],\\\\n        \\\\\\\"tags\\\\\\\": [\\\\\\\"推荐\\\\\\\", \\\\\\\"热销\\\\\\\"],\\\\n        \\\\\\\"available\\\\\\\": true,\\\\n        \\\\\\\"preparationTime\\\\\\\": 15,\\\\n        \\\\\\\"createdAt\\\\\\\": \\\\\\\"2025-01-20T10:00:00Z\\\\\\\"\\\\n      }\\\\n    ],\\\\n    \\\\\\\"pagination\\\\\\\": {\\\\n      \\\\\\\"page\\\\\\\": 1,\\\\n      \\\\\\\"limit\\\\\\\": 20,\\\\n      \\\\\\\"total\\\\\\\": 100,\\\\n      \\\\\\\"totalPages\\\\\\\": 5\\\\n    }\\\\n  }\\\\n}\\\\n\\\\n// 创建菜品\\\\nPOST /api/v1/menu/items\\\\nBody:\\\\n{\\\\n  \\\\\\\"name\\\\\\\": \\\\\\\"宫保鸡丁\\\\\\\",\\\\n  \\\\\\\"category\\\\\\\": \\\\\\\"主食\\\\\\\",\\\\n  \\\\\\\"price\\\\\\\": 48.00,\\\\n  \\\\\\\"cost\\\\\\\": 24.00,\\\\n  \\\\\\\"description\\\\\\\": \\\\\\\"经典川菜\\\\\\\",\\\\n  \\\\\\\"images\\\\\\\": [\\\\\\\"url1\\\\\\\", \\\\\\\"url2\\\\\\\"],\\\\n  \\\\\\\"tags\\\\\\\": [\\\\\\\"推荐\\\\\\\", \\\\\\\"热销\\\\\\\"],\\\\n  \\\\\\\"preparationTime\\\\\\\": 15\\\\n}\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"id\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n    \\\\\\\"name\\\\\\\": \\\\\\\"宫保鸡丁\\\\\\\",\\\\n    \\\\\\\"createdAt\\\\\\\": \\\\\\\"2025-01-20T10:00:00Z\\\\\\\"\\\\n  }\\\\n}\\\\n\\\\n// 更新菜品\\\\nPUT /api/v1/menu/items/:id\\\\nBody: 同创建菜品\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"id\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n    \\\\\\\"updatedAt\\\\\\\": \\\\\\\"2025-01-20T11:00:00Z\\\\\\\"\\\\n  }\\\\n}\\\\n\\\\n// 删除菜品\\\\nDELETE /api/v1/menu/items/:id\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"message\\\\\\\": \\\\\\\"菜品删除成功\\\\\\\"\\\\n}\\\\n\\\\n// 上下架菜品\\\\nPATCH /api/v1/menu/items/:id/availability\\\\nBody:\\\\n{\\\\n  \\\\\\\"available\\\\\\\": true\\\\n}\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"message\\\\\\\": \\\\\\\"菜品上架成功\\\\\\\"\\\\n}\\\\n```\\\\n\\\\n### 4.2 分类管理接口\\\\n\\\\n```typescript\\\\n// 获取分类列表\\\\nGET /api/v1/menu/categories\\\\nQuery Parameters:\\\\n  - parentId: string\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"items\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"id\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n        \\\\\\\"name\\\\\\\": \\\\\\\"主食\\\\\\\",\\\\n        \\\\\\\"parentId\\\\\\\": null,\\\\n        \\\\\\\"icon\\\\\\\": \\\\\\\"icon_url\\\\\\\",\\\\n        \\\\\\\"sortOrder\\\\\\\": 1,\\\\n        \\\\\\\"description\\\\\\\": \\\\\\\"主食类菜品\\\\\\\",\\\\n        \\\\\\\"children\\\\\\\": []\\\\n      }\\\\n    ]\\\\n  }\\\\n}\\\\n\\\\n// 创建分类\\\\nPOST /api/v1/menu/categories\\\\nBody:\\\\n{\\\\n  \\\\\\\"name\\\\\\\": \\\\\\\"主食\\\\\\\",\\\\n  \\\\\\\"parentId\\\\\\\": null,\\\\n  \\\\\\\"icon\\\\\\\": \\\\\\\"icon_url\\\\\\\",\\\\n  \\\\\\\"sortOrder\\\\\\\": 1,\\\\n  \\\\\\\"description\\\\\\\": \\\\\\\"主食类菜品\\\\\\\"\\\\n}\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"id\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n    \\\\\\\"createdAt\\\\\\\": \\\\\\\"2025-01-20T10:00:00Z\\\\\\\"\\\\n  }\\\\n}\\\\n\\\\n// 更新分类\\\\nPUT /api/v1/menu/categories/:id\\\\nBody: 同创建分类\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"message\\\\\\\": \\\\\\\"分类更新成功\\\\\\\"\\\\n}\\\\n\\\\n// 删除分类\\\\nDELETE /api/v1/menu/categories/:id\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"message\\\\\\\": \\\\\\\"分类删除成功\\\\\\\"\\\\n}\\\\n```\\\\n\\\\n### 4.3 价格管理接口\\\\n\\\\n```typescript\\\\n// 获取价格历史\\\\nGET /api/v1/menu/items/:id/price-history\\\\nQuery Parameters:\\\\n  - startDate: string\\\\n  - endDate: string\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"history\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"price\\\\\\\": 48.00,\\\\n        \\\\\\\"oldPrice\\\\\\\": 45.00,\\\\n        \\\\\\\"reason\\\\\\\": \\\\\\\"成本上涨\\\\\\\",\\\\n        \\\\\\\"operator\\\\\\\": \\\\\\\"张三\\\\\\\",\\\\n        \\\\\\\"createdAt\\\\\\\": \\\\\\\"2025-01-20T10:00:00Z\\\\\\\"\\\\n      }\\\\n    ]\\\\n  }\\\\n}\\\\n\\\\n// 批量调整价格\\\\nPOST /api/v1/menu/items/batch/price\\\\nBody:\\\\n{\\\\n  \\\\\\\"itemIds\\\\\\\": [\\\\\\\"1\\\\\\\", \\\\\\\"2\\\\\\\", \\\\\\\"3\\\\\\\"],\\\\n  \\\\\\\"adjustmentType\\\\\\\": \\\\\\\"percentage\\\\\\\",\\\\n  \\\\\\\"value\\\\\\\": 10,\\\\n  \\\\\\\"reason\\\\\\\": \\\\\\\"成本调整\\\\\\\"\\\\n}\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"affectedCount\\\\\\\": 3,\\\\n    \\\\\\\"results\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"itemId\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n        \\\\\\\"oldPrice\\\\\\\": 48.00,\\\\n        \\\\\\\"newPrice\\\\\\\": 52.80\\\\n      }\\\\n    ]\\\\n  }\\\\n}\\\\n```\\\\n\\\\n### 4.4 库存关联接口\\\\n\\\\n```typescript\\\\n// 获取菜品材料关联\\\\nGET /api/v1/menu/items/:id/materials\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"materials\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"materialId\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n        \\\\\\\"name\\\\\\\": \\\\\\\"鸡肉\\\\\\\",\\\\n        \\\\\\\"quantity\\\\\\\": 200,\\\\n        \\\\\\\"unit\\\\\\\": \\\\\\\"克\\\\\\\",\\\\n        \\\\\\\"wasteRate\\\\\\\": 0.05,\\\\n        \\\\\\\"cost\\\\\\\": 12.00\\\\n      }\\\\n    ]\\\\n  }\\\\n}\\\\n\\\\n// 关联材料\\\\nPOST /api/v1/menu/items/:id/materials\\\\nBody:\\\\n{\\\\n  \\\\\\\"materialId\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n  \\\\\\\"quantity\\\\\\\": 200,\\\\n  \\\\\\\"wasteRate\\\\\\\": 0.05\\\\n}\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"message\\\\\\\": \\\\\\\"材料关联成功\\\\\\\"\\\\n}\\\\n\\\\n// 解绑材料\\\\nDELETE /api/v1/menu/items/:id/materials/:materialId\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"message\\\\\\\": \\\\\\\"材料解绑成功\\\\\\\"\\\\n}\\\\n```\\\\n\\\\n### 4.5 批量操作接口\\\\n\\\\n```typescript\\\\n// 批量编辑\\\\nPOST /api/v1/menu/items/batch/edit\\\\nBody:\\\\n{\\\\n  \\\\\\\"itemIds\\\\\\\": [\\\\\\\"1\\\\\\\", \\\\\\\"2\\\\\\\", \\\\\\\"3\\\\\\\"],\\\\n  \\\\\\\"fields\\\\\\\": {\\\\n    \\\\\\\"category\\\\\\\": \\\\\\\"主食\\\\\\\",\\\\n    \\\\\\\"available\\\\\\\": true\\\\n  }\\\\n}\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"affectedCount\\\\\\\": 3\\\\n  }\\\\n}\\\\n\\\\n// 批量导入\\\\nPOST /api/v1/menu/items/batch/import\\\\nBody:\\\\n{\\\\n  \\\\\\\"file\\\\\\\": \\\\\\\"file_data\\\\\\\",\\\\n  \\\\\\\"template\\\\\\\": \\\\\\\"standard\\\\\\\"\\\\n}\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"successCount\\\\\\\": 95,\\\\n    \\\\\\\"failedCount\\\\\\\": 5,\\\\n    \\\\\\\"failedItems\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"row\\\\\\\": 10,\\\\n        \\\\\\\"reason\\\\\\\": \\\\\\\"价格格式错误\\\\\\\"\\\\n      }\\\\n    ]\\\\n  }\\\\n}\\\\n\\\\n// 批量导出\\\\nPOST /api/v1/menu/items/batch/export\\\\nBody:\\\\n{\\\\n  \\\\\\\"format\\\\\\\": \\\\\\\"excel\\\\\\\",\\\\n  \\\\\\\"fields\\\\\\\": [\\\\\\\"name\\\\\\\", \\\\\\\"category\\\\\\\", \\\\\\\"price\\\\\\\", \\\\\\\"cost\\\\\\\"],\\\\n  \\\\\\\"filters\\\\\\\": {\\\\n    \\\\\\\"category\\\\\\\": \\\\\\\"主食\\\\\\\",\\\\n    \\\\\\\"available\\\\\\\": true\\\\n  }\\\\n}\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"downloadUrl\\\\\\\": \\\\\\\"download_url\\\\\\\",\\\\n    \\\\\\\"expiresAt\\\\\\\": \\\\\\\"2025-01-21T10:00:00Z\\\\\\\"\\\\n  }\\\\n}\\\\n```\\\\n\\\\n## 5. 数据模型\\\\n\\\\n### 5.1 菜品模型\\\\n\\\\n```typescript\\\\ninterface MenuItem {\\\\n  id: string;\\\\n  name: string;\\\\n  nameEn?: string;\\\\n  category: string;\\\\n  categoryId: string;\\\\n  price: number;\\\\n  cost: number;\\\\n  profit: number;\\\\n  profitRate: number;\\\\n  description?: string;\\\\n  descriptionEn?: string;\\\\n  images: string[];\\\\n  mainImage: string;\\\\n  tags: string[];\\\\n  available: boolean;\\\\n  preparationTime?: number;\\\\n  specifications: MenuItemSpecification[];\\\\n  materials: MenuItemMaterial[];\\\\n  nutrition?: NutritionInfo;\\\\n  attributes: MenuItemAttribute[];\\\\n  createdAt: string;\\\\n  updatedAt: string;\\\\n  createdBy: string;\\\\n  updatedBy: string;\\\\n}\\\\n\\\\ninterface MenuItemSpecification {\\\\n  id: string;\\\\n  name: string;\\\\n  price: number;\\\\n  description?: string;\\\\n  isDefault: boolean;\\\\n  sortOrder: number;\\\\n}\\\\n\\\\ninterface MenuItemMaterial {\\\\n  materialId: string;\\\\n  materialName: string;\\\\n  quantity: number;\\\\n  unit: string;\\\\n  wasteRate: number;\\\\n  cost: number;\\\\n}\\\\n\\\\ninterface NutritionInfo {\\\\n  calories: number;\\\\n  protein: number;\\\\n  fat: number;\\\\n  carbohydrates: number;\\\\n  sodium: number;\\\\n  fiber?: number;\\\\n  sugar?: number;\\\\n  customNutrients?: CustomNutrient[];\\\\n}\\\\n\\\\ninterface CustomNutrient {\\\\n  name: string;\\\\n  value: number;\\\\n  unit: string;\\\\n}\\\\n\\\\ninterface MenuItemAttribute {\\\\n  name: string;\\\\n  value: string;\\\\n  type: \\\\'spiciness\\\\' | \\\\'temperature\\\\' | \\\\'dietary\\\\' | \\\\'custom\\\\';\\\\n}\\\\n```\\\\n\\\\n### 5.2 分类模型\\\\n\\\\n```typescript\\\\ninterface MenuCategory {\\\\n  id: string;\\\\n  name: string;\\\\n  nameEn?: string;\\\\n  parentId: string | null;\\\\n  icon?: string;\\\\n  sortOrder: number;\\\\n  description?: string;\\\\n  descriptionEn?: string;\\\\n  children?: MenuCategory[];\\\\n  itemCount: number;\\\\n  createdAt: string;\\\\n  updatedAt: string;\\\\n}\\\\n```\\\\n\\\\n### 5.3 标签模型\\\\n\\\\n```typescript\\\\ninterface MenuTag {\\\\n  id: string;\\\\n  name: string;\\\\n  nameEn?: string;\\\\n  color: string;\\\\n  type: TagType;\\\\n  sortOrder: number;\\\\n  createdAt: string;\\\\n}\\\\n\\\\nenum TagType {\\\\n  RECOMMENDED = \\\\'recommended\\\\',\\\\n  NEW = \\\\'new\\\\',\\\\n  HOT_SELLING = \\\\'hot_selling\\\\',\\\\n  LIMITED = \\\\'limited\\\\',\\\\n  CUSTOM = \\\\'custom\\\\'\\\\n}\\\\n```\\\\n\\\\n### 5.4 价格历史模型\\\\n\\\\n```typescript\\\\ninterface PriceHistory {\\\\n  id: string;\\\\n  itemId: string;\\\\n  itemName: string;\\\\n  oldPrice: number;\\\\n  newPrice: number;\\\\n  priceType: PriceType;\\\\n  reason?: string;\\\\n  operator: string;\\\\n  operatorName: string;\\\\n  createdAt: string;\\\\n}\\\\n\\\\nenum PriceType {\\\\n  STANDARD = \\\\'standard\\\\',\\\\n  MEMBER = \\\\'member\\\\',\\\\n  PROMOTION = \\\\'promotion\\\\'\\\\n}\\\\n```\\\\n\\\\n## 6. 用户界面设计\\\\n\\\\n### 6.1 主界面布局\\\\n\\\\n```\\\\n┌─────────────────────────────────────────────────────────────┐\\\\n│  菜单管理                                              │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  [添加菜品]                                           │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  [菜品分类▼] [状态▼] [搜索菜品...] [查询] [重置]      │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  ┌─────────────────────────────────────────────────────┐   │\\\\n│  │ ID  菜品名称    分类  价格   状态  操作        │   │\\\\n│  │  1   宫保鸡丁    主食  ¥48.00 [开] [编辑][删除]│   │\\\\n│  │  2   麻婆豆腐    主食  ¥38.00 [开] [编辑][删除]│   │\\\\n│  │  3   糖醋里脊    主食  ¥42.00 [关] [编辑][删除]│   │\\\\n│  └─────────────────────────────────────────────────────┘   │\\\\n│  共 100 条记录  [上一页] 1 / 5 [下一页]              │\\\\n└─────────────────────────────────────────────────────────────┘\\\\n```\\\\n\\\\n### 6.2 菜品编辑界面\\\\n\\\\n```\\\\n┌─────────────────────────────────────────────────────────────┐\\\\n│  编辑菜品                                              │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  基本信息                                              │\\\\n│  ┌─────────────────────────────────────────────────────┐   │\\\\n│  │ 菜品名称: [宫保鸡丁_________________]          │   │\\\\n│  │ 英文名称: [Kung Pao Chicken___________]          │   │\\\\n│  │ 菜品分类: [主食▼]                              │   │\\\\n│  │ 菜品价格: [¥48.00_____]                        │   │\\\\n│  │ 菜品成本: [¥24.00_____]                        │   │\\\\n│  │ 制作时间: [15_____] 分钟                         │   │\\\\n│  └─────────────────────────────────────────────────────┘   │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  菜品描述                                              │\\\\n│  ┌─────────────────────────────────────────────────────┐   │\\\\n│  │ 经典川菜，选用优质鸡肉，配以花生、干辣椒等...     │   │\\\\n│  └─────────────────────────────────────────────────────┘   │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  菜品图片                                              │\\\\n│  ┌─────────────────────────────────────────────────────┐   │\\\\n│  │ [主图] [副图1] [副图2] [+上传图片]           │   │\\\\n│  └─────────────────────────────────────────────────────┘   │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  菜品标签                                              │\\\\n│  ┌─────────────────────────────────────────────────────┐   │\\\\n│  │ [推荐] [热销] [新品] [+添加标签]               │   │\\\\n│  └─────────────────────────────────────────────────────┘   │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  [取消] [保存]                                       │\\\\n└─────────────────────────────────────────────────────────────┘\\\\n```\\\\n\\\\n### 6.3 分类管理界面\\\\n\\\\n```\\\\n┌─────────────────────────────────────────────────────────────┐\\\\n│  分类管理                                              │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  [+添加分类]                                           │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  ┌─────────────────────────────────────────────────────┐   │\\\\n│  │ ▼ 主食 (50)                                    │   │\\\\n│  │   ▼ 汤品 (30)                                 │   │\\\\n│  │   ▼ 小菜 (40)                                  │   │\\\\n│  │ ▼ 饮料 (20)                                    │   │\\\\n│  │ ▼ 甜点 (15)                                    │   │\\\\n│  └─────────────────────────────────────────────────────┘   │\\\\n│  ┌─────────────────────────────────────────────────────┐   │\\\\n│  │ [编辑] [删除] [上移] [下移] [置顶] [置底]     │   │\\\\n│  └─────────────────────────────────────────────────────┘   │\\\\n└─────────────────────────────────────────────────────────────┘\\\\n```\\\\n\\\\n## 7. 测试需求\\\\n\\\\n### 7.1 单元测试\\\\n\\\\n- 菜品CRUD操作测试\\\\n- 价格计算测试\\\\n- 成本计算测试\\\\n- 库存关联测试\\\\n- 批量操作测试\\\\n\\\\n### 7.2 集成测试\\\\n\\\\n- 菜品与库存集成测试\\\\n- 菜品与订单集成测试\\\\n- 图片上传集成测试\\\\n- 批量导入导出测试\\\\n\\\\n### 7.3 性能测试\\\\n\\\\n- 大数据量加载测试\\\\n- 搜索性能测试\\\\n- 图片加载测试\\\\n- 并发操作测试\\\\n\\\\n### 7.4 用户验收测试\\\\n\\\\n- 功能完整性测试\\\\n- 易用性测试\\\\n- 兼容性测试\\\\n- 安全性测试\\\\n\\\\n## 8. 部署和维护\\\\n\\\\n### 8.1 部署要求\\\\n\\\\n- 服务器配置：4核CPU、8GB内存、200GB SSD\\\\n- 图片存储：支持对象存储（如OSS、S3）\\\\n- 数据库：PostgreSQL 13+\\\\n\\\\n### 8.2 监控要求\\\\n\\\\n- 系统监控：CPU、内存、磁盘、网络\\\\n- 应用监控：响应时间、错误率、吞吐量\\\\n- 业务监控：菜品数据准确性、价格更新及时性\\\\n\\\\n### 8.3 备份策略\\\\n\\\\n- 数据库备份：每日全量备份，每小时增量备份\\\\n- 图片备份：每周全量备份\\\\n- 配置备份：每次配置变更后备份\\\\n\\\\n### 8.4 维护计划\\\\n\\\\n- 定期更新：每月更新菜品数据\\\\n- 性能优化：每季度进行性能优化\\\\n- 安全检查：每周进行安全检查\\\\n- 功能迭代：根据用户反馈持续优化\\\\n\\\\n## 9. 版本历史\\\\n\\\\n| 版本 | 日期 | 作者 | 变更说明 |\\\\n|------|------|------|---------|\\\\n| 1.0.0 | 2025-01-20 | YYC³ | 初始版本 |\\\\n\",\"originAcceptText\":\"# 菜单管理功能模块需求分析与设计文档\\n\\n## 1. 模块概述\\n\\n### 1.1 模块简介\\n\\n菜单管理功能模块是YYC³餐饮平台的核心业务模块，负责管理餐厅的所有菜品信息，包括菜品的创建、编辑、删除、分类管理、价格管理、库存关联等功能。该模块为餐厅提供完整的菜单管理能力，确保菜单信息的准确性和实时性。\\n\\n### 1.2 模块目标\\n\\n- **集中管理**：统一管理所有菜品信息，确保数据一致性\\n- **灵活分类**：支持多层级分类管理，便于菜品组织\\n- **实时更新**：支持菜品上下架、价格调整等实时操作\\n- **库存联动**：与库存系统联动，确保菜品可售性\\n- **成本控制**：记录菜品成本，支持成本分析\\n- **多语言**：支持多语言菜品名称和描述\\n\\n### 1.3 适用范围\\n\\n- 餐厅管理者：管理菜单、调整价格、控制菜品上下架\\n- 厨房管理人员：查看菜品信息、了解制作要求\\n- 财务人员：分析菜品成本、计算利润\\n- 市场营销人员：了解菜品信息、制定促销策略\\n- 客户服务人员：查看菜品详情、解答客户疑问\\n\\n## 2. 功能需求\\n\\n### 2.1 菜品管理\\n\\n#### 2.1.1 菜品创建\\n\\n**功能描述**：创建新的菜品。\\n\\n**输入参数**：\\n- 菜品名称：必填，支持中英文\\n- 菜品分类：必填，从分类列表选择\\n- 价格：必填，支持小数点后两位\\n- 成本：必填，用于计算利润\\n- 菜品图片：可选，支持上传\\n- 菜品描述：可选，支持富文本\\n- 制作时间：可选，单位为分钟\\n- 菜品标签：可选，多个标签\\n- 菜品规格：可选，如大份、中份、小份\\n- 菜品属性：可选，如辣度、温度等\\n- 菜品材料：可选，关联库存材料\\n- 菜品营养：可选，营养成分信息\\n\\n**输出结果**：\\n- 菜品ID：系统生成的唯一标识\\n- 创建时间：菜品创建时间\\n- 操作状态：创建成功或失败\\n\\n**业务规则**：\\n- 菜品名称不能重复\\n- 价格必须大于0\\n- 成本必须小于价格\\n- 图片大小不超过5MB\\n- 支持批量创建\\n\\n#### 2.1.2 菜品编辑\\n\\n**功能描述**：编辑已有菜品信息。\\n\\n**输入参数**：\\n- 菜品ID：必填，标识要编辑的菜品\\n- 其他参数：同菜品创建\\n\\n**输出结果**：\\n- 更新时间：菜品更新时间\\n- 操作状态：更新成功或失败\\n\\n**业务规则**：\\n- 编辑后自动更新相关订单\\n- 价格变更记录历史\\n- 支持部分字段编辑\\n- 编辑记录可追溯\\n\\n#### 2.1.3 菜品删除\\n\\n**功能描述**：删除已有菜品。\\n\\n**输入参数**：\\n- 菜品ID：必填，标识要删除的菜品\\n\\n**输出结果**：\\n- 删除状态：删除成功或失败\\n\\n**业务规则**：\\n- 删除前检查是否有关联订单\\n- 有关联订单时提示确认\\n- 删除后不可恢复\\n- 删除记录保留\\n\\n#### 2.1.4 菜品上下架\\n\\n**功能描述**：控制菜品的上架和下架状态。\\n\\n**输入参数**：\\n- 菜品ID：必填\\n- 状态：上架或下架\\n\\n**输出结果**：\\n- 状态更新结果\\n\\n**业务规则**：\\n- 下架后订单中不可选择\\n- 上架后立即可用\\n- 支持批量上下架\\n- 上下架记录可追溯\\n\\n#### 2.1.5 菜品复制\\n\\n**功能描述**：复制已有菜品创建新菜品。\\n\\n**输入参数**：\\n- 源菜品ID：必填\\n- 新菜品名称：必填\\n\\n**输出结果**：\\n- 新菜品ID：复制的菜品ID\\n- 复制状态：成功或失败\\n\\n**业务规则**：\\n- 复制所有属性\\n- 自动生成新ID\\n- 可修改复制的菜品\\n- 支持批量复制\\n\\n### 2.2 分类管理\\n\\n#### 2.2.1 分类创建\\n\\n**功能描述**：创建菜品分类。\\n\\n**输入参数**：\\n- 分类名称：必填\\n- 父分类：可选，支持多级分类\\n- 分类图标：可选\\n- 分类排序：可选，控制显示顺序\\n- 分类描述：可选\\n\\n**输出结果**：\\n- 分类ID：系统生成的唯一标识\\n- 创建时间：分类创建时间\\n\\n**业务规则**：\\n- 同级分类名称不能重复\\n- 支持多级分类（最多3级）\\n- 分类排序数字越小越靠前\\n\\n#### 2.2.2 分类编辑\\n\\n**功能描述**：编辑已有分类。\\n\\n**输入参数**：\\n- 分类ID：必填\\n- 其他参数：同分类创建\\n\\n**输出结果**：\\n- 更新状态：成功或失败\\n\\n**业务规则**：\\n- 编辑后自动更新关联菜品\\n- 支持拖拽调整顺序\\n- 修改父分类时自动移动子分类\\n\\n#### 2.2.3 分类删除\\n\\n**功能描述**：删除已有分类。\\n\\n**输入参数**：\\n- 分类ID：必填\\n\\n**输出结果**：\\n- 删除状态：成功或失败\\n\\n**业务规则**：\\n- 删除前检查是否有关联菜品\\n- 有关联菜品时提示确认\\n- 删除父分类时需处理子分类\\n- 删除后不可恢复\\n\\n#### 2.2.4 分类排序\\n\\n**功能描述**：调整分类显示顺序。\\n\\n**输入参数**：\\n- 分类ID：必填\\n- 新位置：必填\\n\\n**输出结果**：\\n- 排序状态：成功或失败\\n\\n**业务规则**：\\n- 支持拖拽排序\\n- 支持上移下移\\n- 支持置顶置底\\n\\n### 2.3 价格管理\\n\\n#### 2.3.1 价格设置\\n\\n**功能描述**：设置菜品价格。\\n\\n**输入参数**：\\n- 菜品ID：必填\\n- 价格：必填，支持小数点后两位\\n- 价格类型：标准价、会员价、促销价\\n\\n**输出结果**：\\n- 价格设置状态：成功或失败\\n\\n**业务规则**：\\n- 价格必须大于0\\n- 会员价不能高于标准价\\n- 促销价不能高于会员价\\n- 价格变更记录历史\\n\\n#### 2.3.2 价格调整\\n\\n**功能描述**：批量调整菜品价格。\\n\\n**输入参数**：\\n- 菜品ID列表：必填\\n- 调整方式：固定金额、百分比\\n- 调整值：必填\\n- 调整原因：可选\\n\\n**输出结果**：\\n- 调整结果：成功或失败\\n- 影响菜品数：调整的菜品数量\\n\\n**业务规则**：\\n- 支持正向和负向调整\\n- 调整后价格不能小于0\\n- 记录调整历史\\n- 支持预览调整结果\\n\\n#### 2.3.3 价格历史\\n\\n**功能描述**：查看菜品价格变更历史。\\n\\n**输入参数**：\\n- 菜品ID：必填\\n- 时间范围：可选\\n\\n**输出结果**：\\n- 价格历史记录：时间、价格、操作人、原因\\n\\n**业务规则**：\\n- 记录所有价格变更\\n- 显示变更前后价格\\n- 支持导出历史记录\\n\\n### 2.4 库存关联\\n\\n#### 2.4.1 材料关联\\n\\n**功能描述**：关联菜品与库存材料。\\n\\n**输入参数**：\\n- 菜品ID：必填\\n- 材料ID：必填\\n- 用量：必填，单位与材料一致\\n- 损耗率：可选，默认0\\n\\n**输出结果**：\\n- 关联状态：成功或失败\\n\\n**业务规则**：\\n- 一个菜品可关联多个材料\\n- 记录材料用量和损耗率\\n- 关联后自动计算成本\\n- 支持批量关联\\n\\n#### 2.4.2 材料解绑\\n\\n**功能描述**：解除菜品与材料的关联。\\n\\n**输入参数**：\\n- 菜品ID：必填\\n- 材料ID：必填\\n\\n**输出结果**：\\n- 解绑状态：成功或失败\\n\\n**业务规则**：\\n- 解绑后重新计算成本\\n- 记录解绑操作\\n- 支持批量解绑\\n\\n#### 2.4.3 成本计算\\n\\n**功能描述**：自动计算菜品成本。\\n\\n**输入参数**：\\n- 菜品ID：必填\\n\\n**输出结果**：\\n- 菜品成本：计算出的成本\\n- 成本明细：各材料成本明细\\n\\n**业务规则**：\\n- 成本 = Σ(材料单价 × 用量 × (1 + 损耗率))\\n- 实时更新成本\\n- 支持手动调整成本\\n\\n### 2.5 图片管理\\n\\n#### 2.5.1 图片上传\\n\\n**功能描述**：上传菜品图片。\\n\\n**输入参数**：\\n- 菜品ID：必填\\n- 图片文件：必填，支持JPG、PNG、WEBP\\n- 图片类型：主图、副图\\n\\n**输出结果**：\\n- 图片URL：上传后的图片地址\\n- 上传状态：成功或失败\\n\\n**业务规则**：\\n- 图片大小不超过5MB\\n- 支持多张图片\\n- 自动生成缩略图\\n- 主图只能有一张\\n\\n#### 2.5.2 图片删除\\n\\n**功能描述**：删除菜品图片。\\n\\n**输入参数**：\\n- 图片ID：必填\\n\\n**输出结果**：\\n- 删除状态：成功或失败\\n\\n**业务规则**：\\n- 删除主图时需设置新主图\\n- 删除后不可恢复\\n- 同时删除缩略图\\n\\n#### 2.5.3 图片排序\\n\\n**功能描述**：调整菜品图片显示顺序。\\n\\n**输入参数**：\\n- 菜品ID：必填\\n- 图片ID列表：必填，按顺序排列\\n\\n**输出结果**：\\n- 排序状态：成功或失败\\n\\n**业务规则**：\\n- 第一张为主图\\n- 支持拖拽排序\\n- 实时更新显示\\n\\n### 2.6 规格管理\\n\\n#### 2.6.1 规格创建\\n\\n**功能描述**：创建菜品规格。\\n\\n**输入参数**：\\n- 菜品ID：必填\\n- 规格名称：必填，如大份、中份、小份\\n- 规格价格：必填\\n- 规格描述：可选\\n\\n**输出结果**：\\n- 规格ID：系统生成的唯一标识\\n- 创建状态：成功或失败\\n\\n**业务规则**：\\n- 一个菜品可有多个规格\\n- 规格名称不能重复\\n- 规格价格可不同\\n- 支持默认规格设置\\n\\n#### 2.6.2 规格编辑\\n\\n**功能描述**：编辑已有规格。\\n\\n**输入参数**：\\n- 规格ID：必填\\n- 其他参数：同规格创建\\n\\n**输出结果**：\\n- 更新状态：成功或失败\\n\\n**业务规则**：\\n- 编辑后自动更新价格\\n- 支持禁用规格\\n- 记录编辑历史\\n\\n#### 2.6.3 规格删除\\n\\n**功能描述**：删除已有规格。\\n\\n**输入参数**：\\n- 规格ID：必填\\n\\n**输出结果**：\\n- 删除状态：成功或失败\\n\\n**业务规则**：\\n- 删除前检查是否有关联订单\\n- 删除默认规格时需设置新默认\\n- 删除后不可恢复\\n\\n### 2.7 标签管理\\n\\n#### 2.7.1 标签创建\\n\\n**功能描述**：创建菜品标签。\\n\\n**输入参数**：\\n- 标签名称：必填\\n- 标签颜色：可选\\n- 标签类型：可选，如推荐、新品、热销\\n\\n**输出结果**：\\n- 标签ID：系统生成的唯一标识\\n- 创建状态：成功或失败\\n\\n**业务规则**：\\n- 标签名称不能重复\\n- 支持自定义颜色\\n- 一个菜品可有多个标签\\n\\n#### 2.7.2 标签分配\\n\\n**功能描述**：为菜品分配标签。\\n\\n**输入参数**：\\n- 菜品ID：必填\\n- 标签ID列表：必填\\n\\n**输出结果**：\\n- 分配状态：成功或失败\\n\\n**业务规则**：\\n- 支持批量分配\\n- 自动更新显示\\n- 记录分配历史\\n\\n#### 2.7.3 标签删除\\n\\n**功能描述**：删除已有标签。\\n\\n**输入参数**：\\n- 标签ID：必填\\n\\n**输出结果**：\\n- 删除状态：成功或失败\\n\\n**业务规则**：\\n- 删除前检查使用情况\\n- 删除后自动移除关联\\n- 删除后不可恢复\\n\\n### 2.8 营养管理\\n\\n#### 2.8.1 营养信息录入\\n\\n**功能描述**：录入菜品营养信息。\\n\\n**输入参数**：\\n- 菜品ID：必填\\n- 热量：可选，单位为千卡\\n- 蛋白质：可选，单位为克\\n- 脂肪：可选，单位为克\\n- 碳水化合物：可选，单位为克\\n- 钠：可选，单位为毫克\\n- 其他营养素：可选\\n\\n**输出结果**：\\n- 录入状态：成功或失败\\n\\n**业务规则**：\\n- 支持部分营养信息\\n- 自动计算总热量\\n- 支持自定义营养素\\n\\n#### 2.8.2 营养标签生成\\n\\n**功能描述**：根据营养信息生成营养标签。\\n\\n**输入参数**：\\n- 菜品ID：必填\\n- 标签格式：可选，如标准、简化\\n\\n**输出结果**：\\n- 营养标签：生成的标签图片或文本\\n\\n**业务规则**：\\n- 符合食品安全标准\\n- 自动计算每日摄入百分比\\n- 支持多语言标签\\n\\n### 2.9 搜索和筛选\\n\\n#### 2.9.1 菜品搜索\\n\\n**功能描述**：搜索菜品。\\n\\n**输入参数**：\\n- 搜索关键词：必填\\n- 搜索范围：可选，如名称、描述、材料\\n- 搜索方式：可选，如模糊、精确\\n\\n**输出结果**：\\n- 搜索结果：匹配的菜品列表\\n- 结果数量：匹配的菜品数量\\n\\n**业务规则**：\\n- 支持拼音搜索\\n- 支持同义词搜索\\n- 高亮显示匹配内容\\n- 记录搜索历史\\n\\n#### 2.9.2 菜品筛选\\n\\n**功能描述**：按条件筛选菜品。\\n\\n**输入参数**：\\n- 分类：可选\\n- 价格区间：可选\\n- 状态：可选\\n- 标签：可选\\n- 创建时间：可选\\n\\n**输出结果**：\\n- 筛选结果：符合条件的菜品列表\\n- 结果数量：符合条件的菜品数量\\n\\n**业务规则**：\\n- 支持多条件组合\\n- 实时更新结果\\n- 保存筛选条件\\n\\n#### 2.9.3 高级筛选\\n\\n**功能描述**：使用高级条件筛选菜品。\\n\\n**输入参数**：\\n- 销量区间：可选\\n- 利润区间：可选\\n- 评分区间：可选\\n- 材料列表：可选\\n- 自定义条件：可选\\n\\n**输出结果**：\\n- 筛选结果：符合条件的菜品列表\\n\\n**业务规则**：\\n- 支持自定义筛选条件\\n- 支持保存筛选方案\\n- 支持导出筛选结果\\n\\n### 2.10 批量操作\\n\\n#### 2.10.1 批量编辑\\n\\n**功能描述**：批量编辑菜品。\\n\\n**输入参数**：\\n- 菜品ID列表：必填\\n- 编辑字段：可选，如价格、分类、状态\\n- 编辑值：必填\\n\\n**输出结果**：\\n- 编辑结果：成功或失败\\n- 影响菜品数：编辑的菜品数量\\n\\n**业务规则**：\\n- 支持多字段同时编辑\\n- 记录批量操作历史\\n- 支持预览编辑结果\\n\\n#### 2.10.2 批量上下架\\n\\n**功能描述**：批量上下架菜品。\\n\\n**输入参数**：\\n- 菜品ID列表：必填\\n- 操作：上架或下架\\n\\n**输出结果**：\\n- 操作结果：成功或失败\\n- 影响菜品数：操作的菜品数量\\n\\n**业务规则**：\\n- 支持全选上下架\\n- 操作前确认\\n- 记录操作历史\\n\\n#### 2.10.3 批量删除\\n\\n**功能描述**：批量删除菜品。\\n\\n**输入参数**：\\n- 菜品ID列表：必填\\n\\n**输出结果**：\\n- 删除结果：成功或失败\\n- 影响菜品数：删除的菜品数量\\n\\n**业务规则**：\\n- 删除前检查关联订单\\n- 需要二次确认\\n- 删除后不可恢复\\n\\n#### 2.10.4 批量导入\\n\\n**功能描述**：批量导入菜品。\\n\\n**输入参数**：\\n- 导入文件：必填，支持Excel、CSV\\n- 导入模板：可选\\n\\n**输出结果**：\\n- 导入结果：成功或失败\\n- 成功数量：成功导入的菜品数\\n- 失败数量：导入失败的菜品数\\n- 失败原因：导入失败的原因\\n\\n**业务规则**：\\n- 提供导入模板\\n- 验证数据格式\\n- 支持预览导入数据\\n- 记录导入历史\\n\\n#### 2.10.5 批量导出\\n\\n**功能描述**：批量导出菜品。\\n\\n**输入参数**：\\n- 导出格式：可选，如Excel、CSV、PDF\\n- 导出字段：可选，选择要导出的字段\\n- 导出范围：可选，全部或筛选结果\\n\\n**输出结果**：\\n- 导出文件：生成的导出文件\\n\\n**业务规则**：\\n- 支持自定义导出字段\\n- 支持多格式导出\\n- 记录导出历史\\n\\n## 3. 非功能需求\\n\\n### 3.1 性能需求\\n\\n- **响应时间**：菜品列表加载时间不超过1秒，搜索响应时间不超过500ms\\n- **并发处理**：支持至少50个并发用户同时操作\\n- **数据处理**：支持处理10万级菜品数据\\n- **图片加载**：菜品图片加载时间不超过2秒\\n\\n### 3.2 可用性需求\\n\\n- **易用性**：界面简洁直观，操作流程清晰\\n- **可访问性**：支持键盘导航和屏幕阅读器\\n- **多语言**：支持中英文切换\\n- **响应式设计**：支持PC、平板、手机访问\\n\\n### 3.3 安全需求\\n\\n- **数据加密**：敏感数据加密存储\\n- **访问控制**：基于角色的访问控制\\n- **操作审计**：记录所有操作日志\\n- **数据备份**：定期备份数据\\n\\n### 3.4 兼容性需求\\n\\n- **浏览器兼容**：支持Chrome、Firefox、Safari、Edge最新版本\\n- **设备兼容**：支持Windows、macOS、iOS、Android\\n- **分辨率**：支持1920x1080及以上分辨率\\n\\n## 4. 接口设计\\n\\n### 4.1 菜品管理接口\\n\\n```typescript\\n// 获取菜品列表\\nGET /api/v1/menu/items\\nQuery Parameters:\\n  - page: number\\n  - limit: number\\n  - category: string\\n  - available: boolean\\n  - search: string\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"items\\\": [\\n      {\\n        \\\"id\\\": \\\"1\\\",\\n        \\\"name\\\": \\\"宫保鸡丁\\\",\\n        \\\"category\\\": \\\"主食\\\",\\n        \\\"price\\\": 48.00,\\n        \\\"cost\\\": 24.00,\\n        \\\"description\\\": \\\"经典川菜\\\",\\n        \\\"images\\\": [\\\"url1\\\", \\\"url2\\\"],\\n        \\\"tags\\\": [\\\"推荐\\\", \\\"热销\\\"],\\n        \\\"available\\\": true,\\n        \\\"preparationTime\\\": 15,\\n        \\\"createdAt\\\": \\\"2025-01-20T10:00:00Z\\\"\\n      }\\n    ],\\n    \\\"pagination\\\": {\\n      \\\"page\\\": 1,\\n      \\\"limit\\\": 20,\\n      \\\"total\\\": 100,\\n      \\\"totalPages\\\": 5\\n    }\\n  }\\n}\\n\\n// 创建菜品\\nPOST /api/v1/menu/items\\nBody:\\n{\\n  \\\"name\\\": \\\"宫保鸡丁\\\",\\n  \\\"category\\\": \\\"主食\\\",\\n  \\\"price\\\": 48.00,\\n  \\\"cost\\\": 24.00,\\n  \\\"description\\\": \\\"经典川菜\\\",\\n  \\\"images\\\": [\\\"url1\\\", \\\"url2\\\"],\\n  \\\"tags\\\": [\\\"推荐\\\", \\\"热销\\\"],\\n  \\\"preparationTime\\\": 15\\n}\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"id\\\": \\\"1\\\",\\n    \\\"name\\\": \\\"宫保鸡丁\\\",\\n    \\\"createdAt\\\": \\\"2025-01-20T10:00:00Z\\\"\\n  }\\n}\\n\\n// 更新菜品\\nPUT /api/v1/menu/items/:id\\nBody: 同创建菜品\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"id\\\": \\\"1\\\",\\n    \\\"updatedAt\\\": \\\"2025-01-20T11:00:00Z\\\"\\n  }\\n}\\n\\n// 删除菜品\\nDELETE /api/v1/menu/items/:id\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"message\\\": \\\"菜品删除成功\\\"\\n}\\n\\n// 上下架菜品\\nPATCH /api/v1/menu/items/:id/availability\\nBody:\\n{\\n  \\\"available\\\": true\\n}\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"message\\\": \\\"菜品上架成功\\\"\\n}\\n```\\n\\n### 4.2 分类管理接口\\n\\n```typescript\\n// 获取分类列表\\nGET /api/v1/menu/categories\\nQuery Parameters:\\n  - parentId: string\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"items\\\": [\\n      {\\n        \\\"id\\\": \\\"1\\\",\\n        \\\"name\\\": \\\"主食\\\",\\n        \\\"parentId\\\": null,\\n        \\\"icon\\\": \\\"icon_url\\\",\\n        \\\"sortOrder\\\": 1,\\n        \\\"description\\\": \\\"主食类菜品\\\",\\n        \\\"children\\\": []\\n      }\\n    ]\\n  }\\n}\\n\\n// 创建分类\\nPOST /api/v1/menu/categories\\nBody:\\n{\\n  \\\"name\\\": \\\"主食\\\",\\n  \\\"parentId\\\": null,\\n  \\\"icon\\\": \\\"icon_url\\\",\\n  \\\"sortOrder\\\": 1,\\n  \\\"description\\\": \\\"主食类菜品\\\"\\n}\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"id\\\": \\\"1\\\",\\n    \\\"createdAt\\\": \\\"2025-01-20T10:00:00Z\\\"\\n  }\\n}\\n\\n// 更新分类\\nPUT /api/v1/menu/categories/:id\\nBody: 同创建分类\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"message\\\": \\\"分类更新成功\\\"\\n}\\n\\n// 删除分类\\nDELETE /api/v1/menu/categories/:id\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"message\\\": \\\"分类删除成功\\\"\\n}\\n```\\n\\n### 4.3 价格管理接口\\n\\n```typescript\\n// 获取价格历史\\nGET /api/v1/menu/items/:id/price-history\\nQuery Parameters:\\n  - startDate: string\\n  - endDate: string\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"history\\\": [\\n      {\\n        \\\"price\\\": 48.00,\\n        \\\"oldPrice\\\": 45.00,\\n        \\\"reason\\\": \\\"成本上涨\\\",\\n        \\\"operator\\\": \\\"张三\\\",\\n        \\\"createdAt\\\": \\\"2025-01-20T10:00:00Z\\\"\\n      }\\n    ]\\n  }\\n}\\n\\n// 批量调整价格\\nPOST /api/v1/menu/items/batch/price\\nBody:\\n{\\n  \\\"itemIds\\\": [\\\"1\\\", \\\"2\\\", \\\"3\\\"],\\n  \\\"adjustmentType\\\": \\\"percentage\\\",\\n  \\\"value\\\": 10,\\n  \\\"reason\\\": \\\"成本调整\\\"\\n}\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"affectedCount\\\": 3,\\n    \\\"results\\\": [\\n      {\\n        \\\"itemId\\\": \\\"1\\\",\\n        \\\"oldPrice\\\": 48.00,\\n        \\\"newPrice\\\": 52.80\\n      }\\n    ]\\n  }\\n}\\n```\\n\\n### 4.4 库存关联接口\\n\\n```typescript\\n// 获取菜品材料关联\\nGET /api/v1/menu/items/:id/materials\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"materials\\\": [\\n      {\\n        \\\"materialId\\\": \\\"1\\\",\\n        \\\"name\\\": \\\"鸡肉\\\",\\n        \\\"quantity\\\": 200,\\n        \\\"unit\\\": \\\"克\\\",\\n        \\\"wasteRate\\\": 0.05,\\n        \\\"cost\\\": 12.00\\n      }\\n    ]\\n  }\\n}\\n\\n// 关联材料\\nPOST /api/v1/menu/items/:id/materials\\nBody:\\n{\\n  \\\"materialId\\\": \\\"1\\\",\\n  \\\"quantity\\\": 200,\\n  \\\"wasteRate\\\": 0.05\\n}\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"message\\\": \\\"材料关联成功\\\"\\n}\\n\\n// 解绑材料\\nDELETE /api/v1/menu/items/:id/materials/:materialId\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"message\\\": \\\"材料解绑成功\\\"\\n}\\n```\\n\\n### 4.5 批量操作接口\\n\\n```typescript\\n// 批量编辑\\nPOST /api/v1/menu/items/batch/edit\\nBody:\\n{\\n  \\\"itemIds\\\": [\\\"1\\\", \\\"2\\\", \\\"3\\\"],\\n  \\\"fields\\\": {\\n    \\\"category\\\": \\\"主食\\\",\\n    \\\"available\\\": true\\n  }\\n}\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"affectedCount\\\": 3\\n  }\\n}\\n\\n// 批量导入\\nPOST /api/v1/menu/items/batch/import\\nBody:\\n{\\n  \\\"file\\\": \\\"file_data\\\",\\n  \\\"template\\\": \\\"standard\\\"\\n}\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"successCount\\\": 95,\\n    \\\"failedCount\\\": 5,\\n    \\\"failedItems\\\": [\\n      {\\n        \\\"row\\\": 10,\\n        \\\"reason\\\": \\\"价格格式错误\\\"\\n      }\\n    ]\\n  }\\n}\\n\\n// 批量导出\\nPOST /api/v1/menu/items/batch/export\\nBody:\\n{\\n  \\\"format\\\": \\\"excel\\\",\\n  \\\"fields\\\": [\\\"name\\\", \\\"category\\\", \\\"price\\\", \\\"cost\\\"],\\n  \\\"filters\\\": {\\n    \\\"category\\\": \\\"主食\\\",\\n    \\\"available\\\": true\\n  }\\n}\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"downloadUrl\\\": \\\"download_url\\\",\\n    \\\"expiresAt\\\": \\\"2025-01-21T10:00:00Z\\\"\\n  }\\n}\\n```\\n\\n## 5. 数据模型\\n\\n### 5.1 菜品模型\\n\\n```typescript\\ninterface MenuItem {\\n  id: string;\\n  name: string;\\n  nameEn?: string;\\n  category: string;\\n  categoryId: string;\\n  price: number;\\n  cost: number;\\n  profit: number;\\n  profitRate: number;\\n  description?: string;\\n  descriptionEn?: string;\\n  images: string[];\\n  mainImage: string;\\n  tags: string[];\\n  available: boolean;\\n  preparationTime?: number;\\n  specifications: MenuItemSpecification[];\\n  materials: MenuItemMaterial[];\\n  nutrition?: NutritionInfo;\\n  attributes: MenuItemAttribute[];\\n  createdAt: string;\\n  updatedAt: string;\\n  createdBy: string;\\n  updatedBy: string;\\n}\\n\\ninterface MenuItemSpecification {\\n  id: string;\\n  name: string;\\n  price: number;\\n  description?: string;\\n  isDefault: boolean;\\n  sortOrder: number;\\n}\\n\\ninterface MenuItemMaterial {\\n  materialId: string;\\n  materialName: string;\\n  quantity: number;\\n  unit: string;\\n  wasteRate: number;\\n  cost: number;\\n}\\n\\ninterface NutritionInfo {\\n  calories: number;\\n  protein: number;\\n  fat: number;\\n  carbohydrates: number;\\n  sodium: number;\\n  fiber?: number;\\n  sugar?: number;\\n  customNutrients?: CustomNutrient[];\\n}\\n\\ninterface CustomNutrient {\\n  name: string;\\n  value: number;\\n  unit: string;\\n}\\n\\ninterface MenuItemAttribute {\\n  name: string;\\n  value: string;\\n  type: 'spiciness' | 'temperature' | 'dietary' | 'custom';\\n}\\n```\\n\\n### 5.2 分类模型\\n\\n```typescript\\ninterface MenuCategory {\\n  id: string;\\n  name: string;\\n  nameEn?: string;\\n  parentId: string | null;\\n  icon?: string;\\n  sortOrder: number;\\n  description?: string;\\n  descriptionEn?: string;\\n  children?: MenuCategory[];\\n  itemCount: number;\\n  createdAt: string;\\n  updatedAt: string;\\n}\\n```\\n\\n### 5.3 标签模型\\n\\n```typescript\\ninterface MenuTag {\\n  id: string;\\n  name: string;\\n  nameEn?: string;\\n  color: string;\\n  type: TagType;\\n  sortOrder: number;\\n  createdAt: string;\\n}\\n\\nenum TagType {\\n  RECOMMENDED = 'recommended',\\n  NEW = 'new',\\n  HOT_SELLING = 'hot_selling',\\n  LIMITED = 'limited',\\n  CUSTOM = 'custom'\\n}\\n```\\n\\n### 5.4 价格历史模型\\n\\n```typescript\\ninterface PriceHistory {\\n  id: string;\\n  itemId: string;\\n  itemName: string;\\n  oldPrice: number;\\n  newPrice: number;\\n  priceType: PriceType;\\n  reason?: string;\\n  operator: string;\\n  operatorName: string;\\n  createdAt: string;\\n}\\n\\nenum PriceType {\\n  STANDARD = 'standard',\\n  MEMBER = 'member',\\n  PROMOTION = 'promotion'\\n}\\n```\\n\\n## 6. 用户界面设计\\n\\n### 6.1 主界面布局\\n\\n```\\n┌─────────────────────────────────────────────────────────────┐\\n│  菜单管理                                              │\\n├─────────────────────────────────────────────────────────────┤\\n│  [添加菜品]                                           │\\n├─────────────────────────────────────────────────────────────┤\\n│  [菜品分类▼] [状态▼] [搜索菜品...] [查询] [重置]      │\\n├─────────────────────────────────────────────────────────────┤\\n│  ┌─────────────────────────────────────────────────────┐   │\\n│  │ ID  菜品名称    分类  价格   状态  操作        │   │\\n│  │  1   宫保鸡丁    主食  ¥48.00 [开] [编辑][删除]│   │\\n│  │  2   麻婆豆腐    主食  ¥38.00 [开] [编辑][删除]│   │\\n│  │  3   糖醋里脊    主食  ¥42.00 [关] [编辑][删除]│   │\\n│  └─────────────────────────────────────────────────────┘   │\\n│  共 100 条记录  [上一页] 1 / 5 [下一页]              │\\n└─────────────────────────────────────────────────────────────┘\\n```\\n\\n### 6.2 菜品编辑界面\\n\\n```\\n┌─────────────────────────────────────────────────────────────┐\\n│  编辑菜品                                              │\\n├─────────────────────────────────────────────────────────────┤\\n│  基本信息                                              │\\n│  ┌─────────────────────────────────────────────────────┐   │\\n│  │ 菜品名称: [宫保鸡丁_________________]          │   │\\n│  │ 英文名称: [Kung Pao Chicken___________]          │   │\\n│  │ 菜品分类: [主食▼]                              │   │\\n│  │ 菜品价格: [¥48.00_____]                        │   │\\n│  │ 菜品成本: [¥24.00_____]                        │   │\\n│  │ 制作时间: [15_____] 分钟                         │   │\\n│  └─────────────────────────────────────────────────────┘   │\\n├─────────────────────────────────────────────────────────────┤\\n│  菜品描述                                              │\\n│  ┌─────────────────────────────────────────────────────┐   │\\n│  │ 经典川菜，选用优质鸡肉，配以花生、干辣椒等...     │   │\\n│  └─────────────────────────────────────────────────────┘   │\\n├─────────────────────────────────────────────────────────────┤\\n│  菜品图片                                              │\\n│  ┌─────────────────────────────────────────────────────┐   │\\n│  │ [主图] [副图1] [副图2] [+上传图片]           │   │\\n│  └─────────────────────────────────────────────────────┘   │\\n├─────────────────────────────────────────────────────────────┤\\n│  菜品标签                                              │\\n│  ┌─────────────────────────────────────────────────────┐   │\\n│  │ [推荐] [热销] [新品] [+添加标签]               │   │\\n│  └─────────────────────────────────────────────────────┘   │\\n├─────────────────────────────────────────────────────────────┤\\n│  [取消] [保存]                                       │\\n└─────────────────────────────────────────────────────────────┘\\n```\\n\\n### 6.3 分类管理界面\\n\\n```\\n┌─────────────────────────────────────────────────────────────┐\\n│  分类管理                                              │\\n├─────────────────────────────────────────────────────────────┤\\n│  [+添加分类]                                           │\\n├─────────────────────────────────────────────────────────────┤\\n│  ┌─────────────────────────────────────────────────────┐   │\\n│  │ ▼ 主食 (50)                                    │   │\\n│  │   ▼ 汤品 (30)                                 │   │\\n│  │   ▼ 小菜 (40)                                  │   │\\n│  │ ▼ 饮料 (20)                                    │   │\\n│  │ ▼ 甜点 (15)                                    │   │\\n│  └─────────────────────────────────────────────────────┘   │\\n│  ┌─────────────────────────────────────────────────────┐   │\\n│  │ [编辑] [删除] [上移] [下移] [置顶] [置底]     │   │\\n│  └─────────────────────────────────────────────────────┘   │\\n└─────────────────────────────────────────────────────────────┘\\n```\\n\\n## 7. 测试需求\\n\\n### 7.1 单元测试\\n\\n- 菜品CRUD操作测试\\n- 价格计算测试\\n- 成本计算测试\\n- 库存关联测试\\n- 批量操作测试\\n\\n### 7.2 集成测试\\n\\n- 菜品与库存集成测试\\n- 菜品与订单集成测试\\n- 图片上传集成测试\\n- 批量导入导出测试\\n\\n### 7.3 性能测试\\n\\n- 大数据量加载测试\\n- 搜索性能测试\\n- 图片加载测试\\n- 并发操作测试\\n\\n### 7.4 用户验收测试\\n\\n- 功能完整性测试\\n- 易用性测试\\n- 兼容性测试\\n- 安全性测试\\n\\n## 8. 部署和维护\\n\\n### 8.1 部署要求\\n\\n- 服务器配置：4核CPU、8GB内存、200GB SSD\\n- 图片存储：支持对象存储（如OSS、S3）\\n- 数据库：PostgreSQL 13+\\n\\n### 8.2 监控要求\\n\\n- 系统监控：CPU、内存、磁盘、网络\\n- 应用监控：响应时间、错误率、吞吐量\\n- 业务监控：菜品数据准确性、价格更新及时性\\n\\n### 8.3 备份策略\\n\\n- 数据库备份：每日全量备份，每小时增量备份\\n- 图片备份：每周全量备份\\n- 配置备份：每次配置变更后备份\\n\\n### 8.4 维护计划\\n\\n- 定期更新：每月更新菜品数据\\n- 性能优化：每季度进行性能优化\\n- 安全检查：每周进行安全检查\\n- 功能迭代：根据用户反馈持续优化\\n\\n## 9. 版本历史\\n\\n| 版本 | 日期 | 作者 | 变更说明 |\\n|------|------|------|---------|\\n| 1.0.0 | 2025-01-20 | YYC³ | 初始版本 |\\n\",\"originTextLength\":17828,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768895186754}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/docs/YYC3-Cater-Platform-%E6%96%87%E6%A1%A3%E9%97%AD%E7%8E%AF/YYC3-Cater-%E9%9C%80%E6%B1%82%E8%AE%BE%E8%AE%A1%E6%96%87%E6%A1%A3/%E5%AE%A2%E6%88%B7%E7%AE%A1%E7%90%86%E5%8A%9F%E8%83%BD%E6%A8%A1%E5%9D%97%E9%9C%80%E6%B1%82%E5%88%86%E6%9E%90%E4%B8%8E%E8%AE%BE%E8%AE%A1%E6%96%87%E6%A1%A3.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":982,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":982,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# 客户管理功能模块需求分析与设计文档\\\\n\\\\n## 1. 模块概述\\\\n\\\\n### 1.1 模块简介\\\\n\\\\n客户管理功能模块是YYC³餐饮平台的核心业务模块，负责管理餐厅的客户信息，包括客户档案、会员管理、客户分级、客户画像、客户互动等功能。该模块帮助餐厅建立完善的客户关系管理体系，提升客户满意度和忠诚度。\\\\n\\\\n### 1.2 模块目标\\\\n\\\\n- **客户档案管理**：集中管理客户基本信息，提供完整的客户视图\\\\n- **会员管理**：建立会员体系，提供差异化的会员权益\\\\n- **客户分级**：基于RFM模型进行客户分层，识别高价值客户\\\\n- **客户画像**：分析客户行为，构建客户画像，支撑精准营销\\\\n- **客户互动**：管理客户沟通渠道，提升客户体验\\\\n- **流失预警**：识别流失风险客户，提供挽留策略\\\\n\\\\n### 1.3 适用范围\\\\n\\\\n- 餐厅管理者：管理客户关系，制定客户策略\\\\n- 市场营销人员：进行精准营销，分析营销效果\\\\n- 客服人员：查看客户信息，处理客户问题\\\\n- 财务人员：管理客户账户，处理退款\\\\n- 运营人员：分析客户数据，优化运营策略\\\\n\\\\n## 2. 功能需求\\\\n\\\\n### 2.1 客户档案管理\\\\n\\\\n#### 2.1.1 客户信息录入\\\\n\\\\n**功能描述**：录入新客户信息。\\\\n\\\\n**输入参数**：\\\\n- 基本信息：姓名、手机号、邮箱、性别、生日\\\\n- 地址信息：收货地址、默认地址\\\\n- 客户标签：来源渠道、偏好标签\\\\n- 备注信息：客户备注\\\\n\\\\n**输出结果**：\\\\n- 客户ID：系统生成的唯一标识\\\\n- 客户编号：可自定义的客户编号\\\\n- 创建时间：客户创建时间\\\\n\\\\n**业务规则**：\\\\n- 手机号唯一性校验\\\\n- 邮箱格式校验\\\\n- 支持批量导入客户\\\\n- 支持从订单创建客户\\\\n\\\\n#### 2.1.2 客户信息编辑\\\\n\\\\n**功能描述**：编辑已有客户信息。\\\\n\\\\n**输入参数**：\\\\n- 客户ID：必填\\\\n- 其他信息：同客户信息录入\\\\n\\\\n**输出结果**：\\\\n- 更新时间：客户信息更新时间\\\\n- 修改记录：记录修改历史\\\\n\\\\n**业务规则**：\\\\n- 敏感信息修改需要验证\\\\n- 修改记录完整保留\\\\n- 支持批量编辑客户信息\\\\n\\\\n#### 2.1.3 客户信息查询\\\\n\\\\n**功能描述**：查询客户信息。\\\\n\\\\n**输入参数**：\\\\n- 搜索关键词：姓名、手机号、邮箱、客户编号\\\\n- 筛选条件：客户等级、客户标签、注册时间\\\\n\\\\n**输出结果**：\\\\n- 客户列表：符合条件的客户列表\\\\n- 结果数量：符合条件的客户数量\\\\n\\\\n**业务规则**：\\\\n- 支持模糊搜索\\\\n- 支持多条件组合查询\\\\n- 搜索结果实时更新\\\\n\\\\n#### 2.1.4 客户详情查看\\\\n\\\\n**功能描述**：查看客户详细信息。\\\\n\\\\n**输入参数**：\\\\n- 客户ID：必填\\\\n\\\\n**输出结果**：\\\\n- 基本信息：客户基本资料\\\\n- 消费记录：历史订单记录\\\\n- 互动记录：沟通记录\\\\n- 标签信息：客户标签\\\\n- 备注信息：客户备注\\\\n\\\\n**业务规则**：\\\\n- 支持Tab页签切换\\\\n- 展示完整的客户视图\\\\n- 支持导出客户详情\\\\n\\\\n### 2.2 会员管理\\\\n\\\\n#### 2.2.1 会员等级设置\\\\n\\\\n**功能描述**：设置会员等级体系。\\\\n\\\\n**输入参数**：\\\\n- 等级名称：必填\\\\n- 等级图标：可选\\\\n- 升级条件：消费金额、订单数量、积分\\\\n- 等级权益：折扣、赠品、专属服务\\\\n- 降级规则：保级条件、降级处理\\\\n\\\\n**输出结果**：\\\\n- 等级ID：系统生成的唯一标识\\\\n- 等级配置：等级设置详情\\\\n\\\\n**业务规则**：\\\\n- 支持多级会员体系\\\\n- 等级权益可配置\\\\n- 升降级自动处理\\\\n\\\\n#### 2.2.2 会员开通\\\\n\\\\n**功能描述**：开通会员资格。\\\\n\\\\n**输入参数**：\\\\n- 客户ID：必填\\\\n- 会员等级：必填\\\\n- 有效期：必填\\\\n- 开通方式：购买、赠送、系统调整\\\\n\\\\n**输出结果**：\\\\n- 会员ID：会员记录ID\\\\n- 开通时间：会员开通时间\\\\n- 到期时间：会员到期时间\\\\n\\\\n**业务规则**：\\\\n- 检查客户是否已是会员\\\\n- 支持批量开通\\\\n- 记录开通来源\\\\n\\\\n#### 2.2.3 会员升降级\\\\n\\\\n**功能描述**：自动或手动调整会员等级。\\\\n\\\\n**输入参数**：\\\\n- 客户ID：必填\\\\n- 升降级类型：自动、手动\\\\n- 目标等级：手动调整时必填\\\\n\\\\n**输出结果**：\\\\n- 升降级结果：成功或失败\\\\n- 等级变更记录：变更详情\\\\n\\\\n**业务规则**：\\\\n- 自动升降级按配置规则执行\\\\n- 手动升降级需要权限\\\\n- 升降级通知客户\\\\n\\\\n#### 2.2.4 会员权益管理\\\\n\\\\n**功能描述**：管理会员权益。\\\\n\\\\n**输入参数**：\\\\n- 等级ID：必填\\\\n- 权益类型：折扣、赠品、积分、专属服务\\\\n- 权益内容：权益详情\\\\n\\\\n**输出结果**：\\\\n- 权益配置：权益设置详情\\\\n\\\\n**业务规则**：\\\\n- 权益可叠加或互斥\\\\n- 权益使用记录可追溯\\\\n- 支持权益有效期设置\\\\n\\\\n#### 2.2.5 会员积分管理\\\\n\\\\n**功能描述**：管理客户积分。\\\\n\\\\n**输入参数**：\\\\n- 客户ID：必填\\\\n- 积分变动：增加或减少\\\\n- 变动数量：必填\\\\n- 变动原因：必填\\\\n\\\\n**输出结果**：\\\\n- 积分余额：当前积分\\\\n- 积分变动记录：变动历史\\\\n\\\\n**业务规则**：\\\\n- 积分有效期可配置\\\\n- 积分变动记录完整\\\\n- 支持积分抵扣订单\\\\n\\\\n### 2.3 客户分级\\\\n\\\\n#### 2.3.1 RFM模型分析\\\\n\\\\n**功能描述**：基于RFM模型进行客户分级。\\\\n\\\\n**输入参数**：\\\\n- 分析时间范围：必填\\\\n- 分级数量：3-10级\\\\n- 权重设置：R、F、M权重\\\\n\\\\n**输出结果**：\\\\n- 客户分级：各等级客户列表\\\\n- 分级特征：各等级客户特征\\\\n- 分级统计：各等级统计数据\\\\n\\\\n**业务规则**：\\\\n- R（最近消费时间）\\\\n- F（消费频率）\\\\n- M（消费金额）\\\\n- 支持自定义权重\\\\n\\\\n#### 2.3.2 客户分群\\\\n\\\\n**功能描述**：创建客户分群。\\\\n\\\\n**输入参数**：\\\\n- 分群名称：必填\\\\n- 分群条件：必填，支持多条件\\\\n- 分群范围：全部客户或筛选客户\\\\n\\\\n**输出结果**：\\\\n- 分群ID：系统生成的唯一标识\\\\n- 分群人数：符合条件的客户数\\\\n- 分群规则：分群条件详情\\\\n\\\\n**业务规则**：\\\\n- 支持复杂条件组合\\\\n- 支持保存分群规则\\\\n- 支持分群更新\\\\n\\\\n#### 2.3.3 分群营销\\\\n\\\\n**功能描述**：针对分群进行营销。\\\\n\\\\n**输入参数**：\\\\n- 分群ID：必填\\\\n- 营销活动：必填\\\\n- 营销内容：必填\\\\n\\\\n**输出结果**：\\\\n- 营销ID：营销活动ID\\\\n- 目标人数：目标客户数\\\\n- 发送记录：发送结果\\\\n\\\\n**业务规则**：\\\\n- 支持多种营销方式\\\\n- 营销效果可追踪\\\\n- 支持A/B测试\\\\n\\\\n#### 2.3.4 分群分析\\\\n\\\\n**功能描述**：分析客户分群特征。\\\\n\\\\n**输入参数**：\\\\n- 分群ID：必填\\\\n- 分析维度：消费、行为、属性\\\\n\\\\n**输出结果**：\\\\n- 分群画像：客户画像详情\\\\n- 分群趋势：分群变化趋势\\\\n- 分群对比：与其他分群对比\\\\n\\\\n**业务规则**：\\\\n- 自动生成分析报告\\\\n- 支持多维度分析\\\\n- 支持对比分析\\\\n\\\\n### 2.4 客户画像\\\\n\\\\n#### 2.4.1 基础画像\\\\n\\\\n**功能描述**：生成客户基础画像。\\\\n\\\\n**输入参数**：\\\\n- 客户ID：必填\\\\n- 画像维度：人口统计、消费能力\\\\n\\\\n**输出结果**：\\\\n- 年龄段：客户年龄段\\\\n- 性别：客户性别\\\\n- 地区：客户所在地区\\\\n- 职业：客户职业类型\\\\n- 收入：预估收入水平\\\\n\\\\n**业务规则**：\\\\n- 基于注册信息推断\\\\n- 基于消费行为推断\\\\n- 支持手动标注\\\\n\\\\n#### 2.4.2 消费画像\\\\n\\\\n**功能描述**：生成客户消费画像。\\\\n\\\\n**输入参数**：\\\\n- 客户ID：必填\\\\n- 时间范围：可选\\\\n\\\\n**输出结果**：\\\\n- 消费频次：平均消费频率\\\\n- 消费金额：总消费、客单价\\\\n- 消费偏好：品类偏好、口味偏好\\\\n- 消费时段：消费高峰时段\\\\n- 支付方式：常用支付方式\\\\n\\\\n**业务规则**：\\\\n- 基于历史订单分析\\\\n- 自动更新消费画像\\\\n- 支持同期对比\\\\n\\\\n#### 2.4.3 行为画像\\\\n\\\\n**功能描述**：生成客户行为画像。\\\\n\\\\n**输入参数**：\\\\n- 客户ID：必填\\\\n- 行为类型：浏览、下单、评价\\\\n\\\\n**输出结果**：\\\\n- 访问频率：访问次数、时长\\\\n- 浏览偏好：浏览品类、菜品\\\\n- 互动行为：评价、分享、收藏\\\\n- 渠道偏好：线上、线下偏好\\\\n- 设备偏好：PC、移动端\\\\n\\\\n**业务规则**：\\\\n- 基于埋点数据分析\\\\n- 行为数据脱敏处理\\\\n- 实时更新行为画像\\\\n\\\\n#### 2.4.4 标签系统\\\\n\\\\n**功能描述**：为客户打标签。\\\\n\\\\n**输入参数**：\\\\n- 客户ID：必填\\\\n- 标签类型：自动、手动\\\\n- 标签内容：标签名称\\\\n\\\\n**输出结果**：\\\\n- 标签列表：客户标签列表\\\\n- 标签权重：标签重要性\\\\n\\\\n**业务规则**：\\\\n- 支持自动标签\\\\n- 支持手动标签\\\\n- 标签可继承\\\\n- 支持标签组合\\\\n\\\\n#### 2.4.5 画像更新\\\\n\\\\n**功能描述**：自动更新客户画像。\\\\n\\\\n**输入参数**：\\\\n- 更新类型：实时、定时\\\\n- 更新范围：全部、增量\\\\n\\\\n**输出结果**：\\\\n- 更新状态：更新成功或失败\\\\n- 更新记录：更新详情\\\\n\\\\n**业务规则**：\\\\n- 实时更新关键指标\\\\n- 定时更新完整画像\\\\n- 画像更新可追溯\\\\n\\\\n### 2.5 客户互动\\\\n\\\\n#### 2.5.1 短信通知\\\\n\\\\n**功能描述**：向客户发送短信。\\\\n\\\\n**输入参数**：\\\\n- 客户ID或分群：必填\\\\n- 短信模板：必填\\\\n- 发送时间：即时或定时\\\\n\\\\n**输出结果**：\\\\n- 发送记录：发送详情\\\\n- 发送状态：成功、失败、发送中\\\\n\\\\n**业务规则**：\\\\n- 支持模板短信\\\\n- 支持变量替换\\\\n- 发送记录完整\\\\n\\\\n#### 2.5.2 邮件通知\\\\n\\\\n**功能描述**：向客户发送邮件。\\\\n\\\\n**输入参数**：\\\\n- 客户ID或分群：必填\\\\n- 邮件模板：必填\\\\n- 发送时间：即时或定时\\\\n\\\\n**输出结果**：\\\\n- 发送记录：发送详情\\\\n- 打开率：邮件打开率\\\\n- 点击率：链接点击率\\\\n\\\\n**业务规则**：\\\\n- 支持富文本邮件\\\\n- 支持A/B测试\\\\n- 邮件打开可追踪\\\\n\\\\n#### 2.5.3 微信通知\\\\n\\\\n**功能描述**：向客户发送微信通知。\\\\n\\\\n**输入参数**：\\\\n- 客户ID：必填\\\\n- 微信模板：必填\\\\n- 发送内容：必填\\\\n\\\\n**发送结果**：\\\\n- 发送记录：发送详情\\\\n- 送达状态：送达状态\\\\n\\\\n**业务规则**：\\\\n- 需客户授权\\\\n- 支持模板消息\\\\n- 支持服务通知\\\\n\\\\n#### 2.5.4 沟通记录\\\\n\\\\n**功能描述**：记录客户沟通。\\\\n\\\\n**输入参数**：\\\\n- 客户ID：必填\\\\n- 沟通方式：电话、在线、面对面\\\\n- 沟通内容：必填\\\\n- 沟通结果：必填\\\\n\\\\n**输出结果**：\\\\n- 沟通记录ID：记录ID\\\\n- 沟通时间：沟通时间\\\\n\\\\n**业务规则**：\\\\n- 支持多渠道沟通记录\\\\n- 沟通记录关联订单\\\\n- 支持回访提醒\\\\n\\\\n#### 2.5.5 满意度调查\\\\n\\\\n**功能描述**：进行客户满意度调查。\\\\n\\\\n**输入参数**：\\\\n- 调查方式：问卷、评分\\\\n- 调查对象：全部或指定客户\\\\n- 调查内容：调查题目\\\\n\\\\n**输出结果**：\\\\n- 调查结果：满意度数据\\\\n- 分析报告：分析报告\\\\n\\\\n**业务规则**：\\\\n- 支持多种调查方式\\\\n- 调查结果可分析\\\\n- 支持持续跟踪\\\\n\\\\n### 2.6 流失预警\\\\n\\\\n#### 2.6.1 流失识别\\\\n\\\\n**功能描述**：识别流失风险客户。\\\\n\\\\n**输入参数**：\\\\n- 流失定义：必填（最后消费距今天数）\\\\n- 流失等级：高、中、低\\\\n\\\\n**输出结果**：\\\\n- 流失客户列表：流失风险客户\\\\n- 流失等级：风险等级\\\\n- 流失原因：可能原因\\\\n\\\\n**业务规则**：\\\\n- 基于历史数据分析\\\\n- 流失阈值可配置\\\\n- 流失等级自动评定\\\\n\\\\n#### 2.6.2 流失原因分析\\\\n\\\\n**功能描述**：分析客户流失原因。\\\\n\\\\n**输入参数**：\\\\n- 流失客户：必填\\\\n- 分析维度：价格、服务、质量\\\\n\\\\n**输出结果**：\\\\n- 流失原因：主要原因分析\\\\n- 流失趋势：流失趋势图\\\\n- 对策建议：挽回建议\\\\n\\\\n**业务规则**：\\\\n- 基于数据分析\\\\n- 支持客户反馈分析\\\\n- 提供改进建议\\\\n\\\\n#### 2.6.3 挽留策略\\\\n\\\\n**功能描述**：制定客户挽留策略。\\\\n\\\\n**输入参数**：\\\\n- 流失客户：必填\\\\n- 挽留方式：优惠券、专属服务\\\\n- 挽留内容：必填\\\\n\\\\n**输出结果**：\\\\n- 挽留记录：挽留操作记录\\\\n- 挽留效果：挽留成功率\\\\n\\\\n**业务规则**：\\\\n- 挽留方式可配置\\\\n- 挽留效果可追踪\\\\n- 支持批量挽留\\\\n\\\\n#### 2.6.4 流失挽回\\\\n\\\\n**功能描述**：执行客户流失挽回。\\\\n\\\\n**输入参数**：\\\\n- 流失客户：必填\\\\n- 挽回措施：必填\\\\n\\\\n**输出结果**：\\\\n- 挽回结果：成功或失败\\\\n- 客户状态：当前状态\\\\n\\\\n**业务规则**：\\\\n- 挽回措施可组合\\\\n- 挽回后跟踪消费\\\\n- 记录挽回过程\\\\n\\\\n### 2.7 客户分析\\\\n\\\\n#### 2.7.1 客户统计\\\\n\\\\n**功能描述**：统计客户数据。\\\\n\\\\n**输入参数**：\\\\n- 统计周期：日、周、月、季、年\\\\n- 统计维度：新增、活跃、流失\\\\n\\\\n**输出结果**：\\\\n- 新增客户数：新增客户数量\\\\n- 活跃客户数：活跃客户数量\\\\n- 流失客户数：流失客户数量\\\\n- 客户增长率：增长率\\\\n\\\\n**业务规则**：\\\\n- 支持多维度统计\\\\n- 支持同比环比\\\\n- 数据实时更新\\\\n\\\\n#### 2.7.2 客户生命周期\\\\n\\\\n**功能描述**：分析客户生命周期。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：必填\\\\n- 分析阶段：获取、激活、留存、流失\\\\n\\\\n**输出结果**：\\\\n- 生命周期分布：各阶段客户数\\\\n- 转化率：阶段间转化率\\\\n- 平均周期：平均生命周期\\\\n- 价值分析：生命周期价值\\\\n\\\\n**业务规则**：\\\\n- 生命周期自动计算\\\\n- 转化漏斗可视化\\\\n- 提供优化建议\\\\n\\\\n#### 2.7.3 客户价值分析\\\\n\\\\n**功能描述**：分析客户价值。\\\\n\\\\n**输入参数**：\\\\n- 价值指标：消费、影响力、口碑\\\\n- 分析方法：CLV、RFM\\\\n\\\\n**输出结果**：\\\\n- 客户价值排名：高价值客户排名\\\\n- 价值分布：价值分布情况\\\\n- 价值预测：未来价值预测\\\\n\\\\n**业务规则**：\\\\n- 支持多种价值模型\\\\n- 价值实时更新\\\\n- 价值可追溯\\\\n\\\\n#### 2.7.4 客户行为分析\\\\n\\\\n**功能描述**：分析客户行为。\\\\n\\\\n**输入参数**：\\\\n- 行为类型：浏览、下单、评价\\\\n- 分析维度：频次、时段、渠道\\\\n\\\\n**输出结果**：\\\\n- 行为分布：行为分布情况\\\\n- 行为路径：典型行为路径\\\\n- 行为关联：行为关联分析\\\\n\\\\n**业务规则**：\\\\n- 行为数据脱敏\\\\n- 路径可视化\\\\n- 支持A/B分析\\\\n\\\\n### 2.8 导出管理\\\\n\\\\n#### 2.8.1 客户导出\\\\n\\\\n**功能描述**：导出客户数据。\\\\n\\\\n**输入参数**：\\\\n- 导出格式：Excel、CSV、PDF\\\\n- 导出字段：选择导出字段\\\\n- 筛选条件：导出范围\\\\n\\\\n**输出结果**：\\\\n- 导出文件：生成的导出文件\\\\n- 导出记录：导出历史\\\\n\\\\n**业务规则**：\\\\n- 支持自定义字段\\\\n- 导出记录完整\\\\n- 敏感数据脱敏\\\\n\\\\n#### 2.8.2 客户导入\\\\n\\\\n**功能描述**：导入客户数据。\\\\n\\\\n**输入参数**：\\\\n- 导入文件：必填，支持Excel、CSV\\\\n- 导入映射：字段映射\\\\n\\\\n**输出结果**：\\\\n- 导入结果：成功或失败\\\\n- 成功数量：成功导入数\\\\n- 失败数量：失败数及原因\\\\n\\\\n**业务规则**：\\\\n- 支持模板下载\\\\n- 数据格式验证\\\\n- 失败数据可修正\\\\n\\\\n## 3. 非功能需求\\\\n\\\\n### 3.1 性能需求\\\\n\\\\n- **响应时间**：客户列表加载时间不超过2秒，搜索响应时间不超过1秒\\\\n- **并发处理**：支持至少100个并发用户同时访问\\\\n- **数据处理**：支持处理百万级客户数据\\\\n- **实时性**：客户数据延迟不超过5秒\\\\n\\\\n### 3.2 可用性需求\\\\n\\\\n- **易用性**：界面简洁直观，操作流程清晰\\\\n- **可访问性**：支持键盘导航和屏幕阅读器\\\\n- **多语言**：支持中英文切换\\\\n- **响应式设计**：支持PC、平板、手机访问\\\\n\\\\n### 3.3 安全需求\\\\n\\\\n- **数据加密**：敏感数据加密存储\\\\n- **访问控制**：基于角色的访问控制\\\\n- **操作审计**：记录所有操作日志\\\\n- **数据脱敏**：导出数据自动脱敏\\\\n\\\\n### 3.4 兼容性需求\\\\n\\\\n- **浏览器兼容**：支持Chrome、Firefox、Safari、Edge最新版本\\\\n- **设备兼容**：支持Windows、macOS、iOS、Android\\\\n- **分辨率**：支持1920x1080及以上分辨率\\\\n\\\\n## 4. 接口设计\\\\n\\\\n### 4.1 客户管理接口\\\\n\\\\n```typescript\\\\n// 获取客户列表\\\\nGET /api/v1/customers\\\\nQuery Parameters:\\\\n  - page: number\\\\n  - limit: number\\\\n  - search: string\\\\n  - level: string\\\\n  - segment: string\\\\n  - startDate: string\\\\n  - endDate: string\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"items\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"id\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n        \\\\\\\"name\\\\\\\": \\\\\\\"张三\\\\\\\",\\\\n        \\\\\\\"phone\\\\\\\": \\\\\\\"13800138000\\\\\\\",\\\\n        \\\\\\\"email\\\\\\\": \\\\\\\"zhangsan@example.com\\\\\\\",\\\\n        \\\\\\\"level\\\\\\\": \\\\\\\"vip\\\\\\\",\\\\n        \\\\\\\"points\\\\\\\": 5000,\\\\n        \\\\\\\"totalSpent\\\\\\\": 10000,\\\\n        \\\\\\\"orderCount\\\\\\\": 50,\\\\n        \\\\\\\"lastOrderDate\\\\\\\": \\\\\\\"2025-01-20T10:00:00Z\\\\\\\",\\\\n        \\\\\\\"createdAt\\\\\\\": \\\\\\\"2024-01-01T10:00:00Z\\\\\\\"\\\\n      }\\\\n    ],\\\\n    \\\\\\\"pagination\\\\\\\": {\\\\n      \\\\\\\"page\\\\\\\": 1,\\\\n      \\\\\\\"limit\\\\\\\": 20,\\\\n      \\\\\\\"total\\\\\\\": 1000,\\\\n      \\\\\\\"totalPages\\\\\\\": 50\\\\n    }\\\\n  }\\\\n}\\\\n\\\\n// 创建客户\\\\nPOST /api/v1/customers\\\\nBody:\\\\n{\\\\n  \\\\\\\"name\\\\\\\": \\\\\\\"张三\\\\\\\",\\\\n  \\\\\\\"phone\\\\\\\": \\\\\\\"13800138000\\\\\\\",\\\\n  \\\\\\\"email\\\\\\\": \\\\\\\"zhangsan@example.com\\\\\\\",\\\\n  \\\\\\\"gender\\\\\\\": \\\\\\\"male\\\\\\\",\\\\n  \\\\\\\"birthday\\\\\\\": \\\\\\\"1990-01-01\\\\\\\",\\\\n  \\\\\\\"tags\\\\\\\": [\\\\\\\"美食爱好者\\\\\\\"]\\\\n}\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"id\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n    \\\\\\\"customerNo\\\\\\\": \\\\\\\"C00001\\\\\\\",\\\\n    \\\\\\\"createdAt\\\\\\\": \\\\\\\"2025-01-20T10:00:00Z\\\\\\\"\\\\n  }\\\\n}\\\\n\\\\n// 更新客户\\\\nPUT /api/v1/customers/:id\\\\nBody: 同创建客户\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"id\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n    \\\\\\\"updatedAt\\\\\\\": \\\\\\\"2025-01-20T11:00:00Z\\\\\\\"\\\\n  }\\\\n}\\\\n\\\\n// 获取客户详情\\\\nGET /api/v1/customers/:id\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"id\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n    \\\\\\\"profile\\\\\\\": {\\\\n      \\\\\\\"name\\\\\\\": \\\\\\\"张三\\\\\\\",\\\\n      \\\\\\\"phone\\\\\\\": \\\\\\\"13800138000\\\\\\\",\\\\n      \\\\\\\"email\\\\\\\": \\\\\\\"zhangsan@example.com\\\\\\\",\\\\n      \\\\\\\"gender\\\\\\\": \\\\\\\"male\\\\\\\",\\\\n      \\\\\\\"birthday\\\\\\\": \\\\\\\"1990-01-01\\\\\\\"\\\\n    },\\\\n    \\\\\\\"stats\\\\\\\": {\\\\n      \\\\\\\"totalSpent\\\\\\\": 10000,\\\\n      \\\\\\\"orderCount\\\\\\\": 50,\\\\n      \\\\\\\"avgOrderValue\\\\\\\": 200,\\\\n      \\\\\\\"points\\\\\\\": 5000\\\\n    },\\\\n    \\\\\\\"tags\\\\\\\": [\\\\\\\"美食爱好者\\\\\\\", \\\\\\\"VIP\\\\\\\"],\\\\n    \\\\\\\"orders\\\\\\\": [],\\\\n    \\\\\\\"communications\\\\\\\": []\\\\n  }\\\\n}\\\\n```\\\\n\\\\n### 4.2 会员管理接口\\\\n\\\\n```typescript\\\\n// 获取会员等级\\\\nGET /api/v1/membership/levels\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"levels\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"id\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n        \\\\\\\"name\\\\\\\": \\\\\\\"普通会员\\\\\\\",\\\\n        \\\\\\\"icon\\\\\\\": \\\\\\\"icon_url\\\\\\\",\\\\n        \\\\\\\"upgradeCondition\\\\\\\": {\\\\n          \\\\\\\"amount\\\\\\\": 0,\\\\n          \\\\\\\"orders\\\\\\\": 0\\\\n        },\\\\n        \\\\\\\"benefits\\\\\\\": [\\\\\\\"积分1.2倍\\\\\\\"]\\\\n      }\\\\n    ]\\\\n  }\\\\n}\\\\n\\\\n// 开通会员\\\\nPOST /api/v1/membership/enroll\\\\nBody:\\\\n{\\\\n  \\\\\\\"customerId\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n  \\\\\\\"levelId\\\\\\\": \\\\\\\"2\\\\\\\",\\\\n  \\\\\\\"duration\\\\\\\": 365\\\\n}\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"membershipId\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n    \\\\\\\"startDate\\\\\\\": \\\\\\\"2025-01-20\\\\\\\",\\\\n    \\\\\\\"endDate\\\\\\\": \\\\\\\"2026-01-20\\\\\\\"\\\\n  }\\\\n}\\\\n\\\\n// 调整积分\\\\nPOST /api/v1/membership/points/adjust\\\\nBody:\\\\n{\\\\n  \\\\\\\"customerId\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n  \\\\\\\"adjustment\\\\\\\": 100,\\\\n  \\\\\\\"reason\\\\\\\": \\\\\\\"消费奖励\\\\\\\"\\\\n}\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"currentPoints\\\\\\\": 5100,\\\\n    \\\\\\\"adjustment\\\\\\\": 100\\\\n  }\\\\n}\\\\n```\\\\n\\\\n### 4.3 客户分群接口\\\\n\\\\n```typescript\\\\n// 获取客户分群\\\\nGET /api/v1/customers/segments\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"segments\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"id\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n        \\\\\\\"name\\\\\\\": \\\\\\\"高价值客户\\\\\\\",\\\\n        \\\\\\\"condition\\\\\\\": {\\\\n          \\\\\\\"totalSpent\\\\\\\": { \\\\\\\"gte\\\\\\\": 10000 },\\\\n          \\\\\\\"orderCount\\\\\\\": { \\\\\\\"gte\\\\\\\": 10 }\\\\n        },\\\\n        \\\\\\\"count\\\\\\\": 50\\\\n      }\\\\n    ]\\\\n  }\\\\n}\\\\n\\\\n// 创建分群\\\\nPOST /api/v1/customers/segments\\\\nBody:\\\\n{\\\\n  \\\\\\\"name\\\\\\\": \\\\\\\"新客户\\\\\\\",\\\\n  \\\\\\\"condition\\\\\\\": {\\\\n    \\\\\\\"createdAt\\\\\\\": { \\\\\\\"gte\\\\\\\": \\\\\\\"2025-01-01\\\\\\\" }\\\\n  }\\\\n}\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"id\\\\\\\": \\\\\\\"2\\\\\\\",\\\\n    \\\\\\\"count\\\\\\\": 100\\\\n  }\\\\n}\\\\n```\\\\n\\\\n### 4.4 客户画像接口\\\\n\\\\n```typescript\\\\n// 获取客户画像\\\\nGET /api/v1/customers/:id/profile\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"basicProfile\\\\\\\": {\\\\n      \\\\\\\"age\\\\\\\": \\\\\\\"30-40\\\\\\\",\\\\n      \\\\\\\"gender\\\\\\\": \\\\\\\"male\\\\\\\",\\\\n      \\\\\\\"location\\\\\\\": \\\\\\\"北京\\\\\\\",\\\\n      \\\\\\\"occupation\\\\\\\": \\\\\\\"白领\\\\\\\"\\\\n    },\\\\n    \\\\\\\"consumptionProfile\\\\\\\": {\\\\n      \\\\\\\"avgOrderValue\\\\\\\": 200,\\\\n      \\\\\\\"frequency\\\\\\\": \\\\\\\"weekly\\\\\\\",\\\\n      \\\\\\\"favoriteCategories\\\\\\\": [\\\\\\\"川菜\\\\\\\", \\\\\\\"粤菜\\\\\\\"],\\\\n      \\\\\\\"priceRange\\\\\\\": \\\\\\\"50-100\\\\\\\"\\\\n    },\\\\n    \\\\\\\"behaviorProfile\\\\\\\": {\\\\n      \\\\\\\"peakHours\\\\\\\": [\\\\\\\"12:00-13:00\\\\\\\", \\\\\\\"18:00-19:00\\\\\\\"],\\\\n      \\\\\\\"preferredChannel\\\\\\\": \\\\\\\"小程序\\\\\\\",\\\\n      \\\\\\\"device\\\\\\\": \\\\\\\"mobile\\\\\\\"\\\\n    },\\\\n    \\\\\\\"tags\\\\\\\": [\\\\\\\"美食爱好者\\\\\\\", \\\\\\\"价格敏感\\\\\\\", \\\\\\\"追求品质\\\\\\\"]\\\\n  }\\\\n}\\\\n```\\\\n\\\\n### 4.5 流失预警接口\\\\n\\\\n```typescript\\\\n// 获取流失风险客户\\\\nGET /api/v1/customers/churn-risk\\\\nQuery Parameters:\\\\n  - level: string (high, medium, low)\\\\n  - daysSinceLastOrder: number\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"customers\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"id\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n        \\\\\\\"name\\\\\\\": \\\\\\\"张三\\\\\\\",\\\\n        \\\\\\\"lastOrderDate\\\\\\\": \\\\\\\"2024-12-01\\\\\\\",\\\\n        \\\\\\\"daysSinceLastOrder\\\\\\\": 50,\\\\n        \\\\\\\"churnLevel\\\\\\\": \\\\\\\"high\\\\\\\",\\\\n        \\\\\\\"churnProbability\\\\\\\": 0.85,\\\\n        \\\\\\\"recommendedActions\\\\\\\": [\\\\\\\"发送优惠券\\\\\\\", \\\\\\\"专属客服联系\\\\\\\"]\\\\n      }\\\\n    ]\\\\n  }\\\\n}\\\\n\\\\n// 执行挽留\\\\nPOST /api/v1/customers/:id/retain\\\\nBody:\\\\n{\\\\n  \\\\\\\"action\\\\\\\": \\\\\\\"coupon\\\\\\\",\\\\n  \\\\\\\"couponId\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n  \\\\\\\"note\\\\\\\": \\\\\\\"流失风险客户挽留\\\\\\\"\\\\n}\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"retentionId\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n    \\\\\\\"result\\\\\\\": \\\\\\\"success\\\\\\\"\\\\n  }\\\\n}\\\\n```\\\\n\\\\n## 5. 数据模型\\\\n\\\\n### 5.1 客户模型\\\\n\\\\n```typescript\\\\ninterface Customer {\\\\n  id: string;\\\\n  customerNo: string;\\\\n  name: string;\\\\n  phone: string;\\\\n  email?: string;\\\\n  gender?: string;\\\\n  birthday?: string;\\\\n  avatar?: string;\\\\n  level: CustomerLevel;\\\\n  points: number;\\\\n  totalSpent: number;\\\\n  orderCount: number;\\\\n  avgOrderValue: number;\\\\n  lastOrderDate?: string;\\\\n  registerDate: string;\\\\n  tags: string[];\\\\n  status: CustomerStatus;\\\\n  source?: string;\\\\n  createdAt: string;\\\\n  updatedAt: string;\\\\n}\\\\n\\\\nenum CustomerLevel {\\\\n  REGULAR = \\\\'regular\\\\',\\\\n  MEMBER = \\\\'member\\\\',\\\\n  VIP = \\\\'vip\\\\',\\\\n  SVIP = \\\\'svip\\\\'\\\\n}\\\\n\\\\nenum CustomerStatus {\\\\n  ACTIVE = \\\\'active\\\\',\\\\n  INACTIVE = \\\\'inactive\\\\',\\\\n  CHURNED = \\\\'churned\\\\',\\\\n  BLOCKED = \\\\'blocked\\\\'\\\\n}\\\\n```\\\\n\\\\n### 5.2 会员模型\\\\n\\\\n```typescript\\\\ninterface Membership {\\\\n  id: string;\\\\n  customerId: string;\\\\n  levelId: string;\\\\n  startDate: string;\\\\n  endDate: string;\\\\n  points: number;\\\\n  totalSpent: number;\\\\n  status: MembershipStatus;\\\\n  createdAt: string;\\\\n  updatedAt: string;\\\\n}\\\\n\\\\nenum MembershipStatus {\\\\n  ACTIVE = \\\\'active\\\\',\\\\n  EXPIRED = \\\\'expired\\\\',\\\\n  CANCELLED = \\\\'cancelled\\\\'\\\\n}\\\\n\\\\ninterface MembershipLevel {\\\\n  id: string;\\\\n  name: string;\\\\n  icon?: string;\\\\n  upgradeCondition: {\\\\n    amount?: number;\\\\n    orders?: number;\\\\n    points?: number;\\\\n  };\\\\n  benefits: MembershipBenefit[];\\\\n  sortOrder: number;\\\\n}\\\\n\\\\ninterface MembershipBenefit {\\\\n  type: string;\\\\n  value: string;\\\\n  description: string;\\\\n}\\\\n```\\\\n\\\\n### 5.3 客户分群模型\\\\n\\\\n```typescript\\\\ninterface CustomerSegment {\\\\n  id: string;\\\\n  name: string;\\\\n  description?: string;\\\\n  condition: SegmentCondition;\\\\n  customerCount: number;\\\\n  createdAt: string;\\\\n  updatedAt: string;\\\\n}\\\\n\\\\ninterface SegmentCondition {\\\\n  logicalOperator: \\\\'and\\\\' | \\\\'or\\\\';\\\\n  conditions: Condition[];\\\\n}\\\\n\\\\ninterface Condition {\\\\n  field: string;\\\\n  operator: \\\\'eq\\\\' | \\\\'ne\\\\' | \\\\'gt\\\\' | \\\\'gte\\\\' | \\\\'lt\\\\' | \\\\'lte\\\\' | \\\\'contains\\\\' | \\\\'in\\\\';\\\\n  value: any;\\\\n}\\\\n```\\\\n\\\\n### 5.4 客户画像模型\\\\n\\\\n```typescript\\\\ninterface CustomerProfile {\\\\n  customerId: string;\\\\n  basicProfile: BasicProfile;\\\\n  consumptionProfile: ConsumptionProfile;\\\\n  behaviorProfile: BehaviorProfile;\\\\n  tags: ProfileTag[];\\\\n  updatedAt: string;\\\\n}\\\\n\\\\ninterface BasicProfile {\\\\n  age?: string;\\\\n  gender?: string;\\\\n  location?: string;\\\\n  occupation?: string;\\\\n  income?: string;\\\\n}\\\\n\\\\ninterface ConsumptionProfile {\\\\n  avgOrderValue: number;\\\\n  frequency: string;\\\\n  favoriteCategories: string[];\\\\n  favoriteDishes: string[];\\\\n  priceRange: string;\\\\n  paymentPreferences: string[];\\\\n}\\\\n\\\\ninterface BehaviorProfile {\\\\n  peakHours: string[];\\\\n  preferredChannel: string;\\\\n  device: string;\\\\n  avgSessionDuration: number;\\\\n  browsingPattern: string[];\\\\n}\\\\n\\\\ninterface ProfileTag {\\\\n  name: string;\\\\n  type: \\\\'auto\\\\' | \\\\'manual\\\\';\\\\n  confidence: number;\\\\n  source?: string;\\\\n}\\\\n```\\\\n\\\\n## 6. 用户界面设计\\\\n\\\\n### 6.1 主界面布局\\\\n\\\\n```\\\\n┌─────────────────────────────────────────────────────────────┐\\\\n│  客户管理                                              │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  ┌─────────┐ ┌─────────┐ ┌─────────┐ ┌─────────┐    │\\\\n│  │ 1,000   │ │ 150     │ │ 50      │ │ 85%     │    │\\\\n│  │ 总客户  │ │ 新客户  │ │ VIP客户 │ │ 活跃率  │    │\\\\n│  │ ↑5.2%  │ │ ↑15.3% │ │ ↑8.7%  │ │ ↑3.2%  │    │\\\\n│  └─────────┘ └─────────┘ └─────────┘ └─────────┘    │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  [搜索客户...] [等级▼] [分群▼] [日期范围] [+新增客户]  │\\\\n│  [导出] [分群]                                         │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  ┌─────────────────────────────────────────────────────┐   │\\\\n│  │  客户    等级   手机号     消费    订单   最后消费  │   │\\\\n│  │  张三    VIP   13800138  ¥10,000  50    2025-01-20 │   │\\\\n│  │  李四    会员  13800138  ¥5,000   30    2025-01-19 │   │\\\\n│  │  王五    普通  13800138  ¥1,000   10    2025-01-18 │   │\\\\n│  └─────────────────────────────────────────────────────┘   │\\\\n│  共 1,000 条记录  [上一页] 1 / 50 [下一页]            │\\\\n└─────────────────────────────────────────────────────────────┘\\\\n```\\\\n\\\\n### 6.2 客户详情界面\\\\n\\\\n```\\\\n┌─────────────────────────────────────────────────────────────┐\\\\n│  客户详情 - 张三                                        │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  [基本信息] [消费记录] [互动记录] [客户画像]           │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  基本信息                                              │\\\\n│  ┌─────────────────────────────────────────────────────┐   │\\\\n│  │  姓名: 张三          等级: VIP                    │   │\\\\n│  │  手机: 13800138000   积分: 5,000                 │   │\\\\n│  │  邮箱: zhangsan@example.com                    │   │\\\\n│  │  性别: 男            注册: 2024-01-01           │   │\\\\n│  │  生日: 1990-01-01    来源: 线上                │   │\\\\n│  └─────────────────────────────────────────────────────┘   │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  消费统计                                              │\\\\n│  ┌─────────────────────────────────────────────────────┐   │\\\\n│  │  总消费: ¥10,000    订单数: 50    客单价: ¥200  │   │\\\\n│  │  活跃度: 高         流失风险: 低               │   │\\\\n│  │  标签: 美食爱好者、VIP、高价值客户               │   │\\\\n│  └─────────────────────────────────────────────────────┘   │\\\\n└─────────────────────────────────────────────────────────────┘\\\\n```\\\\n\\\\n## 7. 测试需求\\\\n\\\\n### 7.1 单元测试\\\\n\\\\n- 客户CRUD操作测试\\\\n- 会员升降级测试\\\\n- 积分计算测试\\\\n- RFM分级测试\\\\n- 流失预警测试\\\\n\\\\n### 7.2 集成测试\\\\n\\\\n- 客户与订单集成测试\\\\n- 客户与会员集成测试\\\\n- 分群营销集成测试\\\\n- 画像更新集成测试\\\\n\\\\n### 7.3 性能测试\\\\n\\\\n- 大数据量查询测试\\\\n- 并发访问测试\\\\n- 画像计算性能测试\\\\n- 批量操作性能测试\\\\n\\\\n### 7.4 用户验收测试\\\\n\\\\n- 功能完整性测试\\\\n- 易用性测试\\\\n- 兼容性测试\\\\n- 安全性测试\\\\n\\\\n## 8. 部署和维护\\\\n\\\\n### 8.1 部署要求\\\\n\\\\n- 服务器配置：8核CPU、16GB内存、500GB SSD\\\\n- 数据库：PostgreSQL 13+\\\\n- 缓存：Redis 6+\\\\n\\\\n### 8.2 监控要求\\\\n\\\\n- 系统监控：CPU、内存、磁盘、网络\\\\n- 应用监控：响应时间、错误率、吞吐量\\\\n- 业务监控：客户数据准确性、会员权益使用率\\\\n\\\\n### 8.3 备份策略\\\\n\\\\n- 数据库备份：每日全量备份，每小时增量备份\\\\n- 配置备份：每次配置变更后备份\\\\n- 日志备份：每日备份，保留30天\\\\n\\\\n### 8.4 维护计划\\\\n\\\\n- 定期更新：每月更新客户画像模型\\\\n- 性能优化：每季度进行性能优化\\\\n- 安全检查：每周进行安全检查\\\\n- 功能迭代：根据用户反馈持续优化\\\\n\\\\n## 9. 版本历史\\\\n\\\\n| 版本 | 日期 | 作者 | 变更说明 |\\\\n|------|------|------|---------|\\\\n| 1.0.0 | 2025-01-20 | YYC³ | 初始版本 |\\\\n\",\"originAcceptText\":\"# 客户管理功能模块需求分析与设计文档\\n\\n## 1. 模块概述\\n\\n### 1.1 模块简介\\n\\n客户管理功能模块是YYC³餐饮平台的核心业务模块，负责管理餐厅的客户信息，包括客户档案、会员管理、客户分级、客户画像、客户互动等功能。该模块帮助餐厅建立完善的客户关系管理体系，提升客户满意度和忠诚度。\\n\\n### 1.2 模块目标\\n\\n- **客户档案管理**：集中管理客户基本信息，提供完整的客户视图\\n- **会员管理**：建立会员体系，提供差异化的会员权益\\n- **客户分级**：基于RFM模型进行客户分层，识别高价值客户\\n- **客户画像**：分析客户行为，构建客户画像，支撑精准营销\\n- **客户互动**：管理客户沟通渠道，提升客户体验\\n- **流失预警**：识别流失风险客户，提供挽留策略\\n\\n### 1.3 适用范围\\n\\n- 餐厅管理者：管理客户关系，制定客户策略\\n- 市场营销人员：进行精准营销，分析营销效果\\n- 客服人员：查看客户信息，处理客户问题\\n- 财务人员：管理客户账户，处理退款\\n- 运营人员：分析客户数据，优化运营策略\\n\\n## 2. 功能需求\\n\\n### 2.1 客户档案管理\\n\\n#### 2.1.1 客户信息录入\\n\\n**功能描述**：录入新客户信息。\\n\\n**输入参数**：\\n- 基本信息：姓名、手机号、邮箱、性别、生日\\n- 地址信息：收货地址、默认地址\\n- 客户标签：来源渠道、偏好标签\\n- 备注信息：客户备注\\n\\n**输出结果**：\\n- 客户ID：系统生成的唯一标识\\n- 客户编号：可自定义的客户编号\\n- 创建时间：客户创建时间\\n\\n**业务规则**：\\n- 手机号唯一性校验\\n- 邮箱格式校验\\n- 支持批量导入客户\\n- 支持从订单创建客户\\n\\n#### 2.1.2 客户信息编辑\\n\\n**功能描述**：编辑已有客户信息。\\n\\n**输入参数**：\\n- 客户ID：必填\\n- 其他信息：同客户信息录入\\n\\n**输出结果**：\\n- 更新时间：客户信息更新时间\\n- 修改记录：记录修改历史\\n\\n**业务规则**：\\n- 敏感信息修改需要验证\\n- 修改记录完整保留\\n- 支持批量编辑客户信息\\n\\n#### 2.1.3 客户信息查询\\n\\n**功能描述**：查询客户信息。\\n\\n**输入参数**：\\n- 搜索关键词：姓名、手机号、邮箱、客户编号\\n- 筛选条件：客户等级、客户标签、注册时间\\n\\n**输出结果**：\\n- 客户列表：符合条件的客户列表\\n- 结果数量：符合条件的客户数量\\n\\n**业务规则**：\\n- 支持模糊搜索\\n- 支持多条件组合查询\\n- 搜索结果实时更新\\n\\n#### 2.1.4 客户详情查看\\n\\n**功能描述**：查看客户详细信息。\\n\\n**输入参数**：\\n- 客户ID：必填\\n\\n**输出结果**：\\n- 基本信息：客户基本资料\\n- 消费记录：历史订单记录\\n- 互动记录：沟通记录\\n- 标签信息：客户标签\\n- 备注信息：客户备注\\n\\n**业务规则**：\\n- 支持Tab页签切换\\n- 展示完整的客户视图\\n- 支持导出客户详情\\n\\n### 2.2 会员管理\\n\\n#### 2.2.1 会员等级设置\\n\\n**功能描述**：设置会员等级体系。\\n\\n**输入参数**：\\n- 等级名称：必填\\n- 等级图标：可选\\n- 升级条件：消费金额、订单数量、积分\\n- 等级权益：折扣、赠品、专属服务\\n- 降级规则：保级条件、降级处理\\n\\n**输出结果**：\\n- 等级ID：系统生成的唯一标识\\n- 等级配置：等级设置详情\\n\\n**业务规则**：\\n- 支持多级会员体系\\n- 等级权益可配置\\n- 升降级自动处理\\n\\n#### 2.2.2 会员开通\\n\\n**功能描述**：开通会员资格。\\n\\n**输入参数**：\\n- 客户ID：必填\\n- 会员等级：必填\\n- 有效期：必填\\n- 开通方式：购买、赠送、系统调整\\n\\n**输出结果**：\\n- 会员ID：会员记录ID\\n- 开通时间：会员开通时间\\n- 到期时间：会员到期时间\\n\\n**业务规则**：\\n- 检查客户是否已是会员\\n- 支持批量开通\\n- 记录开通来源\\n\\n#### 2.2.3 会员升降级\\n\\n**功能描述**：自动或手动调整会员等级。\\n\\n**输入参数**：\\n- 客户ID：必填\\n- 升降级类型：自动、手动\\n- 目标等级：手动调整时必填\\n\\n**输出结果**：\\n- 升降级结果：成功或失败\\n- 等级变更记录：变更详情\\n\\n**业务规则**：\\n- 自动升降级按配置规则执行\\n- 手动升降级需要权限\\n- 升降级通知客户\\n\\n#### 2.2.4 会员权益管理\\n\\n**功能描述**：管理会员权益。\\n\\n**输入参数**：\\n- 等级ID：必填\\n- 权益类型：折扣、赠品、积分、专属服务\\n- 权益内容：权益详情\\n\\n**输出结果**：\\n- 权益配置：权益设置详情\\n\\n**业务规则**：\\n- 权益可叠加或互斥\\n- 权益使用记录可追溯\\n- 支持权益有效期设置\\n\\n#### 2.2.5 会员积分管理\\n\\n**功能描述**：管理客户积分。\\n\\n**输入参数**：\\n- 客户ID：必填\\n- 积分变动：增加或减少\\n- 变动数量：必填\\n- 变动原因：必填\\n\\n**输出结果**：\\n- 积分余额：当前积分\\n- 积分变动记录：变动历史\\n\\n**业务规则**：\\n- 积分有效期可配置\\n- 积分变动记录完整\\n- 支持积分抵扣订单\\n\\n### 2.3 客户分级\\n\\n#### 2.3.1 RFM模型分析\\n\\n**功能描述**：基于RFM模型进行客户分级。\\n\\n**输入参数**：\\n- 分析时间范围：必填\\n- 分级数量：3-10级\\n- 权重设置：R、F、M权重\\n\\n**输出结果**：\\n- 客户分级：各等级客户列表\\n- 分级特征：各等级客户特征\\n- 分级统计：各等级统计数据\\n\\n**业务规则**：\\n- R（最近消费时间）\\n- F（消费频率）\\n- M（消费金额）\\n- 支持自定义权重\\n\\n#### 2.3.2 客户分群\\n\\n**功能描述**：创建客户分群。\\n\\n**输入参数**：\\n- 分群名称：必填\\n- 分群条件：必填，支持多条件\\n- 分群范围：全部客户或筛选客户\\n\\n**输出结果**：\\n- 分群ID：系统生成的唯一标识\\n- 分群人数：符合条件的客户数\\n- 分群规则：分群条件详情\\n\\n**业务规则**：\\n- 支持复杂条件组合\\n- 支持保存分群规则\\n- 支持分群更新\\n\\n#### 2.3.3 分群营销\\n\\n**功能描述**：针对分群进行营销。\\n\\n**输入参数**：\\n- 分群ID：必填\\n- 营销活动：必填\\n- 营销内容：必填\\n\\n**输出结果**：\\n- 营销ID：营销活动ID\\n- 目标人数：目标客户数\\n- 发送记录：发送结果\\n\\n**业务规则**：\\n- 支持多种营销方式\\n- 营销效果可追踪\\n- 支持A/B测试\\n\\n#### 2.3.4 分群分析\\n\\n**功能描述**：分析客户分群特征。\\n\\n**输入参数**：\\n- 分群ID：必填\\n- 分析维度：消费、行为、属性\\n\\n**输出结果**：\\n- 分群画像：客户画像详情\\n- 分群趋势：分群变化趋势\\n- 分群对比：与其他分群对比\\n\\n**业务规则**：\\n- 自动生成分析报告\\n- 支持多维度分析\\n- 支持对比分析\\n\\n### 2.4 客户画像\\n\\n#### 2.4.1 基础画像\\n\\n**功能描述**：生成客户基础画像。\\n\\n**输入参数**：\\n- 客户ID：必填\\n- 画像维度：人口统计、消费能力\\n\\n**输出结果**：\\n- 年龄段：客户年龄段\\n- 性别：客户性别\\n- 地区：客户所在地区\\n- 职业：客户职业类型\\n- 收入：预估收入水平\\n\\n**业务规则**：\\n- 基于注册信息推断\\n- 基于消费行为推断\\n- 支持手动标注\\n\\n#### 2.4.2 消费画像\\n\\n**功能描述**：生成客户消费画像。\\n\\n**输入参数**：\\n- 客户ID：必填\\n- 时间范围：可选\\n\\n**输出结果**：\\n- 消费频次：平均消费频率\\n- 消费金额：总消费、客单价\\n- 消费偏好：品类偏好、口味偏好\\n- 消费时段：消费高峰时段\\n- 支付方式：常用支付方式\\n\\n**业务规则**：\\n- 基于历史订单分析\\n- 自动更新消费画像\\n- 支持同期对比\\n\\n#### 2.4.3 行为画像\\n\\n**功能描述**：生成客户行为画像。\\n\\n**输入参数**：\\n- 客户ID：必填\\n- 行为类型：浏览、下单、评价\\n\\n**输出结果**：\\n- 访问频率：访问次数、时长\\n- 浏览偏好：浏览品类、菜品\\n- 互动行为：评价、分享、收藏\\n- 渠道偏好：线上、线下偏好\\n- 设备偏好：PC、移动端\\n\\n**业务规则**：\\n- 基于埋点数据分析\\n- 行为数据脱敏处理\\n- 实时更新行为画像\\n\\n#### 2.4.4 标签系统\\n\\n**功能描述**：为客户打标签。\\n\\n**输入参数**：\\n- 客户ID：必填\\n- 标签类型：自动、手动\\n- 标签内容：标签名称\\n\\n**输出结果**：\\n- 标签列表：客户标签列表\\n- 标签权重：标签重要性\\n\\n**业务规则**：\\n- 支持自动标签\\n- 支持手动标签\\n- 标签可继承\\n- 支持标签组合\\n\\n#### 2.4.5 画像更新\\n\\n**功能描述**：自动更新客户画像。\\n\\n**输入参数**：\\n- 更新类型：实时、定时\\n- 更新范围：全部、增量\\n\\n**输出结果**：\\n- 更新状态：更新成功或失败\\n- 更新记录：更新详情\\n\\n**业务规则**：\\n- 实时更新关键指标\\n- 定时更新完整画像\\n- 画像更新可追溯\\n\\n### 2.5 客户互动\\n\\n#### 2.5.1 短信通知\\n\\n**功能描述**：向客户发送短信。\\n\\n**输入参数**：\\n- 客户ID或分群：必填\\n- 短信模板：必填\\n- 发送时间：即时或定时\\n\\n**输出结果**：\\n- 发送记录：发送详情\\n- 发送状态：成功、失败、发送中\\n\\n**业务规则**：\\n- 支持模板短信\\n- 支持变量替换\\n- 发送记录完整\\n\\n#### 2.5.2 邮件通知\\n\\n**功能描述**：向客户发送邮件。\\n\\n**输入参数**：\\n- 客户ID或分群：必填\\n- 邮件模板：必填\\n- 发送时间：即时或定时\\n\\n**输出结果**：\\n- 发送记录：发送详情\\n- 打开率：邮件打开率\\n- 点击率：链接点击率\\n\\n**业务规则**：\\n- 支持富文本邮件\\n- 支持A/B测试\\n- 邮件打开可追踪\\n\\n#### 2.5.3 微信通知\\n\\n**功能描述**：向客户发送微信通知。\\n\\n**输入参数**：\\n- 客户ID：必填\\n- 微信模板：必填\\n- 发送内容：必填\\n\\n**发送结果**：\\n- 发送记录：发送详情\\n- 送达状态：送达状态\\n\\n**业务规则**：\\n- 需客户授权\\n- 支持模板消息\\n- 支持服务通知\\n\\n#### 2.5.4 沟通记录\\n\\n**功能描述**：记录客户沟通。\\n\\n**输入参数**：\\n- 客户ID：必填\\n- 沟通方式：电话、在线、面对面\\n- 沟通内容：必填\\n- 沟通结果：必填\\n\\n**输出结果**：\\n- 沟通记录ID：记录ID\\n- 沟通时间：沟通时间\\n\\n**业务规则**：\\n- 支持多渠道沟通记录\\n- 沟通记录关联订单\\n- 支持回访提醒\\n\\n#### 2.5.5 满意度调查\\n\\n**功能描述**：进行客户满意度调查。\\n\\n**输入参数**：\\n- 调查方式：问卷、评分\\n- 调查对象：全部或指定客户\\n- 调查内容：调查题目\\n\\n**输出结果**：\\n- 调查结果：满意度数据\\n- 分析报告：分析报告\\n\\n**业务规则**：\\n- 支持多种调查方式\\n- 调查结果可分析\\n- 支持持续跟踪\\n\\n### 2.6 流失预警\\n\\n#### 2.6.1 流失识别\\n\\n**功能描述**：识别流失风险客户。\\n\\n**输入参数**：\\n- 流失定义：必填（最后消费距今天数）\\n- 流失等级：高、中、低\\n\\n**输出结果**：\\n- 流失客户列表：流失风险客户\\n- 流失等级：风险等级\\n- 流失原因：可能原因\\n\\n**业务规则**：\\n- 基于历史数据分析\\n- 流失阈值可配置\\n- 流失等级自动评定\\n\\n#### 2.6.2 流失原因分析\\n\\n**功能描述**：分析客户流失原因。\\n\\n**输入参数**：\\n- 流失客户：必填\\n- 分析维度：价格、服务、质量\\n\\n**输出结果**：\\n- 流失原因：主要原因分析\\n- 流失趋势：流失趋势图\\n- 对策建议：挽回建议\\n\\n**业务规则**：\\n- 基于数据分析\\n- 支持客户反馈分析\\n- 提供改进建议\\n\\n#### 2.6.3 挽留策略\\n\\n**功能描述**：制定客户挽留策略。\\n\\n**输入参数**：\\n- 流失客户：必填\\n- 挽留方式：优惠券、专属服务\\n- 挽留内容：必填\\n\\n**输出结果**：\\n- 挽留记录：挽留操作记录\\n- 挽留效果：挽留成功率\\n\\n**业务规则**：\\n- 挽留方式可配置\\n- 挽留效果可追踪\\n- 支持批量挽留\\n\\n#### 2.6.4 流失挽回\\n\\n**功能描述**：执行客户流失挽回。\\n\\n**输入参数**：\\n- 流失客户：必填\\n- 挽回措施：必填\\n\\n**输出结果**：\\n- 挽回结果：成功或失败\\n- 客户状态：当前状态\\n\\n**业务规则**：\\n- 挽回措施可组合\\n- 挽回后跟踪消费\\n- 记录挽回过程\\n\\n### 2.7 客户分析\\n\\n#### 2.7.1 客户统计\\n\\n**功能描述**：统计客户数据。\\n\\n**输入参数**：\\n- 统计周期：日、周、月、季、年\\n- 统计维度：新增、活跃、流失\\n\\n**输出结果**：\\n- 新增客户数：新增客户数量\\n- 活跃客户数：活跃客户数量\\n- 流失客户数：流失客户数量\\n- 客户增长率：增长率\\n\\n**业务规则**：\\n- 支持多维度统计\\n- 支持同比环比\\n- 数据实时更新\\n\\n#### 2.7.2 客户生命周期\\n\\n**功能描述**：分析客户生命周期。\\n\\n**输入参数**：\\n- 时间范围：必填\\n- 分析阶段：获取、激活、留存、流失\\n\\n**输出结果**：\\n- 生命周期分布：各阶段客户数\\n- 转化率：阶段间转化率\\n- 平均周期：平均生命周期\\n- 价值分析：生命周期价值\\n\\n**业务规则**：\\n- 生命周期自动计算\\n- 转化漏斗可视化\\n- 提供优化建议\\n\\n#### 2.7.3 客户价值分析\\n\\n**功能描述**：分析客户价值。\\n\\n**输入参数**：\\n- 价值指标：消费、影响力、口碑\\n- 分析方法：CLV、RFM\\n\\n**输出结果**：\\n- 客户价值排名：高价值客户排名\\n- 价值分布：价值分布情况\\n- 价值预测：未来价值预测\\n\\n**业务规则**：\\n- 支持多种价值模型\\n- 价值实时更新\\n- 价值可追溯\\n\\n#### 2.7.4 客户行为分析\\n\\n**功能描述**：分析客户行为。\\n\\n**输入参数**：\\n- 行为类型：浏览、下单、评价\\n- 分析维度：频次、时段、渠道\\n\\n**输出结果**：\\n- 行为分布：行为分布情况\\n- 行为路径：典型行为路径\\n- 行为关联：行为关联分析\\n\\n**业务规则**：\\n- 行为数据脱敏\\n- 路径可视化\\n- 支持A/B分析\\n\\n### 2.8 导出管理\\n\\n#### 2.8.1 客户导出\\n\\n**功能描述**：导出客户数据。\\n\\n**输入参数**：\\n- 导出格式：Excel、CSV、PDF\\n- 导出字段：选择导出字段\\n- 筛选条件：导出范围\\n\\n**输出结果**：\\n- 导出文件：生成的导出文件\\n- 导出记录：导出历史\\n\\n**业务规则**：\\n- 支持自定义字段\\n- 导出记录完整\\n- 敏感数据脱敏\\n\\n#### 2.8.2 客户导入\\n\\n**功能描述**：导入客户数据。\\n\\n**输入参数**：\\n- 导入文件：必填，支持Excel、CSV\\n- 导入映射：字段映射\\n\\n**输出结果**：\\n- 导入结果：成功或失败\\n- 成功数量：成功导入数\\n- 失败数量：失败数及原因\\n\\n**业务规则**：\\n- 支持模板下载\\n- 数据格式验证\\n- 失败数据可修正\\n\\n## 3. 非功能需求\\n\\n### 3.1 性能需求\\n\\n- **响应时间**：客户列表加载时间不超过2秒，搜索响应时间不超过1秒\\n- **并发处理**：支持至少100个并发用户同时访问\\n- **数据处理**：支持处理百万级客户数据\\n- **实时性**：客户数据延迟不超过5秒\\n\\n### 3.2 可用性需求\\n\\n- **易用性**：界面简洁直观，操作流程清晰\\n- **可访问性**：支持键盘导航和屏幕阅读器\\n- **多语言**：支持中英文切换\\n- **响应式设计**：支持PC、平板、手机访问\\n\\n### 3.3 安全需求\\n\\n- **数据加密**：敏感数据加密存储\\n- **访问控制**：基于角色的访问控制\\n- **操作审计**：记录所有操作日志\\n- **数据脱敏**：导出数据自动脱敏\\n\\n### 3.4 兼容性需求\\n\\n- **浏览器兼容**：支持Chrome、Firefox、Safari、Edge最新版本\\n- **设备兼容**：支持Windows、macOS、iOS、Android\\n- **分辨率**：支持1920x1080及以上分辨率\\n\\n## 4. 接口设计\\n\\n### 4.1 客户管理接口\\n\\n```typescript\\n// 获取客户列表\\nGET /api/v1/customers\\nQuery Parameters:\\n  - page: number\\n  - limit: number\\n  - search: string\\n  - level: string\\n  - segment: string\\n  - startDate: string\\n  - endDate: string\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"items\\\": [\\n      {\\n        \\\"id\\\": \\\"1\\\",\\n        \\\"name\\\": \\\"张三\\\",\\n        \\\"phone\\\": \\\"13800138000\\\",\\n        \\\"email\\\": \\\"zhangsan@example.com\\\",\\n        \\\"level\\\": \\\"vip\\\",\\n        \\\"points\\\": 5000,\\n        \\\"totalSpent\\\": 10000,\\n        \\\"orderCount\\\": 50,\\n        \\\"lastOrderDate\\\": \\\"2025-01-20T10:00:00Z\\\",\\n        \\\"createdAt\\\": \\\"2024-01-01T10:00:00Z\\\"\\n      }\\n    ],\\n    \\\"pagination\\\": {\\n      \\\"page\\\": 1,\\n      \\\"limit\\\": 20,\\n      \\\"total\\\": 1000,\\n      \\\"totalPages\\\": 50\\n    }\\n  }\\n}\\n\\n// 创建客户\\nPOST /api/v1/customers\\nBody:\\n{\\n  \\\"name\\\": \\\"张三\\\",\\n  \\\"phone\\\": \\\"13800138000\\\",\\n  \\\"email\\\": \\\"zhangsan@example.com\\\",\\n  \\\"gender\\\": \\\"male\\\",\\n  \\\"birthday\\\": \\\"1990-01-01\\\",\\n  \\\"tags\\\": [\\\"美食爱好者\\\"]\\n}\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"id\\\": \\\"1\\\",\\n    \\\"customerNo\\\": \\\"C00001\\\",\\n    \\\"createdAt\\\": \\\"2025-01-20T10:00:00Z\\\"\\n  }\\n}\\n\\n// 更新客户\\nPUT /api/v1/customers/:id\\nBody: 同创建客户\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"id\\\": \\\"1\\\",\\n    \\\"updatedAt\\\": \\\"2025-01-20T11:00:00Z\\\"\\n  }\\n}\\n\\n// 获取客户详情\\nGET /api/v1/customers/:id\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"id\\\": \\\"1\\\",\\n    \\\"profile\\\": {\\n      \\\"name\\\": \\\"张三\\\",\\n      \\\"phone\\\": \\\"13800138000\\\",\\n      \\\"email\\\": \\\"zhangsan@example.com\\\",\\n      \\\"gender\\\": \\\"male\\\",\\n      \\\"birthday\\\": \\\"1990-01-01\\\"\\n    },\\n    \\\"stats\\\": {\\n      \\\"totalSpent\\\": 10000,\\n      \\\"orderCount\\\": 50,\\n      \\\"avgOrderValue\\\": 200,\\n      \\\"points\\\": 5000\\n    },\\n    \\\"tags\\\": [\\\"美食爱好者\\\", \\\"VIP\\\"],\\n    \\\"orders\\\": [],\\n    \\\"communications\\\": []\\n  }\\n}\\n```\\n\\n### 4.2 会员管理接口\\n\\n```typescript\\n// 获取会员等级\\nGET /api/v1/membership/levels\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"levels\\\": [\\n      {\\n        \\\"id\\\": \\\"1\\\",\\n        \\\"name\\\": \\\"普通会员\\\",\\n        \\\"icon\\\": \\\"icon_url\\\",\\n        \\\"upgradeCondition\\\": {\\n          \\\"amount\\\": 0,\\n          \\\"orders\\\": 0\\n        },\\n        \\\"benefits\\\": [\\\"积分1.2倍\\\"]\\n      }\\n    ]\\n  }\\n}\\n\\n// 开通会员\\nPOST /api/v1/membership/enroll\\nBody:\\n{\\n  \\\"customerId\\\": \\\"1\\\",\\n  \\\"levelId\\\": \\\"2\\\",\\n  \\\"duration\\\": 365\\n}\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"membershipId\\\": \\\"1\\\",\\n    \\\"startDate\\\": \\\"2025-01-20\\\",\\n    \\\"endDate\\\": \\\"2026-01-20\\\"\\n  }\\n}\\n\\n// 调整积分\\nPOST /api/v1/membership/points/adjust\\nBody:\\n{\\n  \\\"customerId\\\": \\\"1\\\",\\n  \\\"adjustment\\\": 100,\\n  \\\"reason\\\": \\\"消费奖励\\\"\\n}\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"currentPoints\\\": 5100,\\n    \\\"adjustment\\\": 100\\n  }\\n}\\n```\\n\\n### 4.3 客户分群接口\\n\\n```typescript\\n// 获取客户分群\\nGET /api/v1/customers/segments\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"segments\\\": [\\n      {\\n        \\\"id\\\": \\\"1\\\",\\n        \\\"name\\\": \\\"高价值客户\\\",\\n        \\\"condition\\\": {\\n          \\\"totalSpent\\\": { \\\"gte\\\": 10000 },\\n          \\\"orderCount\\\": { \\\"gte\\\": 10 }\\n        },\\n        \\\"count\\\": 50\\n      }\\n    ]\\n  }\\n}\\n\\n// 创建分群\\nPOST /api/v1/customers/segments\\nBody:\\n{\\n  \\\"name\\\": \\\"新客户\\\",\\n  \\\"condition\\\": {\\n    \\\"createdAt\\\": { \\\"gte\\\": \\\"2025-01-01\\\" }\\n  }\\n}\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"id\\\": \\\"2\\\",\\n    \\\"count\\\": 100\\n  }\\n}\\n```\\n\\n### 4.4 客户画像接口\\n\\n```typescript\\n// 获取客户画像\\nGET /api/v1/customers/:id/profile\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"basicProfile\\\": {\\n      \\\"age\\\": \\\"30-40\\\",\\n      \\\"gender\\\": \\\"male\\\",\\n      \\\"location\\\": \\\"北京\\\",\\n      \\\"occupation\\\": \\\"白领\\\"\\n    },\\n    \\\"consumptionProfile\\\": {\\n      \\\"avgOrderValue\\\": 200,\\n      \\\"frequency\\\": \\\"weekly\\\",\\n      \\\"favoriteCategories\\\": [\\\"川菜\\\", \\\"粤菜\\\"],\\n      \\\"priceRange\\\": \\\"50-100\\\"\\n    },\\n    \\\"behaviorProfile\\\": {\\n      \\\"peakHours\\\": [\\\"12:00-13:00\\\", \\\"18:00-19:00\\\"],\\n      \\\"preferredChannel\\\": \\\"小程序\\\",\\n      \\\"device\\\": \\\"mobile\\\"\\n    },\\n    \\\"tags\\\": [\\\"美食爱好者\\\", \\\"价格敏感\\\", \\\"追求品质\\\"]\\n  }\\n}\\n```\\n\\n### 4.5 流失预警接口\\n\\n```typescript\\n// 获取流失风险客户\\nGET /api/v1/customers/churn-risk\\nQuery Parameters:\\n  - level: string (high, medium, low)\\n  - daysSinceLastOrder: number\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"customers\\\": [\\n      {\\n        \\\"id\\\": \\\"1\\\",\\n        \\\"name\\\": \\\"张三\\\",\\n        \\\"lastOrderDate\\\": \\\"2024-12-01\\\",\\n        \\\"daysSinceLastOrder\\\": 50,\\n        \\\"churnLevel\\\": \\\"high\\\",\\n        \\\"churnProbability\\\": 0.85,\\n        \\\"recommendedActions\\\": [\\\"发送优惠券\\\", \\\"专属客服联系\\\"]\\n      }\\n    ]\\n  }\\n}\\n\\n// 执行挽留\\nPOST /api/v1/customers/:id/retain\\nBody:\\n{\\n  \\\"action\\\": \\\"coupon\\\",\\n  \\\"couponId\\\": \\\"1\\\",\\n  \\\"note\\\": \\\"流失风险客户挽留\\\"\\n}\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"retentionId\\\": \\\"1\\\",\\n    \\\"result\\\": \\\"success\\\"\\n  }\\n}\\n```\\n\\n## 5. 数据模型\\n\\n### 5.1 客户模型\\n\\n```typescript\\ninterface Customer {\\n  id: string;\\n  customerNo: string;\\n  name: string;\\n  phone: string;\\n  email?: string;\\n  gender?: string;\\n  birthday?: string;\\n  avatar?: string;\\n  level: CustomerLevel;\\n  points: number;\\n  totalSpent: number;\\n  orderCount: number;\\n  avgOrderValue: number;\\n  lastOrderDate?: string;\\n  registerDate: string;\\n  tags: string[];\\n  status: CustomerStatus;\\n  source?: string;\\n  createdAt: string;\\n  updatedAt: string;\\n}\\n\\nenum CustomerLevel {\\n  REGULAR = 'regular',\\n  MEMBER = 'member',\\n  VIP = 'vip',\\n  SVIP = 'svip'\\n}\\n\\nenum CustomerStatus {\\n  ACTIVE = 'active',\\n  INACTIVE = 'inactive',\\n  CHURNED = 'churned',\\n  BLOCKED = 'blocked'\\n}\\n```\\n\\n### 5.2 会员模型\\n\\n```typescript\\ninterface Membership {\\n  id: string;\\n  customerId: string;\\n  levelId: string;\\n  startDate: string;\\n  endDate: string;\\n  points: number;\\n  totalSpent: number;\\n  status: MembershipStatus;\\n  createdAt: string;\\n  updatedAt: string;\\n}\\n\\nenum MembershipStatus {\\n  ACTIVE = 'active',\\n  EXPIRED = 'expired',\\n  CANCELLED = 'cancelled'\\n}\\n\\ninterface MembershipLevel {\\n  id: string;\\n  name: string;\\n  icon?: string;\\n  upgradeCondition: {\\n    amount?: number;\\n    orders?: number;\\n    points?: number;\\n  };\\n  benefits: MembershipBenefit[];\\n  sortOrder: number;\\n}\\n\\ninterface MembershipBenefit {\\n  type: string;\\n  value: string;\\n  description: string;\\n}\\n```\\n\\n### 5.3 客户分群模型\\n\\n```typescript\\ninterface CustomerSegment {\\n  id: string;\\n  name: string;\\n  description?: string;\\n  condition: SegmentCondition;\\n  customerCount: number;\\n  createdAt: string;\\n  updatedAt: string;\\n}\\n\\ninterface SegmentCondition {\\n  logicalOperator: 'and' | 'or';\\n  conditions: Condition[];\\n}\\n\\ninterface Condition {\\n  field: string;\\n  operator: 'eq' | 'ne' | 'gt' | 'gte' | 'lt' | 'lte' | 'contains' | 'in';\\n  value: any;\\n}\\n```\\n\\n### 5.4 客户画像模型\\n\\n```typescript\\ninterface CustomerProfile {\\n  customerId: string;\\n  basicProfile: BasicProfile;\\n  consumptionProfile: ConsumptionProfile;\\n  behaviorProfile: BehaviorProfile;\\n  tags: ProfileTag[];\\n  updatedAt: string;\\n}\\n\\ninterface BasicProfile {\\n  age?: string;\\n  gender?: string;\\n  location?: string;\\n  occupation?: string;\\n  income?: string;\\n}\\n\\ninterface ConsumptionProfile {\\n  avgOrderValue: number;\\n  frequency: string;\\n  favoriteCategories: string[];\\n  favoriteDishes: string[];\\n  priceRange: string;\\n  paymentPreferences: string[];\\n}\\n\\ninterface BehaviorProfile {\\n  peakHours: string[];\\n  preferredChannel: string;\\n  device: string;\\n  avgSessionDuration: number;\\n  browsingPattern: string[];\\n}\\n\\ninterface ProfileTag {\\n  name: string;\\n  type: 'auto' | 'manual';\\n  confidence: number;\\n  source?: string;\\n}\\n```\\n\\n## 6. 用户界面设计\\n\\n### 6.1 主界面布局\\n\\n```\\n┌─────────────────────────────────────────────────────────────┐\\n│  客户管理                                              │\\n├─────────────────────────────────────────────────────────────┤\\n│  ┌─────────┐ ┌─────────┐ ┌─────────┐ ┌─────────┐    │\\n│  │ 1,000   │ │ 150     │ │ 50      │ │ 85%     │    │\\n│  │ 总客户  │ │ 新客户  │ │ VIP客户 │ │ 活跃率  │    │\\n│  │ ↑5.2%  │ │ ↑15.3% │ │ ↑8.7%  │ │ ↑3.2%  │    │\\n│  └─────────┘ └─────────┘ └─────────┘ └─────────┘    │\\n├─────────────────────────────────────────────────────────────┤\\n│  [搜索客户...] [等级▼] [分群▼] [日期范围] [+新增客户]  │\\n│  [导出] [分群]                                         │\\n├─────────────────────────────────────────────────────────────┤\\n│  ┌─────────────────────────────────────────────────────┐   │\\n│  │  客户    等级   手机号     消费    订单   最后消费  │   │\\n│  │  张三    VIP   13800138  ¥10,000  50    2025-01-20 │   │\\n│  │  李四    会员  13800138  ¥5,000   30    2025-01-19 │   │\\n│  │  王五    普通  13800138  ¥1,000   10    2025-01-18 │   │\\n│  └─────────────────────────────────────────────────────┘   │\\n│  共 1,000 条记录  [上一页] 1 / 50 [下一页]            │\\n└─────────────────────────────────────────────────────────────┘\\n```\\n\\n### 6.2 客户详情界面\\n\\n```\\n┌─────────────────────────────────────────────────────────────┐\\n│  客户详情 - 张三                                        │\\n├─────────────────────────────────────────────────────────────┤\\n│  [基本信息] [消费记录] [互动记录] [客户画像]           │\\n├─────────────────────────────────────────────────────────────┤\\n│  基本信息                                              │\\n│  ┌─────────────────────────────────────────────────────┐   │\\n│  │  姓名: 张三          等级: VIP                    │   │\\n│  │  手机: 13800138000   积分: 5,000                 │   │\\n│  │  邮箱: zhangsan@example.com                    │   │\\n│  │  性别: 男            注册: 2024-01-01           │   │\\n│  │  生日: 1990-01-01    来源: 线上                │   │\\n│  └─────────────────────────────────────────────────────┘   │\\n├─────────────────────────────────────────────────────────────┤\\n│  消费统计                                              │\\n│  ┌─────────────────────────────────────────────────────┐   │\\n│  │  总消费: ¥10,000    订单数: 50    客单价: ¥200  │   │\\n│  │  活跃度: 高         流失风险: 低               │   │\\n│  │  标签: 美食爱好者、VIP、高价值客户               │   │\\n│  └─────────────────────────────────────────────────────┘   │\\n└─────────────────────────────────────────────────────────────┘\\n```\\n\\n## 7. 测试需求\\n\\n### 7.1 单元测试\\n\\n- 客户CRUD操作测试\\n- 会员升降级测试\\n- 积分计算测试\\n- RFM分级测试\\n- 流失预警测试\\n\\n### 7.2 集成测试\\n\\n- 客户与订单集成测试\\n- 客户与会员集成测试\\n- 分群营销集成测试\\n- 画像更新集成测试\\n\\n### 7.3 性能测试\\n\\n- 大数据量查询测试\\n- 并发访问测试\\n- 画像计算性能测试\\n- 批量操作性能测试\\n\\n### 7.4 用户验收测试\\n\\n- 功能完整性测试\\n- 易用性测试\\n- 兼容性测试\\n- 安全性测试\\n\\n## 8. 部署和维护\\n\\n### 8.1 部署要求\\n\\n- 服务器配置：8核CPU、16GB内存、500GB SSD\\n- 数据库：PostgreSQL 13+\\n- 缓存：Redis 6+\\n\\n### 8.2 监控要求\\n\\n- 系统监控：CPU、内存、磁盘、网络\\n- 应用监控：响应时间、错误率、吞吐量\\n- 业务监控：客户数据准确性、会员权益使用率\\n\\n### 8.3 备份策略\\n\\n- 数据库备份：每日全量备份，每小时增量备份\\n- 配置备份：每次配置变更后备份\\n- 日志备份：每日备份，保留30天\\n\\n### 8.4 维护计划\\n\\n- 定期更新：每月更新客户画像模型\\n- 性能优化：每季度进行性能优化\\n- 安全检查：每周进行安全检查\\n- 功能迭代：根据用户反馈持续优化\\n\\n## 9. 版本历史\\n\\n| 版本 | 日期 | 作者 | 变更说明 |\\n|------|------|------|---------|\\n| 1.0.0 | 2025-01-20 | YYC³ | 初始版本 |\\n\",\"originTextLength\":16938,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768895335514}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/docs/YYC3-Cater-Platform-%E6%96%87%E6%A1%A3%E9%97%AD%E7%8E%AF/YYC3-Cater-%E9%9C%80%E6%B1%82%E8%AE%BE%E8%AE%A1%E6%96%87%E6%A1%A3/%E5%8E%A8%E6%88%BF%E6%98%BE%E7%A4%BA%E5%8A%9F%E8%83%BD%E6%A8%A1%E5%9D%97%E9%9C%80%E6%B1%82%E5%88%86%E6%9E%90%E4%B8%8E%E8%AE%BE%E8%AE%A1%E6%96%87%E6%A1%A3.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":810,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":810,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# 厨房显示功能模块需求分析与设计文档\\\\n\\\\n## 1. 模块概述\\\\n\\\\n### 1.1 模块简介\\\\n\\\\n厨房显示功能模块是YYC³餐饮平台的核心显示系统，为厨房工作人员提供实时的订单信息、任务分配、进度跟踪等功能。该模块通过大屏幕展示，帮助厨房高效管理订单制作，提升出餐效率和客户满意度。\\\\n\\\\n### 1.2 模块目标\\\\n\\\\n- **实时显示**：实时展示订单信息，确保信息及时更新\\\\n- **清晰展示**：通过大屏幕清晰展示，便于厨房查看\\\\n- **任务分配**：自动或手动分配任务到工作站\\\\n- **进度跟踪**：实时跟踪订单制作进度\\\\n- **效率提升**：优化厨房工作流程，提升出餐效率\\\\n- **异常预警**：及时预警异常情况，避免延误\\\\n\\\\n### 1.3 适用范围\\\\n\\\\n- 厨房工作人员：查看订单、制作菜品、更新进度\\\\n- 厨房主管：监控厨房状态、分配任务、处理异常\\\\n- 服务员：查看订单进度、通知客户\\\\n- 餐厅管理者：监控厨房效率、分析数据\\\\n\\\\n## 2. 功能需求\\\\n\\\\n### 2.1 订单显示\\\\n\\\\n#### 2.1.1 订单列表展示\\\\n\\\\n**功能描述**：展示待处理订单列表。\\\\n\\\\n**输入参数**：\\\\n- 筛选条件：订单状态、优先级、订单类型\\\\n- 排序方式：下单时间、优先级、预计完成时间\\\\n- 显示数量：每屏显示订单数\\\\n\\\\n**输出结果**：\\\\n- 订单列表：符合条件的订单列表\\\\n- 订单数量：待处理订单数量\\\\n- 更新时间：最后更新时间\\\\n\\\\n**业务规则**：\\\\n- 实时更新订单状态\\\\n- 新订单自动置顶\\\\n- 支持自动滚动\\\\n- 高亮超时订单\\\\n\\\\n#### 2.1.2 订单详情展示\\\\n\\\\n**功能描述**：展示订单详细信息。\\\\n\\\\n**输入参数**：\\\\n- 订单ID：必填\\\\n\\\\n**输出结果**：\\\\n- 订单信息：订单基本信息\\\\n- 客户信息：客户姓名、特殊要求\\\\n- 菜品信息：菜品列表、数量、备注\\\\n- 制作要求：制作要求、特殊备注\\\\n- 时间信息：下单时间、预计完成时间\\\\n\\\\n**业务规则**：\\\\n- 支持展开/收起详情\\\\n- 特殊要求高亮显示\\\\n- 支持菜品图片显示\\\\n\\\\n#### 2.1.3 订单状态显示\\\\n\\\\n**功能描述**：展示订单制作状态。\\\\n\\\\n**输入参数**：\\\\n- 订单ID：必填\\\\n\\\\n**输出结果**：\\\\n- 订单状态：待处理、制作中、已完成、已出餐\\\\n- 菜品状态：各菜品的制作状态\\\\n- 进度百分比：订单完成进度\\\\n\\\\n**业务规则**：\\\\n- 状态实时更新\\\\n- 进度条可视化\\\\n- 状态颜色区分\\\\n\\\\n#### 2.1.4 订单优先级显示\\\\n\\\\n**功能描述**：展示订单优先级。\\\\n\\\\n**输入参数**：\\\\n- 订单ID：必填\\\\n\\\\n**输出结果**：\\\\n- 优先级标签：高、中、低\\\\n- 优先级颜色：不同颜色区分\\\\n\\\\n**业务规则**：\\\\n- VIP订单高优先级\\\\n- 超时订单自动提升优先级\\\\n- 优先级可手动调整\\\\n\\\\n#### 2.1.5 订单计时显示\\\\n\\\\n**功能描述**：显示订单等待时间。\\\\n\\\\n**输入参数**：\\\\n- 订单ID：必填\\\\n\\\\n**输出结果**：\\\\n- 等待时间：已等待时长\\\\n- 超时预警：是否超时\\\\n- 预计完成时间：预计完成时间\\\\n\\\\n**业务规则**：\\\\n- 实时更新计时\\\\n- 超时订单红色预警\\\\n- 支持倒计时显示\\\\n\\\\n### 2.2 工位显示\\\\n\\\\n#### 2.2.1 工位列表展示\\\\n\\\\n**功能描述**：展示厨房工作站列表。\\\\n\\\\n**输入参数**：\\\\n- 工位类型：热菜、凉菜、面点、饮料等\\\\n- 工位状态：空闲、忙碌、故障\\\\n\\\\n**输出结果**：\\\\n- 工位列表：所有工作站列表\\\\n- 工位状态：各工作站状态\\\\n- 工位任务：当前处理任务\\\\n\\\\n**业务规则**：\\\\n- 工位状态实时更新\\\\n- 故障工位灰色显示\\\\n- 支持工位排序\\\\n\\\\n#### 2.2.2 工位任务分配\\\\n\\\\n**功能描述**：显示工位分配的任务。\\\\n\\\\n**输入参数**：\\\\n- 工位ID：必填\\\\n\\\\n**输出结果**：\\\\n- 任务列表：分配给该工位的任务\\\\n- 任务状态：任务完成状态\\\\n- 任务进度：任务完成进度\\\\n\\\\n**业务规则**：\\\\n- 自动分配任务到合适工位\\\\n- 支持手动调整分配\\\\n- 任务按优先级排序\\\\n\\\\n#### 2.2.3 工位效率显示\\\\n\\\\n**功能描述**：显示工位工作效率。\\\\n\\\\n**输入参数**：\\\\n- 工位ID：必填\\\\n- 时间范围：可选\\\\n\\\\n**输出结果**：\\\\n- 效率指标：完成率、平均时间\\\\n- 效率排名：与其他工位对比\\\\n- 效率趋势：效率变化趋势\\\\n\\\\n**业务规则**：\\\\n- 实时计算效率\\\\n- 低效工位预警\\\\n- 支持效率对比\\\\n\\\\n#### 2.2.4 工位负载显示\\\\n\\\\n**功能描述**：显示工位负载情况。\\\\n\\\\n**输入参数**：\\\\n- 工位ID：必填\\\\n\\\\n**输出结果**：\\\\n- 任务数量：当前任务数\\\\n- 负载率：负载百分比\\\\n- 负载状态：空闲、正常、过载\\\\n\\\\n**业务规则**：\\\\n- 负载实时更新\\\\n- 过载工位红色预警\\\\n- 支持负载均衡\\\\n\\\\n### 2.3 任务管理\\\\n\\\\n#### 2.3.1 任务开始\\\\n\\\\n**功能描述**：开始制作任务。\\\\n\\\\n**输入参数**：\\\\n- 任务ID：必填\\\\n- 操作人员：可选\\\\n\\\\n**输出结果**：\\\\n- 开始时间：任务开始时间\\\\n- 操作状态：成功或失败\\\\n\\\\n**业务规则**：\\\\n- 开始后状态变更为制作中\\\\n- 记录开始时间和操作人\\\\n- 支持批量开始\\\\n\\\\n#### 2.3.2 任务完成\\\\n\\\\n**功能描述**：完成任务制作。\\\\n\\\\n**输入参数**：\\\\n- 任务ID：必填\\\\n- 完成数量：实际完成数量\\\\n- 操作人员：可选\\\\n\\\\n**输出结果**：\\\\n- 完成时间：任务完成时间\\\\n- 操作状态：成功或失败\\\\n\\\\n**业务规则**：\\\\n- 完成后状态变更为已完成\\\\n- 记录完成时间和操作人\\\\n- 支持部分完成\\\\n\\\\n#### 2.3.3 任务暂停\\\\n\\\\n**功能描述**：暂停任务制作。\\\\n\\\\n**输入参数**：\\\\n- 任务ID：必填\\\\n- 暂停原因：必填\\\\n\\\\n**输出结果**：\\\\n- 暂停时间：任务暂停时间\\\\n- 操作状态：成功或失败\\\\n\\\\n**业务规则**：\\\\n- 暂停后状态变更为暂停\\\\n- 记录暂停时间和原因\\\\n- 支持恢复任务\\\\n\\\\n#### 2.3.4 任务取消\\\\n\\\\n**功能描述**：取消任务制作。\\\\n\\\\n**输入参数**：\\\\n- 任务ID：必填\\\\n- 取消原因：必填\\\\n\\\\n**输出结果**：\\\\n- 取消时间：任务取消时间\\\\n- 操作状态：成功或失败\\\\n\\\\n**业务规则**：\\\\n- 取消后状态变更为已取消\\\\n- 记录取消时间和原因\\\\n- 需要权限验证\\\\n\\\\n#### 2.3.5 任务重新分配\\\\n\\\\n**功能描述**：重新分配任务。\\\\n\\\\n**输入参数**：\\\\n- 任务ID：必填\\\\n- 新工位：必填\\\\n- 重新分配原因：可选\\\\n\\\\n**输出结果**：\\\\n- 重新分配时间：重新分配时间\\\\n- 操作状态：成功或失败\\\\n\\\\n**业务规则**：\\\\n- 重新分配后更新任务状态\\\\n- 记录重新分配历史\\\\n- 支持批量重新分配\\\\n\\\\n### 2.4 进度跟踪\\\\n\\\\n#### 2.4.1 制作进度显示\\\\n\\\\n**功能描述**：显示订单制作进度。\\\\n\\\\n**输入参数**：\\\\n- 订单ID：必填\\\\n\\\\n**输出结果**：\\\\n- 总进度：订单整体进度\\\\n- 菜品进度：各菜品制作进度\\\\n- 预计剩余时间：预计剩余时间\\\\n\\\\n**业务规则**：\\\\n- 进度实时更新\\\\n- 进度条可视化\\\\n- 支持进度百分比显示\\\\n\\\\n#### 2.4.2 菜品进度显示\\\\n\\\\n**功能描述**：显示菜品制作进度。\\\\n\\\\n**输入参数**：\\\\n- 订单ID：必填\\\\n- 菜品ID：必填\\\\n\\\\n**输出结果**：\\\\n- 菜品状态：待制作、制作中、已完成\\\\n- 制作进度：制作进度百分比\\\\n- 当前工位：当前制作工位\\\\n\\\\n**业务规则**：\\\\n- 菜品进度独立跟踪\\\\n- 支持菜品图片显示\\\\n- 进度颜色区分\\\\n\\\\n#### 2.4.3 时间预估显示\\\\n\\\\n**功能描述**：预估订单完成时间。\\\\n\\\\n**输入参数**：\\\\n- 订单ID：必填\\\\n\\\\n**输出结果**：\\\\n- 预计完成时间：预计完成时间\\\\n- 剩余时间：剩余时间\\\\n- 时间准确性：预估准确度\\\\n\\\\n**业务规则**：\\\\n- 基于历史数据预估\\\\n- 实时调整预估时间\\\\n- 支持手动调整\\\\n\\\\n### 2.5 语音播报\\\\n\\\\n#### 2.5.1 新订单播报\\\\n\\\\n**功能描述**：语音播报新订单。\\\\n\\\\n**输入参数**：\\\\n- 订单信息：必填\\\\n\\\\n**输出结果**：\\\\n- 播报状态：播报成功或失败\\\\n- 播报内容：播报文本\\\\n\\\\n**业务规则**：\\\\n- 自动播报新订单\\\\n- 播报内容可配置\\\\n- 支持播报音量调节\\\\n\\\\n#### 2.5.2 订单完成播报\\\\n\\\\n**功能描述**：语音播报订单完成。\\\\n\\\\n**输入参数**：\\\\n- 订单信息：必填\\\\n\\\\n**输出结果**：\\\\n- 播报状态：播报成功或失败\\\\n- 播报内容：播报文本\\\\n\\\\n**业务规则**：\\\\n- 自动播报订单完成\\\\n- 支持播报内容自定义\\\\n- 播报间隔可配置\\\\n\\\\n#### 2.5.3 异常播报\\\\n\\\\n**功能描述**：语音播报异常情况。\\\\n\\\\n**输入参数**：\\\\n- 异常信息：必填\\\\n\\\\n**输出结果**：\\\\n- 播报状态：播报成功或失败\\\\n- 播报内容：播报文本\\\\n\\\\n**业务规则**：\\\\n- 自动播报异常情况\\\\n- 异常类型可区分\\\\n- 支持播报频率调节\\\\n\\\\n### 2.6 视图切换\\\\n\\\\n#### 2.6.1 订单视图\\\\n\\\\n**功能描述**：切换到订单视图。\\\\n\\\\n**输入参数**：\\\\n- 无\\\\n\\\\n**输出结果**：\\\\n- 视图切换：切换到订单视图\\\\n- 视图内容：订单列表展示\\\\n\\\\n**业务规则**：\\\\n- 视图状态保存\\\\n- 支持默认视图设置\\\\n- 切换动画流畅\\\\n\\\\n#### 2.6.2 工位视图\\\\n\\\\n**功能描述**：切换到工位视图。\\\\n\\\\n**输入参数**：\\\\n- 无\\\\n\\\\n**输出结果**：\\\\n- 视图切换：切换到工位视图\\\\n- 视图内容：工位列表展示\\\\n\\\\n**业务规则**：\\\\n- 视图状态保存\\\\n- 支持工位排序\\\\n- 工位状态可视化\\\\n\\\\n#### 2.6.3 汇总视图\\\\n\\\\n**功能描述**：切换到汇总视图。\\\\n\\\\n**输入参数**：\\\\n- 无\\\\n\\\\n**输出结果**：\\\\n- 视图切换：切换到汇总视图\\\\n- 视图内容：汇总数据展示\\\\n\\\\n**业务规则**：\\\\n- 汇总数据实时更新\\\\n- 支持多维度汇总\\\\n- 汇总图表可视化\\\\n\\\\n### 2.7 设置管理\\\\n\\\\n#### 2.7.1 显示设置\\\\n\\\\n**功能描述**：配置显示参数。\\\\n\\\\n**输入参数**：\\\\n- 字体大小：小、中、大\\\\n- 显示密度：紧凑、标准、宽松\\\\n- 刷新频率：手动、自动\\\\n- 自动滚动：开启、关闭\\\\n\\\\n**输出结果**：\\\\n- 设置保存：设置保存状态\\\\n- 设置生效：设置立即生效\\\\n\\\\n**业务规则**：\\\\n- 设置可保存\\\\n- 支持默认设置恢复\\\\n- 设置影响全局显示\\\\n\\\\n#### 2.7.2 语音设置\\\\n\\\\n**功能描述**：配置语音播报参数。\\\\n\\\\n**输入参数**：\\\\n- 播报开关：开启、关闭\\\\n- 播报内容：播报内容配置\\\\n- 播报音量：音量大小\\\\n- 播报频率：播报间隔\\\\n\\\\n**输出结果**：\\\\n- 设置保存：设置保存状态\\\\n- 播报测试：播报测试结果\\\\n\\\\n**业务规则**：\\\\n- 支持播报测试\\\\n- 播报内容可自定义\\\\n- 音量可调节\\\\n\\\\n#### 2.7.3 筛选设置\\\\n\\\\n**功能描述**：配置显示筛选条件。\\\\n\\\\n**输入参数**：\\\\n- 显示订单类型：堂食、外卖、自提\\\\n- 显示优先级：高、中、低\\\\n- 显示工位类型：热菜、凉菜等\\\\n\\\\n**输出结果**：\\\\n- 设置保存：设置保存状态\\\\n- 筛选结果：筛选后的显示\\\\n\\\\n**业务规则**：\\\\n- 筛选条件可组合\\\\n- 支持筛选方案保存\\\\n- 筛选实时生效\\\\n\\\\n### 2.8 异常处理\\\\n\\\\n#### 2.8.1 超时预警\\\\n\\\\n**功能描述**：预警订单超时。\\\\n\\\\n**输入参数**：\\\\n- 超时阈值：必填，单位为分钟\\\\n- 预警方式：弹窗、语音、闪烁\\\\n\\\\n**输出结果**：\\\\n- 超时订单：超时订单列表\\\\n- 预警状态：预警触发状态\\\\n\\\\n**业务规则**：\\\\n- 超时订单高亮显示\\\\n- 预警方式可组合\\\\n- 支持阈值调整\\\\n\\\\n#### 2.8.2 缺料预警\\\\n\\\\n**功能描述**：预警物料不足。\\\\n\\\\n**输入参数**：\\\\n- 缺料阈值：必填\\\\n- 预警方式：弹窗、语音\\\\n\\\\n**输出结果**：\\\\n- 缺料信息：缺料物料列表\\\\n- 预警状态：预警触发状态\\\\n\\\\n**业务规则**：\\\\n- 缺料订单暂停制作\\\\n- 支持缺料标记\\\\n- 预警及时通知\\\\n\\\\n#### 2.8.3 设备故障预警\\\\n\\\\n**功能描述**：预警设备故障。\\\\n\\\\n**输入参数**：\\\\n- 故障类型：必填\\\\n- 预警方式：弹窗、语音\\\\n\\\\n**输出结果**：\\\\n- 故障信息：设备故障详情\\\\n- 预警状态：预警触发状态\\\\n\\\\n**业务规则**：\\\\n- 故障工位禁用\\\\n- 支持故障标记\\\\n- 预警及时通知\\\\n\\\\n## 3. 非功能需求\\\\n\\\\n### 3.1 性能需求\\\\n\\\\n- **响应时间**：订单更新延迟不超过2秒\\\\n- **刷新频率**：支持1-60秒刷新频率\\\\n- **并发处理**：支持至少50个并发用户\\\\n- **实时性**：数据延迟不超过3秒\\\\n\\\\n### 3.2 可用性需求\\\\n\\\\n- **易用性**：界面简洁直观，大字体显示\\\\n- **可访问性**：支持语音播报\\\\n- **多语言**：支持中英文切换\\\\n- **响应式设计**：支持不同分辨率大屏\\\\n\\\\n### 3.3 安全需求\\\\n\\\\n- **数据加密**：敏感数据加密传输\\\\n- **访问控制**：基于角色的访问控制\\\\n- **操作审计**：记录所有操作日志\\\\n- **数据备份**：定期备份显示数据\\\\n\\\\n### 3.4 兼容性需求\\\\n\\\\n- **浏览器兼容**：支持Chrome、Firefox、Safari、Edge最新版本\\\\n- **设备兼容**：支持Windows、macOS、Linux\\\\n- **分辨率**：支持1920x1080及以上分辨率\\\\n- **大屏支持**：支持各种尺寸大屏显示\\\\n\\\\n## 4. 接口设计\\\\n\\\\n### 4.1 订单显示接口\\\\n\\\\n```typescript\\\\n// 获取待处理订单\\\\nGET /api/v1/kitchen-display/orders\\\\nQuery Parameters:\\\\n  - status: string (pending, in_progress, ready)\\\\n  - priority: string (high, medium, low)\\\\n  - station: string\\\\n  - limit: number\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"orders\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"id\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n        \\\\\\\"orderNumber\\\\\\\": \\\\\\\"ORD20250120001\\\\\\\",\\\\n        \\\\\\\"customerName\\\\\\\": \\\\\\\"张三\\\\\\\",\\\\n        \\\\\\\"priority\\\\\\\": \\\\\\\"high\\\\\\\",\\\\n        \\\\\\\"status\\\\\\\": \\\\\\\"pending\\\\\\\",\\\\n        \\\\\\\"orderTime\\\\\\\": \\\\\\\"2025-01-20T10:00:00Z\\\\\\\",\\\\n        \\\\\\\"estimatedTime\\\\\\\": \\\\\\\"2025-01-20T10:20:00Z\\\\\\\",\\\\n        \\\\\\\"items\\\\\\\": [\\\\n          {\\\\n            \\\\\\\"id\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n            \\\\\\\"name\\\\\\\": \\\\\\\"宫保鸡丁\\\\\\\",\\\\n            \\\\\\\"quantity\\\\\\\": 1,\\\\n            \\\\\\\"status\\\\\\\": \\\\\\\"pending\\\\\\\",\\\\n            \\\\\\\"specialRequests\\\\\\\": \\\\\\\"少辣\\\\\\\"\\\\n          }\\\\n        ],\\\\n        \\\\\\\"station\\\\\\\": \\\\\\\"热菜\\\\\\\",\\\\n        \\\\\\\"assignedTo\\\\\\\": \\\\\\\"张厨师\\\\\\\"\\\\n      }\\\\n    ],\\\\n    \\\\\\\"pendingCount\\\\\\\": 10,\\\\n    \\\\\\\"inProgressCount\\\\\\\": 5,\\\\n    \\\\\\\"readyCount\\\\\\\": 3\\\\n  }\\\\n}\\\\n\\\\n// 更新订单状态\\\\nPATCH /api/v1/kitchen-display/orders/:id/status\\\\nBody:\\\\n{\\\\n  \\\\\\\"status\\\\\\\": \\\\\\\"in_progress\\\\\\\",\\\\n  \\\\\\\"operatorId\\\\\\\": \\\\\\\"1\\\\\\\"\\\\n}\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"id\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n    \\\\\\\"status\\\\\\\": \\\\\\\"in_progress\\\\\\\",\\\\n    \\\\\\\"updatedAt\\\\\\\": \\\\\\\"2025-01-20T10:05:00Z\\\\\\\"\\\\n  }\\\\n}\\\\n```\\\\n\\\\n### 4.2 工位管理接口\\\\n\\\\n```typescript\\\\n// 获取工位列表\\\\nGET /api/v1/kitchen-display/stations\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"stations\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"id\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n        \\\\\\\"name\\\\\\\": \\\\\\\"热菜\\\\\\\",\\\\n        \\\\\\\"type\\\\\\\": \\\\\\\"hot_dish\\\\\\\",\\\\n        \\\\\\\"status\\\\\\\": \\\\\\\"busy\\\\\\\",\\\\n        \\\\\\\"currentTask\\\\\\\": {\\\\n          \\\\\\\"orderId\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n          \\\\\\\"orderNumber\\\\\\\": \\\\\\\"ORD20250120001\\\\\\\",\\\\n          \\\\\\\"progress\\\\\\\": 50\\\\n        },\\\\n        \\\\\\\"efficiency\\\\\\\": {\\\\n          \\\\\\\"completionRate\\\\\\\": 95,\\\\n          \\\\\\\"avgTime\\\\\\\": 15,\\\\n          \\\\\\\"rank\\\\\\\": 1\\\\n        },\\\\n        \\\\\\\"load\\\\\\\": {\\\\n          \\\\\\\"taskCount\\\\\\\": 3,\\\\n          \\\\\\\"loadRate\\\\\\\": 75,\\\\n          \\\\\\\"status\\\\\\\": \\\\\\\"normal\\\\\\\"\\\\n        }\\\\n      }\\\\n    ]\\\\n  }\\\\n}\\\\n\\\\n// 重新分配任务\\\\nPOST /api/v1/kitchen-display/tasks/:id/reassign\\\\nBody:\\\\n{\\\\n  \\\\\\\"newStationId\\\\\\\": \\\\\\\"2\\\\\\\",\\\\n  \\\\\\\"reason\\\\\\\": \\\\\\\"工位负载过高\\\\\\\"\\\\n}\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"taskId\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n    \\\\\\\"oldStationId\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n    \\\\\\\"newStationId\\\\\\\": \\\\\\\"2\\\\\\\",\\\\n    \\\\\\\"reassignedAt\\\\\\\": \\\\\\\"2025-01-20T10:10:00Z\\\\\\\"\\\\n  }\\\\n}\\\\n```\\\\n\\\\n### 4.3 进度跟踪接口\\\\n\\\\n```typescript\\\\n// 更新菜品进度\\\\nPATCH /api/v1/kitchen-display/orders/:orderId/items/:itemId/progress\\\\nBody:\\\\n{\\\\n  \\\\\\\"progress\\\\\\\": 50,\\\\n  \\\\\\\"operatorId\\\\\\\": \\\\\\\"1\\\\\\\"\\\\n}\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"itemId\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n    \\\\\\\"progress\\\\\\\": 50,\\\\n    \\\\\\\"updatedAt\\\\\\\": \\\\\\\"2025-01-20T10:05:00Z\\\\\\\"\\\\n  }\\\\n}\\\\n\\\\n// 获取订单进度\\\\nGET /api/v1/kitchen-display/orders/:id/progress\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"orderId\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n    \\\\\\\"totalProgress\\\\\\\": 60,\\\\n    \\\\\\\"items\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"itemId\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n        \\\\\\\"name\\\\\\\": \\\\\\\"宫保鸡丁\\\\\\\",\\\\n        \\\\\\\"progress\\\\\\\": 80,\\\\n        \\\\\\\"status\\\\\\\": \\\\\\\"in_progress\\\\\\\",\\\\n        \\\\\\\"currentStation\\\\\\\": \\\\\\\"热菜\\\\\\\"\\\\n      }\\\\n    ],\\\\n    \\\\\\\"estimatedRemainingTime\\\\\\\": 8\\\\n  }\\\\n}\\\\n```\\\\n\\\\n### 4.4 语音播报接口\\\\n\\\\n```typescript\\\\n// 播报新订单\\\\nPOST /api/v1/kitchen-display/announce/new-order\\\\nBody:\\\\n{\\\\n  \\\\\\\"orderId\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n  \\\\\\\"orderNumber\\\\\\\": \\\\\\\"ORD20250120001\\\\\\\",\\\\n  \\\\\\\"content\\\\\\\": \\\\\\\"新订单，订单号ORD20250120001\\\\\\\"\\\\n}\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"announceId\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n    \\\\\\\"announcedAt\\\\\\\": \\\\\\\"2025-01-20T10:00:00Z\\\\\\\"\\\\n  }\\\\n}\\\\n\\\\n// 播报订单完成\\\\nPOST /api/v1/kitchen-display/announce/order-complete\\\\nBody:\\\\n{\\\\n  \\\\\\\"orderId\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n  \\\\\\\"content\\\\\\\": \\\\\\\"订单ORD20250120001已完成\\\\\\\"\\\\n}\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"announceId\\\\\\\": \\\\\\\"2\\\\\\\",\\\\n    \\\\\\\"announcedAt\\\\\\\": \\\\\\\"2025-01-20T10:20:00Z\\\\\\\"\\\\n  }\\\\n}\\\\n```\\\\n\\\\n## 5. 数据模型\\\\n\\\\n### 5.1 订单显示模型\\\\n\\\\n```typescript\\\\ninterface KitchenOrderDisplay {\\\\n  id: string;\\\\n  orderNumber: string;\\\\n  customerName: string;\\\\n  priority: OrderPriority;\\\\n  status: OrderStatus;\\\\n  orderTime: string;\\\\n  estimatedTime: string;\\\\n  actualTime?: string;\\\\n  waitingTime: number;\\\\n  items: KitchenOrderItemDisplay[];\\\\n  station: string;\\\\n  stationId: string;\\\\n  assignedTo?: string;\\\\n  assignedToId?: string;\\\\n  specialRequests?: string;\\\\n  progress: number;\\\\n  isOverdue: boolean;\\\\n  tags: string[];\\\\n}\\\\n\\\\ninterface KitchenOrderItemDisplay {\\\\n  id: string;\\\\n  orderId: string;\\\\n  name: string;\\\\n  nameEn?: string;\\\\n  quantity: number;\\\\n  status: ItemStatus;\\\\n  progress: number;\\\\n  currentStation?: string;\\\\n  specialRequests?: string;\\\\n  imageUrl?: string;\\\\n  preparationTime?: number;\\\\n}\\\\n\\\\nenum OrderPriority {\\\\n  HIGH = \\\\'high\\\\',\\\\n  MEDIUM = \\\\'medium\\\\',\\\\n  LOW = \\\\'low\\\\'\\\\n}\\\\n\\\\nenum OrderStatus {\\\\n  PENDING = \\\\'pending\\\\',\\\\n  IN_PROGRESS = \\\\'in_progress\\\\',\\\\n  READY = \\\\'ready\\\\',\\\\n  COMPLETED = \\\\'completed\\\\',\\\\n  CANCELLED = \\\\'cancelled\\\\'\\\\n}\\\\n\\\\nenum ItemStatus {\\\\n  PENDING = \\\\'pending\\\\',\\\\n  IN_PROGRESS = \\\\'in_progress\\\\',\\\\n  READY = \\\\'ready\\\\',\\\\n  COMPLETED = \\\\'completed\\\\'\\\\n}\\\\n```\\\\n\\\\n### 5.2 工位模型\\\\n\\\\n```typescript\\\\ninterface KitchenStation {\\\\n  id: string;\\\\n  name: string;\\\\n  nameEn?: string;\\\\n  type: StationType;\\\\n  status: StationStatus;\\\\n  location?: string;\\\\n  capacity?: number;\\\\n  currentTask?: CurrentTask;\\\\n  efficiency?: StationEfficiency;\\\\n  load?: StationLoad;\\\\n  createdAt: string;\\\\n  updatedAt: string;\\\\n}\\\\n\\\\nenum StationType {\\\\n  HOT_DISH = \\\\'hot_dish\\\\',\\\\n  COLD_DISH = \\\\'cold_dish\\\\',\\\\n  NOODLE = \\\\'noodle\\\\',\\\\n  DRINK = \\\\'drink\\\\',\\\\n  DESSERT = \\\\'dessert\\\\'\\\\n}\\\\n\\\\nenum StationStatus {\\\\n  IDLE = \\\\'idle\\\\',\\\\n  BUSY = \\\\'busy\\\\',\\\\n  MAINTENANCE = \\\\'maintenance\\\\',\\\\n  OFFLINE = \\\\'offline\\\\'\\\\n}\\\\n\\\\ninterface CurrentTask {\\\\n  orderId: string;\\\\n  orderNumber: string;\\\\n  progress: number;\\\\n  startTime: string;\\\\n  estimatedEndTime: string;\\\\n}\\\\n\\\\ninterface StationEfficiency {\\\\n  completionRate: number;\\\\n  avgPrepTime: number;\\\\n  rank: number;\\\\n  trend: number;\\\\n}\\\\n\\\\ninterface StationLoad {\\\\n  taskCount: number;\\\\n  loadRate: number;\\\\n  status: LoadStatus;\\\\n}\\\\n\\\\nenum LoadStatus {\\\\n  LOW = \\\\'low\\\\',\\\\n  NORMAL = \\\\'normal\\\\',\\\\n  HIGH = \\\\'high\\\\',\\\\n  OVERLOAD = \\\\'overload\\\\'\\\\n}\\\\n```\\\\n\\\\n### 5.3 语音播报模型\\\\n\\\\n```typescript\\\\ninterface VoiceAnnouncement {\\\\n  id: string;\\\\n  type: AnnouncementType;\\\\n  content: string;\\\\n  orderId?: string;\\\\n  orderNumber?: string;\\\\n  announcedAt: string;\\\\n  operatorId?: string;\\\\n  status: AnnouncementStatus;\\\\n}\\\\n\\\\nenum AnnouncementType {\\\\n  NEW_ORDER = \\\\'new_order\\\\',\\\\n  ORDER_COMPLETE = \\\\'order_complete\\\\',\\\\n  ALERT = \\\\'alert\\\\',\\\\n  CUSTOM = \\\\'custom\\\\'\\\\n}\\\\n\\\\nenum AnnouncementStatus {\\\\n  PENDING = \\\\'pending\\\\',\\\\n  ANNOUNCED = \\\\'announced\\\\',\\\\n  FAILED = \\\\'failed\\\\'\\\\n}\\\\n```\\\\n\\\\n## 6. 用户界面设计\\\\n\\\\n### 6.1 订单视图\\\\n\\\\n```\\\\n┌─────────────────────────────────────────────────────────────┐\\\\n│  厨房显示                                              │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  [订单视图] [工位视图] [汇总视图]  [刷新]           │\\\\n│  当前时间: 2025-01-20 10:30:00                    │\\\\n│  待处理: 10  进行中: 5  已完成: 3                    │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  ┌─────────────┐ ┌─────────────┐ ┌─────────────┐    │\\\\n│  │ 订单 #001   │ │ 订单 #002   │ │ 订单 #003   │    │\\\\n│  │ [高优先级]  │ │ [中优先级]  │ │ [低优先级]  │    │\\\\n│  │ 等待: 5分钟 │ │ 等待: 3分钟 │ │ 等待: 2分钟 │    │\\\\n│  │ ─────────────│ │ ─────────────│ │ ─────────────│    │\\\\n│  │ 客户: 张三  │ │ 客户: 李四  │ │ 客户: 王五  │    │\\\\n│  │ ─────────────│ │ ─────────────│ │ ─────────────│    │\\\\n│  │ 宫保鸡丁 ×1  │ │ 麻婆豆腐 ×1  │ │ 糖醋里脊 ×1  │    │\\\\n│  │ [制作中 50%]│ │ [待制作]    │ │ [待制作]    │    │\\\\n│  │ ─────────────│ │ ─────────────│ │ ─────────────│    │\\\\n│  │ [开始制作]   │ │ [开始制作]   │ │ [开始制作]   │    │\\\\n│  └─────────────┘ └─────────────┘ └─────────────┘    │\\\\n└─────────────────────────────────────────────────────────────┘\\\\n```\\\\n\\\\n### 6.2 工位视图\\\\n\\\\n```\\\\n┌─────────────────────────────────────────────────────────────┐\\\\n│  厨房显示 - 工位视图                                  │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  ┌─────────────┐ ┌─────────────┐ ┌─────────────┐    │\\\\n│  │ 热菜工位    │ │ 凉菜工位    │ │ 面点工位    │    │\\\\n│  │ ─────────────│ │ ─────────────│ │ ─────────────│    │\\\\n│  │ 状态: 忙碌  │ │ 状态: 空闲  │ │ 状态: 忙碌  │    │\\\\n│  │ [██████████]│ │ [░░░░░░░░░]│ │ [██████░░░░]│    │\\\\n│  │ ─────────────│ │ ─────────────│ │ ─────────────│    │\\\\n│  │ 当前任务:    │ │ 当前任务:    │ │ 当前任务:    │    │\\\\n│  │ 订单 #001   │ │ 无          │ │ 订单 #003   │    │\\\\n│  │ 进度: 50%   │ │             │ │ 进度: 80%   │    │\\\\n│  │ ─────────────│ │ ─────────────│ │ ─────────────│    │\\\\n│  │ 效率: 95%   │ │ 效率: 92%   │ │ 效率: 88%   │    │\\\\n│  │ 排名: 1     │ │ 排名: 2     │ │ 排名: 3     │    │\\\\n│  │ ─────────────│ │ ─────────────│ │ ─────────────│    │\\\\n│  │ 负载: 正常  │ │ 负载: 低    │ │ 负载: 高    │    │\\\\n│  │ [███████░░░]│ │ [██░░░░░░░░]│ │ [██████████]│    │\\\\n│  └─────────────┘ └─────────────┘ └─────────────┘    │\\\\n└─────────────────────────────────────────────────────────────┘\\\\n```\\\\n\\\\n## 7. 测试需求\\\\n\\\\n### 7.1 单元测试\\\\n\\\\n- 订单显示测试\\\\n- 工位管理测试\\\\n- 任务操作测试\\\\n- 进度跟踪测试\\\\n- 语音播报测试\\\\n\\\\n### 7.2 集成测试\\\\n\\\\n- 订单与工位集成测试\\\\n- 任务与进度集成测试\\\\n- 语音播报集成测试\\\\n- 异常预警集成测试\\\\n\\\\n### 7.3 性能测试\\\\n\\\\n- 实时更新性能测试\\\\n- 大数据量显示测试\\\\n- 并发访问测试\\\\n- 语音播报性能测试\\\\n\\\\n### 7.4 用户验收测试\\\\n\\\\n- 功能完整性测试\\\\n- 易用性测试\\\\n- 大屏显示测试\\\\n- 语音播报测试\\\\n\\\\n## 8. 部署和维护\\\\n\\\\n### 8.1 部署要求\\\\n\\\\n- 显示设备：支持大屏显示（1920x1080及以上）\\\\n- 音频设备：支持语音播报\\\\n- 网络环境：稳定的网络连接\\\\n- 浏览器：支持现代浏览器\\\\n\\\\n### 8.2 监控要求\\\\n\\\\n- 系统监控：CPU、内存、网络\\\\n- 显示监控：显示状态、更新频率\\\\n- 业务监控：订单准确性、出餐及时性\\\\n- 异常监控：超时、缺料、故障\\\\n\\\\n### 8.3 备份策略\\\\n\\\\n- 配置备份：每次配置变更后备份\\\\n- 日志备份：每日备份，保留7天\\\\n- 数据同步：与后台系统实时同步\\\\n\\\\n### 8.4 维护计划\\\\n\\\\n- 定期更新：每月更新显示逻辑\\\\n- 性能优化：每季度进行性能优化\\\\n- 安全检查：每周进行安全检查\\\\n- 功能迭代：根据用户反馈持续优化\\\\n\\\\n## 9. 版本历史\\\\n\\\\n| 版本 | 日期 | 作者 | 变更说明 |\\\\n|------|------|------|---------|\\\\n| 1.0.0 | 2025-01-20 | YYC³ | 初始版本 |\\\\n\",\"originAcceptText\":\"# 厨房显示功能模块需求分析与设计文档\\n\\n## 1. 模块概述\\n\\n### 1.1 模块简介\\n\\n厨房显示功能模块是YYC³餐饮平台的核心显示系统，为厨房工作人员提供实时的订单信息、任务分配、进度跟踪等功能。该模块通过大屏幕展示，帮助厨房高效管理订单制作，提升出餐效率和客户满意度。\\n\\n### 1.2 模块目标\\n\\n- **实时显示**：实时展示订单信息，确保信息及时更新\\n- **清晰展示**：通过大屏幕清晰展示，便于厨房查看\\n- **任务分配**：自动或手动分配任务到工作站\\n- **进度跟踪**：实时跟踪订单制作进度\\n- **效率提升**：优化厨房工作流程，提升出餐效率\\n- **异常预警**：及时预警异常情况，避免延误\\n\\n### 1.3 适用范围\\n\\n- 厨房工作人员：查看订单、制作菜品、更新进度\\n- 厨房主管：监控厨房状态、分配任务、处理异常\\n- 服务员：查看订单进度、通知客户\\n- 餐厅管理者：监控厨房效率、分析数据\\n\\n## 2. 功能需求\\n\\n### 2.1 订单显示\\n\\n#### 2.1.1 订单列表展示\\n\\n**功能描述**：展示待处理订单列表。\\n\\n**输入参数**：\\n- 筛选条件：订单状态、优先级、订单类型\\n- 排序方式：下单时间、优先级、预计完成时间\\n- 显示数量：每屏显示订单数\\n\\n**输出结果**：\\n- 订单列表：符合条件的订单列表\\n- 订单数量：待处理订单数量\\n- 更新时间：最后更新时间\\n\\n**业务规则**：\\n- 实时更新订单状态\\n- 新订单自动置顶\\n- 支持自动滚动\\n- 高亮超时订单\\n\\n#### 2.1.2 订单详情展示\\n\\n**功能描述**：展示订单详细信息。\\n\\n**输入参数**：\\n- 订单ID：必填\\n\\n**输出结果**：\\n- 订单信息：订单基本信息\\n- 客户信息：客户姓名、特殊要求\\n- 菜品信息：菜品列表、数量、备注\\n- 制作要求：制作要求、特殊备注\\n- 时间信息：下单时间、预计完成时间\\n\\n**业务规则**：\\n- 支持展开/收起详情\\n- 特殊要求高亮显示\\n- 支持菜品图片显示\\n\\n#### 2.1.3 订单状态显示\\n\\n**功能描述**：展示订单制作状态。\\n\\n**输入参数**：\\n- 订单ID：必填\\n\\n**输出结果**：\\n- 订单状态：待处理、制作中、已完成、已出餐\\n- 菜品状态：各菜品的制作状态\\n- 进度百分比：订单完成进度\\n\\n**业务规则**：\\n- 状态实时更新\\n- 进度条可视化\\n- 状态颜色区分\\n\\n#### 2.1.4 订单优先级显示\\n\\n**功能描述**：展示订单优先级。\\n\\n**输入参数**：\\n- 订单ID：必填\\n\\n**输出结果**：\\n- 优先级标签：高、中、低\\n- 优先级颜色：不同颜色区分\\n\\n**业务规则**：\\n- VIP订单高优先级\\n- 超时订单自动提升优先级\\n- 优先级可手动调整\\n\\n#### 2.1.5 订单计时显示\\n\\n**功能描述**：显示订单等待时间。\\n\\n**输入参数**：\\n- 订单ID：必填\\n\\n**输出结果**：\\n- 等待时间：已等待时长\\n- 超时预警：是否超时\\n- 预计完成时间：预计完成时间\\n\\n**业务规则**：\\n- 实时更新计时\\n- 超时订单红色预警\\n- 支持倒计时显示\\n\\n### 2.2 工位显示\\n\\n#### 2.2.1 工位列表展示\\n\\n**功能描述**：展示厨房工作站列表。\\n\\n**输入参数**：\\n- 工位类型：热菜、凉菜、面点、饮料等\\n- 工位状态：空闲、忙碌、故障\\n\\n**输出结果**：\\n- 工位列表：所有工作站列表\\n- 工位状态：各工作站状态\\n- 工位任务：当前处理任务\\n\\n**业务规则**：\\n- 工位状态实时更新\\n- 故障工位灰色显示\\n- 支持工位排序\\n\\n#### 2.2.2 工位任务分配\\n\\n**功能描述**：显示工位分配的任务。\\n\\n**输入参数**：\\n- 工位ID：必填\\n\\n**输出结果**：\\n- 任务列表：分配给该工位的任务\\n- 任务状态：任务完成状态\\n- 任务进度：任务完成进度\\n\\n**业务规则**：\\n- 自动分配任务到合适工位\\n- 支持手动调整分配\\n- 任务按优先级排序\\n\\n#### 2.2.3 工位效率显示\\n\\n**功能描述**：显示工位工作效率。\\n\\n**输入参数**：\\n- 工位ID：必填\\n- 时间范围：可选\\n\\n**输出结果**：\\n- 效率指标：完成率、平均时间\\n- 效率排名：与其他工位对比\\n- 效率趋势：效率变化趋势\\n\\n**业务规则**：\\n- 实时计算效率\\n- 低效工位预警\\n- 支持效率对比\\n\\n#### 2.2.4 工位负载显示\\n\\n**功能描述**：显示工位负载情况。\\n\\n**输入参数**：\\n- 工位ID：必填\\n\\n**输出结果**：\\n- 任务数量：当前任务数\\n- 负载率：负载百分比\\n- 负载状态：空闲、正常、过载\\n\\n**业务规则**：\\n- 负载实时更新\\n- 过载工位红色预警\\n- 支持负载均衡\\n\\n### 2.3 任务管理\\n\\n#### 2.3.1 任务开始\\n\\n**功能描述**：开始制作任务。\\n\\n**输入参数**：\\n- 任务ID：必填\\n- 操作人员：可选\\n\\n**输出结果**：\\n- 开始时间：任务开始时间\\n- 操作状态：成功或失败\\n\\n**业务规则**：\\n- 开始后状态变更为制作中\\n- 记录开始时间和操作人\\n- 支持批量开始\\n\\n#### 2.3.2 任务完成\\n\\n**功能描述**：完成任务制作。\\n\\n**输入参数**：\\n- 任务ID：必填\\n- 完成数量：实际完成数量\\n- 操作人员：可选\\n\\n**输出结果**：\\n- 完成时间：任务完成时间\\n- 操作状态：成功或失败\\n\\n**业务规则**：\\n- 完成后状态变更为已完成\\n- 记录完成时间和操作人\\n- 支持部分完成\\n\\n#### 2.3.3 任务暂停\\n\\n**功能描述**：暂停任务制作。\\n\\n**输入参数**：\\n- 任务ID：必填\\n- 暂停原因：必填\\n\\n**输出结果**：\\n- 暂停时间：任务暂停时间\\n- 操作状态：成功或失败\\n\\n**业务规则**：\\n- 暂停后状态变更为暂停\\n- 记录暂停时间和原因\\n- 支持恢复任务\\n\\n#### 2.3.4 任务取消\\n\\n**功能描述**：取消任务制作。\\n\\n**输入参数**：\\n- 任务ID：必填\\n- 取消原因：必填\\n\\n**输出结果**：\\n- 取消时间：任务取消时间\\n- 操作状态：成功或失败\\n\\n**业务规则**：\\n- 取消后状态变更为已取消\\n- 记录取消时间和原因\\n- 需要权限验证\\n\\n#### 2.3.5 任务重新分配\\n\\n**功能描述**：重新分配任务。\\n\\n**输入参数**：\\n- 任务ID：必填\\n- 新工位：必填\\n- 重新分配原因：可选\\n\\n**输出结果**：\\n- 重新分配时间：重新分配时间\\n- 操作状态：成功或失败\\n\\n**业务规则**：\\n- 重新分配后更新任务状态\\n- 记录重新分配历史\\n- 支持批量重新分配\\n\\n### 2.4 进度跟踪\\n\\n#### 2.4.1 制作进度显示\\n\\n**功能描述**：显示订单制作进度。\\n\\n**输入参数**：\\n- 订单ID：必填\\n\\n**输出结果**：\\n- 总进度：订单整体进度\\n- 菜品进度：各菜品制作进度\\n- 预计剩余时间：预计剩余时间\\n\\n**业务规则**：\\n- 进度实时更新\\n- 进度条可视化\\n- 支持进度百分比显示\\n\\n#### 2.4.2 菜品进度显示\\n\\n**功能描述**：显示菜品制作进度。\\n\\n**输入参数**：\\n- 订单ID：必填\\n- 菜品ID：必填\\n\\n**输出结果**：\\n- 菜品状态：待制作、制作中、已完成\\n- 制作进度：制作进度百分比\\n- 当前工位：当前制作工位\\n\\n**业务规则**：\\n- 菜品进度独立跟踪\\n- 支持菜品图片显示\\n- 进度颜色区分\\n\\n#### 2.4.3 时间预估显示\\n\\n**功能描述**：预估订单完成时间。\\n\\n**输入参数**：\\n- 订单ID：必填\\n\\n**输出结果**：\\n- 预计完成时间：预计完成时间\\n- 剩余时间：剩余时间\\n- 时间准确性：预估准确度\\n\\n**业务规则**：\\n- 基于历史数据预估\\n- 实时调整预估时间\\n- 支持手动调整\\n\\n### 2.5 语音播报\\n\\n#### 2.5.1 新订单播报\\n\\n**功能描述**：语音播报新订单。\\n\\n**输入参数**：\\n- 订单信息：必填\\n\\n**输出结果**：\\n- 播报状态：播报成功或失败\\n- 播报内容：播报文本\\n\\n**业务规则**：\\n- 自动播报新订单\\n- 播报内容可配置\\n- 支持播报音量调节\\n\\n#### 2.5.2 订单完成播报\\n\\n**功能描述**：语音播报订单完成。\\n\\n**输入参数**：\\n- 订单信息：必填\\n\\n**输出结果**：\\n- 播报状态：播报成功或失败\\n- 播报内容：播报文本\\n\\n**业务规则**：\\n- 自动播报订单完成\\n- 支持播报内容自定义\\n- 播报间隔可配置\\n\\n#### 2.5.3 异常播报\\n\\n**功能描述**：语音播报异常情况。\\n\\n**输入参数**：\\n- 异常信息：必填\\n\\n**输出结果**：\\n- 播报状态：播报成功或失败\\n- 播报内容：播报文本\\n\\n**业务规则**：\\n- 自动播报异常情况\\n- 异常类型可区分\\n- 支持播报频率调节\\n\\n### 2.6 视图切换\\n\\n#### 2.6.1 订单视图\\n\\n**功能描述**：切换到订单视图。\\n\\n**输入参数**：\\n- 无\\n\\n**输出结果**：\\n- 视图切换：切换到订单视图\\n- 视图内容：订单列表展示\\n\\n**业务规则**：\\n- 视图状态保存\\n- 支持默认视图设置\\n- 切换动画流畅\\n\\n#### 2.6.2 工位视图\\n\\n**功能描述**：切换到工位视图。\\n\\n**输入参数**：\\n- 无\\n\\n**输出结果**：\\n- 视图切换：切换到工位视图\\n- 视图内容：工位列表展示\\n\\n**业务规则**：\\n- 视图状态保存\\n- 支持工位排序\\n- 工位状态可视化\\n\\n#### 2.6.3 汇总视图\\n\\n**功能描述**：切换到汇总视图。\\n\\n**输入参数**：\\n- 无\\n\\n**输出结果**：\\n- 视图切换：切换到汇总视图\\n- 视图内容：汇总数据展示\\n\\n**业务规则**：\\n- 汇总数据实时更新\\n- 支持多维度汇总\\n- 汇总图表可视化\\n\\n### 2.7 设置管理\\n\\n#### 2.7.1 显示设置\\n\\n**功能描述**：配置显示参数。\\n\\n**输入参数**：\\n- 字体大小：小、中、大\\n- 显示密度：紧凑、标准、宽松\\n- 刷新频率：手动、自动\\n- 自动滚动：开启、关闭\\n\\n**输出结果**：\\n- 设置保存：设置保存状态\\n- 设置生效：设置立即生效\\n\\n**业务规则**：\\n- 设置可保存\\n- 支持默认设置恢复\\n- 设置影响全局显示\\n\\n#### 2.7.2 语音设置\\n\\n**功能描述**：配置语音播报参数。\\n\\n**输入参数**：\\n- 播报开关：开启、关闭\\n- 播报内容：播报内容配置\\n- 播报音量：音量大小\\n- 播报频率：播报间隔\\n\\n**输出结果**：\\n- 设置保存：设置保存状态\\n- 播报测试：播报测试结果\\n\\n**业务规则**：\\n- 支持播报测试\\n- 播报内容可自定义\\n- 音量可调节\\n\\n#### 2.7.3 筛选设置\\n\\n**功能描述**：配置显示筛选条件。\\n\\n**输入参数**：\\n- 显示订单类型：堂食、外卖、自提\\n- 显示优先级：高、中、低\\n- 显示工位类型：热菜、凉菜等\\n\\n**输出结果**：\\n- 设置保存：设置保存状态\\n- 筛选结果：筛选后的显示\\n\\n**业务规则**：\\n- 筛选条件可组合\\n- 支持筛选方案保存\\n- 筛选实时生效\\n\\n### 2.8 异常处理\\n\\n#### 2.8.1 超时预警\\n\\n**功能描述**：预警订单超时。\\n\\n**输入参数**：\\n- 超时阈值：必填，单位为分钟\\n- 预警方式：弹窗、语音、闪烁\\n\\n**输出结果**：\\n- 超时订单：超时订单列表\\n- 预警状态：预警触发状态\\n\\n**业务规则**：\\n- 超时订单高亮显示\\n- 预警方式可组合\\n- 支持阈值调整\\n\\n#### 2.8.2 缺料预警\\n\\n**功能描述**：预警物料不足。\\n\\n**输入参数**：\\n- 缺料阈值：必填\\n- 预警方式：弹窗、语音\\n\\n**输出结果**：\\n- 缺料信息：缺料物料列表\\n- 预警状态：预警触发状态\\n\\n**业务规则**：\\n- 缺料订单暂停制作\\n- 支持缺料标记\\n- 预警及时通知\\n\\n#### 2.8.3 设备故障预警\\n\\n**功能描述**：预警设备故障。\\n\\n**输入参数**：\\n- 故障类型：必填\\n- 预警方式：弹窗、语音\\n\\n**输出结果**：\\n- 故障信息：设备故障详情\\n- 预警状态：预警触发状态\\n\\n**业务规则**：\\n- 故障工位禁用\\n- 支持故障标记\\n- 预警及时通知\\n\\n## 3. 非功能需求\\n\\n### 3.1 性能需求\\n\\n- **响应时间**：订单更新延迟不超过2秒\\n- **刷新频率**：支持1-60秒刷新频率\\n- **并发处理**：支持至少50个并发用户\\n- **实时性**：数据延迟不超过3秒\\n\\n### 3.2 可用性需求\\n\\n- **易用性**：界面简洁直观，大字体显示\\n- **可访问性**：支持语音播报\\n- **多语言**：支持中英文切换\\n- **响应式设计**：支持不同分辨率大屏\\n\\n### 3.3 安全需求\\n\\n- **数据加密**：敏感数据加密传输\\n- **访问控制**：基于角色的访问控制\\n- **操作审计**：记录所有操作日志\\n- **数据备份**：定期备份显示数据\\n\\n### 3.4 兼容性需求\\n\\n- **浏览器兼容**：支持Chrome、Firefox、Safari、Edge最新版本\\n- **设备兼容**：支持Windows、macOS、Linux\\n- **分辨率**：支持1920x1080及以上分辨率\\n- **大屏支持**：支持各种尺寸大屏显示\\n\\n## 4. 接口设计\\n\\n### 4.1 订单显示接口\\n\\n```typescript\\n// 获取待处理订单\\nGET /api/v1/kitchen-display/orders\\nQuery Parameters:\\n  - status: string (pending, in_progress, ready)\\n  - priority: string (high, medium, low)\\n  - station: string\\n  - limit: number\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"orders\\\": [\\n      {\\n        \\\"id\\\": \\\"1\\\",\\n        \\\"orderNumber\\\": \\\"ORD20250120001\\\",\\n        \\\"customerName\\\": \\\"张三\\\",\\n        \\\"priority\\\": \\\"high\\\",\\n        \\\"status\\\": \\\"pending\\\",\\n        \\\"orderTime\\\": \\\"2025-01-20T10:00:00Z\\\",\\n        \\\"estimatedTime\\\": \\\"2025-01-20T10:20:00Z\\\",\\n        \\\"items\\\": [\\n          {\\n            \\\"id\\\": \\\"1\\\",\\n            \\\"name\\\": \\\"宫保鸡丁\\\",\\n            \\\"quantity\\\": 1,\\n            \\\"status\\\": \\\"pending\\\",\\n            \\\"specialRequests\\\": \\\"少辣\\\"\\n          }\\n        ],\\n        \\\"station\\\": \\\"热菜\\\",\\n        \\\"assignedTo\\\": \\\"张厨师\\\"\\n      }\\n    ],\\n    \\\"pendingCount\\\": 10,\\n    \\\"inProgressCount\\\": 5,\\n    \\\"readyCount\\\": 3\\n  }\\n}\\n\\n// 更新订单状态\\nPATCH /api/v1/kitchen-display/orders/:id/status\\nBody:\\n{\\n  \\\"status\\\": \\\"in_progress\\\",\\n  \\\"operatorId\\\": \\\"1\\\"\\n}\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"id\\\": \\\"1\\\",\\n    \\\"status\\\": \\\"in_progress\\\",\\n    \\\"updatedAt\\\": \\\"2025-01-20T10:05:00Z\\\"\\n  }\\n}\\n```\\n\\n### 4.2 工位管理接口\\n\\n```typescript\\n// 获取工位列表\\nGET /api/v1/kitchen-display/stations\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"stations\\\": [\\n      {\\n        \\\"id\\\": \\\"1\\\",\\n        \\\"name\\\": \\\"热菜\\\",\\n        \\\"type\\\": \\\"hot_dish\\\",\\n        \\\"status\\\": \\\"busy\\\",\\n        \\\"currentTask\\\": {\\n          \\\"orderId\\\": \\\"1\\\",\\n          \\\"orderNumber\\\": \\\"ORD20250120001\\\",\\n          \\\"progress\\\": 50\\n        },\\n        \\\"efficiency\\\": {\\n          \\\"completionRate\\\": 95,\\n          \\\"avgTime\\\": 15,\\n          \\\"rank\\\": 1\\n        },\\n        \\\"load\\\": {\\n          \\\"taskCount\\\": 3,\\n          \\\"loadRate\\\": 75,\\n          \\\"status\\\": \\\"normal\\\"\\n        }\\n      }\\n    ]\\n  }\\n}\\n\\n// 重新分配任务\\nPOST /api/v1/kitchen-display/tasks/:id/reassign\\nBody:\\n{\\n  \\\"newStationId\\\": \\\"2\\\",\\n  \\\"reason\\\": \\\"工位负载过高\\\"\\n}\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"taskId\\\": \\\"1\\\",\\n    \\\"oldStationId\\\": \\\"1\\\",\\n    \\\"newStationId\\\": \\\"2\\\",\\n    \\\"reassignedAt\\\": \\\"2025-01-20T10:10:00Z\\\"\\n  }\\n}\\n```\\n\\n### 4.3 进度跟踪接口\\n\\n```typescript\\n// 更新菜品进度\\nPATCH /api/v1/kitchen-display/orders/:orderId/items/:itemId/progress\\nBody:\\n{\\n  \\\"progress\\\": 50,\\n  \\\"operatorId\\\": \\\"1\\\"\\n}\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"itemId\\\": \\\"1\\\",\\n    \\\"progress\\\": 50,\\n    \\\"updatedAt\\\": \\\"2025-01-20T10:05:00Z\\\"\\n  }\\n}\\n\\n// 获取订单进度\\nGET /api/v1/kitchen-display/orders/:id/progress\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"orderId\\\": \\\"1\\\",\\n    \\\"totalProgress\\\": 60,\\n    \\\"items\\\": [\\n      {\\n        \\\"itemId\\\": \\\"1\\\",\\n        \\\"name\\\": \\\"宫保鸡丁\\\",\\n        \\\"progress\\\": 80,\\n        \\\"status\\\": \\\"in_progress\\\",\\n        \\\"currentStation\\\": \\\"热菜\\\"\\n      }\\n    ],\\n    \\\"estimatedRemainingTime\\\": 8\\n  }\\n}\\n```\\n\\n### 4.4 语音播报接口\\n\\n```typescript\\n// 播报新订单\\nPOST /api/v1/kitchen-display/announce/new-order\\nBody:\\n{\\n  \\\"orderId\\\": \\\"1\\\",\\n  \\\"orderNumber\\\": \\\"ORD20250120001\\\",\\n  \\\"content\\\": \\\"新订单，订单号ORD20250120001\\\"\\n}\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"announceId\\\": \\\"1\\\",\\n    \\\"announcedAt\\\": \\\"2025-01-20T10:00:00Z\\\"\\n  }\\n}\\n\\n// 播报订单完成\\nPOST /api/v1/kitchen-display/announce/order-complete\\nBody:\\n{\\n  \\\"orderId\\\": \\\"1\\\",\\n  \\\"content\\\": \\\"订单ORD20250120001已完成\\\"\\n}\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"announceId\\\": \\\"2\\\",\\n    \\\"announcedAt\\\": \\\"2025-01-20T10:20:00Z\\\"\\n  }\\n}\\n```\\n\\n## 5. 数据模型\\n\\n### 5.1 订单显示模型\\n\\n```typescript\\ninterface KitchenOrderDisplay {\\n  id: string;\\n  orderNumber: string;\\n  customerName: string;\\n  priority: OrderPriority;\\n  status: OrderStatus;\\n  orderTime: string;\\n  estimatedTime: string;\\n  actualTime?: string;\\n  waitingTime: number;\\n  items: KitchenOrderItemDisplay[];\\n  station: string;\\n  stationId: string;\\n  assignedTo?: string;\\n  assignedToId?: string;\\n  specialRequests?: string;\\n  progress: number;\\n  isOverdue: boolean;\\n  tags: string[];\\n}\\n\\ninterface KitchenOrderItemDisplay {\\n  id: string;\\n  orderId: string;\\n  name: string;\\n  nameEn?: string;\\n  quantity: number;\\n  status: ItemStatus;\\n  progress: number;\\n  currentStation?: string;\\n  specialRequests?: string;\\n  imageUrl?: string;\\n  preparationTime?: number;\\n}\\n\\nenum OrderPriority {\\n  HIGH = 'high',\\n  MEDIUM = 'medium',\\n  LOW = 'low'\\n}\\n\\nenum OrderStatus {\\n  PENDING = 'pending',\\n  IN_PROGRESS = 'in_progress',\\n  READY = 'ready',\\n  COMPLETED = 'completed',\\n  CANCELLED = 'cancelled'\\n}\\n\\nenum ItemStatus {\\n  PENDING = 'pending',\\n  IN_PROGRESS = 'in_progress',\\n  READY = 'ready',\\n  COMPLETED = 'completed'\\n}\\n```\\n\\n### 5.2 工位模型\\n\\n```typescript\\ninterface KitchenStation {\\n  id: string;\\n  name: string;\\n  nameEn?: string;\\n  type: StationType;\\n  status: StationStatus;\\n  location?: string;\\n  capacity?: number;\\n  currentTask?: CurrentTask;\\n  efficiency?: StationEfficiency;\\n  load?: StationLoad;\\n  createdAt: string;\\n  updatedAt: string;\\n}\\n\\nenum StationType {\\n  HOT_DISH = 'hot_dish',\\n  COLD_DISH = 'cold_dish',\\n  NOODLE = 'noodle',\\n  DRINK = 'drink',\\n  DESSERT = 'dessert'\\n}\\n\\nenum StationStatus {\\n  IDLE = 'idle',\\n  BUSY = 'busy',\\n  MAINTENANCE = 'maintenance',\\n  OFFLINE = 'offline'\\n}\\n\\ninterface CurrentTask {\\n  orderId: string;\\n  orderNumber: string;\\n  progress: number;\\n  startTime: string;\\n  estimatedEndTime: string;\\n}\\n\\ninterface StationEfficiency {\\n  completionRate: number;\\n  avgPrepTime: number;\\n  rank: number;\\n  trend: number;\\n}\\n\\ninterface StationLoad {\\n  taskCount: number;\\n  loadRate: number;\\n  status: LoadStatus;\\n}\\n\\nenum LoadStatus {\\n  LOW = 'low',\\n  NORMAL = 'normal',\\n  HIGH = 'high',\\n  OVERLOAD = 'overload'\\n}\\n```\\n\\n### 5.3 语音播报模型\\n\\n```typescript\\ninterface VoiceAnnouncement {\\n  id: string;\\n  type: AnnouncementType;\\n  content: string;\\n  orderId?: string;\\n  orderNumber?: string;\\n  announcedAt: string;\\n  operatorId?: string;\\n  status: AnnouncementStatus;\\n}\\n\\nenum AnnouncementType {\\n  NEW_ORDER = 'new_order',\\n  ORDER_COMPLETE = 'order_complete',\\n  ALERT = 'alert',\\n  CUSTOM = 'custom'\\n}\\n\\nenum AnnouncementStatus {\\n  PENDING = 'pending',\\n  ANNOUNCED = 'announced',\\n  FAILED = 'failed'\\n}\\n```\\n\\n## 6. 用户界面设计\\n\\n### 6.1 订单视图\\n\\n```\\n┌─────────────────────────────────────────────────────────────┐\\n│  厨房显示                                              │\\n├─────────────────────────────────────────────────────────────┤\\n│  [订单视图] [工位视图] [汇总视图]  [刷新]           │\\n│  当前时间: 2025-01-20 10:30:00                    │\\n│  待处理: 10  进行中: 5  已完成: 3                    │\\n├─────────────────────────────────────────────────────────────┤\\n│  ┌─────────────┐ ┌─────────────┐ ┌─────────────┐    │\\n│  │ 订单 #001   │ │ 订单 #002   │ │ 订单 #003   │    │\\n│  │ [高优先级]  │ │ [中优先级]  │ │ [低优先级]  │    │\\n│  │ 等待: 5分钟 │ │ 等待: 3分钟 │ │ 等待: 2分钟 │    │\\n│  │ ─────────────│ │ ─────────────│ │ ─────────────│    │\\n│  │ 客户: 张三  │ │ 客户: 李四  │ │ 客户: 王五  │    │\\n│  │ ─────────────│ │ ─────────────│ │ ─────────────│    │\\n│  │ 宫保鸡丁 ×1  │ │ 麻婆豆腐 ×1  │ │ 糖醋里脊 ×1  │    │\\n│  │ [制作中 50%]│ │ [待制作]    │ │ [待制作]    │    │\\n│  │ ─────────────│ │ ─────────────│ │ ─────────────│    │\\n│  │ [开始制作]   │ │ [开始制作]   │ │ [开始制作]   │    │\\n│  └─────────────┘ └─────────────┘ └─────────────┘    │\\n└─────────────────────────────────────────────────────────────┘\\n```\\n\\n### 6.2 工位视图\\n\\n```\\n┌─────────────────────────────────────────────────────────────┐\\n│  厨房显示 - 工位视图                                  │\\n├─────────────────────────────────────────────────────────────┤\\n│  ┌─────────────┐ ┌─────────────┐ ┌─────────────┐    │\\n│  │ 热菜工位    │ │ 凉菜工位    │ │ 面点工位    │    │\\n│  │ ─────────────│ │ ─────────────│ │ ─────────────│    │\\n│  │ 状态: 忙碌  │ │ 状态: 空闲  │ │ 状态: 忙碌  │    │\\n│  │ [██████████]│ │ [░░░░░░░░░]│ │ [██████░░░░]│    │\\n│  │ ─────────────│ │ ─────────────│ │ ─────────────│    │\\n│  │ 当前任务:    │ │ 当前任务:    │ │ 当前任务:    │    │\\n│  │ 订单 #001   │ │ 无          │ │ 订单 #003   │    │\\n│  │ 进度: 50%   │ │             │ │ 进度: 80%   │    │\\n│  │ ─────────────│ │ ─────────────│ │ ─────────────│    │\\n│  │ 效率: 95%   │ │ 效率: 92%   │ │ 效率: 88%   │    │\\n│  │ 排名: 1     │ │ 排名: 2     │ │ 排名: 3     │    │\\n│  │ ─────────────│ │ ─────────────│ │ ─────────────│    │\\n│  │ 负载: 正常  │ │ 负载: 低    │ │ 负载: 高    │    │\\n│  │ [███████░░░]│ │ [██░░░░░░░░]│ │ [██████████]│    │\\n│  └─────────────┘ └─────────────┘ └─────────────┘    │\\n└─────────────────────────────────────────────────────────────┘\\n```\\n\\n## 7. 测试需求\\n\\n### 7.1 单元测试\\n\\n- 订单显示测试\\n- 工位管理测试\\n- 任务操作测试\\n- 进度跟踪测试\\n- 语音播报测试\\n\\n### 7.2 集成测试\\n\\n- 订单与工位集成测试\\n- 任务与进度集成测试\\n- 语音播报集成测试\\n- 异常预警集成测试\\n\\n### 7.3 性能测试\\n\\n- 实时更新性能测试\\n- 大数据量显示测试\\n- 并发访问测试\\n- 语音播报性能测试\\n\\n### 7.4 用户验收测试\\n\\n- 功能完整性测试\\n- 易用性测试\\n- 大屏显示测试\\n- 语音播报测试\\n\\n## 8. 部署和维护\\n\\n### 8.1 部署要求\\n\\n- 显示设备：支持大屏显示（1920x1080及以上）\\n- 音频设备：支持语音播报\\n- 网络环境：稳定的网络连接\\n- 浏览器：支持现代浏览器\\n\\n### 8.2 监控要求\\n\\n- 系统监控：CPU、内存、网络\\n- 显示监控：显示状态、更新频率\\n- 业务监控：订单准确性、出餐及时性\\n- 异常监控：超时、缺料、故障\\n\\n### 8.3 备份策略\\n\\n- 配置备份：每次配置变更后备份\\n- 日志备份：每日备份，保留7天\\n- 数据同步：与后台系统实时同步\\n\\n### 8.4 维护计划\\n\\n- 定期更新：每月更新显示逻辑\\n- 性能优化：每季度进行性能优化\\n- 安全检查：每周进行安全检查\\n- 功能迭代：根据用户反馈持续优化\\n\\n## 9. 版本历史\\n\\n| 版本 | 日期 | 作者 | 变更说明 |\\n|------|------|------|---------|\\n| 1.0.0 | 2025-01-20 | YYC³ | 初始版本 |\\n\",\"originTextLength\":14325,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768895472532}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/docs/YYC3-Cater-Platform-%E6%96%87%E6%A1%A3%E9%97%AD%E7%8E%AF/YYC3-Cater-%E9%9C%80%E6%B1%82%E8%AE%BE%E8%AE%A1%E6%96%87%E6%A1%A3/%E9%A3%9F%E5%93%81%E5%AE%89%E5%85%A8%E5%8A%9F%E8%83%BD%E6%A8%A1%E5%9D%97%E9%9C%80%E6%B1%82%E5%88%86%E6%9E%90%E4%B8%8E%E8%AE%BE%E8%AE%A1%E6%96%87%E6%A1%A3.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":926,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":926,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# 食品安全管理功能模块需求分析与设计文档\\\\n\\\\n## 1. 模块概述\\\\n\\\\n### 1.1 模块简介\\\\n\\\\n食品安全管理功能模块是YYC³餐饮平台的核心安全管理系统，负责管理餐厅的食材安全、储存安全、卫生检查、安全预警等功能。该模块确保食品从采购到制作的全流程安全，保障客户健康，降低食品安全风险。\\\\n\\\\n### 1.2 模块目标\\\\n\\\\n- **全程监控**：监控食品从采购到制作的全流程安全\\\\n- **风险预警**：及时预警食品安全风险，防止事故发生\\\\n- **合规管理**：确保符合食品安全法规和标准\\\\n- **追溯管理**：建立食品追溯体系，快速定位问题\\\\n- **培训管理**：管理食品安全培训，提升员工安全意识\\\\n- **应急处理**：建立应急处理机制，快速响应食品安全事件\\\\n\\\\n### 1.3 适用范围\\\\n\\\\n- 餐厅管理者：监控食品安全状况，制定安全策略\\\\n- 厨房管理人员：管理食材储存，执行卫生检查\\\\n- 采购人员：管理食材采购，确保食材安全\\\\n- 质检人员：执行质量检查，记录检查结果\\\\n- 监管部门：查看安全记录，监督合规情况\\\\n\\\\n## 2. 功能需求\\\\n\\\\n### 2.1 食材管理\\\\n\\\\n#### 2.1.1 食材录入\\\\n\\\\n**功能描述**：录入新食材信息。\\\\n\\\\n**输入参数**：\\\\n- 食材名称：必填\\\\n- 食材类型：必填，如蔬菜、肉类、水产\\\\n- 供应商：必填\\\\n- 批次号：必填\\\\n- 生产日期：必填\\\\n- 有效期：必填\\\\n- 数量：必填\\\\n- 单位：必填\\\\n- 储存条件：必填，如冷藏、冷冻\\\\n- 检验报告：可选\\\\n\\\\n**输出结果**：\\\\n- 食材ID：系统生成的唯一标识\\\\n- 录入时间：食材录入时间\\\\n- 操作状态：录入成功或失败\\\\n\\\\n**业务规则**：\\\\n- 批次号唯一性校验\\\\n- 有效期必须大于生产日期\\\\n- 支持批量录入\\\\n- 录入记录可追溯\\\\n\\\\n#### 2.1.2 食材编辑\\\\n\\\\n**功能描述**：编辑已有食材信息。\\\\n\\\\n**输入参数**：\\\\n- 食材ID：必填\\\\n- 其他参数：同食材录入\\\\n\\\\n**输出结果**：\\\\n- 更新时间：食材更新时间\\\\n- 修改记录：记录修改历史\\\\n\\\\n**业务规则**：\\\\n- 编辑后自动更新相关记录\\\\n- 修改记录完整保留\\\\n- 支持批量编辑\\\\n\\\\n#### 2.1.3 食材查询\\\\n\\\\n**功能描述**：查询食材信息。\\\\n\\\\n**输入参数**：\\\\n- 搜索关键词：食材名称、批次号\\\\n- 筛选条件：食材类型、供应商、有效期\\\\n- 排序方式：录入时间、有效期\\\\n\\\\n**输出结果**：\\\\n- 食材列表：符合条件的食材列表\\\\n- 结果数量：符合条件的食材数量\\\\n\\\\n**业务规则**：\\\\n- 支持模糊搜索\\\\n- 支持多条件组合查询\\\\n- 即将过期食材高亮显示\\\\n\\\\n#### 2.1.4 食材追溯\\\\n\\\\n**功能描述**：追溯食材来源。\\\\n\\\\n**输入参数**：\\\\n- 食材ID：必填\\\\n- 批次号：可选\\\\n\\\\n**输出结果**：\\\\n- 食材信息：食材基本信息\\\\n- 供应商信息：供应商详细信息\\\\n- 检验记录：检验报告记录\\\\n- 使用记录：食材使用记录\\\\n\\\\n**业务规则**：\\\\n- 完整追溯链条\\\\n- 支持正向和反向追溯\\\\n- 追溯记录可导出\\\\n\\\\n### 2.2 储存管理\\\\n\\\\n#### 2.2.1 储存位置管理\\\\n\\\\n**功能描述**：管理储存位置。\\\\n\\\\n**输入参数**：\\\\n- 位置名称：必填\\\\n- 位置类型：必填，如冷藏库、冷冻库、常温库\\\\n- 温度要求：可选\\\\n- 湿度要求：可选\\\\n- 容量：可选\\\\n- 当前库存：可选\\\\n\\\\n**输出结果**：\\\\n- 位置ID：系统生成的唯一标识\\\\n- 创建时间：位置创建时间\\\\n\\\\n**业务规则**：\\\\n- 位置名称不能重复\\\\n- 支持多级位置\\\\n- 支持位置排序\\\\n\\\\n#### 2.2.2 储存记录\\\\n\\\\n**功能描述**：记录食材储存信息。\\\\n\\\\n**输入参数**：\\\\n- 食材ID：必填\\\\n- 储存位置：必填\\\\n- 储存数量：必填\\\\n- 储存时间：必填\\\\n- 操作人员：可选\\\\n\\\\n**输出结果**：\\\\n- 记录ID：储存记录ID\\\\n- 储存时间：储存时间\\\\n\\\\n**业务规则**：\\\\n- 储存记录完整保留\\\\n- 支持批量储存\\\\n- 储存后更新库存\\\\n\\\\n#### 2.2.3 温度监控\\\\n\\\\n**功能描述**：监控储存温度。\\\\n\\\\n**输入参数**：\\\\n- 储存位置：必填\\\\n- 监控时间：可选\\\\n\\\\n**输出结果**：\\\\n- 温度数据：温度变化记录\\\\n- 温度状态：正常、预警、异常\\\\n- 温度趋势：温度变化趋势\\\\n\\\\n**业务规则**：\\\\n- 实时监控温度\\\\n- 温度异常自动预警\\\\n- 温度数据可追溯\\\\n\\\\n#### 2.2.4 库存预警\\\\n\\\\n**功能描述**：预警库存异常。\\\\n\\\\n**输入参数**：\\\\n- 预警类型：缺货、积压、过期\\\\n- 预警阈值：必填\\\\n- 预警方式：弹窗、短信、邮件\\\\n\\\\n**输出结果**：\\\\n- 预警记录：预警详情\\\\n- 预警状态：预警触发状态\\\\n\\\\n**业务规则**：\\\\n- 自动检测库存异常\\\\n- 预警及时通知\\\\n- 预警记录完整\\\\n\\\\n### 2.3 卫生检查\\\\n\\\\n#### 2.3.1 检查计划\\\\n\\\\n**功能描述**：制定卫生检查计划。\\\\n\\\\n**输入参数**：\\\\n- 检查名称：必填\\\\n- 检查类型：必填，如日常检查、周检查、月检查\\\\n- 检查频率：必填\\\\n- 检查项目：必填\\\\n- 负责人：必填\\\\n- 开始日期：必填\\\\n\\\\n**输出结果**：\\\\n- 计划ID：系统生成的唯一标识\\\\n- 计划状态：计划状态\\\\n\\\\n**业务规则**：\\\\n- 支持检查模板\\\\n- 支持自动生成计划\\\\n- 计划可调整\\\\n\\\\n#### 2.3.2 检查执行\\\\n\\\\n**功能描述**：执行卫生检查。\\\\n\\\\n**输入参数**：\\\\n- 检查计划ID：必填\\\\n- 检查结果：必填\\\\n- 检查图片：可选\\\\n- 检查备注：可选\\\\n- 检查人员：必填\\\\n\\\\n**输出结果**：\\\\n- 检查记录ID：检查记录ID\\\\n- 检查时间：检查时间\\\\n- 检查状态：检查状态\\\\n\\\\n**业务规则**：\\\\n- 检查结果可评分\\\\n- 支持检查图片上传\\\\n- 检查记录完整保留\\\\n\\\\n#### 2.3.3 检查记录\\\\n\\\\n**功能描述**：查看卫生检查记录。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：可选\\\\n- 检查类型：可选\\\\n- 检查结果：可选\\\\n\\\\n**输出结果**：\\\\n- 检查记录：符合条件的检查记录\\\\n- 检查统计：检查统计数据\\\\n\\\\n**业务规则**：\\\\n- 支持多条件筛选\\\\n- 检查记录可导出\\\\n- 检查趋势可分析\\\\n\\\\n#### 2.3.4 问题整改\\\\n\\\\n**功能描述**：记录问题整改情况。\\\\n\\\\n**输入参数**：\\\\n- 检查记录ID：必填\\\\n- 问题列表：必填\\\\n- 整改措施：必填\\\\n- 整改人员：必填\\\\n- 整改时间：必填\\\\n- 整改结果：必填\\\\n\\\\n**输出结果**：\\\\n- 整改记录ID：整改记录ID\\\\n- 整改状态：整改状态\\\\n\\\\n**业务规则**：\\\\n- 整改记录完整保留\\\\n- 支持问题跟踪\\\\n- 整改效果可评估\\\\n\\\\n### 2.4 质量检验\\\\n\\\\n#### 2.4.1 检验计划\\\\n\\\\n**功能描述**：制定质量检验计划。\\\\n\\\\n**输入参数**：\\\\n- 检验名称：必填\\\\n- 检验类型：必填，如入库检验、过程检验、出厂检验\\\\n- 检验标准：必填\\\\n- 检验项目：必填\\\\n- 负责人：必填\\\\n- 检验频率：必填\\\\n\\\\n**输出结果**：\\\\n- 计划ID：系统生成的唯一标识\\\\n- 计划状态：计划状态\\\\n\\\\n**业务规则**：\\\\n- 支持检验模板\\\\n- 支持自动生成计划\\\\n- 计划可调整\\\\n\\\\n#### 2.4.2 检验执行\\\\n\\\\n**功能描述**：执行质量检验。\\\\n\\\\n**输入参数**：\\\\n- 检验计划ID：必填\\\\n- 检验结果：必填\\\\n- 检验数据：必填\\\\n- 检验图片：可选\\\\n- 检验备注：可选\\\\n- 检验人员：必填\\\\n\\\\n**输出结果**：\\\\n- 检验记录ID：检验记录ID\\\\n- 检验时间：检验时间\\\\n- 检验状态：检验状态\\\\n\\\\n**业务规则**：\\\\n- 检验结果可评分\\\\n- 支持检验图片上传\\\\n- 检验记录完整保留\\\\n\\\\n#### 2.4.3 不合格处理\\\\n\\\\n**功能描述**：处理不合格食材。\\\\n\\\\n**输入参数**：\\\\n- 检验记录ID：必填\\\\n- 不合格项目：必填\\\\n- 处理方式：必填，如退货、销毁、降级使用\\\\n- 处理原因：必填\\\\n- 处理人员：必填\\\\n\\\\n**输出结果**：\\\\n- 处理记录ID：处理记录ID\\\\n- 处理时间：处理时间\\\\n- 处理状态：处理状态\\\\n\\\\n**业务规则**：\\\\n- 不合格食材隔离\\\\n- 处理记录完整保留\\\\n- 处理结果可追溯\\\\n\\\\n#### 2.4.4 检验报告\\\\n\\\\n**功能描述**：生成检验报告。\\\\n\\\\n**输入参数**：\\\\n- 检验记录ID：必填\\\\n- 报告格式：可选，如PDF、Excel\\\\n\\\\n**输出结果**：\\\\n- 报告文件：生成的报告文件\\\\n- 报告内容：报告详细内容\\\\n\\\\n**业务规则**：\\\\n- 报告自动生成\\\\n- 报告格式可自定义\\\\n- 报告可导出\\\\n\\\\n### 2.5 安全预警\\\\n\\\\n#### 2.5.1 过期预警\\\\n\\\\n**功能描述**：预警食材过期。\\\\n\\\\n**输入参数**：\\\\n- 预警天数：必填\\\\n- 预警方式：弹窗、短信、邮件\\\\n\\\\n**输出结果**：\\\\n- 预警记录：预警详情\\\\n- 预警状态：预警触发状态\\\\n\\\\n**业务规则**：\\\\n- 自动检测即将过期食材\\\\n- 预警及时通知\\\\n- 预警记录完整\\\\n\\\\n#### 2.5.2 温度异常预警\\\\n\\\\n**功能描述**：预警温度异常。\\\\n\\\\n**输入参数**：\\\\n- 温度范围：必填\\\\n- 异常持续时间：必填\\\\n- 预警方式：弹窗、短信、邮件\\\\n\\\\n**输出结果**：\\\\n- 预警记录：预警详情\\\\n- 预警状态：预警触发状态\\\\n\\\\n**业务规则**：\\\\n- 实时监控温度\\\\n- 温度异常及时预警\\\\n- 预警记录完整\\\\n\\\\n#### 2.5.3 质量异常预警\\\\n\\\\n**功能描述**：预警质量异常。\\\\n\\\\n**输入参数**：\\\\n- 异常类型：必填\\\\n- 异常阈值：必填\\\\n- 预警方式：弹窗、短信、邮件\\\\n\\\\n**输出结果**：\\\\n- 预警记录：预警详情\\\\n- 预警状态：预警触发状态\\\\n\\\\n**业务规则**：\\\\n- 自动检测质量异常\\\\n- 异常及时预警\\\\n- 预警记录完整\\\\n\\\\n#### 2.5.4 合规预警\\\\n\\\\n**功能描述**：预警合规风险。\\\\n\\\\n**输入参数**：\\\\n- 合规类型：必填\\\\n- 合规标准：必填\\\\n- 预警方式：弹窗、短信、邮件\\\\n\\\\n**输出结果**：\\\\n- 预警记录：预警详情\\\\n- 预警状态：预警触发状态\\\\n\\\\n**业务规则**：\\\\n- 自动检测合规风险\\\\n- 风险及时预警\\\\n- 预警记录完整\\\\n\\\\n### 2.6 培训管理\\\\n\\\\n#### 2.6.1 培训计划\\\\n\\\\n**功能描述**：制定安全培训计划。\\\\n\\\\n**输入参数**：\\\\n- 培训名称：必填\\\\n- 培训类型：必填，如入职培训、定期培训、专项培训\\\\n- 培训内容：必填\\\\n- 培训时间：必填\\\\n- 培训人员：必填\\\\n- 培训讲师：必填\\\\n\\\\n**输出结果**：\\\\n- 计划ID：系统生成的唯一标识\\\\n- 计划状态：计划状态\\\\n\\\\n**业务规则**：\\\\n- 支持培训模板\\\\n- 支持自动生成计划\\\\n- 计划可调整\\\\n\\\\n#### 2.6.2 培训执行\\\\n\\\\n**功能描述**：执行安全培训。\\\\n\\\\n**输入参数**：\\\\n- 培训计划ID：必填\\\\n- 培训记录：必填\\\\n- 培训图片：可选\\\\n- 培训备注：可选\\\\n\\\\n**输出结果**：\\\\n- 培训记录ID：培训记录ID\\\\n- 培训时间：培训时间\\\\n- 培训状态：培训状态\\\\n\\\\n**业务规则**：\\\\n- 培训记录完整保留\\\\n- 支持培训签到\\\\n- 培训效果可评估\\\\n\\\\n#### 2.6.3 培训考核\\\\n\\\\n**功能描述**：考核培训效果。\\\\n\\\\n**输入参数**：\\\\n- 培训记录ID：必填\\\\n- 考核方式：必填，如笔试、实操、综合\\\\n- 考核成绩：必填\\\\n- 考核人员：必填\\\\n\\\\n**输出结果**：\\\\n- 考核记录ID：考核记录ID\\\\n- 考核时间：考核时间\\\\n- 考核状态：考核状态\\\\n\\\\n**业务规则**：\\\\n- 考核结果可评分\\\\n- 考核记录完整保留\\\\n- 考核结果可追溯\\\\n\\\\n#### 2.6.4 培训记录\\\\n\\\\n**功能描述**：查看培训记录。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：可选\\\\n- 培训类型：可选\\\\n- 培训人员：可选\\\\n\\\\n**输出结果**：\\\\n- 培训记录：符合条件的培训记录\\\\n- 培训统计：培训统计数据\\\\n\\\\n**业务规则**：\\\\n- 支持多条件筛选\\\\n- 培训记录可导出\\\\n- 培训效果可分析\\\\n\\\\n### 2.7 应急处理\\\\n\\\\n#### 2.7.1 应急预案\\\\n\\\\n**功能描述**：制定食品安全应急预案。\\\\n\\\\n**输入参数**：\\\\n- 预案名称：必填\\\\n- 预案类型：必填，如食材中毒、食材污染、设备故障\\\\n- 预案内容：必填\\\\n- 负责人：必填\\\\n- 联系方式：必填\\\\n\\\\n**输出结果**：\\\\n- 预案ID：系统生成的唯一标识\\\\n- 预案状态：预案状态\\\\n\\\\n**业务规则**：\\\\n- 支持预案模板\\\\n- 预案可定期演练\\\\n- 预案可调整\\\\n\\\\n#### 2.7.2 事件上报\\\\n\\\\n**功能描述**：上报食品安全事件。\\\\n\\\\n**输入参数**：\\\\n- 事件类型：必填\\\\n- 事件描述：必填\\\\n- 发生时间：必填\\\\n- 影响范围：必填\\\\n- 上报人员：必填\\\\n- 处理措施：可选\\\\n\\\\n**输出结果**：\\\\n- 事件ID：系统生成的唯一标识\\\\n- 上报时间：上报时间\\\\n- 事件状态：事件状态\\\\n\\\\n**业务规则**：\\\\n- 事件及时上报\\\\n- 事件记录完整保留\\\\n- 事件处理可跟踪\\\\n\\\\n#### 2.7.3 事件处理\\\\n\\\\n**功能描述**：处理食品安全事件。\\\\n\\\\n**输入参数**：\\\\n- 事件ID：必填\\\\n- 处理措施：必填\\\\n- 处理人员：必填\\\\n- 处理时间：必填\\\\n- 处理结果：必填\\\\n\\\\n**输出结果**：\\\\n- 处理记录ID：处理记录ID\\\\n- 处理时间：处理时间\\\\n- 处理状态：处理状态\\\\n\\\\n**业务规则**：\\\\n- 处理记录完整保留\\\\n- 支持事件跟踪\\\\n- 处理效果可评估\\\\n\\\\n#### 2.7.4 事件报告\\\\n\\\\n**功能描述**：生成事件报告。\\\\n\\\\n**输入参数**：\\\\n- 事件ID：必填\\\\n- 报告格式：可选，如PDF、Excel\\\\n\\\\n**输出结果**：\\\\n- 报告文件：生成的报告文件\\\\n- 报告内容：报告详细内容\\\\n\\\\n**业务规则**：\\\\n- 报告自动生成\\\\n- 报告格式可自定义\\\\n- 报告可导出\\\\n\\\\n### 2.8 合规管理\\\\n\\\\n#### 2.8.1 法规管理\\\\n\\\\n**功能描述**：管理食品安全法规。\\\\n\\\\n**输入参数**：\\\\n- 法规名称：必填\\\\n- 法规类型：必填，如国家法规、行业标准\\\\n- 法规内容：必填\\\\n- 生效日期：必填\\\\n- 废止日期：可选\\\\n\\\\n**输出结果**：\\\\n- 法规ID：系统生成的唯一标识\\\\n- 法规状态：法规状态\\\\n\\\\n**业务规则**：\\\\n- 法规可分类管理\\\\n- 法规可版本管理\\\\n- 法规可搜索\\\\n\\\\n#### 2.8.2 合规检查\\\\n\\\\n**功能描述**：检查合规情况。\\\\n\\\\n**输入参数**：\\\\n- 检查范围：必填\\\\n- 检查标准：必填\\\\n- 检查时间：必填\\\\n\\\\n**输出结果**：\\\\n- 检查结果：合规检查结果\\\\n- 不合规项：不合规项目列表\\\\n- 整改建议：整改建议\\\\n\\\\n**业务规则**：\\\\n- 自动检查合规情况\\\\n- 不合规项自动识别\\\\n- 整改建议可生成\\\\n\\\\n#### 2.8.3 合规报告\\\\n\\\\n**功能描述**：生成合规报告。\\\\n\\\\n**输入参数**：\\\\n- 检查记录ID：必填\\\\n- 报告格式：可选，如PDF、Excel\\\\n\\\\n**输出结果**：\\\\n- 报告文件：生成的报告文件\\\\n- 报告内容：报告详细内容\\\\n\\\\n**业务规则**：\\\\n- 报告自动生成\\\\n- 报告格式可自定义\\\\n- 报告可导出\\\\n\\\\n## 3. 非功能需求\\\\n\\\\n### 3.1 性能需求\\\\n\\\\n- **响应时间**：数据查询响应时间不超过2秒\\\\n- **实时监控**：温度监控延迟不超过5秒\\\\n- **并发处理**：支持至少50个并发用户\\\\n- **数据处理**：支持处理百万级数据\\\\n\\\\n### 3.2 可用性需求\\\\n\\\\n- **易用性**：界面简洁直观，操作流程清晰\\\\n- **可访问性**：支持键盘导航和屏幕阅读器\\\\n- **多语言**：支持中英文切换\\\\n- **响应式设计**：支持PC、平板、手机访问\\\\n\\\\n### 3.3 安全需求\\\\n\\\\n- **数据加密**：敏感数据加密存储\\\\n- **访问控制**：基于角色的访问控制\\\\n- **操作审计**：记录所有操作日志\\\\n- **数据备份**：定期备份安全数据\\\\n\\\\n### 3.4 兼容性需求\\\\n\\\\n- **浏览器兼容**：支持Chrome、Firefox、Safari、Edge最新版本\\\\n- **设备兼容**：支持Windows、macOS、iOS、Android\\\\n- **分辨率**：支持1920x1080及以上分辨率\\\\n\\\\n## 4. 接口设计\\\\n\\\\n### 4.1 食材管理接口\\\\n\\\\n```typescript\\\\n// 获取食材列表\\\\nGET /api/v1/food-safety/ingredients\\\\nQuery Parameters:\\\\n  - page: number\\\\n  - limit: number\\\\n  - type: string\\\\n  - supplier: string\\\\n  - search: string\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"items\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"id\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n        \\\\\\\"name\\\\\\\": \\\\\\\"鸡肉\\\\\\\",\\\\n        \\\\\\\"type\\\\\\\": \\\\\\\"肉类\\\\\\\",\\\\n        \\\\\\\"supplier\\\\\\\": \\\\\\\"供应商A\\\\\\\",\\\\n        \\\\\\\"batchNo\\\\\\\": \\\\\\\"B20250120001\\\\\\\",\\\\n        \\\\\\\"productionDate\\\\\\\": \\\\\\\"2025-01-15\\\\\\\",\\\\n        \\\\\\\"expiryDate\\\\\\\": \\\\\\\"2025-01-25\\\\\\\",\\\\n        \\\\\\\"quantity\\\\\\\": 100,\\\\n        \\\\\\\"unit\\\\\\\": \\\\\\\"kg\\\\\\\",\\\\n        \\\\\\\"storageCondition\\\\\\\": \\\\\\\"冷藏\\\\\\\",\\\\n        \\\\\\\"status\\\\\\\": \\\\\\\"safe\\\\\\\",\\\\n        \\\\\\\"createdAt\\\\\\\": \\\\\\\"2025-01-20T10:00:00Z\\\\\\\"\\\\n      }\\\\n    ],\\\\n    \\\\\\\"pagination\\\\\\\": {\\\\n      \\\\\\\"page\\\\\\\": 1,\\\\n      \\\\\\\"limit\\\\\\\": 20,\\\\n      \\\\\\\"total\\\\\\\": 1000,\\\\n      \\\\\\\"totalPages\\\\\\\": 50\\\\n    }\\\\n  }\\\\n}\\\\n\\\\n// 创建食材\\\\nPOST /api/v1/food-safety/ingredients\\\\nBody:\\\\n{\\\\n  \\\\\\\"name\\\\\\\": \\\\\\\"鸡肉\\\\\\\",\\\\n  \\\\\\\"type\\\\\\\": \\\\\\\"肉类\\\\\\\",\\\\n  \\\\\\\"supplier\\\\\\\": \\\\\\\"供应商A\\\\\\\",\\\\n  \\\\\\\"batchNo\\\\\\\": \\\\\\\"B20250120001\\\\\\\",\\\\n  \\\\\\\"productionDate\\\\\\\": \\\\\\\"2025-01-15\\\\\\\",\\\\n  \\\\\\\"expiryDate\\\\\\\": \\\\\\\"2025-01-25\\\\\\\",\\\\n  \\\\\\\"quantity\\\\\\\": 100,\\\\n  \\\\\\\"unit\\\\\\\": \\\\\\\"kg\\\\\\\",\\\\n  \\\\\\\"storageCondition\\\\\\\": \\\\\\\"冷藏\\\\\\\"\\\\n}\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"id\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n    \\\\\\\"createdAt\\\\\\\": \\\\\\\"2025-01-20T10:00:00Z\\\\\\\"\\\\n  }\\\\n}\\\\n\\\\n// 食材追溯\\\\nGET /api/v1/food-safety/ingredients/:id/trace\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"ingredient\\\\\\\": {\\\\n      \\\\\\\"id\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n      \\\\\\\"name\\\\\\\": \\\\\\\"鸡肉\\\\\\\",\\\\n      \\\\\\\"batchNo\\\\\\\": \\\\\\\"B20250120001\\\\\\\"\\\\n    },\\\\n    \\\\\\\"supplier\\\\\\\": {\\\\n      \\\\\\\"name\\\\\\\": \\\\\\\"供应商A\\\\\\\",\\\\n      \\\\\\\"license\\\\\\\": \\\\\\\"许可证号\\\\\\\",\\\\n      \\\\\\\"contact\\\\\\\": \\\\\\\"联系方式\\\\\\\"\\\\n    },\\\\n    \\\\\\\"inspectionRecords\\\\\\\": [],\\\\n    \\\\\\\"usageRecords\\\\\\\": []\\\\n  }\\\\n}\\\\n```\\\\n\\\\n### 4.2 卫生检查接口\\\\n\\\\n```typescript\\\\n// 获取检查计划\\\\nGET /api/v1/food-safety/hygiene-plans\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"plans\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"id\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n        \\\\\\\"name\\\\\\\": \\\\\\\"日常卫生检查\\\\\\\",\\\\n        \\\\\\\"type\\\\\\\": \\\\\\\"daily\\\\\\\",\\\\n        \\\\\\\"frequency\\\\\\\": \\\\\\\"daily\\\\\\\",\\\\n        \\\\\\\"items\\\\\\\": [\\\\\\\"清洁\\\\\\\", \\\\\\\"消毒\\\\\\\", \\\\\\\"整理\\\\\\\"],\\\\n        \\\\\\\"responsible\\\\\\\": \\\\\\\"张三\\\\\\\",\\\\n        \\\\\\\"startDate\\\\\\\": \\\\\\\"2025-01-01\\\\\\\",\\\\n        \\\\\\\"status\\\\\\\": \\\\\\\"active\\\\\\\"\\\\n      }\\\\n    ]\\\\n  }\\\\n}\\\\n\\\\n// 执行检查\\\\nPOST /api/v1/food-safety/hygiene-inspections\\\\nBody:\\\\n{\\\\n  \\\\\\\"planId\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n  \\\\\\\"result\\\\\\\": \\\\\\\"pass\\\\\\\",\\\\n  \\\\\\\"score\\\\\\\": 95,\\\\n  \\\\\\\"images\\\\\\\": [\\\\\\\"url1\\\\\\\", \\\\\\\"url2\\\\\\\"],\\\\n  \\\\\\\"notes\\\\\\\": \\\\\\\"检查结果良好\\\\\\\",\\\\n  \\\\\\\"inspector\\\\\\\": \\\\\\\"张三\\\\\\\"\\\\n}\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"id\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n    \\\\\\\"inspectedAt\\\\\\\": \\\\\\\"2025-01-20T10:00:00Z\\\\\\\"\\\\n  }\\\\n}\\\\n\\\\n// 问题整改\\\\nPOST /api/v1/food-safety/hygiene-inspections/:id/rectification\\\\nBody:\\\\n{\\\\n  \\\\\\\"issues\\\\\\\": [\\\\n    {\\\\n      \\\\\\\"description\\\\\\\": \\\\\\\"清洁不彻底\\\\\\\",\\\\n      \\\\\\\"severity\\\\\\\": \\\\\\\"medium\\\\\\\"\\\\n    }\\\\n  ],\\\\n  \\\\\\\"measures\\\\\\\": \\\\\\\"加强清洁\\\\\\\",\\\\n  \\\\\\\"responsible\\\\\\\": \\\\\\\"李四\\\\\\\",\\\\n  \\\\\\\"result\\\\\\\": \\\\\\\"resolved\\\\\\\"\\\\n}\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"id\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n    \\\\\\\"rectifiedAt\\\\\\\": \\\\\\\"2025-01-20T14:00:00Z\\\\\\\"\\\\n  }\\\\n}\\\\n```\\\\n\\\\n### 4.3 安全预警接口\\\\n\\\\n```typescript\\\\n// 获取预警记录\\\\nGET /api/v1/food-safety/alerts\\\\nQuery Parameters:\\\\n  - type: string (expiry, temperature, quality, compliance)\\\\n  - status: string (active, resolved, all)\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"alerts\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"id\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n        \\\\\\\"type\\\\\\\": \\\\\\\"expiry\\\\\\\",\\\\n        \\\\\\\"severity\\\\\\\": \\\\\\\"high\\\\\\\",\\\\n        \\\\\\\"message\\\\\\\": \\\\\\\"鸡肉即将过期\\\\\\\",\\\\n        \\\\\\\"ingredientId\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n        \\\\\\\"ingredientName\\\\\\\": \\\\\\\"鸡肉\\\\\\\",\\\\n        \\\\\\\"expiryDate\\\\\\\": \\\\\\\"2025-01-25\\\\\\\",\\\\n        \\\\\\\"daysToExpiry\\\\\\\": 5,\\\\n        \\\\\\\"timestamp\\\\\\\": \\\\\\\"2025-01-20T10:00:00Z\\\\\\\",\\\\n        \\\\\\\"status\\\\\\\": \\\\\\\"active\\\\\\\"\\\\n      }\\\\n    ]\\\\n  }\\\\n}\\\\n\\\\n// 更新预警状态\\\\nPATCH /api/v1/food-safety/alerts/:id\\\\nBody:\\\\n{\\\\n  \\\\\\\"status\\\\\\\": \\\\\\\"resolved\\\\\\\",\\\\n  \\\\\\\"note\\\\\\\": \\\\\\\"已处理\\\\\\\"\\\\n}\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"message\\\\\\\": \\\\\\\"预警状态更新成功\\\\\\\"\\\\n}\\\\n```\\\\n\\\\n## 5. 数据模型\\\\n\\\\n### 5.1 食材模型\\\\n\\\\n```typescript\\\\ninterface Ingredient {\\\\n  id: string;\\\\n  name: string;\\\\n  nameEn?: string;\\\\n  type: IngredientType;\\\\n  supplier: string;\\\\n  supplierId: string;\\\\n  batchNo: string;\\\\n  productionDate: string;\\\\n  expiryDate: string;\\\\n  quantity: number;\\\\n  unit: string;\\\\n  storageCondition: StorageCondition;\\\\n  storageLocation?: string;\\\\n  inspectionReport?: string;\\\\n  status: IngredientStatus;\\\\n  createdAt: string;\\\\n  updatedAt: string;\\\\n}\\\\n\\\\nenum IngredientType {\\\\n  VEGETABLE = \\\\'vegetable\\\\',\\\\n  MEAT = \\\\'meat\\\\',\\\\n  AQUATIC = \\\\'aquatic\\\\',\\\\n  GRAIN = \\\\'grain\\\\',\\\\n  SPICE = \\\\'spice\\\\',\\\\n  OTHER = \\\\'other\\\\'\\\\n}\\\\n\\\\nenum StorageCondition {\\\\n  REFRIGERATED = \\\\'refrigerated\\\\',\\\\n  FROZEN = \\\\'frozen\\\\',\\\\n  ROOM_TEMPERATURE = \\\\'room_temperature\\\\',\\\\n  VACUUM = \\\\'vacuum\\\\'\\\\n}\\\\n\\\\nenum IngredientStatus {\\\\n  SAFE = \\\\'safe\\\\',\\\\n  EXPIRING = \\\\'expiring\\\\',\\\\n  EXPIRED = \\\\'expired\\\\',\\\\n  QUARANTINED = \\\\'quarantined\\\\',\\\\n  DISPOSED = \\\\'disposed\\\\'\\\\n}\\\\n```\\\\n\\\\n### 5.2 卫生检查模型\\\\n\\\\n```typescript\\\\ninterface HygienePlan {\\\\n  id: string;\\\\n  name: string;\\\\n  type: InspectionType;\\\\n  frequency: InspectionFrequency;\\\\n  items: string[];\\\\n  responsible: string;\\\\n  responsibleId: string;\\\\n  startDate: string;\\\\n  status: PlanStatus;\\\\n  createdAt: string;\\\\n  updatedAt: string;\\\\n}\\\\n\\\\ninterface HygieneInspection {\\\\n  id: string;\\\\n  planId: string;\\\\n  planName: string;\\\\n  result: InspectionResult;\\\\n  score?: number;\\\\n  images: string[];\\\\n  notes?: string;\\\\n  inspector: string;\\\\n  inspectorId: string;\\\\n  inspectedAt: string;\\\\n  issues: InspectionIssue[];\\\\n  rectifications: Rectification[];\\\\n  createdAt: string;\\\\n}\\\\n\\\\ninterface InspectionIssue {\\\\n  id: string;\\\\n  description: string;\\\\n  severity: IssueSeverity;\\\\n  status: IssueStatus;\\\\n}\\\\n\\\\ninterface Rectification {\\\\n  id: string;\\\\n  issueId: string;\\\\n  measures: string;\\\\n  responsible: string;\\\\n  responsibleId: string;\\\\n  rectifiedAt: string;\\\\n  result: string;\\\\n}\\\\n\\\\nenum InspectionType {\\\\n  DAILY = \\\\'daily\\\\',\\\\n  WEEKLY = \\\\'weekly\\\\',\\\\n  MONTHLY = \\\\'monthly\\\\',\\\\n  SPECIAL = \\\\'special\\\\'\\\\n}\\\\n\\\\nenum InspectionFrequency {\\\\n  DAILY = \\\\'daily\\\\',\\\\n  WEEKLY = \\\\'weekly\\\\',\\\\n  MONTHLY = \\\\'monthly\\\\',\\\\n  QUARTERLY = \\\\'quarterly\\\\'\\\\n}\\\\n\\\\nenum InspectionResult {\\\\n  PASS = \\\\'pass\\\\',\\\\n  FAIL = \\\\'fail\\\\',\\\\n  CONDITIONAL_PASS = \\\\'conditional_pass\\\\'\\\\n}\\\\n\\\\nenum IssueSeverity {\\\\n  LOW = \\\\'low\\\\',\\\\n  MEDIUM = \\\\'medium\\\\',\\\\n  HIGH = \\\\'high\\\\',\\\\n  CRITICAL = \\\\'critical\\\\'\\\\n}\\\\n\\\\nenum IssueStatus {\\\\n  PENDING = \\\\'pending\\\\',\\\\n  IN_PROGRESS = \\\\'in_progress\\\\',\\\\n  RESOLVED = \\\\'resolved\\\\'\\\\n}\\\\n```\\\\n\\\\n### 5.3 安全预警模型\\\\n\\\\n```typescript\\\\ninterface SafetyAlert {\\\\n  id: string;\\\\n  type: AlertType;\\\\n  severity: AlertSeverity;\\\\n  message: string;\\\\n  ingredientId?: string;\\\\n  ingredientName?: string;\\\\n  storageLocationId?: string;\\\\n  storageLocationName?: string;\\\\n  expiryDate?: string;\\\\n  daysToExpiry?: number;\\\\n  temperature?: number;\\\\n  temperatureRange?: string;\\\\n  timestamp: string;\\\\n  status: AlertStatus;\\\\n  resolvedAt?: string;\\\\n  resolvedBy?: string;\\\\n  note?: string;\\\\n}\\\\n\\\\nenum AlertType {\\\\n  EXPIRY = \\\\'expiry\\\\',\\\\n  TEMPERATURE = \\\\'temperature\\\\',\\\\n  QUALITY = \\\\'quality\\\\',\\\\n  COMPLIANCE = \\\\'compliance\\\\',\\\\n  STOCK = \\\\'stock\\\\'\\\\n}\\\\n\\\\nenum AlertSeverity {\\\\n  LOW = \\\\'low\\\\',\\\\n  MEDIUM = \\\\'medium\\\\',\\\\n  HIGH = \\\\'high\\\\',\\\\n  CRITICAL = \\\\'critical\\\\'\\\\n}\\\\n\\\\nenum AlertStatus {\\\\n  ACTIVE = \\\\'active\\\\',\\\\n  RESOLVED = \\\\'resolved\\\\',\\\\n  DISMISSED = \\\\'dismissed\\\\'\\\\n}\\\\n```\\\\n\\\\n## 6. 用户界面设计\\\\n\\\\n### 6.1 主界面布局\\\\n\\\\n```\\\\n┌─────────────────────────────────────────────────────────────┐\\\\n│  食品安全管理                                          │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  [总览] [食材管理] [储存管理] [检查记录] [告警管理]  │\\\\n│  [+新增记录]                                         │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  ┌─────────┐ ┌─────────┐ ┌─────────┐ ┌─────────┐    │\\\\n│  │ 1,200   │ │ 50      │ │ 95%     │ │ 3       │    │\\\\n│  │ 安全食材│ │ 即将过期│ │ 合格率  │ │ 告警    │    │\\\\n│  │ ↑2.5%  │ │ ↓5.2%   │ │ ↑1.8%  │ │ ↓2.1%   │    │\\\\n│  └─────────┘ └─────────┘ └─────────┘ └─────────┘    │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  ┌─────────────────────────────────────────────────────┐   │\\\\n│  │  食材    类型    批次号    有效期    状态    操作    │   │\\\\n│  │  鸡肉    肉类    B2025012  2025-01-25 安全  [编辑][删除]│   │\\\\n│  │  牛肉    肉类    B2025013  2025-01-28 安全  [编辑][删除]│   │\\\\n│  │  蔬菜    蔬菜    B2025014  2025-01-22 预警  [编辑][删除]│   │\\\\n│  └─────────────────────────────────────────────────────┘   │\\\\n│  共 1,200 条记录  [上一页] 1 / 60 [下一页]            │\\\\n└─────────────────────────────────────────────────────────────┘\\\\n```\\\\n\\\\n### 6.2 检查记录界面\\\\n\\\\n```\\\\n┌─────────────────────────────────────────────────────────────┐\\\\n│  卫生检查记录                                          │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  [日常检查] [周检查] [月检查] [专项检查]            │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  ┌─────────────────────────────────────────────────────┐   │\\\\n│  │  检查时间    检查类型    结果    评分    操作    │   │\\\\n│  │  2025-01-20  日常检查    合格    95     [详情]  │   │\\\\n│  │  2025-01-19  日常检查    合格    92     [详情]  │   │\\\\n│  │  2025-01-18  日常检查    不合格  78     [详情]  │   │\\\\n│  └─────────────────────────────────────────────────────┘   │\\\\n│  共 100 条记录  [上一页] 1 / 10 [下一页]              │\\\\n└─────────────────────────────────────────────────────────────┘\\\\n```\\\\n\\\\n## 7. 测试需求\\\\n\\\\n### 7.1 单元测试\\\\n\\\\n- 食材CRUD操作测试\\\\n- 储存管理测试\\\\n- 卫生检查测试\\\\n- 质量检验测试\\\\n- 安全预警测试\\\\n\\\\n### 7.2 集成测试\\\\n\\\\n- 食材与储存集成测试\\\\n- 检查与整改集成测试\\\\n- 预警与通知集成测试\\\\n- 合规检查集成测试\\\\n\\\\n### 7.3 性能测试\\\\n\\\\n- 大数据量查询测试\\\\n- 实时监控性能测试\\\\n- 并发访问测试\\\\n- 预警响应时间测试\\\\n\\\\n### 7.4 用户验收测试\\\\n\\\\n- 功能完整性测试\\\\n- 易用性测试\\\\n- 兼容性测试\\\\n- 安全性测试\\\\n\\\\n## 8. 部署和维护\\\\n\\\\n### 8.1 部署要求\\\\n\\\\n- 服务器配置：4核CPU、8GB内存、200GB SSD\\\\n- 温度监控设备：支持温度传感器接入\\\\n- 数据库：PostgreSQL 13+\\\\n- 缓存：Redis 6+\\\\n\\\\n### 8.2 监控要求\\\\n\\\\n- 系统监控：CPU、内存、磁盘、网络\\\\n- 应用监控：响应时间、错误率、吞吐量\\\\n- 业务监控：食材数据准确性、温度监控及时性、预警响应速度\\\\n\\\\n### 8.3 备份策略\\\\n\\\\n- 数据库备份：每日全量备份，每小时增量备份\\\\n- 检查记录备份：每日备份，保留90天\\\\n- 配置备份：每次配置变更后备份\\\\n\\\\n### 8.4 维护计划\\\\n\\\\n- 定期更新：每月更新安全标准\\\\n- 性能优化：每季度进行性能优化\\\\n- 安全检查：每周进行安全检查\\\\n- 功能迭代：根据用户反馈持续优化\\\\n\\\\n## 9. 版本历史\\\\n\\\\n| 版本 | 日期 | 作者 | 变更说明 |\\\\n|------|------|------|---------|\\\\n| 1.0.0 | 2025-01-20 | YYC³ | 初始版本 |\\\\n\",\"originAcceptText\":\"# 食品安全管理功能模块需求分析与设计文档\\n\\n## 1. 模块概述\\n\\n### 1.1 模块简介\\n\\n食品安全管理功能模块是YYC³餐饮平台的核心安全管理系统，负责管理餐厅的食材安全、储存安全、卫生检查、安全预警等功能。该模块确保食品从采购到制作的全流程安全，保障客户健康，降低食品安全风险。\\n\\n### 1.2 模块目标\\n\\n- **全程监控**：监控食品从采购到制作的全流程安全\\n- **风险预警**：及时预警食品安全风险，防止事故发生\\n- **合规管理**：确保符合食品安全法规和标准\\n- **追溯管理**：建立食品追溯体系，快速定位问题\\n- **培训管理**：管理食品安全培训，提升员工安全意识\\n- **应急处理**：建立应急处理机制，快速响应食品安全事件\\n\\n### 1.3 适用范围\\n\\n- 餐厅管理者：监控食品安全状况，制定安全策略\\n- 厨房管理人员：管理食材储存，执行卫生检查\\n- 采购人员：管理食材采购，确保食材安全\\n- 质检人员：执行质量检查，记录检查结果\\n- 监管部门：查看安全记录，监督合规情况\\n\\n## 2. 功能需求\\n\\n### 2.1 食材管理\\n\\n#### 2.1.1 食材录入\\n\\n**功能描述**：录入新食材信息。\\n\\n**输入参数**：\\n- 食材名称：必填\\n- 食材类型：必填，如蔬菜、肉类、水产\\n- 供应商：必填\\n- 批次号：必填\\n- 生产日期：必填\\n- 有效期：必填\\n- 数量：必填\\n- 单位：必填\\n- 储存条件：必填，如冷藏、冷冻\\n- 检验报告：可选\\n\\n**输出结果**：\\n- 食材ID：系统生成的唯一标识\\n- 录入时间：食材录入时间\\n- 操作状态：录入成功或失败\\n\\n**业务规则**：\\n- 批次号唯一性校验\\n- 有效期必须大于生产日期\\n- 支持批量录入\\n- 录入记录可追溯\\n\\n#### 2.1.2 食材编辑\\n\\n**功能描述**：编辑已有食材信息。\\n\\n**输入参数**：\\n- 食材ID：必填\\n- 其他参数：同食材录入\\n\\n**输出结果**：\\n- 更新时间：食材更新时间\\n- 修改记录：记录修改历史\\n\\n**业务规则**：\\n- 编辑后自动更新相关记录\\n- 修改记录完整保留\\n- 支持批量编辑\\n\\n#### 2.1.3 食材查询\\n\\n**功能描述**：查询食材信息。\\n\\n**输入参数**：\\n- 搜索关键词：食材名称、批次号\\n- 筛选条件：食材类型、供应商、有效期\\n- 排序方式：录入时间、有效期\\n\\n**输出结果**：\\n- 食材列表：符合条件的食材列表\\n- 结果数量：符合条件的食材数量\\n\\n**业务规则**：\\n- 支持模糊搜索\\n- 支持多条件组合查询\\n- 即将过期食材高亮显示\\n\\n#### 2.1.4 食材追溯\\n\\n**功能描述**：追溯食材来源。\\n\\n**输入参数**：\\n- 食材ID：必填\\n- 批次号：可选\\n\\n**输出结果**：\\n- 食材信息：食材基本信息\\n- 供应商信息：供应商详细信息\\n- 检验记录：检验报告记录\\n- 使用记录：食材使用记录\\n\\n**业务规则**：\\n- 完整追溯链条\\n- 支持正向和反向追溯\\n- 追溯记录可导出\\n\\n### 2.2 储存管理\\n\\n#### 2.2.1 储存位置管理\\n\\n**功能描述**：管理储存位置。\\n\\n**输入参数**：\\n- 位置名称：必填\\n- 位置类型：必填，如冷藏库、冷冻库、常温库\\n- 温度要求：可选\\n- 湿度要求：可选\\n- 容量：可选\\n- 当前库存：可选\\n\\n**输出结果**：\\n- 位置ID：系统生成的唯一标识\\n- 创建时间：位置创建时间\\n\\n**业务规则**：\\n- 位置名称不能重复\\n- 支持多级位置\\n- 支持位置排序\\n\\n#### 2.2.2 储存记录\\n\\n**功能描述**：记录食材储存信息。\\n\\n**输入参数**：\\n- 食材ID：必填\\n- 储存位置：必填\\n- 储存数量：必填\\n- 储存时间：必填\\n- 操作人员：可选\\n\\n**输出结果**：\\n- 记录ID：储存记录ID\\n- 储存时间：储存时间\\n\\n**业务规则**：\\n- 储存记录完整保留\\n- 支持批量储存\\n- 储存后更新库存\\n\\n#### 2.2.3 温度监控\\n\\n**功能描述**：监控储存温度。\\n\\n**输入参数**：\\n- 储存位置：必填\\n- 监控时间：可选\\n\\n**输出结果**：\\n- 温度数据：温度变化记录\\n- 温度状态：正常、预警、异常\\n- 温度趋势：温度变化趋势\\n\\n**业务规则**：\\n- 实时监控温度\\n- 温度异常自动预警\\n- 温度数据可追溯\\n\\n#### 2.2.4 库存预警\\n\\n**功能描述**：预警库存异常。\\n\\n**输入参数**：\\n- 预警类型：缺货、积压、过期\\n- 预警阈值：必填\\n- 预警方式：弹窗、短信、邮件\\n\\n**输出结果**：\\n- 预警记录：预警详情\\n- 预警状态：预警触发状态\\n\\n**业务规则**：\\n- 自动检测库存异常\\n- 预警及时通知\\n- 预警记录完整\\n\\n### 2.3 卫生检查\\n\\n#### 2.3.1 检查计划\\n\\n**功能描述**：制定卫生检查计划。\\n\\n**输入参数**：\\n- 检查名称：必填\\n- 检查类型：必填，如日常检查、周检查、月检查\\n- 检查频率：必填\\n- 检查项目：必填\\n- 负责人：必填\\n- 开始日期：必填\\n\\n**输出结果**：\\n- 计划ID：系统生成的唯一标识\\n- 计划状态：计划状态\\n\\n**业务规则**：\\n- 支持检查模板\\n- 支持自动生成计划\\n- 计划可调整\\n\\n#### 2.3.2 检查执行\\n\\n**功能描述**：执行卫生检查。\\n\\n**输入参数**：\\n- 检查计划ID：必填\\n- 检查结果：必填\\n- 检查图片：可选\\n- 检查备注：可选\\n- 检查人员：必填\\n\\n**输出结果**：\\n- 检查记录ID：检查记录ID\\n- 检查时间：检查时间\\n- 检查状态：检查状态\\n\\n**业务规则**：\\n- 检查结果可评分\\n- 支持检查图片上传\\n- 检查记录完整保留\\n\\n#### 2.3.3 检查记录\\n\\n**功能描述**：查看卫生检查记录。\\n\\n**输入参数**：\\n- 时间范围：可选\\n- 检查类型：可选\\n- 检查结果：可选\\n\\n**输出结果**：\\n- 检查记录：符合条件的检查记录\\n- 检查统计：检查统计数据\\n\\n**业务规则**：\\n- 支持多条件筛选\\n- 检查记录可导出\\n- 检查趋势可分析\\n\\n#### 2.3.4 问题整改\\n\\n**功能描述**：记录问题整改情况。\\n\\n**输入参数**：\\n- 检查记录ID：必填\\n- 问题列表：必填\\n- 整改措施：必填\\n- 整改人员：必填\\n- 整改时间：必填\\n- 整改结果：必填\\n\\n**输出结果**：\\n- 整改记录ID：整改记录ID\\n- 整改状态：整改状态\\n\\n**业务规则**：\\n- 整改记录完整保留\\n- 支持问题跟踪\\n- 整改效果可评估\\n\\n### 2.4 质量检验\\n\\n#### 2.4.1 检验计划\\n\\n**功能描述**：制定质量检验计划。\\n\\n**输入参数**：\\n- 检验名称：必填\\n- 检验类型：必填，如入库检验、过程检验、出厂检验\\n- 检验标准：必填\\n- 检验项目：必填\\n- 负责人：必填\\n- 检验频率：必填\\n\\n**输出结果**：\\n- 计划ID：系统生成的唯一标识\\n- 计划状态：计划状态\\n\\n**业务规则**：\\n- 支持检验模板\\n- 支持自动生成计划\\n- 计划可调整\\n\\n#### 2.4.2 检验执行\\n\\n**功能描述**：执行质量检验。\\n\\n**输入参数**：\\n- 检验计划ID：必填\\n- 检验结果：必填\\n- 检验数据：必填\\n- 检验图片：可选\\n- 检验备注：可选\\n- 检验人员：必填\\n\\n**输出结果**：\\n- 检验记录ID：检验记录ID\\n- 检验时间：检验时间\\n- 检验状态：检验状态\\n\\n**业务规则**：\\n- 检验结果可评分\\n- 支持检验图片上传\\n- 检验记录完整保留\\n\\n#### 2.4.3 不合格处理\\n\\n**功能描述**：处理不合格食材。\\n\\n**输入参数**：\\n- 检验记录ID：必填\\n- 不合格项目：必填\\n- 处理方式：必填，如退货、销毁、降级使用\\n- 处理原因：必填\\n- 处理人员：必填\\n\\n**输出结果**：\\n- 处理记录ID：处理记录ID\\n- 处理时间：处理时间\\n- 处理状态：处理状态\\n\\n**业务规则**：\\n- 不合格食材隔离\\n- 处理记录完整保留\\n- 处理结果可追溯\\n\\n#### 2.4.4 检验报告\\n\\n**功能描述**：生成检验报告。\\n\\n**输入参数**：\\n- 检验记录ID：必填\\n- 报告格式：可选，如PDF、Excel\\n\\n**输出结果**：\\n- 报告文件：生成的报告文件\\n- 报告内容：报告详细内容\\n\\n**业务规则**：\\n- 报告自动生成\\n- 报告格式可自定义\\n- 报告可导出\\n\\n### 2.5 安全预警\\n\\n#### 2.5.1 过期预警\\n\\n**功能描述**：预警食材过期。\\n\\n**输入参数**：\\n- 预警天数：必填\\n- 预警方式：弹窗、短信、邮件\\n\\n**输出结果**：\\n- 预警记录：预警详情\\n- 预警状态：预警触发状态\\n\\n**业务规则**：\\n- 自动检测即将过期食材\\n- 预警及时通知\\n- 预警记录完整\\n\\n#### 2.5.2 温度异常预警\\n\\n**功能描述**：预警温度异常。\\n\\n**输入参数**：\\n- 温度范围：必填\\n- 异常持续时间：必填\\n- 预警方式：弹窗、短信、邮件\\n\\n**输出结果**：\\n- 预警记录：预警详情\\n- 预警状态：预警触发状态\\n\\n**业务规则**：\\n- 实时监控温度\\n- 温度异常及时预警\\n- 预警记录完整\\n\\n#### 2.5.3 质量异常预警\\n\\n**功能描述**：预警质量异常。\\n\\n**输入参数**：\\n- 异常类型：必填\\n- 异常阈值：必填\\n- 预警方式：弹窗、短信、邮件\\n\\n**输出结果**：\\n- 预警记录：预警详情\\n- 预警状态：预警触发状态\\n\\n**业务规则**：\\n- 自动检测质量异常\\n- 异常及时预警\\n- 预警记录完整\\n\\n#### 2.5.4 合规预警\\n\\n**功能描述**：预警合规风险。\\n\\n**输入参数**：\\n- 合规类型：必填\\n- 合规标准：必填\\n- 预警方式：弹窗、短信、邮件\\n\\n**输出结果**：\\n- 预警记录：预警详情\\n- 预警状态：预警触发状态\\n\\n**业务规则**：\\n- 自动检测合规风险\\n- 风险及时预警\\n- 预警记录完整\\n\\n### 2.6 培训管理\\n\\n#### 2.6.1 培训计划\\n\\n**功能描述**：制定安全培训计划。\\n\\n**输入参数**：\\n- 培训名称：必填\\n- 培训类型：必填，如入职培训、定期培训、专项培训\\n- 培训内容：必填\\n- 培训时间：必填\\n- 培训人员：必填\\n- 培训讲师：必填\\n\\n**输出结果**：\\n- 计划ID：系统生成的唯一标识\\n- 计划状态：计划状态\\n\\n**业务规则**：\\n- 支持培训模板\\n- 支持自动生成计划\\n- 计划可调整\\n\\n#### 2.6.2 培训执行\\n\\n**功能描述**：执行安全培训。\\n\\n**输入参数**：\\n- 培训计划ID：必填\\n- 培训记录：必填\\n- 培训图片：可选\\n- 培训备注：可选\\n\\n**输出结果**：\\n- 培训记录ID：培训记录ID\\n- 培训时间：培训时间\\n- 培训状态：培训状态\\n\\n**业务规则**：\\n- 培训记录完整保留\\n- 支持培训签到\\n- 培训效果可评估\\n\\n#### 2.6.3 培训考核\\n\\n**功能描述**：考核培训效果。\\n\\n**输入参数**：\\n- 培训记录ID：必填\\n- 考核方式：必填，如笔试、实操、综合\\n- 考核成绩：必填\\n- 考核人员：必填\\n\\n**输出结果**：\\n- 考核记录ID：考核记录ID\\n- 考核时间：考核时间\\n- 考核状态：考核状态\\n\\n**业务规则**：\\n- 考核结果可评分\\n- 考核记录完整保留\\n- 考核结果可追溯\\n\\n#### 2.6.4 培训记录\\n\\n**功能描述**：查看培训记录。\\n\\n**输入参数**：\\n- 时间范围：可选\\n- 培训类型：可选\\n- 培训人员：可选\\n\\n**输出结果**：\\n- 培训记录：符合条件的培训记录\\n- 培训统计：培训统计数据\\n\\n**业务规则**：\\n- 支持多条件筛选\\n- 培训记录可导出\\n- 培训效果可分析\\n\\n### 2.7 应急处理\\n\\n#### 2.7.1 应急预案\\n\\n**功能描述**：制定食品安全应急预案。\\n\\n**输入参数**：\\n- 预案名称：必填\\n- 预案类型：必填，如食材中毒、食材污染、设备故障\\n- 预案内容：必填\\n- 负责人：必填\\n- 联系方式：必填\\n\\n**输出结果**：\\n- 预案ID：系统生成的唯一标识\\n- 预案状态：预案状态\\n\\n**业务规则**：\\n- 支持预案模板\\n- 预案可定期演练\\n- 预案可调整\\n\\n#### 2.7.2 事件上报\\n\\n**功能描述**：上报食品安全事件。\\n\\n**输入参数**：\\n- 事件类型：必填\\n- 事件描述：必填\\n- 发生时间：必填\\n- 影响范围：必填\\n- 上报人员：必填\\n- 处理措施：可选\\n\\n**输出结果**：\\n- 事件ID：系统生成的唯一标识\\n- 上报时间：上报时间\\n- 事件状态：事件状态\\n\\n**业务规则**：\\n- 事件及时上报\\n- 事件记录完整保留\\n- 事件处理可跟踪\\n\\n#### 2.7.3 事件处理\\n\\n**功能描述**：处理食品安全事件。\\n\\n**输入参数**：\\n- 事件ID：必填\\n- 处理措施：必填\\n- 处理人员：必填\\n- 处理时间：必填\\n- 处理结果：必填\\n\\n**输出结果**：\\n- 处理记录ID：处理记录ID\\n- 处理时间：处理时间\\n- 处理状态：处理状态\\n\\n**业务规则**：\\n- 处理记录完整保留\\n- 支持事件跟踪\\n- 处理效果可评估\\n\\n#### 2.7.4 事件报告\\n\\n**功能描述**：生成事件报告。\\n\\n**输入参数**：\\n- 事件ID：必填\\n- 报告格式：可选，如PDF、Excel\\n\\n**输出结果**：\\n- 报告文件：生成的报告文件\\n- 报告内容：报告详细内容\\n\\n**业务规则**：\\n- 报告自动生成\\n- 报告格式可自定义\\n- 报告可导出\\n\\n### 2.8 合规管理\\n\\n#### 2.8.1 法规管理\\n\\n**功能描述**：管理食品安全法规。\\n\\n**输入参数**：\\n- 法规名称：必填\\n- 法规类型：必填，如国家法规、行业标准\\n- 法规内容：必填\\n- 生效日期：必填\\n- 废止日期：可选\\n\\n**输出结果**：\\n- 法规ID：系统生成的唯一标识\\n- 法规状态：法规状态\\n\\n**业务规则**：\\n- 法规可分类管理\\n- 法规可版本管理\\n- 法规可搜索\\n\\n#### 2.8.2 合规检查\\n\\n**功能描述**：检查合规情况。\\n\\n**输入参数**：\\n- 检查范围：必填\\n- 检查标准：必填\\n- 检查时间：必填\\n\\n**输出结果**：\\n- 检查结果：合规检查结果\\n- 不合规项：不合规项目列表\\n- 整改建议：整改建议\\n\\n**业务规则**：\\n- 自动检查合规情况\\n- 不合规项自动识别\\n- 整改建议可生成\\n\\n#### 2.8.3 合规报告\\n\\n**功能描述**：生成合规报告。\\n\\n**输入参数**：\\n- 检查记录ID：必填\\n- 报告格式：可选，如PDF、Excel\\n\\n**输出结果**：\\n- 报告文件：生成的报告文件\\n- 报告内容：报告详细内容\\n\\n**业务规则**：\\n- 报告自动生成\\n- 报告格式可自定义\\n- 报告可导出\\n\\n## 3. 非功能需求\\n\\n### 3.1 性能需求\\n\\n- **响应时间**：数据查询响应时间不超过2秒\\n- **实时监控**：温度监控延迟不超过5秒\\n- **并发处理**：支持至少50个并发用户\\n- **数据处理**：支持处理百万级数据\\n\\n### 3.2 可用性需求\\n\\n- **易用性**：界面简洁直观，操作流程清晰\\n- **可访问性**：支持键盘导航和屏幕阅读器\\n- **多语言**：支持中英文切换\\n- **响应式设计**：支持PC、平板、手机访问\\n\\n### 3.3 安全需求\\n\\n- **数据加密**：敏感数据加密存储\\n- **访问控制**：基于角色的访问控制\\n- **操作审计**：记录所有操作日志\\n- **数据备份**：定期备份安全数据\\n\\n### 3.4 兼容性需求\\n\\n- **浏览器兼容**：支持Chrome、Firefox、Safari、Edge最新版本\\n- **设备兼容**：支持Windows、macOS、iOS、Android\\n- **分辨率**：支持1920x1080及以上分辨率\\n\\n## 4. 接口设计\\n\\n### 4.1 食材管理接口\\n\\n```typescript\\n// 获取食材列表\\nGET /api/v1/food-safety/ingredients\\nQuery Parameters:\\n  - page: number\\n  - limit: number\\n  - type: string\\n  - supplier: string\\n  - search: string\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"items\\\": [\\n      {\\n        \\\"id\\\": \\\"1\\\",\\n        \\\"name\\\": \\\"鸡肉\\\",\\n        \\\"type\\\": \\\"肉类\\\",\\n        \\\"supplier\\\": \\\"供应商A\\\",\\n        \\\"batchNo\\\": \\\"B20250120001\\\",\\n        \\\"productionDate\\\": \\\"2025-01-15\\\",\\n        \\\"expiryDate\\\": \\\"2025-01-25\\\",\\n        \\\"quantity\\\": 100,\\n        \\\"unit\\\": \\\"kg\\\",\\n        \\\"storageCondition\\\": \\\"冷藏\\\",\\n        \\\"status\\\": \\\"safe\\\",\\n        \\\"createdAt\\\": \\\"2025-01-20T10:00:00Z\\\"\\n      }\\n    ],\\n    \\\"pagination\\\": {\\n      \\\"page\\\": 1,\\n      \\\"limit\\\": 20,\\n      \\\"total\\\": 1000,\\n      \\\"totalPages\\\": 50\\n    }\\n  }\\n}\\n\\n// 创建食材\\nPOST /api/v1/food-safety/ingredients\\nBody:\\n{\\n  \\\"name\\\": \\\"鸡肉\\\",\\n  \\\"type\\\": \\\"肉类\\\",\\n  \\\"supplier\\\": \\\"供应商A\\\",\\n  \\\"batchNo\\\": \\\"B20250120001\\\",\\n  \\\"productionDate\\\": \\\"2025-01-15\\\",\\n  \\\"expiryDate\\\": \\\"2025-01-25\\\",\\n  \\\"quantity\\\": 100,\\n  \\\"unit\\\": \\\"kg\\\",\\n  \\\"storageCondition\\\": \\\"冷藏\\\"\\n}\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"id\\\": \\\"1\\\",\\n    \\\"createdAt\\\": \\\"2025-01-20T10:00:00Z\\\"\\n  }\\n}\\n\\n// 食材追溯\\nGET /api/v1/food-safety/ingredients/:id/trace\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"ingredient\\\": {\\n      \\\"id\\\": \\\"1\\\",\\n      \\\"name\\\": \\\"鸡肉\\\",\\n      \\\"batchNo\\\": \\\"B20250120001\\\"\\n    },\\n    \\\"supplier\\\": {\\n      \\\"name\\\": \\\"供应商A\\\",\\n      \\\"license\\\": \\\"许可证号\\\",\\n      \\\"contact\\\": \\\"联系方式\\\"\\n    },\\n    \\\"inspectionRecords\\\": [],\\n    \\\"usageRecords\\\": []\\n  }\\n}\\n```\\n\\n### 4.2 卫生检查接口\\n\\n```typescript\\n// 获取检查计划\\nGET /api/v1/food-safety/hygiene-plans\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"plans\\\": [\\n      {\\n        \\\"id\\\": \\\"1\\\",\\n        \\\"name\\\": \\\"日常卫生检查\\\",\\n        \\\"type\\\": \\\"daily\\\",\\n        \\\"frequency\\\": \\\"daily\\\",\\n        \\\"items\\\": [\\\"清洁\\\", \\\"消毒\\\", \\\"整理\\\"],\\n        \\\"responsible\\\": \\\"张三\\\",\\n        \\\"startDate\\\": \\\"2025-01-01\\\",\\n        \\\"status\\\": \\\"active\\\"\\n      }\\n    ]\\n  }\\n}\\n\\n// 执行检查\\nPOST /api/v1/food-safety/hygiene-inspections\\nBody:\\n{\\n  \\\"planId\\\": \\\"1\\\",\\n  \\\"result\\\": \\\"pass\\\",\\n  \\\"score\\\": 95,\\n  \\\"images\\\": [\\\"url1\\\", \\\"url2\\\"],\\n  \\\"notes\\\": \\\"检查结果良好\\\",\\n  \\\"inspector\\\": \\\"张三\\\"\\n}\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"id\\\": \\\"1\\\",\\n    \\\"inspectedAt\\\": \\\"2025-01-20T10:00:00Z\\\"\\n  }\\n}\\n\\n// 问题整改\\nPOST /api/v1/food-safety/hygiene-inspections/:id/rectification\\nBody:\\n{\\n  \\\"issues\\\": [\\n    {\\n      \\\"description\\\": \\\"清洁不彻底\\\",\\n      \\\"severity\\\": \\\"medium\\\"\\n    }\\n  ],\\n  \\\"measures\\\": \\\"加强清洁\\\",\\n  \\\"responsible\\\": \\\"李四\\\",\\n  \\\"result\\\": \\\"resolved\\\"\\n}\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"id\\\": \\\"1\\\",\\n    \\\"rectifiedAt\\\": \\\"2025-01-20T14:00:00Z\\\"\\n  }\\n}\\n```\\n\\n### 4.3 安全预警接口\\n\\n```typescript\\n// 获取预警记录\\nGET /api/v1/food-safety/alerts\\nQuery Parameters:\\n  - type: string (expiry, temperature, quality, compliance)\\n  - status: string (active, resolved, all)\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"alerts\\\": [\\n      {\\n        \\\"id\\\": \\\"1\\\",\\n        \\\"type\\\": \\\"expiry\\\",\\n        \\\"severity\\\": \\\"high\\\",\\n        \\\"message\\\": \\\"鸡肉即将过期\\\",\\n        \\\"ingredientId\\\": \\\"1\\\",\\n        \\\"ingredientName\\\": \\\"鸡肉\\\",\\n        \\\"expiryDate\\\": \\\"2025-01-25\\\",\\n        \\\"daysToExpiry\\\": 5,\\n        \\\"timestamp\\\": \\\"2025-01-20T10:00:00Z\\\",\\n        \\\"status\\\": \\\"active\\\"\\n      }\\n    ]\\n  }\\n}\\n\\n// 更新预警状态\\nPATCH /api/v1/food-safety/alerts/:id\\nBody:\\n{\\n  \\\"status\\\": \\\"resolved\\\",\\n  \\\"note\\\": \\\"已处理\\\"\\n}\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"message\\\": \\\"预警状态更新成功\\\"\\n}\\n```\\n\\n## 5. 数据模型\\n\\n### 5.1 食材模型\\n\\n```typescript\\ninterface Ingredient {\\n  id: string;\\n  name: string;\\n  nameEn?: string;\\n  type: IngredientType;\\n  supplier: string;\\n  supplierId: string;\\n  batchNo: string;\\n  productionDate: string;\\n  expiryDate: string;\\n  quantity: number;\\n  unit: string;\\n  storageCondition: StorageCondition;\\n  storageLocation?: string;\\n  inspectionReport?: string;\\n  status: IngredientStatus;\\n  createdAt: string;\\n  updatedAt: string;\\n}\\n\\nenum IngredientType {\\n  VEGETABLE = 'vegetable',\\n  MEAT = 'meat',\\n  AQUATIC = 'aquatic',\\n  GRAIN = 'grain',\\n  SPICE = 'spice',\\n  OTHER = 'other'\\n}\\n\\nenum StorageCondition {\\n  REFRIGERATED = 'refrigerated',\\n  FROZEN = 'frozen',\\n  ROOM_TEMPERATURE = 'room_temperature',\\n  VACUUM = 'vacuum'\\n}\\n\\nenum IngredientStatus {\\n  SAFE = 'safe',\\n  EXPIRING = 'expiring',\\n  EXPIRED = 'expired',\\n  QUARANTINED = 'quarantined',\\n  DISPOSED = 'disposed'\\n}\\n```\\n\\n### 5.2 卫生检查模型\\n\\n```typescript\\ninterface HygienePlan {\\n  id: string;\\n  name: string;\\n  type: InspectionType;\\n  frequency: InspectionFrequency;\\n  items: string[];\\n  responsible: string;\\n  responsibleId: string;\\n  startDate: string;\\n  status: PlanStatus;\\n  createdAt: string;\\n  updatedAt: string;\\n}\\n\\ninterface HygieneInspection {\\n  id: string;\\n  planId: string;\\n  planName: string;\\n  result: InspectionResult;\\n  score?: number;\\n  images: string[];\\n  notes?: string;\\n  inspector: string;\\n  inspectorId: string;\\n  inspectedAt: string;\\n  issues: InspectionIssue[];\\n  rectifications: Rectification[];\\n  createdAt: string;\\n}\\n\\ninterface InspectionIssue {\\n  id: string;\\n  description: string;\\n  severity: IssueSeverity;\\n  status: IssueStatus;\\n}\\n\\ninterface Rectification {\\n  id: string;\\n  issueId: string;\\n  measures: string;\\n  responsible: string;\\n  responsibleId: string;\\n  rectifiedAt: string;\\n  result: string;\\n}\\n\\nenum InspectionType {\\n  DAILY = 'daily',\\n  WEEKLY = 'weekly',\\n  MONTHLY = 'monthly',\\n  SPECIAL = 'special'\\n}\\n\\nenum InspectionFrequency {\\n  DAILY = 'daily',\\n  WEEKLY = 'weekly',\\n  MONTHLY = 'monthly',\\n  QUARTERLY = 'quarterly'\\n}\\n\\nenum InspectionResult {\\n  PASS = 'pass',\\n  FAIL = 'fail',\\n  CONDITIONAL_PASS = 'conditional_pass'\\n}\\n\\nenum IssueSeverity {\\n  LOW = 'low',\\n  MEDIUM = 'medium',\\n  HIGH = 'high',\\n  CRITICAL = 'critical'\\n}\\n\\nenum IssueStatus {\\n  PENDING = 'pending',\\n  IN_PROGRESS = 'in_progress',\\n  RESOLVED = 'resolved'\\n}\\n```\\n\\n### 5.3 安全预警模型\\n\\n```typescript\\ninterface SafetyAlert {\\n  id: string;\\n  type: AlertType;\\n  severity: AlertSeverity;\\n  message: string;\\n  ingredientId?: string;\\n  ingredientName?: string;\\n  storageLocationId?: string;\\n  storageLocationName?: string;\\n  expiryDate?: string;\\n  daysToExpiry?: number;\\n  temperature?: number;\\n  temperatureRange?: string;\\n  timestamp: string;\\n  status: AlertStatus;\\n  resolvedAt?: string;\\n  resolvedBy?: string;\\n  note?: string;\\n}\\n\\nenum AlertType {\\n  EXPIRY = 'expiry',\\n  TEMPERATURE = 'temperature',\\n  QUALITY = 'quality',\\n  COMPLIANCE = 'compliance',\\n  STOCK = 'stock'\\n}\\n\\nenum AlertSeverity {\\n  LOW = 'low',\\n  MEDIUM = 'medium',\\n  HIGH = 'high',\\n  CRITICAL = 'critical'\\n}\\n\\nenum AlertStatus {\\n  ACTIVE = 'active',\\n  RESOLVED = 'resolved',\\n  DISMISSED = 'dismissed'\\n}\\n```\\n\\n## 6. 用户界面设计\\n\\n### 6.1 主界面布局\\n\\n```\\n┌─────────────────────────────────────────────────────────────┐\\n│  食品安全管理                                          │\\n├─────────────────────────────────────────────────────────────┤\\n│  [总览] [食材管理] [储存管理] [检查记录] [告警管理]  │\\n│  [+新增记录]                                         │\\n├─────────────────────────────────────────────────────────────┤\\n│  ┌─────────┐ ┌─────────┐ ┌─────────┐ ┌─────────┐    │\\n│  │ 1,200   │ │ 50      │ │ 95%     │ │ 3       │    │\\n│  │ 安全食材│ │ 即将过期│ │ 合格率  │ │ 告警    │    │\\n│  │ ↑2.5%  │ │ ↓5.2%   │ │ ↑1.8%  │ │ ↓2.1%   │    │\\n│  └─────────┘ └─────────┘ └─────────┘ └─────────┘    │\\n├─────────────────────────────────────────────────────────────┤\\n│  ┌─────────────────────────────────────────────────────┐   │\\n│  │  食材    类型    批次号    有效期    状态    操作    │   │\\n│  │  鸡肉    肉类    B2025012  2025-01-25 安全  [编辑][删除]│   │\\n│  │  牛肉    肉类    B2025013  2025-01-28 安全  [编辑][删除]│   │\\n│  │  蔬菜    蔬菜    B2025014  2025-01-22 预警  [编辑][删除]│   │\\n│  └─────────────────────────────────────────────────────┘   │\\n│  共 1,200 条记录  [上一页] 1 / 60 [下一页]            │\\n└─────────────────────────────────────────────────────────────┘\\n```\\n\\n### 6.2 检查记录界面\\n\\n```\\n┌─────────────────────────────────────────────────────────────┐\\n│  卫生检查记录                                          │\\n├─────────────────────────────────────────────────────────────┤\\n│  [日常检查] [周检查] [月检查] [专项检查]            │\\n├─────────────────────────────────────────────────────────────┤\\n│  ┌─────────────────────────────────────────────────────┐   │\\n│  │  检查时间    检查类型    结果    评分    操作    │   │\\n│  │  2025-01-20  日常检查    合格    95     [详情]  │   │\\n│  │  2025-01-19  日常检查    合格    92     [详情]  │   │\\n│  │  2025-01-18  日常检查    不合格  78     [详情]  │   │\\n│  └─────────────────────────────────────────────────────┘   │\\n│  共 100 条记录  [上一页] 1 / 10 [下一页]              │\\n└─────────────────────────────────────────────────────────────┘\\n```\\n\\n## 7. 测试需求\\n\\n### 7.1 单元测试\\n\\n- 食材CRUD操作测试\\n- 储存管理测试\\n- 卫生检查测试\\n- 质量检验测试\\n- 安全预警测试\\n\\n### 7.2 集成测试\\n\\n- 食材与储存集成测试\\n- 检查与整改集成测试\\n- 预警与通知集成测试\\n- 合规检查集成测试\\n\\n### 7.3 性能测试\\n\\n- 大数据量查询测试\\n- 实时监控性能测试\\n- 并发访问测试\\n- 预警响应时间测试\\n\\n### 7.4 用户验收测试\\n\\n- 功能完整性测试\\n- 易用性测试\\n- 兼容性测试\\n- 安全性测试\\n\\n## 8. 部署和维护\\n\\n### 8.1 部署要求\\n\\n- 服务器配置：4核CPU、8GB内存、200GB SSD\\n- 温度监控设备：支持温度传感器接入\\n- 数据库：PostgreSQL 13+\\n- 缓存：Redis 6+\\n\\n### 8.2 监控要求\\n\\n- 系统监控：CPU、内存、磁盘、网络\\n- 应用监控：响应时间、错误率、吞吐量\\n- 业务监控：食材数据准确性、温度监控及时性、预警响应速度\\n\\n### 8.3 备份策略\\n\\n- 数据库备份：每日全量备份，每小时增量备份\\n- 检查记录备份：每日备份，保留90天\\n- 配置备份：每次配置变更后备份\\n\\n### 8.4 维护计划\\n\\n- 定期更新：每月更新安全标准\\n- 性能优化：每季度进行性能优化\\n- 安全检查：每周进行安全检查\\n- 功能迭代：根据用户反馈持续优化\\n\\n## 9. 版本历史\\n\\n| 版本 | 日期 | 作者 | 变更说明 |\\n|------|------|------|---------|\\n| 1.0.0 | 2025-01-20 | YYC³ | 初始版本 |\\n\",\"originTextLength\":15651,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768895592320}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/docs/YYC3-Cater-Platform-%E6%96%87%E6%A1%A3%E9%97%AD%E7%8E%AF/YYC3-Cater-%E9%9C%80%E6%B1%82%E8%AE%BE%E8%AE%A1%E6%96%87%E6%A1%A3/%E6%8A%A5%E8%A1%A8%E5%88%86%E6%9E%90%E5%8A%9F%E8%83%BD%E6%A8%A1%E5%9D%97%E9%9C%80%E6%B1%82%E5%88%86%E6%9E%90%E4%B8%8E%E8%AE%BE%E8%AE%A1%E6%96%87%E6%A1%A3.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":871,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":871,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# 报表分析功能模块需求分析与设计文档\\\\n\\\\n## 1. 模块概述\\\\n\\\\n### 1.1 模块简介\\\\n\\\\n报表分析功能模块是YYC³餐饮平台的核心报表系统，提供全面的业务报表生成、分析、导出等功能。该模块帮助餐厅管理者快速生成各类业务报表，进行深度数据分析，为决策提供数据支持。\\\\n\\\\n### 1.2 模块目标\\\\n\\\\n- **报表生成**：快速生成各类业务报表，满足不同分析需求\\\\n- **数据分析**：深度分析报表数据，发现业务规律\\\\n- **可视化展示**：通过图表直观展示报表数据\\\\n- **灵活导出**：支持多种格式导出报表\\\\n- **定时报表**：自动生成和发送定时报表\\\\n- **报表共享**：支持报表共享和协作\\\\n\\\\n### 1.3 适用范围\\\\n\\\\n- 餐厅管理者：查看业务报表，制定经营策略\\\\n- 财务人员：生成财务报表，进行财务分析\\\\n- 运营人员：生成运营报表，优化运营流程\\\\n- 市场营销人员：生成营销报表，分析营销效果\\\\n- 监管部门：查看合规报表，监督合规情况\\\\n\\\\n## 2. 功能需求\\\\n\\\\n### 2.1 报表管理\\\\n\\\\n#### 2.1.1 报表创建\\\\n\\\\n**功能描述**：创建新报表。\\\\n\\\\n**输入参数**：\\\\n- 报表名称：必填\\\\n- 报表类型：必填，如销售报表、财务报表、客户报表\\\\n- 报表模板：可选，选择报表模板\\\\n- 数据源：必填，选择数据源\\\\n- 筛选条件：可选，设置筛选条件\\\\n- 排序方式：可选，设置排序方式\\\\n- 图表类型：可选，选择图表类型\\\\n\\\\n**输出结果**：\\\\n- 报表ID：系统生成的唯一标识\\\\n- 创建时间：报表创建时间\\\\n- 操作状态：创建成功或失败\\\\n\\\\n**业务规则**：\\\\n- 报表名称不能重复\\\\n- 支持报表模板\\\\n- 支持自定义报表\\\\n- 报表可保存\\\\n\\\\n#### 2.1.2 报表编辑\\\\n\\\\n**功能描述**：编辑已有报表。\\\\n\\\\n**输入参数**：\\\\n- 报表ID：必填\\\\n- 其他参数：同报表创建\\\\n\\\\n**输出结果**：\\\\n- 更新时间：报表更新时间\\\\n- 操作状态：更新成功或失败\\\\n\\\\n**业务规则**：\\\\n- 编辑后自动更新报表数据\\\\n- 支持报表版本管理\\\\n- 编辑记录可追溯\\\\n\\\\n#### 2.1.3 报表删除\\\\n\\\\n**功能描述**：删除已有报表。\\\\n\\\\n**输入参数**：\\\\n- 报表ID：必填\\\\n\\\\n**输出结果**：\\\\n- 删除状态：删除成功或失败\\\\n\\\\n**业务规则**：\\\\n- 删除前确认\\\\n- 删除后不可恢复\\\\n- 删除记录保留\\\\n\\\\n#### 2.1.4 报表复制\\\\n\\\\n**功能描述**：复制已有报表。\\\\n\\\\n**输入参数**：\\\\n- 源报表ID：必填\\\\n- 新报表名称：必填\\\\n\\\\n**输出结果**：\\\\n- 新报表ID：复制的报表ID\\\\n- 复制状态：复制成功或失败\\\\n\\\\n**业务规则**：\\\\n- 复制所有配置\\\\n- 自动生成新ID\\\\n- 可修改复制的报表\\\\n\\\\n### 2.2 销售报表\\\\n\\\\n#### 2.2.1 销售汇总报表\\\\n\\\\n**功能描述**：生成销售汇总报表。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：必填，如日、周、月、季、年\\\\n- 对比周期：可选，如同比、环比\\\\n- 数据维度：可选，如渠道、品类、地区\\\\n\\\\n**输出结果**：\\\\n- 销售总额：总销售额\\\\n- 销售量：总销售量\\\\n- 客单价：平均客单价\\\\n- 增长率：与上期对比增长率\\\\n- 趋势图：销售趋势图\\\\n\\\\n**业务规则**：\\\\n- 支持多维度汇总\\\\n- 支持同比环比\\\\n- 数据实时更新\\\\n\\\\n#### 2.2.2 菜品销售报表\\\\n\\\\n**功能描述**：生成菜品销售报表。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：必填\\\\n- 菜品分类：可选\\\\n- 排序方式：可选，如销量、收入、利润\\\\n\\\\n**输出结果**：\\\\n- 菜品列表：各菜品销售数据\\\\n- 销售排行：菜品销售排行\\\\n- 销售占比：各菜品销售占比\\\\n- 趋势分析：销售趋势分析\\\\n\\\\n**业务规则**：\\\\n- 支持多维度排序\\\\n- 支持菜品筛选\\\\n- 数据可导出\\\\n\\\\n#### 2.2.3 渠道销售报表\\\\n\\\\n**功能描述**：生成渠道销售报表。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：必填\\\\n- 销售渠道：可选，如堂食、外卖、自提\\\\n\\\\n**输出结果**：\\\\n- 渠道数据：各渠道销售数据\\\\n- 渠道占比：各渠道销售占比\\\\n- 渠道对比：渠道对比分析\\\\n- 趋势分析：渠道趋势分析\\\\n\\\\n**业务规则**：\\\\n- 支持多渠道对比\\\\n- 支持渠道筛选\\\\n- 数据可导出\\\\n\\\\n#### 2.2.4 时段销售报表\\\\n\\\\n**功能描述**：生成时段销售报表。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：必填\\\\n- 时段划分：可选，如小时、半天\\\\n\\\\n**输出结果**：\\\\n- 时段数据：各时段销售数据\\\\n- 高峰时段：销售高峰时段\\\\n- 低谷时段：销售低谷时段\\\\n- 趋势分析：时段趋势分析\\\\n\\\\n**业务规则**：\\\\n- 支持时段自定义\\\\n- 支持高峰低谷识别\\\\n- 数据可导出\\\\n\\\\n### 2.3 财务报表\\\\n\\\\n#### 2.3.1 收入报表\\\\n\\\\n**功能描述**：生成收入报表。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：必填\\\\n- 收入类型：可选，如主营收入、其他收入\\\\n- 对比周期：可选\\\\n\\\\n**输出结果**：\\\\n- 收入总额：总收入\\\\n- 收入构成：收入构成分析\\\\n- 增长率：与上期对比增长率\\\\n- 趋势图：收入趋势图\\\\n\\\\n**业务规则**：\\\\n- 支持多维度分析\\\\n- 支持同比环比\\\\n- 数据实时更新\\\\n\\\\n#### 2.3.2 成本报表\\\\n\\\\n**功能描述**：生成成本报表。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：必填\\\\n- 成本类型：可选，如食材成本、人工成本、运营成本\\\\n- 对比周期：可选\\\\n\\\\n**输出结果**：\\\\n- 成本总额：总成本\\\\n- 成本构成：成本构成分析\\\\n- 成本率：成本率分析\\\\n- 趋势图：成本趋势图\\\\n\\\\n**业务规则**：\\\\n- 支持多维度分析\\\\n- 支持成本率计算\\\\n- 数据实时更新\\\\n\\\\n#### 2.3.3 利润报表\\\\n\\\\n**功能描述**：生成利润报表。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：必填\\\\n- 利润类型：可选，如毛利、净利\\\\n- 对比周期：可选\\\\n\\\\n**输出结果**：\\\\n- 利润总额：总利润\\\\n- 利润率：利润率分析\\\\n- 增长率：与上期对比增长率\\\\n- 趋势图：利润趋势图\\\\n\\\\n**业务规则**：\\\\n- 支持多维度分析\\\\n- 支持利润率计算\\\\n- 数据实时更新\\\\n\\\\n#### 2.3.4 费用报表\\\\n\\\\n**功能描述**：生成费用报表。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：必填\\\\n- 费用类型：可选，如固定费用、变动费用\\\\n- 对比周期：可选\\\\n\\\\n**输出结果**：\\\\n- 费用总额：总费用\\\\n- 费用构成：费用构成分析\\\\n- 费用率：费用率分析\\\\n- 趋势图：费用趋势图\\\\n\\\\n**业务规则**：\\\\n- 支持多维度分析\\\\n- 支持费用率计算\\\\n- 数据实时更新\\\\n\\\\n### 2.4 客户报表\\\\n\\\\n#### 2.4.1 客户统计报表\\\\n\\\\n**功能描述**：生成客户统计报表。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：必填\\\\n- 客户类型：可选，如新客户、老客户、VIP客户\\\\n- 对比周期：可选\\\\n\\\\n**输出结果**：\\\\n- 客户总数：总客户数\\\\n- 新增客户：新增客户数\\\\n- 活跃客户：活跃客户数\\\\n- 流失客户：流失客户数\\\\n- 增长率：客户增长率\\\\n\\\\n**业务规则**：\\\\n- 支持多维度分析\\\\n- 支持客户分类\\\\n- 数据实时更新\\\\n\\\\n#### 2.4.2 客户消费报表\\\\n\\\\n**功能描述**：生成客户消费报表。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：必填\\\\n- 客户类型：可选\\\\n- 消费维度：可选，如消费频次、消费金额\\\\n\\\\n**输出结果**：\\\\n- 消费总额：总消费金额\\\\n- 客单价：平均客单价\\\\n- 消费频次：平均消费频次\\\\n- 消费排行：客户消费排行\\\\n\\\\n**业务规则**：\\\\n- 支持多维度分析\\\\n- 支持客户筛选\\\\n- 数据可导出\\\\n\\\\n#### 2.4.3 客户留存报表\\\\n\\\\n**功能描述**：生成客户留存报表。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：必填\\\\n- 留存周期：可选，如周留存、月留存\\\\n\\\\n**输出结果**：\\\\n- 留存率：客户留存率\\\\n- 留存分布：各周期留存分布\\\\n- 留存趋势：留存趋势分析\\\\n- 流失分析：客户流失分析\\\\n\\\\n**业务规则**：\\\\n- 支持多周期分析\\\\n- 支持留存趋势分析\\\\n- 数据可导出\\\\n\\\\n#### 2.4.4 客户画像报表\\\\n\\\\n**功能描述**：生成客户画像报表。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：必填\\\\n- 画像维度：可选，如人口统计、消费习惯、行为特征\\\\n\\\\n**输出结果**：\\\\n- 客户画像：客户画像数据\\\\n- 画像分布：画像分布情况\\\\n- 画像趋势：画像趋势分析\\\\n\\\\n**业务规则**：\\\\n- 支持多维度分析\\\\n- 支持画像可视化\\\\n- 数据可导出\\\\n\\\\n### 2.5 库存报表\\\\n\\\\n#### 2.5.1 库存汇总报表\\\\n\\\\n**功能描述**：生成库存汇总报表。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：必填\\\\n- 库存类型：可选，如食材、调料、包装材料\\\\n- 库存状态：可选，如正常、不足、积压\\\\n\\\\n**输出结果**：\\\\n- 库存总额：总库存价值\\\\n- 库存数量：总库存数量\\\\n- 库存构成：库存构成分析\\\\n- 库存周转：库存周转率\\\\n\\\\n**业务规则**：\\\\n- 支持多维度分析\\\\n- 支持库存状态筛选\\\\n- 数据实时更新\\\\n\\\\n#### 2.5.2 库存明细报表\\\\n\\\\n**功能描述**：生成库存明细报表。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：必填\\\\n- 物料类型：可选\\\\n- 筛选条件：可选\\\\n\\\\n**输出结果**：\\\\n- 库存明细：各物料库存明细\\\\n- 库存状态：各物料库存状态\\\\n- 库存趋势：库存趋势分析\\\\n\\\\n**业务规则**：\\\\n- 支持多条件筛选\\\\n- 支持库存趋势分析\\\\n- 数据可导出\\\\n\\\\n#### 2.5.3 库存周转报表\\\\n\\\\n**功能描述**：生成库存周转报表。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：必填\\\\n- 物料类型：可选\\\\n\\\\n**输出结果**：\\\\n- 周转率：库存周转率\\\\n- 周转天数：库存周转天数\\\\n- 周转排名：物料周转排名\\\\n- 周转趋势：周转趋势分析\\\\n\\\\n**业务规则**：\\\\n- 支持多维度分析\\\\n- 支持周转排名\\\\n- 数据可导出\\\\n\\\\n#### 2.5.4 库存预警报表\\\\n\\\\n**功能描述**：生成库存预警报表。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：必填\\\\n- 预警类型：可选，如缺货、积压、过期\\\\n\\\\n**输出结果**：\\\\n- 预警列表：库存预警列表\\\\n- 预警统计：预警统计数据\\\\n- 预警趋势：预警趋势分析\\\\n\\\\n**业务规则**：\\\\n- 支持多类型预警\\\\n- 支持预警统计\\\\n- 数据可导出\\\\n\\\\n### 2.6 运营报表\\\\n\\\\n#### 2.6.1 订单报表\\\\n\\\\n**功能描述**：生成订单报表。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：必填\\\\n- 订单类型：可选，如堂食、外卖、自提\\\\n- 订单状态：可选\\\\n\\\\n**输出结果**：\\\\n- 订单总数：总订单数\\\\n- 订单金额：总订单金额\\\\n- 客单价：平均客单价\\\\n- 订单趋势：订单趋势分析\\\\n\\\\n**业务规则**：\\\\n- 支持多维度分析\\\\n- 支持订单筛选\\\\n- 数据实时更新\\\\n\\\\n#### 2.6.2 效率报表\\\\n\\\\n**功能描述**：生成效率报表。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：必填\\\\n- 效率类型：可选，如出餐效率、员工效率、设备效率\\\\n\\\\n**输出结果**：\\\\n- 效率指标：效率指标数据\\\\n- 效率排名：效率排名\\\\n- 效率趋势：效率趋势分析\\\\n\\\\n**业务规则**：\\\\n- 支持多维度分析\\\\n- 支持效率排名\\\\n- 数据可导出\\\\n\\\\n#### 2.6.3 质量报表\\\\n\\\\n**功能描述**：生成质量报表。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：必填\\\\n- 质量类型：可选，如菜品质量、服务质量\\\\n\\\\n**输出结果**：\\\\n- 质量指标：质量指标数据\\\\n- 质量评分：质量评分数据\\\\n- 质量趋势：质量趋势分析\\\\n\\\\n**业务规则**：\\\\n- 支持多维度分析\\\\n- 支持质量评分\\\\n- 数据可导出\\\\n\\\\n#### 2.6.4 满意度报表\\\\n\\\\n**功能描述**：生成满意度报表。\\\\n\\\\n**输入参数**：\\\\n- 时间范围：必填\\\\n- 满意度类型：可选，如菜品满意度、服务满意度\\\\n\\\\n**输出结果**：\\\\n- 满意度评分：满意度评分数据\\\\n- 满意度分布：满意度分布情况\\\\n- 满意度趋势：满意度趋势分析\\\\n\\\\n**业务规则**：\\\\n- 支持多维度分析\\\\n- 支持满意度分布\\\\n- 数据可导出\\\\n\\\\n### 2.7 可视化展示\\\\n\\\\n#### 2.7.1 图表展示\\\\n\\\\n**功能描述**：通过图表展示报表数据。\\\\n\\\\n**输入参数**：\\\\n- 报表ID：必填\\\\n- 图表类型：必填，如折线图、柱状图、饼图\\\\n\\\\n**输出结果**：\\\\n- 图表数据：图表数据\\\\n- 图表配置：图表配置信息\\\\n\\\\n**业务规则**：\\\\n- 支持多种图表类型\\\\n- 支持图表交互\\\\n- 图表可导出\\\\n\\\\n#### 2.7.2 仪表板展示\\\\n\\\\n**功能描述**：通过仪表板展示关键指标。\\\\n\\\\n**输入参数**：\\\\n- 仪表板ID：必填\\\\n- 显示指标：可选，选择显示指标\\\\n\\\\n**输出结果**：\\\\n- 仪表板数据：仪表板数据\\\\n- 指标数据：各指标数据\\\\n\\\\n**业务规则**：\\\\n- 支持自定义仪表板\\\\n- 支持指标选择\\\\n- 数据实时更新\\\\n\\\\n#### 2.7.3 趋势分析\\\\n\\\\n**功能描述**：分析数据趋势。\\\\n\\\\n**输入参数**：\\\\n- 报表ID：必填\\\\n- 分析维度：必填\\\\n\\\\n**输出结果**：\\\\n- 趋势数据：趋势数据\\\\n- 趋势预测：趋势预测数据\\\\n\\\\n**业务规则**：\\\\n- 支持多维度分析\\\\n- 支持趋势预测\\\\n- 数据可视化\\\\n\\\\n### 2.8 报表导出\\\\n\\\\n#### 2.8.1 格式导出\\\\n\\\\n**功能描述**：导出报表为不同格式。\\\\n\\\\n**输入参数**：\\\\n- 报表ID：必填\\\\n- 导出格式：必填，如Excel、PDF、CSV\\\\n- 导出范围：可选，全部或筛选结果\\\\n\\\\n**输出结果**：\\\\n- 导出文件：生成的导出文件\\\\n- 导出记录：导出历史记录\\\\n\\\\n**业务规则**：\\\\n- 支持多种格式\\\\n- 支持自定义导出字段\\\\n- 导出记录完整\\\\n\\\\n#### 2.8.2 定时导出\\\\n\\\\n**功能描述**：定时导出报表。\\\\n\\\\n**输入参数**：\\\\n- 报表ID：必填\\\\n- 导出格式：必填\\\\n- 导出频率：必填，如每日、每周、每月\\\\n- 接收人：必填\\\\n\\\\n**输出结果**：\\\\n- 定时任务ID：定时任务ID\\\\n- 任务状态：任务状态\\\\n\\\\n**业务规则**：\\\\n- 支持多种频率\\\\n- 支持多个接收人\\\\n- 任务可管理\\\\n\\\\n#### 2.8.3 邮件发送\\\\n\\\\n**功能描述**：通过邮件发送报表。\\\\n\\\\n**输入参数**：\\\\n- 报表ID：必填\\\\n- 接收人：必填\\\\n- 邮件主题：必填\\\\n- 邮件内容：可选\\\\n\\\\n**输出结果**：\\\\n- 发送记录：发送历史记录\\\\n- 发送状态：发送状态\\\\n\\\\n**业务规则**：\\\\n- 支持多个接收人\\\\n- 支持邮件模板\\\\n- 发送记录完整\\\\n\\\\n### 2.9 报表共享\\\\n\\\\n#### 2.9.1 报表分享\\\\n\\\\n**功能描述**：分享报表给其他用户。\\\\n\\\\n**输入参数**：\\\\n- 报表ID：必填\\\\n- 分享对象：必填，如用户、角色\\\\n- 分享权限：必填，如查看、编辑\\\\n\\\\n**输出结果**：\\\\n- 分享记录：分享历史记录\\\\n- 分享状态：分享状态\\\\n\\\\n**业务规则**：\\\\n- 支持多种分享对象\\\\n- 支持权限控制\\\\n- 分享记录完整\\\\n\\\\n#### 2.9.2 报表订阅\\\\n\\\\n**功能描述**：订阅报表更新。\\\\n\\\\n**输入参数**：\\\\n- 报表ID：必填\\\\n- 订阅方式：必填，如邮件、系统通知\\\\n\\\\n**输出结果**：\\\\n- 订阅记录：订阅历史记录\\\\n- 订阅状态：订阅状态\\\\n\\\\n**业务规则**：\\\\n- 支持多种订阅方式\\\\n- 更新自动通知\\\\n- 订阅记录完整\\\\n\\\\n#### 2.9.3 报表评论\\\\n\\\\n**功能描述**：对报表进行评论。\\\\n\\\\n**输入参数**：\\\\n- 报表ID：必填\\\\n- 评论内容：必填\\\\n\\\\n**输出结果**：\\\\n- 评论记录：评论历史记录\\\\n- 评论状态：评论状态\\\\n\\\\n**业务规则**：\\\\n- 支持多用户评论\\\\n- 评论可回复\\\\n- 评论记录完整\\\\n\\\\n## 3. 非功能需求\\\\n\\\\n### 3.1 性能需求\\\\n\\\\n- **响应时间**：报表生成时间不超过5秒，数据查询响应时间不超过2秒\\\\n- **并发处理**：支持至少100个并发用户同时访问\\\\n- **数据处理**：支持处理千万级数据\\\\n- **导出性能**：大数据量导出时间不超过30秒\\\\n\\\\n### 3.2 可用性需求\\\\n\\\\n- **易用性**：界面简洁直观，操作流程清晰\\\\n- **可访问性**：支持键盘导航和屏幕阅读器\\\\n- **多语言**：支持中英文切换\\\\n- **响应式设计**：支持PC、平板、手机访问\\\\n\\\\n### 3.3 安全需求\\\\n\\\\n- **数据加密**：敏感数据加密存储\\\\n- **访问控制**：基于角色的访问控制\\\\n- **操作审计**：记录所有操作日志\\\\n- **数据脱敏**：导出数据自动脱敏\\\\n\\\\n### 3.4 兼容性需求\\\\n\\\\n- **浏览器兼容**：支持Chrome、Firefox、Safari、Edge最新版本\\\\n- **设备兼容**：支持Windows、macOS、iOS、Android\\\\n- **分辨率**：支持1920x1080及以上分辨率\\\\n\\\\n## 4. 接口设计\\\\n\\\\n### 4.1 报表管理接口\\\\n\\\\n```typescript\\\\n// 获取报表列表\\\\nGET /api/v1/reports\\\\nQuery Parameters:\\\\n  - page: number\\\\n  - limit: number\\\\n  - type: string\\\\n  - search: string\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"items\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"id\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n        \\\\\\\"name\\\\\\\": \\\\\\\"销售汇总报表\\\\\\\",\\\\n        \\\\\\\"type\\\\\\\": \\\\\\\"sales\\\\\\\",\\\\n        \\\\\\\"description\\\\\\\": \\\\\\\"每日销售汇总\\\\\\\",\\\\n        \\\\\\\"creator\\\\\\\": \\\\\\\"张三\\\\\\\",\\\\n        \\\\\\\"createdAt\\\\\\\": \\\\\\\"2025-01-20T10:00:00Z\\\\\\\",\\\\n        \\\\\\\"updatedAt\\\\\\\": \\\\\\\"2025-01-20T10:00:00Z\\\\\\\"\\\\n      }\\\\n    ],\\\\n    \\\\\\\"pagination\\\\\\\": {\\\\n      \\\\\\\"page\\\\\\\": 1,\\\\n      \\\\\\\"limit\\\\\\\": 20,\\\\n      \\\\\\\"total\\\\\\\": 100,\\\\n      \\\\\\\"totalPages\\\\\\\": 5\\\\n    }\\\\n  }\\\\n}\\\\n\\\\n// 创建报表\\\\nPOST /api/v1/reports\\\\nBody:\\\\n{\\\\n  \\\\\\\"name\\\\\\\": \\\\\\\"销售汇总报表\\\\\\\",\\\\n  \\\\\\\"type\\\\\\\": \\\\\\\"sales\\\\\\\",\\\\n  \\\\\\\"templateId\\\\\\\": \\\\\\\"template_1\\\\\\\",\\\\n  \\\\\\\"dataSource\\\\\\\": \\\\\\\"orders\\\\\\\",\\\\n  \\\\\\\"filters\\\\\\\": {\\\\n    \\\\\\\"dateRange\\\\\\\": \\\\\\\"this_month\\\\\\\",\\\\n    \\\\\\\"channel\\\\\\\": \\\\\\\"all\\\\\\\"\\\\n  },\\\\n  \\\\\\\"chartType\\\\\\\": \\\\\\\"line\\\\\\\"\\\\n}\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"id\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n    \\\\\\\"createdAt\\\\\\\": \\\\\\\"2025-01-20T10:00:00Z\\\\\\\"\\\\n  }\\\\n}\\\\n\\\\n// 生成报表数据\\\\nPOST /api/v1/reports/:id/generate\\\\nBody:\\\\n{\\\\n  \\\\\\\"startDate\\\\\\\": \\\\\\\"2025-01-01\\\\\\\",\\\\n  \\\\\\\"endDate\\\\\\\": \\\\\\\"2025-01-31\\\\\\\",\\\\n  \\\\\\\"filters\\\\\\\": {}\\\\n}\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"reportId\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n    \\\\\\\"generatedAt\\\\\\\": \\\\\\\"2025-01-20T10:00:00Z\\\\\\\",\\\\n    \\\\\\\"summary\\\\\\\": {\\\\n      \\\\\\\"totalRevenue\\\\\\\": 100000,\\\\n      \\\\\\\"totalOrders\\\\\\\": 500,\\\\n      \\\\\\\"avgOrderValue\\\\\\\": 200,\\\\n      \\\\\\\"growthRate\\\\\\\": 15.5\\\\n    },\\\\n    \\\\\\\"details\\\\\\\": [],\\\\n    \\\\\\\"charts\\\\\\\": []\\\\n  }\\\\n}\\\\n```\\\\n\\\\n### 4.2 报表导出接口\\\\n\\\\n```typescript\\\\n// 导出报表\\\\nPOST /api/v1/reports/:id/export\\\\nBody:\\\\n{\\\\n  \\\\\\\"format\\\\\\\": \\\\\\\"excel\\\\\\\",\\\\n  \\\\\\\"fields\\\\\\\": [\\\\\\\"name\\\\\\\", \\\\\\\"value\\\\\\\", \\\\\\\"date\\\\\\\"],\\\\n  \\\\\\\"filters\\\\\\\": {}\\\\n}\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"downloadUrl\\\\\\\": \\\\\\\"download_url\\\\\\\",\\\\n    \\\\\\\"expiresAt\\\\\\\": \\\\\\\"2025-01-21T10:00:00Z\\\\\\\"\\\\n  }\\\\n}\\\\n\\\\n// 创建定时导出\\\\nPOST /api/v1/reports/:id/scheduled-export\\\\nBody:\\\\n{\\\\n  \\\\\\\"format\\\\\\\": \\\\\\\"excel\\\\\\\",\\\\n  \\\\\\\"frequency\\\\\\\": \\\\\\\"daily\\\\\\\",\\\\n  \\\\\\\"recipients\\\\\\\": [\\\\\\\"user1@example.com\\\\\\\", \\\\\\\"user2@example.com\\\\\\\"]\\\\n}\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"taskId\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n    \\\\\\\"status\\\\\\\": \\\\\\\"active\\\\\\\"\\\\n  }\\\\n}\\\\n```\\\\n\\\\n### 4.3 报表共享接口\\\\n\\\\n```typescript\\\\n// 分享报表\\\\nPOST /api/v1/reports/:id/share\\\\nBody:\\\\n{\\\\n  \\\\\\\"shareWith\\\\\\\": [\\\\\\\"user1\\\\\\\", \\\\\\\"user2\\\\\\\"],\\\\n  \\\\\\\"permission\\\\\\\": \\\\\\\"view\\\\\\\"\\\\n}\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"shareId\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n    \\\\\\\"sharedAt\\\\\\\": \\\\\\\"2025-01-20T10:00:00Z\\\\\\\"\\\\n  }\\\\n}\\\\n\\\\n// 订阅报表\\\\nPOST /api/v1/reports/:id/subscribe\\\\nBody:\\\\n{\\\\n  \\\\\\\"method\\\\\\\": \\\\\\\"email\\\\\\\"\\\\n}\\\\n\\\\nResponse:\\\\n{\\\\n  \\\\\\\"success\\\\\\\": true,\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"subscriptionId\\\\\\\": \\\\\\\"1\\\\\\\",\\\\n    \\\\\\\"subscribedAt\\\\\\\": \\\\\\\"2025-01-20T10:00:00Z\\\\\\\"\\\\n  }\\\\n}\\\\n```\\\\n\\\\n## 5. 数据模型\\\\n\\\\n### 5.1 报表模型\\\\n\\\\n```typescript\\\\ninterface Report {\\\\n  id: string;\\\\n  name: string;\\\\n  nameEn?: string;\\\\n  type: ReportType;\\\\n  description?: string;\\\\n  templateId?: string;\\\\n  dataSource: string;\\\\n  filters: ReportFilters;\\\\n  chartType: ChartType;\\\\n  creator: string;\\\\n  creatorId: string;\\\\n  createdAt: string;\\\\n  updatedAt: string;\\\\n  isPublic: boolean;\\\\n  tags: string[];\\\\n}\\\\n\\\\nenum ReportType {\\\\n  SALES = \\\\'sales\\\\',\\\\n  FINANCIAL = \\\\'financial\\\\',\\\\n  CUSTOMER = \\\\'customer\\\\',\\\\n  INVENTORY = \\\\'inventory\\\\',\\\\n  OPERATIONAL = \\\\'operational\\\\',\\\\n  CUSTOM = \\\\'custom\\\\'\\\\n}\\\\n\\\\nenum ChartType {\\\\n  LINE = \\\\'line\\\\',\\\\n  BAR = \\\\'bar\\\\',\\\\n  PIE = \\\\'pie\\\\',\\\\n  TABLE = \\\\'table\\\\',\\\\n  MIXED = \\\\'mixed\\\\'\\\\n}\\\\n\\\\ninterface ReportFilters {\\\\n  dateRange?: string;\\\\n  startDate?: string;\\\\n  endDate?: string;\\\\n  channel?: string;\\\\n  category?: string;\\\\n  status?: string;\\\\n  customFilters?: Record<string, any>;\\\\n}\\\\n```\\\\n\\\\n### 5.2 报表数据模型\\\\n\\\\n```typescript\\\\ninterface ReportData {\\\\n  reportId: string;\\\\n  generatedAt: string;\\\\n  summary: ReportSummary;\\\\n  details: ReportDetail[];\\\\n  charts: ChartData[];\\\\n}\\\\n\\\\ninterface ReportSummary {\\\\n  totalRevenue?: number;\\\\n  totalOrders?: number;\\\\n  avgOrderValue?: number;\\\\n  growthRate?: number;\\\\n  totalCost?: number;\\\\n  profit?: number;\\\\n  profitRate?: number;\\\\n}\\\\n\\\\ninterface ReportDetail {\\\\n  id: string;\\\\n  name: string;\\\\n  value: number;\\\\n  date: string;\\\\n  category?: string;\\\\n  [key: string]: any;\\\\n}\\\\n\\\\ninterface ChartData {\\\\n  type: ChartType;\\\\n  title: string;\\\\n  data: ChartSeries[];\\\\n  config: ChartConfig;\\\\n}\\\\n\\\\ninterface ChartSeries {\\\\n  name: string;\\\\n  data: ChartPoint[];\\\\n}\\\\n\\\\ninterface ChartPoint {\\\\n  name: string;\\\\n  value: number;\\\\n  date?: string;\\\\n}\\\\n\\\\ninterface ChartConfig {\\\\n  xAxis?: string;\\\\n  yAxis?: string;\\\\n  legend?: boolean;\\\\n  colors?: string[];\\\\n}\\\\n```\\\\n\\\\n### 5.3 报表共享模型\\\\n\\\\n```typescript\\\\ninterface ReportShare {\\\\n  id: string;\\\\n  reportId: string;\\\\n  reportName: string;\\\\n  sharedBy: string;\\\\n  sharedById: string;\\\\n  sharedWith: string[];\\\\n  sharedWithType: \\\\'users\\\\' | \\\\'roles\\\\';\\\\n  permission: SharePermission;\\\\n  sharedAt: string;\\\\n  expiresAt?: string;\\\\n}\\\\n\\\\nenum SharePermission {\\\\n  VIEW = \\\\'view\\\\',\\\\n  EDIT = \\\\'edit\\\\',\\\\n  ADMIN = \\\\'admin\\\\'\\\\n}\\\\n\\\\ninterface ReportSubscription {\\\\n  id: string;\\\\n  reportId: string;\\\\n  reportName: string;\\\\n  subscriber: string;\\\\n  subscriberId: string;\\\\n  method: SubscriptionMethod;\\\\n  createdAt: string;\\\\n  status: SubscriptionStatus;\\\\n}\\\\n\\\\nenum SubscriptionMethod {\\\\n  EMAIL = \\\\'email\\\\',\\\\n  NOTIFICATION = \\\\'notification\\\\',\\\\n  BOTH = \\\\'both\\\\'\\\\n}\\\\n\\\\nenum SubscriptionStatus {\\\\n  ACTIVE = \\\\'active\\\\',\\\\n  PAUSED = \\\\'paused\\\\',\\\\n  CANCELLED = \\\\'cancelled\\\\'\\\\n}\\\\n```\\\\n\\\\n## 6. 用户界面设计\\\\n\\\\n### 6.1 报表列表界面\\\\n\\\\n```\\\\n┌─────────────────────────────────────────────────────────────┐\\\\n│  报表分析                                              │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  [销售报表] [财务报表] [客户报表] [库存报表] [运营报表]│\\\\n│  [+创建报表]                                         │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  ┌─────────────────────────────────────────────────────┐   │\\\\n│  │  报表名称    类型    创建人    更新时间    操作    │   │\\\\n│  │  销售汇总    销售    张三      2025-01-20  [查看][编辑]│   │\\\\n│  │  财务报表    财务    李四      2025-01-19  [查看][编辑]│   │\\\\n│  │  客户统计    客户    王五      2025-01-18  [查看][编辑]│   │\\\\n│  └─────────────────────────────────────────────────────┘   │\\\\n│  共 100 条记录  [上一页] 1 / 5 [下一页]              │\\\\n└─────────────────────────────────────────────────────────────┘\\\\n```\\\\n\\\\n### 6.2 报表详情界面\\\\n\\\\n```\\\\n┌─────────────────────────────────────────────────────────────┐\\\\n│  销售汇总报表                                          │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  [本月] [导出] [分享] [订阅]                       │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  ┌─────────┐ ┌─────────┐ ┌─────────┐ ┌─────────┐    │\\\\n│  │ ¥100,000│ │ 500     │ │ ¥200    │ │ ↑15.5%  │    │\\\\n│  │ 总收入  │ │ 总订单  │ │ 客单价  │ │ 增长率  │    │\\\\n│  └─────────┘ └─────────┘ └─────────┘ └─────────┘    │\\\\n├─────────────────────────────────────────────────────────────┤\\\\n│  ┌─────────────────────────────────────────────────────┐   │\\\\n│  │  销售趋势图                                    │   │\\\\n│  │  ¥100k ┤                                     │   │\\\\n│  │         │    ╭────╮                             │   │\\\\n│  │  ¥80k  │   ╱      ╲                            │   │\\\\n│  │         │  ╱        ╲                           │   │\\\\n│  │  ¥60k  │ ╱          ╲                          │   │\\\\n│  │         │╱            ╲                         │   │\\\\n│  │  ¥40k  ┼──────────────╲                        │   │\\\\n│  │         │              ╲                       │   │\\\\n│  │  ¥20k  │               ╲                      │   │\\\\n│  │         └─────────────────────────────────────      │   │\\\\n│  └─────────────────────────────────────────────────────┘   │\\\\n└─────────────────────────────────────────────────────────────┘\\\\n```\\\\n\\\\n## 7. 测试需求\\\\n\\\\n### 7.1 单元测试\\\\n\\\\n- 报表CRUD操作测试\\\\n- 数据生成测试\\\\n- 图表渲染测试\\\\n- 导出功能测试\\\\n- 共享功能测试\\\\n\\\\n### 7.2 集成测试\\\\n\\\\n- 报表与数据源集成测试\\\\n- 导出与文件系统集成测试\\\\n- 共享与权限集成测试\\\\n- 定时任务集成测试\\\\n\\\\n### 7.3 性能测试\\\\n\\\\n- 大数据量生成测试\\\\n- 并发访问测试\\\\n- 导出性能测试\\\\n- 图表渲染性能测试\\\\n\\\\n### 7.4 用户验收测试\\\\n\\\\n- 功能完整性测试\\\\n- 易用性测试\\\\n- 兼容性测试\\\\n- 安全性测试\\\\n\\\\n## 8. 部署和维护\\\\n\\\\n### 8.1 部署要求\\\\n\\\\n- 服务器配置：8核CPU、16GB内存、500GB SSD\\\\n- 数据库：PostgreSQL 13+\\\\n- 缓存：Redis 6+\\\\n- 文件存储：支持对象存储（如OSS、S3）\\\\n\\\\n### 8.2 监控要求\\\\n\\\\n- 系统监控：CPU、内存、磁盘、网络\\\\n- 应用监控：响应时间、错误率、吞吐量\\\\n- 业务监控：报表生成准确性、导出成功率、共享使用率\\\\n\\\\n### 8.3 备份策略\\\\n\\\\n- 数据库备份：每日全量备份，每小时增量备份\\\\n- 报表备份：每次生成后备份\\\\n- 配置备份：每次配置变更后备份\\\\n\\\\n### 8.4 维护计划\\\\n\\\\n- 定期更新：每月更新报表模板\\\\n- 性能优化：每季度进行性能优化\\\\n- 安全检查：每周进行安全检查\\\\n- 功能迭代：根据用户反馈持续优化\\\\n\\\\n## 9. 版本历史\\\\n\\\\n| 版本 | 日期 | 作者 | 变更说明 |\\\\n|------|------|------|---------|\\\\n| 1.0.0 | 2025-01-20 | YYC³ | 初始版本 |\\\\n\",\"originAcceptText\":\"# 报表分析功能模块需求分析与设计文档\\n\\n## 1. 模块概述\\n\\n### 1.1 模块简介\\n\\n报表分析功能模块是YYC³餐饮平台的核心报表系统，提供全面的业务报表生成、分析、导出等功能。该模块帮助餐厅管理者快速生成各类业务报表，进行深度数据分析，为决策提供数据支持。\\n\\n### 1.2 模块目标\\n\\n- **报表生成**：快速生成各类业务报表，满足不同分析需求\\n- **数据分析**：深度分析报表数据，发现业务规律\\n- **可视化展示**：通过图表直观展示报表数据\\n- **灵活导出**：支持多种格式导出报表\\n- **定时报表**：自动生成和发送定时报表\\n- **报表共享**：支持报表共享和协作\\n\\n### 1.3 适用范围\\n\\n- 餐厅管理者：查看业务报表，制定经营策略\\n- 财务人员：生成财务报表，进行财务分析\\n- 运营人员：生成运营报表，优化运营流程\\n- 市场营销人员：生成营销报表，分析营销效果\\n- 监管部门：查看合规报表，监督合规情况\\n\\n## 2. 功能需求\\n\\n### 2.1 报表管理\\n\\n#### 2.1.1 报表创建\\n\\n**功能描述**：创建新报表。\\n\\n**输入参数**：\\n- 报表名称：必填\\n- 报表类型：必填，如销售报表、财务报表、客户报表\\n- 报表模板：可选，选择报表模板\\n- 数据源：必填，选择数据源\\n- 筛选条件：可选，设置筛选条件\\n- 排序方式：可选，设置排序方式\\n- 图表类型：可选，选择图表类型\\n\\n**输出结果**：\\n- 报表ID：系统生成的唯一标识\\n- 创建时间：报表创建时间\\n- 操作状态：创建成功或失败\\n\\n**业务规则**：\\n- 报表名称不能重复\\n- 支持报表模板\\n- 支持自定义报表\\n- 报表可保存\\n\\n#### 2.1.2 报表编辑\\n\\n**功能描述**：编辑已有报表。\\n\\n**输入参数**：\\n- 报表ID：必填\\n- 其他参数：同报表创建\\n\\n**输出结果**：\\n- 更新时间：报表更新时间\\n- 操作状态：更新成功或失败\\n\\n**业务规则**：\\n- 编辑后自动更新报表数据\\n- 支持报表版本管理\\n- 编辑记录可追溯\\n\\n#### 2.1.3 报表删除\\n\\n**功能描述**：删除已有报表。\\n\\n**输入参数**：\\n- 报表ID：必填\\n\\n**输出结果**：\\n- 删除状态：删除成功或失败\\n\\n**业务规则**：\\n- 删除前确认\\n- 删除后不可恢复\\n- 删除记录保留\\n\\n#### 2.1.4 报表复制\\n\\n**功能描述**：复制已有报表。\\n\\n**输入参数**：\\n- 源报表ID：必填\\n- 新报表名称：必填\\n\\n**输出结果**：\\n- 新报表ID：复制的报表ID\\n- 复制状态：复制成功或失败\\n\\n**业务规则**：\\n- 复制所有配置\\n- 自动生成新ID\\n- 可修改复制的报表\\n\\n### 2.2 销售报表\\n\\n#### 2.2.1 销售汇总报表\\n\\n**功能描述**：生成销售汇总报表。\\n\\n**输入参数**：\\n- 时间范围：必填，如日、周、月、季、年\\n- 对比周期：可选，如同比、环比\\n- 数据维度：可选，如渠道、品类、地区\\n\\n**输出结果**：\\n- 销售总额：总销售额\\n- 销售量：总销售量\\n- 客单价：平均客单价\\n- 增长率：与上期对比增长率\\n- 趋势图：销售趋势图\\n\\n**业务规则**：\\n- 支持多维度汇总\\n- 支持同比环比\\n- 数据实时更新\\n\\n#### 2.2.2 菜品销售报表\\n\\n**功能描述**：生成菜品销售报表。\\n\\n**输入参数**：\\n- 时间范围：必填\\n- 菜品分类：可选\\n- 排序方式：可选，如销量、收入、利润\\n\\n**输出结果**：\\n- 菜品列表：各菜品销售数据\\n- 销售排行：菜品销售排行\\n- 销售占比：各菜品销售占比\\n- 趋势分析：销售趋势分析\\n\\n**业务规则**：\\n- 支持多维度排序\\n- 支持菜品筛选\\n- 数据可导出\\n\\n#### 2.2.3 渠道销售报表\\n\\n**功能描述**：生成渠道销售报表。\\n\\n**输入参数**：\\n- 时间范围：必填\\n- 销售渠道：可选，如堂食、外卖、自提\\n\\n**输出结果**：\\n- 渠道数据：各渠道销售数据\\n- 渠道占比：各渠道销售占比\\n- 渠道对比：渠道对比分析\\n- 趋势分析：渠道趋势分析\\n\\n**业务规则**：\\n- 支持多渠道对比\\n- 支持渠道筛选\\n- 数据可导出\\n\\n#### 2.2.4 时段销售报表\\n\\n**功能描述**：生成时段销售报表。\\n\\n**输入参数**：\\n- 时间范围：必填\\n- 时段划分：可选，如小时、半天\\n\\n**输出结果**：\\n- 时段数据：各时段销售数据\\n- 高峰时段：销售高峰时段\\n- 低谷时段：销售低谷时段\\n- 趋势分析：时段趋势分析\\n\\n**业务规则**：\\n- 支持时段自定义\\n- 支持高峰低谷识别\\n- 数据可导出\\n\\n### 2.3 财务报表\\n\\n#### 2.3.1 收入报表\\n\\n**功能描述**：生成收入报表。\\n\\n**输入参数**：\\n- 时间范围：必填\\n- 收入类型：可选，如主营收入、其他收入\\n- 对比周期：可选\\n\\n**输出结果**：\\n- 收入总额：总收入\\n- 收入构成：收入构成分析\\n- 增长率：与上期对比增长率\\n- 趋势图：收入趋势图\\n\\n**业务规则**：\\n- 支持多维度分析\\n- 支持同比环比\\n- 数据实时更新\\n\\n#### 2.3.2 成本报表\\n\\n**功能描述**：生成成本报表。\\n\\n**输入参数**：\\n- 时间范围：必填\\n- 成本类型：可选，如食材成本、人工成本、运营成本\\n- 对比周期：可选\\n\\n**输出结果**：\\n- 成本总额：总成本\\n- 成本构成：成本构成分析\\n- 成本率：成本率分析\\n- 趋势图：成本趋势图\\n\\n**业务规则**：\\n- 支持多维度分析\\n- 支持成本率计算\\n- 数据实时更新\\n\\n#### 2.3.3 利润报表\\n\\n**功能描述**：生成利润报表。\\n\\n**输入参数**：\\n- 时间范围：必填\\n- 利润类型：可选，如毛利、净利\\n- 对比周期：可选\\n\\n**输出结果**：\\n- 利润总额：总利润\\n- 利润率：利润率分析\\n- 增长率：与上期对比增长率\\n- 趋势图：利润趋势图\\n\\n**业务规则**：\\n- 支持多维度分析\\n- 支持利润率计算\\n- 数据实时更新\\n\\n#### 2.3.4 费用报表\\n\\n**功能描述**：生成费用报表。\\n\\n**输入参数**：\\n- 时间范围：必填\\n- 费用类型：可选，如固定费用、变动费用\\n- 对比周期：可选\\n\\n**输出结果**：\\n- 费用总额：总费用\\n- 费用构成：费用构成分析\\n- 费用率：费用率分析\\n- 趋势图：费用趋势图\\n\\n**业务规则**：\\n- 支持多维度分析\\n- 支持费用率计算\\n- 数据实时更新\\n\\n### 2.4 客户报表\\n\\n#### 2.4.1 客户统计报表\\n\\n**功能描述**：生成客户统计报表。\\n\\n**输入参数**：\\n- 时间范围：必填\\n- 客户类型：可选，如新客户、老客户、VIP客户\\n- 对比周期：可选\\n\\n**输出结果**：\\n- 客户总数：总客户数\\n- 新增客户：新增客户数\\n- 活跃客户：活跃客户数\\n- 流失客户：流失客户数\\n- 增长率：客户增长率\\n\\n**业务规则**：\\n- 支持多维度分析\\n- 支持客户分类\\n- 数据实时更新\\n\\n#### 2.4.2 客户消费报表\\n\\n**功能描述**：生成客户消费报表。\\n\\n**输入参数**：\\n- 时间范围：必填\\n- 客户类型：可选\\n- 消费维度：可选，如消费频次、消费金额\\n\\n**输出结果**：\\n- 消费总额：总消费金额\\n- 客单价：平均客单价\\n- 消费频次：平均消费频次\\n- 消费排行：客户消费排行\\n\\n**业务规则**：\\n- 支持多维度分析\\n- 支持客户筛选\\n- 数据可导出\\n\\n#### 2.4.3 客户留存报表\\n\\n**功能描述**：生成客户留存报表。\\n\\n**输入参数**：\\n- 时间范围：必填\\n- 留存周期：可选，如周留存、月留存\\n\\n**输出结果**：\\n- 留存率：客户留存率\\n- 留存分布：各周期留存分布\\n- 留存趋势：留存趋势分析\\n- 流失分析：客户流失分析\\n\\n**业务规则**：\\n- 支持多周期分析\\n- 支持留存趋势分析\\n- 数据可导出\\n\\n#### 2.4.4 客户画像报表\\n\\n**功能描述**：生成客户画像报表。\\n\\n**输入参数**：\\n- 时间范围：必填\\n- 画像维度：可选，如人口统计、消费习惯、行为特征\\n\\n**输出结果**：\\n- 客户画像：客户画像数据\\n- 画像分布：画像分布情况\\n- 画像趋势：画像趋势分析\\n\\n**业务规则**：\\n- 支持多维度分析\\n- 支持画像可视化\\n- 数据可导出\\n\\n### 2.5 库存报表\\n\\n#### 2.5.1 库存汇总报表\\n\\n**功能描述**：生成库存汇总报表。\\n\\n**输入参数**：\\n- 时间范围：必填\\n- 库存类型：可选，如食材、调料、包装材料\\n- 库存状态：可选，如正常、不足、积压\\n\\n**输出结果**：\\n- 库存总额：总库存价值\\n- 库存数量：总库存数量\\n- 库存构成：库存构成分析\\n- 库存周转：库存周转率\\n\\n**业务规则**：\\n- 支持多维度分析\\n- 支持库存状态筛选\\n- 数据实时更新\\n\\n#### 2.5.2 库存明细报表\\n\\n**功能描述**：生成库存明细报表。\\n\\n**输入参数**：\\n- 时间范围：必填\\n- 物料类型：可选\\n- 筛选条件：可选\\n\\n**输出结果**：\\n- 库存明细：各物料库存明细\\n- 库存状态：各物料库存状态\\n- 库存趋势：库存趋势分析\\n\\n**业务规则**：\\n- 支持多条件筛选\\n- 支持库存趋势分析\\n- 数据可导出\\n\\n#### 2.5.3 库存周转报表\\n\\n**功能描述**：生成库存周转报表。\\n\\n**输入参数**：\\n- 时间范围：必填\\n- 物料类型：可选\\n\\n**输出结果**：\\n- 周转率：库存周转率\\n- 周转天数：库存周转天数\\n- 周转排名：物料周转排名\\n- 周转趋势：周转趋势分析\\n\\n**业务规则**：\\n- 支持多维度分析\\n- 支持周转排名\\n- 数据可导出\\n\\n#### 2.5.4 库存预警报表\\n\\n**功能描述**：生成库存预警报表。\\n\\n**输入参数**：\\n- 时间范围：必填\\n- 预警类型：可选，如缺货、积压、过期\\n\\n**输出结果**：\\n- 预警列表：库存预警列表\\n- 预警统计：预警统计数据\\n- 预警趋势：预警趋势分析\\n\\n**业务规则**：\\n- 支持多类型预警\\n- 支持预警统计\\n- 数据可导出\\n\\n### 2.6 运营报表\\n\\n#### 2.6.1 订单报表\\n\\n**功能描述**：生成订单报表。\\n\\n**输入参数**：\\n- 时间范围：必填\\n- 订单类型：可选，如堂食、外卖、自提\\n- 订单状态：可选\\n\\n**输出结果**：\\n- 订单总数：总订单数\\n- 订单金额：总订单金额\\n- 客单价：平均客单价\\n- 订单趋势：订单趋势分析\\n\\n**业务规则**：\\n- 支持多维度分析\\n- 支持订单筛选\\n- 数据实时更新\\n\\n#### 2.6.2 效率报表\\n\\n**功能描述**：生成效率报表。\\n\\n**输入参数**：\\n- 时间范围：必填\\n- 效率类型：可选，如出餐效率、员工效率、设备效率\\n\\n**输出结果**：\\n- 效率指标：效率指标数据\\n- 效率排名：效率排名\\n- 效率趋势：效率趋势分析\\n\\n**业务规则**：\\n- 支持多维度分析\\n- 支持效率排名\\n- 数据可导出\\n\\n#### 2.6.3 质量报表\\n\\n**功能描述**：生成质量报表。\\n\\n**输入参数**：\\n- 时间范围：必填\\n- 质量类型：可选，如菜品质量、服务质量\\n\\n**输出结果**：\\n- 质量指标：质量指标数据\\n- 质量评分：质量评分数据\\n- 质量趋势：质量趋势分析\\n\\n**业务规则**：\\n- 支持多维度分析\\n- 支持质量评分\\n- 数据可导出\\n\\n#### 2.6.4 满意度报表\\n\\n**功能描述**：生成满意度报表。\\n\\n**输入参数**：\\n- 时间范围：必填\\n- 满意度类型：可选，如菜品满意度、服务满意度\\n\\n**输出结果**：\\n- 满意度评分：满意度评分数据\\n- 满意度分布：满意度分布情况\\n- 满意度趋势：满意度趋势分析\\n\\n**业务规则**：\\n- 支持多维度分析\\n- 支持满意度分布\\n- 数据可导出\\n\\n### 2.7 可视化展示\\n\\n#### 2.7.1 图表展示\\n\\n**功能描述**：通过图表展示报表数据。\\n\\n**输入参数**：\\n- 报表ID：必填\\n- 图表类型：必填，如折线图、柱状图、饼图\\n\\n**输出结果**：\\n- 图表数据：图表数据\\n- 图表配置：图表配置信息\\n\\n**业务规则**：\\n- 支持多种图表类型\\n- 支持图表交互\\n- 图表可导出\\n\\n#### 2.7.2 仪表板展示\\n\\n**功能描述**：通过仪表板展示关键指标。\\n\\n**输入参数**：\\n- 仪表板ID：必填\\n- 显示指标：可选，选择显示指标\\n\\n**输出结果**：\\n- 仪表板数据：仪表板数据\\n- 指标数据：各指标数据\\n\\n**业务规则**：\\n- 支持自定义仪表板\\n- 支持指标选择\\n- 数据实时更新\\n\\n#### 2.7.3 趋势分析\\n\\n**功能描述**：分析数据趋势。\\n\\n**输入参数**：\\n- 报表ID：必填\\n- 分析维度：必填\\n\\n**输出结果**：\\n- 趋势数据：趋势数据\\n- 趋势预测：趋势预测数据\\n\\n**业务规则**：\\n- 支持多维度分析\\n- 支持趋势预测\\n- 数据可视化\\n\\n### 2.8 报表导出\\n\\n#### 2.8.1 格式导出\\n\\n**功能描述**：导出报表为不同格式。\\n\\n**输入参数**：\\n- 报表ID：必填\\n- 导出格式：必填，如Excel、PDF、CSV\\n- 导出范围：可选，全部或筛选结果\\n\\n**输出结果**：\\n- 导出文件：生成的导出文件\\n- 导出记录：导出历史记录\\n\\n**业务规则**：\\n- 支持多种格式\\n- 支持自定义导出字段\\n- 导出记录完整\\n\\n#### 2.8.2 定时导出\\n\\n**功能描述**：定时导出报表。\\n\\n**输入参数**：\\n- 报表ID：必填\\n- 导出格式：必填\\n- 导出频率：必填，如每日、每周、每月\\n- 接收人：必填\\n\\n**输出结果**：\\n- 定时任务ID：定时任务ID\\n- 任务状态：任务状态\\n\\n**业务规则**：\\n- 支持多种频率\\n- 支持多个接收人\\n- 任务可管理\\n\\n#### 2.8.3 邮件发送\\n\\n**功能描述**：通过邮件发送报表。\\n\\n**输入参数**：\\n- 报表ID：必填\\n- 接收人：必填\\n- 邮件主题：必填\\n- 邮件内容：可选\\n\\n**输出结果**：\\n- 发送记录：发送历史记录\\n- 发送状态：发送状态\\n\\n**业务规则**：\\n- 支持多个接收人\\n- 支持邮件模板\\n- 发送记录完整\\n\\n### 2.9 报表共享\\n\\n#### 2.9.1 报表分享\\n\\n**功能描述**：分享报表给其他用户。\\n\\n**输入参数**：\\n- 报表ID：必填\\n- 分享对象：必填，如用户、角色\\n- 分享权限：必填，如查看、编辑\\n\\n**输出结果**：\\n- 分享记录：分享历史记录\\n- 分享状态：分享状态\\n\\n**业务规则**：\\n- 支持多种分享对象\\n- 支持权限控制\\n- 分享记录完整\\n\\n#### 2.9.2 报表订阅\\n\\n**功能描述**：订阅报表更新。\\n\\n**输入参数**：\\n- 报表ID：必填\\n- 订阅方式：必填，如邮件、系统通知\\n\\n**输出结果**：\\n- 订阅记录：订阅历史记录\\n- 订阅状态：订阅状态\\n\\n**业务规则**：\\n- 支持多种订阅方式\\n- 更新自动通知\\n- 订阅记录完整\\n\\n#### 2.9.3 报表评论\\n\\n**功能描述**：对报表进行评论。\\n\\n**输入参数**：\\n- 报表ID：必填\\n- 评论内容：必填\\n\\n**输出结果**：\\n- 评论记录：评论历史记录\\n- 评论状态：评论状态\\n\\n**业务规则**：\\n- 支持多用户评论\\n- 评论可回复\\n- 评论记录完整\\n\\n## 3. 非功能需求\\n\\n### 3.1 性能需求\\n\\n- **响应时间**：报表生成时间不超过5秒，数据查询响应时间不超过2秒\\n- **并发处理**：支持至少100个并发用户同时访问\\n- **数据处理**：支持处理千万级数据\\n- **导出性能**：大数据量导出时间不超过30秒\\n\\n### 3.2 可用性需求\\n\\n- **易用性**：界面简洁直观，操作流程清晰\\n- **可访问性**：支持键盘导航和屏幕阅读器\\n- **多语言**：支持中英文切换\\n- **响应式设计**：支持PC、平板、手机访问\\n\\n### 3.3 安全需求\\n\\n- **数据加密**：敏感数据加密存储\\n- **访问控制**：基于角色的访问控制\\n- **操作审计**：记录所有操作日志\\n- **数据脱敏**：导出数据自动脱敏\\n\\n### 3.4 兼容性需求\\n\\n- **浏览器兼容**：支持Chrome、Firefox、Safari、Edge最新版本\\n- **设备兼容**：支持Windows、macOS、iOS、Android\\n- **分辨率**：支持1920x1080及以上分辨率\\n\\n## 4. 接口设计\\n\\n### 4.1 报表管理接口\\n\\n```typescript\\n// 获取报表列表\\nGET /api/v1/reports\\nQuery Parameters:\\n  - page: number\\n  - limit: number\\n  - type: string\\n  - search: string\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"items\\\": [\\n      {\\n        \\\"id\\\": \\\"1\\\",\\n        \\\"name\\\": \\\"销售汇总报表\\\",\\n        \\\"type\\\": \\\"sales\\\",\\n        \\\"description\\\": \\\"每日销售汇总\\\",\\n        \\\"creator\\\": \\\"张三\\\",\\n        \\\"createdAt\\\": \\\"2025-01-20T10:00:00Z\\\",\\n        \\\"updatedAt\\\": \\\"2025-01-20T10:00:00Z\\\"\\n      }\\n    ],\\n    \\\"pagination\\\": {\\n      \\\"page\\\": 1,\\n      \\\"limit\\\": 20,\\n      \\\"total\\\": 100,\\n      \\\"totalPages\\\": 5\\n    }\\n  }\\n}\\n\\n// 创建报表\\nPOST /api/v1/reports\\nBody:\\n{\\n  \\\"name\\\": \\\"销售汇总报表\\\",\\n  \\\"type\\\": \\\"sales\\\",\\n  \\\"templateId\\\": \\\"template_1\\\",\\n  \\\"dataSource\\\": \\\"orders\\\",\\n  \\\"filters\\\": {\\n    \\\"dateRange\\\": \\\"this_month\\\",\\n    \\\"channel\\\": \\\"all\\\"\\n  },\\n  \\\"chartType\\\": \\\"line\\\"\\n}\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"id\\\": \\\"1\\\",\\n    \\\"createdAt\\\": \\\"2025-01-20T10:00:00Z\\\"\\n  }\\n}\\n\\n// 生成报表数据\\nPOST /api/v1/reports/:id/generate\\nBody:\\n{\\n  \\\"startDate\\\": \\\"2025-01-01\\\",\\n  \\\"endDate\\\": \\\"2025-01-31\\\",\\n  \\\"filters\\\": {}\\n}\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"reportId\\\": \\\"1\\\",\\n    \\\"generatedAt\\\": \\\"2025-01-20T10:00:00Z\\\",\\n    \\\"summary\\\": {\\n      \\\"totalRevenue\\\": 100000,\\n      \\\"totalOrders\\\": 500,\\n      \\\"avgOrderValue\\\": 200,\\n      \\\"growthRate\\\": 15.5\\n    },\\n    \\\"details\\\": [],\\n    \\\"charts\\\": []\\n  }\\n}\\n```\\n\\n### 4.2 报表导出接口\\n\\n```typescript\\n// 导出报表\\nPOST /api/v1/reports/:id/export\\nBody:\\n{\\n  \\\"format\\\": \\\"excel\\\",\\n  \\\"fields\\\": [\\\"name\\\", \\\"value\\\", \\\"date\\\"],\\n  \\\"filters\\\": {}\\n}\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"downloadUrl\\\": \\\"download_url\\\",\\n    \\\"expiresAt\\\": \\\"2025-01-21T10:00:00Z\\\"\\n  }\\n}\\n\\n// 创建定时导出\\nPOST /api/v1/reports/:id/scheduled-export\\nBody:\\n{\\n  \\\"format\\\": \\\"excel\\\",\\n  \\\"frequency\\\": \\\"daily\\\",\\n  \\\"recipients\\\": [\\\"user1@example.com\\\", \\\"user2@example.com\\\"]\\n}\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"taskId\\\": \\\"1\\\",\\n    \\\"status\\\": \\\"active\\\"\\n  }\\n}\\n```\\n\\n### 4.3 报表共享接口\\n\\n```typescript\\n// 分享报表\\nPOST /api/v1/reports/:id/share\\nBody:\\n{\\n  \\\"shareWith\\\": [\\\"user1\\\", \\\"user2\\\"],\\n  \\\"permission\\\": \\\"view\\\"\\n}\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"shareId\\\": \\\"1\\\",\\n    \\\"sharedAt\\\": \\\"2025-01-20T10:00:00Z\\\"\\n  }\\n}\\n\\n// 订阅报表\\nPOST /api/v1/reports/:id/subscribe\\nBody:\\n{\\n  \\\"method\\\": \\\"email\\\"\\n}\\n\\nResponse:\\n{\\n  \\\"success\\\": true,\\n  \\\"data\\\": {\\n    \\\"subscriptionId\\\": \\\"1\\\",\\n    \\\"subscribedAt\\\": \\\"2025-01-20T10:00:00Z\\\"\\n  }\\n}\\n```\\n\\n## 5. 数据模型\\n\\n### 5.1 报表模型\\n\\n```typescript\\ninterface Report {\\n  id: string;\\n  name: string;\\n  nameEn?: string;\\n  type: ReportType;\\n  description?: string;\\n  templateId?: string;\\n  dataSource: string;\\n  filters: ReportFilters;\\n  chartType: ChartType;\\n  creator: string;\\n  creatorId: string;\\n  createdAt: string;\\n  updatedAt: string;\\n  isPublic: boolean;\\n  tags: string[];\\n}\\n\\nenum ReportType {\\n  SALES = 'sales',\\n  FINANCIAL = 'financial',\\n  CUSTOMER = 'customer',\\n  INVENTORY = 'inventory',\\n  OPERATIONAL = 'operational',\\n  CUSTOM = 'custom'\\n}\\n\\nenum ChartType {\\n  LINE = 'line',\\n  BAR = 'bar',\\n  PIE = 'pie',\\n  TABLE = 'table',\\n  MIXED = 'mixed'\\n}\\n\\ninterface ReportFilters {\\n  dateRange?: string;\\n  startDate?: string;\\n  endDate?: string;\\n  channel?: string;\\n  category?: string;\\n  status?: string;\\n  customFilters?: Record<string, any>;\\n}\\n```\\n\\n### 5.2 报表数据模型\\n\\n```typescript\\ninterface ReportData {\\n  reportId: string;\\n  generatedAt: string;\\n  summary: ReportSummary;\\n  details: ReportDetail[];\\n  charts: ChartData[];\\n}\\n\\ninterface ReportSummary {\\n  totalRevenue?: number;\\n  totalOrders?: number;\\n  avgOrderValue?: number;\\n  growthRate?: number;\\n  totalCost?: number;\\n  profit?: number;\\n  profitRate?: number;\\n}\\n\\ninterface ReportDetail {\\n  id: string;\\n  name: string;\\n  value: number;\\n  date: string;\\n  category?: string;\\n  [key: string]: any;\\n}\\n\\ninterface ChartData {\\n  type: ChartType;\\n  title: string;\\n  data: ChartSeries[];\\n  config: ChartConfig;\\n}\\n\\ninterface ChartSeries {\\n  name: string;\\n  data: ChartPoint[];\\n}\\n\\ninterface ChartPoint {\\n  name: string;\\n  value: number;\\n  date?: string;\\n}\\n\\ninterface ChartConfig {\\n  xAxis?: string;\\n  yAxis?: string;\\n  legend?: boolean;\\n  colors?: string[];\\n}\\n```\\n\\n### 5.3 报表共享模型\\n\\n```typescript\\ninterface ReportShare {\\n  id: string;\\n  reportId: string;\\n  reportName: string;\\n  sharedBy: string;\\n  sharedById: string;\\n  sharedWith: string[];\\n  sharedWithType: 'users' | 'roles';\\n  permission: SharePermission;\\n  sharedAt: string;\\n  expiresAt?: string;\\n}\\n\\nenum SharePermission {\\n  VIEW = 'view',\\n  EDIT = 'edit',\\n  ADMIN = 'admin'\\n}\\n\\ninterface ReportSubscription {\\n  id: string;\\n  reportId: string;\\n  reportName: string;\\n  subscriber: string;\\n  subscriberId: string;\\n  method: SubscriptionMethod;\\n  createdAt: string;\\n  status: SubscriptionStatus;\\n}\\n\\nenum SubscriptionMethod {\\n  EMAIL = 'email',\\n  NOTIFICATION = 'notification',\\n  BOTH = 'both'\\n}\\n\\nenum SubscriptionStatus {\\n  ACTIVE = 'active',\\n  PAUSED = 'paused',\\n  CANCELLED = 'cancelled'\\n}\\n```\\n\\n## 6. 用户界面设计\\n\\n### 6.1 报表列表界面\\n\\n```\\n┌─────────────────────────────────────────────────────────────┐\\n│  报表分析                                              │\\n├─────────────────────────────────────────────────────────────┤\\n│  [销售报表] [财务报表] [客户报表] [库存报表] [运营报表]│\\n│  [+创建报表]                                         │\\n├─────────────────────────────────────────────────────────────┤\\n│  ┌─────────────────────────────────────────────────────┐   │\\n│  │  报表名称    类型    创建人    更新时间    操作    │   │\\n│  │  销售汇总    销售    张三      2025-01-20  [查看][编辑]│   │\\n│  │  财务报表    财务    李四      2025-01-19  [查看][编辑]│   │\\n│  │  客户统计    客户    王五      2025-01-18  [查看][编辑]│   │\\n│  └─────────────────────────────────────────────────────┘   │\\n│  共 100 条记录  [上一页] 1 / 5 [下一页]              │\\n└─────────────────────────────────────────────────────────────┘\\n```\\n\\n### 6.2 报表详情界面\\n\\n```\\n┌─────────────────────────────────────────────────────────────┐\\n│  销售汇总报表                                          │\\n├─────────────────────────────────────────────────────────────┤\\n│  [本月] [导出] [分享] [订阅]                       │\\n├─────────────────────────────────────────────────────────────┤\\n│  ┌─────────┐ ┌─────────┐ ┌─────────┐ ┌─────────┐    │\\n│  │ ¥100,000│ │ 500     │ │ ¥200    │ │ ↑15.5%  │    │\\n│  │ 总收入  │ │ 总订单  │ │ 客单价  │ │ 增长率  │    │\\n│  └─────────┘ └─────────┘ └─────────┘ └─────────┘    │\\n├─────────────────────────────────────────────────────────────┤\\n│  ┌─────────────────────────────────────────────────────┐   │\\n│  │  销售趋势图                                    │   │\\n│  │  ¥100k ┤                                     │   │\\n│  │         │    ╭────╮                             │   │\\n│  │  ¥80k  │   ╱      ╲                            │   │\\n│  │         │  ╱        ╲                           │   │\\n│  │  ¥60k  │ ╱          ╲                          │   │\\n│  │         │╱            ╲                         │   │\\n│  │  ¥40k  ┼──────────────╲                        │   │\\n│  │         │              ╲                       │   │\\n│  │  ¥20k  │               ╲                      │   │\\n│  │         └─────────────────────────────────────      │   │\\n│  └─────────────────────────────────────────────────────┘   │\\n└─────────────────────────────────────────────────────────────┘\\n```\\n\\n## 7. 测试需求\\n\\n### 7.1 单元测试\\n\\n- 报表CRUD操作测试\\n- 数据生成测试\\n- 图表渲染测试\\n- 导出功能测试\\n- 共享功能测试\\n\\n### 7.2 集成测试\\n\\n- 报表与数据源集成测试\\n- 导出与文件系统集成测试\\n- 共享与权限集成测试\\n- 定时任务集成测试\\n\\n### 7.3 性能测试\\n\\n- 大数据量生成测试\\n- 并发访问测试\\n- 导出性能测试\\n- 图表渲染性能测试\\n\\n### 7.4 用户验收测试\\n\\n- 功能完整性测试\\n- 易用性测试\\n- 兼容性测试\\n- 安全性测试\\n\\n## 8. 部署和维护\\n\\n### 8.1 部署要求\\n\\n- 服务器配置：8核CPU、16GB内存、500GB SSD\\n- 数据库：PostgreSQL 13+\\n- 缓存：Redis 6+\\n- 文件存储：支持对象存储（如OSS、S3）\\n\\n### 8.2 监控要求\\n\\n- 系统监控：CPU、内存、磁盘、网络\\n- 应用监控：响应时间、错误率、吞吐量\\n- 业务监控：报表生成准确性、导出成功率、共享使用率\\n\\n### 8.3 备份策略\\n\\n- 数据库备份：每日全量备份，每小时增量备份\\n- 报表备份：每次生成后备份\\n- 配置备份：每次配置变更后备份\\n\\n### 8.4 维护计划\\n\\n- 定期更新：每月更新报表模板\\n- 性能优化：每季度进行性能优化\\n- 安全检查：每周进行安全检查\\n- 功能迭代：根据用户反馈持续优化\\n\\n## 9. 版本历史\\n\\n| 版本 | 日期 | 作者 | 变更说明 |\\n|------|------|------|---------|\\n| 1.0.0 | 2025-01-20 | YYC³ | 初始版本 |\\n\",\"originTextLength\":14641,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768895732409}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/views/__tests__/MenuManagement.test.ts": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":371,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":371,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"/**\\\\n * @fileoverview YYC³餐饮管理系统 - MenuManagement组件单元测试\\\\n * @description 测试MenuManagement组件的功能\\\\n * @module MenuManagement.test\\\\n * @author YYC³\\\\n * @version 1.0.0\\\\n * @created 2025-01-20\\\\n */\\\\n\\\\nimport { describe, it, expect, beforeEach, vi } from \\\\'vitest\\\\'\\\\nimport { mount, VueWrapper } from \\\\'@vue/test-utils\\\\'\\\\nimport { createPinia, setActivePinia } from \\\\'pinia\\\\'\\\\nimport { ref, reactive } from \\\\'vue\\\\'\\\\nimport ElementPlus from \\\\'element-plus\\\\'\\\\nimport MenuManagement from \\\\'@/views/MenuManagement.vue\\\\'\\\\nimport { MenuAPI } from \\\\'@/api/menu\\\\'\\\\nimport type { MenuItem } from \\\\'@/api/menu\\\\'\\\\n\\\\nvi.mock(\\\\'@/api/menu\\\\', () => ({\\\\n  MenuAPI: {\\\\n    getMenuItems: vi.fn(),\\\\n    createMenuItem: vi.fn(),\\\\n    updateMenuItem: vi.fn(),\\\\n    deleteMenuItem: vi.fn()\\\\n  }\\\\n}))\\\\n\\\\nvi.mock(\\\\'element-plus\\\\', () => ({\\\\n  default: {\\\\n    ElMessage: {\\\\n      success: vi.fn(),\\\\n      error: vi.fn(),\\\\n      warning: vi.fn(),\\\\n      info: vi.fn()\\\\n    },\\\\n    ElMessageBox: {\\\\n      confirm: vi.fn()\\\\n    }\\\\n  },\\\\n  ElMessage: {\\\\n    success: vi.fn(),\\\\n    error: vi.fn(),\\\\n    warning: vi.fn(),\\\\n    info: vi.fn()\\\\n  },\\\\n  ElMessageBox: {\\\\n    confirm: vi.fn()\\\\n  }\\\\n}))\\\\n\\\\ndescribe(\\\\'MenuManagement组件\\\\', () => {\\\\n  let wrapper: VueWrapper<any>\\\\n  let pinia: any\\\\n\\\\n  const mockMenuItems: MenuItem[] = [\\\\n    {\\\\n      id: 1,\\\\n      name: \\\\'宫保鸡丁\\\\',\\\\n      description: \\\\'经典川菜\\\\',\\\\n      price: 38.00,\\\\n      category: \\\\'小菜\\\\',\\\\n      imageUrl: \\\\'http://example.com/gongbao.jpg\\\\',\\\\n      available: true,\\\\n      ingredients: [\\\\'鸡肉\\\\', \\\\'花生\\\\', \\\\'辣椒\\\\'],\\\\n      allergens: [\\\\'花生\\\\'],\\\\n      nutritionInfo: {\\\\n        calories: 280,\\\\n        protein: 25,\\\\n        carbs: 15,\\\\n        fat: 14\\\\n      },\\\\n      createdAt: \\\\'2025-01-15T10:00:00Z\\\\',\\\\n      updatedAt: \\\\'2025-01-15T10:00:00Z\\\\'\\\\n    },\\\\n    {\\\\n      id: 2,\\\\n      name: \\\\'番茄牛腩\\\\',\\\\n      description: \\\\'营养美味\\\\',\\\\n      price: 58.00,\\\\n      category: \\\\'主食\\\\',\\\\n      imageUrl: \\\\'http://example.com/niu.jpg\\\\',\\\\n      available: true,\\\\n      ingredients: [\\\\'牛肉\\\\', \\\\'番茄\\\\', \\\\'洋葱\\\\'],\\\\n      allergens: [],\\\\n      createdAt: \\\\'2025-01-14T09:00:00Z\\\\',\\\\n      updatedAt: \\\\'2025-01-14T09:00:00Z\\\\'\\\\n    },\\\\n    {\\\\n      id: 3,\\\\n      name: \\\\'冰镇酸梅汤\\\\',\\\\n      description: \\\\'消暑饮品\\\\',\\\\n      price: 12.00,\\\\n      category: \\\\'饮料\\\\',\\\\n      available: false,\\\\n      ingredients: [\\\\'乌梅\\\\', \\\\'山楂\\\\', \\\\'甘草\\\\'],\\\\n      allergens: [],\\\\n      createdAt: \\\\'2025-01-13T08:00:00Z\\\\',\\\\n      updatedAt: \\\\'2025-01-13T08:00:00Z\\\\'\\\\n    }\\\\n  ]\\\\n\\\\n  beforeEach(() => {\\\\n    pinia = createPinia()\\\\n    setActivePinia(pinia)\\\\n\\\\n    vi.clearAllMocks()\\\\n\\\\n    ;(MenuAPI.getMenuItems as any).mockResolvedValue({\\\\n      success: true,\\\\n      data: {\\\\n        items: mockMenuItems,\\\\n        pagination: {\\\\n          page: 1,\\\\n          limit: 20,\\\\n          total: 3,\\\\n          totalPages: 1\\\\n        }\\\\n      }\\\\n    })\\\\n  })\\\\n\\\\n  const createWrapper = () => {\\\\n    return mount(MenuManagement, {\\\\n      global: {\\\\n        plugins: [ElementPlus, pinia],\\\\n        stubs: {\\\\n          \\\\'el-dialog\\\\': {\\\\n            template: \\\\'<div class=\\\\\\\"el-dialog-mock\\\\\\\" v-if=\\\\\\\"modelValue\\\\\\\"><slot></slot><slot name=\\\\\\\"footer\\\\\\\"></slot></div>\\\\',\\\\n            props: [\\\\'modelValue\\\\', \\\\'title\\\\'],\\\\n            emits: [\\\\'update:modelValue\\\\']\\\\n          },\\\\n          \\\\'el-table\\\\': {\\\\n            template: \\\\'<div class=\\\\\\\"el-table-mock\\\\\\\"><slot v-for=\\\\\\\"item in $slots.default?.[0]?.children\\\\\\\" name=\\\\\\\"default\\\\\\\"></slot></div>\\\\',\\\\n            props: [\\\\'data\\\\', \\\\'loading\\\\', \\\\'rowKey\\\\', \\\\'stripe\\\\']\\\\n          },\\\\n          \\\\'el-table-column\\\\': {\\\\n            template: \\\\'<div class=\\\\\\\"el-table-column-mock\\\\\\\"><slot></slot></div>\\\\',\\\\n            props: [\\\\'prop\\\\', \\\\'label\\\\', \\\\'width\\\\', \\\\'minWidth\\\\', \\\\'fixed\\\\']\\\\n          }\\\\n        }\\\\n      }\\\\n    })\\\\n  }\\\\n\\\\n  describe(\\\\'初始化渲染\\\\', () => {\\\\n    it(\\\\'应该正确渲染页面标题\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.find(\\\\'h1\\\\').text()).toBe(\\\\'菜单管理\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该渲染添加菜品按钮\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      const addButton = wrapper.find(\\\\'.el-button--primary\\\\')\\\\n      expect(addButton.text()).toContain(\\\\'添加菜品\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该渲染筛选表单\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.find(\\\\'.filter-card\\\\').exists()).toBe(true)\\\\n      expect(wrapper.find(\\\\'input[placeholder=\\\\\\\"搜索菜品名称\\\\\\\"]\\\\').exists()).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该渲染菜单列表\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.find(\\\\'.menu-list-card\\\\').exists()).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该渲染分页组件\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.find(\\\\'.pagination-container\\\\').exists()).toBe(true)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'数据加载\\\\', () => {\\\\n    it(\\\\'应该正确加载菜单数据\\\\', async () => {\\\\n      wrapper = createWrapper()\\\\n      await wrapper.vm.$nextTick()\\\\n      expect(MenuAPI.getMenuItems).toHaveBeenCalled()\\\\n      expect(wrapper.vm.menuItems).toHaveLength(3)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示菜单项名称\\\\', async () => {\\\\n      wrapper = createWrapper()\\\\n      await wrapper.vm.$nextTick()\\\\n      expect(wrapper.text()).toContain(\\\\'宫保鸡丁\\\\')\\\\n      expect(wrapper.text()).toContain(\\\\'番茄牛腩\\\\')\\\\n      expect(wrapper.text()).toContain(\\\\'冰镇酸梅汤\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示菜单项价格\\\\', async () => {\\\\n      wrapper = createWrapper()\\\\n      await wrapper.vm.$nextTick()\\\\n      expect(wrapper.text()).toContain(\\\\'¥38.00\\\\')\\\\n      expect(wrapper.text()).toContain(\\\\'¥58.00\\\\')\\\\n      expect(wrapper.text()).toContain(\\\\'¥12.00\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示菜单项分类标签\\\\', async () => {\\\\n      wrapper = createWrapper()\\\\n      await wrapper.vm.$nextTick()\\\\n      expect(wrapper.text()).toContain(\\\\'小菜\\\\')\\\\n      expect(wrapper.text()).toContain(\\\\'主食\\\\')\\\\n      expect(wrapper.text()).toContain(\\\\'饮料\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'状态显示\\\\', () => {\\\\n    it(\\\\'应该正确显示上架状态\\\\', async () => {\\\\n      wrapper = createWrapper()\\\\n      await wrapper.vm.$nextTick()\\\\n      expect(wrapper.text()).toContain(\\\\'宫保鸡丁\\\\')\\\\n      expect(wrapper.text()).not.toContain(\\\\'已下架\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示下架状态\\\\', async () => {\\\\n      wrapper = createWrapper()\\\\n      await wrapper.vm.$nextTick()\\\\n      expect(wrapper.text()).toContain(\\\\'冰镇酸梅汤\\\\')\\\\n      expect(wrapper.text()).toContain(\\\\'已下架\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'筛选功能\\\\', () => {\\\\n    it(\\\\'应该能够按分类筛选\\\\', async () => {\\\\n      wrapper = createWrapper()\\\\n      await wrapper.vm.$nextTick()\\\\n\\\\n      const categorySelect = wrapper.find(\\\\'.el-select\\\\')\\\\n      expect(categorySelect.exists()).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该能够按状态筛选\\\\', async () => {\\\\n      wrapper = createWrapper()\\\\n      await wrapper.vm.$nextTick()\\\\n\\\\n      const statusSelects = wrapper.findAll(\\\\'.el-select\\\\')\\\\n      expect(statusSelects.length).toBeGreaterThanOrEqual(2)\\\\n    })\\\\n\\\\n    it(\\\\'应该能够搜索菜品\\\\', async () => {\\\\n      wrapper = createWrapper()\\\\n      await wrapper.vm.$nextTick()\\\\n\\\\n      const searchInput = wrapper.find(\\\\'input[placeholder=\\\\\\\"搜索菜品名称\\\\\\\"]\\\\')\\\\n      expect(searchInput.exists()).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该能够重置筛选条件\\\\', async () => {\\\\n      wrapper = createWrapper()\\\\n      await wrapper.vm.$nextTick()\\\\n\\\\n      const resetButton = wrapper.findAll(\\\\'.el-button\\\\').find(btn => btn.text() === \\\\'重置\\\\')\\\\n      expect(resetButton).toBeDefined()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'分页功能\\\\', () => {\\\\n    it(\\\\'应该正确初始化分页\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      expect(wrapper.vm.pagination.page).toBe(1)\\\\n      expect(wrapper.vm.pagination.limit).toBe(20)\\\\n    })\\\\n\\\\n    it(\\\\'应该能够切换页码\\\\', async () => {\\\\n      wrapper = createWrapper()\\\\n      await wrapper.vm.$nextTick()\\\\n\\\\n      ;(MenuAPI.getMenuItems as any).mockResolvedValue({\\\\n        success: true,\\\\n        data: {\\\\n          items: mockMenuItems.slice(0, 2),\\\\n          pagination: {\\\\n            page: 2,\\\\n            limit: 20,\\\\n            total: 3,\\\\n            totalPages: 1\\\\n          }\\\\n        }\\\\n      })\\\\n\\\\n      wrapper.vm.pagination.page = 2\\\\n      await wrapper.vm.$nextTick()\\\\n      expect(MenuAPI.getMenuItems).toHaveBeenCalled()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'创建功能\\\\', () => {\\\\n    it(\\\\'应该能够打开创建对话框\\\\', async () => {\\\\n      wrapper = createWrapper()\\\\n      await wrapper.vm.$nextTick()\\\\n\\\\n      const addButton = wrapper.find(\\\\'.el-button--primary\\\\')\\\\n      await addButton.trigger(\\\\'click\\\\')\\\\n\\\\n      expect(wrapper.vm.showCreateDialog).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'创建对话框应该包含表单字段\\\\', async () => {\\\\n      wrapper = createWrapper()\\\\n      await wrapper.vm.$nextTick()\\\\n\\\\n      wrapper.vm.showCreateDialog = true\\\\n      await wrapper.vm.$nextTick()\\\\n\\\\n      expect(wrapper.text()).toContain(\\\\'菜品名称\\\\')\\\\n      expect(wrapper.text()).toContain(\\\\'菜品分类\\\\')\\\\n      expect(wrapper.text()).toContain(\\\\'价格\\\\')\\\\n      expect(wrapper.text()).toContain(\\\\'描述\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该能够创建新菜品\\\\', async () => {\\\\n      ;(MenuAPI.createMenuItem as any).mockResolvedValue({\\\\n        success: true,\\\\n        message: \\\\'创建: {\\\\n          id: 4,\\\\n          name: \\\\'成功\\\\',\\\\n        data新菜品\\\\',\\\\n          description: \\\\'新菜品描述\\\\',\\\\n          price: 25.00,\\\\n          category: \\\\'小菜\\\\',\\\\n          available: true,\\\\n          ingredients: [],\\\\n          allergens: [],\\\\n          createdAt: new Date().toISOString(),\\\\n          updatedAt: new Date().toISOString()\\\\n        }\\\\n      })\\\\n\\\\n      wrapper = createWrapper()\\\\n      await wrapper.vm.$nextTick()\\\\n\\\\n      wrapper.vm.showCreateDialog = true\\\\n      await wrapper.vm.$nextTick()\\\\n\\\\n      Object.assign(wrapper.vm.formData, {\\\\n        name: \\\\'新菜品\\\\',\\\\n        category: \\\\'小菜\\\\',\\\\n        price: 25.00,\\\\n        description: \\\\'新菜品描述\\\\',\\\\n        available: true\\\\n      })\\\\n\\\\n      const submitButton = wrapper.findAll(\\\\'.el-button\\\\').find(btn => btn.text() === \\\\'创建\\\\')\\\\n      expect(submitButton).toBeDefined()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'编辑功能\\\\', () => {\\\\n    it(\\\\'应该能够打开编辑对话框\\\\', async () => {\\\\n      wrapper = createWrapper()\\\\n      await wrapper.vm.$nextTick()\\\\n\\\\n      const editButtons = wrapper.findAll(\\\\'.el-button--default\\\\')\\\\n      const editButton = editButtons.find(btn => btn.text().includes(\\\\'编辑\\\\'))\\\\n      expect(editButton).toBeDefined()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'删除功能\\\\', () => {\\\\n    it(\\\\'应该能够打开删除确认\\\\', async () => {\\\\n      ;(ElMessageBox.confirm as any).mockResolvedValue(true)\\\\n\\\\n      wrapper = createWrapper()\\\\n      await wrapper.vm.$nextTick()\\\\n\\\\n      const deleteButtons = wrapper.findAll(\\\\'.el-button--danger\\\\')\\\\n      expect(deleteButtons.length).toBeGreaterThanOrEqual(1)\\\\n    })\\\\n\\\\n    it(\\\\'删除确认后应该调用删除API\\\\', async () => {\\\\n      ;(ElMessageBox.confirm as any).mockResolvedValue(true)\\\\n      ;(MenuAPI.deleteMenuItem as any).mockResolvedValue({\\\\n        success: true,\\\\n        message: \\\\'删除成功\\\\'\\\\n      })\\\\n\\\\n      wrapper = createWrapper()\\\\n      await wrapper.vm.$nextTick()\\\\n\\\\n      wrapper.vm.handleDelete(mockMenuItems[0])\\\\n      await wrapper.vm.$nextTick()\\\\n\\\\n      expect(MenuAPI.deleteMenuItem).toHaveBeenCalledWith(1)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'状态切换\\\\', () => {\\\\n    it(\\\\'应该能够切换菜品状态\\\\', async () => {\\\\n      ;(MenuAPI.updateMenuItem as any).mockResolvedValue({\\\\n        success: true,\\\\n        message: \\\\'状态更新成功\\\\'\\\\n      })\\\\n\\\\n      wrapper = createWrapper()\\\\n      await wrapper.vm.$nextTick()\\\\n\\\\n      const menuItem = { ...mockMenuItems[0], available: false }\\\\n      await wrapper.vm.handleStatusChange(menuItem)\\\\n      await wrapper.vm.$nextTick()\\\\n\\\\n      expect(MenuAPI.updateMenuItem).toHaveBeenCalled()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'表单验证\\\\', () => {\\\\n    it(\\\\'应该验证必填字段\\\\', async () => {\\\\n      wrapper = createWrapper()\\\\n      await wrapper.vm.$nextTick()\\\\n\\\\n      wrapper.vm.showCreateDialog = true\\\\n      await wrapper.vm.$nextTick()\\\\n\\\\n      expect(wrapper.vm.formRules.name[0].required).toBe(true)\\\\n      expect(wrapper.vm.formRules.category[0].required).toBe(true)\\\\n      expect(wrapper.vm.formRules.price[0].required).toBe(true)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'格式化功能\\\\', () => {\\\\n    it(\\\\'应该正确格式化日期时间\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      const formattedDate = wrapper.vm.formatDateTime(\\\\'2025-01-15T10:00:00Z\\\\')\\\\n      expect(formattedDate).not.toBe(\\\\'-\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该处理空日期\\\\', () => {\\\\n      wrapper = createWrapper()\\\\n      const formattedDate = wrapper.vm.formatDateTime(undefined)\\\\n      expect(formattedDate).toBe(\\\\'-\\\\')\\\\n    })\\\\n  })\\\\n})\\\\n\",\"originAcceptText\":\"/**\\n * @fileoverview YYC³餐饮管理系统 - MenuManagement组件单元测试\\n * @description 测试MenuManagement组件的功能\\n * @module MenuManagement.test\\n * @author YYC³\\n * @version 1.0.0\\n * @created 2025-01-20\\n */\\n\\nimport { describe, it, expect, beforeEach, vi } from 'vitest'\\nimport { mount, VueWrapper } from '@vue/test-utils'\\nimport { createPinia, setActivePinia } from 'pinia'\\nimport { ref, reactive } from 'vue'\\nimport ElementPlus from 'element-plus'\\nimport MenuManagement from '@/views/MenuManagement.vue'\\nimport { MenuAPI } from '@/api/menu'\\nimport type { MenuItem } from '@/api/menu'\\n\\nvi.mock('@/api/menu', () => ({\\n  MenuAPI: {\\n    getMenuItems: vi.fn(),\\n    createMenuItem: vi.fn(),\\n    updateMenuItem: vi.fn(),\\n    deleteMenuItem: vi.fn()\\n  }\\n}))\\n\\nvi.mock('element-plus', () => ({\\n  default: {\\n    ElMessage: {\\n      success: vi.fn(),\\n      error: vi.fn(),\\n      warning: vi.fn(),\\n      info: vi.fn()\\n    },\\n    ElMessageBox: {\\n      confirm: vi.fn()\\n    }\\n  },\\n  ElMessage: {\\n    success: vi.fn(),\\n    error: vi.fn(),\\n    warning: vi.fn(),\\n    info: vi.fn()\\n  },\\n  ElMessageBox: {\\n    confirm: vi.fn()\\n  }\\n}))\\n\\ndescribe('MenuManagement组件', () => {\\n  let wrapper: VueWrapper<any>\\n  let pinia: any\\n\\n  const mockMenuItems: MenuItem[] = [\\n    {\\n      id: 1,\\n      name: '宫保鸡丁',\\n      description: '经典川菜',\\n      price: 38.00,\\n      category: '小菜',\\n      imageUrl: 'http://example.com/gongbao.jpg',\\n      available: true,\\n      ingredients: ['鸡肉', '花生', '辣椒'],\\n      allergens: ['花生'],\\n      nutritionInfo: {\\n        calories: 280,\\n        protein: 25,\\n        carbs: 15,\\n        fat: 14\\n      },\\n      createdAt: '2025-01-15T10:00:00Z',\\n      updatedAt: '2025-01-15T10:00:00Z'\\n    },\\n    {\\n      id: 2,\\n      name: '番茄牛腩',\\n      description: '营养美味',\\n      price: 58.00,\\n      category: '主食',\\n      imageUrl: 'http://example.com/niu.jpg',\\n      available: true,\\n      ingredients: ['牛肉', '番茄', '洋葱'],\\n      allergens: [],\\n      createdAt: '2025-01-14T09:00:00Z',\\n      updatedAt: '2025-01-14T09:00:00Z'\\n    },\\n    {\\n      id: 3,\\n      name: '冰镇酸梅汤',\\n      description: '消暑饮品',\\n      price: 12.00,\\n      category: '饮料',\\n      available: false,\\n      ingredients: ['乌梅', '山楂', '甘草'],\\n      allergens: [],\\n      createdAt: '2025-01-13T08:00:00Z',\\n      updatedAt: '2025-01-13T08:00:00Z'\\n    }\\n  ]\\n\\n  beforeEach(() => {\\n    pinia = createPinia()\\n    setActivePinia(pinia)\\n\\n    vi.clearAllMocks()\\n\\n    ;(MenuAPI.getMenuItems as any).mockResolvedValue({\\n      success: true,\\n      data: {\\n        items: mockMenuItems,\\n        pagination: {\\n          page: 1,\\n          limit: 20,\\n          total: 3,\\n          totalPages: 1\\n        }\\n      }\\n    })\\n  })\\n\\n  const createWrapper = () => {\\n    return mount(MenuManagement, {\\n      global: {\\n        plugins: [ElementPlus, pinia],\\n        stubs: {\\n          'el-dialog': {\\n            template: '<div class=\\\"el-dialog-mock\\\" v-if=\\\"modelValue\\\"><slot></slot><slot name=\\\"footer\\\"></slot></div>',\\n            props: ['modelValue', 'title'],\\n            emits: ['update:modelValue']\\n          },\\n          'el-table': {\\n            template: '<div class=\\\"el-table-mock\\\"><slot v-for=\\\"item in $slots.default?.[0]?.children\\\" name=\\\"default\\\"></slot></div>',\\n            props: ['data', 'loading', 'rowKey', 'stripe']\\n          },\\n          'el-table-column': {\\n            template: '<div class=\\\"el-table-column-mock\\\"><slot></slot></div>',\\n            props: ['prop', 'label', 'width', 'minWidth', 'fixed']\\n          }\\n        }\\n      }\\n    })\\n  }\\n\\n  describe('初始化渲染', () => {\\n    it('应该正确渲染页面标题', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.find('h1').text()).toBe('菜单管理')\\n    })\\n\\n    it('应该渲染添加菜品按钮', () => {\\n      wrapper = createWrapper()\\n      const addButton = wrapper.find('.el-button--primary')\\n      expect(addButton.text()).toContain('添加菜品')\\n    })\\n\\n    it('应该渲染筛选表单', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.find('.filter-card').exists()).toBe(true)\\n      expect(wrapper.find('input[placeholder=\\\"搜索菜品名称\\\"]').exists()).toBe(true)\\n    })\\n\\n    it('应该渲染菜单列表', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.find('.menu-list-card').exists()).toBe(true)\\n    })\\n\\n    it('应该渲染分页组件', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.find('.pagination-container').exists()).toBe(true)\\n    })\\n  })\\n\\n  describe('数据加载', () => {\\n    it('应该正确加载菜单数据', async () => {\\n      wrapper = createWrapper()\\n      await wrapper.vm.$nextTick()\\n      expect(MenuAPI.getMenuItems).toHaveBeenCalled()\\n      expect(wrapper.vm.menuItems).toHaveLength(3)\\n    })\\n\\n    it('应该正确显示菜单项名称', async () => {\\n      wrapper = createWrapper()\\n      await wrapper.vm.$nextTick()\\n      expect(wrapper.text()).toContain('宫保鸡丁')\\n      expect(wrapper.text()).toContain('番茄牛腩')\\n      expect(wrapper.text()).toContain('冰镇酸梅汤')\\n    })\\n\\n    it('应该正确显示菜单项价格', async () => {\\n      wrapper = createWrapper()\\n      await wrapper.vm.$nextTick()\\n      expect(wrapper.text()).toContain('¥38.00')\\n      expect(wrapper.text()).toContain('¥58.00')\\n      expect(wrapper.text()).toContain('¥12.00')\\n    })\\n\\n    it('应该正确显示菜单项分类标签', async () => {\\n      wrapper = createWrapper()\\n      await wrapper.vm.$nextTick()\\n      expect(wrapper.text()).toContain('小菜')\\n      expect(wrapper.text()).toContain('主食')\\n      expect(wrapper.text()).toContain('饮料')\\n    })\\n  })\\n\\n  describe('状态显示', () => {\\n    it('应该正确显示上架状态', async () => {\\n      wrapper = createWrapper()\\n      await wrapper.vm.$nextTick()\\n      expect(wrapper.text()).toContain('宫保鸡丁')\\n      expect(wrapper.text()).not.toContain('已下架')\\n    })\\n\\n    it('应该正确显示下架状态', async () => {\\n      wrapper = createWrapper()\\n      await wrapper.vm.$nextTick()\\n      expect(wrapper.text()).toContain('冰镇酸梅汤')\\n      expect(wrapper.text()).toContain('已下架')\\n    })\\n  })\\n\\n  describe('筛选功能', () => {\\n    it('应该能够按分类筛选', async () => {\\n      wrapper = createWrapper()\\n      await wrapper.vm.$nextTick()\\n\\n      const categorySelect = wrapper.find('.el-select')\\n      expect(categorySelect.exists()).toBe(true)\\n    })\\n\\n    it('应该能够按状态筛选', async () => {\\n      wrapper = createWrapper()\\n      await wrapper.vm.$nextTick()\\n\\n      const statusSelects = wrapper.findAll('.el-select')\\n      expect(statusSelects.length).toBeGreaterThanOrEqual(2)\\n    })\\n\\n    it('应该能够搜索菜品', async () => {\\n      wrapper = createWrapper()\\n      await wrapper.vm.$nextTick()\\n\\n      const searchInput = wrapper.find('input[placeholder=\\\"搜索菜品名称\\\"]')\\n      expect(searchInput.exists()).toBe(true)\\n    })\\n\\n    it('应该能够重置筛选条件', async () => {\\n      wrapper = createWrapper()\\n      await wrapper.vm.$nextTick()\\n\\n      const resetButton = wrapper.findAll('.el-button').find(btn => btn.text() === '重置')\\n      expect(resetButton).toBeDefined()\\n    })\\n  })\\n\\n  describe('分页功能', () => {\\n    it('应该正确初始化分页', () => {\\n      wrapper = createWrapper()\\n      expect(wrapper.vm.pagination.page).toBe(1)\\n      expect(wrapper.vm.pagination.limit).toBe(20)\\n    })\\n\\n    it('应该能够切换页码', async () => {\\n      wrapper = createWrapper()\\n      await wrapper.vm.$nextTick()\\n\\n      ;(MenuAPI.getMenuItems as any).mockResolvedValue({\\n        success: true,\\n        data: {\\n          items: mockMenuItems.slice(0, 2),\\n          pagination: {\\n            page: 2,\\n            limit: 20,\\n            total: 3,\\n            totalPages: 1\\n          }\\n        }\\n      })\\n\\n      wrapper.vm.pagination.page = 2\\n      await wrapper.vm.$nextTick()\\n      expect(MenuAPI.getMenuItems).toHaveBeenCalled()\\n    })\\n  })\\n\\n  describe('创建功能', () => {\\n    it('应该能够打开创建对话框', async () => {\\n      wrapper = createWrapper()\\n      await wrapper.vm.$nextTick()\\n\\n      const addButton = wrapper.find('.el-button--primary')\\n      await addButton.trigger('click')\\n\\n      expect(wrapper.vm.showCreateDialog).toBe(true)\\n    })\\n\\n    it('创建对话框应该包含表单字段', async () => {\\n      wrapper = createWrapper()\\n      await wrapper.vm.$nextTick()\\n\\n      wrapper.vm.showCreateDialog = true\\n      await wrapper.vm.$nextTick()\\n\\n      expect(wrapper.text()).toContain('菜品名称')\\n      expect(wrapper.text()).toContain('菜品分类')\\n      expect(wrapper.text()).toContain('价格')\\n      expect(wrapper.text()).toContain('描述')\\n    })\\n\\n    it('应该能够创建新菜品', async () => {\\n      ;(MenuAPI.createMenuItem as any).mockResolvedValue({\\n        success: true,\\n        message: '创建: {\\n          id: 4,\\n          name: '成功',\\n        data新菜品',\\n          description: '新菜品描述',\\n          price: 25.00,\\n          category: '小菜',\\n          available: true,\\n          ingredients: [],\\n          allergens: [],\\n          createdAt: new Date().toISOString(),\\n          updatedAt: new Date().toISOString()\\n        }\\n      })\\n\\n      wrapper = createWrapper()\\n      await wrapper.vm.$nextTick()\\n\\n      wrapper.vm.showCreateDialog = true\\n      await wrapper.vm.$nextTick()\\n\\n      Object.assign(wrapper.vm.formData, {\\n        name: '新菜品',\\n        category: '小菜',\\n        price: 25.00,\\n        description: '新菜品描述',\\n        available: true\\n      })\\n\\n      const submitButton = wrapper.findAll('.el-button').find(btn => btn.text() === '创建')\\n      expect(submitButton).toBeDefined()\\n    })\\n  })\\n\\n  describe('编辑功能', () => {\\n    it('应该能够打开编辑对话框', async () => {\\n      wrapper = createWrapper()\\n      await wrapper.vm.$nextTick()\\n\\n      const editButtons = wrapper.findAll('.el-button--default')\\n      const editButton = editButtons.find(btn => btn.text().includes('编辑'))\\n      expect(editButton).toBeDefined()\\n    })\\n  })\\n\\n  describe('删除功能', () => {\\n    it('应该能够打开删除确认', async () => {\\n      ;(ElMessageBox.confirm as any).mockResolvedValue(true)\\n\\n      wrapper = createWrapper()\\n      await wrapper.vm.$nextTick()\\n\\n      const deleteButtons = wrapper.findAll('.el-button--danger')\\n      expect(deleteButtons.length).toBeGreaterThanOrEqual(1)\\n    })\\n\\n    it('删除确认后应该调用删除API', async () => {\\n      ;(ElMessageBox.confirm as any).mockResolvedValue(true)\\n      ;(MenuAPI.deleteMenuItem as any).mockResolvedValue({\\n        success: true,\\n        message: '删除成功'\\n      })\\n\\n      wrapper = createWrapper()\\n      await wrapper.vm.$nextTick()\\n\\n      wrapper.vm.handleDelete(mockMenuItems[0])\\n      await wrapper.vm.$nextTick()\\n\\n      expect(MenuAPI.deleteMenuItem).toHaveBeenCalledWith(1)\\n    })\\n  })\\n\\n  describe('状态切换', () => {\\n    it('应该能够切换菜品状态', async () => {\\n      ;(MenuAPI.updateMenuItem as any).mockResolvedValue({\\n        success: true,\\n        message: '状态更新成功'\\n      })\\n\\n      wrapper = createWrapper()\\n      await wrapper.vm.$nextTick()\\n\\n      const menuItem = { ...mockMenuItems[0], available: false }\\n      await wrapper.vm.handleStatusChange(menuItem)\\n      await wrapper.vm.$nextTick()\\n\\n      expect(MenuAPI.updateMenuItem).toHaveBeenCalled()\\n    })\\n  })\\n\\n  describe('表单验证', () => {\\n    it('应该验证必填字段', async () => {\\n      wrapper = createWrapper()\\n      await wrapper.vm.$nextTick()\\n\\n      wrapper.vm.showCreateDialog = true\\n      await wrapper.vm.$nextTick()\\n\\n      expect(wrapper.vm.formRules.name[0].required).toBe(true)\\n      expect(wrapper.vm.formRules.category[0].required).toBe(true)\\n      expect(wrapper.vm.formRules.price[0].required).toBe(true)\\n    })\\n  })\\n\\n  describe('格式化功能', () => {\\n    it('应该正确格式化日期时间', () => {\\n      wrapper = createWrapper()\\n      const formattedDate = wrapper.vm.formatDateTime('2025-01-15T10:00:00Z')\\n      expect(formattedDate).not.toBe('-')\\n    })\\n\\n    it('应该处理空日期', () => {\\n      wrapper = createWrapper()\\n      const formattedDate = wrapper.vm.formatDateTime(undefined)\\n      expect(formattedDate).toBe('-')\\n    })\\n  })\\n})\\n\",\"originTextLength\":11351,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768895988553},{\"originRange\":{\"start\":{\"line\":313,\"character\":0},\"end\":{\"line\":314,\"character\":15}},\"modifyRange\":{\"start\":{\"line\":313,\"character\":0},\"end\":{\"line\":314,\"character\":15}},\"action\":\"None\",\"isLine\":false,\"originText\":\"        message: \\\\'创建成功\\\\',\\\\n        data: {\",\"originAcceptText\":\"        message: '创建成功',\\n        data: {\",\"originTextLength\":40,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768896058316},{\"originRange\":{\"start\":{\"line\":315,\"character\":0},\"end\":{\"line\":315,\"character\":22}},\"modifyRange\":{\"start\":{\"line\":315,\"character\":0},\"end\":{\"line\":315,\"character\":22}},\"action\":\"None\",\"isLine\":false,\"originText\":\"          name: \\\\'新菜品\\\\',\",\"originAcceptText\":\"          name: '新菜品',\",\"originTextLength\":22,\"aiScene\":\"b