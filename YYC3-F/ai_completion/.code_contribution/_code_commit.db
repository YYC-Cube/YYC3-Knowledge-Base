\":{\"line\":161,\"character\":84}},\"action\":\"None\",\"isLine\":false,\"originText\":\"    // 呼叫前智能准备（缓存优化）\\\\n    const preparation = await this.preCallIntelligenceOptimized(customer, campaign);\",\"originAcceptText\":\"    // 呼叫前智能准备（缓存优化）\\n    const preparation = await this.preCallIntelligenceOptimized(customer, campaign);\",\"originTextLength\":105,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1767733178366},{\"originRange\":{\"start\":{\"line\":163,\"character\":0},\"end\":{\"line\":164,\"character\":79}},\"modifyRange\":{\"start\":{\"line\":163,\"character\":0},\"end\":{\"line\":164,\"character\":79}},\"action\":\"None\",\"isLine\":false,\"originText\":\"    // 呼叫中实时辅助（流式处理）\\\\n    const callExecution = await this.duringCallAssistanceStreamed(preparation);\",\"originAcceptText\":\"    // 呼叫中实时辅助（流式处理）\\n    const callExecution = await this.duringCallAssistanceStreamed(preparation);\",\"originTextLength\":100,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1767733178374},{\"originRange\":{\"start\":{\"line\":166,\"character\":0},\"end\":{\"line\":167,\"character\":71}},\"modifyRange\":{\"start\":{\"line\":166,\"character\":0},\"end\":{\"line\":167,\"character\":71}},\"action\":\"None\",\"isLine\":false,\"originText\":\"    // 呼叫后智能处理（异步处理）\\\\n    const postCall = await this.postCallProcessingAsync(callExecution);\",\"originAcceptText\":\"    // 呼叫后智能处理（异步处理）\\n    const postCall = await this.postCallProcessingAsync(callExecution);\",\"originTextLength\":92,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1767733178382},{\"originRange\":{\"start\":{\"line\":169,\"character\":0},\"end\":{\"line\":170,\"character\":77}},\"modifyRange\":{\"start\":{\"line\":169,\"character\":0},\"end\":{\"line\":170,\"character\":77}},\"action\":\"None\",\"isLine\":false,\"originText\":\"    // 数据闭环与优化（批量处理）\\\\n    const optimization = await this.learningAndOptimizationBatched(postCall);\",\"originAcceptText\":\"    