el-timeline-item>\\\\n            </el-timeline>\\\\n          </el-card>\\\\n        </el-col>\\\\n\\\\n        <el-col :span=\\\\\\\"8\\\\\\\">\\\\n          <el-card>\\\\n            <template #header>\\\\n              <span>关键洞察</span>\\\\n            </template>\\\\n\\\\n            <div class=\\\\\\\"insights-list\\\\\\\">\\\\n              <div\\\\n                v-for=\\\\\\\"insight in insights\\\\\\\"\\\\n                :key=\\\\\\\"insight.id\\\\\\\"\\\\n                class=\\\\\\\"insight-item\\\\\\\"\\\\n                :class=\\\\\\\"insight.type\\\\\\\"\\\\n              >\\\\n                <div class=\\\\\\\"insight-icon\\\\\\\">\\\\n                  <el-icon>\\\\n                    <component :is=\\\\\\\"insight.icon\\\\\\\" />\\\\n                  </el-icon>\\\\n                </div>\\\\n                <div class=\\\\\\\"insight-content\\\\\\\">\\\\n                  <div class=\\\\\\\"insight-title\\\\\\\">{{ insight.title }}</div>\\\\n                  <div class=\\\\\\\"insight-description\\\\\\\">{{ insight.description }}</div>\\\\n                </div>\\\\n              </div>\\\\n            </div>\\\\n          </el-card>\\\\n        </el-col>\\\\n      </el-row>\\\\n\\\\n      <el-row :gutter=\\\\\\\"20\\\\\\\" style=\\\\\\\"margin-top: 20px\\\\\\\">\\\\n        <el-col :span=\\\\\\\"12\\\\\\\">\\\\n          <el-card>\\\\n            <template #header>\\\\n              <span>价值验证</span>\\\\n            </template>\\\\n\\\\n            <div class=\\\\\\\"value-validation\\\\\\\">\\\\n              <el-descriptions :column=\\\\\\\"2\\\\\\\" border>\\\\n                <el-descriptions-item label=\\\\\\\"开发成本\\\\\\\">\\\\n                  ¥{{ valueValidation.developmentCost.toLocaleString() }}\\\\n                </el-descriptions-item>\\\\n                <el-descriptions-item label=\\\\\\\"年度收益\\\\\\\">\\\\n                  ¥{{ valueValidation.annualRevenue.toLocaleString() }}\\\\n                </el-descriptions-item>\\\\n                <el-descriptions-item label=\\\\\\\"回报周期\\\\\\\">\\\\n                  {{ valueValidation.paybackPeriod }} 个月\\\\n                </el-descriptions-item>\\\\n                <el-descriptions-item label=\\\\\\\"NPV (3年)\\\\\\\">\\\\n                  ¥{{ valueValidation.npv.toLocaleString() }}\\\\n                </el-descriptions-item>\\\\n                <el-descriptions-item label=\\\\\\\"投资回报率\\\\\\\">\\\\n                  {{ valueValidation.roi }}%\\\\n                </el-descriptions-item>\\\\n                <el-descriptions-item label=\\\\\\\"采用率\\\\\\\">\\\\n                  {{ valueValidation.adoptionRate }}%\\\\n                </el-descriptions-item>\\\\n              </el-descriptions>\\\\n            </div>\\\\n          </el-card>\\\\n        </el-col>\\\\n\\\\n        <el-col :span=\\\\\\\"12\\\\\\\">\\\\n          <el-card>\\\\n            <template #header>\\\\n              <span>下一周期规划</span>\\\\n            </template>\\\\n\\\\n            <div class=\\\\\\\"next-cycle\\\\\\\">\\\\n              <el-form label-width=\\\\\\\"100px\\\\\\\">\\\\n                <el-form-item label=\\\\\\\"聚焦领域\\\\\\\">\\\\n                  <el-tag\\\\n                    v-for=\\\\\\\"focus in nextCycle.focus\\\\\\\"\\\\n                    :key=\\\\\\\"focus\\\\\\\"\\\\n                    style=\\\\\\\"margin-right: 8px\\\\\\\"\\\\n                  >\\\\n                    {{ focus }}\\\\n                  </el-tag>\\\\n                </el-form-item>\\\\n\\\\n                <el-form-item label=\\\\\\\"成功标准\\\\\\\">\\\\n                  <ul>\\\\n                    <li v-for=\\\\\\\"criterion in nextCycle.successCriteria\\\\\\\" :key=\\\\\\\"criterion\\\\\\\">\\\\n                      {{ criterion }}\\\\n                    </li>\\\\n                  </ul>\\\\n                </el-form-item>\\\\n\\\\n                <el-form-item label=\\\\\\\"资源分配\\\\\\\">\\\\n                  <el-progress\\\\n                    :percentage=\\\\\\\"nextCycle.resourceAllocation\\\\\\\"\\\\n                    :color=\\\\\\\"[\\\\'#409eff\\\\', \\\\'#67c23a\\\\', \\\\'#e6a23c\\\\']\\\\\\\"\\\\n                  />\\\\n                </el-form-item>\\\\n\\\\n                <el-form-item label=\\\\\\\"预计完成\\\\\\\">\\\\n                  <el-date-picker\\\\n                    v-model=\\\\\\\"nextCycle.estimatedCompletion\\\\\\\"\\\\n                    type=\\\\\\\"date\\\\\\\"\\\\n                    placeholder=\\\\\\\"选择日期\\\\\\\"\\\\n                    disabled\\\\n                  />\\\\n                </el-form-item>\\\\n              </el-form>\\\\n            </div>\\\\n          </el-card>\\\\n        </el-col>\\\\n      </el-row>\\\\n    </div>\\\\n  </div>\\\\n</template>\\\\n\\\\n<script setup lang=\\\\\\\"ts\\\\\\\">\\\\nimport { ref } from \\\\'vue\\\\'\\\\nimport { useRouter } from \\\\'vue-router\\\\'\\\\nimport {\\\\n  DataAnalysis,\\\\n  TrendCharts,\\\\n  Money,\\\\n  User,\\\\n  Lightning,\\\\n  ArrowUp,\\\\n  VideoPlay,\\\\n  CircleCheck,\\\\n  Warning,\\\\n  InfoFilled,\\\\n} from \\\\'@element-plus/icons-vue\\\\'\\\\nimport { ElMessage } from \\\\'element-plus\\\\'\\\\n\\\\nconst router = useRouter()\\\\n\\\\nconst metrics = ref({\\\\n  goalCompletion: 78,\\\\n  goalChange: 13,\\\\n  goalTrend: \\\\'up\\\\',\\\\n  roiScore: 72,\\\\n  roiChange: 12,\\\\n  roiTrend: \\\\'up\\\\',\\\\n  userSatisfaction: 4.6,\\\\n  satisfactionChange: 0.4,\\\\n  satisfactionTrend: \\\\'up\\\\',\\\\n  learningSpeed: 85,\\\\n  learningChange: 8,\\\\n  learningTrend: \\\\'up\\\\',\\\\n})\\\\n\\\\nconst isExecuting = ref(false)\\\\n\\\\nconst cycles = ref([\\\\n  {\\\\n    id: \\\\'1\\\\',\\\\n    title: \\\\'周期 #1\\\\',\\\\n    description: \\\\'初始优化周期，完成基础功能验证\\\\',\\\\n    timestamp: \\\\'2024-12-15\\\\',\\\\n    status: \\\\'success\\\\',\\\\n    goalCompletion: 78,\\\\n    roiScore: 72,\\\\n    satisfaction: 4.6,\\\\n  },\\\\n  {\\\\n    id: \\\\'2\\\\',\\\\n    title: \\\\'周期 #2\\\\',\\\\n    description: \\\\'性能优化周期，提升系统响应速度\\\\',\\\\n    timestamp: \\\\'2024-12-29\\\\',\\\\n    status: \\\\'primary\\\\',\\\\n    goalCompletion: 85,\\\\n    roiScore: 78,\\\\n    satisfaction: 4.7,\\\\n  },\\\\n])\\\\n\\\\nconst insights = ref([\\\\n  {\\\\n    id: \\\\'1\\\\',\\\\n    type: \\\\'success\\\\',\\\\n    icon: CircleCheck,\\\\n    title: \\\\'AI智能化能力领先\\\\',\\\\n    description: \\\\'AI助手准确率达到92%，用户满意度提升15%\\\\',\\\\n  },\\\\n  {\\\\n    id: \\\\'2\\\\',\\\\n    type: \\\\'warning\\\\',\\\\n    icon: Warning,\\\\n    title: \\\\'移动端体验待优化\\\\',\\\\n    description: \\\\'移动端加载时间较长，建议进行性能优化\\\\',\\\\n  },\\\\n  {\\\\n    id: \\\\'3\\\\',\\\\n    type: \\\\'info\\\\',\\\\n    icon: InfoFilled,\\\\n    title: \\\\'批量操作需求增加\\\\',\\\\n    description: \\\\'用户反馈需要更多批量操作功能\\\\',\\\\n  },\\\\n])\\\\n\\\\nconst valueValidation = ref({\\\\n  developmentCost: 1030000,\\\\n  annualRevenue: 1250000,\\\\n  paybackPeriod: 10,\\\\n  npv: 2100000,\\\\n  roi: 121,\\\\n  adoptionRate: 87.5,\\\\n})\\\\n\\\\nconst nextCycle = ref({\\\\n  focus: [\\\\'移动端优化\\\\', \\\\'批量操作\\\\', \\\\'报表定制\\\\'],\\\\n  successCriteria: [\\\\n    \\\\'移动端加载时间 < 2秒\\\\',\\\\n    \\\\'批量操作覆盖80%场景\\\\',\\\\n    \\\\'报表定制功能上线\\\\',\\\\n  ],\\\\n  resourceAllocation: 85,\\\\n  estimatedCompletion: new Date(\\\\'2025-01-15\\\\'),\\\\n})\\\\n\\\\nconst goBack = () => {\\\\n  router.back()\\\\n}\\\\n\\\\nconst executeCycle = async () => {\\\\n  isExecuting.value = true\\\\n\\\\n  try {\\\\n    await new Promise(resolve => setTimeout(resolve, 2000))\\\\n\\\\n    ElMessage.success(\\\\'新周期执行成功！\\\\')\\\\n\\\\n    cycles.value.unshift({\\\\n      id: String(cycles.value.length + 1),\\\\n      title: `周期 #${cycles.value.length + 1}`,\\\\n      description: \\\\'自动执行的新优化周期\\\\',\\\\n      timestamp: new Date().toISOString().split(\\\\'T\\\\')[0],\\\\n      status: \\\\'primary\\\\',\\\\n      goalCompletion: 82,\\\\n      roiScore: 75,\\\\n      satisfaction: 4.7,\\\\n    })\\\\n  } catch (error) {\\\\n    console.error(\\\\'Execute cycle error:\\\\', error)\\\\n    ElMessage.error(\\\\'周期执行失败，请稍后再试\\\\')\\\\n  } finally {\\\\n    isExecuting.value = false\\\\n  }\\\\n}\\\\n</script>\\\\n\\\\n<style scoped>\\\\n.closed-loop-management {\\\\n  padding: 24px;\\\\n}\\\\n\\\\n.page-header-content {\\\\n  display: flex;\\\\n  align-items: center;\\\\n  gap: 8px;\\\\n  font-size: 18px;\\\\n  font-weight: 600;\\\\n}\\\\n\\\\n.management-content {\\\\n  margin-top: 24px;\\\\n}\\\\n\\\\n.metric-card {\\\\n  height: 120px;\\\\n}\\\\n\\\\n.metric-content {\\\\n  display: flex;\\\\n  align-items: center;\\\\n  gap: 16px;\\\\n}\\\\n\\\\n.metric-icon {\\\\n  width: 56px;\\\\n  height: 56px;\\\\n  border-radius: 12px;\\\\n  display: flex;\\\\n  align-items: center;\\\\n  justify-content: center;\\\\n  font-size: 24px;\\\\n}\\\\n\\\\n.metric-icon.success {\\\\n  background: #d1fae5;\\\\n  color: #059669;\\\\n}\\\\n\\\\n.metric-icon.primary {\\\\n  background: #dbeafe;\\\\n  color: #2563eb;\\\\n}\\\\n\\\\n.metric-icon.warning {\\\\n  background: #fef3c7;\\\\n  color: #d97706;\\\\n}\\\\n\\\\n.metric-icon.info {\\\\n  background: #e0e7ff;\\\\n  color: #4f46e5;\\\\n}\\\\n\\\\n.metric-info {\\\\n  flex: 1;\\\\n}\\\\n\\\\n.metric-value {\\\\n  font-size: 28px;\\\\n  font-weight: 700;\\\\n  color: #1f2937;\\\\n}\\\\n\\\\n.metric-label {\\\\n  font-size: 14px;\\\\n  color: #6b7280;\\\\n  margin-top: 4px;\\\\n}\\\\n\\\\n.metric-trend {\\\\n  font-size: 12px;\\\\n  margin-top: 4px;\\\\n  display: flex;\\\\n  align-items: center;\\\\n  gap: 2px;\\\\n}\\\\n\\\\n.metric-trend.up {\\\\n  color: #059669;\\\\n}\\\\n\\\\n.metric-trend.down {\\\\n  color: #dc2626;\\\\n}\\\\n\\\\n.card-header {\\\\n  display: flex;\\\\n  justify-content: space-between;\\\\n  align-items: center;\\\\n}\\\\n\\\\n.cycle-item {\\\\n  padding: 8px 0;\\\\n}\\\\n\\\\n.cycle-title {\\\\n  font-weight: 600;\\\\n  margin-bottom: 4px;\\\\n}\\\\n\\\\n.cycle-description {\\\\n  color: #6b7280;\\\\n  font-size: 14px;\\\\n  margin-bottom: 8px;\\\\n}\\\\n\\\\n.cycle-metrics {\\\\n  display: flex;\\\\n  gap: 8px;\\\\n}\\\\n\\\\n.insights-list {\\\\n  display: flex;\\\\n  flex-direction: column;\\\\n  gap: 12px;\\\\n}\\\\n\\\\n.insight-item {\\\\n  display: flex;\\\\n  gap: 12px;\\\\n  padding: 12px;\\\\n  border-radius: 8px;\\\\n  background: #f9fafb;\\\\n}\\\\n\\\\n.insight-item.success {\\\\n  background: #ecfdf5;\\\\n  border-left: 4px solid #10b981;\\\\n}\\\\n\\\\n.insight-item.warning {\\\\n  background: #fffbeb;\\\\n  border-left: 4px solid #f59e0b;\\\\n}\\\\n\\\\n.insight-item.info {\\\\n  background: #eff6ff;\\\\n  border-left: 4px solid #3b82f6;\\\\n}\\\\n\\\\n.insight-icon {\\\\n  font-size: 20px;\\\\n  margin-top: 2px;\\\\n}\\\\n\\\\n.insight-content {\\\\n  flex: 1;\\\\n}\\\\n\\\\n.insight-title {\\\\n  font-weight: 600;\\\\n  margin-bottom: 4px;\\\\n}\\\\n\\\\n.insight-description {\\\\n  font-size: 14px;\\\\n  color: #6b7280;\\\\n}\\\\n\\\\n.value-validation {\\\\n  padding: 16px;\\\\n}\\\\n\\\\n.next-cycle {\\\\n  padding: 16px;\\\\n}\\\\n\\\\n.next-cycle ul {\\\\n  list-style: none;\\\\n  padding: 0;\\\\n  margin: 0;\\\\n}\\\\n\\\\n.next-cycle li {\\\\n  padding: 4px 0;\\\\n  color: #6b7280;\\\\n}\\\\n</style>\\\\n\",\"originAcceptText\":\"<template>\\n  <div class=\\\"closed-loop-management\\\">\\n    <el-page-header @back=\\\"goBack\\\" title=\\\"闭环管理\\\">\\n      <template #content>\\n        <div class=\\\"page-header-content\\\">\\n          <el-icon><DataAnalysis /></el-icon>\\n          <span>闭环价值创造与优化系统</span>\\n        </div>\\n      </template>\\n    </el-page-header>\\n\\n    <div class=\\\"management-content\\\">\\n      <el-row :gutter=\\\"20\\\">\\n        <el-col :span=\\\"6\\\">\\n          <el-card class=\\\"metric-card\\\">\\n            <div class=\\\"metric-content\\\">\\n              <div class=\\\"metric-icon success\\\">\\n                <el-icon><TrendCharts /></el-icon>\\n              </div>\\n              <div class=\\\"metric-info\\\">\\n                <div class=\\\"metric-value\\\">{{ metrics.goalCompletion }}%</div>\\n                <div class=\\\"metric-label\\\">目标完成度</div>\\n                <div class=\\\"metric-trend\\\" :class=\\\"metrics.goalTrend\\\">\\n                  <el-icon><ArrowUp /></el-icon>\\n                  +{{ metrics.goalChange }}%\\n                </div>\\n              </div>\\n            </div>\\n          </el-card>\\n        </el-col>\\n\\n        <el-col :span=\\\"6\\\">\\n          <el-card class=\\\"metric-card\\\">\\n            <div class=\\\"metric-content\\\">\\n              <div class=\\\"metric-icon primary\\\">\\n                <el-icon><Money /></el-icon>\\n              </div>\\n              <div class=\\\"metric-info\\\">\\n                <div class=\\\"metric-value\\\">{{ metrics.roiScore }}</div>\\n                <div class=\\\"metric-label\\\">ROI 分数</div>\\n                <div class=\\\"metric-trend\\\" :class=\\\"metrics.roiTrend\\\">\\n                  <el-icon><ArrowUp /></el-icon>\\n                  +{{ metrics.roiChange }}\\n                </div>\\n              </div>\\n            </div>\\n          </el-card>\\n        </el-col>\\n\\n        <el-col :span=\\\"6\\\">\\n          <el-card class=\\\"metric-card\\\">\\n            <div class=\\\"metric-content\\\">\\n              <div class=\\\"metric-icon warning\\\">\\n                <el-icon><User /></el-icon>\\n              </div>\\n              <div class=\\\"metric-info\\\">\\n                <div class=\\\"metric-value\\\">{{ metrics.userSatisfaction }}/5</div>\\n                <div class=\\\"metric-label\\\">用户满意度</div>\\n                <div class=\\\"metric-trend\\\" :class=\\\"metrics.satisfactionTrend\\\">\\n                  <el-icon><ArrowUp /></el-icon>\\n                  +{{ metrics.satisfactionChange }}\\n                </div>\\n              </div>\\n            </div>\\n          </el-card>\\n        </el-col>\\n\\n        <el-col :span=\\\"6\\\">\\n          <el-card class=\\\"metric-card\\\">\\n            <div class=\\\"metric-content\\\">\\n              <div class=\\\"metric-icon info\\\">\\n                <el-icon><Lightning /></el-icon>\\n              </div>\\n              <div class=\\\"metric-info\\\">\\n                <div class=\\\"metric-value\\\">{{ metrics.learningSpeed }}%</div>\\n                <div class=\\\"metric-label\\\">学习速度</div>\\n                <div class=\\\"metric-trend\\\" :class=\\\"metrics.learningTrend\\\">\\n                  <el-icon><ArrowUp /></el-icon>\\n                  +{{ metrics.learningChange }}%\\n                </div>\\n              </div>\\n            </div>\\n          </el-card>\\n        </el-col>\\n      </el-row>\\n\\n      <el-row :gutter=\\\"20\\\" style=\\\"margin-top: 20px\\\">\\n        <el-col :span=\\\"16\\\">\\n          <el-card>\\n            <template #header>\\n              <div class=\\\"card-header\\\">\\n                <span>周期执行监控</span>\\n                <el-button type=\\\"primary\\\" @click=\\\"executeCycle\\\" :loading=\\\"isExecuting\\\">\\n                  <el-icon><VideoPlay /></el-icon>\\n                  执行新周期\\n                </el-button>\\n              </div>\\n            </template>\\n\\n            <el-timeline>\\n              <el-timeline-item\\n                v-for=\\\"cycle in cycles\\\"\\n                :key=\\\"cycle.id\\\"\\n                :timestamp=\\\"cycle.timestamp\\\"\\n                :type=\\\"cycle.status\\\"\\n              >\\n                <div class=\\\"cycle-item\\\">\\n                  <div class=\\\"cycle-title\\\">{{ cycle.title }}</div>\\n                  <div class=\\\"cycle-description\\\">{{ cycle.description }}</div>\\n                  <div class=\\\"cycle-metrics\\\">\\n                    <el-tag size=\\\"small\\\">目标: {{ cycle.goalCompletion }}%</el-tag>\\n                    <el-tag size=\\\"small\\\" type=\\\"success\\\">ROI: {{ cycle.roiScore }}</el-tag>\\n                    <el-tag size=\\\"small\\\" type=\\\"warning\\\">满意度: {{ cycle.satisfaction }}/5</el-tag>\\n                  </div>\\n                </div>\\n              </el-timeline-item>\\n            </el-timeline>\\n          </el-card>\\n        </el-col>\\n\\n        <el-col :span=\\\"8\\\">\\n          <el-card>\\n            <template #header>\\n              <span>关键洞察</span>\\n            </template>\\n\\n            <div class=\\\"insights-list\\\">\\n              <div\\n                v-for=\\\"insight in insights\\\"\\n                :key=\\\"insight.id\\\"\\n                class=\\\"insight-item\\\"\\n                :class=\\\"insight.type\\\"\\n              >\\n                <div class=\\\"insight-icon\\\">\\n                  <el-icon>\\n                    <component :is=\\\"insight.icon\\\" />\\n                  </el-icon>\\n                </div>\\n                <div class=\\\"insight-content\\\">\\n                  <div class=\\\"insight-title\\\">{{ insight.title }}</div>\\n                  <div class=\\\"insight-description\\\">{{ insight.description }}</div>\\n                </div>\\n              </div>\\n            </div>\\n          </el-card>\\n        </el-col>\\n      </el-row>\\n\\n      <el-row :gutter=\\\"20\\\" style=\\\"margin-top: 20px\\\">\\n        <el-col :span=\\\"12\\\">\\n          <el-card>\\n            <template #header>\\n              <span>价值验证</span>\\n            </template>\\n\\n            <div class=\\\"value-validation\\\">\\n              <el-descriptions :column=\\\"2\\\" border>\\n                <el-descriptions-item label=\\\"开发成本\\\">\\n                  ¥{{ valueValidation.developmentCost.toLocaleString() }}\\n                </el-descriptions-item>\\n                <el-descriptions-item label=\\\"年度收益\\\">\\n                  ¥{{ valueValidation.annualRevenue.toLocaleString() }}\\n                </el-descriptions-item>\\n                <el-descriptions-item label=\\\"回报周期\\\">\\n                  {{ valueValidation.paybackPeriod }} 个月\\n                </el-descriptions-item>\\n                <el-descriptions-item label=\\\"NPV (3年)\\\">\\n                  ¥{{ valueValidation.npv.toLocaleString() }}\\n                </el-descriptions-item>\\n                <el-descriptions-item label=\\\"投资回报率\\\">\\n                  {{ valueValidation.roi }}%\\n                </el-descriptions-item>\\n                <el-descriptions-item label=\\\"采用率\\\">\\n                  {{ valueValidation.adoptionRate }}%\\n                </el-descriptions-item>\\n              </el-descriptions>\\n            </div>\\n          </el-card>\\n        </el-col>\\n\\n        <el-col :span=\\\"12\\\">\\n          <el-card>\\n            <template #header>\\n              <span>下一周期规划</span>\\n            </template>\\n\\n            <div class=\\\"next-cycle\\\">\\n              <el-form label-width=\\\"100px\\\">\\n                <el-form-item label=\\\"聚焦领域\\\">\\n                  <el-tag\\n                    v-for=\\\"focus in nextCycle.focus\\\"\\n                    :key=\\\"focus\\\"\\n                    style=\\\"margin-right: 8px\\\"\\n                  >\\n                    {{ focus }}\\n                  </el-tag>\\n                </el-form-item>\\n\\n                <el-form-item label=\\\"成功标准\\\">\\n                  <ul>\\n                    <li v-for=\\\"criterion in nextCycle.successCriteria\\\" :key=\\\"criterion\\\">\\n                      {{ criterion }}\\n                    </li>\\n                  </ul>\\n                </el-form-item>\\n\\n                <el-form-item label=\\\"资源分配\\\">\\n                  <el-progress\\n                    :percentage=\\\"nextCycle.resourceAllocation\\\"\\n                    :color=\\\"['#409eff', '#67c23a', '#e6a23c']\\\"\\n                  />\\n                </el-form-item>\\n\\n                <el-form-item label=\\\"预计完成\\\">\\n                  <el-date-picker\\n                    v-model=\\\"nextCycle.estimatedCompletion\\\"\\n                    type=\\\"date\\\"\\n                    placeholder=\\\"选择日期\\\"\\n                    disabled\\n                  />\\n                </el-form-item>\\n              </el-form>\\n            </div>\\n          </el-card>\\n        </el-col>\\n      </el-row>\\n    </div>\\n  </div>\\n</template>\\n\\n<script setup lang=\\\"ts\\\">\\nimport { ref } from 'vue'\\nimport { useRouter } from 'vue-router'\\nimport {\\n  DataAnalysis,\\n  TrendCharts,\\n  Money,\\n  User,\\n  Lightning,\\n  ArrowUp,\\n  VideoPlay,\\n  CircleCheck,\\n  Warning,\\n  InfoFilled,\\n} from '@element-plus/icons-vue'\\nimport { ElMessage } from 'element-plus'\\n\\nconst router = useRouter()\\n\\nconst metrics = ref({\\n  goalCompletion: 78,\\n  goalChange: 13,\\n  goalTrend: 'up',\\n  roiScore: 72,\\n  roiChange: 12,\\n  roiTrend: 'up',\\n  userSatisfaction: 4.6,\\n  satisfactionChange: 0.4,\\n  satisfactionTrend: 'up',\\n  learningSpeed: 85,\\n  learningChange: 8,\\n  learningTrend: 'up',\\n})\\n\\nconst isExecuting = ref(false)\\n\\nconst cycles = ref([\\n  {\\n    id: '1',\\n    title: '周期 #1',\\n    description: '初始优化周期，完成基础功能验证',\\n    timestamp: '2024-12-15',\\n    status: 'success',\\n    goalCompletion: 78,\\n    roiScore: 72,\\n    satisfaction: 4.6,\\n  },\\n  {\\n    id: '2',\\n    title: '周期 #2',\\n    description: '性能优化周期，提升系统响应速度',\\n    timestamp: '2024-12-29',\\n    status: 'primary',\\n    goalCompletion: 85,\\n    roiScore: 78,\\n    satisfaction: 4.7,\\n  },\\n])\\n\\nconst insights = ref([\\n  {\\n    id: '1',\\n    type: 'success',\\n    icon: CircleCheck,\\n    title: 'AI智能化能力领先',\\n    description: 'AI助手准确率达到92%，用户满意度提升15%',\\n  },\\n  {\\n    id: '2',\\n    type: 'warning',\\n    icon: Warning,\\n    title: '移动端体验待优化',\\n    description: '移动端加载时间较长，建议进行性能优化',\\n  },\\n  {\\n    id: '3',\\n    type: 'info',\\n    icon: InfoFilled,\\n    title: '批量操作需求增加',\\n    description: '用户反馈需要更多批量操作功能',\\n  },\\n])\\n\\nconst valueValidation = ref({\\n  developmentCost: 1030000,\\n  annualRevenue: 1250000,\\n  paybackPeriod: 10,\\n  npv: 2100000,\\n  roi: 121,\\n  adoptionRate: 87.5,\\n})\\n\\nconst nextCycle = ref({\\n  focus: ['移动端优化', '批量操作', '报表定制'],\\n  successCriteria: [\\n    '移动端加载时间 < 2秒',\\n    '批量操作覆盖80%场景',\\n    '报表定制功能上线',\\n  ],\\n  resourceAllocation: 85,\\n  estimatedCompletion: new Date('2025-01-15'),\\n})\\n\\nconst goBack = () => {\\n  router.back()\\n}\\n\\nconst executeCycle = async () => {\\n  isExecuting.value = true\\n\\n  try {\\n    await new Promise(resolve => setTimeout(resolve, 2000))\\n\\n    ElMessage.success('新周期执行成功！')\\n\\n    cycles.value.unshift({\\n      id: String(cycles.value.length + 1),\\n      title: `周期 #${cycles.value.length + 1}`,\\n      description: '自动执行的新优化周期',\\n      timestamp: new Date().toISOString().split('T')[0],\\n      status: 'primary',\\n      goalCompletion: 82,\\n      roiScore: 75,\\n      satisfaction: 4.7,\\n    })\\n  } catch (error) {\\n    console.error('Execute cycle error:', error)\\n    ElMessage.error('周期执行失败，请稍后再试')\\n  } finally {\\n    isExecuting.value = false\\n  }\\n}\\n</script>\\n\\n<style scoped>\\n.closed-loop-management {\\n  padding: 24px;\\n}\\n\\n.page-header-content {\\n  display: flex;\\n  align-items: center;\\n  gap: 8px;\\n  font-size: 18px;\\n  font-weight: 600;\\n}\\n\\n.management-content {\\n  margin-top: 24px;\\n}\\n\\n.metric-card {\\n  height: 120px;\\n}\\n\\n.metric-content {\\n  display: flex;\\n  align-items: center;\\n  gap: 16px;\\n}\\n\\n.metric-icon {\\n  width: 56px;\\n  height: 56px;\\n  border-radius: 12px;\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  font-size: 24px;\\n}\\n\\n.metric-icon.success {\\n  background: #d1fae5;\\n  color: #059669;\\n}\\n\\n.metric-icon.primary {\\n  background: #dbeafe;\\n  color: #2563eb;\\n}\\n\\n.metric-icon.warning {\\n  background: #fef3c7;\\n  color: #d97706;\\n}\\n\\n.metric-icon.info {\\n  background: #e0e7ff;\\n  color: #4f46e5;\\n}\\n\\n.metric-info {\\n  flex: 1;\\n}\\n\\n.metric-value {\\n  font-size: 28px;\\n  font-weight: 700;\\n  color: #1f2937;\\n}\\n\\n.metric-label {\\n  font-size: 14px;\\n  color: #6b7280;\\n  margin-top: 4px;\\n}\\n\\n.metric-trend {\\n  font-size: 12px;\\n  margin-top: 4px;\\n  display: flex;\\n  align-items: center;\\n  gap: 2px;\\n}\\n\\n.metric-trend.up {\\n  color: #059669;\\n}\\n\\n.metric-trend.down {\\n  color: #dc2626;\\n}\\n\\n.card-header {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n}\\n\\n.cycle-item {\\n  padding: 8px 0;\\n}\\n\\n.cycle-title {\\n  font-weight: 600;\\n  margin-bottom: 4px;\\n}\\n\\n.cycle-description {\\n  color: #6b7280;\\n  font-size: 14px;\\n  margin-bottom: 8px;\\n}\\n\\n.cycle-metrics {\\n  display: flex;\\n  gap: 8px;\\n}\\n\\n.insights-list {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 12px;\\n}\\n\\n.insight-item {\\n  display: flex;\\n  gap: 12px;\\n  padding: 12px;\\n  border-radius: 8px;\\n  background: #f9fafb;\\n}\\n\\n.insight-item.success {\\n  background: #ecfdf5;\\n  border-left: 4px solid #10b981;\\n}\\n\\n.insight-item.warning {\\n  background: #fffbeb;\\n  border-left: 4px solid #f59e0b;\\n}\\n\\n.insight-item.info {\\n  background: #eff6ff;\\n  border-left: 4px solid #3b82f6;\\n}\\n\\n.insight-icon {\\n  font-size: 20px;\\n  margin-top: 2px;\\n}\\n\\n.insight-content {\\n  flex: 1;\\n}\\n\\n.insight-title {\\n  font-weight: 600;\\n  margin-bottom: 4px;\\n}\\n\\n.insight-description {\\n  font-size: 14px;\\n  color: #6b7280;\\n}\\n\\n.value-validation {\\n  padding: 16px;\\n}\\n\\n.next-cycle {\\n  padding: 16px;\\n}\\n\\n.next-cycle ul {\\n  list-style: none;\\n  padding: 0;\\n  margin: 0;\\n}\\n\\n.next-cycle li {\\n  padding: 4px 0;\\n  color: #6b7280;\\n}\\n</style>\\n\",\"originTextLength\":12840,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768971308915}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/__tests__/integration/ai-widget.test.ts": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":83,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":83,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"import { describe, it, expect, beforeEach, vi } from \\\\'vitest\\\\'\\\\nimport { mount } from \\\\'@vue/test-utils\\\\'\\\\nimport AIWidget from \\\\'@/components/AIWidget/index.vue\\\\'\\\\nimport { ElMessage } from \\\\'element-plus\\\\'\\\\n\\\\nvi.mock(\\\\'element-plus\\\\', () => ({\\\\n  ElMessage: {\\\\n    error: vi.fn(),\\\\n  },\\\\n}))\\\\n\\\\ndescribe(\\\\'AIWidget Integration\\\\', () => {\\\\n  let wrapper: any\\\\n\\\\n  beforeEach(() => {\\\\n    wrapper = mount(AIWidget)\\\\n  })\\\\n\\\\n  it(\\\\'应该正确渲染AI Widget组件\\\\', () => {\\\\n    expect(wrapper.find(\\\\'.ai-widget-container\\\\').exists()).toBe(true)\\\\n    expect(wrapper.find(\\\\'.ai-widget-button\\\\').exists()).toBe(true)\\\\n  })\\\\n\\\\n  it(\\\\'点击按钮应该打开/关闭Widget面板\\\\', async () => {\\\\n    const button = wrapper.find(\\\\'.ai-widget-button\\\\')\\\\n    await button.trigger(\\\\'click\\\\')\\\\n    expect(wrapper.find(\\\\'.ai-widget-panel\\\\').exists()).toBe(true)\\\\n\\\\n    await button.trigger(\\\\'click\\\\')\\\\n    expect(wrapper.find(\\\\'.ai-widget-panel\\\\').exists()).toBe(false)\\\\n  })\\\\n\\\\n  it(\\\\'应该显示初始欢迎消息\\\\', () => {\\\\n    expect(wrapper.vm.messages).toHaveLength(1)\\\\n    expect(wrapper.vm.messages[0].role).toBe(\\\\'assistant\\\\')\\\\n    expect(wrapper.vm.messages[0].content).toContain(\\\\'你好！我是YYC³ AI助手\\\\')\\\\n  })\\\\n\\\\n  it(\\\\'应该能够发送消息\\\\', async () => {\\\\n    global.fetch = vi.fn(() =>\\\\n      Promise.resolve({\\\\n        ok: true,\\\\n        json: () => Promise.resolve({\\\\n          content: \\\\'测试回复\\\\',\\\\n          toolCalls: [],\\\\n        }),\\\\n      })\\\\n    ) as any\\\\n\\\\n    wrapper.vm.inputMessage = \\\\'测试消息\\\\'\\\\n    await wrapper.vm.sendMessage()\\\\n\\\\n    expect(wrapper.vm.messages).toHaveLength(2)\\\\n    expect(wrapper.vm.messages[1].role).toBe(\\\\'user\\\\')\\\\n    expect(wrapper.vm.messages[1].content).toBe(\\\\'测试消息\\\\')\\\\n  })\\\\n\\\\n  it(\\\\'应该处理API错误\\\\', async () => {\\\\n    global.fetch = vi.fn(() =>\\\\n      Promise.resolve({\\\\n        ok: false,\\\\n      })\\\\n    ) as any\\\\n\\\\n    wrapper.vm.inputMessage = \\\\'测试消息\\\\'\\\\n    await wrapper.vm.sendMessage()\\\\n\\\\n    expect(ElMessage.error).toHaveBeenCalledWith(\\\\'AI服务暂时不可用，请稍后再试\\\\')\\\\n  })\\\\n\\\\n  it(\\\\'应该显示工具调用信息\\\\', async () => {\\\\n    global.fetch = vi.fn(() =>\\\\n      Promise.resolve({\\\\n        ok: true,\\\\n        json: () => Promise.resolve({\\\\n          content: \\\\'执行完成\\\\',\\\\n          toolCalls: [\\\\n            { name: \\\\'search_orders\\\\', result: { orders: [] } },\\\\n            { name: \\\\'get_revenue_stats\\\\', result: { revenue: 10000 } },\\\\n          ],\\\\n        }),\\\\n      })\\\\n    ) as any\\\\n\\\\n    wrapper.vm.inputMessage = \\\\'查询订单\\\\'\\\\n    await wrapper.vm.sendMessage()\\\\n\\\\n    const lastMessage = wrapper.vm.messages[wrapper.vm.messages.length - 1]\\\\n    expect(lastMessage.toolCalls).toHaveLength(2)\\\\n    expect(lastMessage.toolCalls[0].name).toBe(\\\\'search_orders\\\\')\\\\n  })\\\\n\\\\n  it(\\\\'应该自动滚动到底部\\\\', async () => {\\\\n    const scrollToBottomSpy = vi.spyOn(wrapper.vm, \\\\'scrollToBottom\\\\')\\\\n    const button = wrapper.find(\\\\'.ai-widget-button\\\\')\\\\n    await button.trigger(\\\\'click\\\\')\\\\n\\\\n    await wrapper.vm.$nextTick()\\\\n    expect(scrollToBottomSpy).toHaveBeenCalled()\\\\n  })\\\\n})\\\\n\",\"originAcceptText\":\"import { describe, it, expect, beforeEach, vi } from 'vitest'\\nimport { mount } from '@vue/test-utils'\\nimport AIWidget from '@/components/AIWidget/index.vue'\\nimport { ElMessage } from 'element-plus'\\n\\nvi.mock('element-plus', () => ({\\n  ElMessage: {\\n    error: vi.fn(),\\n  },\\n}))\\n\\ndescribe('AIWidget Integration', () => {\\n  let wrapper: any\\n\\n  beforeEach(() => {\\n    wrapper = mount(AIWidget)\\n  })\\n\\n  it('应该正确渲染AI Widget组件', () => {\\n    expect(wrapper.find('.ai-widget-container').exists()).toBe(true)\\n    expect(wrapper.find('.ai-widget-button').exists()).toBe(true)\\n  })\\n\\n  it('点击按钮应该打开/关闭Widget面板', async () => {\\n    const button = wrapper.find('.ai-widget-button')\\n    await button.trigger('click')\\n    expect(wrapper.find('.ai-widget-panel').exists()).toBe(true)\\n\\n    await button.trigger('click')\\n    expect(wrapper.find('.ai-widget-panel').exists()).toBe(false)\\n  })\\n\\n  it('应该显示初始欢迎消息', () => {\\n    expect(wrapper.vm.messages).toHaveLength(1)\\n    expect(wrapper.vm.messages[0].role).toBe('assistant')\\n    expect(wrapper.vm.messages[0].content).toContain('你好！我是YYC³ AI助手')\\n  })\\n\\n  it('应该能够发送消息', async () => {\\n    global.fetch = vi.fn(() =>\\n      Promise.resolve({\\n        ok: true,\\n        json: () => Promise.resolve({\\n          content: '测试回复',\\n          toolCalls: [],\\n        }),\\n      })\\n    ) as any\\n\\n    wrapper.vm.inputMessage = '测试消息'\\n    await wrapper.vm.sendMessage()\\n\\n    expect(wrapper.vm.messages).toHaveLength(2)\\n    expect(wrapper.vm.messages[1].role).toBe('user')\\n    expect(wrapper.vm.messages[1].content).toBe('测试消息')\\n  })\\n\\n  it('应该处理API错误', async () => {\\n    global.fetch = vi.fn(() =>\\n      Promise.resolve({\\n        ok: false,\\n      })\\n    ) as any\\n\\n    wrapper.vm.inputMessage = '测试消息'\\n    await wrapper.vm.sendMessage()\\n\\n    expect(ElMessage.error).toHaveBeenCalledWith('AI服务暂时不可用，请稍后再试')\\n  })\\n\\n  it('应该显示工具调用信息', async () => {\\n    global.fetch = vi.fn(() =>\\n      Promise.resolve({\\n        ok: true,\\n        json: () => Promise.resolve({\\n          content: '执行完成',\\n          toolCalls: [\\n            { name: 'search_orders', result: { orders: [] } },\\n            { name: 'get_revenue_stats', result: { revenue: 10000 } },\\n          ],\\n        }),\\n      })\\n    ) as any\\n\\n    wrapper.vm.inputMessage = '查询订单'\\n    await wrapper.vm.sendMessage()\\n\\n    const lastMessage = wrapper.vm.messages[wrapper.vm.messages.length - 1]\\n    expect(lastMessage.toolCalls).toHaveLength(2)\\n    expect(lastMessage.toolCalls[0].name).toBe('search_orders')\\n  })\\n\\n  it('应该自动滚动到底部', async () => {\\n    const scrollToBottomSpy = vi.spyOn(wrapper.vm, 'scrollToBottom')\\n    const button = wrapper.find('.ai-widget-button')\\n    await button.trigger('click')\\n\\n    await wrapper.vm.$nextTick()\\n    expect(scrollToBottomSpy).toHaveBeenCalled()\\n  })\\n})\\n\",\"originTextLength\":2746,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768971413180}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/__tests__/integration/closed-loop.test.ts": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":89,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":89,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"import { describe, it, expect, beforeEach, vi } from \\\\'vitest\\\\'\\\\nimport { mount } from \\\\'@vue/test-utils\\\\'\\\\nimport ClosedLoopManagement from \\\\'@/views/ClosedLoopManagement.vue\\\\'\\\\nimport { ElMessage } from \\\\'element-plus\\\\'\\\\nimport { useRouter } from \\\\'vue-router\\\\'\\\\n\\\\nvi.mock(\\\\'vue-router\\\\', () => ({\\\\n  useRouter: vi.fn(),\\\\n}))\\\\n\\\\nvi.mock(\\\\'element-plus\\\\', () => ({\\\\n  ElMessage: {\\\\n    success: vi.fn(),\\\\n    error: vi.fn(),\\\\n  },\\\\n}))\\\\n\\\\ndescribe(\\\\'ClosedLoopManagement Integration\\\\', () => {\\\\n  let wrapper: any\\\\n  let mockRouter: any\\\\n\\\\n  beforeEach(() => {\\\\n    mockRouter = {\\\\n      back: vi.fn(),\\\\n    }\\\\n    ;(useRouter as any).mockReturnValue(mockRouter)\\\\n\\\\n    wrapper = mount(ClosedLoopManagement)\\\\n  })\\\\n\\\\n  it(\\\\'应该正确渲染Closed Loop管理页面\\\\', () => {\\\\n    expect(wrapper.find(\\\\'.closed-loop-management\\\\').exists()).toBe(true)\\\\n    expect(wrapper.find(\\\\'.page-header-content\\\\').exists()).toBe(true)\\\\n  })\\\\n\\\\n  it(\\\\'应该显示所有关键指标\\\\', () => {\\\\n    expect(wrapper.find(\\\\'.metric-value\\\\').exists()).toBe(true)\\\\n    expect(wrapper.vm.metrics.goalCompletion).toBe(78)\\\\n    expect(wrapper.vm.metrics.roiScore).toBe(72)\\\\n    expect(wrapper.vm.metrics.userSatisfaction).toBe(4.6)\\\\n    expect(wrapper.vm.metrics.learningSpeed).toBe(85)\\\\n  })\\\\n\\\\n  it(\\\\'应该显示周期执行历史\\\\', () => {\\\\n    expect(wrapper.vm.cycles).toHaveLength(2)\\\\n    expect(wrapper.vm.cycles[0].title).toBe(\\\\'周期 #1\\\\')\\\\n    expect(wrapper.vm.cycles[1].title).toBe(\\\\'周期 #2\\\\')\\\\n  })\\\\n\\\\n  it(\\\\'应该显示关键洞察\\\\', () => {\\\\n    expect(wrapper.vm.insights).toHaveLength(3)\\\\n    expect(wrapper.vm.insights[0].type).toBe(\\\\'success\\\\')\\\\n    expect(wrapper.vm.insights[1].type).toBe(\\\\'warning\\\\')\\\\n    expect(wrapper.vm.insights[2].type).toBe(\\\\'info\\\\')\\\\n  })\\\\n\\\\n  it(\\\\'应该显示价值验证数据\\\\', () => {\\\\n    expect(wrapper.vm.valueValidation.developmentCost).toBe(1030000)\\\\n    expect(wrapper.vm.valueValidation.annualRevenue).toBe(1250000)\\\\n    expect(wrapper.vm.valueValidation.paybackPeriod).toBe(10)\\\\n    expect(wrapper.vm.valueValidation.npv).toBe(2100000)\\\\n    expect(wrapper.vm.valueValidation.roi).toBe(121)\\\\n    expect(wrapper.vm.valueValidation.adoptionRate).toBe(87.5)\\\\n  })\\\\n\\\\n  it(\\\\'应该显示下一周期规划\\\\', () => {\\\\n    expect(wrapper.vm.nextCycle.focus).toContain(\\\\'移动端优化\\\\')\\\\n    expect(wrapper.vm.nextCycle.focus).toContain(\\\\'批量操作\\\\')\\\\n    expect(wrapper.vm.nextCycle.focus).toContain(\\\\'报表定制\\\\')\\\\n    expect(wrapper.vm.nextCycle.resourceAllocation).toBe(85)\\\\n  })\\\\n\\\\n  it(\\\\'应该能够执行新周期\\\\', async () => {\\\\n    const executeButton = wrapper.find(\\\\'.el-button--primary\\\\')\\\\n    await executeButton.trigger(\\\\'click\\\\')\\\\n\\\\n    await wrapper.vm.$nextTick()\\\\n\\\\n    expect(wrapper.vm.isExecuting).toBe(false)\\\\n    expect(wrapper.vm.cycles).toHaveLength(3)\\\\n    expect(wrapper.vm.cycles[0].title).toBe(\\\\'周期 #3\\\\')\\\\n    expect(ElMessage.success).toHaveBeenCalledWith(\\\\'新周期执行成功！\\\\')\\\\n  })\\\\n\\\\n  it(\\\\'应该能够返回上一页\\\\', () => {\\\\n    const backButton = wrapper.find(\\\\'.el-page-header\\\\')\\\\n    backButton.vm.$emit(\\\\'back\\\\')\\\\n\\\\n    expect(mockRouter.back).toHaveBeenCalled()\\\\n  })\\\\n\\\\n  it(\\\\'应该正确显示指标趋势\\\\', () => {\\\\n    expect(wrapper.vm.metrics.goalTrend).toBe(\\\\'up\\\\')\\\\n    expect(wrapper.vm.metrics.roiTrend).toBe(\\\\'up\\\\')\\\\n    expect(wrapper.vm.metrics.satisfactionTrend).toBe(\\\\'up\\\\')\\\\n    expect(wrapper.vm.metrics.learningTrend).toBe(\\\\'up\\\\')\\\\n  })\\\\n\\\\n  it(\\\\'应该正确格式化金额显示\\\\', () => {\\\\n    const formattedCost = wrapper.vm.valueValidation.developmentCost.toLocaleString()\\\\n    expect(formattedCost).toBe(\\\\'1,030,000\\\\')\\\\n  })\\\\n\\\\n  it(\\\\'应该显示周期时间线\\\\', () => {\\\\n    const timelineItems = wrapper.findAll(\\\\'.el-timeline-item\\\\')\\\\n    expect(timelineItems).toHaveLength(2)\\\\n  })\\\\n})\\\\n\",\"originAcceptText\":\"import { describe, it, expect, beforeEach, vi } from 'vitest'\\nimport { mount } from '@vue/test-utils'\\nimport ClosedLoopManagement from '@/views/ClosedLoopManagement.vue'\\nimport { ElMessage } from 'element-plus'\\nimport { useRouter } from 'vue-router'\\n\\nvi.mock('vue-router', () => ({\\n  useRouter: vi.fn(),\\n}))\\n\\nvi.mock('element-plus', () => ({\\n  ElMessage: {\\n    success: vi.fn(),\\n    error: vi.fn(),\\n  },\\n}))\\n\\ndescribe('ClosedLoopManagement Integration', () => {\\n  let wrapper: any\\n  let mockRouter: any\\n\\n  beforeEach(() => {\\n    mockRouter = {\\n      back: vi.fn(),\\n    }\\n    ;(useRouter as any).mockReturnValue(mockRouter)\\n\\n    wrapper = mount(ClosedLoopManagement)\\n  })\\n\\n  it('应该正确渲染Closed Loop管理页面', () => {\\n    expect(wrapper.find('.closed-loop-management').exists()).toBe(true)\\n    expect(wrapper.find('.page-header-content').exists()).toBe(true)\\n  })\\n\\n  it('应该显示所有关键指标', () => {\\n    expect(wrapper.find('.metric-value').exists()).toBe(true)\\n    expect(wrapper.vm.metrics.goalCompletion).toBe(78)\\n    expect(wrapper.vm.metrics.roiScore).toBe(72)\\n    expect(wrapper.vm.metrics.userSatisfaction).toBe(4.6)\\n    expect(wrapper.vm.metrics.learningSpeed).toBe(85)\\n  })\\n\\n  it('应该显示周期执行历史', () => {\\n    expect(wrapper.vm.cycles).toHaveLength(2)\\n    expect(wrapper.vm.cycles[0].title).toBe('周期 #1')\\n    expect(wrapper.vm.cycles[1].title).toBe('周期 #2')\\n  })\\n\\n  it('应该显示关键洞察', () => {\\n    expect(wrapper.vm.insights).toHaveLength(3)\\n    expect(wrapper.vm.insights[0].type).toBe('success')\\n    expect(wrapper.vm.insights[1].type).toBe('warning')\\n    expect(wrapper.vm.insights[2].type).toBe('info')\\n  })\\n\\n  it('应该显示价值验证数据', () => {\\n    expect(wrapper.vm.valueValidation.developmentCost).toBe(1030000)\\n    expect(wrapper.vm.valueValidation.annualRevenue).toBe(1250000)\\n    expect(wrapper.vm.valueValidation.paybackPeriod).toBe(10)\\n    expect(wrapper.vm.valueValidation.npv).toBe(2100000)\\n    expect(wrapper.vm.valueValidation.roi).toBe(121)\\n    expect(wrapper.vm.valueValidation.adoptionRate).toBe(87.5)\\n  })\\n\\n  it('应该显示下一周期规划', () => {\\n    expect(wrapper.vm.nextCycle.focus).toContain('移动端优化')\\n    expect(wrapper.vm.nextCycle.focus).toContain('批量操作')\\n    expect(wrapper.vm.nextCycle.focus).toContain('报表定制')\\n    expect(wrapper.vm.nextCycle.resourceAllocation).toBe(85)\\n  })\\n\\n  it('应该能够执行新周期', async () => {\\n    const executeButton = wrapper.find('.el-button--primary')\\n    await executeButton.trigger('click')\\n\\n    await wrapper.vm.$nextTick()\\n\\n    expect(wrapper.vm.isExecuting).toBe(false)\\n    expect(wrapper.vm.cycles).toHaveLength(3)\\n    expect(wrapper.vm.cycles[0].title).toBe('周期 #3')\\n    expect(ElMessage.success).toHaveBeenCalledWith('新周期执行成功！')\\n  })\\n\\n  it('应该能够返回上一页', () => {\\n    const backButton = wrapper.find('.el-page-header')\\n    backButton.vm.$emit('back')\\n\\n    expect(mockRouter.back).toHaveBeenCalled()\\n  })\\n\\n  it('应该正确显示指标趋势', () => {\\n    expect(wrapper.vm.metrics.goalTrend).toBe('up')\\n    expect(wrapper.vm.metrics.roiTrend).toBe('up')\\n    expect(wrapper.vm.metrics.satisfactionTrend).toBe('up')\\n    expect(wrapper.vm.metrics.learningTrend).toBe('up')\\n  })\\n\\n  it('应该正确格式化金额显示', () => {\\n    const formattedCost = wrapper.vm.valueValidation.developmentCost.toLocaleString()\\n    expect(formattedCost).toBe('1,030,000')\\n  })\\n\\n 