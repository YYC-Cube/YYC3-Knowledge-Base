  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/docs/YYC3-Cater-Platform-%E6%96%87%E6%A1%A3%E9%97%AD%E7%8E%AF/YYC3-%E6%96%87%E6%A1%A3%E7%B4%A2%E5%BC%95.md": "[{\"originRange\":{\"start\":{\"line\":300,\"character\":0},\"end\":{\"line\":315,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":300,\"character\":0},\"end\":{\"line\":315,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"### 8.3 需求设计文档（12个）\\\\n\\\\n| 文档名称 | 行数 | 状态 |\\\\n|----------|------|------|\\\\n| 客户生命周期管理功能模块需求分析与设计文档.md | - | ✅ |\\\\n| 客户管理功能模块需求分析与设计文档.md | - | ✅ |\\\\n| 厨房管理功能模块需求分析与设计文档.md | - | ✅ |\\\\n| 订单管理功能模块需求分析与设计文档.md | - | ✅ |\\\\n| 菜单管理功能模块需求分析与设计文档.md | - | ✅ |\\\\n| 厨房显示功能模块需求分析与设计文档.md | - | ✅ |\\\\n| 食品安全功能模块需求分析与设计文档.md | - | ✅ |\\\\n| 报表分析功能模块需求分析与设计文档.md | - | ✅ |\\\\n| 连锁管理功能模块需求分析与设计文档.md | - | ✅ |\\\\n| 支付管理功能模块需求分析与设计文档.md | - | ✅ |\\\\n| 系统管理功能模块需求分析与设计文档.md | - | ✅ |\\\\n| 数据分析功能模块需求分析与设计文档.md | - | ✅ |\\\\n\",\"originAcceptText\":\"### 8.3 需求设计文档（12个）\\n\\n| 文档名称 | 行数 | 状态 |\\n|----------|------|------|\\n| 客户生命周期管理功能模块需求分析与设计文档.md | - | ✅ |\\n| 客户管理功能模块需求分析与设计文档.md | - | ✅ |\\n| 厨房管理功能模块需求分析与设计文档.md | - | ✅ |\\n| 订单管理功能模块需求分析与设计文档.md | - | ✅ |\\n| 菜单管理功能模块需求分析与设计文档.md | - | ✅ |\\n| 厨房显示功能模块需求分析与设计文档.md | - | ✅ |\\n| 食品安全功能模块需求分析与设计文档.md | - | ✅ |\\n| 报表分析功能模块需求分析与设计文档.md | - | ✅ |\\n| 连锁管理功能模块需求分析与设计文档.md | - | ✅ |\\n| 支付管理功能模块需求分析与设计文档.md | - | ✅ |\\n| 系统管理功能模块需求分析与设计文档.md | - | ✅ |\\n| 数据分析功能模块需求分析与设计文档.md | - | ✅ |\\n\",\"originTextLength\":467,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768911383087}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/views/CustomerStatusTracker.vue": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":403,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":403,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"<template>\\\\n  <div class=\\\\\\\"customer-status-tracker\\\\\\\">\\\\n    <el-card class=\\\\\\\"status-card\\\\\\\">\\\\n      <template #header>\\\\n        <div class=\\\\\\\"card-header\\\\\\\">\\\\n          <span class=\\\\\\\"card-title\\\\\\\">客户状态跟踪</span>\\\\n          <el-button type=\\\\\\\"primary\\\\\\\" size=\\\\\\\"small\\\\\\\" @click=\\\\\\\"refreshData\\\\\\\">\\\\n            <el-icon><Refresh /></el-icon>\\\\n            刷新\\\\n          </el-button>\\\\n        </div>\\\\n      </template>\\\\n\\\\n      <div class=\\\\\\\"status-overview\\\\\\\">\\\\n        <div class=\\\\\\\"status-item active\\\\\\\">\\\\n          <div class=\\\\\\\"status-count\\\\\\\">{{ statistics.active || 0 }}</div>\\\\n          <div class=\\\\\\\"status-label\\\\\\\">活跃客户</div>\\\\n        </div>\\\\n        <div class=\\\\\\\"status-item inactive\\\\\\\">\\\\n          <div class=\\\\\\\"status-count\\\\\\\">{{ statistics.inactive || 0 }}</div>\\\\n          <div class=\\\\\\\"status-label\\\\\\\">非活跃客户</div>\\\\n        </div>\\\\n        <div class=\\\\\\\"status-item blacklisted\\\\\\\">\\\\n          <div class=\\\\\\\"status-count\\\\\\\">{{ statistics.blacklisted || 0 }}</div>\\\\n          <div class=\\\\\\\"status-label\\\\\\\">黑名单客户</div>\\\\n        </div>\\\\n        <div class=\\\\\\\"status-item total\\\\\\\">\\\\n          <div class=\\\\\\\"status-count\\\\\\\">{{ statistics.total || 0 }}</div>\\\\n          <div class=\\\\\\\"status-label\\\\\\\">客户总数</div>\\\\n        </div>\\\\n      </div>\\\\n    </el-card>\\\\n\\\\n    <el-card class=\\\\\\\"filter-card\\\\\\\">\\\\n      <el-form :model=\\\\\\\"filters\\\\\\\" inline>\\\\n        <el-form-item label=\\\\\\\"客户姓名\\\\\\\">\\\\n          <el-input v-model=\\\\\\\"filters.name\\\\\\\" placeholder=\\\\\\\"请输入客户姓名\\\\\\\" clearable />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"手机号\\\\\\\">\\\\n          <el-input v-model=\\\\\\\"filters.phone\\\\\\\" placeholder=\\\\\\\"请输入手机号\\\\\\\" clearable />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"状态\\\\\\\">\\\\n          <el-select v-model=\\\\\\\"filters.status\\\\\\\" placeholder=\\\\\\\"请选择状态\\\\\\\" clearable>\\\\n            <el-option label=\\\\\\\"全部\\\\\\\" value=\\\\\\\"\\\\\\\" />\\\\n            <el-option label=\\\\\\\"活跃\\\\\\\" value=\\\\\\\"active\\\\\\\" />\\\\n            <el-option label=\\\\\\\"非活跃\\\\\\\" value=\\\\\\\"inactive\\\\\\\" />\\\\n            <el-option label=\\\\\\\"黑名单\\\\\\\" value=\\\\\\\"blacklisted\\\\\\\" />\\\\n          </el-select>\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"注册时间\\\\\\\">\\\\n          <el-date-picker\\\\n            v-model=\\\\\\\"filters.registerDateRange\\\\\\\"\\\\n            type=\\\\\\\"daterange\\\\\\\"\\\\n            range-separator=\\\\\\\"至\\\\\\\"\\\\n            start-placeholder=\\\\\\\"开始日期\\\\\\\"\\\\n            end-placeholder=\\\\\\\"结束日期\\\\\\\"\\\\n            value-format=\\\\\\\"YYYY-MM-DD\\\\\\\"\\\\n          />\\\\n        </el-form-item>\\\\n        <el-form-item>\\\\n          <el-button type=\\\\\\\"primary\\\\\\\" @click=\\\\\\\"handleSearch\\\\\\\">搜索</el-button>\\\\n          <el-button @click=\\\\\\\"handleReset\\\\\\\">重置</el-button>\\\\n        </el-form-item>\\\\n      </el-form>\\\\n    </el-card>\\\\n\\\\n    <el-card class=\\\\\\\"table-card\\\\\\\">\\\\n      <el-table :data=\\\\\\\"customerList\\\\\\\" stripe v-loading=\\\\\\\"loading\\\\\\\" border>\\\\n        <el-table-column prop=\\\\\\\"name\\\\\\\" label=\\\\\\\"客户姓名\\\\\\\" width=\\\\\\\"120\\\\\\\" />\\\\n        <el-table-column prop=\\\\\\\"phone\\\\\\\" label=\\\\\\\"手机号\\\\\\\" width=\\\\\\\"130\\\\\\\" />\\\\n        <el-table-column prop=\\\\\\\"email\\\\\\\" label=\\\\\\\"邮箱\\\\\\\" width=\\\\\\\"180\\\\\\\" />\\\\n        <el-table-column label=\\\\\\\"状态\\\\\\\" width=\\\\\\\"100\\\\\\\">\\\\n          <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n            <el-tag :type=\\\\\\\"getStatusType(row.status)\\\\\\\" size=\\\\\\\"small\\\\\\\">\\\\n              {{ getStatusText(row.status) }}\\\\n            </el-tag>\\\\n          </template>\\\\n        </el-table-column>\\\\n        <el-table-column prop=\\\\\\\"totalSpent\\\\\\\" label=\\\\\\\"累计消费\\\\\\\" width=\\\\\\\"120\\\\\\\">\\\\n          <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n            ¥{{ row.totalSpent?.toFixed(2) || \\\\'0.00\\\\' }}\\\\n          </template>\\\\n        </el-table-column>\\\\n        <el-table-column prop=\\\\\\\"totalOrders\\\\\\\" label=\\\\\\\"订单数\\\\\\\" width=\\\\\\\"80\\\\\\\" />\\\\n        <el-table-column prop=\\\\\\\"points\\\\\\\" label=\\\\\\\"积分\\\\\\\" width=\\\\\\\"80\\\\\\\" />\\\\n        <el-table-column prop=\\\\\\\"lastVisitAt\\\\\\\" label=\\\\\\\"最后访问\\\\\\\" width=\\\\\\\"160\\\\\\\">\\\\n          <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n            {{ formatDate(row.lastVisitAt) }}\\\\n          </template>\\\\n        </el-table-column>\\\\n        <el-table-column prop=\\\\\\\"createdAt\\\\\\\" label=\\\\\\\"注册时间\\\\\\\" width=\\\\\\\"160\\\\\\\">\\\\n          <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n            {{ formatDate(row.createdAt) }}\\\\n          </template>\\\\n        </el-table-column>\\\\n        <el-table-column label=\\\\\\\"操作\\\\\\\" width=\\\\\\\"200\\\\\\\" fixed=\\\\\\\"right\\\\\\\">\\\\n          <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n            <el-button type=\\\\\\\"primary\\\\\\\" link size=\\\\\\\"small\\\\\\\" @click=\\\\\\\"handleViewDetail(row)\\\\\\\">\\\\n              查看详情\\\\n            </el-button>\\\\n            <el-button type=\\\\\\\"warning\\\\\\\" link size=\\\\\\\"small\\\\\\\" @click=\\\\\\\"handleChangeStatus(row)\\\\\\\">\\\\n              修改状态\\\\n            </el-button>\\\\n            <el-button type=\\\\\\\"info\\\\\\\" link size=\\\\\\\"small\\\\\\\" @click=\\\\\\\"handleViewHistory(row)\\\\\\\">\\\\n              状态历史\\\\n            </el-button>\\\\n          </template>\\\\n        </el-table-column>\\\\n      </el-table>\\\\n\\\\n      <div class=\\\\\\\"pagination-container\\\\\\\">\\\\n        <el-pagination\\\\n          v-model:current-page=\\\\\\\"pagination.page\\\\\\\"\\\\n          v-model:page-size=\\\\\\\"pagination.size\\\\\\\"\\\\n          :total=\\\\\\\"pagination.total\\\\\\\"\\\\n          :page-sizes=\\\\\\\"[10, 20, 50, 100]\\\\\\\"\\\\n          layout=\\\\\\\"total, sizes, prev, pager, next, jumper\\\\\\\"\\\\n          @size-change=\\\\\\\"handleSizeChange\\\\\\\"\\\\n          @current-change=\\\\\\\"handlePageChange\\\\\\\"\\\\n        />\\\\n      </div>\\\\n    </el-card>\\\\n\\\\n    <el-dialog v-model=\\\\\\\"statusDialogVisible\\\\\\\" title=\\\\\\\"修改客户状态\\\\\\\" width=\\\\\\\"500px\\\\\\\">\\\\n      <el-form :model=\\\\\\\"statusForm\\\\\\\" :rules=\\\\\\\"statusRules\\\\\\\" ref=\\\\\\\"statusFormRef\\\\\\\" label-width=\\\\\\\"100px\\\\\\\">\\\\n        <el-form-item label=\\\\\\\"客户姓名\\\\\\\">\\\\n          <el-input v-model=\\\\\\\"statusForm.customerName\\\\\\\" disabled />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"当前状态\\\\\\\">\\\\n          <el-tag :type=\\\\\\\"getStatusType(statusForm.currentStatus)\\\\\\\" size=\\\\\\\"small\\\\\\\">\\\\n            {{ getStatusText(statusForm.currentStatus) }}\\\\n          </el-tag>\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"新状态\\\\\\\" prop=\\\\\\\"newStatus\\\\\\\">\\\\n          <el-select v-model=\\\\\\\"statusForm.newStatus\\\\\\\" placeholder=\\\\\\\"请选择新状态\\\\\\\">\\\\n            <el-option label=\\\\\\\"活跃\\\\\\\" value=\\\\\\\"active\\\\\\\" />\\\\n            <el-option label=\\\\\\\"非活跃\\\\\\\" value=\\\\\\\"inactive\\\\\\\" />\\\\n            <el-option label=\\\\\\\"黑名单\\\\\\\" value=\\\\\\\"blacklisted\\\\\\\" />\\\\n          </el-select>\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"变更原因\\\\\\\" prop=\\\\\\\"reason\\\\\\\">\\\\n          <el-input\\\\n            v-model=\\\\\\\"statusForm.reason\\\\\\\"\\\\n            type=\\\\\\\"textarea\\\\\\\"\\\\n            :rows=\\\\\\\"3\\\\\\\"\\\\n            placeholder=\\\\\\\"请输入变更原因\\\\\\\"\\\\n          />\\\\n        </el-form-item>\\\\n      </el-form>\\\\n      <template #footer>\\\\n        <el-button @click=\\\\\\\"statusDialogVisible = false\\\\\\\">取消</el-button>\\\\n        <el-button type=\\\\\\\"primary\\\\\\\" @click=\\\\\\\"handleStatusSubmit\\\\\\\" :loading=\\\\\\\"submitting\\\\\\\">\\\\n          确定\\\\n        </el-button>\\\\n      </template>\\\\n    </el-dialog>\\\\n\\\\n    <el-dialog v-model=\\\\\\\"historyDialogVisible\\\\\\\" title=\\\\\\\"客户状态历史\\\\\\\" width=\\\\\\\"800px\\\\\\\">\\\\n      <el-table :data=\\\\\\\"statusHistoryList\\\\\\\" stripe border max-height=\\\\\\\"400\\\\\\\">\\\\n        <el-table-column prop=\\\\\\\"oldStatus\\\\\\\" label=\\\\\\\"旧状态\\\\\\\" width=\\\\\\\"100\\\\\\\">\\\\n          <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n            <el-tag v-if=\\\\\\\"row.oldStatus\\\\\\\" :type=\\\\\\\"getStatusType(row.oldStatus)\\\\\\\" size=\\\\\\\"small\\\\\\\">\\\\n              {{ getStatusText(row.oldStatus) }}\\\\n            </el-tag>\\\\n            <span v-else>-</span>\\\\n          </template>\\\\n        </el-table-column>\\\\n        <el-table-column prop=\\\\\\\"newStatus\\\\\\\" label=\\\\\\\"新状态\\\\\\\" width=\\\\\\\"100\\\\\\\">\\\\n          <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n            <el-tag :type=\\\\\\\"getStatusType(row.newStatus)\\\\\\\" size=\\\\\\\"small\\\\\\\">\\\\n              {{ getStatusText(row.newStatus) }}\\\\n            </el-tag>\\\\n          </template>\\\\n        </el-table-column>\\\\n        <el-table-column prop=\\\\\\\"changedBy\\\\\\\" label=\\\\\\\"变更人\\\\\\\" width=\\\\\\\"120\\\\\\\" />\\\\n        <el-table-column prop=\\\\\\\"changedAt\\\\\\\" label=\\\\\\\"变更时间\\\\\\\" width=\\\\\\\"160\\\\\\\">\\\\n          <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n            {{ formatDate(row.changedAt) }}\\\\n          </template>\\\\n        </el-table-column>\\\\n        <el-table-column prop=\\\\\\\"reason\\\\\\\" label=\\\\\\\"变更原因\\\\\\\" show-overflow-tooltip />\\\\n      </el-table>\\\\n      <template #footer>\\\\n        <el-button @click=\\\\\\\"historyDialogVisible = false\\\\\\\">关闭</el-button>\\\\n      </template>\\\\n    </el-dialog>\\\\n  </div>\\\\n</template>\\\\n\\\\n<script setup lang=\\\\\\\"ts\\\\\\\">\\\\nimport { ref, reactive, onMounted } from \\\\'vue\\\\'\\\\nimport { ElMessage, ElMessageBox } from \\\\'element-plus\\\\'\\\\nimport { Refresh } from \\\\'@element-plus/icons-vue\\\\'\\\\nimport { getCustomers, updateCustomerStatus, getCustomerStatusHistory, getCustomerStatistics } from \\\\'@/api/customer\\\\'\\\\nimport type { Customer, CustomerStatusHistory } from \\\\'@/api/customer\\\\'\\\\n\\\\nconst loading = ref(false)\\\\nconst submitting = ref(false)\\\\nconst statusDialogVisible = ref(false)\\\\nconst historyDialogVisible = ref(false)\\\\nconst statusFormRef = ref()\\\\n\\\\nconst statistics = reactive({\\\\n  active: 0,\\\\n  inactive: 0,\\\\n  blacklisted: 0,\\\\n  total: 0\\\\n})\\\\n\\\\nconst filters = reactive({\\\\n  name: \\\\'\\\\',\\\\n  phone: \\\\'\\\\',\\\\n  status: \\\\'\\\\',\\\\n  registerDateRange: []\\\\n})\\\\n\\\\nconst pagination = reactive({\\\\n  page: 1,\\\\n  size: 20,\\\\n  total: 0\\\\n})\\\\n\\\\nconst customerList = ref<Customer[]>([])\\\\nconst statusHistoryList = ref<CustomerStatusHistory[]>([])\\\\n\\\\nconst statusForm = reactive({\\\\n  customerId: \\\\'\\\\',\\\\n  customerName: \\\\'\\\\',\\\\n  currentStatus: \\\\'\\\\',\\\\n  newStatus: \\\\'\\\\',\\\\n  reason: \\\\'\\\\'\\\\n})\\\\n\\\\nconst statusRules = {\\\\n  newStatus: [\\\\n    { required: true, message: \\\\'请选择新状态\\\\', trigger: \\\\'change\\\\' }\\\\n  ],\\\\n  reason: [\\\\n    { required: true, message: \\\\'请输入变更原因\\\\', trigger: \\\\'blur\\\\' },\\\\n    { min: 5, message: \\\\'变更原因至少5个字符\\\\', trigger: \\\\'blur\\\\' }\\\\n  ]\\\\n}\\\\n\\\\nconst getStatusType = (status: string) => {\\\\n  const typeMap: Record<string, any> = {\\\\n    active: \\\\'success\\\\',\\\\n    inactive: \\\\'info\\\\',\\\\n    blacklisted: \\\\'danger\\\\'\\\\n  }\\\\n  return typeMap[status] || \\\\'\\\\'\\\\n}\\\\n\\\\nconst getStatusText = (status: string) => {\\\\n  const textMap: Record<string, string> = {\\\\n    active: \\\\'活跃\\\\',\\\\n    inactive: \\\\'非活跃\\\\',\\\\n    blacklisted: \\\\'黑名单\\\\'\\\\n  }\\\\n  return textMap[status] || status\\\\n}\\\\n\\\\nconst formatDate = (date: string) => {\\\\n  if (!date) return \\\\'-\\\\'\\\\n  return new Date(date).toLocaleString(\\\\'zh-CN\\\\')\\\\n}\\\\n\\\\nconst loadStatistics = async () => {\\\\n  try {\\\\n    const data = await getCustomerStatistics()\\\\n    Object.assign(statistics, data)\\\\n  } catch (error) {\\\\n    console.error(\\\\'加载统计数据失败:\\\\', error)\\\\n  }\\\\n}\\\\n\\\\nconst loadCustomerList = async () => {\\\\n  loading.value = true\\\\n  try {\\\\n    const params = {\\\\n      keyword: filters.name,\\\\n      phone: filters.phone,\\\\n      status: filters.status,\\\\n      page: pagination.page,\\\\n      size: pagination.size\\\\n    }\\\\n\\\\n    if (filters.registerDateRange && filters.registerDateRange.length === 2) {\\\\n      Object.assign(params, {\\\\n        registerDateStart: filters.registerDateRange[0],\\\\n        registerDateEnd: filters.registerDateRange[1]\\\\n      })\\\\n    }\\\\n\\\\n    const result = await getCustomers(params)\\\\n    customerList.value = result.data || []\\\\n    pagination.total = result.total || 0\\\\n  } catch (error) {\\\\n    ElMessage.error(\\\\'加载客户列表失败\\\\')\\\\n    console.error(error)\\\\n  } finally {\\\\n    loading.value = false\\\\n  }\\\\n}\\\\n\\\\nconst refreshData = () => {\\\\n  loadStatistics()\\\\n  loadCustomerList()\\\\n}\\\\n\\\\nconst handleSearch = () => {\\\\n  pagination.page = 1\\\\n  loadCustomerList()\\\\n}\\\\n\\\\nconst handleReset = () => {\\\\n  filters.name = \\\\'\\\\'\\\\n  filters.phone = \\\\'\\\\'\\\\n  filters.status = \\\\'\\\\'\\\\n  filters.registerDateRange = []\\\\n  pagination.page = 1\\\\n  loadCustomerList()\\\\n}\\\\n\\\\nconst handleSizeChange = (size: number) => {\\\\n  pagination.size = size\\\\n  pagination.page = 1\\\\n  loadCustomerList()\\\\n}\\\\n\\\\nconst handlePageChange = (page: number) => {\\\\n  pagination.page = page\\\\n  loadCustomerList()\\\\n}\\\\n\\\\nconst handleViewDetail = (row: Customer) => {\\\\n  ElMessage.info(\\\\'查看详情功能待实现\\\\')\\\\n}\\\\n\\\\nconst handleChangeStatus = (row: Customer) => {\\\\n  statusForm.customerId = row.id\\\\n  statusForm.customerName = row.name\\\\n  statusForm.currentStatus = row.status\\\\n  statusForm.newStatus = \\\\'\\\\'\\\\n  statusForm.reason = \\\\'\\\\'\\\\n  statusDialogVisible.value = true\\\\n}\\\\n\\\\nconst handleStatusSubmit = async () => {\\\\n  if (!statusFormRef.value) return\\\\n\\\\n  try {\\\\n    await statusFormRef.value.validate()\\\\n    submitting.value = true\\\\n\\\\n    await updateCustomerStatus(statusForm.customerId, statusForm.newStatus as any)\\\\n\\\\n    ElMessage.success(\\\\'状态修改成功\\\\')\\\\n    statusDialogVisible.value = false\\\\n    refreshData()\\\\n  } catch (error: any) {\\\\n    if (error !== false) {\\\\n      ElMessage.error(error.message || \\\\'状态修改失败\\\\')\\\\n    }\\\\n  } finally {\\\\n    submitting.value = false\\\\n  }\\\\n}\\\\n\\\\nconst handleViewHistory = async (row: Customer) => {\\\\n  try {\\\\n    const result = await getCustomerStatusHistory(row.id)\\\\n    statusHistoryList.value = result.data || []\\\\n    historyDialogVisible.value = true\\\\n  } catch (error) {\\\\n    ElMessage.error(\\\\'加载状态历史失败\\\\')\\\\n    console.error(error)\\\\n  }\\\\n}\\\\n\\\\nonMounted(() => {\\\\n  loadStatistics()\\\\n  loadCustomerList()\\\\n})\\\\n</script>\\\\n\\\\n<style scoped lang=\\\\\\\"scss\\\\\\\">\\\\n.customer-status-tracker {\\\\n  padding: 20px;\\\\n\\\\n  .status-card,\\\\n  .filter-card,\\\\n  .table-card {\\\\n    margin-bottom: 20px;\\\\n  }\\\\n\\\\n  .card-header {\\\\n    display: flex;\\\\n    justify-content: space-between;\\\\n    align-items: center;\\\\n\\\\n    .card-title {\\\\n      font-size: 16px;\\\\n      font-weight: 600;\\\\n    }\\\\n  }\\\\n\\\\n  .status-overview {\\\\n    display: flex;\\\\n    justify-content: space-around;\\\\n    padding: 20px 0;\\\\n\\\\n    .status-item {\\\\n      text-align: center;\\\\n\\\\n      .status-count {\\\\n        font-size: 32px;\\\\n        font-weight: 600;\\\\n        margin-bottom: 8px;\\\\n      }\\\\n\\\\n      .status-label {\\\\n        font-size: 14px;\\\\n        color: #909399;\\\\n      }\\\\n\\\\n      &.active .status-count {\\\\n        color: #67c23a;\\\\n      }\\\\n\\\\n      &.inactive .status-count {\\\\n        color: #909399;\\\\n      }\\\\n\\\\n      &.blacklisted .status-count {\\\\n        color: #f56c6c;\\\\n      }\\\\n\\\\n      &.total .status-count {\\\\n        color: #409eff;\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  .pagination-container {\\\\n    display: flex;\\\\n    justify-content: flex-end;\\\\n    margin-top: 20px;\\\\n  }\\\\n}\\\\n</style>\\\\n\",\"originAcceptText\":\"<template>\\n  <div class=\\\"customer-status-tracker\\\">\\n    <el-card class=\\\"status-card\\\">\\n      <template #header>\\n        <div class=\\\"card-header\\\">\\n          <span class=\\\"card-title\\\">客户状态跟踪</span>\\n          <el-button type=\\\"primary\\\" size=\\\"small\\\" @click=\\\"refreshData\\\">\\n            <el-icon><Refresh /></el-icon>\\n            刷新\\n          </el-button>\\n        </div>\\n      </template>\\n\\n      <div class=\\\"status-overview\\\">\\n        <div class=\\\"status-item active\\\">\\n          <div class=\\\"status-count\\\">{{ statistics.active || 0 }}</div>\\n          <div class=\\\"status-label\\\">活跃客户</div>\\n        </div>\\n        <div class=\\\"status-item inactive\\\">\\n          <div class=\\\"status-count\\\">{{ statistics.inactive || 0 }}</div>\\n          <div class=\\\"status-label\\\">非活跃客户</div>\\n        </div>\\n        <div class=\\\"status-item blacklisted\\\">\\n          <div class=\\\"status-count\\\">{{ statistics.blacklisted || 0 }}</div>\\n          <div class=\\\"status-label\\\">黑名单客户</div>\\n        </div>\\n        <div class=\\\"status-item total\\\">\\n          <div class=\\\"status-count\\\">{{ statistics.total || 0 }}</div>\\n          <div class=\\\"status-label\\\">客户总数</div>\\n        </div>\\n      </div>\\n    </el-card>\\n\\n    <el-card class=\\\"filter-card\\\">\\n      <el-form :model=\\\"filters\\\" inline>\\n        <el-form-item label=\\\"客户姓名\\\">\\n          <el-input v-model=\\\"filters.name\\\" placeholder=\\\"请输入客户姓名\\\" clearable />\\n        </el-form-item>\\n        <el-form-item label=\\\"手机号\\\">\\n          <el-input v-model=\\\"filters.phone\\\" placeholder=\\\"请输入手机号\\\" clearable />\\n        </el-form-item>\\n        <el-form-item label=\\\"状态\\\">\\n          <el-select v-model=\\\"filters.status\\\" placeholder=\\\"请选择状态\\\" clearable>\\n            <el-option label=\\\"全部\\\" value=\\\"\\\" />\\n            <el-option label=\\\"活跃\\\" value=\\\"active\\\" />\\n            <el-option label=\\\"非活跃\\\" value=\\\"inactive\\\" />\\n            <el-option label=\\\"黑名单\\\" value=\\\"blacklisted\\\" />\\n          </el-select>\\n        </el-form-item>\\n        <el-form-item label=\\\"注册时间\\\">\\n          <el-date-picker\\n            v-model=\\\"filters.registerDateRange\\\"\\n            type=\\\"daterange\\\"\\n            range-separator=\\\"至\\\"\\n            start-placeholder=\\\"开始日期\\\"\\n            end-placeholder=\\\"结束日期\\\"\\n            value-format=\\\"YYYY-MM-DD\\\"\\n          />\\n        </el-form-item>\\n        <el-form-item>\\n          <el-button type=\\\"primary\\\" @click=\\\"handleSearch\\\">搜索</el-button>\\n          <el-button @click=\\\"handleReset\\\">重置</el-button>\\n        </el-form-item>\\n      </el-form>\\n    </el-card>\\n\\n    <el-card class=\\\"table-card\\\">\\n      <el-table :data=\\\"customerList\\\" stripe v-loading=\\\"loading\\\" border>\\n        <el-table-column prop=\\\"name\\\" label=\\\"客户姓名\\\" width=\\\"120\\\" />\\n        <el-table-column prop=\\\"phone\\\" label=\\\"手机号\\\" width=\\\"130\\\" />\\n        <el-table-column prop=\\\"email\\\" label=\\\"邮箱\\\" width=\\\"180\\\" />\\n        <el-table-column label=\\\"状态\\\" width=\\\"100\\\">\\n          <template #default=\\\"{ row }\\\">\\n            <el-tag :type=\\\"getStatusType(row.status)\\\" size=\\\"small\\\">\\n              {{ getStatusText(row.status) }}\\n            </el-tag>\\n          </template>\\n        </el-table-column>\\n        <el-table-column prop=\\\"totalSpent\\\" label=\\\"累计消费\\\" width=\\\"120\\\">\\n          <template #default=\\\"{ row }\\\">\\n            ¥{{ row.totalSpent?.toFixed(2) || '0.00' }}\\n          </template>\\n        </el-table-column>\\n        <el-table-column prop=\\\"totalOrders\\\" label=\\\"订单数\\\" width=\\\"80\\\" />\\n        <el-table-column prop=\\\"points\\\" label=\\\"积分\\\" width=\\\"80\\\" />\\n        <el-table-column prop=\\\"lastVisitAt\\\" label=\\\"最后访问\\\" width=\\\"160\\\">\\n          <template #default=\\\"{ row }\\\">\\n            {{ formatDate(row.lastVisitAt) }}\\n          </template>\\n        </el-table-column>\\n        <el-table-column prop=\\\"createdAt\\\" label=\\\"注册时间\\\" width=\\\"160\\\">\\n          <template #default=\\\"{ row }\\\">\\n            {{ formatDate(row.createdAt) }}\\n          </template>\\n        </el-table-column>\\n        <el-table-column label=\\\"操作\\\" width=\\\"200\\\" fixed=\\\"right\\\">\\n          <template #default=\\\"{ row }\\\">\\n            <el-button type=\\\"primary\\\" link size=\\\"small\\\" @click=\\\"handleViewDetail(row)\\\">\\n              查看详情\\n            </el-button>\\n            <el-button type=\\\"warning\\\" link size=\\\"small\\\" @click=\\\"handleChangeStatus(row)\\\">\\n              修改状态\\n            </el-button>\\n            <el-button type=\\\"info\\\" link size=\\\"small\\\" @click=\\\"handleViewHistory(row)\\\">\\n              状态历史\\n            </el-button>\\n          </template>\\n        </el-table-column>\\n      </el-table>\\n\\n      <div class=\\\"pagination-container\\\">\\n        <el-pagination\\n          v-model:current-page=\\\"pagination.page\\\"\\n          v-model:page-size=\\\"pagination.size\\\"\\n          :total=\\\"pagination.total\\\"\\n          :page-sizes=\\\"[10, 20, 50, 100]\\\"\\n          layout=\\\"total, sizes, prev, pager, next, jumper\\\"\\n          @size-change=\\\"handleSizeChange\\\"\\n          @current-change=\\\"handlePageChange\\\"\\n        />\\n      </div>\\n    </el-card>\\n\\n    <el-dialog v-model=\\\"statusDialogVisible\\\" title=\\\"修改客户状态\\\" width=\\\"500px\\\">\\n      <el-form :model=\\\"statusForm\\\" :rules=\\\"statusRules\\\" ref=\\\"statusFormRef\\\" label-width=\\\"100px\\\">\\n        <el-form-item label=\\\"客户姓名\\\">\\n          <el-input v-model=\\\"statusForm.customerName\\\" disabled />\\n        </el-form-item>\\n        <el-form-item label=\\\"当前状态\\\">\\n          <el-tag :type=\\\"getStatusType(statusForm.currentStatus)\\\" size=\\\"small\\\">\\n            {{ getStatusText(statusForm.currentStatus) }}\\n          </el-tag>\\n        </el-form-item>\\n        <el-form-item label=\\\"新状态\\\" prop=\\\"newStatus\\\">\\n          <el-select v-model=\\\"statusForm.newStatus\\\" placeholder=\\\"请选择新状态\\\">\\n            <el-option label=\\\"活跃\\\" value=\\\"active\\\" />\\n            <el-option label=\\\"非活跃\\\" value=\\\"inactive\\\" />\\n            <el-option label=\\\"黑名单\\\" value=\\\"blacklisted\\\" />\\n          </el-select>\\n        </el-form-item>\\n        <el-form-item label=\\\"变更原因\\\" prop=\\\"reason\\\">\\n          <el-input\\n            v-model=\\\"statusForm.reason\\\"\\n            type=\\\"textarea\\\"\\n            :rows=\\\"3\\\"\\n            placeholder=\\\"请输入变更原因\\\"\\n          />\\n        </el-form-item>\\n      </el-form>\\n      <template #footer>\\n        <el-button @click=\\\"statusDialogVisible = false\\\">取消</el-button>\\n        <el-button type=\\\"primary\\\" @click=\\\"handleStatusSubmit\\\" :loading=\\\"submitting\\\">\\n          确定\\n        </el-button>\\n      </template>\\n    </el-dialog>\\n\\n    <el-dialog v-model=\\\"historyDialogVisible\\\" title=\\\"客户状态历史\\\" width=\\\"800px\\\">\\n      <el-table :data=\\\"statusHistoryList\\\" stripe border max-height=\\\"400\\\">\\n        <el-table-column prop=\\\"oldStatus\\\" label=\\\"旧状态\\\" width=\\\"100\\\">\\n          <template #default=\\\"{ row }\\\">\\n            <el-tag v-if=\\\"row.oldStatus\\\" :type=\\\"getStatusType(row.oldStatus)\\\" size=\\\"small\\\">\\n              {{ getStatusText(row.oldStatus) }}\\n            </el-tag>\\n            <span v-else>-</span>\\n          </template>\\n        </el-table-column>\\n        <el-table-column prop=\\\"newStatus\\\" label=\\\"新状态\\\" width=\\\"100\\\">\\n          <template #default=\\\"{ row }\\\">\\n            <el-tag :type=\\\"getStatusType(row.newStatus)\\\" size=\\\"small\\\">\\n              {{ getStatusText(row.newStatus) }}\\n            </el-tag>\\n          </template>\\n        </el-table-column>\\n        <el-table-column prop=\\\"changedBy\\\" label=\\\"变更人\\\" width=\\\"120\\\" />\\n        <el-table-column prop=\\\"changedAt\\\" label=\\\"变更时间\\\" width=\\\"160\\\">\\n          <template #default=\\\"{ row }\\\">\\n            {{ formatDate(row.changedAt) }}\\n          </template>\\n        </el-table-column>\\n        <el-table-column prop=\\\"reason\\\" label=\\\"变更原因\\\" show-overflow-tooltip />\\n      </el-table>\\n      <template #footer>\\n        <el-button @click=\\\"historyDialogVisible = false\\\">关闭</el-button>\\n      </template>\\n    </el-dialog>\\n  </div>\\n</template>\\n\\n<script setup lang=\\\"ts\\\">\\nimport { ref, reactive, onMounted } from 'vue'\\nimport { ElMessage, ElMessageBox } from 'element-plus'\\nimport { Refresh } from '@element-plus/icons-vue'\\nimport { getCustomers, updateCustomerStatus, getCustomerStatusHistory, getCustomerStatistics } from '@/api/customer'\\nimport type { Customer, CustomerStatusHistory } from '@/api/customer'\\n\\nconst loading = ref(false)\\nconst submitting = ref(false)\\nconst statusDialogVisible = ref(false)\\nconst historyDialogVisible = ref(false)\\nconst statusFormRef = ref()\\n\\nconst statistics = reactive({\\n  active: 0,\\n  inactive: 0,\\n  blacklisted: 0,\\n  total: 0\\n})\\n\\nconst filters = reactive({\\n  name: '',\\n  phone: '',\\n  status: '',\\n  registerDateRange: []\\n})\\n\\nconst pagination = reactive({\\n  page: 1,\\n  size: 20,\\n  total: 0\\n})\\n\\nconst customerList = ref<Customer[]>([])\\nconst statusHistoryList = ref<CustomerStatusHistory[]>([])\\n\\nconst statusForm = reactive({\\n  customerId: '',\\n  customerName: '',\\n  currentStatus: '',\\n  newStatus: '',\\n  reason: ''\\n})\\n\\nconst statusRules = {\\n  newStatus: [\\n    { required: true, message: '请选择新状态', trigger: 'change' }\\n  ],\\n  reason: [\\n    { required: true, message: '请输入变更原因', trigger: 'blur' },\\n    { min: 5, message: '变更原因至少5个字符', trigger: 'blur' }\\n  ]\\n}\\n\\nconst getStatusType = (status: string) => {\\n  const typeMap: Record<string, any> = {\\n    active: 'success',\\n    inactive: 'info',\\n    blacklisted: 'danger'\\n  }\\n  return typeMap[status] || ''\\n}\\n\\nconst getStatusText = (status: string) => {\\n  const textMap: Record<string, string> = {\\n    active: '活跃',\\n    inactive: '非活跃',\\n    blacklisted: '黑名单'\\n  }\\n  return textMap[status] || status\\n}\\n\\nconst formatDate = (date: string) => {\\n  if (!date) return '-'\\n  return new Date(date).toLocaleString('zh-CN')\\n}\\n\\nconst loadStatistics = async () => {\\n  try {\\n    const data = await getCustomerStatistics()\\n    Object.assign(statistics, data)\\n  } catch (error) {\\n    console.error('加载统计数据失败:', error)\\n  }\\n}\\n\\nconst loadCustomerList = async () => {\\n  loading.value = true\\n  try {\\n    const params = {\\n      keyword: filters.name,\\n      phone: filters.phone,\\n      status: filters.status,\\n      page: pagination.page,\\n      size: pagination.size\\n    }\\n\\n    if (filters.registerDateRange && filters.registerDateRange.length === 2) {\\n      Object.assign(params, {\\n        registerDateStart: filters.registerDateRange[0],\\n        registerDateEnd: filters.registerDateRange[1]\\n      })\\n    }\\n\\n    const result = await getCustomers(params)\\n    customerList.value = result.data || []\\n    pagination.total = result.total || 0\\n  } catch (error) {\\n    ElMessage.error('加载客户列表失败')\\n    console.error(error)\\n  } finally {\\n    loading.value = false\\n  }\\n}\\n\\nconst refreshData = () => {\\n  loadStatistics()\\n  loadCustomerList()\\n}\\n\\nconst handleSearch = () => {\\n  pagination.page = 1\\n  loadCustomerList()\\n}\\n\\nconst handleReset = () => {\\n  filters.name = ''\\n  filters.phone = ''\\n  filters.status = ''\\n  filters.registerDateRange = []\\n  pagination.page = 1\\n  loadCustomerList()\\n}\\n\\nconst handleSizeChange = (size: number) => {\\n  pagination.size = size\\n  pagination.page = 1\\n  loadCustomerList()\\n}\\n\\nconst handlePageChange = (page: number) => {\\n  pagination.page = page\\n  loadCustomerList()\\n}\\n\\nconst handleViewDetail = (row: Customer) => {\\n  ElMessage.info('查看详情功能待实现')\\n}\\n\\nconst handleChangeStatus = (row: Customer) => {\\n  statusForm.customerId = row.id\\n  statusForm.customerName = row.name\\n  statusForm.currentStatus = row.status\\n  statusForm.newStatus = ''\\n  statusForm.reason = ''\\n  statusDialogVisible.value = true\\n}\\n\\nconst handleStatusSubmit = async () => {\\n  if (!statusFormRef.value) return\\n\\n  try {\\n    await statusFormRef.value.validate()\\n    submitting.value = true\\n\\n    await updateCustomerStatus(statusForm.customerId, statusForm.newStatus as any)\\n\\n    ElMessage.success('状态修改成功')\\n    statusDialogVisible.value = false\\n    refreshData()\\n  } catch (error: any) {\\n    if (error !== false) {\\n      ElMessage.error(error.message || '状态修改失败')\\n    }\\n  } finally {\\n    submitting.value = false\\n  }\\n}\\n\\nconst handleViewHistory = async (row: Customer) => {\\n  try {\\n    const result = await getCustomerStatusHistory(row.id)\\n    statusHistoryList.value = result.data || []\\n    historyDialogVisible.value = true\\n  } catch (error) {\\n    ElMessage.error('加载状态历史失败')\\n    console.error(error)\\n  }\\n}\\n\\nonMounted(() => {\\n  loadStatistics()\\n  loadCustomerList()\\n})\\n</script>\\n\\n<style scoped lang=\\\"scss\\\">\\n.customer-status-tracker {\\n  padding: 20px;\\n\\n  .status-card,\\n  .filter-card,\\n  .table-card {\\n    margin-bottom: 20px;\\n  }\\n\\n  .card-header {\\n    display: flex;\\n    justify-content: space-between;\\n    align-items: center;\\n\\n    .card-title {\\n      font-size: 16px;\\n      font-weight: 600;\\n    }\\n  }\\n\\n  .status-overview {\\n    display: flex;\\n    justify-content: space-around;\\n    padding: 20px 0;\\n\\n    .status-item {\\n      text-align: center;\\n\\n      .status-count {\\n        font-size: 32px;\\n        font-weight: 600;\\n        margin-bottom: 8px;\\n      }\\n\\n      .status-label {\\n        font-size: 14px;\\n        color: #909399;\\n      }\\n\\n      &.active .status-count {\\n        color: #67c23a;\\n      }\\n\\n      &.inactive .status-count {\\n        color: #909399;\\n      }\\n\\n      &.blacklisted .status-count {\\n        color: #f56c6c;\\n      }\\n\\n      &.total .status-count {\\n        color: #409eff;\\n      }\\n    }\\n  }\\n\\n  .pagination-container {\\n    display: flex;\\n    justify-content: flex-end;\\n    margin-top: 20px;\\n  }\\n}\\n</style>\\n\",\"originTextLength\":12801,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768912921200}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/views/CustomerHistoryQuery.vue": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":589,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":589,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"<template>\\\\n  <div class=\\\\\\\"customer-history-query\\\\\\\">\\\\n    <el-card class=\\\\\\\"customer-info-card\\\\\\\">\\\\n      <template #header>\\\\n        <div class=\\\\\\\"card-header\\\\\\\">\\\\n          <span class=\\\\\\\"card-title\\\\\\\">客户信息</span>\\\\n          <el-button type=\\\\\\\"primary\\\\\\\" link @click=\\\\\\\"handleBack\\\\\\\">返回列表</el-button>\\\\n        </div>\\\\n      </template>\\\\n\\\\n      <div class=\\\\\\\"customer-info\\\\\\\" v-loading=\\\\\\\"customerLoading\\\\\\\">\\\\n        <div class=\\\\\\\"info-row\\\\\\\">\\\\n          <span class=\\\\\\\"label\\\\\\\">客户姓名：</span>\\\\n          <span class=\\\\\\\"value\\\\\\\">{{ customerInfo.name }}</span>\\\\n        </div>\\\\n        <div class=\\\\\\\"info-row\\\\\\\">\\\\n          <span class=\\\\\\\"label\\\\\\\">手机号：</span>\\\\n          <span class=\\\\\\\"value\\\\\\\">{{ customerInfo.phone }}</span>\\\\n        </div>\\\\n        <div class=\\\\\\\"info-row\\\\\\\">\\\\n          <span class=\\\\\\\"label\\\\\\\">邮箱：</span>\\\\n          <span class=\\\\\\\"value\\\\\\\">{{ customerInfo.email || \\\\'-\\\\' }}</span>\\\\n        </div>\\\\n        <div class=\\\\\\\"info-row\\\\\\\">\\\\n          <span class=\\\\\\\"label\\\\\\\">会员等级：</span>\\\\n          <span class=\\\\\\\"value\\\\\\\">{{ customerInfo.memberLevel || \\\\'普通会员\\\\' }}</span>\\\\n        </div>\\\\n        <div class=\\\\\\\"info-row\\\\\\\">\\\\n          <span class=\\\\\\\"label\\\\\\\">累计消费：</span>\\\\n          <span class=\\\\\\\"value\\\\\\\">¥{{ customerInfo.totalSpent?.toFixed(2) || \\\\'0.00\\\\' }}</span>\\\\n        </div>\\\\n        <div class=\\\\\\\"info-row\\\\\\\">\\\\n          <span class=\\\\\\\"label\\\\\\\">订单数：</span>\\\\n          <span class=\\\\\\\"value\\\\\\\">{{ customerInfo.totalOrders || 0 }}</span>\\\\n        </div>\\\\n        <div class=\\\\\\\"info-row\\\\\\\">\\\\n          <span class=\\\\\\\"label\\\\\\\">积分：</span>\\\\n          <span class=\\\\\\\"value\\\\\\\">{{ customerInfo.points || 0 }}</span>\\\\n        </div>\\\\n        <div class=\\\\\\\"info-row\\\\\\\">\\\\n          <span class=\\\\\\\"label\\\\\\\">注册时间：</span>\\\\n          <span class=\\\\\\\"value\\\\\\\">{{ formatDate(customerInfo.createdAt) }}</span>\\\\n        </div>\\\\n      </div>\\\\n    </el-card>\\\\n\\\\n    <el-card class=\\\\\\\"history-tabs-card\\\\\\\">\\\\n      <el-tabs v-model=\\\\\\\"activeTab\\\\\\\" type=\\\\\\\"border-card\\\\\\\">\\\\n        <el-tab-pane label=\\\\\\\"订单历史\\\\\\\" name=\\\\\\\"orders\\\\\\\">\\\\n          <div class=\\\\\\\"tab-content\\\\\\\">\\\\n            <div class=\\\\\\\"filter-bar\\\\\\\">\\\\n              <el-date-picker\\\\n                v-model=\\\\\\\"orderFilters.dateRange\\\\\\\"\\\\n                type=\\\\\\\"daterange\\\\\\\"\\\\n                range-separator=\\\\\\\"至\\\\\\\"\\\\n                start-placeholder=\\\\\\\"开始日期\\\\\\\"\\\\n                end-placeholder=\\\\\\\"结束日期\\\\\\\"\\\\n                value-format=\\\\\\\"YYYY-MM-DD\\\\\\\"\\\\n                style=\\\\\\\"width: 300px\\\\\\\"\\\\n              />\\\\n              <el-button type=\\\\\\\"primary\\\\\\\" @click=\\\\\\\"loadOrderHistory\\\\\\\">查询</el-button>\\\\n              <el-button @click=\\\\\\\"resetOrderFilters\\\\\\\">重置</el-button>\\\\n            </div>\\\\n\\\\n            <el-table :data=\\\\\\\"orderHistoryList\\\\\\\" stripe v-loading=\\\\\\\"orderLoading\\\\\\\" border>\\\\n              <el-table-column prop=\\\\\\\"orderNo\\\\\\\" label=\\\\\\\"订单号\\\\\\\" width=\\\\\\\"180\\\\\\\" />\\\\n              <el-table-column prop=\\\\\\\"orderAmount\\\\\\\" label=\\\\\\\"订单金额\\\\\\\" width=\\\\\\\"120\\\\\\\">\\\\n                <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                  ¥{{ row.orderAmount?.toFixed(2) || \\\\'0.00\\\\' }}\\\\n                </template>\\\\n              </el-table-column>\\\\n              <el-table-column prop=\\\\\\\"orderStatus\\\\\\\" label=\\\\\\\"订单状态\\\\\\\" width=\\\\\\\"100\\\\\\\">\\\\n                <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                  <el-tag :type=\\\\\\\"getOrderStatusType(row.orderStatus)\\\\\\\" size=\\\\\\\"small\\\\\\\">\\\\n                    {{ getOrderStatusText(row.orderStatus) }}\\\\n                  </el-tag>\\\\n                </template>\\\\n              </el-table-column>\\\\n              <el-table-column prop=\\\\\\\"paymentMethod\\\\\\\" label=\\\\\\\"支付方式\\\\\\\" width=\\\\\\\"100\\\\\\\" />\\\\n              <el-table-column prop=\\\\\\\"createdAt\\\\\\\" label=\\\\\\\"下单时间\\\\\\\" width=\\\\\\\"160\\\\\\\">\\\\n                <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                  {{ formatDate(row.createdAt) }}\\\\n                </template>\\\\n              </el-table-column>\\\\n              <el-table-column label=\\\\\\\"操作\\\\\\\" width=\\\\\\\"100\\\\\\\">\\\\n                <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                  <el-button type=\\\\\\\"primary\\\\\\\" link size=\\\\\\\"small\\\\\\\" @click=\\\\\\\"handleViewOrder(row)\\\\\\\">\\\\n                    查看详情\\\\n                  </el-button>\\\\n                </template>\\\\n              </el-table-column>\\\\n            </el-table>\\\\n\\\\n            <div class=\\\\\\\"pagination-container\\\\\\\">\\\\n              <el-pagination\\\\n                v-model:current-page=\\\\\\\"orderPagination.page\\\\\\\"\\\\n                v-model:page-size=\\\\\\\"orderPagination.size\\\\\\\"\\\\n                :total=\\\\\\\"orderPagination.total\\\\\\\"\\\\n                :page-sizes=\\\\\\\"[10, 20, 50]\\\\\\\"\\\\n                layout=\\\\\\\"total, sizes, prev, pager, next, jumper\\\\\\\"\\\\n                @size-change=\\\\\\\"handleOrderSizeChange\\\\\\\"\\\\n                @current-change=\\\\\\\"handleOrderPageChange\\\\\\\"\\\\n              />\\\\n            </div>\\\\n          </div>\\\\n        </el-tab-pane>\\\\n\\\\n        <el-tab-pane label=\\\\\\\"积分历史\\\\\\\" name=\\\\\\\"points\\\\\\\">\\\\n          <div class=\\\\\\\"tab-content\\\\\\\">\\\\n            <div class=\\\\\\\"filter-bar\\\\\\\">\\\\n              <el-select v-model=\\\\\\\"pointFilters.type\\\\\\\" placeholder=\\\\\\\"积分类型\\\\\\\" clearable style=\\\\\\\"width: 150px\\\\\\\">\\\\n                <el-option label=\\\\\\\"全部\\\\\\\" value=\\\\\\\"\\\\\\\" />\\\\n                <el-option label=\\\\\\\"获得\\\\\\\" value=\\\\\\\"earn\\\\\\\" />\\\\n                <el-option label=\\\\\\\"消费\\\\\\\" value=\\\\\\\"spend\\\\\\\" />\\\\n                <el-option label=\\\\\\\"过期\\\\\\\" value=\\\\\\\"expire\\\\\\\" />\\\\n              </el-select>\\\\n              <el-date-picker\\\\n                v-model=\\\\\\\"pointFilters.dateRange\\\\\\\"\\\\n                type=\\\\\\\"daterange\\\\\\\"\\\\n                range-separator=\\\\\\\"至\\\\\\\"\\\\n                start-placeholder=\\\\\\\"开始日期\\\\\\\"\\\\n                end-placeholder=\\\\\\\"结束日期\\\\\\\"\\\\n                value-format=\\\\\\\"YYYY-MM-DD\\\\\\\"\\\\n                style=\\\\\\\"width: 300px\\\\\\\"\\\\n              />\\\\n              <el-button type=\\\\\\\"primary\\\\\\\" @click=\\\\\\\"loadPointsHistory\\\\\\\">查询</el-button>\\\\n              <el-button @click=\\\\\\\"resetPointFilters\\\\\\\">重置</el-button>\\\\n            </div>\\\\n\\\\n            <el-table :data=\\\\\\\"pointsHistoryList\\\\\\\" stripe v-loading=\\\\\\\"pointsLoading\\\\\\\" border>\\\\n              <el-table-column prop=\\\\\\\"pointsChange\\\\\\\" label=\\\\\\\"积分变化\\\\\\\" width=\\\\\\\"120\\\\\\\">\\\\n                <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                  <span :class=\\\\\\\"row.pointsChange > 0 ? \\\\'points-positive\\\\' : \\\\'points-negative\\\\'\\\\\\\">\\\\n                    {{ row.pointsChange > 0 ? \\\\'+\\\\' : \\\\'\\\\' }}{{ row.pointsChange }}\\\\n                  </span>\\\\n                </template>\\\\n              </el-table-column>\\\\n              <el-table-column prop=\\\\\\\"pointsAfter\\\\\\\" label=\\\\\\\"变化后积分\\\\\\\" width=\\\\\\\"120\\\\\\\" />\\\\n              <el-table-column prop=\\\\\\\"changeType\\\\\\\" label=\\\\\\\"变化类型\\\\\\\" width=\\\\\\\"100\\\\\\\">\\\\n                <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                  <el-tag :type=\\\\\\\"getPointsTypeTag(row.changeType)\\\\\\\" size=\\\\\\\"small\\\\\\\">\\\\n                    {{ getPointsTypeText(row.changeType) }}\\\\n                  </el-tag>\\\\n                </template>\\\\n              </el-table-column>\\\\n              <el-table-column prop=\\\\\\\"description\\\\\\\" label=\\\\\\\"说明\\\\\\\" show-overflow-tooltip />\\\\n              <el-table-column prop=\\\\\\\"createdAt\\\\\\\" label=\\\\\\\"时间\\\\\\\" width=\\\\\\\"160\\\\\\\">\\\\n                <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                  {{ formatDate(row.createdAt) }}\\\\n                </template>\\\\n              </el-table-column>\\\\n            </el-table>\\\\n\\\\n            <div class=\\\\\\\"pagination-container\\\\\\\">\\\\n              <el-pagination\\\\n                v-model:current-page=\\\\\\\"pointsPagination.page\\\\\\\"\\\\n                v-model:page-size=\\\\\\\"pointsPagination.size\\\\\\\"\\\\n                :total=\\\\\\\"pointsPagination.total\\\\\\\"\\\\n                :page-sizes=\\\\\\\"[10, 20, 50]\\\\\\\"\\\\n                layout=\\\\\\\"total, sizes, prev, pager, next, jumper\\\\\\\"\\\\n                @size-change=\\\\\\\"handlePointsSizeChange\\\\\\\"\\\\n                @current-change=\\\\\\\"handlePointsPageChange\\\\\\\"\\\\n              />\\\\n            </div>\\\\n          </div>\\\\n        </el-tab-pane>\\\\n\\\\n        <el-tab-pane label=\\\\\\\"状态历史\\\\\\\" name=\\\\\\\"status\\\\\\\">\\\\n          <div class=\\\\\\\"tab-content\\\\\\\">\\\\n            <el-table :data=\\\\\\\"statusHistoryList\\\\\\\" stripe v-loading=\\\\\\\"statusLoading\\\\\\\" border>\\\\n              <el-table-column prop=\\\\\\\"oldStatus\\\\\\\" label=\\\\\\\"旧状态\\\\\\\" width=\\\\\\\"100\\\\\\\">\\\\n                <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                  <el-tag v-if=\\\\\\\"row.oldStatus\\\\\\\" :type=\\\\\\\"getStatusType(row.oldStatus)\\\\\\\" size=\\\\\\\"small\\\\\\\">\\\\n                    {{ getStatusText(row.oldStatus) }}\\\\n                  </el-tag>\\\\n                  <span v-else>-</span>\\\\n                </template>\\\\n              </el-table-column>\\\\n              <el-table-column prop=\\\\\\\"newStatus\\\\\\\" label=\\\\\\\"新状态\\\\\\\" width=\\\\\\\"100\\\\\\\">\\\\n                <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                  <el-tag :type=\\\\\\\"getStatusType(row.newStatus)\\\\\\\" size=\\\\\\\"small\\\\\\\">\\\\n                    {{ getStatusText(row.newStatus) }}\\\\n                  </el-tag>\\\\n                </template>\\\\n              </el-table-column>\\\\n              <el-table-column prop=\\\\\\\"changedBy\\\\\\\" label=\\\\\\\"变更人\\\\\\\" width=\\\\\\\"120\\\\\\\" />\\\\n              <el-table-column prop=\\\\\\\"changedAt\\\\\\\" label=\\\\\\\"变更时间\\\\\\\" width=\\\\\\\"160\\\\\\\">\\\\n                <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                  {{ formatDate(row.changedAt) }}\\\\n                </template>\\\\n              </el-table-column>\\\\n              <el-table-column prop=\\\\\\\"reason\\\\\\\" label=\\\\\\\"变更原因\\\\\\\" show-overflow-tooltip />\\\\n            </el-table>\\\\n\\\\n            <div class=\\\\\\\"pagination-container\\\\\\\">\\\\n              <el-pagination\\\\n                v-model:current-page=\\\\\\\"statusPagination.page\\\\\\\"\\\\n                v-model:page-size=\\\\\\\"statusPagination.size\\\\\\\"\\\\n                :total=\\\\\\\"statusPagination.total\\\\\\\"\\\\n                :page-sizes=\\\\\\\"[10, 20, 50]\\\\\\\"\\\\n                layout=\\\\\\\"total, sizes, prev, pager, next, jumper\\\\\\\"\\\\n                @size-change=\\\\\\\"handleStatusSizeChange\\\\\\\"\\\\n                @current-change=\\\\\\\"handleStatusPageChange\\\\\\\"\\\\n              />\\\\n            </div>\\\\n          </div>\\\\n        </el-tab-pane>\\\\n\\\\n        <el-tab-pane label=\\\\\\\"访问记录\\\\\\\" name=\\\\\\\"visits\\\\\\\">\\\\n          <div class=\\\\\\\"tab-content\\\\\\\">\\\\n            <div class=\\\\\\\"filter-bar\\\\\\\">\\\\n              <el-date-picker\\\\n                v-model=\\\\\\\"visitFilters.dateRange\\\\\\\"\\\\n                type=\\\\\\\"daterange\\\\\\\"\\\\n                range-separator=\\\\\\\"至\\\\\\\"\\\\n                start-placeholder=\\\\\\\"开始日期\\\\\\\"\\\\n                end-placeholder=\\\\\\\"结束日期\\\\\\\"\\\\n                value-format=\\\\\\\"YYYY-MM-DD\\\\\\\"\\\\n                style=\\\\\\\"width: 300px\\\\\\\"\\\\n              />\\\\n              <el-button type=\\\\\\\"primary\\\\\\\" @click=\\\\\\\"loadVisitHistory\\\\\\\">查询</el-button>\\\\n              <el-button @click=\\\\\\\"resetVisitFilters\\\\\\\">重置</el-button>\\\\n            </div>\\\\n\\\\n            <el-table :data=\\\\\\\"visitHistoryList\\\\\\\" stripe v-loading=\\\\\\\"visitLoading\\\\\\\" border>\\\\n              <el-table-column prop=\\\\\\\"visitType\\\\\\\" label=\\\\\\\"访问类型\\\\\\\" width=\\\\\\\"120\\\\\\\" />\\\\n              <el-table-column prop=\\\\\\\"deviceType\\\\\\\" label=\\\\\\\"设备类型\\\\\\\" width=\\\\\\\"100\\\\\\\" />\\\\n              <el-table-column prop=\\\\\\\"ipAddress\\\\\\\" label=\\\\\\\"IP地址\\\\\\\" width=\\\\\\\"150\\\\\\\" />\\\\n              <el-table-column prop=\\\\\\\"location\\\\\\\" label=\\\\\\\"位置\\\\\\\" width=\\\\\\\"150\\\\\\\" />\\\\n              <el-table-column prop=\\\\\\\"visitDuration\\\\\\\" label=\\\\\\\"停留时长\\\\\\\" width=\\\\\\\"100\\\\\\\">\\\\n                <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                  {{ formatDuration(row.visitDuration) }}\\\\n                </template>\\\\n              </el-table-column>\\\\n              <el-table-column prop=\\\\\\\"visitedAt\\\\\\\" label=\\\\\\\"访问时间\\\\\\\" width=\\\\\\\"160\\\\\\\">\\\\n                <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                  {{ formatDate(row.visitedAt) }}\\\\n                </template>\\\\n              </el-table-column>\\\\n            </el-table>\\\\n\\\\n            <div class=\\\\\\\"pagination-container\\\\\\\">\\\\n              <el-pagination\\\\n                v-model:current-page=\\\\\\\"visitPagination.page\\\\\\\"\\\\n                v-model:page-size=\\\\\\\"visitPagination.size\\\\\\\"\\\\n                :total=\\\\\\\"visitPagination.total\\\\\\\"\\\\n                :page-sizes=\\\\\\\"[10, 20, 50]\\\\\\\"\\\\n                layout=\\\\\\\"total, sizes, prev, pager, next, jumper\\\\\\\"\\\\n                @size-change=\\\\\\\"handleVisitSizeChange\\\\\\\"\\\\n                @current-change=\\\\\\\"handleVisitPageChange\\\\\\\"\\\\n              />\\\\n            </div>\\\\n          </div>\\\\n        </el-tab-pane>\\\\n      </el-tabs>\\\\n    </el-card>\\\\n  </div>\\\\n</template>\\\\n\\\\n<script setup lang=\\\\\\\"ts\\\\\\\">\\\\nimport { ref, reactive, onMounted } from \\\\'vue\\\\'\\\\nimport { useRoute, useRouter } from \\\\'vue-router\\\\'\\\\nimport { ElMessage } from \\\\'element-plus\\\\'\\\\nimport { getCustomerDetail, getCustomerOrderHistory, getCustomerPointsHistory, getCustomerStatusHistory } from \\\\'@/api/customer\\\\'\\\\nimport type { Customer, CustomerStatusHistory } from \\\\'@/api/customer\\\\'\\\\n\\\\nconst route = useRoute()\\\\nconst router = useRouter()\\\\n\\\\nconst customerId = ref(route.params.id as string)\\\\n\\\\nconst customerLoading = ref(false)\\\\nconst orderLoading = ref(false)\\\\nconst pointsLoading = ref(false)\\\\nconst statusLoading = ref(false)\\\\nconst visitLoading = ref(false)\\\\n\\\\nconst activeTab = ref(\\\\'orders\\\\')\\\\n\\\\nconst customerInfo = reactive({\\\\n  id: \\\\'\\\\',\\\\n  name: \\\\'\\\\',\\\\n  phone: \\\\'\\\\',\\\\n  email: \\\\'\\\\',\\\\n  memberLevel: \\\\'\\\\',\\\\n  totalSpent: 0,\\\\n  totalOrders: 0,\\\\n  points: 0,\\\\n  createdAt: \\\\'\\\\'\\\\n})\\\\n\\\\nconst orderFilters = reactive({\\\\n  dateRange: []\\\\n})\\\\n\\\\nconst pointFilters = reactive({\\\\n  type: \\\\'\\\\',\\\\n  dateRange: []\\\\n})\\\\n\\\\nconst visitFilters = reactive({\\\\n  dateRange: []\\\\n})\\\\n\\\\nconst orderPagination = reactive({\\\\n  page: 1,\\\\n  size: 20,\\\\n  total: 0\\\\n})\\\\n\\\\nconst pointsPagination = reactive({\\\\n  page: 1,\\\\n  size: 20,\\\\n  total: 0\\\\n})\\\\n\\\\nconst statusPagination = reactive({\\\\n  page: 1,\\\\n  size: 20,\\\\n  total: 0\\\\n})\\\\n\\\\nconst visitPagination = reactive({\\\\n  page: 1,\\\\n  size: 20,\\\\n  total: 0\\\\n})\\\\n\\\\nconst orderHistoryList = ref<any[]>([])\\\\nconst pointsHistoryList = ref<any[]>([])\\\\nconst statusHistoryList = ref<CustomerStatusHistory[]>([])\\\\nconst visitHistoryList = ref<any[]>([])\\\\n\\\\nconst formatDate = (date: string) => {\\\\n  if (!date) return \\\\'-\\\\'\\\\n  return new Date(date).toLocaleString(\\\\'zh-CN\\\\')\\\\n}\\\\n\\\\nconst formatDuration = (seconds: number) => {\\\\n  if (!seconds) return \\\\'-\\\\'\\\\n  const hours = Math.floor(seconds / 3600)\\\\n  const minutes = Math.floor((seconds % 3600) / 60)\\\\n  const secs = seconds % 60\\\\n  return `${hours}小时${minutes}分${secs}秒`\\\\n}\\\\n\\\\nconst getOrderStatusType = (status: string) => {\\\\n  const typeMap: Record<string, any> = {\\\\n    pending: \\\\'warning\\\\',\\\\n    paid: \\\\'primary\\\\',\\\\n    shipped: \\\\'info\\\\',\\\\n    completed: \\\\'success\\\\',\\\\n    cancelled: \\\\'danger\\\\'\\\\n  }\\\\n  return typeMap[status] || \\\\'\\\\'\\\\n}\\\\n\\\\nconst getOrderStatusText = (status: string) => {\\\\n  const textMap: Record<string, string> = {\\\\n    pending: \\\\'待支付\\\\',\\\\n    paid: \\\\'已支付\\\\',\\\\n    shipped: \\\\'已发货\\\\',\\\\n    completed: \\\\'已完成\\\\',\\\\n    cancelled: \\\\'已取消\\\\'\\\\n  }\\\\n  return textMap[status] || status\\\\n}\\\\n\\\\nconst getPointsTypeTag = (type: string) => {\\\\n  const typeMap: Record<string, any> = {\\\\n    earn: \\\\'success\\\\',\\\\n    spend: \\\\'warning\\\\',\\\\n    expire: \\\\'info\\\\'\\\\n  }\\\\n  return typeMap[type] || \\\\'\\\\'\\\\n}\\\\n\\\\nconst getPointsTypeText = (type: string) => {\\\\n  const textMap: Record<string, string> = {\\\\n    earn: \\\\'获得\\\\',\\\\n    spend: \\\\'消费\\\\',\\\\n    expire: \\\\'过期\\\\'\\\\n  }\\\\n  return textMap[type] || type\\\\n}\\\\n\\\\nconst getStatusType = (status: string) => {\\\\n  const typeMap: Record<string, any> = {\\\\n    active: \\\\'success\\\\',\\\\n    inactive: \\\\'info\\\\',\\\\n    blacklisted: \\\\'danger\\\\'\\\\n  }\\\\n  return typeMap[status] || \\\\'\\\\'\\\\n}\\\\n\\\\nconst getStatusText = (status: string) => {\\\\n  const textMap: Record<string, string> = {\\\\n    active: \\\\'活跃\\\\',\\\\n    inactive: \\\\'非活跃\\\\',\\\\n    blacklisted: \\\\'黑名单\\\\'\\\\n  }\\\\n  return textMap[status] || status\\\\n}\\\\n\\\\nconst loadCustomerInfo = async () => {\\\\n  customerLoading.value = true\\\\n  try {\\\\n    const data = await getCustomerDetail(customerId.value)\\\\n    Object.assign(customerInfo, data)\\\\n  } catch (error) {\\\\n    ElMessage.error(\\\\'加载客户信息失败\\\\')\\\\n    console.error(error)\\\\n  } finally {\\\\n    customerLoading.value = false\\\\n  }\\\\n}\\\\n\\\\nconst loadOrderHistory = async () => {\\\\n  orderLoading.value = true\\\\n  try {\\\\n    const params = {\\\\n      page: orderPagination.page,\\\\n      size: orderPagination.size\\\\n    }\\\\n\\\\n    if (orderFilters.dateRange && orderFilters.dateRange.length === 2) {\\\\n      Object.assign(params, {\\\\n        startDate: orderFilters.dateRange[0],\\\\n        endDate: orderFilters.dateRange[1]\\\\n      })\\\\n    }\\\\n\\\\n    const result = await getCustomerOrderHistory(customerId.value, params)\\\\n    orderHistoryList.value = result.data || []\\\\n    orderPagination.total = result.total || 0\\\\n  } catch (error) {\\\\n    ElMessage.error(\\\\'加载订单历史失败\\\\')\\\\n    console.error(error)\\\\n  } finally {\\\\n    orderLoading.value = false\\\\n  }\\\\n}\\\\n\\\\nconst loadPointsHistory = async () => {\\\\n  pointsLoading.value = true\\\\n  try {\\\\n    const params = {\\\\n      page: pointsPagination.page,\\\\n      size: pointsPagination.size\\\\n    }\\\\n\\\\n    if (pointFilters.type) {\\\\n      Object.assign(params, { type: pointFilters.type })\\\\n    }\\\\n\\\\n    if (pointFilters.dateRange && pointFilters.dateRange.length === 2) {\\\\n      Object.assign(params, {\\\\n        startDate: pointFilters.dateRange[0],\\\\n        endDate: pointFilters.dateRange[1]\\\\n      })\\\\n    }\\\\n\\\\n    const result = await getCustomerPointsHistory(customerId.value, params)\\\\n    pointsHistoryList.value = result.data || []\\\\n    pointsPagination.total = result.total || 0\\\\n  } catch (error) {\\\\n    ElMessage.error(\\\\'加载积分历史失败\\\\')\\\\n    console.error(error)\\\\n  } finally {\\\\n    pointsLoading.value = false\\\\n  }\\\\n}\\\\n\\\\nconst loadStatusHistory = async () => {\\\\n  statusLoading.value = true\\\\n  try {\\\\n    const result = await getCustomerStatusHistory(customerId.value, {\\\\n      page: statusPagination.page,\\\\n      size: statusPagination.size\\\\n    })\\\\n    statusHistoryList.value = result.data || []\\\\n    statusPagination.total = result.total || 0\\\\n  } catch (error) {\\\\n    ElMessage.error(\\\\'加载状态历史失败\\\\')\\\\n    console.error(error)\\\\n  } finally {\\\\n    statusLoading.value = false\\\\n  }\\\\n}\\\\n\\\\nconst loadVisitHistory = async () => {\\\\n  visitLoading.value = true\\\\n  try {\\\\n    const params = {\\\\n      page: visitPagination.page,\\\\n      size: visitPagination.size\\\\n    }\\\\n\\\\n    if (visitFilters.dateRange && visitFilters.dateRange.length === 2) {\\\\n      Object.assign(params, {\\\\n        startDate: visitFilters.dateRange[0],\\\\n        endDate: visitFilters.dateRange[1]\\\\n      })\\\\n    }\\\\n\\\\n    visitHistoryList.value = []\\\\n    visitPagination.total = 0\\\\n  } catch (error) {\\\\n    ElMessage.error(\\\\'加载访问记录失败\\\\')\\\\n    console.error(error)\\\\n  } finally {\\\\n    visitLoading.value = false\\\\n  }\\\\n}\\\\n\\\\nconst resetOrderFilters = () => {\\\\n  orderFilters.dateRange = []\\\\n  orderPagination.page = 1\\\\n  loadOrderHistory()\\\\n}\\\\n\\\\nconst resetPointFilters = () => {\\\\n  pointFilters.type = \\\\'\\\\'\\\\n  pointFilters.dateRange = []\\\\n  pointsPagination.page = 1\\\\n  loadPointsHistory()\\\\n}\\\\n\\\\nconst resetVisitFilters = () => {\\\\n  visitFilters.dateRange = []\\\\n  visitPagination.page = 1\\\\n  loadVisitHistory()\\\\n}\\\\n\\\\nconst handleOrderSizeChange = (size: number) => {\\\\n  orderPagination.size = size\\\\n  orderPagination.page = 1\\\\n  loadOrderHistory()\\\\n}\\\\n\\\\nconst handleOrderPageChange = (page: number) => {\\\\n  orderPagination.page = page\\\\n  loadOrderHistory()\\\\n}\\\\n\\\\nconst handlePointsSizeChange = (size: number) => {\\\\n  pointsPagination.size = size\\\\n  pointsPagination.page = 1\\\\n  loadPointsHistory()\\\\n}\\\\n\\\\nconst handlePointsPageChange = (page: number) => {\\\\n  pointsPagination.page = page\\\\n  loadPointsHistory()\\\\n}\\\\n\\\\nconst handleStatusSizeChange = (size: number) => {\\\\n  statusPagination.size = size\\\\n  statusPagination.page = 1\\\\n  loadStatusHistory()\\\\n}\\\\n\\\\nconst handleStatusPageChange = (page: number) => {\\\\n  statusPagination.page = page\\\\n  loadStatusHistory()\\\\n}\\\\n\\\\nconst handleVisitSizeChange = (size: number) => {\\\\n  visitPagination.size = size\\\\n  visitPagination.page = 1\\\\n  loadVisitHistory()\\\\n}\\\\n\\\\nconst handleVisitPageChange = (page: number) => {\\\\n  visitPagination.page = page\\\\n  loadVisitHistory()\\\\n}\\\\n\\\\nconst handleViewOrder = (row: any) => {\\\\n  ElMessage.info(\\\\'查看订单详情功能待实现\\\\')\\\\n}\\\\n\\\\nconst handleBack = () => {\\\\n  router.back()\\\\n}\\\\n\\\\nonMounted(() => {\\\\n  loadCustomerInfo()\\\\n  loadOrderHistory()\\\\n})\\\\n</script>\\\\n\\\\n<style scoped lang=\\\\\\\"scss\\\\\\\">\\\\n.customer-history-query {\\\\n  padding: 20px;\\\\n\\\\n  .customer-info-card,\\\\n  .history-tabs-card {\\\\n    margin-bottom: 20px;\\\\n  }\\\\n\\\\n  .card-header {\\\\n    display: flex;\\\\n    justify-content: space-between;\\\\n    align-items: center;\\\\n\\\\n    .card-title {\\\\n      font-size: 16px;\\\\n      font-weight: 600;\\\\n    }\\\\n  }\\\\n\\\\n  .customer-info {\\\\n    display: grid;\\\\n    grid-template-columns: repeat(2, 1fr);\\\\n    gap: 20px;\\\\n    padding: 10px 0;\\\\n\\\\n    .info-row {\\\\n      display: flex;\\\\n      align-items: center;\\\\n\\\\n      .label {\\\\n        width: 100px;\\\\n        color: #606266;\\\\n        font-weight: 500;\\\\n      }\\\\n\\\\n      .value {\\\\n        color: #303133;\\\\n        font-weight: 600;\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  .tab-content {\\\\n    .filter-bar {\\\\n      margin-bottom: 20px;\\\\n      display: flex;\\\\n      gap: 10px;\\\\n      align-items: center;\\\\n    }\\\\n\\\\n    .points-positive {\\\\n      color: #67c23a;\\\\n      font-weight: 600;\\\\n    }\\\\n\\\\n    .points-negative {\\\\n      color: #f56c6c;\\\\n      font-weight: 600;\\\\n    }\\\\n\\\\n    .pagination-container {\\\\n      display: flex;\\\\n      justify-content: flex-end;\\\\n      margin-top: 20px;\\\\n    }\\\\n  }\\\\n}\\\\n</style>\\\\n\",\"originAcceptText\":\"<template>\\n  <div class=\\\"customer-history-query\\\">\\n    <el-card class=\\\"customer-info-card\\\">\\n      <template #header>\\n        <div class=\\\"card-header\\\">\\n          <span class=\\\"card-title\\\">客户信息</span>\\n          <el-button type=\\\"primary\\\" link @click=\\\"handleBack\\\">返回列表</el-button>\\n        </div>\\n      </template>\\n\\n      <div class=\\\"customer-info\\\" v-loading=\\\"customerLoading\\\">\\n        <div class=\\\"info-row\\\">\\n          <span class=\\\"label\\\">客户姓名：</span>\\n          <span class=\\\"value\\\">{{ customerInfo.name }}</span>\\n        </div>\\n        <div class=\\\"info-row\\\">\\n          <span class=\\\"label\\\">手机号：</span>\\n          <span class=\\\"value\\\">{{ customerInfo.phone }}</span>\\n        </div>\\n        <div class=\\\"info-row\\\">\\n          <span class=\\\"label\\\">邮箱：</span>\\n          <span class=\\\"value\\\">{{ customerInfo.email || '-' }}</span>\\n        </div>\\n        <div class=\\\"info-row\\\">\\n          <span class=\\\"label\\\">会员等级：</span>\\n          <span class=\\\"value\\\">{{ customerInfo.memberLevel || '普通会员' }}</span>\\n        </div>\\n        <div class=\\\"info-row\\\">\\n          <span class=\\\"label\\\">累计消费：</span>\\n          <span class=\\\"value\\\">¥{{ customerInfo.totalSpent?.toFixed(2) || '0.00' }}</span>\\n        </div>\\n        <div class=\\\"info-row\\\">\\n          <span class=\\\"label\\\">订单数：</span>\\n          <span class=\\\"value\\\">{{ customerInfo.totalOrders || 0 }}</span>\\n        </div>\\n        <div class=\\\"info-row\\\">\\n          <span class=\\\"label\\\">积分：</span>\\n          <span class=\\\"value\\\">{{ customerInfo.points || 0 }}</span>\\n        </div>\\n        <div class=\\\"info-row\\\">\\n          <span class=\\\"label\\\">注册时间：</span>\\n          <span class=\\\"value\\\">{{ formatDate(customerInfo.createdAt) }}</span>\\n        </div>\\n      </div>\\n    </el-card>\\n\\n    <el-card class=\\\"history-tabs-card\\\">\\n      <el-tabs v-model=\\\"activeTab\\\" type=\\\"border-card\\\">\\n        <el-tab-pane label=\\\"订单历史\\\" name=\\\"orders\\\">\\n          <div class=\\\"tab-content\\\">\\n            <div class=\\\"filter-bar\\\">\\n              <el-date-picker\\n                v-model=\\\"orderFilters.dateRange\\\"\\n                type=\\\"daterange\\\"\\n                range-separator=\\\"至\\\"\\n                start-placeholder=\\\"开始日期\\\"\\n                end-placeholder=\\\"结束日期\\\"\\n                value-format=\\\"YYYY-MM-DD\\\"\\n                style=\\\"width: 300px\\\"\\n              />\\n              <el-button type=\\\"primary\\\" @click=\\\"loadOrderHistory\\\">查询</el-button>\\n              <el-button @click=\\\"resetOrderFilters\\\">重置</el-button>\\n            </div>\\n\\n            <el-table :data=\\\"orderHistoryList\\\" stripe v-loading=\\\"orderLoading\\\" border>\\n              <el-table-column prop=\\\"orderNo\\\" label=\\\"订单号\\\" width=\\\"180\\\" />\\n              <el-table-column prop=\\\"orderAmount\\\" label=\\\"订单金额\\\" width=\\\"120\\\">\\n                <template #default=\\\"{ row }\\\">\\n                  ¥{{ row.orderAmount?.toFixed(2) || '0.00' }}\\n                </template>\\n              </el-table-column>\\n              <el-table-column prop=\\\"orderStatus\\\" label=\\\"订单状态\\\" width=\\\"100\\\">\\n                <template #default=\\\"{ row }\\\">\\n                  <el-tag :type=\\\"getOrderStatusType(row.orderStatus)\\\" size=\\\"small\\\">\\n                    {{ getOrderStatusText(row.orderStatus) }}\\n                  </el-tag>\\n                </template>\\n              </el-table-column>\\n              <el-table-column prop=\\\"paymentMethod\\\" label=\\\"支付方式\\\" width=\\\"100\\\" />\\n              <el-table-column prop=\\\"createdAt\\\" label=\\\"下单时间\\\" width=\\\"160\\\">\\n                <template #default=\\\"{ row }\\\">\\n                  {{ formatDate(row.createdAt) }}\\n                </template>\\n              </el-table-column>\\n              <el-table-column label=\\\"操作\\\" width=\\\"100\\\">\\n                <template #default=\\\"{ row }\\\">\\n                  <el-button type=\\\"primary\\\" link size=\\\"small\\\" @click=\\\"handleViewOrder(row)\\\">\\n                    查看详情\\n                  </el-button>\\n                </template>\\n              </el-table-column>\\n            </el-table>\\n\\n            <div class=\\\"pagination-container\\\">\\n              <el-pagination\\n                v-model:current-page=\\\"orderPagination.page\\\"\\n                v-model:page-size=\\\"orderPagination.size\\\"\\n                :total=\\\"orderPagination.total\\\"\\n                :page-sizes=\\\"[10, 20, 50]\\\"\\n                layout=\\\"total, sizes, prev, pager, next, jumper\\\"\\n                @size-change=\\\"handleOrderSizeChange\\\"\\n                @current-change=\\\"handleOrderPageChange\\\"\\n              />\\n            </div>\\n          </div>\\n        </el-tab-pane>\\n\\n        <el-tab-pane label=\\\"积分历史\\\" name=\\\"points\\\">\\n          <div class=\\\"tab-content\\\">\\n            <div class=\\\"filter-bar\\\">\\n              <el-select v-model=\\\"pointFilters.type\\\" placeholder=\\\"积分类型\\\" clearable style=\\\"width: 150px\\\">\\n                <el-option label=\\\"全部\\\" value=\\\"\\\" />\\n                <el-option label=\\\"获得\\\" value=\\\"earn\\\" />\\n                <el-option label=\\\"消费\\\" value=\\\"spend\\\" />\\n                <el-option label=\\\"过期\\\" value=\\\"expire\\\" />\\n              </el-select>\\n              <el-date-picker\\n                v-model=\\\"pointFilters.dateRange\\\"\\n                type=\\\"daterange\\\"\\n                range-separator=\\\"至\\\"\\n                start-placeholder=\\\"开始日期\\\"\\n                end-placeholder=\\\"结束日期\\\"\\n                value-format=\\\"YYYY-MM-DD\\\"\\n                style=\\\"width: 300px\\\"\\n              />\\n              <el-button type=\\\"primary\\\" @click=\\\"loadPointsHistory\\\">查询</el-button>\\n              <el-button @click=\\\"resetPointFilters\\\">重置</el-button>\\n            </div>\\n\\n            <el-table :data=\\\"pointsHistoryList\\\" stripe v-loading=\\\"pointsLoading\\\" border>\\n              <el-table-column prop=\\\"pointsChange\\\" label=\\\"积分变化\\\" width=\\\"120\\\">\\n                <template #default=\\\"{ row }\\\">\\n                  <span :class=\\\"row.pointsChange > 0 ? 'points-positive' : 'points-negative'\\\">\\n                    {{ row.pointsChange > 0 ? '+' : '' }}{{ row.pointsChange }}\\n                  </span>\\n                </template>\\n              </el-table-column>\\n              <el-table-column prop=\\\"pointsAfter\\\" label=\\\"变化后积分\\\" width=\\\"120\\\" />\\n              <el-table-column prop=\\\"changeType\\\" label=\\\"变化类型\\\" width=\\\"100\\\">\\n                <template #default=\\\"{ row }\\\">\\n                  <el-tag :type=\\\"getPointsTypeTag(row.changeType)\\\" size=\\\"small\\\">\\n                    {{ getPointsTypeText(row.changeType) }}\\n                  </el-tag>\\n                </template>\\n              </el-table-column>\\n              <el-table-column prop=\\\"description\\\" label=\\\"说明\\\" show-overflow-tooltip />\\n              <el-table-column prop=\\\"createdAt\\\" label=\\\"时间\\\" width=\\\"160\\\">\\n                <template #default=\\\"{ row }\\\">\\n                  {{ formatDate(row.createdAt) }}\\n                </template>\\n              </el-table-column>\\n            </el-table>\\n\\n            <div class=\\\"pagination-container\\\">\\n              <el-pagination\\n                v-model:current-page=\\\"pointsPagination.page\\\"\\n                v-model:page-size=\\\"pointsPagination.size\\\"\\n                :total=\\\"pointsPagination.total\\\"\\n                :page-sizes=\\\"[10, 20, 50]\\\"\\n                layout=\\\"total, sizes, prev, pager, next, jumper\\\"\\n                @size-change=\\\"handlePointsSizeChange\\\"\\n                @current-change=\\\"handlePointsPageChange\\\"\\n              />\\n            </div>\\n          </div>\\n        </el-tab-pane>\\n\\n        <el-tab-pane label=\\\"状态历史\\\" name=\\\"status\\\">\\n          <div class=\\\"tab-content\\\">\\n            <el-table :data=\\\"statusHistoryList\\\" stripe v-loading=\\\"statusLoading\\\" border>\\n              <el-table-column prop=\\\"oldStatus\\\" label=\\\"旧状态\\\" width=\\\"100\\\">\\n                <template #default=\\\"{ row }\\\">\\n                  <el-tag v-if=\\\"row.oldStatus\\\" :type=\\\"getStatusType(row.oldStatus)\\\" size=\\\"small\\\">\\n                    {{ getStatusText(row.oldStatus) }}\\n                  </el-tag>\\n                  <span v-else>-</span>\\n                </template>\\n              </el-table-column>\\n              <el-table-column prop=\\\"newStatus\\\" label=\\\"新状态\\\" width=\\\"100\\\">\\n                <template #default=\\\"{ row }\\\">\\n                  <el-tag :type=\\\"getStatusType(row.newStatus)\\\" size=\\\"small\\\">\\n                    {{ getStatusText(row.newStatus) }}\\n                  </el-tag>\\n                </template>\\n              </el-table-column>\\n              <el-table-column prop=\\\"changedBy\\\" label=\\\"变更人\\\" width=\\\"120\\\" />\\n              <el-table-column prop=\\\"changedAt\\\" label=\\\"变更时间\\\" width=\\\"160\\\">\\n                <template #default=\\\"{ row }\\\">\\n                  {{ formatDate(row.changedAt) }}\\n                </template>\\n              </el-table-column>\\n              <el-table-column prop=\\\"reason\\\" label=\\\"变更原因\\\" show-overflow-tooltip />\\n            </el-table>\\n\\n            <div class=\\\"pagination-container\\\">\\n              <el-pagination\\n                v-model:current-page=\\\"statusPagination.page\\\"\\n                v-model:page-size=\\\"statusPagination.size\\\"\\n                :total=\\\"statusPagination.total\\\"\\n                :page-sizes=\\\"[10, 20, 50]\\\"\\n                layout=\\\"total, sizes, prev, pager, next, jumper\\\"\\n                @size-change=\\\"handleStatusSizeChange\\\"\\n                @current-change=\\\"handleStatusPageChange\\\"\\n              />\\n            </div>\\n          </div>\\n        </el-tab-pane>\\n\\n        <el-tab-pane label=\\\"访问记录\\\" name=\\\"visits\\\">\\n          <div class=\\\"tab-content\\\">\\n            <div class=\\\"filter-bar\\\">\\n              <el-date-picker\\n                v-model=\\\"visitFilters.dateRange\\\"\\n                type=\\\"daterange\\\"\\n                range-separator=\\\"至\\\"\\n                start-placeholder=\\\"开始日期\\\"\\n                end-placeholder=\\\"结束日期\\\"\\n                value-format=\\\"YYYY-MM-DD\\\"\\n                style=\\\"width: 300px\\\"\\n              />\\n              <el-button type=\\\"primary\\\" @click=\\\"loadVisitHistory\\\">查询</el-button>\\n              <el-button @click=\\\"resetVisitFilters\\\">重置</el-button>\\n            </div>\\n\\n            <el-table :data=\\\"visitHistoryList\\\" stripe v-loading=\\\"visitLoading\\\" border>\\n              <el-table-column prop=\\\"visitType\\\" label=\\\"访问类型\\\" width=\\\"120\\\" />\\n              <el-table-column prop=\\\"deviceType\\\" label=\\\"设备类型\\\" width=\\\"100\\\" />\\n              <el-table-column prop=\\\"ipAddress\\\" label=\\\"IP地址\\\" width=\\\"150\\\" />\\n              <el-table-column prop=\\\"location\\\" label=\\\"位置\\\" width=\\\"150\\\" />\\n              <el-table-column prop=\\\"visitDuration\\\" label=\\\"停留时长\\\" width=\\\"100\\\">\\n                <template #default=\\\"{ row }\\\">\\n                  {{ formatDuration(row.visitDuration) }}\\n                </template>\\n              </el-table-column>\\n              <el-table-column prop=\\\"visitedAt\\\" label=\\\"访问时间\\\" width=\\\"160\\\">\\n                <template #default=\\\"{ row }\\\">\\n                  {{ formatDate(row.visitedAt) }}\\n                </template>\\n              </el-table-column>\\n            </el-table>\\n\\n            <div class=\\\"pagination-container\\\">\\n              <el-pagination\\n                v-model:current-page=\\\"visitPagination.page\\\"\\n                v-model:page-size=\\\"visitPagination.size\\\"\\n                :total=\\\"visitPagination.total\\\"\\n                :page-sizes=\\\"[10, 20, 50]\\\"\\n                layout=\\\"total, sizes, prev, pager, next, jumper\\\"\\n                @size-change=\\\"handleVisitSizeChange\\\"\\n                @current-change=\\\"handleVisitPageChange\\\"\\n              />\\n            </div>\\n          </div>\\n        </el-tab-pane>\\n      </el-tabs>\\n    </el-card>\\n  </div>\\n</template>\\n\\n<script setup lang=\\\"ts\\\">\\nimport { ref, reactive, onMounted } from 'vue'\\nimport { useRoute, useRouter } from 'vue-router'\\nimport { ElMessage } from 'element-plus'\\nimport { getCustomerDetail, getCustomerOrderHistory, getCustomerPointsHistory, getCustomerStatusHistory } from '@/api/customer'\\nimport type { Customer, CustomerStatusHistory } from '@/api/customer'\\n\\nconst route = useRoute()\\nconst router = useRouter()\\n\\nconst customerId = ref(route.params.id as string)\\n\\nconst customerLoading = ref(false)\\nconst orderLoading = ref(false)\\nconst pointsLoading = ref(false)\\nconst statusLoading = ref(false)\\nconst visitLoading = ref(false)\\n\\nconst activeTab = ref('orders')\\n\\nconst customerInfo = reactive({\\n  id: '',\\n  name: '',\\n  phone: '',\\n  email: '',\\n  memberLevel: '',\\n  totalSpent: 0,\\n  totalOrders: 0,\\n  points: 0,\\n  createdAt: ''\\n})\\n\\nconst orderFilters = reactive({\\n  dateRange: []\\n})\\n\\nconst pointFilters = reactive({\\n  type: '',\\n  dateRange: []\\n})\\n\\nconst visitFilters = reactive({\\n  dateRange: []\\n})\\n\\nconst orderPagination = reactive({\\n  page: 1,\\n  size: 20,\\n  total: 0\\n})\\n\\nconst pointsPagination = reactive({\\n  page: 1,\\n  size: 20,\\n  total: 0\\n})\\n\\nconst statusPagination = reactive({\\n  page: 1,\\n  size: 20,\\n  total: 0\\n})\\n\\nconst visitPagination = reactive({\\n  page: 1,\\n  size: 20,\\n  total: 0\\n})\\n\\nconst orderHistoryList = ref<any[]>([])\\nconst pointsHistoryList = ref<any[]>([])\\nconst statusHistoryList = ref<CustomerStatusHistory[]>([])\\nconst visitHistoryList = ref<any[]>([])\\n\\nconst formatDate = (date: string) => {\\n  if (!date) return '-'\\n  return new Date(date).toLocaleString('zh-CN')\\n}\\n\\nconst formatDuration = (seconds: number) => {\\n  if (!seconds) return '-'\\n  const hours = Math.floor(seconds / 3600)\\n  const minutes = Math.floor((seconds % 3600) / 60)\\n  const secs = seconds % 60\\n  return `${hours}小时${minutes}分${secs}秒`\\n}\\n\\nconst getOrderStatusType = (status: string) => {\\n  const typeMap: Record<string, any> = {\\n    pending: 'warning',\\n    paid: 'primary',\\n    shipped: 'info',\\n    completed: 'success',\\n    cancelled: 'danger'\\n  }\\n  return typeMap[status] || ''\\n}\\n\\nconst getOrderStatusText = (status: string) => {\\n  const textMap: Record<string, string> = {\\n    pending: '待支付',\\n    paid: '已支付',\\n    shipped: '已发货',\\n    completed: '已完成',\\n    cancelled: '已取消'\\n  }\\n  return textMap[status] || status\\n}\\n\\nconst getPointsTypeTag = (type: string) => {\\n  const typeMap: Record<string, any> = {\\n    earn: 'success',\\n    spend: 'warning',\\n    expire: 'info'\\n  }\\n  return typeMap[type] || ''\\n}\\n\\nconst getPointsTypeText = (type: string) => {\\n  const textMap: Record<string, string> = {\\n    earn: '获得',\\n    spend: '消费',\\n    expire: '过期'\\n  }\\n  return textMap[type] || type\\n}\\n\\nconst getStatusType = (status: string) => {\\n  const typeMap: Record<string, any> = {\\n    active: 'success',\\n    inactive: 'info',\\n    blacklisted: 'danger'\\n  }\\n  return typeMap[status] || ''\\n}\\n\\nconst getStatusText = (status: string) => {\\n  const textMap: Record<string, string> = {\\n    active: '活跃',\\n    inactive: '非活跃',\\n    blacklisted: '黑名单'\\n  }\\n  return textMap[status] || status\\n}\\n\\nconst loadCustomerInfo = async () => {\\n  customerLoading.value = true\\n  try {\\n    const data = await getCustomerDetail(customerId.value)\\n    Object.assign(customerInfo, data)\\n  } catch (error) {\\n    ElMessage.error('加载客户信息失败')\\n    console.error(error)\\n  } finally {\\n    customerLoading.value = false\\n  }\\n}\\n\\nconst loadOrderHistory = async () => {\\n  orderLoading.value = true\\n  try {\\n    const params = {\\n      page: orderPagination.page,\\n      size: orderPagination.size\\n    }\\n\\n    if (orderFilters.dateRange && orderFilters.dateRange.length === 2) {\\n      Object.assign(params, {\\n        startDate: orderFilters.dateRange[0],\\n        endDate: orderFilters.dateRange[1]\\n      })\\n    }\\n\\n    const result = await getCustomerOrderHistory(customerId.value, params)\\n    orderHistoryList.value = result.data || []\\n    orderPagination.total = result.total || 0\\n  } catch (error) {\\n    ElMessage.error('加载订单历史失败')\\n    console.error(error)\\n  } finally {\\n    orderLoading.value = false\\n  }\\n}\\n\\nconst loadPointsHistory = async () => {\\n  pointsLoading.value = true\\n  try {\\n    const params = {\\n      page: pointsPagination.page,\\n      size: pointsPagination.size\\n    }\\n\\n    if (pointFilters.type) {\\n      Object.assign(params, { type: pointFilters.type })\\n    }\\n\\n    if (pointFilters.dateRange && pointFilters.dateRange.length === 2) {\\n      Object.assign(params, {\\n        startDate: pointFilters.dateRange[0],\\n        endDate: pointFilters.dateRange[1]\\n      })\\n    }\\n\\n    const result = await getCustomerPointsHistory(customerId.value, params)\\n    pointsHistoryList.value = result.data || []\\n    pointsPagination.total = result.total || 0\\n  } catch (error) {\\n    ElMessage.error('加载积分历史失败')\\n    console.error(error)\\n  } finally {\\n    pointsLoading.value = false\\n  }\\n}\\n\\nconst loadStatusHistory = async () => {\\n  statusLoading.value = true\\n  try {\\n    const result = await getCustomerStatusHistory(customerId.value, {\\n      page: statusPagination.page,\\n      size: statusPagination.size\\n    })\\n    statusHistoryList.value = result.data || []\\n    statusPagination.total = result.total || 0\\n  } catch (error) {\\n    ElMessage.error('加载状态历史失败')\\n    console.error(error)\\n  } finally {\\n    statusLoading.value = false\\n  }\\n}\\n\\nconst loadVisitHistory = async () => {\\n  visitLoading.value = true\\n  try {\\n    const params = {\\n      page: visitPagination.page,\\n      size: visitPagination.size\\n    }\\n\\n    if (visitFilters.dateRange && visitFilters.dateRange.length === 2) {\\n      Object.assign(params, {\\n        startDate: visitFilters.dateRange[0],\\n        endDate: visitFilters.dateRange[1]\\n      })\\n    }\\n\\n    visitHistoryList.value = []\\n    visitPagination.total = 0\\n  } catch (error) {\\n    ElMessage.error('加载访问记录失败')\\n    console.error(error)\\n  } finally {\\n    visitLoading.value = false\\n  }\\n}\\n\\nconst resetOrderFilters = () => {\\n  orderFilters.dateRange = []\\n  orderPagination.page = 1\\n  loadOrderHistory()\\n}\\n\\nconst resetPointFilters = () => {\\n  pointFilters.type = ''\\n  pointFilters.dateRange = []\\n  pointsPagination.page = 1\\n  loadPointsHistory()\\n}\\n\\nconst resetVisitFilters = () => {\\n  visitFilters.dateRange = []\\n  visitPagination.page = 1\\n  loadVisitHistory()\\n}\\n\\nconst handleOrderSizeChange = (size: number) => {\\n  orderPagination.size = size\\n  orderPagination.page = 1\\n  loadOrderHistory()\\n}\\n\\nconst handleOrderPageChange = (page: number) => {\\n  orderPagination.page = page\\n  loadOrderHistory()\\n}\\n\\nconst handlePointsSizeChange = (size: number) => {\\n  pointsPagination.size = size\\n  pointsPagination.page = 1\\n  loadPointsHistory()\\n}\\n\\nconst handlePointsPageChange = (page: number) => {\\n  pointsPagination.page = page\\n  loadPointsHistory()\\n}\\n\\nconst handleStatusSizeChange = (size: number) => {\\n  statusPagination.size = size\\n  statusPagination.page = 1\\n  loadStatusHistory()\\n}\\n\\nconst handleStatusPageChange = (page: number) => {\\n  statusPagination.page = page\\n  loadStatusHistory()\\n}\\n\\nconst handleVisitSizeChange = (size: number) => {\\n  visitPagination.size = size\\n  visitPagination.page = 1\\n  loadVisitHistory()\\n}\\n\\nconst handleVisitPageChange = (page: number) => {\\n  visitPagination.page = page\\n  loadVisitHistory()\\n}\\n\\nconst handleViewOrder = (row: any) => {\\n  ElMessage.info('查看订单详情功能待实现')\\n}\\n\\nconst handleBack = () => {\\n  router.back()\\n}\\n\\nonMounted(() => {\\n  loadCustomerInfo()\\n  loadOrderHistory()\\n})\\n</script>\\n\\n<style scoped lang=\\\"scss\\\">\\n.customer-history-query {\\n  padding: 20px;\\n\\n  .customer-info-card,\\n  .history-tabs-card {\\n    margin-bottom: 20px;\\n  }\\n\\n  .card-header {\\n    display: flex;\\n    justify-content: space-between;\\n    align-items: center;\\n\\n    .card-title {\\n      font-size: 16px;\\n      font-weight: 600;\\n    }\\n  }\\n\\n  .customer-info {\\n    display: grid;\\n    grid-template-columns: repeat(2, 1fr);\\n    gap: 20px;\\n    padding: 10px 0;\\n\\n    .info-row {\\n      display: flex;\\n      align-items: center;\\n\\n      .label {\\n        width: 100px;\\n        color: #606266;\\n        font-weight: 500;\\n      }\\n\\n      .value {\\n        color: #303133;\\n        font-weight: 600;\\n      }\\n    }\\n  }\\n\\n  .tab-content {\\n    .filter-bar {\\n      margin-bottom: 20px;\\n      display: flex;\\n      gap: 10px;\\n      align-items: center;\\n    }\\n\\n    .points-positive {\\n      color: #67c23a;\\n      font-weight: 600;\\n    }\\n\\n    .points-negative {\\n      color: #f56c6c;\\n      font-weight: 600;\\n    }\\n\\n    .pagination-container {\\n      display: flex;\\n      justify-content: flex-end;\\n      margin-top: 20px;\\n    }\\n  }\\n}\\n</style>\\n\",\"originTextLength\":19487,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768913014639}]",
