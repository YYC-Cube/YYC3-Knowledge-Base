l-button type=\\\\\\\"danger\\\\\\\" @click=\\\\\\\"handleRemoveMembers\\\\\\\" :disabled=\\\\\\\"selectedMembers.length === 0\\\\\\\">\\\\n            <el-icon><Delete /></el-icon>\\\\n            批量移除\\\\n          </el-button>\\\\n        </div>\\\\n      </div>\\\\n\\\\n      <el-table\\\\n        :data=\\\\\\\"membersList\\\\\\\"\\\\n        stripe\\\\n        v-loading=\\\\\\\"membersLoading\\\\\\\"\\\\n        border\\\\n        @selection-change=\\\\\\\"handleSelectionChange\\\\\\\"\\\\n      >\\\\n        <el-table-column type=\\\\\\\"selection\\\\\\\" width=\\\\\\\"55\\\\\\\" />\\\\n        <el-table-column prop=\\\\\\\"customerName\\\\\\\" label=\\\\\\\"客户姓名\\\\\\\" width=\\\\\\\"120\\\\\\\" />\\\\n        <el-table-column prop=\\\\\\\"customerPhone\\\\\\\" label=\\\\\\\"手机号\\\\\\\" width=\\\\\\\"130\\\\\\\" />\\\\n        <el-table-column prop=\\\\\\\"addedBy\\\\\\\" label=\\\\\\\"添加人\\\\\\\" width=\\\\\\\"100\\\\\\\" />\\\\n        <el-table-column prop=\\\\\\\"addedAt\\\\\\\" label=\\\\\\\"添加时间\\\\\\\" width=\\\\\\\"160\\\\\\\">\\\\n          <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n            {{ formatDate(row.addedAt) }}\\\\n          </template>\\\\n        </el-table-column>\\\\n        <el-table-column prop=\\\\\\\"reason\\\\\\\" label=\\\\\\\"添加原因\\\\\\\" show-overflow-tooltip />\\\\n        <el-table-column label=\\\\\\\"操作\\\\\\\" width=\\\\\\\"100\\\\\\\">\\\\n          <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n            <el-button type=\\\\\\\"danger\\\\\\\" link size=\\\\\\\"small\\\\\\\" @click=\\\\\\\"handleRemoveMember(row)\\\\\\\">\\\\n              移除\\\\n            </el-button>\\\\n          </template>\\\\n        </el-table-column>\\\\n      </el-table>\\\\n\\\\n      <div class=\\\\\\\"pagination-container\\\\\\\">\\\\n        <el-pagination\\\\n          v-model:current-page=\\\\\\\"membersPagination.page\\\\\\\"\\\\n          v-model:page-size=\\\\\\\"membersPagination.size\\\\\\\"\\\\n          :total=\\\\\\\"membersPagination.total\\\\\\\"\\\\n          :page-sizes=\\\\\\\"[10, 20, 50]\\\\\\\"\\\\n          layout=\\\\\\\"total, sizes, prev, pager, next, jumper\\\\\\\"\\\\n          @size-change=\\\\\\\"handleMembersSizeChange\\\\\\\"\\\\n          @current-change=\\\\\\\"handleMembersPageChange\\\\\\\"\\\\n        />\\\\n      </div>\\\\n    </el-dialog>\\\\n\\\\n    <el-dialog v-model=\\\\\\\"addMembersDialogVisible\\\\\\\" title=\\\\\\\"添加客户到分群\\\\\\\" width=\\\\\\\"800px\\\\\\\">\\\\n      <div class=\\\\\\\"add-members-search\\\\\\\">\\\\n        <el-input\\\\n          v-model=\\\\\\\"memberSearchKeyword\\\\\\\"\\\\n          placeholder=\\\\\\\"请输入客户姓名或手机号\\\\\\\"\\\\n          clearable\\\\n          @input=\\\\\\\"handleMemberSearch\\\\\\\"\\\\n        >\\\\n          <template #prefix>\\\\n            <el-icon><Search /></el-icon>\\\\n          </template>\\\\n        </el-input>\\\\n      </div>\\\\n\\\\n      <el-table\\\\n        :data=\\\\\\\"availableCustomers\\\\\\\"\\\\n        stripe\\\\n        v-loading=\\\\\\\"availableCustomersLoading\\\\\\\"\\\\n        border\\\\n        max-height=\\\\\\\"400\\\\\\\"\\\\n        @selection-change=\\\\\\\"handleAvailableSelectionChange\\\\\\\"\\\\n      >\\\\n        <el-table-column type=\\\\\\\"selection\\\\\\\" width=\\\\\\\"55\\\\\\\" />\\\\n        <el-table-column prop=\\\\\\\"name\\\\\\\" label=\\\\\\\"客户姓名\\\\\\\" width=\\\\\\\"120\\\\\\\" />\\\\n        <el-table-column prop=\\\\\\\"phone\\\\\\\" label=\\\\\\\"手机号\\\\\\\" width=\\\\\\\"130\\\\\\\" />\\\\n        <el-table-column prop=\\\\\\\"email\\\\\\\" label=\\\\\\\"邮箱\\\\\\\" width=\\\\\\\"180\\\\\\\" />\\\\n        <el-table-column prop=\\\\\\\"totalSpent\\\\\\\" label=\\\\\\\"累计消费\\\\\\\" width=\\\\\\\"120\\\\\\\">\\\\n          <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n            ¥{{ row.totalSpent?.toFixed(2) || \\\\'0.00\\\\' }}\\\\n          </template>\\\\n        </el-table-column>\\\\n      </el-table>\\\\n\\\\n      <template #footer>\\\\n        <el-button @click=\\\\\\\"addMembersDialogVisible = false\\\\\\\">取消</el-button>\\\\n        <el-button\\\\n          type=\\\\\\\"primary\\\\\\\"\\\\n          @click=\\\\\\\"handleAddMembersSubmit\\\\\\\"\\\\n          :loading=\\\\\\\"addMembersSubmitting\\\\\\\"\\\\n          :disabled=\\\\\\\"selectedAvailableCustomers.length === 0\\\\\\\"\\\\n        >\\\\n          确定（已选择{{ selectedAvailableCustomers.length }}人）\\\\n        </el-button>\\\\n      </template>\\\\n    </el-dialog>\\\\n  </div>\\\\n</template>\\\\n\\\\n<script setup lang=\\\\\\\"ts\\\\\\\">\\\\nimport { ref, reactive, onMounted } from \\\\'vue\\\\'\\\\nimport { ElMessage, ElMessageBox } from \\\\'element-plus\\\\'\\\\nimport { Plus, Delete, Search } from \\\\'@element-plus/icons-vue\\\\'\\\\nimport {\\\\n  getCustomerGroups,\\\\n  getCustomerGroupDetail,\\\\n  createCustomerGroup,\\\\n  updateCustomerGroup,\\\\n  deleteCustomerGroup,\\\\n  getCustomerGroupMembers,\\\\n  addCustomerToGroup,\\\\n  removeCustomerFromGroup,\\\\n  getCustomerGroupStatistics\\\\n} from \\\\'@/api/customer\\\\'\\\\nimport type { CustomerGroup, CustomerGroupMember } from \\\\'@/api/customer\\\\'\\\\n\\\\nconst loading = ref(false)\\\\nconst membersLoading = ref(false)\\\\nconst availableCustomersLoading = ref(false)\\\\nconst submitting = ref(false)\\\\nconst addMembersSubmitting = ref(false)\\\\n\\\\nconst groupDialogVisible = ref(false)\\\\nconst membersDialogVisible = ref(false)\\\\nconst addMembersDialogVisible = ref(false)\\\\n\\\\nconst isEdit = ref(false)\\\\nconst groupFormRef = ref()\\\\n\\\\nconst statistics = reactive({\\\\n  totalGroups: 0,\\\\n  manualGroups: 0,\\\\n  autoGroups: 0,\\\\n  rfmGroups: 0,\\\\n  lifecycleGroups: 0,\\\\n  totalMembers: 0,\\\\n  avgMembersPerGroup: 0\\\\n})\\\\n\\\\nconst filters = reactive({\\\\n  name: \\\\'\\\\',\\\\n  groupType: \\\\'\\\\',\\\\n  enabled: \\\\'\\\\'\\\\n})\\\\n\\\\nconst pagination = reactive({\\\\n  page: 1,\\\\n  size: 20,\\\\n  total: 0\\\\n})\\\\n\\\\nconst membersPagination = reactive({\\\\n  page: 1,\\\\n  size: 20,\\\\n  total: 0\\\\n})\\\\n\\\\nconst groupList = ref<CustomerGroup[]>([])\\\\nconst membersList = ref<CustomerGroupMember[]>([])\\\\nconst selectedMembers = ref<CustomerGroupMember[]>([])\\\\nconst availableCustomers = ref<any[]>([])\\\\nconst selectedAvailableCustomers = ref<any[]>([])\\\\nconst currentGroup = reactive({\\\\n  id: \\\\'\\\\',\\\\n  name: \\\\'\\\\',\\\\n  groupType: \\\\'\\\\'\\\\n})\\\\n\\\\nconst memberSearchKeyword = ref(\\\\'\\\\')\\\\n\\\\nconst groupForm = reactive({\\\\n  id: \\\\'\\\\',\\\\n  name: \\\\'\\\\',\\\\n  description: \\\\'\\\\',\\\\n  groupType: \\\\'\\\\',\\\\n  color: \\\\'#409EFF\\\\',\\\\n  priority: 0,\\\\n  enabled: true\\\\n})\\\\n\\\\nconst groupRules = {\\\\n  name: [\\\\n    { required: true, message: \\\\'请输入分群名称\\\\', trigger: \\\\'blur\\\\' },\\\\n    { min: 2, max: 50, message: \\\\'长度在 2 到 50 个字符\\\\', trigger: \\\\'blur\\\\' }\\\\n  ],\\\\n  groupType: [\\\\n    { required: true, message: \\\\'请选择分群类型\\\\', trigger: \\\\'change\\\\' }\\\\n  ],\\\\n  description: [\\\\n    { max: 200, message: \\\\'描述最多200个字符\\\\', trigger: \\\\'blur\\\\' }\\\\n  ]\\\\n}\\\\n\\\\nconst getGroupTypeTag = (type: string) => {\\\\n  const typeMap: Record<string, any> = {\\\\n    manual: \\\\'primary\\\\',\\\\n    auto: \\\\'success\\\\',\\\\n    rfm: \\\\'warning\\\\',\\\\n    lifecycle: \\\\'info\\\\'\\\\n  }\\\\n  return typeMap[type] || \\\\'\\\\'\\\\n}\\\\n\\\\nconst getGroupTypeText = (type: string) => {\\\\n  const textMap: Record<string, string> = {\\\\n    manual: \\\\'手动分群\\\\',\\\\n    auto: \\\\'自动分群\\\\',\\\\n    rfm: \\\\'RFM分群\\\\',\\\\n    lifecycle: \\\\'生命周期分群\\\\'\\\\n  }\\\\n  return textMap[type] || type\\\\n}\\\\n\\\\nconst formatDate = (date: string) => {\\\\n  if (!date) return \\\\'-\\\\'\\\\n  return new Date(date).toLocaleString(\\\\'zh-CN\\\\')\\\\n}\\\\n\\\\nconst loadStatistics = async () => {\\\\n  try {\\\\n    const data = await getCustomerGroupStatistics()\\\\n    Object.assign(statistics, data)\\\\n  } catch (error) {\\\\n    console.error(\\\\'加载统计数据失败:\\\\', error)\\\\n  }\\\\n}\\\\n\\\\nconst loadGroupList = async () => {\\\\n  loading.value = true\\\\n  try {\\\\n    const params = {\\\\n      name: filters.name,\\\\n      groupType: filters.groupType,\\\\n      enabled: filters.enabled === \\\\'\\\\' ? undefined : filters.enabled === \\\\'true\\\\',\\\\n      page: pagination.page,\\\\n      size: pagination.size\\\\n    }\\\\n\\\\n    const result = await getCustomerGroups(params)\\\\n    groupList.value = result.data || []\\\\n    pagination.total = result.total || 0\\\\n  } catch (error) {\\\\n    ElMessage.error(\\\\'加载分群列表失败\\\\')\\\\n    console.error(error)\\\\n  } finally {\\\\n    loading.value = false\\\\n  }\\\\n}\\\\n\\\\nconst loadMembersList = async () => {\\\\n  membersLoading.value = true\\\\n  try {\\\\n    const result = await getCustomerGroupMembers(currentGroup.id, {\\\\n      page: membersPagination.page,\\\\n      size: membersPagination.size\\\\n    })\\\\n    membersList.value = result.data || []\\\\n    membersPagination.total = result.total || 0\\\\n  } catch (error) {\\\\n    ElMessage.error(\\\\'加载成员列表失败\\\\')\\\\n    console.error(error)\\\\n  } finally {\\\\n    membersLoading.value = false\\\\n  }\\\\n}\\\\n\\\\nconst refreshData = () => {\\\\n  loadStatistics()\\\\n  loadGroupList()\\\\n}\\\\n\\\\nconst handleSearch = () => {\\\\n  pagination.page = 1\\\\n  loadGroupList()\\\\n}\\\\n\\\\nconst handleReset = () => {\\\\n  filters.name = \\\\'\\\\'\\\\n  filters.groupType = \\\\'\\\\'\\\\n  filters.enabled = \\\\'\\\\'\\\\n  pagination.page = 1\\\\n  loadGroupList()\\\\n}\\\\n\\\\nconst handleSizeChange = (size: number) => {\\\\n  pagination.size = size\\\\n  pagination.page = 1\\\\n  loadGroupList()\\\\n}\\\\n\\\\nconst handlePageChange = (page: number) => {\\\\n  pagination.page = page\\\\n  loadGroupList()\\\\n}\\\\n\\\\nconst handleCreate = () => {\\\\n  isEdit.value = false\\\\n  Object.assign(groupForm, {\\\\n    id: \\\\'\\\\',\\\\n    name: \\\\'\\\\',\\\\n    description: \\\\'\\\\',\\\\n    groupType: \\\\'\\\\',\\\\n    color: \\\\'#409EFF\\\\',\\\\n    priority: 0,\\\\n    enabled: true\\\\n  })\\\\n  groupDialogVisible.value = true\\\\n}\\\\n\\\\nconst handleEdit = async (row: CustomerGroup) => {\\\\n  isEdit.value = true\\\\n  try {\\\\n    const data = await getCustomerGroupDetail(row.id)\\\\n    Object.assign(groupForm, data)\\\\n    groupDialogVisible.value = true\\\\n  } catch (error) {\\\\n    ElMessage.error(\\\\'加载分群详情失败\\\\')\\\\n    console.error(error)\\\\n  }\\\\n}\\\\n\\\\nconst handleGroupSubmit = async () => {\\\\n  if (!groupFormRef.value) return\\\\n\\\\n  try {\\\\n    await groupFormRef.value.validate()\\\\n    submitting.value = true\\\\n\\\\n    if (isEdit.value) {\\\\n      await updateCustomerGroup(groupForm.id, groupForm)\\\\n      ElMessage.success(\\\\'分群更新成功\\\\')\\\\n    } else {\\\\n      await createCustomerGroup(groupForm)\\\\n      ElMessage.success(\\\\'分群创建成功\\\\')\\\\n    }\\\\n\\\\n    groupDialogVisible.value = false\\\\n    refreshData()\\\\n  } catch (error: any) {\\\\n    if (error !== false) {\\\\n      ElMessage.error(error.message || \\\\'操作失败\\\\')\\\\n    }\\\\n  } finally {\\\\n    submitting.value = false\\\\n  }\\\\n}\\\\n\\\\nconst handleToggleStatus = async (row: CustomerGroup) => {\\\\n  try {\\\\n    await ElMessageBox.confirm(\\\\n      `确定要${row.enabled ? \\\\'禁用\\\\' : \\\\'启用\\\\'}该分群吗？`,\\\\n      \\\\'提示\\\\',\\\\n      {\\\\n        confirmButtonText: \\\\'确定\\\\',\\\\n        cancelButtonText: \\\\'取消\\\\',\\\\n        type: \\\\'warning\\\\'\\\\n      }\\\\n    )\\\\n\\\\n    await updateCustomerGroup(row.id, { enabled: !row.enabled })\\\\n    ElMessage.success(\\\\'状态更新成功\\\\')\\\\n    refreshData()\\\\n  } catch (error) {\\\\n    if (error !== \\\\'cancel\\\\') {\\\\n      ElMessage.error(\\\\'状态更新失败\\\\')\\\\n      console.error(error)\\\\n    }\\\\n  }\\\\n}\\\\n\\\\nconst handleDelete = async (row: CustomerGroup) => {\\\\n  try {\\\\n    await ElMessageBox.confirm(\\\\n      `确定要删除分群\\\\\\\"${row.name}\\\\\\\"吗？删除后无法恢复！`,\\\\n      \\\\'警告\\\\',\\\\n      {\\\\n        confirmButtonText: \\\\'确定\\\\',\\\\n        cancelButtonText: \\\\'取消\\\\',\\\\n        type: \\\\'warning\\\\'\\\\n      }\\\\n    )\\\\n\\\\n    await deleteCustomerGroup(row.id)\\\\n    ElMessage.success(\\\\'分群删除成功\\\\')\\\\n    refreshData()\\\\n  } catch (error) {\\\\n    if (error !== \\\\'cancel\\\\') {\\\\n      ElMessage.error(\\\\'分群删除失败\\\\')\\\\n      console.error(error)\\\\n    }\\\\n  }\\\\n}\\\\n\\\\nconst handleViewMembers = async (row: CustomerGroup) => {\\\\n  currentGroup.id = row.id\\\\n  currentGroup.name = row.name\\\\n  currentGroup.groupType = row.groupType\\\\n  membersPagination.page = 1\\\\n  await loadMembersList()\\\\n  membersDialogVisible.value = true\\\\n}\\\\n\\\\nconst handleSelectionChange = (selection: CustomerGroupMember[]) => {\\\\n  selectedMembers.value = selection\\\\n}\\\\n\\\\nconst handleMembersSizeChange = (size: number) => {\\\\n  membersPagination.size = size\\\\n  membersPagination.page = 1\\\\n  loadMembersList()\\\\n}\\\\n\\\\nconst handleMembersPageChange = (page: number) => {\\\\n  membersPagination.page = page\\\\n  loadMembersList()\\\\n}\\\\n\\\\nconst handleRemoveMember = async (row: CustomerGroupMember) => {\\\\n  try {\\\\n    await ElMessageBox.confirm(\\\\n      \\\\'确定要移除该客户吗？\\\\',\\\\n      \\\\'提示\\\\',\\\\n      {\\\\n        confirmButtonText: \\\\'确定\\\\',\\\\n        cancelButtonText: \\\\'取消\\\\',\\\\n        type: \\\\'warning\\\\'\\\\n      }\\\\n    )\\\\n\\\\n    await removeCustomerFromGroup(currentGroup.id, row.customerId)\\\\n    ElMessage.success(\\\\'移除成功\\\\')\\\\n    loadMembersList()\\\\n  } catch (error) {\\\\n    if (error !== \\\\'cancel\\\\') {\\\\n      ElMessage.error(\\\\'移除失败\\\\')\\\\n      console.error(error)\\\\n    }\\\\n  }\\\\n}\\\\n\\\\nconst handleRemoveMembers = async () => {\\\\n  try {\\\\n    await ElMessageBox.confirm(\\\\n      `确定要移除选中的${selectedMembers.value.length}个客户吗？`,\\\\n      \\\\'提示\\\\',\\\\n      {\\\\n        confirmButtonText: \\\\'确定\\\\',\\\\n        cancelButtonText: \\\\'取消\\\\',\\\\n        type: \\\\'warning\\\\'\\\\n      }\\\\n    )\\\\n\\\\n    const customerIds = selectedMembers.value.map(m => m.customerId)\\\\n    await removeCustomerFromGroup(currentGroup.id, customerIds[0])\\\\n    ElMessage.success(\\\\'批量移除成功\\\\')\\\\n    loadMembersList()\\\\n  } catch (error) {\\\\n    if (error !== \\\\'cancel\\\\') {\\\\n      ElMessage.error(\\\\'批量移除失败\\\\')\\\\n      console.error(error)\\\\n    }\\\\n  }\\\\n}\\\\n\\\\nconst handleAddMembers = () => {\\\\n  memberSearchKeyword.value = \\\\'\\\\'\\\\n  selectedAvailableCustomers.value = []\\\\n  availableCustomers.value = []\\\\n  addMembersDialogVisible.value = true\\\\n}\\\\n\\\\nconst handleMemberSearch = async () => {\\\\n  if (!memberSearchKeyword.value) {\\\\n    availableCustomers.value = []\\\\n    return\\\\n  }\\\\n\\\\n  availableCustomersLoading.value = true\\\\n  try {\\\\n    availableCustomers.value = []\\\\n  } catch (error) {\\\\n    console.error(error)\\\\n  } finally {\\\\n    availableCustomersLoading.value = false\\\\n  }\\\\n}\\\\n\\\\nconst handleAvailableSelectionChange = (selection: any[]) => {\\\\n  selectedAvailableCustomers.value = selection\\\\n}\\\\n\\\\nconst handleAddMembersSubmit = async () => {\\\\n  if (selectedAvailableCustomers.value.length === 0) {\\\\n    ElMessage.warning(\\\\'请选择要添加的客户\\\\')\\\\n    return\\\\n  }\\\\n\\\\n  addMembersSubmitting.value = true\\\\n  try {\\\\n    const customerIds = selectedAvailableCustomers.value.map(c => c.id)\\\\n    await addCustomerToGroup(currentGroup.id, customerIds)\\\\n    ElMessage.success(\\\\'添加成功\\\\')\\\\n    addMembersDialogVisible.value = false\\\\n    loadMembersList()\\\\n  } catch (error) {\\\\n    ElMessage.error(\\\\'添加失败\\\\')\\\\n    console.error(error)\\\\n  } finally {\\\\n    addMembersSubmitting.value = false\\\\n  }\\\\n}\\\\n\\\\nonMounted(() => {\\\\n  loadStatistics()\\\\n  loadGroupList()\\\\n})\\\\n</script>\\\\n\\\\n<style scoped lang=\\\\\\\"scss\\\\\\\">\\\\n.customer-group-management {\\\\n  padding: 20px;\\\\n\\\\n  .statistics-card,\\\\n  .filter-card,\\\\n  .table-card {\\\\n    margin-bottom: 20px;\\\\n  }\\\\n\\\\n  .statistics-overview {\\\\n    display: flex;\\\\n    justify-content: space-around;\\\\n    padding: 20px 0;\\\\n\\\\n    .stat-item {\\\\n      text-align: center;\\\\n\\\\n      .stat-value {\\\\n        font-size: 32px;\\\\n        font-weight: 600;\\\\n        color: #409eff;\\\\n        margin-bottom: 8px;\\\\n      }\\\\n\\\\n      .stat-label {\\\\n        font-size: 14px;\\\\n        color: #909399;\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  .pagination-container {\\\\n    display: flex;\\\\n    justify-content: flex-end;\\\\n    margin-top: 20px;\\\\n  }\\\\n\\\\n  .members-header {\\\\n    display: flex;\\\\n    justify-content: space-between;\\\\n    align-items: center;\\\\n    margin-bottom: 20px;\\\\n    padding-bottom: 15px;\\\\n    border-bottom: 1px solid #ebeef5;\\\\n\\\\n    .group-info {\\\\n      display: flex;\\\\n      align-items: center;\\\\n      gap: 15px;\\\\n\\\\n      .group-name {\\\\n        font-size: 16px;\\\\n        font-weight: 600;\\\\n      }\\\\n\\\\n      .member-count {\\\\n        color: #909399;\\\\n        font-size: 14px;\\\\n      }\\\\n    }\\\\n\\\\n    .members-actions {\\\\n      display: flex;\\\\n      gap: 10px;\\\\n    }\\\\n  }\\\\n\\\\n  .add-members-search {\\\\n    margin-bottom: 20px;\\\\n  }\\\\n}\\\\n</style>\\\\n\",\"originAcceptText\":\"<template>\\n  <div class=\\\"customer-group-management\\\">\\n    <el-card class=\\\"statistics-card\\\">\\n      <div class=\\\"statistics-overview\\\">\\n        <div class=\\\"stat-item\\\">\\n          <div class=\\\"stat-value\\\">{{ statistics.totalGroups || 0 }}</div>\\n          <div class=\\\"stat-label\\\">总分群数</div>\\n        </div>\\n        <div class=\\\"stat-item\\\">\\n          <div class=\\\"stat-value\\\">{{ statistics.manualGroups || 0 }}</div>\\n          <div class=\\\"stat-label\\\">手动分群</div>\\n        </div>\\n        <div class=\\\"stat-item\\\">\\n          <div class=\\\"stat-value\\\">{{ statistics.autoGroups || 0 }}</div>\\n          <div class=\\\"stat-label\\\">自动分群</div>\\n        </div>\\n        <div class=\\\"stat-item\\\">\\n          <div class=\\\"stat-value\\\">{{ statistics.totalMembers || 0 }}</div>\\n          <div class=\\\"stat-label\\\">总成员数</div>\\n        </div>\\n      </div>\\n    </el-card>\\n\\n    <el-card class=\\\"filter-card\\\">\\n      <el-form :model=\\\"filters\\\" inline>\\n        <el-form-item label=\\\"分群名称\\\">\\n          <el-input v-model=\\\"filters.name\\\" placeholder=\\\"请输入分群名称\\\" clearable />\\n        </el-form-item>\\n        <el-form-item label=\\\"分群类型\\\">\\n          <el-select v-model=\\\"filters.groupType\\\" placeholder=\\\"请选择分群类型\\\" clearable>\\n            <el-option label=\\\"全部\\\" value=\\\"\\\" />\\n            <el-option label=\\\"手动分群\\\" value=\\\"manual\\\" />\\n            <el-option label=\\\"自动分群\\\" value=\\\"auto\\\" />\\n            <el-option label=\\\"RFM分群\\\" value=\\\"rfm\\\" />\\n            <el-option label=\\\"生命周期分群\\\" value=\\\"lifecycle\\\" />\\n          </el-select>\\n        </el-form-item>\\n        <el-form-item label=\\\"状态\\\">\\n          <el-select v-model=\\\"filters.enabled\\\" placeholder=\\\"请选择状态\\\" clearable>\\n            <el-option label=\\\"全部\\\" value=\\\"\\\" />\\n            <el-option label=\\\"启用\\\" value=\\\"true\\\" />\\n            <el-option label=\\\"禁用\\\" value=\\\"false\\\" />\\n          </el-select>\\n        </el-form-item>\\n        <el-form-item>\\n          <el-button type=\\\"primary\\\" @click=\\\"handleSearch\\\">搜索</el-button>\\n          <el-button @click=\\\"handleReset\\\">重置</el-button>\\n          <el-button type=\\\"success\\\" @click=\\\"handleCreate\\\">\\n            <el-icon><Plus /></el-icon>\\n            新建分群\\n          </el-button>\\n        </el-form-item>\\n      </el-form>\\n    </el-card>\\n\\n    <el-card class=\\\"table-card\\\">\\n      <el-table :data=\\\"groupList\\\" stripe v-loading=\\\"loading\\\" border>\\n        <el-table-column prop=\\\"name\\\" label=\\\"分群名称\\\" width=\\\"180\\\" />\\n        <el-table-column prop=\\\"description\\\" label=\\\"描述\\\" show-overflow-tooltip />\\n        <el-table-column label=\\\"分群类型\\\" width=\\\"120\\\">\\n          <template #default=\\\"{ row }\\\">\\n            <el-tag :type=\\\"getGroupTypeTag(row.groupType)\\\" size=\\\"small\\\">\\n              {{ getGroupTypeText(row.groupType) }}\\n            </el-tag>\\n          </template>\\n        </el-table-column>\\n        <el-table-column prop=\\\"memberCount\\\" label=\\\"成员数量\\\" width=\\\"100\\\" />\\n        <el-table-column prop=\\\"priority\\\" label=\\\"优先级\\\" width=\\\"80\\\" />\\n        <el-table-column label=\\\"状态\\\" width=\\\"80\\\">\\n          <template #default=\\\"{ row }\\\">\\n            <el-tag :type=\\\"row.enabled ? 'success' : 'info'\\\" size=\\\"small\\\">\\n              {{ row.enabled ? '启用' : '禁用' }}\\n            </el-tag>\\n          </template>\\n        </el-table-column>\\n        <el-table-column prop=\\\"createdAt\\\" label=\\\"创建时间\\\" width=\\\"160\\\">\\n          <template #default=\\\"{ row }\\\">\\n            {{ formatDate(row.createdAt) }}\\n          </template>\\n        </el-table-column>\\n        <el-table-column label=\\\"操作\\\" width=\\\"280\\\" fixed=\\\"right\\\">\\n          <template #default=\\\"{ row }\\\">\\n            <el-button type=\\\"primary\\\" link size=\\\"small\\\" @click=\\\"handleViewMembers(row)\\\">\\n              查看成员\\n            </el-button>\\n            <el-button type=\\\"warning\\\" link size=\\\"small\\\" @click=\\\"handleEdit(row)\\\">\\n              编辑\\n            </el-button>\\n            <el-button type=\\\"success\\\" link size=\\\"small\\\" @click=\\\"handleToggleStatus(row)\\\">\\n              {{ row.enabled ? '禁用' : '启用' }}\\n            </el-button>\\n            <el-button type=\\\"danger\\\" link size=\\\"small\\\" @click=\\\"handleDelete(row)\\\">\\n              删除\\n            </el-button>\\n          </template>\\n        </el-table-column>\\n      </el-table>\\n\\n      <div class=\\\"pagination-container\\\">\\n        <el-pagination\\n          v-model:current-page=\\\"pagination.page\\\"\\n          v-model:page-size=\\\"pagination.size\\\"\\n          :total=\\\"pagination.total\\\"\\n          :page-sizes=\\\"[10, 20, 50]\\\"\\n          layout=\\\"total, sizes, prev, pager, next, jumper\\\"\\n          @size-change=\\\"handleSizeChange\\\"\\n          @current-change=\\\"handlePageChange\\\"\\n        />\\n      </div>\\n    </el-card>\\n\\n    <el-dialog v-model=\\\"groupDialogVisible\\\" :title=\\\"isEdit ? '编辑分群' : '新建分群'\\\" width=\\\"600px\\\">\\n      <el-form :model=\\\"groupForm\\\" :rules=\\\"groupRules\\\" ref=\\\"groupFormRef\\\" label-width=\\\"100px\\\">\\n        <el-form-item label=\\\"分群名称\\\" prop=\\\"name\\\">\\n          <el-input v-model=\\\"groupForm.name\\\" placeholder=\\\"请输入分群名称\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"分群类型\\\" prop=\\\"groupType\\\">\\n          <el-select v-model=\\\"groupForm.groupType\\\" placeholder=\\\"请选择分群类型\\\" :disabled=\\\"isEdit\\\">\\n            <el-option label=\\\"手动分群\\\" value=\\\"manual\\\" />\\n            <el-option label=\\\"自动分群\\\" value=\\\"auto\\\" />\\n            <el-option label=\\\"RFM分群\\\" value=\\\"rfm\\\" />\\n            <el-option label=\\\"生命周期分群\\\" value=\\\"lifecycle\\\" />\\n          </el-select>\\n        </el-form-item>\\n        <el-form-item label=\\\"描述\\\" prop=\\\"description\\\">\\n          <el-input\\n            v-model=\\\"groupForm.description\\\"\\n            type=\\\"textarea\\\"\\n            :rows=\\\"3\\\"\\n            placeholder=\\\"请输入分群描述\\\"\\n          />\\n        </el-form-item>\\n        <el-form-item label=\\\"显示颜色\\\" prop=\\\"color\\\">\\n          <el-color-picker v-model=\\\"groupForm.color\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"优先级\\\" prop=\\\"priority\\\">\\n          <el-input-number v-model=\\\"groupForm.priority\\\" :min=\\\"0\\\" :max=\\\"100\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"状态\\\" prop=\\\"enabled\\\">\\n          <el-switch v-model=\\\"groupForm.enabled\\\" />\\n        </el-form-item>\\n      </el-form>\\n      <template #footer>\\n        <el-button @click=\\\"groupDialogVisible = false\\\">取消</el-button>\\n        <el-button type=\\\"primary\\\" @click=\\\"handleGroupSubmit\\\" :loading=\\\"submitting\\\">\\n          确定\\n        </el-button>\\n      </template>\\n    </el-dialog>\\n\\n    <el-dialog v-model=\\\"membersDialogVisible\\\" title=\\\"分群成员管理\\\" width=\\\"900px\\\">\\n      <div class=\\\"members-header\\\">\\n        <div class=\\\"group-info\\\">\\n          <span class=\\\"group-name\\\">{{ currentGroup.name }}</span>\\n          <el-tag :type=\\\"getGroupTypeTag(currentGroup.groupType)\\\" size=\\\"small\\\">\\n            {{ getGroupTypeText(currentGroup.groupType) }}\\n          </el-tag>\\n          <span class=\\\"member-count\\\">成员数：{{ membersPagination.total }}</span>\\n        </div>\\n        <div class=\\\"members-actions\\\">\\n          <el-button type=\\\"primary\\\" @click=\\\"handleAddMembers\\\">\\n            <el-icon><Plus /></el-icon>\\n            添加成员\\n          </el-button>\\n          <el-button type=\\\"danger\\\" @click=\\\"handleRemoveMembers\\\" :disabled=\\\"selectedMembers.length === 0\\\">\\n            <el-icon><Delete /></el-icon>\\n            批量移除\\n          </el-button>\\n        </div>\\n      </div>\\n\\n      <el-table\\n        :data=\\\"membersList\\\"\\n        stripe\\n        v-loading=\\\"membersLoading\\\"\\n        border\\n        @selection-change=\\\"handleSelectionChange\\\"\\n      >\\n        <el-table-column type=\\\"selection\\\" width=\\\"55\\\" />\\n        <el-table-column prop=\\\"customerName\\\" label=\\\"客户姓名\\\" width=\\\"120\\\" />\\n        <el-table-column prop=\\\"customerPhone\\\" label=\\\"手机号\\\" width=\\\"130\\\" />\\n        <el-table-column prop=\\\"addedBy\\\" label=\\\"添加人\\\" width=\\\"100\\\" />\\n        <el-table-column prop=\\\"addedAt\\\" label=\\\"添加时间\\\" width=\\\"160\\\">\\n          <template #default=\\\"{ row }\\\">\\n            {{ formatDate(row.addedAt) }}\\n          </template>\\n        </el-table-column>\\n        <el-table-column prop=\\\"reason\\\" label=\\\"添加原因\\\" show-overflow-tooltip />\\n        <el-table-column label=\\\"操作\\\" width=\\\"100\\\">\\n          <template #default=\\\"{ row }\\\">\\n            <el-button type=\\\"danger\\\" link size=\\\"small\\\" @click=\\\"handleRemoveMember(row)\\\">\\n              移除\\n            </el-button>\\n          </template>\\n        </el-table-column>\\n      </el-table>\\n\\n      <div class=\\\"pagination-container\\\">\\n        <el-pagination\\n          v-model:current-page=\\\"membersPagination.page\\\"\\n          v-model:page-size=\\\"membersPagination.size\\\"\\n          :total=\\\"membersPagination.total\\\"\\n          :page-sizes=\\\"[10, 20, 50]\\\"\\n          layout=\\\"total, sizes, prev, pager, next, jumper\\\"\\n          @size-change=\\\"handleMembersSizeChange\\\"\\n          @current-change=\\\"handleMembersPageChange\\\"\\n        />\\n      </div>\\n    </el-dialog>\\n\\n    <el-dialog v-model=\\\"addMembersDialogVisible\\\" title=\\\"添加客户到分群\\\" width=\\\"800px\\\">\\n      <div class=\\\"add-members-search\\\">\\n        <el-input\\n          v-model=\\\"memberSearchKeyword\\\"\\n          placeholder=\\\"请输入客户姓名或手机号\\\"\\n          clearable\\n          @input=\\\"handleMemberSearch\\\"\\n        >\\n          <template #prefix>\\n            <el-icon><Search /></el-icon>\\n          </template>\\n        </el-input>\\n      </div>\\n\\n      <el-table\\n        :data=\\\"availableCustomers\\\"\\n        stripe\\n        v-loading=\\\"availableCustomersLoading\\\"\\n        border\\n        max-height=\\\"400\\\"\\n        @selection-change=\\\"handleAvailableSelectionChange\\\"\\n      >\\n        <el-table-column type=\\\"selection\\\" width=\\\"55\\\" />\\n        <el-table-column prop=\\\"name\\\" label=\\\"客户姓名\\\" width=\\\"120\\\" />\\n        <el-table-column prop=\\\"phone\\\" label=\\\"手机号\\\" width=\\\"130\\\" />\\n        <el-table-column prop=\\\"email\\\" label=\\\"邮箱\\\" width=\\\"180\\\" />\\n        <el-table-column prop=\\\"totalSpent\\\" label=\\\"累计消费\\\" width=\\\"120\\\">\\n          <template #default=\\\"{ row }\\\">\\n            ¥{{ row.totalSpent?.toFixed(2) || '0.00' }}\\n          </template>\\n        </el-table-column>\\n      </el-table>\\n\\n      <template #footer>\\n        <el-button @click=\\\"addMembersDialogVisible = false\\\">取消</el-button>\\n        <el-button\\n          type=\\\"primary\\\"\\n          @click=\\\"handleAddMembersSubmit\\\"\\n          :loading=\\\"addMembersSubmitting\\\"\\n          :disabled=\\\"selectedAvailableCustomers.length === 0\\\"\\n        >\\n          确定（已选择{{ selectedAvailableCustomers.length }}人）\\n        </el-button>\\n      </template>\\n    </el-dialog>\\n  </div>\\n</template>\\n\\n<script setup lang=\\\"ts\\\">\\nimport { ref, reactive, onMounted } from 'vue'\\nimport { ElMessage, ElMessageBox } from 'element-plus'\\nimport { Plus, Delete, Search } from '@element-plus/icons-vue'\\nimport {\\n  getCustomerGroups,\\n  getCustomerGroupDetail,\\n  createCustomerGroup,\\n  updateCustomerGroup,\\n  deleteCustomerGroup,\\n  getCustomerGroupMembers,\\n  addCustomerToGroup,\\n  removeCustomerFromGroup,\\n  getCustomerGroupStatistics\\n} from '@/api/customer'\\nimport type { CustomerGroup, CustomerGroupMember } from '@/api/customer'\\n\\nconst loading = ref(false)\\nconst membersLoading = ref(false)\\nconst availableCustomersLoading = ref(false)\\nconst submitting = ref(false)\\nconst addMembersSubmitting = ref(false)\\n\\nconst groupDialogVisible = ref(false)\\nconst membersDialogVisible = ref(false)\\nconst addMembersDialogVisible = ref(false)\\n\\nconst isEdit = ref(false)\\nconst groupFormRef = ref()\\n\\nconst statistics = reactive({\\n  totalGroups: 0,\\n  manualGroups: 0,\\n  autoGroups: 0,\\n  rfmGroups: 0,\\n  lifecycleGroups: 0,\\n  totalMembers: 0,\\n  avgMembersPerGroup: 0\\n})\\n\\nconst filters = reactive({\\n  name: '',\\n  groupType: '',\\n  enabled: ''\\n})\\n\\nconst pagination = reactive({\\n  page: 1,\\n  size: 20,\\n  total: 0\\n})\\n\\nconst membersPagination = reactive({\\n  page: 1,\\n  size: 20,\\n  total: 0\\n})\\n\\nconst groupList = ref<CustomerGroup[]>([])\\nconst membersList = ref<CustomerGroupMember[]>([])\\nconst selectedMembers = ref<CustomerGroupMember[]>([])\\nconst availableCustomers = ref<any[]>([])\\nconst selectedAvailableCustomers = ref<any[]>([])\\nconst currentGroup = reactive({\\n  id: '',\\n  name: '',\\n  groupType: ''\\n})\\n\\nconst memberSearchKeyword = ref('')\\n\\nconst groupForm = reactive({\\n  id: '',\\n  name: '',\\n  description: '',\\n  groupType: '',\\n  color: '#409EFF',\\n  priority: 0,\\n  enabled: true\\n})\\n\\nconst groupRules = {\\n  name: [\\n    { required: true, message: '请输入分群名称', trigger: 'blur' },\\n    { min: 2, max: 50, message: '长度在 2 到 50 个字符', trigger: 'blur' }\\n  ],\\n  groupType: [\\n    { required: true, message: '请选择分群类型', trigger: 'change' }\\n  ],\\n  description: [\\n    { max: 200, message: '描述最多200个字符', trigger: 'blur' }\\n  ]\\n}\\n\\nconst getGroupTypeTag = (type: string) => {\\n  const typeMap: Record<string, any> = {\\n    manual: 'primary',\\n    auto: 'success',\\n    rfm: 'warning',\\n    lifecycle: 'info'\\n  }\\n  return typeMap[type] || ''\\n}\\n\\nconst getGroupTypeText = (type: string) => {\\n  const textMap: Record<string, string> = {\\n    manual: '手动分群',\\n    auto: '自动分群',\\n    rfm: 'RFM分群',\\n    lifecycle: '生命周期分群'\\n  }\\n  return textMap[type] || type\\n}\\n\\nconst formatDate = (date: string) => {\\n  if (!date) return '-'\\n  return new Date(date).toLocaleString('zh-CN')\\n}\\n\\nconst loadStatistics = async () => {\\n  try {\\n    const data = await getCustomerGroupStatistics()\\n    Object.assign(statistics, data)\\n  } catch (error) {\\n    console.error('加载统计数据失败:', error)\\n  }\\n}\\n\\nconst loadGroupList = async () => {\\n  loading.value = true\\n  try {\\n    const params = {\\n      name: filters.name,\\n      groupType: filters.groupType,\\n      enabled: filters.enabled === '' ? undefined : filters.enabled === 'true',\\n      page: pagination.page,\\n      size: pagination.size\\n    }\\n\\n    const result = await getCustomerGroups(params)\\n    groupList.value = result.data || []\\n    pagination.total = result.total || 0\\n  } catch (error) {\\n    ElMessage.error('加载分群列表失败')\\n    console.error(error)\\n  } finally {\\n    loading.value = false\\n  }\\n}\\n\\nconst loadMembersList = async () => {\\n  membersLoading.value = true\\n  try {\\n    const result = await getCustomerGroupMembers(currentGroup.id, {\\n      page: membersPagination.page,\\n      size: membersPagination.size\\n    })\\n    membersList.value = result.data || []\\n    membersPagination.total = result.total || 0\\n  } catch (error) {\\n    ElMessage.error('加载成员列表失败')\\n    console.error(error)\\n  } finally {\\n    membersLoading.value = false\\n  }\\n}\\n\\nconst refreshData = () => {\\n  loadStatistics()\\n  loadGroupList()\\n}\\n\\nconst handleSearch = () => {\\n  pagination.page = 1\\n  loadGroupList()\\n}\\n\\nconst handleReset = () => {\\n  filters.name = ''\\n  filters.groupType = ''\\n  filters.enabled = ''\\n  pagination.page = 1\\n  loadGroupList()\\n}\\n\\nconst handleSizeChange = (size: number) => {\\n  pagination.size = size\\n  pagination.page = 1\\n  loadGroupList()\\n}\\n\\nconst handlePageChange = (page: number) => {\\n  pagination.page = page\\n  loadGroupList()\\n}\\n\\nconst handleCreate = () => {\\n  isEdit.value = false\\n  Object.assign(groupForm, {\\n    id: '',\\n    name: '',\\n    description: '',\\n    groupType: '',\\n    color: '#409EFF',\\n    priority: 0,\\n    enabled: true\\n  })\\n  groupDialogVisible.value = true\\n}\\n\\nconst handleEdit = async (row: CustomerGroup) => {\\n  isEdit.value = true\\n  try {\\n    const data = await getCustomerGroupDetail(row.id)\\n    Object.assign(groupForm, data)\\n    groupDialogVisible.value = true\\n  } catch (error) {\\n    ElMessage.error('加载分群详情失败')\\n    console.error(error)\\n  }\\n}\\n\\nconst handleGroupSubmit = async () => {\\n  if (!groupFormRef.value) return\\n\\n  try {\\n    await groupFormRef.value.validate()\\n    submitting.value = true\\n\\n    if (isEdit.value) {\\n      await updateCustomerGroup(groupForm.id, groupForm)\\n      ElMessage.success('分群更新成功')\\n    } else {\\n      await createCustomerGroup(groupForm)\\n      ElMessage.success('分群创建成功')\\n    }\\n\\n    groupDialogVisible.value = false\\n    refreshData()\\n  } catch (error: any) {\\n    if (error !== false) {\\n      ElMessage.error(error.message || '操作失败')\\n    }\\n  } finally {\\n    submitting.value = false\\n  }\\n}\\n\\nconst handleToggleStatus = async (row: CustomerGroup) => {\\n  try {\\n    await ElMessageBox.confirm(\\n      `确定要${row.enabled ? '禁用' : '启用'}该分群吗？`,\\n      '提示',\\n      {\\n        confirmButtonText: '确定',\\n        cancelButtonText: '取消',\\n        type: 'warning'\\n      }\\n    )\\n\\n    await updateCustomerGroup(row.id, { enabled: !row.enabled })\\n    ElMessage.success('状态更新成功')\\n    refreshData()\\n  } catch (error) {\\n    if (error !== 'cancel') {\\n      ElMessage.error('状态更新失败')\\n      console.error(error)\\n    }\\n  }\\n}\\n\\nconst handleDelete = async (row: CustomerGroup) => {\\n  try {\\n    await ElMessageBox.confirm(\\n      `确定要删除分群\\\"${row.name}\\\"吗？删除后无法恢复！`,\\n      '警告',\\n      {\\n        confirmButtonText: '确定',\\n        cancelButtonText: '取消',\\n        type: 'warning'\\n      }\\n    )\\n\\n    await deleteCustomerGroup(row.id)\\n    ElMessage.success('分群删除成功')\\n    refreshData()\\n  } catch (error) {\\n    if (error !== 'cancel') {\\n      ElMessage.error('分群删除失败')\\n      console.error(error)\\n    }\\n  }\\n}\\n\\nconst handleViewMembers = async (row: CustomerGroup) => {\\n  currentGroup.id = row.id\\n  currentGroup.name = row.name\\n  currentGroup.groupType = row.groupType\\n  membersPagination.page = 1\\n  await loadMembersList()\\n  membersDialogVisible.value = true\\n}\\n\\nconst handleSelectionChange = (selection: CustomerGroupMember[]) => {\\n  selectedMembers.value = selection\\n}\\n\\nconst handleMembersSizeChange = (size: number) => {\\n  membersPagination.size = size\\n  membersPagination.page = 1\\n  loadMembersList()\\n}\\n\\nconst handleMembersPageChange = (page: number) => {\\n  membersPagination.page = page\\n  loadMembersList()\\n}\\n\\nconst handleRemoveMember = async (row: CustomerGroupMember) => {\\n  try {\\n    await ElMessageBox.confirm(\\n      '确定要移除该客户吗？',\\n      '提示',\\n      {\\n        confirmButtonText: '确定',\\n        cancelButtonText: '取消',\\n        type: 'warning'\\n      }\\n    )\\n\\n    await removeCustomerFromGroup(currentGroup.id, row.customerId)\\n    ElMessage.success('移除成功')\\n    loadMembersList()\\n  } catch (error) {\\n    if (error !== 'cancel') {\\n      ElMessage.error('移除失败')\\n      console.error(error)\\n    }\\n  }\\n}\\n\\nconst handleRemoveMembers = async () => {\\n  try {\\n    await ElMessageBox.confirm(\\n      `确定要移除选中的${selectedMembers.value.length}个客户吗？`,\\n      '提示',\\n      {\\n        confirmButtonText: '确定',\\n        cancelButtonText: '取消',\\n        type: 'warning'\\n      }\\n    )\\n\\n    const customerIds = selectedMembers.value.map(m => m.customerId)\\n    await removeCustomerFromGroup(currentGroup.id, customerIds[0])\\n    ElMessage.success('批量移除成功')\\n    loadMembersList()\\n  } catch (error) {\\n    if (error !== 'cancel') {\\n      ElMessage.error('批量移除失败')\\n      console.error(error)\\n    }\\n  }\\n}\\n\\nconst handleAddMembers = () => {\\n  memberSearchKeyword.value = ''\\n  selectedAvailableCustomers.value = []\\n  availableCustomers.value = []\\n  addMembersDialogVisible.value = true\\n}\\n\\nconst handleMemberSearch = async () => {\\n  if (!memberSearchKeyword.value) {\\n    availableCustomers.value = []\\n    return\\n  }\\n\\n  availableCustomersLoading.value = true\\n  try {\\n    availableCustomers.value = []\\n  } catch (error) {\\n    console.error(error)\\n  } finally {\\n    availableCustomersLoading.value = false\\n  }\\n}\\n\\nconst handleAvailableSelectionChange = (selection: any[]) => {\\n  selectedAvailableCustomers.value = selection\\n}\\n\\nconst handleAddMembersSubmit = async () => {\\n  if (selectedAvailableCustomers.value.length === 0) {\\n    ElMessage.warning('请选择要添加的客户')\\n    return\\n  }\\n\\n  addMembersSubmitting.value = true\\n  try {\\n    const customerIds = selectedAvailableCustomers.value.map(c => c.id)\\n    await addCustomerToGroup(currentGroup.id, customerIds)\\n    ElMessage.success('添加成功')\\n    addMembersDialogVisible.value = false\\n    loadMembersList()\\n  } catch (error) {\\n    ElMessage.error('添加失败')\\n    console.error(error)\\n  } finally {\\n    addMembersSubmitting.value = false\\n  }\\n}\\n\\nonMounted(() => {\\n  loadStatistics()\\n  loadGroupList()\\n})\\n</script>\\n\\n<style scoped lang=\\\"scss\\\">\\n.customer-group-management {\\n  padding: 20px;\\n\\n  .statistics-card,\\n  .filter-card,\\n  .table-card {\\n    margin-bottom: 20px;\\n  }\\n\\n  .statistics-overview {\\n    display: flex;\\n    justify-content: space-around;\\n    padding: 20px 0;\\n\\n    .stat-item {\\n      text-align: center;\\n\\n      .stat-value {\\n        font-size: 32px;\\n        font-weight: 600;\\n        color: #409eff;\\n        margin-bottom: 8px;\\n      }\\n\\n      .stat-label {\\n        font-size: 14px;\\n        color: #909399;\\n      }\\n    }\\n  }\\n\\n  .pagination-container {\\n    display: flex;\\n    justify-content: flex-end;\\n    margin-top: 20px;\\n  }\\n\\n  .members-header {\\n    display: flex;\\n    justify-content: space-between;\\n    align-items: center;\\n    margin-bottom: 20px;\\n    padding-bottom: 15px;\\n    border-bottom: 1px solid #ebeef5;\\n\\n    .group-info {\\n      display: flex;\\n      align-items: center;\\n      gap: 15px;\\n\\n      .group-name {\\n        font-size: 16px;\\n        font-weight: 600;\\n      }\\n\\n      .member-count {\\n        color: #909399;\\n        font-size: 14px;\\n      }\\n    }\\n\\n    .members-actions {\\n      display: flex;\\n      gap: 10px;\\n    }\\n  }\\n\\n  .add-members-search {\\n    margin-bottom: 20px;\\n  }\\n}\\n</style>\\n\",\"originTextLength\":20378,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768913192506}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/docs/YYC3-Cater-Platform-%E6%96%87%E6%A1%A3%E9%97%AD%E7%8E%AF/YYC3-Cater-%E7%94%A8%E6%88%B7%E6%8C%87%E5%8D%97/YYC3-Cater-%E7%94%A8%E6%88%B7%E6%93%8D%E4%BD%9C%E6%89%8B%E5%86%8C.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":594,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":594,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# YYC³餐饮行业智能化平台 - 用户操作手册\\\\n\\\\n## 文档信息\\\\n\\\\n| 项目 | 内容 |\\\\n|------|------|\\\\n| 文档名称 | YYC³餐饮行业智能化平台用户操作手册 |\\\\n| 文档版本 | v1.0.0 |\\\\n| 创建日期 | 2026-01-20 |\\\\n| 最后更新 | 2026-01-20 |\\\\n| 文档状态 | 正式版 |\\\\n\\\\n---\\\\n\\\\n## 目录\\\\n\\\\n1. [平台概述](#1-平台概述)\\\\n2. [快速入门](#2-快速入门)\\\\n3. [客户管理模块](#3-客户管理模块)\\\\n4. [订单管理模块](#4-订单管理模块)\\\\n5. [厨房管理模块](#5-厨房管理模块)\\\\n6. [菜单管理模块](#6-菜单管理模块)\\\\n7. [数据分析模块](#7-数据分析模块)\\\\n8. [系统管理模块](#8-系统管理模块)\\\\n9. [常见问题](#9-常见问题)\\\\n10. [技术支持](#10-技术支持)\\\\n\\\\n---\\\\n\\\\n## 1. 平台概述\\\\n\\\\n### 1.1 平台简介\\\\n\\\\nYYC³餐饮行业智能化平台是一款专为餐饮企业打造的全方位智能化管理平台，集成了客户管理、订单管理、厨房管理、菜单管理、数据分析等核心功能，帮助餐饮企业实现数字化转型，提升运营效率，优化客户体验。\\\\n\\\\n### 1.2 核心功能\\\\n\\\\n- **客户管理**：全方位客户信息管理，支持客户分群、标签管理、生命周期跟踪\\\\n- **订单管理**：订单全流程管理，支持订单查询、状态跟踪、统计分析\\\\n- **厨房管理**：厨房任务管理，支持任务分配、进度跟踪、效率分析\\\\n- **菜单管理**：菜品信息管理，支持分类管理、价格管理、库存管理\\\\n- **数据分析**：多维度数据分析，支持销售分析、客户分析、趋势分析\\\\n- **系统管理**：系统配置管理，支持用户管理、权限管理、日志管理\\\\n\\\\n### 1.3 系统要求\\\\n\\\\n- **浏览器**：Chrome 80+、Firefox 75+、Safari 13+、Edge 80+\\\\n- **分辨率**：建议使用1920x1080或更高分辨率\\\\n- **网络**：稳定的互联网连接\\\\n\\\\n---\\\\n\\\\n## 2. 快速入门\\\\n\\\\n### 2.1 登录系统\\\\n\\\\n1. 打开浏览器，访问系统地址\\\\n2. 输入用户名和密码\\\\n3. 点击\\\\\\\"登录\\\\\\\"按钮\\\\n4. 首次登录需要修改密码\\\\n\\\\n### 2.2 界面导航\\\\n\\\\n系统采用左侧导航栏+顶部工具栏的布局：\\\\n\\\\n- **左侧导航栏**：主要功能模块入口\\\\n- **顶部工具栏**：用户信息、消息通知、系统设置\\\\n- **主内容区**：当前功能模块的操作界面\\\\n\\\\n### 2.3 基本操作\\\\n\\\\n#### 2.3.1 表格操作\\\\n\\\\n- **查看详情**：点击操作列的\\\\\\\"查看\\\\\\\"按钮\\\\n- **编辑**：点击操作列的\\\\\\\"编辑\\\\\\\"按钮\\\\n- **删除**：点击操作列的\\\\\\\"删除\\\\\\\"按钮\\\\n- **批量操作**：勾选表格左侧复选框，使用顶部批量操作按钮\\\\n\\\\n#### 2.3.2 搜索过滤\\\\n\\\\n- **关键词搜索**：在搜索框输入关键词，点击搜索按钮\\\\n- **高级筛选**：使用筛选条件组合进行精确查询\\\\n- **重置筛选**：点击\\\\\\\"重置\\\\\\\"按钮清空所有筛选条件\\\\n\\\\n#### 2.3.3 分页浏览\\\\n\\\\n- **切换页码**：点击页码或使用\\\\\\\"上一页\\\\\\\"、\\\\\\\"下一页\\\\\\\"按钮\\\\n- **调整每页条数**：在每页条数下拉框中选择显示数量\\\\n\\\\n---\\\\n\\\\n## 3. 客户管理模块\\\\n\\\\n### 3.1 客户列表\\\\n\\\\n#### 3.1.1 功能概述\\\\n\\\\n客户列表展示所有客户的基本信息，支持搜索、筛选、排序、批量操作等功能。\\\\n\\\\n#### 3.1.2 操作步骤\\\\n\\\\n1. 进入\\\\\\\"客户管理\\\\\\\"→\\\\\\\"客户列表\\\\\\\"\\\\n2. 查看客户列表，包含以下信息：\\\\n   - 客户姓名\\\\n   - 手机号\\\\n   - 邮箱\\\\n   - 会员等级\\\\n   - 累计消费\\\\n   - 订单数\\\\n   - 积分\\\\n   - 注册时间\\\\n3. 使用搜索框或筛选条件查找客户\\\\n4. 点击操作按钮进行相应操作\\\\n\\\\n#### 3.1.3 搜索筛选\\\\n\\\\n支持以下筛选条件：\\\\n- **客户姓名**：输入客户姓名进行模糊搜索\\\\n- **手机号**：输入手机号进行精确搜索\\\\n- **会员等级**：选择会员等级进行筛选\\\\n- **注册时间**：选择注册时间范围\\\\n- **状态**：选择客户状态（活跃/非活跃/黑名单）\\\\n\\\\n### 3.2 客户详情\\\\n\\\\n#### 3.2.1 功能概述\\\\n\\\\n客户详情展示客户的完整信息，包括基本信息、订单历史、积分历史、状态历史等。\\\\n\\\\n#### 3.2.2 操作步骤\\\\n\\\\n1. 在客户列表中点击\\\\\\\"查看详情\\\\\\\"按钮\\\\n2. 查看客户基本信息\\\\n3. 切换标签页查看不同类型的历史记录：\\\\n   - 订单历史\\\\n   - 积分历史\\\\n   - 状态历史\\\\n   - 访问记录\\\\n\\\\n#### 3.2.3 信息说明\\\\n\\\\n**基本信息**：\\\\n- 客户姓名、手机号、邮箱\\\\n- 会员等级、累计消费、订单数、积分\\\\n- 注册时间、最后访问时间\\\\n\\\\n**订单历史**：\\\\n- 订单号、订单金额、订单状态\\\\n- 支付方式、下单时间\\\\n\\\\n**积分历史**：\\\\n- 积分变化、变化后积分\\\\n- 变化类型（获得/消费/过期）\\\\n- 说明、时间\\\\n\\\\n**状态历史**：\\\\n- 旧状态、新状态\\\\n- 变更人、变更时间、变更原因\\\\n\\\\n### 3.3 客户分群\\\\n\\\\n#### 3.3.1 功能概述\\\\n\\\\n客户分群支持将客户按照不同维度进行分组管理，便于精细化运营。\\\\n\\\\n#### 3.3.2 创建分群\\\\n\\\\n1. 进入\\\\\\\"客户管理\\\\\\\"→\\\\\\\"客户分群\\\\\\\"\\\\n2. 点击\\\\\\\"新建分群\\\\\\\"按钮\\\\n3. 填写分群信息：\\\\n   - 分群名称（必填）\\\\n   - 分群类型（手动/自动/RFM/生命周期）\\\\n   - 描述\\\\n   - 显示颜色\\\\n   - 优先级\\\\n   - 状态（启用/禁用）\\\\n4. 点击\\\\\\\"确定\\\\\\\"保存\\\\n\\\\n#### 3.3.3 分群类型说明\\\\n\\\\n- **手动分群**：手动添加客户到分群\\\\n- **自动分群**：根据预设条件自动添加客户\\\\n- **RFM分群**：根据RFM模型自动分群\\\\n- **生命周期分群**：根据客户生命周期阶段自动分群\\\\n\\\\n#### 3.3.4 管理分群成员\\\\n\\\\n1. 在分群列表中点击\\\\\\\"查看成员\\\\\\\"\\\\n2. 查看分群成员列表\\\\n3. 点击\\\\\\\"添加成员\\\\\\\"添加客户\\\\n4. 勾选客户后点击\\\\\\\"批量移除\\\\\\\"删除成员\\\\n\\\\n### 3.4 客户标签\\\\n\\\\n#### 3.4.1 功能概述\\\\n\\\\n客户标签支持为客户打标签，便于客户画像和精准营销。\\\\n\\\\n#### 3.4.2 创建标签\\\\n\\\\n1. 进入\\\\\\\"客户管理\\\\\\\"→\\\\\\\"客户标签\\\\\\\"\\\\n2. 点击\\\\\\\"新建标签\\\\\\\"按钮\\\\n3. 填写标签信息：\\\\n   - 标签名称（必填）\\\\n   - 标签类型（行为/偏好/自定义/系统）\\\\n   - 描述\\\\n   - 显示颜色\\\\n4. 点击\\\\\\\"确定\\\\\\\"保存\\\\n\\\\n#### 3.4.3 为客户打标签\\\\n\\\\n1. 在客户详情或客户列表中\\\\n2. 点击\\\\\\\"添加标签\\\\\\\"按钮\\\\n3. 选择要添加的标签\\\\n4. 点击\\\\\\\"确定\\\\\\\"保存\\\\n\\\\n### 3.5 客户状态跟踪\\\\n\\\\n#### 3.5.1 功能概述\\\\n\\\\n客户状态跟踪实时监控客户状态变化，支持状态修改和历史查询。\\\\n\\\\n#### 3.5.2 查看状态统计\\\\n\\\\n1. 进入\\\\\\\"客户管理\\\\\\\"→\\\\\\\"状态跟踪\\\\\\\"\\\\n2. 查看状态统计卡片：\\\\n   - 活跃客户数\\\\n   - 非活跃客户数\\\\n   - 黑名单客户数\\\\n   - 客户总数\\\\n\\\\n#### 3.5.3 修改客户状态\\\\n\\\\n1. 在客户列表中点击\\\\\\\"修改状态\\\\\\\"\\\\n2. 选择新状态\\\\n3. 填写变更原因\\\\n4. 点击\\\\\\\"确定\\\\\\\"提交\\\\n\\\\n#### 3.5.4 查看状态历史\\\\n\\\\n1. 在客户列表中点击\\\\\\\"状态历史\\\\\\\"\\\\n2. 查看客户状态变更记录\\\\n3. 包含旧状态、新状态、变更人、变更时间、变更原因\\\\n\\\\n### 3.6 客户生命周期管理\\\\n\\\\n#### 3.6.1 功能概述\\\\n\\\\n客户生命周期管理基于RFM模型和规则引擎，自动管理客户生命周期阶段。\\\\n\\\\n#### 3.6.2 生命周期阶段\\\\n\\\\n系统定义了6个生命周期阶段：\\\\n\\\\n1. **潜在客户**：已注册但未下单\\\\n2. **新客户**：首次下单后30天内\\\\n3. **活跃客户**：30天内有消费记录\\\\n4. **忠诚客户**：高价值、高频次消费\\\\n5. **休眠客户**：60-90天未消费\\\\n6. **流失客户**：90天以上未消费\\\\n\\\\n#### 3.6.3 查看生命周期看板\\\\n\\\\n1. 进入\\\\\\\"客户管理\\\\\\\"→\\\\\\\"生命周期管理\\\\\\\"\\\\n2. 查看生命周期数据看板\\\\n3. 包含以下内容：\\\\n   - 生命周期阶段分布\\\\n   - 客户价值分布（RFM）\\\\n   - 生命周期流转趋势\\\\n   - 客户留存率趋势\\\\n   - 客户生命周期价值分布\\\\n\\\\n#### 3.6.4 客户流失预警\\\\n\\\\n1. 在生命周期看板中查看流失预警列表\\\\n2. 筛选风险等级（高危/中危/低危）\\\\n3. 查看客户流失概率和风险因素\\\\n4. 分配责任人并制定挽回措施\\\\n5. 跟踪处理进度\\\\n\\\\n#### 3.6.5 智能客户关怀\\\\n\\\\n1. 在生命周期看板中查看关怀提醒列表\\\\n2. 查看提醒类型和触发条件\\\\n3. 发送关怀信息\\\\n4. 记录关怀结果\\\\n\\\\n### 3.7 客户地址管理\\\\n\\\\n#### 3.7.1 功能概述\\\\n\\\\n客户地址管理支持管理客户的收货地址信息。\\\\n\\\\n#### 3.7.2 添加地址\\\\n\\\\n1. 在客户详情中点击\\\\\\\"地址管理\\\\\\\"\\\\n2. 点击\\\\\\\"添加地址\\\\\\\"按钮\\\\n3. 填写地址信息：\\\\n   - 联系人姓名\\\\n   - 联系电话\\\\n   - 省份、城市、区县\\\\n   - 详细地址\\\\n   - 邮编\\\\n   - 地址类型（家/公司/其他）\\\\n4. 点击\\\\\\\"确定\\\\\\\"保存\\\\n\\\\n#### 3.7.3 设置默认地址\\\\n\\\\n1. 在地址列表中点击\\\\\\\"设为默认\\\\\\\"\\\\n2. 系统自动将该地址设为默认地址\\\\n\\\\n### 3.8 客户偏好管理\\\\n\\\\n#### 3.8.1 功能概述\\\\n\\\\n客户偏好管理记录客户的个性化偏好，用于精准推荐。\\\\n\\\\n#### 3.8.2 设置偏好\\\\n\\\\n1. 在客户详情中点击\\\\\\\"偏好管理\\\\\\\"\\\\n2. 选择偏好类型（口味/菜品/用餐时间等）\\\\n3. 设置偏好值\\\\n4. 点击\\\\\\\"确定\\\\\\\"保存\\\\n\\\\n---\\\\n\\\\n## 4. 订单管理模块\\\\n\\\\n### 4.1 订单列表\\\\n\\\\n#### 4.1.1 功能概述\\\\n\\\\n订单列表展示所有订单信息，支持搜索、筛选、状态管理等功能。\\\\n\\\\n#### 4.1.2 订单状态\\\\n\\\\n- **待支付**：订单已创建，等待支付\\\\n- **已支付**：订单已支付，等待处理\\\\n- **已接单**：商家已接单，准备制作\\\\n- **制作中**：订单正在制作\\\\n- **配送中**：订单正在配送\\\\n- **已完成**：订单已完成\\\\n- **已取消**：订单已取消\\\\n- **已退款**：订单已退款\\\\n\\\\n#### 4.1.3 操作步骤\\\\n\\\\n1. 进入\\\\\\\"订单管理\\\\\\\"→\\\\\\\"订单列表\\\\\\\"\\\\n2. 查看订单列表，包含以下信息：\\\\n   - 订单号\\\\n   - 客户姓名\\\\n   - 订单金额\\\\n   - 订单状态\\\\n   - 下单时间\\\\n   - 配送地址\\\\n3. 使用搜索或筛选查找订单\\\\n4. 点击操作按钮进行相应操作\\\\n\\\\n### 4.2 订单详情\\\\n\\\\n#### 4.2.1 功能概述\\\\n\\\\n订单详情展示订单的完整信息，包括订单信息、商品信息、配送信息、支付信息等。\\\\n\\\\n#### 4.2.2 查看详情\\\\n\\\\n1. 在订单列表中点击\\\\\\\"查看详情\\\\\\\"\\\\n2. 查看订单基本信息\\\\n3. 查看商品明细\\\\n4. 查看配送信息\\\\n5. 查看支付信息\\\\n6. 查看订单日志\\\\n\\\\n### 4.3 订单处理\\\\n\\\\n#### 4.3.1 接单\\\\n\\\\n1. 在订单列表中找到待接单的订单\\\\n2. 点击\\\\\\\"接单\\\\\\\"按钮\\\\n3. 确认接单\\\\n\\\\n#### 4.3.2 开始制作\\\\n\\\\n1. 在订单列表中找到已接单的订单\\\\n2. 点击\\\\\\\"开始制作\\\\\\\"按钮\\\\n3. 订单状态变为\\\\\\\"制作中\\\\\\\"\\\\n\\\\n#### 4.3.3 完成制作\\\\n\\\\n1. 在订单列表中找到制作中的订单\\\\n2. 点击\\\\\\\"完成制作\\\\\\\"按钮\\\\n3. 订单状态变为\\\\\\\"配送中\\\\\\\"\\\\n\\\\n#### 4.3.4 完成订单\\\\n\\\\n1. 在订单列表中找到配送中的订单\\\\n2. 点击\\\\\\\"完成订单\\\\\\\"按钮\\\\n3. 订单状态变为\\\\\\\"已完成\\\\\\\"\\\\n\\\\n### 4.4 订单取消\\\\n\\\\n#### 4.4.1 取消订单\\\\n\\\\n1. 在订单列表中找到要取消的订单\\\\n2. 点击\\\\\\\"取消订单\\\\\\\"按钮\\\\n3. 选择取消原因\\\\n4. 填写备注\\\\n5. 点击\\\\\\\"确定\\\\\\\"提交\\\\n\\\\n#### 4.4.2 退款处理\\\\n\\\\n1. 在订单详情中点击\\\\\\\"申请退款\\\\\\\"\\\\n2. 选择退款金额\\\\n3. 填写退款原因\\\\n4. 提交退款申请\\\\n\\\\n### 4.5 订单统计\\\\n\\\\n#### 4.5.1 销售统计\\\\n\\\\n1. 进入\\\\\\\"订单管理\\\\\\\"→\\\\\\\"订单统计\\\\\\\"\\\\n2. 选择统计时间范围\\\\n3. 查看销售数据：\\\\n   - 订单总数\\\\n   - 订单总额\\\\n   - 平均订单金额\\\\n   - 客单价\\\\n\\\\n#### 4.5.2 状态统计\\\\n\\\\n1. 在订单统计页面\\\\n2. 查看各状态订单数量和占比\\\\n3. 分析订单流转效率\\\\n\\\\n---\\\\n\\\\n## 5. 厨房管理模块\\\\n\\\\n### 5.1 厨房任务列表\\\\n\\\\n#### 5.1.1 功能概述\\\\n\\\\n厨房任务列表展示所有待处理的厨房任务，支持任务分配、进度跟踪等功能。\\\\n\\\\n#### 5.1.2 任务状态\\\\n\\\\n- **待处理**：任务已创建，等待处理\\\\n- **进行中**：任务正在处理\\\\n- **已完成**：任务已完成\\\\n- **已取消**：任务已取消\\\\n\\\\n#### 5.1.3 操作步骤\\\\n\\\\n1. 进入\\\\\\\"厨房管理\\\\\\\"→\\\\\\\"任务列表\\\\\\\"\\\\n2. 查看任务列表，包含以下信息：\\\\n   - 任务编号\\\\n   - 订单号\\\\n   - 菜品名称\\\\n   - 数量\\\\n   - 任务状态\\\\n   - 创建时间\\\\n   - 截止时间\\\\n3. 点击操作按钮进行相应操作\\\\n\\\\n### 5.2 任务分配\\\\n\\\\n#### 5.2.1 分配任务\\\\n\\\\n1. 在任务列表中找到待分配的任务\\\\n2. 点击\\\\\\\"分配任务\\\\\\\"按钮\\\\n3. 选择处理人\\\\n4. 设置优先级\\\\n5. 点击\\\\\\\"确定\\\\\\\"保存\\\\n\\\\n#### 5.2.2 批量分配\\\\n\\\\n1. 勾选多个待分配任务\\\\n2. 点击\\\\\\\"批量分配\\\\\\\"按钮\\\\n3. 选择处理人\\\\n4. 点击\\\\\\\"确定\\\\\\\"保存\\\\n\\\\n### 5.3 任务处理\\\\n\\\\n#### 5.3.1 开始任务\\\\n\\\\n1. 在任务列表中找到待处理的任务\\\\n2. 点击\\\\\\\"开始处理\\\\\\\"按钮\\\\n3. 任务状态变为\\\\\\\"进行中\\\\\\\"\\\\n\\\\n#### 5.3.2 完成任务\\\\n\\\\n1. 在任务列表中找到进行中的任务\\\\n2. 点击\\\\\\\"完成任务\\\\\\\"按钮\\\\n3. 填写完成备注\\\\n4. 点击\\\\\\\"确定\\\\\\\"保存\\\\n\\\\n#### 5.3.3 取消任务\\\\n\\\\n1. 在任务列表中找到要取消的任务\\\\n2. 点击\\\\\\\"取消任务\\\\\\\"按钮\\\\n3. 选择取消原因\\\\n4. 点击\\\\\\\"确定\\\\\\\"保存\\\\n\\\\n### 5.4 厨房效率分析\\\\n\\\\n#### 5.4.1 效率统计\\\\n\\\\n1. 进入\\\\\\\"厨房管理\\\\\\\"→\\\\\\\"效率分析\\\\\\\"\\\\n2. 选择统计时间范围\\\\n3. 查看效率数据：\\\\n   - 任务完成数量\\\\n   - 平均处理时间\\\\n   - 任务准时率\\\\n   - 人员效率排名\\\\n\\\\n#### 5.4.2 趋势分析\\\\n\\\\n1. 在效率分析页面\\\\n2. 查看效率趋势图表\\\\n3. 分析效率变化情况\\\\n\\\\n---\\\\n\\\\n## 6. 菜单管理模块\\\\n\\\\n### 6.1 菜品列表\\\\n\\\\n#### 6.1.1 功能概述\\\\n\\\\n菜品列表展示所有菜品信息，支持搜索、筛选、分类管理等功能。\\\\n\\\\n#### 6.1.2 操作步骤\\\\n\\\\n1. 进入\\\\\\\"菜单管理\\\\\\\"→\\\\\\\"菜品列表\\\\\\\"\\\\n2. 查看菜品列表，包含以下信息：\\\\n   - 菜品名称\\\\n   - 菜品分类\\\\n   - 价格\\\\n   - 库存\\\\n   - 状态\\\\n   - 创建时间\\\\n3. 使用搜索或筛选查找菜品\\\\n4. 点击操作按钮进行相应操作\\\\n\\\\n### 6.2 添加菜品\\\\n\\\\n#### 6.2.1 创建菜品\\\\n\\\\n1. 点击\\\\\\\"添加菜品\\\\\\\"按钮\\\\n2. 填写菜品信息：\\\\n   - 菜品名称（必填）\\\\n   - 菜品分类（必填）\\\\n   - 价格（必填）\\\\n   - 原价\\\\n   - 库存数量\\\\n   - 菜品图片\\\\n   - 菜品描述\\\\n   - 菜品标签\\\\n   - 状态（上架/下架）\\\\n3. 点击\\\\\\\"确定\\\\\\\"保存\\\\n\\\\n### 6.3 编辑菜品\\\\n\\\\n#### 6.3.1 修改菜品信息\\\\n\\\\n1. 在菜品列表中点击\\\\\\\"编辑\\\\\\\"按钮\\\\n2. 修改菜品信息\\\\n3. 点击\\\\\\\"确定\\\\\\\"保存\\\\n\\\\n### 6.4 菜品分类\\\\n\\\\n#### 6.4.1 管理分类\\\\n\\\\n1. 进入\\\\\\\"菜单管理\\\\\\\"→\\\\\\\"菜品分类\\\\\\\"\\\\n2. 查看分类列表\\\\n3. 点击\\\\\\\"添加分类\\\\\\\"创建新分类\\\\n4. 点击\\\\\\\"编辑\\\\\\\"修改分类信息\\\\n5. 点击\\\\\\\"删除\\\\\\\"删除分类\\\\n\\\\n### 6.5 库存管理\\\\n\\\\n#### 6.5.1 查看库存\\\\n\\\\n1. 在菜品列表中查看库存数量\\\\n2. 库存不足的菜品会显示警告标识\\\\n\\\\n#### 6.5.2 调整库存\\\\n\\\\n1. 在菜品列表中点击\\\\\\\"调整库存\\\\\\\"\\\\n2. 输入新的库存数量\\\\n3. 填写调整原因\\\\n4. 点击\\\\\\\"确定\\\\\\\"保存\\\\n\\\\n---\\\\n\\\\n## 7. 数据分析模块\\\\n\\\\n### 7.1 销售分析\\\\n\\\\n#### 7.1.1 销售概览\\\\n\\\\n1. 进入\\\\\\\"数据分析\\\\\\\"→\\\\\\\"销售分析\\\\\\\"\\\\n2. 选择统计时间范围\\\\n3. 查看销售数据：\\\\n   - 销售总额\\\\n   - 订单数量\\\\n   - 客单价\\\\n   - 同比增长\\\\n   - 环比增长\\\\n\\\\n#### 7.1.2 销售趋势\\\\n\\\\n1. 在销售分析页面\\\\n2. 查看销售趋势图表\\\\n3. 分析销售变化情况\\\\n\\\\n#### 7.1.3 商品销售排行\\\\n\\\\n1. 在销售分析页面\\\\n2. 查看商品销售排行榜\\\\n3. 分析热销商品\\\\n\\\\n### 7.2 客户分析\\\\n\\\\n#### 7.2.1 客户概览\\\\n\\\\n1. 进入\\\\\\\"数据分析\\\\\\\"→\\\\\\\"客户分析\\\\\\\"\\\\n2. 选择统计时间范围\\\\n3. 查看客户数据：\\\\n   - 客户总数\\\\n   - 新增客户\\\\n   - 活跃客户\\\\n   - 流失客户\\\\n   - 客户留存率\\\\n\\\\n#### 7.2.2 客户价值分析\\\\n\\\\n1. 在客户分析页面\\\\n2. 查看客户价值分布\\\\n3. 分析高价值客户特征\\\\n\\\\n#### 7.2.3 客户行为分析\\\\n\\\\n1. 在客户分析页面\\\\n2. 查看客户行为数据\\\\n3. 分析客户消费习惯\\\\n\\\\n### 7.3 订单分析\\\\n\\\\n#### 7.3.1 订单概览\\\\n\\\\n1. 进入\\\\\\\"数据分析\\\\\\\"→\\\\\\\"订单分析\\\\\\\"\\\\n2. 选择统计时间范围\\\\n3. 查看订单数据：\\\\n   - 订单总数\\\\n   - 订单金额\\\\n   - 平均订单金额\\\\n   - 订单完成率\\\\n\\\\n#### 7.3.2 订单趋势\\\\n\\\\n1. 在订单分析页面\\\\n2. 查看订单趋势图表\\\\n3. 分析订单变化情况\\\\n\\\\n### 7.4 报表导出\\\\n\\\\n#### 7.4.1 导出报表\\\\n\\\\n1. 在数据分析页面\\\\n2. 点击\\\\\\\"导出报表\\\\\\\"按钮\\\\n3. 选择报表类型\\\\n4. 选择导出格式（Excel/PDF）\\\\n5. 点击\\\\\\\"确定\\\\\\\"导出\\\\n\\\\n---\\\\n\\\\n## 8. 系统管理模块\\\\n\\\\n### 8.1 用户管理\\\\n\\\\n#### 8.1.1 用户列表\\\\n\\\\n1. 进入\\\\\\\"系统管理\\\\\\\"→\\\\\\\"用户管理\\\\\\\"\\\\n2. 查看用户列表\\\\n3. 包含用户名、姓名、角色、状态、最后登录时间等信息\\\\n\\\\n#### 8.1.2 添加用户\\\\n\\\\n1. 点击\\\\\\\"添加用户\\\\\\\"按钮\\\\n2. 填写用户信息：\\\\n   - 用户名（必填）\\\\n   - 姓名（必填）\\\\n   - 手机号（必填）\\\\n   - 邮箱\\\\n   - 角色（必填）\\\\n   - 状态（启用/禁用）\\\\n3. 点击\\\\\\\"确定\\\\\\\"保存\\\\n\\\\n#### 8.1.3 重置密码\\\\n\\\\n1. 在用户列表中点击\\\\\\\"重置密码\\\\\\\"\\\\n2. 输入新密码\\\\n3. 点击\\\\\\\"确定\\\\\\\"保存\\\\n\\\\n### 8.2 角色管理\\\\n\\\\n#### 8.2.1 角色列表\\\\n\\\\n1. 进入\\\\\\\"系统管理\\\\\\\"→\\\\\\\"角色管理\\\\\\\"\\\\n2. 查看角色列表\\\\n3. 包含角色名称、描述、用户数量等信息\\\\n\\\\n#### 8.2.2 添加角色\\\\n\\\\n1. 点击\\\\\\\"添加角色\\\\\\\"按钮\\\\n2. 填写角色信息：\\\\n   - 角色名称（必填）\\\\n   - 角色描述\\\\n   - 权限设置\\\\n3. 点击\\\\\\\"确定\\\\\\\"保存\\\\n\\\\n### 8.3 权限管理\\\\n\\\\n#### 8.3.1 权限列表\\\\n\\\\n1. 进入\\\\\\\"系统管理\\\\\\\"→\\\\\\\"权限管理\\\\\\\"\\\\n2. 查看权限列表\\\\n3. 包含权限名称、权限标识、权限类型等信息\\\\n\\\\n#### 8.3.2 分配权限\\\\n\\\\n1. 在角色管理中点击\\\\\\\"权限设置\\\\\\\"\\\\n2. 勾选要分配的权限\\\\n3. 点击\\\\\\\"确定\\\\\\\"保存\\\\n\\\\n### 8.4 系统日志\\\\n\\\\n#### 8.4.1 日志查询\\\\n\\\\n1. 进入\\\\\\\"系统管理\\\\\\\"→\\\\\\\"系统日志\\\\\\\"\\\\n2. 选择查询条件：\\\\n   - 操作人\\\\n   - 操作类型\\\\n   - 时间范围\\\\n3. 点击\\\\\\\"查询\\\\\\\"按钮\\\\n4. 查看日志列表\\\\n\\\\n#### 8.4.2 日志详情\\\\n\\\\n1. 在日志列表中点击\\\\\\\"查看详情\\\\\\\"\\\\n2. 查看完整的日志信息\\\\n\\\\n---\\\\n\\\\n## 9. 常见问题\\\\n\\\\n### 9.1 登录问题\\\\n\\\\n**Q：忘记密码怎么办？**\\\\n\\\\nA：请联系系统管理员重置密码。\\\\n\\\\n**Q：登录时提示\\\\\\\"用户名或密码错误\\\\\\\"？**\\\\n\\\\nA：请检查用户名和密码是否正确，注意大小写。\\\\n\\\\n### 9.2 操作问题\\\\n\\\\n**Q：如何批量操作？**\\\\n\\\\nA：勾选表格左侧的复选框，然后使用顶部的批量操作按钮。\\\\n\\\\n**Q：如何导出数据？**\\\\n\\\\nA：在列表页面点击\\\\\\\"导出\\\\\\\"按钮，选择导出格式即可。\\\\n\\\\n**Q：数据修改后多久生效？**\\\\n\\\\nA：数据修改后立即生效。\\\\n\\\\n### 9.3 性能问题\\\\n\\\\n**Q：页面加载缓慢怎么办？**\\\\n\\\\nA：请检查网络连接，清除浏览器缓存，或联系技术支持。\\\\n\\\\n**Q：导出大量数据时超时怎么办？**\\\\n\\\\nA：请缩小导出时间范围，或联系技术支持。\\\\n\\\\n### 9.4 其他问题\\\\n\\\\n**Q：系统支持哪些浏览器？**\\\\n\\\\nA：支持Chrome 80+、Firefox 75+、Safari 13+、Edge 80+。\\\\n\\\\n**Q：如何联系技术支持？**\\\\n\\\\nA：请查看\\\\\\\"技术支持\\\\\\\"章节获取联系方式。\\\\n\\\\n---\\\\n\\\\n## 10. 技术支持\\\\n\\\\n### 10.1 联系方式\\\\n\\\\n- **技术支持热线**：400-XXX-XXXX\\\\n- **技术支持邮箱**：support@yyc3.com\\\\n- **在线客服**：系统右下角在线客服图标\\\\n- **工作时间**：周一至周日 9:00-21:00\\\\n\\\\n### 10.2 问题反馈\\\\n\\\\n如遇到问题或有建议，请通过以下方式反馈：\\\\n\\\\n1. 在线客服反馈\\\\n2. 发送邮件至support@yyc3.com\\\\n3. 拨打技术支持热线\\\\n\\\\n### 10.3 常用链接\\\\n\\\\n- **系统官网**：https://www.yyc3.com\\\\n- **帮助中心**：https://help.yyc3.com\\\\n- **视频教程**：https://video.yyc3.com\\\\n\\\\n---\\\\n\\\\n## 附录\\\\n\\\\n### A. 术语表\\\\n\\\\n| 术语 | 说明 |\\\\n|------|------|\\\\n| RFM模型 | 一种客户价值分析模型，通过最近消费、消费频率、消费金额三个维度评估客户价值 |\\\\n| 客户生命周期 | 客户从注册到流失的整个过程，分为多个阶段 |\\\\n| 客户分群 | 将客户按照不同维度进行分组管理 |\\\\n| 客户标签 | 为客户打上的标签，用于客户画像和精准营销 |\\\\n\\\\n### B. 快捷键\\\\n\\\\n| 快捷键 | 功能 |\\\\n|--------|------|\\\\n| Ctrl + F | 搜索 |\\\\n| Ctrl + S | 保存 |\\\\n| Ctrl + R | 刷新 |\\\\n| Esc | 关闭弹窗 |\\\\n\\\\n### C. 版本历史\\\\n\\\\n| 版本 | 日期 | 更新内容 |\\\\n|------|------|----------|\\\\n| v1.0.0 | 2026-01-20 | 初始版本 |\\\\n\\\\n---\\\\n\\\\n> 「***YanYuCloudCube***」\\\\n> 「***<admin@0379.email>***」\\\\n> 「***Words Initiate Quadrants, Language Serves as Core for the Future***」\\\\n> 「***All things converge in the cloud pivot; Deep stacks ignite a new era of intelligence***」\\\\n\",\"originAcceptText\":\"# YYC³餐饮行业智能化平台 - 用户操作手册\\n\\n## 文档信息\\n\\n| 项目 | 内容 |\\n|------|------|\\n| 文档名称 | YYC³餐饮行业智能化平台用户操作手册 |\\n| 文档版本 | v1.0.0 |\\n| 创建日期 | 2026-01-20 |\\n| 最后更新 | 2026-01-20 |\\n| 文档状态 | 正式版 |\\n\\n---\\n\\n## 目录\\n\\n1. [平台概述](#1-平台概述)\\n2. [快速入门](#2-快速入门)\\n3. [客户管理模块](#3-客户管理模块)\\n4. [订单管理模块](#4-订单管理模块)\\n5. [厨房管理模块](#5-厨房管理模块)\\n6. [菜单管理模块](#6-菜单管理模块)\\n7. [数据分析模块](#7-数据分析模块)\\n8. [系统管理模块](#8-系统管理模块)\\n9. [常见问题](#9-常见问题)\\n10. [技术支持](#10-技术支持)\\n\\n---\\n\\n## 1. 平台概述\\n\\n### 1.1 平台简介\\n\\nYYC³餐饮行业智能化平台是一款专为餐饮企业打造的全方位智能化管理平台，集成了客户管理、订单管理、厨房管理、菜单管理、数据分析等核心功能，帮助餐饮企业实现数字化转型，提升运营效率，优化客户体验。\\n\\n### 1.2 核心功能\\n\\n- **客户管理**：全方位客户信息管理，支持客户分群、标签管理、生命周期跟踪\\n- **订单管理**：订单全流程管理，支持订单查询、状态跟踪、统计分析\\n- **厨房管理**：厨房任务管理，支持任务分配、进度跟踪、效率分析\\n- **菜单管理**：菜品信息管理，支持分类管理、价格管理、库存管理\\n- **数据分析**：多维度数据分析，支持销售分析、客户分析、趋势分析\\n- **系统管理**：系统配置管理，支持用户管理、权限管理、日志管理\\n\\n### 1.3 系统要求\\n\\n- **浏览器**：Chrome 80+、Firefox 75+、Safari 13+、Edge 80+\\n- **分辨率**：建议使用1920x1080或更高分辨率\\n- **网络**：稳定的互联网连接\\n\\n---\\n\\n## 2. 快速入门\\n\\n### 2.1 登录系统\\n\\n1. 打开浏览器，访问系统地址\\n2. 输入用户名和密码\\n3. 点击\\\"登录\\\"按钮\\n4. 首次登录需要修改密码\\n\\n### 2.2 界面导航\\n\\n系统采用左侧导航栏+顶部工具栏的布局：\\n\\n- **左侧导航栏**：主要功能模块入口\\n- **顶部工具栏**：用户信息、消息通知、系统设置\\n- **主内容区**：当前功能模块的操作界面\\n\\n### 2.3 基本操作\\n\\n#### 2.3.1 表格操作\\n\\n- **查看详情**：点击操作列的\\\"查看\\\"按钮\\n- **编辑**：点击操作列的\\\"编辑\\\"按钮\\n- **删除**：点击操作列的\\\"删除\\\"按钮\\n- **批量操作**：勾选表格左侧复选框，使用顶部批量操作按钮\\n\\n#### 2.3.2 搜索过滤\\n\\n- **关键词搜索**：在搜索框输入关键词，点击搜索按钮\\n- **高级筛选**：使用筛选条件组合进行精确查询\\n- **重置筛选**：点击\\\"重置\\\"按钮清空所有筛选条件\\n\\n#### 2.3.3 分页浏览\\n\\n- **切换页码**：点击页码或使用\\\"上一页\\\"、\\\"下一页\\\"按钮\\n- **调整每页条数**：在每页条数下拉框中选择显示数量\\n\\n---\\n\\n## 3. 客户管理模块\\n\\n### 3.1 客户列表\\n\\n#### 3.1.1 功能概述\\n\\n客户列表展示所有客户的基本信息，支持搜索、筛选、排序、批量操作等功能。\\n\\n#### 3.1.2 操作步骤\\n\\n1. 进入\\\"客户管理\\\"→\\\"客户列表\\\"\\n2. 查看客户列表，包含以下信息：\\n   - 客户姓名\\n   - 手机号\\n   - 邮箱\\n   - 会员等级\\n   - 累计消费\\n   - 订单数\\n   - 积分\\n   - 注册时间\\n3. 使用搜索框或筛选条件查找客户\\n4. 点击操作按钮进行相应操作\\n\\n#### 3.1.3 搜索筛选\\n\\n支持以下筛选条件：\\n- **客户姓名**：输入客户姓名进行模糊搜索\\n- **手机号**：输入手机号进行精确搜索\\n- **会员等级**：选择会员等级进行筛选\\n- **注册时间**：选择注册时间范围\\n- **状态**：选择客户状态（活跃/非活跃/黑名单）\\n\\n### 3.2 客户详情\\n\\n#### 3.2.1 功能概述\\n\\n客户详情展示客户的完整信息，包括基本信息、订单历史、积分历史、状态历史等。\\n\\n#### 3.2.2 操作步骤\\n\\n1. 在客户列表中点击\\\"查看详情\\\"按钮\\n2. 查看客户基本信息\\n3. 切换标签页查看不同类型的历史记录：\\n   - 订单历史\\n   - 积分历史\\n   - 状态历史\\n   - 访问记录\\n\\n#### 3.2.3 信息说明\\n\\n**基本信息**：\\n- 客户姓名、手机号、邮箱\\n- 会员等级、累计消费、订单数、积分\\n- 注册时间、最后访问时间\\n\\n**订单历史**：\\n- 订单号、订单金额、订单状态\\n- 支付方式、下单时间\\n\\n**积分历史**：\\n- 积分变化、变化后积分\\n- 变化类型（获得/消费/过期）\\n- 说明、时间\\n\\n**状态历史**：\\n- 旧状态、新状态\\n- 变更人、变更时间、变更原因\\n\\n### 3.3 客户分群\\n\\n#### 3.3.1 功能概述\\n\\n客户分群支持将客户按照不同维度进行分组管理，便于精细化运营。\\n\\n#### 3.3.2 创建分群\\n\\n1. 进入\\\"客户管理\\\"→\\\"客户分群\\\"\\n2. 点击\\\"新建分群\\\"按钮\\n3. 填写分群信息：\\n   - 分群名称（必填）\\n   - 分群类型（手动/自动/RFM/生命周期）\\n   - 描述\\n   - 显示颜色\\n   - 优先级\\n   - 状态（启用/禁用）\\n4. 点击\\\"确定\\\"保存\\n\\n#### 3.3.3 分群类型说明\\n\\n- **手动分群**：手动添加客户到分群\\n- **自动分群**：根据预设条件自动添加客户\\n- **RFM分群**：根据RFM模型自动分群\\n- **生命周期分群**：根据客户生命周期阶段自动分群\\n\\n#### 3.3.4 管理分群成员\\n\\n1. 在分群列表中点击\\\"查看成员\\\"\\n2. 查看分群成员列表\\n3. 点击\\\"添加成员\\\"添加客户\\n4. 勾选客户后点击\\\"批量移除\\\"删除成员\\n\\n### 3.4 客户标签\\n\\n#### 3.4.1 功能概述\\n\\n客户标签支持为客户打标签，便于客户画像和精准营销。\\n\\n#### 3.4.2 创建标签\\n\\n1. 进入\\\"客户管理\\\"→\\\"客户标签\\\"\\n2. 点击\\\"新建标签\\\"按钮\\n3. 填写标签信息：\\n   - 标签名称（必填）\\n   - 标签类型（行为/偏好/自定义/系统）\\n   - 描述\\n   - 显示颜色\\n4. 点击\\\"确定\\\"保存\\n\\n#### 3.4.3 为客户打标签\\n\\n1. 在客户详情或客户列表中\\n2. 点击\\\"添加标签\\\"按钮\\n3. 选择要添加的标签\\n4. 点击\\\"确定\\\"保存\\n\\n### 3.5 客户状态跟踪\\n\\n#### 3.5.1 功能概述\\n\\n客户状态跟踪实时监控客户状态变化，支持状态修改和历史查询。\\n\\n#### 3.5.2 查看状态统计\\n\\n1. 进入\\\"客户管理\\\"→\\\"状态跟踪\\\"\\n2. 查看状态统计卡片：\\n   - 活跃客户数\\n   - 非活跃客户数\\n   - 黑名单客户数\\n   - 客户总数\\n\\n#### 3.5.3 修改客户状态\\n\\n1. 在客户列表中点击\\\"修改状态\\\"\\n2. 选择新状态\\n3. 填写变更原因\\n4. 点击\\\"确定\\\"提交\\n\\n#### 3.5.4 查看状态历史\\n\\n1. 在客户列表中点击\\\"状态历史\\\"\\n2. 查看客户状态变更记录\\n3. 包含旧状态、新状态、变更人、变更时间、变更原因\\n\\n### 3.6 客户生命周期管理\\n\\n#### 3.6.1 功能概述\\n\\n客户生命周期管理基于RFM模型和规则引擎，自动管理客户生命周期阶段。\\n\\n#### 3.6.2 生命周期阶段\\n\\n系统定义了6个生命周期阶段：\\n\\n1. **潜在客户**：已注册但未下单\\n2. **新客户**：首次下单后30天内\\n3. **活跃客户**：30天内有消费记录\\n4. **忠诚客户**：高价值、高频次消费\\n5. **休眠客户**：60-90天未消费\\n6. **流失客户**：90天以上未消费\\n\\n#### 3.6.3 查看生命周期看板\\n\\n1. 进入\\\"客户管理\\\"→\\\"生命周期管理\\\"\\n2. 查看生命周期数据看板\\n3. 包含以下内容：\\n   - 生命周期阶段分布\\n   - 客户价值分布（RFM）\\n   - 生命周期流转趋势\\n   - 客户留存率趋势\\n   - 客户生命周期价值分布\\n\\n#### 3.6.4 客户流失预警\\n\\n1. 在生命周期看板中查看流失预警列表\\n2. 筛选风险等级（高危/中危/低危）\\n3. 查看客户流失概率和风险因素\\n4. 分配责任人并制定挽回措施\\n5. 跟踪处理进度\\n\\n#### 3.6.5 智能客户关怀\\n\\n1. 在生命周期看板中查看关怀提醒列表\\n2. 查看提醒类型和触发条件\\n3. 发送关怀信息\\n4. 记录关怀结果\\n\\n### 3.7 客户地址管理\\n\\n#### 3.7.1 功能概述\\n\\n客户地址管理支持管理客户的收货地址信息。\\n\\n#### 3.7.2 添加地址\\n\\n1. 在客户详情中点击\\\"地址管理\\\"\\n2. 点击\\\"添加地址\\\"按钮\\n3. 填写地址信息：\\n   - 联系人姓名\\n   - 联系电话\\n   - 省份、城市、区县\\n   - 详细地址\\n   - 邮编\\n   - 地址类型（家/公司/其他）\\n4. 点击\\\"确定\\\"保存\\n\\n#### 3.7.3 设置默认地址\\n\\n1. 在地址列表中点击\\\"设为默认\\\"\\n2. 系统自动将该地址设为默认地址\\n\\n### 3.8 客户偏好管理\\n\\n#### 3.8.1 功能概述\\n\\n客户偏好管理记录客户的个性化偏好，用于精准推荐。\\n\\n#### 3.8.2 设置偏好\\n\\n1. 在客户详情中点击\\\"偏好管理\\\"\\n2. 选择偏好类型（口味/菜品/用餐时间等）\\n3. 设置偏好值\\n4. 点击\\\"确定\\\"保存\\n\\n---\\n\\n## 4. 订单管理模块\\n\\n### 4.1 订单列表\\n\\n#### 4.1.1 功能概述\\n\\n订单列表展示所有订单信息，支持搜索、筛选、状态管理等功能。\\n\\n#### 4.1.2 订单状态\\n\\n- **待支付**：订单已创建，等待支付\\n- **已支付**：订单已支付，等待处理\\n- **已接单**：商家已接单，准备制作\\n- **制作中**：订单正在制作\\n- **配送中**：订单正在配送\\n- **已完成**：订单已完成\\n- **已取消**：订单已取消\\n- **已退款**：订单已退款\\n\\n#### 4.1.3 操作步骤\\n\\n1. 进入\\\"订单管理\\\"→\\\"订单列表\\\"\\n2. 查看订单列表，包含以下信息：\\n   - 订单号\\n   - 客户姓名\\n   - 订单金额\\n   - 订单状态\\n   - 下单时间\\n   - 配送地址\\n3. 使用搜索或筛选查找订单\\n4. 点击操作按钮进行相应操作\\n\\n### 4.2 订单详情\\n\\n#### 4.2.1 功能概述\\n\\n订单详情展示订单的完整信息，包括订单信息、商品信息、配送信息、支付信息等。\\n\\n#### 4.2.2 查看详情\\n\\n1. 在订单列表中点击\\\"查看详情\\\"\\n2. 查看订单基本信息\\n3. 查看商品明细\\n4. 查看配送信息\\n5. 查看支付信息\\n6. 查看订单日志\\n\\n### 4.3 订单处理\\n\\n#### 4.3.1 接单\\n\\n1. 在订单列表中找到待接单的订单\\n2. 点击\\\"接单\\\"按钮\\n3. 确认接单\\n\\n#### 4.3.2 开始制作\\n\\n1. 在订单列表中找到已接单的订单\\n2. 点击\\\"开始制作\\\"按钮\\n3. 订单状态变为\\\"制作中\\\"\\n\\n#### 4.3.3 完成制作\\n\\n1. 在订单列表中找到制作中的订单\\n2. 点击\\\"完成制作\\\"按钮\\n3. 订单状态变为\\\"配送中\\\"\\n\\n#### 4.3.4 完成订单\\n\\n1. 在订单列表中找到配送中的订单\\n2. 点击\\\"完成订单\\\"按钮\\n3. 订单状态变为\\\"已完成\\\"\\n\\n### 4.4 订单取消\\n\\n#### 4.4.1 取消订单\\n\\n1. 在订单列表中找到要取消的订单\\n2. 点击\\\"取消订单\\\"按钮\\n3. 选择取消原因\\n4. 填写备注\\n5. 点击\\\"确定\\\"提交\\n\\n#### 4.4.2 退款处理\\n\\n1. 在订单详情中点击\\\"申请退款\\\"\\n2. 选择退款金额\\n3. 填写退款原因\\n4. 提交退款申请\\n\\n### 4.5 订单统计\\n\\n#### 4.5.1 销售统计\\n\\n1. 进入\\\"订单管理\\\"→\\\"订单统计\\\"\\n2. 选择统计时间范围\\n3. 查看销售数据：\\n   - 订单总数\\n   - 订单总额\\n   - 平均订单金额\\n   - 客单价\\n\\n#### 4.5.2 状态统计\\n\\n1. 在订单统计页面\\n2. 查看各状态订单数量和占比\\n3. 分析订单流转效率\\n\\n---\\n\\n## 5. 厨房管理模块\\n\\n### 5.1 厨房任务列表\\n\\n#### 5.1.1 功能概述\\n\\n厨房任务列表展示所有待处理的厨房任务，支持任务分配、进度跟踪等功能。\\n\\n#### 5.1.2 任务状态\\n\\n- **待处理**：任务已创建，等待处理\\n- **进行中**：任务正在处理\\n- **已完成**：任务已完成\\n- **已取消**：任务已取消\\n\\n#### 5.1.3 操作步骤\\n\\n1. 进入\\\"厨房管理\\\"→\\\"任务列表\\\"\\n2. 查看任务列表，包含以下信息：\\n   - 任务编号\\n   - 订单号\\n   - 菜品名称\\n   - 数量\\n   - 任务状态\\n   - 创建时间\\n   - 截止时间\\n3. 点击操作按钮进行相应操作\\n\\n### 5.2 任务分配\\n\\n#### 5.2.1 分配任务\\n\\n1. 在任务列表中找到待分配的任务\\n2. 点击\\\"分配任务\\\"按钮\\n3. 选择处理人\\n4. 设置优先级\\n5. 点击\\\"确定\\\"保存\\n\\n#### 5.2.2 批量分配\\n\\n1. 勾选多个待分配任务\\n2. 点击\\\"批量分配\\\"按钮\\n3. 选择处理人\\n4. 点击\\\"确定\\\"保存\\n\\n### 5.3 任务处理\\n\\n#### 5.3.1 开始任务\\n\\n1. 在任务列表中找到待处理的任务\\n2. 点击\\\"开始处理\\\"按钮\\n3. 任务状态变为\\\"进行中\\\"\\n\\n#### 5.3.2 完成任务\\n\\n1. 在任务列表中找到进行中的任务\\n2. 点击\\\"完成任务\\\"按钮\\n3. 填写完成备注\\n4. 点击\\\"确定\\\"保存\\n\\n#### 5.3.3 取消任务\\n\\n1. 在任务列表中找到要取消的任务\\n2. 点击\\\"取消任务\\\"按钮\\n3. 选择取消原因\\n4. 点击\\\"确定\\\"保存\\n\\n### 5.4 厨房效率分析\\n\\n#### 5.4.1 效率统计\\n\\n1. 进入\\\"厨房管理\\\"→\\\"效率分析\\\"\\n2. 选择统计时间范围\\n3. 查看效率数据：\\n   - 任务完成数量\\n   - 平均处理时间\\n   - 任务准时率\\n   - 人员效率排名\\n\\n#### 5.4.2 趋势分析\\n\\n1. 在效率分析页面\\n2. 查看效率趋势图表\\n3. 分析效率变化情况\\n\\n---\\n\\n## 6. 菜单管理模块\\n\\n### 6.1 菜品列表\\n\\n#### 6.1.1 功能概述\\n\\n菜品列表展示所有菜品信息，支持搜索、筛选、分类管理等功能。\\n\\n#### 6.1.2 操作步骤\\n\\n1. 进入\\\"菜单管理\\\"→\\\"菜品列表\\\"\\n2. 查看菜品列表，包含以下信息：\\n   - 菜品名称\\n   - 菜品分类\\n   - 价格\\n   - 库存\\n   - 状态\\n   - 创建时间\\n3. 使用搜索或筛选查找菜品\\n4. 点击操作按钮进行相应操作\\n\\n### 6.2 添加菜品\\n\\n#### 6.2.1 创建菜品\\n\\n1. 点击\\\"添加菜品\\\"按钮\\n2. 填写菜品信息：\\n   - 菜品名称（必填）\\n   - 菜品分类（必填）\\n   - 价格（必填）\\n   - 原价\\n   - 库存数量\\n   - 菜品图片\\n   - 菜品描述\\n   - 菜品标签\\n   - 状态（上架/下架）\\n3. 点击\\\"确定\\\"保存\\n\\n### 6.3 编辑菜品\\n\\n#### 6.3.1 修改菜品信息\\n\\n1. 在菜品列表中点击\\\"编辑\\\"按钮\\n2. 修改菜品信息\\n3. 点击\\\"确定\\\"保存\\n\\n### 6.4 菜品分类\\n\\n#### 6.4.1 管理分类\\n\\n1. 进入\\\"菜单管理\\\"→\\\"菜品分类\\\"\\n2. 查看分类列表\\n3. 点击\\\"添加分类\\\"创建新分类\\n4. 点击\\\"编辑\\\"修改分类信息\\n5. 点击\\\"删除\\\"删除分类\\n\\n### 6.5 库存管理\\n\\n#### 6.5.1 查看库存\\n\\n1. 在菜品列表中查看库存数量\\n2. 库存不足的菜品会显示警告标识\\n\\n#### 6.5.2 调整库存\\n\\n1. 在菜品列表中点击\\\"调整库存\\\"\\n2. 输入新的库存数量\\n3. 填写调整原因\\n4. 点击\\\"确定\\\"保存\\n\\n---\\n\\n## 7. 数据分析模块\\n\\n### 7.1 销售分析\\n\\n#### 7.1.1 销售概览\\n\\n1. 进入\\\"数据分析\\\"→\\\"销售分析\\\"\\n2. 选择统计时间范围\\n3. 查看销售数据：\\n   - 销售总额\\n   - 订单数量\\n   - 客单价\\n   - 同比增长\\n   - 环比增长\\n\\n#### 7.1.2 销售趋势\\n\\n1. 在销售分析页面\\n2. 查看销售趋势图表\\n3. 分析销售变化情况\\n\\n#### 7.1.3 商品销售排行\\n\\n1. 在销售分析页面\\n2. 查看商品销售排行榜\\n3. 分析热销商品\\n\\n### 7.2 客户分析\\n\\n#### 7.2.1 客户概览\\n\\n1. 进入\\\"数据分析\\\"→\\\"客户分析\\\"\\n2. 选择统计时间范围\\n3. 查看客户数据：\\n   - 客户总数\\n   - 新增客户\\n   - 活跃客户\\n   - 流失客户\\n   - 客户留存率\\n\\n#### 7.2.2 客户价值分析\\n\\n1. 在客户分析页面\\n2. 查看客户价值分布\\n3. 分析高价值客户特征\\n\\n#### 7.2.3 客户行为分析\\n\\n1. 在客户分析页面\\n2. 查看客户行为数据\\n3. 分析客户消费习惯\\n\\n### 7.3 订单分析\\n\\n#### 7.3.1 订单概览\\n\\n1. 进入\\\"数据分析\\\"→\\\"订单分析\\\"\\n2. 选择统计时间范围\\n3. 查看订单数据：\\n   - 订单总数\\n   - 订单金额\\n   - 平均订单金额\\n   - 订单完成率\\n\\n#### 7.3.2 订单趋势\\n\\n1. 在订单分析页面\\n2. 查看订单趋势图表\\n3. 分析订单变化情况\\n\\n### 7.4 报表导出\\n\\n#### 7.4.1 导出报表\\n\\n1. 在数据分析页面\\n2. 点击\\\"导出报表\\\"按钮\\n3. 选择报表类型\\n4. 选择导出格式（Excel/PDF）\\n5. 点击\\\"确定\\\"导出\\n\\n---\\n\\n## 8. 系统管理模块\\n\\n### 8.1 用户管理\\n\\n#### 8.1.1 用户列表\\n\\n1. 进入\\\"系统管理\\\"→\\\"用户管理\\\"\\n2. 查看用户列表\\n3. 包含用户名、姓名、角色、状态、最后登录时间等信息\\n\\n#### 8.1.2 添加用户\\n\\n1. 点击\\\"添加用户\\\"按钮\\n2. 填写用户信息：\\n   - 用户名（必填）\\n   - 姓名（必填）\\n   - 手机号（必填）\\n   - 邮箱\\n   - 角色（必填）\\n   - 状态（启用/禁用）\\n3. 点击\\\"确定\\\"保存\\n\\n#### 8.1.3 重置密码\\n\\n1. 在用户列表中点击\\\"重置密码\\\"\\n2. 输入新密码\\n3. 点击\\\"确定\\\"保存\\n\\n### 8.2 角色管理\\n\\n#### 8.2.1 角色列表\\n\\n1. 进入\\\"系统管理\\\"→\\\"角色管理\\\"\\n2. 查看角色列表\\n3. 包含角色名称、描述、用户数量等信息\\n\\n#### 8.2.2 添加角色\\n\\n1. 点击\\\"添加角色\\\"按钮\\n2. 填写角色信息：\\n   - 角色名称（必填）\\n   - 角色描述\\n   - 权限设置\\n3. 点击\\\"确定\\\"保存\\n\\n### 8.3 权限管理\\n\\n#### 8.3.1 权限列表\\n\\n1. 进入\\\"系统管理\\\"→\\\"权限管理\\\"\\n2. 查看权限列表\\n3. 包含权限名称、权限标识、权限类型等信息\\n\\n#### 8.3.2 分配权限\\n\\n1. 在角色管理中点击\\\"权限设置\\\"\\n2. 勾选要分配的权限\\n3. 点击\\\"确定\\\"保存\\n\\n### 8.4 系统日志\\n\\n#### 8.4.1 日志查询\\n\\n1. 进入\\\"系统管理\\\"→\\\"系统日志\\\"\\n2. 选择查询条件：\\n   - 操作人\\n   - 操作类型\\n   - 时间范围\\n3. 点击\\\"查询\\\"按钮\\n4. 查看日志列表\\n\\n#### 8.4.2 日志详情\\n\\n1. 在日志列表中点击\\\"查看详情\\\"\\n2. 查看完整的日志信息\\n\\n---\\n\\n## 9. 常见问题\\n\\n### 9.1 登录问题\\n\\n**Q：忘记密码怎么办？**\\n\\nA：请联系系统管理员重置密码。\\n\\n**Q：登录时提示\\\"用户名或密码错误\\\"？**\\n\\nA：请检查用户名和密码是否正确，注意大小写。\\n\\n### 9.2 操作问题\\n\\n**Q：如何批量操作？**\\n\\nA：勾选表格左侧的复选框，然后使用顶部的批量操作按钮。\\n\\n**Q：如何导出数据？**\\n\\nA：在列表页面点击\\\"导出\\\"按钮，选择导出格式即可。\\n\\n**Q：数据修改后多久生效？**\\n\\nA：数据修改后立即生效。\\n\\n### 9.3 性能问题\\n\\n**Q：页面加载缓慢怎么办？**\\n\\nA：请检查网络连接，清除浏览器缓存，或联系技术支持。\\n\\n**Q：导出大量数据时超时怎么办？**\\n\\nA：请缩小导出时间范围，或联系技术支持。\\n\\n### 9.4 其他问题\\n\\n**Q：系统支持哪些浏览器？**\\n\\nA：支持Chrome 80+、Firefox 75+、Safari 13+、Edge 80+。\\n\\n**Q：如何联系技术支持？**\\n\\nA：请查看\\\"技术支持\\\"章节获取联系方式。\\n\\n---\\n\\n## 10. 技术支持\\n\\n### 10.1 联系方式\\n\\n- **技术支持热线**：400-XXX-XXXX\\n- **技术支持邮箱**：support@yyc3.com\\n- **在线客服**：系统右下角在线客服图标\\n- **工作时间**：周一至周日 9:00-21:00\\n\\n### 10.2 问题反馈\\n\\n如遇到问题或有建议，请通过以下方式反馈：\\n\\n1. 在线客服反馈\\n2. 发送邮件至support@yyc3.com\\n3. 拨打技术支持热线\\n\\n### 10.3 常用链接\\n\\n- **系统官网**：https://www.yyc3.com\\n- **帮助中心**：https://help.yyc3.com\\n- **视频教程**：https://video.yyc3.com\\n\\n---\\n\\n## 附录\\n\\n### A. 术语表\\n\\n| 术语 | 说明 |\\n|------|------|\\n| RFM模型 | 一种客户价值分析模型，通过最近消费、消费频率、消费金额三个维度评估客户价值 |\\n| 客户生命周期 | 客户从注册到流失的整个过程，分为多个阶段 |\\n| 客户分群 | 将客户按照不同维度进行分组管理 |\\n| 客户标签 | 为客户打上的标签，用于客户画像和精准营销 |\\n\\n### B. 快捷键\\n\\n| 快捷键 | 功能 |\\n|--------|------|\\n| Ctrl + F | 搜索 |\\n| Ctrl + S | 保存 |\\n| Ctrl + R | 刷新 |\\n| Esc | 关闭弹窗 |\\n\\n### C. 版本历史\\n\\n| 版本 | 日期 | 更新内容 |\\n|------|------|----------|\\n| v1.0.0 | 2026-01-20 | 初始版本 |\\n\\n---\\n\\n> 「***YanYuCloudCube***」\\n> 「***<admin@0379.email>***」\\n> 「***Words Initiate Quadrants, Language Serves as Core for the Future***」\\n> 「***All things converge in the cloud pivot; Deep stacks ignite a new era of intelligence***」\\n\",\"originTextLength\":9790,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768913478401},{\"originRange\":{\"start\":{\"line\":248,\"character\":0},\"end\":{\"line\":248,\"character\":64}},\"modifyRange\":{\"start\":{\"line\":248,\"character\":0},\"end\":{\"line\":248,\"character\":64}},\"action\":\"None\",\"isLine\":false,\"originText\":\"客户生命周期管理基于RFM模型和规则引擎，自动管理客户生命周期阶段，提供流失预警、智能关怀等功能，帮助提升客户留存率和客户价值。\",\"originAcceptText\":\"客户生命周期管理基于RFM模型和规则引擎，自动管理客户生命周期阶段，提供流失预警、智能关怀等功能，帮助提升客户留存率和客户价值。\",\"originTextLength\":64,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768914147318},{\"originRange\":{\"start\":{\"line\":272,\"character\":0},\"end\":{\"line\":482,\"character\":15}},\"modifyRange\":{\"start\":{\"line\":272,\"character\":0},\"end\":{\"line\":482,\"character\":15}},\"action\":\"None\",\"isLine\":false,\"originText\":\"#### 3.6.4 RFM分析\\\\n\\\\n##### 3.6.4.1 RFM模型说明\\\\n\\\\nRFM模型通过三个维度评估客户价值：\\\\n\\\\n- **Recency（最近消费）**：客户最近一次消费时间，分值1-5分\\\\n- **Frequency（消费频率）**：客户消费频次，分值1-5分\\\\n- **Monetary（消费金额）**：客户累计消费金额，分值1-5分\\\\n\\\\nRFM总分 = Recency + Frequency + Monetary（3-15分）\\\\n\\\\n##### 3.6.4.2 客户等级划分\\\\n\\\\n| RFM分数 | 客户等级 | 说明 |\\\\n|---------|----------|------|\\\\n| 13-15分 | 超级VIP | 最高价值客户，需要重点维护 |\\\\n| 10-12分 | VIP | 高价值客户，需要持续关注 |\\\\n| 7-9分 | 会员 | 中等价值客户，需要提升价值 |\\\\n| 4-6分 | 普通 | 一般价值客户，需要培养 |\\\\n| 1-3分 | 低价值 | 低价值客户，需要激活 |\\\\n\\\\n##### 3.6.4.3 计算RFM评分\\\\n\\\\n1. 进入\\\\\\\"客户管理\\\\\\\"→\\\\\\\"RFM分析\\\\\\\"\\\\n2. 点击\\\\\\\"计算RFM评分\\\\\\\"按钮\\\\n3. 选择要计算的客户（支持批量选择）\\\\n4. 点击\\\\\\\"确定\\\\\\\"开始计算\\\\n5. 系统自动计算并更新RFM评分\\\\n\\\\n##### 3.6.4.4 查看RFM分析报告\\\\n\\\\n1. 在RFM分析页面查看统计数据\\\\n2. 包含以下内容：\\\\n   - 平均RFM分数\\\\n   - 客户等级分布\\\\n   - Recency分布\\\\n   - Frequency分布\\\\n   - Monetary分布\\\\n   - RFM三维分布图\\\\n\\\\n##### 3.6.4.5 导出RFM分析报告\\\\n\\\\n1. 在RFM分析页面点击\\\\\\\"导出报告\\\\\\\"\\\\n2. 选择导出格式（Excel/PDF）\\\\n3. 选择时间范围\\\\n4. 点击\\\\\\\"确定\\\\\\\"导出\\\\n\\\\n#### 3.6.5 客户流失预警\\\\n\\\\n##### 3.6.5.1 流失预警说明\\\\n\\\\n系统根据客户行为数据预测客户流失概率，并生成流失预警：\\\\n\\\\n- **高危预警**：流失概率≥70%，需要立即处理\\\\n- **中危预警**：流失概率40%-70%，需要关注\\\\n- **低危预警**：流失概率<40%，需要监控\\\\n\\\\n##### 3.6.5.2 查看流失预警列表\\\\n\\\\n1. 进入\\\\\\\"客户管理\\\\\\\"→\\\\\\\"流失预警\\\\\\\"\\\\n2. 查看流失预警列表\\\\n3. 包含以下信息：\\\\n   - 客户姓名、手机号、邮箱\\\\n   - 流失概率、风险等级\\\\n   - 风险因素\\\\n   - 预测流失日期\\\\n   - 推荐挽回措施\\\\n   - 负责人、状态\\\\n\\\\n##### 3.6.5.3 筛选流失预警\\\\n\\\\n支持以下筛选条件：\\\\n- **风险等级**：高危/中危/低危\\\\n- **状态**：待处理/处理中/已解决/已关闭\\\\n- **负责人**：选择负责人\\\\n- **时间范围**：选择预警时间范围\\\\n\\\\n##### 3.6.5.4 分配流失预警\\\\n\\\\n1. 在流失预警列表中找到待分配的预警\\\\n2. 点击\\\\\\\"分配\\\\\\\"按钮\\\\n3. 选择负责人\\\\n4. 点击\\\\\\\"确定\\\\\\\"保存\\\\n5. 预警状态变为\\\\\\\"处理中\\\\\\\"\\\\n\\\\n##### 3.6.5.5 处理流失预警\\\\n\\\\n1. 在流失预警列表中点击\\\\\\\"查看详情\\\\\\\"\\\\n2. 查看客户信息和风险因素\\\\n3. 根据推荐挽回措施制定处理方案\\\\n4. 记录处理过程和结果\\\\n5. 点击\\\\\\\"标记为已解决\\\\\\\"完成处理\\\\n\\\\n##### 3.6.5.6 查看流失趋势\\\\n\\\\n1. 在流失预警页面点击\\\\\\\"趋势分析\\\\\\\"\\\\n2. 查看流失趋势图表\\\\n3. 包含以下内容：\\\\n   - 流失客户数量趋势\\\\n   - 流失率趋势\\\\n   - 各风险等级预警数量趋势\\\\n   - 流失原因分析\\\\n\\\\n#### 3.6.6 智能客户关怀\\\\n\\\\n##### 3.6.6.1 关怀提醒说明\\\\n\\\\n系统根据客户行为和生命周期阶段，自动生成关怀提醒：\\\\n\\\\n- **回访提醒**：客户长时间未消费时触发\\\\n- **生日提醒**：客户生日当天触发\\\\n- **节日提醒**：重要节日前触发\\\\n- **会员升级提醒**：客户等级提升时触发\\\\n- **消费提醒**：客户消费后触发\\\\n\\\\n##### 3.6.6.2 查看关怀提醒列表\\\\n\\\\n1. 进入\\\\\\\"客户管理\\\\\\\"→\\\\\\\"关怀提醒\\\\\\\"\\\\n2. 查看关怀提醒列表\\\\n3. 包含以下信息：\\\\n   - 客户姓名、手机号\\\\n   - 提醒类型、标题\\\\n   - 提醒内容\\\\n   - 发送渠道（短信/邮件/推送）\\\\n   - 优先级\\\\n   - 计划发送时间\\\\n   - 发送状态\\\\n\\\\n##### 3.6.6.3 筛选关怀提醒\\\\n\\\\n支持以下筛选条件：\\\\n- **客户**：输入客户姓名或手机号\\\\n- **提醒类型**：选择提醒类型\\\\n- **状态**：待发送/已发送/发送失败\\\\n- **优先级**：高/中/低\\\\n\\\\n##### 3.6.6.4 发送关怀提醒\\\\n\\\\n1. 在关怀提醒列表中找到待发送的提醒\\\\n2. 点击\\\\\\\"发送\\\\\\\"按钮\\\\n3. 系统自动发送关怀信息\\\\n4. 查看发送结果\\\\n\\\\n##### 3.6.6.5 批量发送关怀提醒\\\\n\\\\n1. 勾选多个待发送的提醒\\\\n2. 点击\\\\\\\"批量发送\\\\\\\"按钮\\\\n3. 确认批量发送\\\\n4. 系统自动批量发送\\\\n\\\\n##### 3.6.6.6 查看发送结果\\\\n\\\\n1. 在关怀提醒列表中点击\\\\\\\"查看结果\\\\\\\"\\\\n2. 查看发送状态和结果\\\\n3. 包含以下信息：\\\\n   - 发送渠道\\\\n   - 消息ID\\\\n   - 发送状态\\\\n   - 发送时间\\\\n   - 失败原因（如发送失败）\\\\n\\\\n#### 3.6.7 关怀提醒规则配置\\\\n\\\\n##### 3.6.7.1 查看规则列表\\\\n\\\\n1. 进入\\\\\\\"客户管理\\\\\\\"→\\\\\\\"关怀规则\\\\\\\"\\\\n2. 查看关怀提醒规则列表\\\\n3. 包含以下信息：\\\\n   - 规则名称\\\\n   - 规则描述\\\\n   - 触发类型\\\\n   - 触发条件\\\\n   - 提醒类型\\\\n   - 发送渠道\\\\n   - 优先级\\\\n   - 状态\\\\n\\\\n##### 3.6.7.2 创建关怀规则\\\\n\\\\n1. 点击\\\\\\\"新建规则\\\\\\\"按钮\\\\n2. 填写规则信息：\\\\n   - 规则名称（必填）\\\\n   - 规则描述\\\\n   - 触发类型（时间/事件）\\\\n   - 触发条件\\\\n   - 提醒类型\\\\n   - 发送渠道（短信/邮件/推送）\\\\n   - 提醒模板\\\\n   - 优先级（高/中/低）\\\\n   - 状态（启用/禁用）\\\\n3. 点击\\\\\\\"确定\\\\\\\"保存\\\\n\\\\n##### 3.6.7.3 编辑关怀规则\\\\n\\\\n1. 在规则列表中点击\\\\\\\"编辑\\\\\\\"\\\\n2. 修改规则信息\\\\n3. 点击\\\\\\\"确定\\\\\\\"保存\\\\n\\\\n##### 3.6.7.4 启用/禁用规则\\\\n\\\\n1. 在规则列表中点击\\\\\\\"启用\\\\\\\"或\\\\\\\"禁用\\\\\\\"\\\\n2. 系统立即更新规则状态\\\\n\\\\n##### 3.6.7.5 删除规则\\\\n\\\\n1. 在规则列表中点击\\\\\\\"删除\\\\\\\"\\\\n2. 确认删除\\\\n3. 规则被永久删除\\\\n\\\\n#### 3.6.8 生命周期数据看板\\\\n\\\\n##### 3.6.8.1 生命周期阶段分布\\\\n\\\\n1. 在生命周期看板中查看阶段分布图表\\\\n2. 展示各阶段客户数量和占比\\\\n3. 支持按时间范围筛选\\\\n\\\\n##### 3.6.8.2 客户价值分布\\\\n\\\\n1. 在生命周期看板中查看客户价值分布\\\\n2. 展示各RFM等级客户数量和占比\\\\n3. 展示平均客户生命周期价值（CLV）\\\\n4. 展示总客户生命周期价值\\\\n\\\\n##### 3.6.8.3 生命周期流转趋势\\\\n\\\\n1. 在生命周期看板中查看流转趋势图表\\\\n2. 展示各阶段之间的流转数量\\\\n3. 支持按天/周/月查看趋势\\\\n4. 分析客户生命周期流转效率\\\\n\\\\n##### 3.6.8.4 客户留存率趋势\\\\n\\\\n1. 在生命周期看板中查看留存率趋势\\\\n2. 展示不同周期的留存率\\\\n3. 支持自定义留存周期\\\\n4. 分析客户留存情况\\\\n\\\\n##### 3.6.8.5 导出生命周期报告\\\\n\\\\n1. 在生命周期看板中点击\\\\\\\"导出报告\\\\\\\"\\\\n2. 选择导出格式（Excel/PDF）\\\\n3. 选择时间范围\\\\n4. 点击\\\\\\\"确定\\\\\\\"导出\\\\n\\\\n#### 3.6.9 手动更新生命周期阶段\\\\n\\\\n##### 3.6.9.1 更新单个客户生命周期\\\\n\\\\n1. 在客户详情中点击\\\\\\\"生命周期\\\\\\\"标签\\\\n2. 查看当前生命周期阶段\\\\n3. 点击\\\\\\\"更新阶段\\\\\\\"按钮\\\\n4. 选择新阶段\\\\n5. 填写变更原因\\\\n6. 点击\\\\\\\"确定\\\\\\\"保存\\\\n\\\\n##### 3.6.9.2 批量更新生命周期\\\\n\\\\n1. 在客户列表中勾选多个客户\\\\n2. 点击\\\\\\\"批量更新生命周期\\\\\\\"\\\\n3. 选择新阶段\\\\n4. 填写变更原因\\\\n5. 点击\\\\\\\"确定\\\\\\\"保存\\\\n\\\\n#### 3.6.10 查看生命周期历史\\\\n\\\\n##### 3.6.10.1 查看单个客户生命周期历史\\\\n\\\\n1. 在客户详情中点击\\\\\\\"生命周期历史\\\\\\\"\\\\n2. 查看客户生命周期阶段变更记录\\\\n3. 包含以下信息：\\\\n   - 阶段名称\\\\n   - 进入时间\\\\n   - 退出时间\\\\n   - 持续时长\\\\n   - 变更原因\\\\n\\\\n##### 3.6.10.2 查看生命周期流转统计\\\\n\\\\n1. 在生命周期看板中点击\\\\\\\"流转统计\\\\\\\"\\\\n2. 查看各阶段之间的流转统计\\\\n3. 分析客户生命周期流转规律\",\"originAcceptText\":\"#### 3.6.4 RFM分析\\n\\n##### 3.6.4.1 RFM模型说明\\n\\nRFM模型通过三个维度评估客户价值：\\n\\n- **Recency（最近消费）**：客户最近一次消费时间，分值1-5分\\n- **Frequency（消费频率）**：客户消费频次，分值1-5分\\n- **Monetary（消费金额）**：客户累计消费金额，分值1-5分\\n\\nRFM总分 = Recency + Frequency + Monetary（3-15分）\\n\\n##### 3.6.4.2 客户等级划分\\n\\n| RFM分数 | 客户等级 | 说明 |\\n|---------|----------|------|\\n| 13-15分 | 超级VIP | 最高价值客户，需要重点维护 |\\n| 10-12分 | VIP | 高价值客户，需要持续关注 |\\n| 7-9分 | 会员 | 中等价值客户，需要提升价值 |\\n| 4-6分 | 普通 | 一般价值客户，需要培养 |\\n| 1-3分 | 低价值 | 低价值客户，需要激活 |\\n\\n##### 3.6.4.3 计算RFM评分\\n\\n1. 进入\\\"客户管理\\\"→\\\"RFM分析\\\"\\n2. 点击\\\"计算RFM评分\\\"按钮\\n3. 选择要计算的客户（支持批量选择）\\n4. 点击\\\"确定\\\"开始计算\\n5. 系统自动计算并更新RFM评分\\n\\n##### 3.6.4.4 查看RFM分析报告\\n\\n1. 在RFM分析页面查看统计数据\\n2. 包含以下内容：\\n   - 平均RFM分数\\n   - 客户等级分布\\n   - Recency分布\\n   - Frequency分布\\n   - Monetary分布\\n   - RFM三维分布图\\n\\n##### 3.6.4.5 导出RFM分析报告\\n\\n1. 在RFM分析页面点击\\\"导出报告\\\"\\n2. 选择导出格式（Excel/PDF）\\n3. 选择时间范围\\n4. 点击\\\"确定\\\"导出\\n\\n#### 3.6.5 客户流失预警\\n\\n##### 3.6.5.1 流失预警说明\\n\\n系统根据客户行为数据预测客户流失概率，并生成流失预警：\\n\\n- **高危预警**：流失概率≥70%，需要立即处理\\n- **中危预警**：流失概率40%-70%，需要关注\\n- **低危预警**：流失概率<40%，需要监控\\n\\n##### 3.6.5.2 查看流失预警列表\\n\\n1. 进入\\\"客户管理\\\"→\\\"流失预警\\\"\\n2. 查看流失预警列表\\n3. 包含以下信息：\\n   - 客户姓名、手机号、邮箱\\n   - 流失概率、风险等级\\n   - 风险因素\\n   - 预测流失日期\\n   - 推荐挽回措施\\n   - 负责人、状态\\n\\n##### 3.6.5.3 筛选流失预警\\n\\n支持以下筛选条件：\\n- **风险等级**：高危/中危/低危\\n- **状态**：待处理/处理中/已解决/已关闭\\n- **负责人**：选择负责人\\n- **时间范围**：选择预警时间范围\\n\\n##### 3.6.5.4 分配流失预警\\n\\n1. 在流失预警列表中找到待分配的预警\\n2. 点击\\\"分配\\\"按钮\\n3. 选择负责人\\n4. 点击\\\"确定\\\"保存\\n5. 预警状态变为\\\"处理中\\\"\\n\\n##### 3.6.5.5 处理流失预警\\n\\n1. 在流失预警列表中点击\\\"查看详情\\\"\\n2. 查看客户信息和风险因素\\n3. 根据推荐挽回措施制定处理方案\\n4. 记录处理过程和结果\\n5. 点击\\\"标记为已解决\\\"完成处理\\n\\n##### 3.6.5.6 查看流失趋势\\n\\n1. 在流失预警页面点击\\\"趋势分析\\\"\\n2. 查看流失趋势图表\\n3. 包含以下内容：\\n   - 流失客户数量趋势\\n   - 流失率趋势\\n   - 各风险等级预警数量趋势\\n   - 流失原因分析\\n\\n#### 3.6.6 智能客户关怀\\n\\n##### 3.6.6.1 关怀提醒说明\\n\\n系统根据客户行为和生命周期阶段，自动生成关怀提醒：\\n\\n- **回访提醒**：客户长时间未消费时触发\\n- **生日提醒**：客户生日当天触发\\n- **节日提醒**：重要节日前触发\\n- **会员升级提醒**：客户等级提升时触发\\n- **消费提醒**：客户消费后触发\\n\\n##### 3.6.6.2 查看关怀提醒列表\\n\\n1. 进入\\\"客户管理\\\"→\\\"关怀提醒\\\"\\n2. 查看关怀提醒列表\\n3. 包含以下信息：\\n   - 客户姓名、手机号\\n   - 提醒类型、标题\\n   - 提醒内容\\n   - 发送渠道（短信/邮件/推送）\\n   - 优先级\\n   - 计划发送时间\\n   - 发送状态\\n\\n##### 3.6.6.3 筛选关怀提醒\\n\\n支持以下筛选条件：\\n- **客户**：输入客户姓名或手机号\\n- **提醒类型**：选择提醒类型\\n- **状态**：待发送/已发送/发送失败\\n- **优先级**：高/中/低\\n\\n##### 3.6.6.4 发送关怀提醒\\n\\n1. 在关怀提醒列表中找到待发送的提醒\\n2. 点击\\\"发送\\\"按钮\\n3. 系统自动发送关怀信息\\n4. 查看发送结果\\n\\n##### 3.6.6.5 批量发送关怀提醒\\n\\n1. 勾选多个待发送的提醒\\n2. 点击\\\"批量发送\\\"按钮\\n3. 确认批量发送\\n4. 系统自动批量发送\\n\\n##### 3.6.6.6 查看发送结果\\n\\n1. 在关怀提醒列表中点击\\\"查看结果\\\"\\n2. 查看发送状态和结果\\n3. 包含以下信息：\\n   - 发送渠道\\n   - 消息ID\\n   - 发送状态\\n   - 发送时间\\n   - 失败原因（如发送失败）\\n\\n#### 3.6.7 关怀提醒规则配置\\n\\n##### 3.6.7.1 查看规则列表\\n\\n1. 进入\\\"客户管理\\\"→\\\"关怀规则\\\"\\n2. 查看关怀提醒规则列表\\n3. 包含以下信息：\\n   - 规则名称\\n   - 规则描述\\n   - 触发类型\\n   - 触发条件\\n   - 提醒类型\\n   - 发送渠道\\n   - 优先级\\n   - 状态\\n\\n##### 3.6.7.2 创建关怀规则\\n\\n1. 点击\\\"新建规则\\\"按钮\\n2. 填写规则信息：\\n   - 规则名称（必填）\\n   - 规则描述\\n   - 触发类型（时间/事件）\\n   - 触发条件\\n   - 提醒类型\\n   - 发送渠道（短信/邮件/推送）\\n   - 提醒模板\\n   - 优先级（高/中/低）\\n   - 状态（启用/禁用）\\n3. 点击\\\"确定\\\"保存\\n\\n##### 3.6.7.3 编辑关怀规则\\n\\n1. 在规则列表中点击\\\"编辑\\\"\\n2. 修改规则信息\\n3. 点击\\\"确定\\\"保存\\n\\n##### 3.6.7.4 启用/禁用规则\\n\\n1. 在规则列表中点击\\\"启用\\\"或\\\"禁用\\\"\\n2. 系统立即更新规则状态\\n\\n##### 3.6.7.5 删除规则\\n\\n1. 在规则列表中点击\\\"删除\\\"\\n2. 确认删除\\n3. 规则被永久删除\\n\\n#### 3.6.8 生命周期数据看板\\n\\n##### 3.6.8.1 生命周期阶段分布\\n\\n1. 在生命周期看板中查看阶段分布图表\\n2. 展示各阶段客户数量和占比\\n3. 支持按时间范围筛选\\n\\n##### 3.6.8.2 客户价值分布\\n\\n1. 在生命周期看板中查看客户价值分布\\n2. 展示各RFM等级客户数量和占比\\n3. 展示平均客户生命周期价值（CLV）\\n4. 展示总客户生命周期价值\\n\\n##### 3.6.8.3 生命周期流转趋势\\n\\n1. 在生命周期看板中查看流转趋势图表\\n2. 展示各阶段之间的流转数量\\n3. 支持按天/周/月查看趋势\\n4. 分析客户生命周期流转效率\\n\\n##### 3.6.8.4 客户留存率趋势\\n\\n1. 在生命周期看板中查看留存率趋势\\n2. 展示不同周期的留存率\\n3. 支持自定义留存周期\\n4. 分析客户留存情况\\n\\n##### 3.6.8.5 导出生命周期报告\\n\\n1. 在生命周期看板中点击\\\"导出报告\\\"\\n2. 选择导出格式（Excel/PDF）\\n3. 选择时间范围\\n4. 点击\\\"确定\\\"导出\\n\\n#### 3.6.9 手动更新生命周期阶段\\n\\n##### 3.6.9.1 更新单个客户生命周期\\n\\n1. 在客户详情中点击\\\"生命周期\\\"标签\\n2. 查看当前生命周期阶段\\n3. 点击\\\"更新阶段\\\"按钮\\n4. 选择新阶段\\n5. 填写变更原因\\n6. 点击\\\"确定\\\"保存\\n\\n##### 3.6.9.2 批量更新生命周期\\n\\n1. 在客户列表中勾选多个客户\\n2. 点击\\\"批量更新生命周期\\\"\\n3. 选择新阶段\\n4. 填写变更原因\\n5. 点击\\\"确定\\\"保存\\n\\n#### 3.6.10 查看生命周期历史\\n\\n##### 3.6.10.1 查看单个客户生命周期历史\\n\\n1. 在客户详情中点击\\\"生命周期历史\\\"\\n2. 查看客户生命周期阶段变更记录\\n3. 包含以下信息：\\n   - 阶段名称\\n   - 进入时间\\n   - 退出时间\\n   - 持续时长\\n   - 变更原因\\n\\n##### 3.6.10.2 查看生命周期流转统计\\n\\n1. 在生命周期看板中点击\\\"流转统计\\\"\\n2. 查看各阶段之间的流转统计\\n3. 分析客户生命周期流转规律\",\"originTextLength\":3659,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768914147404}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/docs/YYC3-Cater-Platform-%E6%96%87%E6%A1%A3%E9%97%AD%E7%8E%AF/YYC3-Cater-%E5%BC%80%E5%8F%91%E6%96%87%E6%A1%A3/%E5%AE%A2%E6%88%B7%E7%AE%A1%E7%90%86%E6%A8%A1%E5%9D%97%E5%BC%80%E5%8F%91%E6%96%87%E6%A1%A3.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":1084,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":1084,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# YYC³餐饮行业智能化平台 - 客户管理模块开发文档\\\\n\\\\n## 文档信息\\\\n\\\\n| 项目 | 内容 |\\\\n|------|------|\\\\n| 文档名称 | YYC³餐饮行业智能化平台客户管理模块开发文档 |\\\\n| 文档版本 | v1.0.0 |\\\\n| 创建日期 | 2026-01-20 |\\\\n| 最后更新 | 2026-01-20 |\\\\n| 文档状态 | 正式版 |\\\\n\\\\n---\\\\n\\\\n## 目录\\\\n\\\\n1. [模块概述](#1-模块概述)\\\\n2. [技术架构](#2-技术架构)\\\\n3. [数据模型](#3-数据模型)\\\\n4. [API接口](#4-api接口)\\\\n5. [组件设计](#5-组件设计)\\\\n6. [核心功能](#6-核心功能)\\\\n7. [开发指南](#7-开发指南)\\\\n8. [测试指南](#8-测试指南)\\\\n9. [部署指南](#9-部署指南)\\\\n10. [常见问题](#10-常见问题)\\\\n\\\\n---\\\\n\\\\n## 1. 模块概述\\\\n\\\\n### 1.1 模块简介\\\\n\\\\n客户管理模块是YYC³餐饮行业智能化平台的核心模块之一，提供全方位的客户信息管理功能，包括客户基本信息管理、客户分群、客户标签、客户状态跟踪、客户历史查询、客户生命周期管理等功能。\\\\n\\\\n### 1.2 核心功能\\\\n\\\\n- **客户信息管理**：客户基本信息的增删改查\\\\n- **客户分群管理**：支持手动分群、自动分群、RFM分群、生命周期分群\\\\n- **客户标签管理**：为客户打标签，支持行为标签、偏好标签、自定义标签、系统标签\\\\n- **客户状态跟踪**：实时跟踪客户状态变化，记录状态历史\\\\n- **客户历史查询**：查询客户的订单历史、积分历史、状态历史、访问记录\\\\n- **客户生命周期管理**：基于RFM模型和规则引擎的自动生命周期管理\\\\n- **客户流失预测**：基于多种因素的客户流失预测\\\\n- **智能客户关怀**：基于规则的自动客户关怀提醒\\\\n\\\\n### 1.3 技术栈\\\\n\\\\n- **前端框架**：Vue 3 + TypeScript\\\\n- **UI组件库**：Element Plus\\\\n- **状态管理**：Pinia\\\\n- **HTTP客户端**：Axios\\\\n- **图表库**：ECharts\\\\n- **日期处理**：Day.js\\\\n\\\\n---\\\\n\\\\n## 2. 技术架构\\\\n\\\\n### 2.1 整体架构\\\\n\\\\n```\\\\n┌─────────────────────────────────────────────────────────┐\\\\n│                   前端层 (Vue 3)                    │\\\\n├─────────────────────────────────────────────────────────┤\\\\n│  视图层 (Views)                                    │\\\\n│  - CustomerStatusTracker.vue                          │\\\\n│  - CustomerHistoryQuery.vue                          │\\\\n│  - CustomerGroupManagement.vue                        │\\\\n│  - CustomerLifecycleDashboard.vue                     │\\\\n├─────────────────────────────────────────────────────────┤\\\\n│  业务逻辑层 (Composables)                           │\\\\n│  - useLifecycleRuleEngine.ts                        │\\\\n│  - useRFMModel.ts                                  │\\\\n│  - useCareReminder.ts                              │\\\\n│  - useChurnPrediction.ts                           │\\\\n├─────────────────────────────────────────────────────────┤\\\\n│  数据访问层 (API)                                   │\\\\n│  - customer.ts                                      │\\\\n├─────────────────────────────────────────────────────────┤\\\\n│                   后端层 (Node.js)                   │\\\\n├─────────────────────────────────────────────────────────┤\\\\n│  控制器层 (Controllers)                            │\\\\n│  - CustomerController                               │\\\\n│  - CustomerGroupController                          │\\\\n│  - CustomerTagController                            │\\\\n│  - CustomerLifecycleController                      │\\\\n├─────────────────────────────────────────────────────────┤\\\\n│  服务层 (Services)                                 │\\\\n│  - CustomerService                                 │\\\\n│  - CustomerGroupService                            │\\\\n│  - CustomerLifecycleService                        │\\\\n│  - RFMAnalysisService                             │\\\\n│  - ChurnPredictionService                         │\\\\n├─────────────────────────────────────────────────────────┤\\\\n│  数据访问层 (Repositories)                          │\\\\n│  - CustomerRepository                              │\\\\n│  - CustomerGroupRepository                         │\\\\n│  - CustomerLifecycleRepository                    │\\\\n├─────────────────────────────────────────────────────────┤\\\\n│                   数据层 (PostgreSQL)                │\\\\n├─────────────────────────────────────────────────────────┤\\\\n│  - customers                                       │\\\\n│  - customer_groups                                 │\\\\n│  - customer_group_members                          │\\\\n│  - customer_tags                                  │\\\\n│  - customer_tag_relations                         │\\\\n│  - customer_lifecycle                             │\\\\n│  - lifecycle_stage_history                        │\\\\n│  - lifecycle_rules                               │\\\\n│  - rfm_scores                                    │\\\\n│  - care_reminders                                │\\\\n│  - churn_predictions                             │\\\\n└─────────────────────────────────────────────────────────┘\\\\n```\\\\n\\\\n### 2.2 目录结构\\\\n\\\\n```\\\\nfrontend/apps/admin-dashboard/src/\\\\n├── api/\\\\n│   └── customer.ts                    # 客户管理API接口\\\\n├── composables/\\\\n│   ├── useLifecycleRuleEngine.ts       # 生命周期规则引擎\\\\n│   ├── useRFMModel.ts               # RFM客户价值评估模型\\\\n│   ├── useCareReminder.ts           # 智能客户关怀提醒\\\\n│   └── useChurnPrediction.ts        # 客户流失预测\\\\n├── views/\\\\n│   ├── CustomerStatusTracker.vue     # 客户状态跟踪组件\\\\n│   ├── CustomerHistoryQuery.vue      # 客户历史查询组件\\\\n│   ├── CustomerGroupManagement.vue   # 客户分群管理组件\\\\n│   └── CustomerLifecycleDashboard.vue  # 生命周期数据分析看板\\\\n└── types/\\\\n    └── customer.ts                  # 客户相关类型定义\\\\n```\\\\n\\\\n---\\\\n\\\\n## 3. 数据模型\\\\n\\\\n### 3.1 客户表 (customers)\\\\n\\\\n```sql\\\\nCREATE TABLE customers (\\\\n    id VARCHAR(36) PRIMARY KEY,\\\\n    name VARCHAR(100) NOT NULL,\\\\n    phone VARCHAR(20) NOT NULL UNIQUE,\\\\n    email VARCHAR(100),\\\\n    gender VARCHAR(10) CHECK (gender IN (\\\\'male\\\\', \\\\'female\\\\', \\\\'other\\\\')),\\\\n    birthday DATE,\\\\n    avatar VARCHAR(255),\\\\n    member_level_id VARCHAR(36),\\\\n    points INT NOT NULL DEFAULT 0,\\\\n    total_spent DECIMAL(10,2) NOT NULL DEFAULT 0.00,\\\\n    total_orders INT NOT NULL DEFAULT 0,\\\\n    last_visit_at TIMESTAMP,\\\\n    last_order_at TIMESTAMP,\\\\n    status VARCHAR(20) NOT NULL DEFAULT \\\\'active\\\\' CHECK (status IN (\\\\'active\\\\', \\\\'inactive\\\\', \\\\'blacklisted\\\\')),\\\\n    source VARCHAR(50),\\\\n    register_ip VARCHAR(50),\\\\n    register_device VARCHAR(100),\\\\n    metadata JSONB,\\\\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\\\n    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\\\\n);\\\\n```\\\\n\\\\n### 3.2 客户分群表 (customer_groups)\\\\n\\\\n```sql\\\\nCREATE TABLE customer_groups (\\\\n    id VARCHAR(36) PRIMARY KEY,\\\\n    name VARCHAR(100) NOT NULL,\\\\n    description TEXT,\\\\n    group_type VARCHAR(50) NOT NULL CHECK (group_type IN (\\\\'manual\\\\', \\\\'auto\\\\', \\\\'rfm\\\\', \\\\'lifecycle\\\\')),\\\\n    conditions JSONB,\\\\n    color VARCHAR(20) DEFAULT \\\\'#409EFF\\\\',\\\\n    icon VARCHAR(50),\\\\n    priority INT NOT NULL DEFAULT 0,\\\\n    member_count INT NOT NULL DEFAULT 0,\\\\n    enabled BOOLEAN NOT NULL DEFAULT true,\\\\n    created_by VARCHAR(36),\\\\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\\\n    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\\\\n);\\\\n```\\\\n\\\\n### 3.3 客户标签表 (customer_tags)\\\\n\\\\n```sql\\\\nCREATE TABLE customer_tags (\\\\n    id VARCHAR(36) PRIMARY KEY,\\\\n    name VARCHAR(50) NOT NULL,\\\\n    description TEXT,\\\\n    color VARCHAR(20) DEFAULT \\\\'#67C23A\\\\',\\\\n    tag_type VARCHAR(50) NOT NULL CHECK (tag_type IN (\\\\'behavior\\\\', \\\\'preference\\\\', \\\\'custom\\\\', \\\\'system\\\\')),\\\\n    usage_count INT NOT NULL DEFAULT 0,\\\\n    created_by VARCHAR(36),\\\\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\\\n    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\\\\n);\\\\n```\\\\n\\\\n### 3.4 客户生命周期表 (customer_lifecycle)\\\\n\\\\n```sql\\\\nCREATE TABLE customer_lifecycle (\\\\n    id VARCHAR(36) PRIMARY KEY,\\\\n    customer_id VARCHAR(36) NOT NULL,\\\\n    current_stage VARCHAR(50) NOT NULL,\\\\n    previous_stage VARCHAR(50),\\\\n    stage_changed_at TIMESTAMP NOT NULL,\\\\n    days_in_current_stage INT NOT NULL DEFAULT 0,\\\\n    total_days_in_lifecycle INT NOT NULL DEFAULT 0,\\\\n    metadata JSONB,\\\\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\\\n    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\\\n    FOREIGN KEY (customer_id) REFERENCES customers(id) ON DELETE CASCADE\\\\n);\\\\n```\\\\n\\\\n### 3.5 RFM评分表 (rfm_scores)\\\\n\\\\n```sql\\\\nCREATE TABLE rfm_scores (\\\\n    id VARCHAR(36) PRIMARY KEY,\\\\n    customer_id VARCHAR(36) NOT NULL,\\\\n    recency_score INT NOT NULL,\\\\n    frequency_score INT NOT NULL,\\\\n    monetary_score INT NOT NULL,\\\\n    rfm_score INT NOT NULL,\\\\n    customer_level VARCHAR(20) NOT NULL,\\\\n    calculated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\\\n    FOREIGN KEY (customer_id) REFERENCES customers(id) ON DELETE CASCADE\\\\n);\\\\n```\\\\n\\\\n---\\\\n\\\\n## 4. API接口\\\\n\\\\n### 4.1 客户管理接口\\\\n\\\\n#### 4.1.1 获取客户列表\\\\n\\\\n```typescript\\\\nGET /api/customers\\\\n```\\\\n\\\\n**请求参数**：\\\\n\\\\n| 参数名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| keyword | string | 否 | 关键词搜索 |\\\\n| phone | string | 否 | 手机号 |\\\\n| email | string | 否 | 邮箱 |\\\\n| status | string | 否 | 状态 |\\\\n| page | number | 否 | 页码 |\\\\n| size | number | 否 | 每页数量 |\\\\n\\\\n**响应示例**：\\\\n\\\\n```json\\\\n{\\\\n  \\\\\\\"code\\\\\\\": 200,\\\\n  \\\\\\\"message\\\\\\\": \\\\\\\"success\\\\\\\",\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"data\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"id\\\\\\\": \\\\\\\"xxx\\\\\\\",\\\\n        \\\\\\\"name\\\\\\\": \\\\\\\"张三\\\\\\\",\\\\n        \\\\\\\"phone\\\\\\\": \\\\\\\"13800138000\\\\\\\",\\\\n        \\\\\\\"email\\\\\\\": \\\\\\\"zhangsan@example.com\\\\\\\",\\\\n        \\\\\\\"status\\\\\\\": \\\\\\\"active\\\\\\\",\\\\n        \\\\\\\"totalSpent\\\\\\\": 1000.00,\\\\n        \\\\\\\"totalOrders\\\\\\\": 10,\\\\n        \\\\\\\"points\\\\\\\": 500,\\\\n        \\\\\\\"createdAt\\\\\\\": \\\\\\\"2026-01-01T00:00:00Z\\\\\\\"\\\\n      }\\\\n    ],\\\\n    \\\\\\\"total\\\\\\\": 100\\\\n  }\\\\n}\\\\n```\\\\n\\\\n#### 4.1.2 获取客户详情\\\\n\\\\n```typescript\\\\nGET /api/customers/:id\\\\n```\\\\n\\\\n**路径参数**：\\\\n\\\\n| 参数名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | string | 是 | 客户ID |\\\\n\\\\n**响应示例**：\\\\n\\\\n```json\\\\n{\\\\n  \\\\\\\"code\\\\\\\": 200,\\\\n  \\\\\\\"message\\\\\\\": \\\\\\\"success\\\\\\\",\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"id\\\\\\\": \\\\\\\"xxx\\\\\\\",\\\\n    \\\\\\\"name\\\\\\\": \\\\\\\"张三\\\\\\\",\\\\n    \\\\\\\"phone\\\\\\\": \\\\\\\"13800138000\\\\\\\",\\\\n    \\\\\\\"email\\\\\\\": \\\\\\\"zhangsan@example.com\\\\\\\",\\\\n    \\\\\\\"status\\\\\\\": \\\\\\\"active\\\\\\\",\\\\n    \\\\\\\"totalSpent\\\\\\\": 1000.00,\\\\n    \\\\\\\"totalOrders\\\\\\\": 10,\\\\n    \\\\\\\"points\\\\\\\": 500,\\\\n    \\\\\\\"createdAt\\\\\\\": \\\\\\\"2026-01-01T00:00:00Z\\\\\\\"\\\\n  }\\\\n}\\\\n```\\\\n\\\\n#### 4.1.3 创建客户\\\\n\\\\n```typescript\\\\nPOST /api/customers\\\\n```\\\\n\\\\n**请求体**：\\\\n\\\\n```json\\\\n{\\\\n  \\\\\\\"name\\\\\\\": \\\\\\\"张三\\\\\\\",\\\\n  \\\\\\\"phone\\\\\\\": \\\\\\\"13800138000\\\\\\\",\\\\n  \\\\\\\"email\\\\\\\": \\\\\\\"zhangsan@example.com\\\\\\\",\\\\n  \\\\\\\"gender\\\\\\\": \\\\\\\"male\\\\\\\",\\\\n  \\\\\\\"birthday\\\\\\\": \\\\\\\"1990-01-01\\\\\\\"\\\\n}\\\\n```\\\\n\\\\n**响应示例**：\\\\n\\\\n```json\\\\n{\\\\n  \\\\\\\"code\\\\\\\": 200,\\\\n  \\\\\\\"message\\\\\\\": \\\\\\\"创建成功\\\\\\\",\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"id\\\\\\\": \\\\\\\"xxx\\\\\\\",\\\\n    \\\\\\\"name\\\\\\\": \\\\\\\"张三\\\\\\\",\\\\n    \\\\\\\"phone\\\\\\\": \\\\\\\"13800138000\\\\\\\",\\\\n    \\\\\\\"email\\\\\\\": \\\\\\\"zhangsan@example.com\\\\\\\",\\\\n    \\\\\\\"status\\\\\\\": \\\\\\\"active\\\\\\\",\\\\n    \\\\\\\"createdAt\\\\\\\": \\\\\\\"2026-01-20T00:00:00Z\\\\\\\"\\\\n  }\\\\n}\\\\n```\\\\n\\\\n#### 4.1.4 更新客户\\\\n\\\\n```typescript\\\\nPUT /api/customers/:id\\\\n```\\\\n\\\\n**路径参数**：\\\\n\\\\n| 参数名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | string | 是 | 客户ID |\\\\n\\\\n**请求体**：\\\\n\\\\n```json\\\\n{\\\\n  \\\\\\\"name\\\\\\\": \\\\\\\"张三\\\\\\\",\\\\n  \\\\\\\"email\\\\\\\": \\\\\\\"zhangsan_new@example.com\\\\\\\"\\\\n}\\\\n```\\\\n\\\\n**响应示例**：\\\\n\\\\n```json\\\\n{\\\\n  \\\\\\\"code\\\\\\\": 200,\\\\n  \\\\\\\"message\\\\\\\": \\\\\\\"更新成功\\\\\\\",\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"id\\\\\\\": \\\\\\\"xxx\\\\\\\",\\\\n    \\\\\\\"name\\\\\\\": \\\\\\\"张三\\\\\\\",\\\\n    \\\\\\\"email\\\\\\\": \\\\\\\"zhangsan_new@example.com\\\\\\\"\\\\n  }\\\\n}\\\\n```\\\\n\\\\n#### 4.1.5 删除客户\\\\n\\\\n```typescript\\\\nDELETE /api/customers/:id\\\\n```\\\\n\\\\n**路径参数**：\\\\n\\\\n| 参数名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | string | 是 | 客户ID |\\\\n\\\\n**响应示例**：\\\\n\\\\n```json\\\\n{\\\\n  \\\\\\\"code\\\\\\\": 200,\\\\n  \\\\\\\"message\\\\\\\": \\\\\\\"删除成功\\\\\\\"\\\\n}\\\\n```\\\\n\\\\n### 4.2 客户分群接口\\\\n\\\\n#### 4.2.1 获取客户分群列表\\\\n\\\\n```typescript\\\\nGET /api/customer-groups\\\\n```\\\\n\\\\n**请求参数**：\\\\n\\\\n| 参数名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| groupType | string | 否 | 分群类型 |\\\\n| enabled | boolean | 否 | 是否启用 |\\\\n| page | number | 否 | 页码 |\\\\n| size | number | 否 | 每页数量 |\\\\n\\\\n**响应示例**：\\\\n\\\\n```json\\\\n{\\\\n  \\\\\\\"code\\\\\\\": 200,\\\\n  \\\\\\\"message\\\\\\\": \\\\\\\"success\\\\\\\",\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"data\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"id\\\\\\\": \\\\\\\"xxx\\\\\\\",\\\\n        \\\\\\\"name\\\\\\\": \\\\\\\"高价值客户\\\\\\\",\\\\n        \\\\\\\"groupType\\\\\\\": \\\\\\\"rfm\\\\\\\",\\\\n        \\\\\\\"memberCount\\\\\\\": 100,\\\\n        \\\\\\\"enabled\\\\\\\": true,\\\\n        \\\\\\\"createdAt\\\\\\\": \\\\\\\"2026-01-01T00:00:00Z\\\\\\\"\\\\n      }\\\\n    ],\\\\n    \\\\\\\"total\\\\\\\": 10\\\\n  }\\\\n}\\\\n```\\\\n\\\\n#### 4.2.2 创建客户分群\\\\n\\\\n```typescript\\\\nPOST /api/customer-groups\\\\n```\\\\n\\\\n**请求体**：\\\\n\\\\n```json\\\\n{\\\\n  \\\\\\\"name\\\\\\\": \\\\\\\"高价值客户\\\\\\\",\\\\n  \\\\\\\"description\\\\\\\": \\\\\\\"RFM评分大于等于4的客户\\\\\\\",\\\\n  \\\\\\\"groupType\\\\\\\": \\\\\\\"rfm\\\\\\\",\\\\n  \\\\\\\"color\\\\\\\": \\\\\\\"#409EFF\\\\\\\",\\\\n  \\\\\\\"priority\\\\\\\": 1,\\\\n  \\\\\\\"enabled\\\\\\\": true\\\\n}\\\\n```\\\\n\\\\n**响应示例**：\\\\n\\\\n```json\\\\n{\\\\n  \\\\\\\"code\\\\\\\": 200,\\\\n  \\\\\\\"message\\\\\\\": \\\\\\\"创建成功\\\\\\\",\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"id\\\\\\\": \\\\\\\"xxx\\\\\\\",\\\\n    \\\\\\\"name\\\\\\\": \\\\\\\"高价值客户\\\\\\\",\\\\n    \\\\\\\"groupType\\\\\\\": \\\\\\\"rfm\\\\\\\",\\\\n    \\\\\\\"memberCount\\\\\\\": 0,\\\\n    \\\\\\\"enabled\\\\\\\": true,\\\\n    \\\\\\\"createdAt\\\\\\\": \\\\\\\"2026-01-20T00:00:00Z\\\\\\\"\\\\n  }\\\\n}\\\\n```\\\\n\\\\n### 4.3 客户生命周期接口\\\\n\\\\n#### 4.3.1 获取客户生命周期信息\\\\n\\\\n```typescript\\\\nGET /api/customers/:id/lifecycle\\\\n```\\\\n\\\\n**路径参数**：\\\\n\\\\n| 参数名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | string | 是 | 客户ID |\\\\n\\\\n**响应示例**：\\\\n\\\\n```json\\\\n{\\\\n  \\\\\\\"code\\\\\\\": 200,\\\\n  \\\\\\\"message\\\\\\\": \\\\\\\"success\\\\\\\",\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"id\\\\\\\": \\\\\\\"xxx\\\\\\\",\\\\n    \\\\\\\"customerId\\\\\\\": \\\\\\\"xxx\\\\\\\",\\\\n    \\\\\\\"currentStage\\\\\\\": \\\\\\\"active\\\\\\\",\\\\n    \\\\\\\"previousStage\\\\\\\": \\\\\\\"new\\\\\\\",\\\\n    \\\\\\\"stageChangedAt\\\\\\\": \\\\\\\"2026-01-15T00:00:00Z\\\\\\\",\\\\n    \\\\\\\"daysInCurrentStage\\\\\\\": 5,\\\\n    \\\\\\\"totalDaysInLifecycle\\\\\\\": 30\\\\n  }\\\\n}\\\\n```\\\\n\\\\n#### 4.3.2 更新客户生命周期阶段\\\\n\\\\n```typescript\\\\nPUT /api/customers/:id/lifecycle/stage\\\\n```\\\\n\\\\n**路径参数**：\\\\n\\\\n| 参数名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | string | 是 | 客户ID |\\\\n\\\\n**请求体**：\\\\n\\\\n```json\\\\n{\\\\n  \\\\\\\"stage\\\\\\\": \\\\\\\"loyal\\\\\\\",\\\\n  \\\\\\\"reason\\\\\\\": \\\\\\\"客户消费频次和金额达到忠诚客户标准\\\\\\\"\\\\n}\\\\n```\\\\n\\\\n**响应示例**：\\\\n\\\\n```json\\\\n{\\\\n  \\\\\\\"code\\\\\\\": 200,\\\\n  \\\\\\\"message\\\\\\\": \\\\\\\"更新成功\\\\\\\",\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"id\\\\\\\": \\\\\\\"xxx\\\\\\\",\\\\n    \\\\\\\"currentStage\\\\\\\": \\\\\\\"loyal\\\\\\\",\\\\n    \\\\\\\"stageChangedAt\\\\\\\": \\\\\\\"2026-01-20T00:00:00Z\\\\\\\"\\\\n  }\\\\n}\\\\n```\\\\n\\\\n### 4.4 RFM分析接口\\\\n\\\\n#### 4.4.1 计算客户RFM评分\\\\n\\\\n```typescript\\\\nPOST /api/rfm/calculate\\\\n```\\\\n\\\\n**请求体**：\\\\n\\\\n```json\\\\n{\\\\n  \\\\\\\"customerIds\\\\\\\": [\\\\\\\"xxx\\\\\\\", \\\\\\\"yyy\\\\\\\"]\\\\n}\\\\n```\\\\n\\\\n**响应示例**：\\\\n\\\\n```json\\\\n{\\\\n  \\\\\\\"code\\\\\\\": 200,\\\\n  \\\\\\\"message\\\\\\\": \\\\\\\"计算成功\\\\\\\",\\\\n  \\\\\\\"data\\\\\\\": [\\\\n    {\\\\n      \\\\\\\"customerId\\\\\\\": \\\\\\\"xxx\\\\\\\",\\\\n      \\\\\\\"recencyScore\\\\\\\": 5,\\\\n      \\\\\\\"frequencyScore\\\\\\\": 4,\\\\n      \\\\\\\"monetaryScore\\\\\\\": 5,\\\\n      \\\\\\\"rfmScore\\\\\\\": 14,\\\\n      \\\\\\\"customerLevel\\\\\\\": \\\\\\\"超级VIP\\\\\\\"\\\\n    }\\\\n  ]\\\\n}\\\\n```\\\\n\\\\n### 4.5 流失预测接口\\\\n\\\\n#### 4.5.1 预测客户流失\\\\n\\\\n```typescript\\\\nPOST /api/churn-predictions/predict\\\\n```\\\\n\\\\n**请求体**：\\\\n\\\\n```json\\\\n{\\\\n  \\\\\\\"customerIds\\\\\\\": [\\\\\\\"xxx\\\\\\\", \\\\\\\"yyy\\\\\\\"]\\\\n}\\\\n```\\\\n\\\\n**响应示例**：\\\\n\\\\n```json\\\\n{\\\\n  \\\\\\\"code\\\\\\\": 200,\\\\n  \\\\\\\"message\\\\\\\": \\\\\\\"预测成功\\\\\\\",\\\\n  \\\\\\\"data\\\\\\\": [\\\\n    {\\\\n      \\\\\\\"customerId\\\\\\\": \\\\\\\"xxx\\\\\\\",\\\\n      \\\\\\\"customerName\\\\\\\": \\\\\\\"张三\\\\\\\",\\\\n      \\\\\\\"churnProbability\\\\\\\": 0.75,\\\\n      \\\\\\\"riskLevel\\\\\\\": \\\\\\\"high\\\\\\\",\\\\n      \\\\\\\"riskFactors\\\\\\\": [\\\\\\\"60天未消费\\\\\\\", \\\\\\\"消费频次下降50%\\\\\\\"],\\\\n      \\\\\\\"predictedChurnDate\\\\\\\": \\\\\\\"2026-03-20T00:00:00Z\\\\\\\"\\\\n    }\\\\n  ]\\\\n}\\\\n```\\\\n\\\\n---\\\\n\\\\n## 5. 组件设计\\\\n\\\\n### 5.1 CustomerStatusTracker.vue\\\\n\\\\n#### 5.1.1 组件说明\\\\n\\\\n客户状态跟踪组件，用于实时监控客户状态变化，支持状态修改和历史查询。\\\\n\\\\n#### 5.1.2 主要功能\\\\n\\\\n- 状态统计展示\\\\n- 客户列表查询\\\\n- 客户状态修改\\\\n- 客户状态历史查询\\\\n\\\\n#### 5.1.3 组件结构\\\\n\\\\n```vue\\\\n<template>\\\\n  <div class=\\\\\\\"customer-status-tracker\\\\\\\">\\\\n    <!-- 状态统计卡片 -->\\\\n    <el-card class=\\\\\\\"status-card\\\\\\\">\\\\n      <div class=\\\\\\\"status-overview\\\\\\\">\\\\n        <div class=\\\\\\\"status-item active\\\\\\\">\\\\n          <div class=\\\\\\\"status-count\\\\\\\">{{ statistics.active }}</div>\\\\n          <div class=\\\\\\\"status-label\\\\\\\">活跃客户</div>\\\\n        </div>\\\\n        <!-- 其他状态统计 -->\\\\n      </div>\\\\n    </el-card>\\\\n\\\\n    <!-- 筛选条件 -->\\\\n    <el-card class=\\\\\\\"filter-card\\\\\\\">\\\\n      <el-form :model=\\\\\\\"filters\\\\\\\" inline>\\\\n        <!-- 筛选表单 -->\\\\n      </el-form>\\\\n    </el-card>\\\\n\\\\n    <!-- 客户列表 -->\\\\n    <el-card class=\\\\\\\"table-card\\\\\\\">\\\\n      <el-table :data=\\\\\\\"customerList\\\\\\\">\\\\n        <!-- 表格列 -->\\\\n      </el-table>\\\\n    </el-card>\\\\n\\\\n    <!-- 状态修改对话框 -->\\\\n    <el-dialog v-model=\\\\\\\"statusDialogVisible\\\\\\\">\\\\n      <!-- 状态修改表单 -->\\\\n    </el-dialog>\\\\n\\\\n    <!-- 状态历史对话框 -->\\\\n    <el-dialog v-model=\\\\\\\"historyDialogVisible\\\\\\\">\\\\n      <!-- 状态历史表格 -->\\\\n    </el-dialog>\\\\n  </div>\\\\n</template>\\\\n```\\\\n\\\\n#### 5.1.4 核心方法\\\\n\\\\n```typescript\\\\nconst loadStatistics = async () => {\\\\n  const data = await getCustomerStatistics()\\\\n  Object.assign(statistics, data)\\\\n}\\\\n\\\\nconst loadCustomerList = async () => {\\\\n  const result = await getCustomers(params)\\\\n  customerList.value = result.data\\\\n  pagination.total = result.total\\\\n}\\\\n\\\\nconst handleChangeStatus = (row: Customer) => {\\\\n  statusForm.customerId = row.id\\\\n  statusForm.currentStatus = row.status\\\\n  statusDialogVisible.value = true\\\\n}\\\\n\\\\nconst handleStatusSubmit = async () => {\\\\n  await updateCustomerStatus(statusForm.customerId, statusForm.newStatus)\\\\n  ElMessage.success(\\\\'状态修改成功\\\\')\\\\n  refreshData()\\\\n}\\\\n```\\\\n\\\\n### 5.2 CustomerHistoryQuery.vue\\\\n\\\\n#### 5.2.1 组件说明\\\\n\\\\n客户历史查询组件，用于查询客户的订单历史、积分历史、状态历史、访问记录等。\\\\n\\\\n#### 5.2.2 主要功能\\\\n\\\\n- 客户基本信息展示\\\\n- 订单历史查询\\\\n- 积分历史查询\\\\n- 状态历史查询\\\\n- 访问记录查询\\\\n\\\\n#### 5.2.3 组件结构\\\\n\\\\n```vue\\\\n<template>\\\\n  <div class=\\\\\\\"customer-history-query\\\\\\\">\\\\n    <!-- 客户信息卡片 -->\\\\n    <el-card class=\\\\\\\"customer-info-card\\\\\\\">\\\\n      <div class=\\\\\\\"customer-info\\\\\\\">\\\\n        <!-- 客户基本信息 -->\\\\n      </div>\\\\n    </el-card>\\\\n\\\\n    <!-- 历史记录标签页 -->\\\\n    <el-card class=\\\\\\\"history-tabs-card\\\\\\\">\\\\n      <el-tabs v-model=\\\\\\\"activeTab\\\\\\\">\\\\n        <el-tab-pane label=\\\\\\\"订单历史\\\\\\\" name=\\\\\\\"orders\\\\\\\">\\\\n          <!-- 订单历史表格 -->\\\\n        </el-tab-pane>\\\\n        <el-tab-pane label=\\\\\\\"积分历史\\\\\\\" name=\\\\\\\"points\\\\\\\">\\\\n          <!-- 积分历史表格 -->\\\\n        </el-tab-pane>\\\\n        <el-tab-pane label=\\\\\\\"状态历史\\\\\\\" name=\\\\\\\"status\\\\\\\">\\\\n          <!-- 状态历史表格 -->\\\\n        </el-tab-pane>\\\\n        <el-tab-pane label=\\\\\\\"访问记录\\\\\\\" name=\\\\\\\"visits\\\\\\\">\\\\n          <!-- 访问记录表格 -->\\\\n        </el-tab-pane>\\\\n      </el-tabs>\\\\n    </el-card>\\\\n  </div>\\\\n</template>\\\\n```\\\\n\\\\n### 5.3 CustomerGroupManagement.vue\\\\n\\\\n#### 5.3.1 组件说明\\\\n\\\\n客户分群管理组件，用于管理客户分群，支持创建、编辑、删除分群，以及分群成员管理。\\\\n\\\\n#### 5.3.2 主要功能\\\\n\\\\n- 分群统计展示\\\\n- 分群列表管理\\\\n- 分群创建和编辑\\\\n- 分群成员管理\\\\n- 批量添加和移除成员\\\\n\\\\n#### 5.3.3 组件结构\\\\n\\\\n```vue\\\\n<template>\\\\n  <div class=\\\\\\\"customer-group-management\\\\\\\">\\\\n    <!-- 统计卡片 -->\\\\n    <el-card class=\\\\\\\"statistics-card\\\\\\\">\\\\n      <div class=\\\\\\\"statistics-overview\\\\\\\">\\\\n        <!-- 统计数据 -->\\\\n      </div>\\\\n    </el-card>\\\\n\\\\n    <!-- 筛选条件 -->\\\\n    <el-card class=\\\\\\\"filter-card\\\\\\\">\\\\n      <el-form :model=\\\\\\\"filters\\\\\\\" inline>\\\\n        <!-- 筛选表单 -->\\\\n      </el-form>\\\\n    </el-card>\\\\n\\\\n    <!-- 分群列表 -->\\\\n    <el-card class=\\\\\\\"table-card\\\\\\\">\\\\n      <el-table :data=\\\\\\\"groupList\\\\\\\">\\\\n        <!-- 表格列 -->\\\\n      </el-table>\\\\n    </el-card>\\\\n\\\\n    <!-- 分群编辑对话框 -->\\\\n    <el-dialog v-model=\\\\\\\"groupDialogVisible\\\\\\\">\\\\n      <!-- 分群表单 -->\\\\n    </el-dialog>\\\\n\\\\n    <!-- 分群成员管理对话框 -->\\\\n    <el-dialog v-model=\\\\\\\"membersDialogVisible\\\\\\\">\\\\n      <!-- 成员列表 -->\\\\n    </el-dialog>\\\\n  </div>\\\\n</template>\\\\n```\\\\n\\\\n### 5.4 CustomerLifecycleDashboard.vue\\\\n\\\\n#### 5.4.1 组件说明\\\\n\\\\n客户生命周期数据分析看板，用于展示客户生命周期相关的数据分析和可视化图表。\\\\n\\\\n#### 5.4.2 主要功能\\\\n\\\\n- 生命周期阶段分布\\\\n- 客户价值分布（RFM）\\\\n- 生命周期流转趋势\\\\n- 客户留存率趋势\\\\n- 客户生命周期价值分布\\\\n- 流失预警管理\\\\n- 关怀提醒管理\\\\n\\\\n#### 5.4.3 组件结构\\\\n\\\\n```vue\\\\n<template>\\\\n  <div class=\\\\\\\"customer-lifecycle-dashboard\\\\\\\">\\\\n    <!-- 头部操作栏 -->\\\\n    <div class=\\\\\\\"dashboard-header\\\\\\\">\\\\n      <h1>客户生命周期管理看板</h1>\\\\n      <div class=\\\\\\\"header-actions\\\\\\\">\\\\n        <!-- 操作按钮 -->\\\\n      </div>\\\\n    </div>\\\\n\\\\n    <!-- 概览指标 -->\\\\n    <el-row :gutter=\\\\\\\"20\\\\\\\" class=\\\\\\\"metrics-row\\\\\\\">\\\\n      <el-col :span=\\\\\\\"4\\\\\\\" v-for=\\\\\\\"metric in overviewMetrics\\\\\\\">\\\\n        <el-card class=\\\\\\\"metric-card\\\\\\\">\\\\n          <!-- 指标卡片 -->\\\\n        </el-card>\\\\n      </el-col>\\\\n    </el-row>\\\\n\\\\n    <!-- 图表区域 -->\\\\n    <el-row :gutter=\\\\\\\"20\\\\\\\" class=\\\\\\\"charts-row\\\\\\\">\\\\n      <el-col :span=\\\\\\\"12\\\\\\\">\\\\n        <el-card class=\\\\\\\"chart-card\\\\\\\">\\\\n          <!-- 生命周期阶段分布图 -->\\\\n        </el-card>\\\\n      </el-col>\\\\n      <el-col :span=\\\\\\\"12\\\\\\\">\\\\n        <el-card class=\\\\\\\"chart-card\\\\\\\">\\\\n          <!-- 客户价值分布图 -->\\\\n        </el-card>\\\\n      </el-col>\\\\n    </el-row>\\\\n\\\\n    <!-- 流失预警和关怀提醒 -->\\\\n    <el-row :gutter=\\\\\\\"20\\\\\\\" class=\\\\\\\"alerts-row\\\\\\\">\\\\n      <el-col :span=\\\\\\\"12\\\\\\\">\\\\n        <el-card class=\\\\\\\"alert-card\\\\\\\">\\\\n          <!-- 流失预警列表 -->\\\\n        </el-card>\\\\n      </el-col>\\\\n      <el-col :span=\\\\\\\"12\\\\\\\">\\\\n        <el-card class=\\\\\\\"alert-card\\\\\\\">\\\\n          <!-- 关怀提醒列表 -->\\\\n        </el-card>\\\\n      </el-col>\\\\n    </el-row>\\\\n  </div>\\\\n</template>\\\\n```\\\\n\\\\n---\\\\n\\\\n## 6. 核心功能\\\\n\\\\n### 6.1 客户生命周期管理\\\\n\\\\n#### 6.1.1 生命周期阶段定义\\\\n\\\\n```typescript\\\\nexport const LIFECYCLE_STAGES = {\\\\n  POTENTIAL: \\\\'potential\\\\',\\\\n  NEW: \\\\'new\\\\',\\\\n  ACTIVE: \\\\'active\\\\',\\\\n  LOYAL: \\\\'loyal\\\\',\\\\n  DORMANT: \\\\'dormant\\\\',\\\\n  CHURNED: \\\\'churned\\\\'\\\\n} as const\\\\n```\\\\n\\\\n#### 6.1.2 阶段转换规则\\\\n\\\\n```typescript\\\\nexport const STAGE_TRANSITION_RULES = [\\\\n  {\\\\n    from: [LIFECYCLE_STAGES.POTENTIAL],\\\\n    to: LIFECYCLE_STAGES.NEW,\\\\n    condition: (customer: Customer) => {\\\\n      return customer.totalOrders > 0\\\\n    },\\\\n    reason: \\\\'首次下单\\\\'\\\\n  },\\\\n  {\\\\n    from: [LIFECYCLE_STAGES.NEW],\\\\n    to: LIFECYCLE_STAGES.ACTIVE,\\\\n    condition: (customer: Customer) => {\\\\n      const daysSinceFirstOrder = getDaysSince(customer.firstOrderAt)\\\\n      return daysSinceFirstOrder <= 30 && customer.totalOrders >= 2\\\\n    },\\\\n    reason: \\\\'30天内多次消费\\\\'\\\\n  },\\\\n  // 更多规则...\\\\n]\\\\n```\\\\n\\\\n### 6.2 RFM客户价值评估\\\\n\\\\n#### 6.2.1 RFM评分计算\\\\n\\\\n```typescript\\\\nclass RFMModel {\\\\n  calculateRFMScore(customer: Customer): RFMScore {\\\\n    const recencyScore = this.calculateRecencyScore(customer.lastOrderAt)\\\\n    const frequencyScore = this.calculateFrequencyScore(customer.totalOrders)\\\\n    const monetaryScore = this.calculateMonetaryScore(customer.totalSpent)\\\\n\\\\n    const rfmScore = recencyScore + frequencyScore + monetaryScore\\\\n    const customerLevel = this.getCustomerLevel(rfmScore)\\\\n\\\\n    return {\\\\n      customerId: customer.id,\\\\n      recencyScore,\\\\n      frequencyScore,\\\\n      monetaryScore,\\\\n      rfmScore,\\\\n      customerLevel,\\\\n      calculatedAt: new Date()\\\\n    }\\\\n  }\\\\n\\\\n  private calculateRecencyScore(lastOrderAt: Date): number {\\\\n    const daysSinceLastOrder = getDaysSince(lastOrderAt)\\\\n\\\\n    if (daysSinceLastOrder <= 7) return 5\\\\n    if (daysSinceLastOrder <= 14) return 4\\\\n    if (daysSinceLastOrder <= 30) return 3\\\\n    if (daysSinceLastOrder <= 60) return 2\\\\n    return 1\\\\n  }\\\\n\\\\n  private calculateFrequencyScore(totalOrders: number): number {\\\\n    if (totalOrders >= 20) return 5\\\\n    if (totalOrders >= 10) return 4\\\\n    if (totalOrders >= 5) return 3\\\\n    if (totalOrders >= 2) return 2\\\\n    return 1\\\\n  }\\\\n\\\\n  private calculateMonetaryScore(totalSpent: number): number {\\\\n    if (totalSpent >= 5000) return 5\\\\n    if (totalSpent >= 2000) return 4\\\\n    if (totalSpent >= 1000) return 3\\\\n    if (totalSpent >= 500) return 2\\\\n    return 1\\\\n  }\\\\n\\\\n  private getCustomerLevel(rfmScore: number): string {\\\\n    if (rfmScore >= 13) return \\\\'超级VIP\\\\'\\\\n    if (rfmScore >= 10) return \\\\'VIP\\\\'\\\\n    if (rfmScore >= 7) return \\\\'会员\\\\'\\\\n    if (rfmScore >= 4) return \\\\'普通\\\\'\\\\n    return \\\\'低价值\\\\'\\\\n  }\\\\n}\\\\n```\\\\n\\\\n### 6.3 客户流失预测\\\\n\\\\n#### 6.3.1 流失风险因素\\\\n\\\\n```typescript\\\\nclass ChurnPredictionModel {\\\\n  predictChurn(customer: Customer): ChurnPrediction {\\\\n    const riskFactors: string[] = []\\\\n    let churnProbability = 0\\\\n\\\\n    const daysSinceLastOrder = this.getDaysSince(customer.lastOrderAt)\\\\n    const frequencyDrop = this.calculateFrequencyDrop(customer)\\\\n    const spendingDrop = this.calculateSpendingDrop(customer)\\\\n\\\\n    if (this.isInactive(customer, 30)) {\\\\n      churnProbability += 0.2\\\\n      riskFactors.push(\\\\'30天未消费\\\\')\\\\n    }\\\\n\\\\n    if (this.isInactive(customer, 60)) {\\\\n      churnProbability += 0.3\\\\n      riskFactors.push(\\\\'60天未消费\\\\')\\\\n    }\\\\n\\\\n    if (frequencyDrop <= -0.5) {\\\\n      churnProbability += 0.25\\\\n      riskFactors.push(`消费频次下降${Math.abs(frequencyDrop * 100).toFixed(0)}%`)\\\\n    }\\\\n\\\\n    if (spendingDrop <= -0.5) {\\\\n      churnProbability += 0.15\\\\n      riskFactors.push(`消费金额下降${Math.abs(spendingDrop * 100).toFixed(0)}%`)\\\\n    }\\\\n\\\\n    if (customer.satisfactionScore < 3.5) {\\\\n      churnProbability += 0.1\\\\n      riskFactors.push(`满意度评分${customer.satisfactionScore}分`)\\\\n    }\\\\n\\\\n    churnProbability = Math.min(churnProbability, 1.0)\\\\n\\\\n    const riskLevel = this.getRiskLevel(churnProbability)\\\\n    const predictedChurnDate = this.predictChurnDate(churnProbability)\\\\n    const recommendations = this.generateRecommendations(riskFactors)\\\\n\\\\n    return {\\\\n      customerId: customer.id,\\\\n      customerName: customer.name,\\\\n      customerPhone: customer.phone,\\\\n      customerEmail: customer.email,\\\\n      churnProbability: Math.round(churnProbability * 100) / 100,\\\\n      riskLevel,\\\\n      riskFactors,\\\\n      predictedChurnDate,\\\\n      recommendations,\\\\n      assignedTo: null,\\\\n      status: \\\\'pending\\\\',\\\\n      createdAt: new Date(),\\\\n      updatedAt: new Date()\\\\n    }\\\\n  }\\\\n}\\\\n```\\\\n\\\\n### 6.4 智能客户关怀\\\\n\\\\n#### 6.4.1 关怀提醒生成\\\\n\\\\n```typescript\\\\nclass CareReminderEngine {\\\\n  generateReminders(customer: Customer): CareReminder[] {\\\\n    const reminders: CareReminder[] = []\\\\n\\\\n    const daysSinceLastOrder = this.getDaysSince(customer.lastOrderAt)\\\\n    const lifecycle = this.getCustomerLifecycle(customer.id)\\\\n\\\\n    if (daysSinceLastOrder === 7) {\\\\n      reminders.push({\\\\n        customerId: customer.id,\\\\n        reminderType: \\\\'revisit\\\\',\\\\n        title: \\\\'7天未消费关怀\\\\',\\\\n        content: \\\\'亲爱的${customer.name}，您已经7天没有光顾了，我们想念您！\\\\',\\\\n        priority: \\\\'medium\\\\',\\\\n        scheduledAt: new Date()\\\\n      })\\\\n    }\\\\n\\\\n    if (daysSinceLastOrder === 30) {\\\\n      reminders.push({\\\\n        customerId: customer.id,\\\\n        reminderType: \\\\'reactivation\\\\',\\\\n        title: \\\\'30天未消费关怀\\\\',\\\\n        content: \\\\'亲爱的${customer.name}，您已经30天没有光顾了，特为您准备了一份专属优惠券！\\\\',\\\\n        priority: \\\\'high\\\\',\\\\n        scheduledAt: new Date()\\\\n      })\\\\n    }\\\\n\\\\n    if (lifecycle.currentStage === \\\\'loyal\\\\') {\\\\n      reminders.push({\\\\n        customerId: customer.id,\\\\n        reminderType: \\\\'loyalty\\\\',\\\\n        title: \\\\'忠诚客户关怀\\\\',\\\\n        content: \\\\'亲爱的${customer.name}，感谢您一直以来的支持，特为您升级为VIP会员！\\\\',\\\\n        priority: \\\\'low\\\\',\\\\n        scheduledAt: new Date()\\\\n      })\\\\n    }\\\\n\\\\n    return reminders\\\\n  }\\\\n}\\\\n```\\\\n\\\\n---\\\\n\\\\n## 7. 开发指南\\\\n\\\\n### 7.1 环境搭建\\\\n\\\\n#### 7.1.1 前端环境\\\\n\\\\n```bash\\\\n# 安装依赖\\\\ncd frontend/apps/admin-dashboard\\\\nnpm install\\\\n\\\\n# 启动开发服务器\\\\nnpm run dev\\\\n\\\\n# 构建生产版本\\\\nnpm run build\\\\n```\\\\n\\\\n#### 7.1.2 后端环境\\\\n\\\\n```bash\\\\n# 安装依赖\\\\ncd backend\\\\nnpm install\\\\n\\\\n# 启动开发服务器\\\\nnpm run dev\\\\n\\\\n# 构建生产版本\\\\nnpm run build\\\\n```\\\\n\\\\n### 7.2 代码规范\\\\n\\\\n#### 7.2.1 命名规范\\\\n\\\\n- **文件名**：使用kebab-case，如 `customer-status-tracker.vue`\\\\n- **组件名**：使用PascalCase，如 `CustomerStatusTracker`\\\\n- **变量名**：使用camelCase，如 `customerList`\\\\n- **常量名**：使用UPPER_SNAKE_CASE，如 `LIFECYCLE_STAGES`\\\\n\\\\n#### 7.2.2 注释规范\\\\n\\\\n```typescript\\\\n/**\\\\n * @description 客户状态跟踪组件\\\\n * @author YYC\\\\n * @created 2026-01-20\\\\n */\\\\nexport const CustomerStatusTracker = defineComponent({\\\\n  // 组件实现\\\\n})\\\\n```\\\\n\\\\n### 7.3 Git工作流\\\\n\\\\n#### 7.3.1 分支策略\\\\n\\\\n- `main`：主分支，用于生产环境\\\\n- `develop`：开发分支，用于集成开发\\\\n- `feature/*`：功能分支，用于开发新功能\\\\n- `bugfix/*`：修复分支，用于修复bug\\\\n\\\\n#### 7.3.2 提交规范\\\\n\\\\n```\\\\nfeat: 添加客户分群管理功能\\\\nfix: 修复客户状态修改bug\\\\ndocs: 更新API文档\\\\nstyle: 调整代码格式\\\\nrefactor: 重构RFM计算逻辑\\\\ntest: 添加客户管理模块测试\\\\nchore: 更新依赖包\\\\n```\\\\n\\\\n### 7.4 调试技巧\\\\n\\\\n#### 7.4.1 前端调试\\\\n\\\\n1. 使用Chrome DevTools进行调试\\\\n2. 使用Vue DevTools查看组件状态\\\\n3. 使用console.log输出调试信息\\\\n\\\\n#### 7.4.2 后端调试\\\\n\\\\n1. 使用VS Code调试器\\\\n2. 使用Postman测试API接口\\\\n3. 查看服务器日志\\\\n\\\\n---\\\\n\\\\n## 8. 测试指南\\\\n\\\\n### 8.1 单元测试\\\\n\\\\n#### 8.1.1 测试框架\\\\n\\\\n- **前端**：Vitest + Vue Test Utils\\\\n- **后端**：Jest\\\\n\\\\n#### 8.1.2 测试示例\\\\n\\\\n```typescript\\\\ndescribe(\\\\'CustomerStatusTracker\\\\', () => {\\\\n  it(\\\\'应该正确加载客户统计数据\\\\', async () => {\\\\n    const wrapper = mount(CustomerStatusTracker)\\\\n    await wrapper.vm.loadStatistics()\\\\n    expect(wrapper.vm.statistics.active).toBeGreaterThan(0)\\\\n  })\\\\n\\\\n  it(\\\\'应该正确修改客户状态\\\\', async () => {\\\\n    const wrapper = mount(CustomerStatusTracker)\\\\n    await wrapper.vm.handleStatusSubmit()\\\\n    expect(wrapper.vm.statusDialogVisible).toBe(false)\\\\n  })\\\\n})\\\\n```\\\\n\\\\n### 8.2 集成测试\\\\n\\\\n#### 8.2.1 测试场景\\\\n\\\\n1. 客户创建到分群的完整流程\\\\n2. 客户生命周期自动流转\\\\n3. RFM评分计算和客户等级划分\\\\n4. 流失预测和预警处理\\\\n\\\\n### 8.3 E2E测试\\\\n\\\\n#### 8.3.1 测试框架\\\\n\\\\n- **Playwright**\\\\n\\\\n#### 8.3.2 测试示例\\\\n\\\\n```typescript\\\\ntest(\\\\'客户状态跟踪完整流程\\\\', async ({ page }) => {\\\\n  await page.goto(\\\\'/customer/status-tracker\\\\')\\\\n  await page.fill(\\\\'input[name=\\\\\\\"keyword\\\\\\\"]\\\\', \\\\'张三\\\\')\\\\n  await page.click(\\\\'button:has-text(\\\\\\\"搜索\\\\\\\")\\\\')\\\\n  await expect(page.locator(\\\\'table\\\\')).toBeVisible()\\\\n})\\\\n```\\\\n\\\\n---\\\\n\\\\n## 9. 部署指南\\\\n\\\\n### 9.1 前端部署\\\\n\\\\n#### 9.1.1 构建命令\\\\n\\\\n```bash\\\\nnpm run build\\\\n```\\\\n\\\\n#### 9.1.2 部署到Nginx\\\\n\\\\n```nginx\\\\nserver {\\\\n  listen 80;\\\\n  server_name admin.yyc3.com;\\\\n\\\\n  root /var/www/admin-dashboard/dist;\\\\n  index index.html;\\\\n\\\\n  location / {\\\\n    try_files $uri $uri/ /index.html;\\\\n  }\\\\n\\\\n  location /api {\\\\n    proxy_pass http://localhost:3006;\\\\n  }\\\\n}\\\\n```\\\\n\\\\n### 9.2 后端部署\\\\n\\\\n#### 9.2.1 环境变量\\\\n\\\\n```env\\\\nNODE_ENV=production\\\\nPORT=3006\\\\nDATABASE_URL=postgresql://user:password@localhost:5432/yyc3\\\\nJWT_SECRET=your-secret-key\\\\n```\\\\n\\\\n#### 9.2.2 使用PM2部署\\\\n\\\\n```bash\\\\nnpm install -g pm2\\\\npm2 start npm --name \\\\\\\"yyc3-api\\\\\\\" -- start\\\\npm2 save\\\\npm2 startup\\\\n```\\\\n\\\\n### 9.3 数据库部署\\\\n\\\\n#### 9.3.1 创建数据库\\\\n\\\\n```sql\\\\nCREATE DATABASE yyc3;\\\\n```\\\\n\\\\n#### 9.3.2 执行迁移\\\\n\\\\n```bash\\\\nnpm run migrate\\\\n```\\\\n\\\\n---\\\\n\\\\n## 10. 常见问题\\\\n\\\\n### 10.1 开发问题\\\\n\\\\n**Q：如何添加新的客户分群类型？**\\\\n\\\\nA：在`customer.ts`中的`CustomerGroup`接口中添加新的`groupType`值，并在数据库中添加相应的CHECK约束。\\\\n\\\\n**Q：如何修改RFM评分标准？**\\\\n\\\\nA：在`useRFMModel.ts`中修改`calculateRecencyScore`、`calculateFrequencyScore`、`calculateMonetaryScore`方法的评分逻辑。\\\\n\\\\n### 10.2 性能问题\\\\n\\\\n**Q：客户列表加载缓慢怎么办？**\\\\n\\\\nA：检查数据库索引是否正确创建，考虑添加分页和缓存机制。\\\\n\\\\n**Q：RFM计算耗时过长怎么办？**\\\\n\\\\nA：考虑使用后台任务异步计算，或使用缓存存储计算结果。\\\\n\\\\n### 10.3 部署问题\\\\n\\\\n**Q：部署后API接口404怎么办？**\\\\n\\\\nA：检查Nginx配置中的`proxy_pass`是否正确，确保后端服务正在运行。\\\\n\\\\n**Q：数据库连接失败怎么办？**\\\\n\\\\nA：检查数据库连接字符串是否正确，确保数据库服务正在运行，检查防火墙设置。\\\\n\\\\n---\\\\n\\\\n## 附录\\\\n\\\\n### A. 相关文档\\\\n\\\\n- [用户操作手册](./YYC3-Cater-用户操作手册.md)\\\\n- [API接口文档](./YYC3-Cater-接口文档/客户生命周期管理API接口文档.md)\\\\n- [数据模型设计文档](../../YYC3-CP-详细设计/041-YYC3-AICP-详细设计-数据模型设计文档.md)\\\\n\\\\n### B. 版本历史\\\\n\\\\n| 版本 | 日期 | 更新内容 |\\\\n|------|------|----------|\\\\n| v1.0.0 | 2026-01-20 | 初始版本 |\\\\n\\\\n---\\\\n\\\\n> 「***YanYuCloudCube***」\\\\n> 「***<admin@0379.email>***」\\\\n> 「***Words Initiate Quadrants, Language Serves as Core for the Future***」\\\\n> 「***All things converge in the cloud pivot; Deep stacks ignite a new era of intelligence***」\\\\n\",\"originAcceptText\":\"# YYC³餐饮行业智能化平台 - 客户管理模块开发文档\\n\\n## 文档信息\\n\\n| 项目 | 内容 |\\n|------|------|\\n| 文档名称 | YYC³餐饮行业智能化平台客户管理模块开发文档 |\\n| 文档版本 | v1.0.0 |\\n| 创建日期 | 2026-01-20 |\\n| 最后更新 | 2026-01-20 |\\n| 文档状态 | 正式版 |\\n\\n---\\n\\n## 目录\\n\\n1. [模块概述](#1-模块概述)\\n2. [技术架构](#2-技术架构)\\n3. [数据模型](#3-数据模型)\\n4. [API接口](#4-api接口)\\n5. [组件设计](#5-组件设计)\\n6. [核心功能](#6-核心功能)\\n7. [开发指南](#7-开发指南)\\n8. [测试指南](#8-测试指南)\\n9. [部署指南](#9-部署指南)\\n10. [常见问题](#10-常见问题)\\n\\n---\\n\\n## 1. 模块概述\\n\\n### 1.1 模块简介\\n\\n客户管理模块是YYC³餐饮行业智能化平台的核心模块之一，提供全方位的客户信息管理功能，包括客户基本信息管理、客户分群、客户标签、客户状态跟踪、客户历史查询、客户生命周期管理等功能。\\n\\n### 1.2 核心功能\\n\\n- **客户信息管理**：客户基本信息的增删改查\\n- **客户分群管理**：支持手动分群、自动分群、RFM分群、生命周期分群\\n- **客户标签管理**：为客户打标签，支持行为标签、偏好标签、自定义标签、系统标签\\n- **客户状态跟踪**：实时跟踪客户状态变化，记录状态历史\\n- **客户历史查询**：查询客户的订单历史、积分历史、状态历史、访问记录\\n- **客户生命周期管理**：基于RFM模型和规则引擎的自动生命周期管理\\n- **客户流失预测**：基于多种因素的客户流失预测\\n- **智能客户关怀**：基于规则的自动客户关怀提醒\\n\\n### 1.3 技术栈\\n\\n- **前端框架**：Vue 3 + TypeScript\\n- **UI组件库**：Element Plus\\n- **状态管理**：Pinia\\n- **HTTP客户端**：Axios\\n- **图表库**：ECharts\\n- **日期处理**：Day.js\\n\\n---\\n\\n## 2. 技术架构\\n\\n### 2.1 整体架构\\n\\n```\\n┌─────────────────────────────────────────────────────────┐\\n│                   前端层 (Vue 3)                    │\\n├─────────────────────────────────────────────────────────┤\\n│  视图层 (Views)                                    │\\n│  - CustomerStatusTracker.vue                          │\\n│  - CustomerHistoryQuery.vue                          │\\n│  - CustomerGroupManagement.vue                        │\\n│  - CustomerLifecycleDashboard.vue                     │\\n├─────────────────────────────────────────────────────────┤\\n│  业务逻辑层 (Composables)                           │\\n│  - useLifecycleRuleEngine.ts                        │\\n│  - useRFMModel.ts                                  │\\n│  - useCareReminder.ts                              │\\n│  - useChurnPrediction.ts                           │\\n├─────────────────────────────────────────────────────────┤\\n│  数据访问层 (API)                                   │\\n│  - customer.ts                                      │\\n├─────────────────────────────────────────────────────────┤\\n│                   后端层 (Node.js)                   │\\n├─────────────────────────────────────────────────────────┤\\n│  控制器层 (Controllers)                            │\\n│  - CustomerController                               │\\n│  - CustomerGroupController                          │\\n│  - CustomerTagController                            │\\n│  - CustomerLifecycleController                      │\\n├─────────────────────────────────────────────────────────┤\\n│  服务层 (Services)                                 │\\n│  - CustomerService                                 │\\n│  - CustomerGroupService                            │\\n│  - CustomerLifecycleService                        │\\n│  - RFMAnalysisService                             │\\n│  - ChurnPredictionService                         │\\n├─────────────────────────────────────────────────────────┤\\n│  数据访问层 (Repositories)                          │\\n│  - CustomerRepository                              │\\n│  - CustomerGroupRepository                         │\\n│  - CustomerLifecycleRepository                    │\\n├─────────────────────────────────────────────────────────┤\\n│                   数据层 (PostgreSQL)                │\\n├─────────────────────────────────────────────────────────┤\\n│  - customers                                       │\\n│  - customer_groups                                 │\\n│  - customer_group_members                          │\\n│  - customer_tags                                  │\\n│  - customer_tag_relations                         │\\n│  - customer_lifecycle                             │\\n│  - lifecycle_stage_history                        │\\n│  - lifecycle_rules                               │\\n│  - rfm_scores                                    │\\n│  - care_reminders                                │\\n│  - churn_predictions                             │\\n└─────────────────────────────────────────────────────────┘\\n```\\n\\n### 2.2 目录结构\\n\\n```\\nfrontend/apps/admin-dashboard/src/\\n├── api/\\n│   └── customer.ts                    # 客户管理API接口\\n├── composables/\\n│   ├── useLifecycleRuleEngine.ts       # 生命周期规则引擎\\n│   ├── useRFMModel.ts               # RFM客户价值评估模型\\n│   ├── useCareReminder.ts           # 智能客户关怀提醒\\n│   └── useChurnPrediction.ts        # 客户流失预测\\n├── views/\\n│   ├── CustomerStatusTracker.vue     # 客户状态跟踪组件\\n│   ├── CustomerHistoryQuery.vue      # 客户历史查询组件\\n│   ├── CustomerGroupManagement.vue   # 客户分群管理组件\\n│   └── CustomerLifecycleDashboard.vue  # 生命周期数据分析看板\\n└── types/\\n    └── customer.ts                  # 客户相关类型定义\\n```\\n\\n---\\n\\n## 3. 数据模型\\n\\n### 3.1 客户表 (customers)\\n\\n```sql\\nCREATE TABLE customers (\\n    id VARCHAR(36) PRIMARY KEY,\\n    name VARCHAR(100) NOT NULL,\\n    phone VARCHAR(20) NOT NULL UNIQUE,\\n    email VARCHAR(100),\\n    gender VARCHAR(10) CHECK (gender IN ('male', 'female', 'other')),\\n    birthday DATE,\\n    avatar VARCHAR(255),\\n    member_level_id VARCHAR(36),\\n    points INT NOT NULL DEFAULT 0,\\n    total_spent DECIMAL(10,2) NOT NULL DEFAULT 0.00,\\n    total_orders INT NOT NULL DEFAULT 0,\\n    last_visit_at TIMESTAMP,\\n    last_order_at TIMESTAMP,\\n    status VARCHAR(20) NOT NULL DEFAULT 'active' CHECK (status IN ('active', 'inactive', 'blacklisted')),\\n    source VARCHAR(50),\\n    register_ip VARCHAR(50),\\n    register_device VARCHAR(100),\\n    metadata JSONB,\\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\n    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\\n);\\n```\\n\\n### 3.2 客户分群表 (customer_groups)\\n\\n```sql\\nCREATE TABLE customer_groups (\\n    id VARCHAR(36) PRIMARY KEY,\\n    name VARCHAR(100) NOT NULL,\\n    description TEXT,\\n    group_type VARCHAR(50) NOT NULL CHECK (group_type IN ('manual', 'auto', 'rfm', 'lifecycle')),\\n    conditions JSONB,\\n    color VARCHAR(20) DEFAULT '#409EFF',\\n    icon VARCHAR(50),\\n    priority INT NOT NULL DEFAULT 0,\\n    member_count INT NOT NULL DEFAULT 0,\\n    enabled BOOLEAN NOT NULL DEFAULT true,\\n    created_by VARCHAR(36),\\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\n    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\\n);\\n```\\n\\n### 3.3 客户标签表 (customer_tags)\\n\\n```sql\\nCREATE TABLE customer_tags (\\n    id VARCHAR(36) PRIMARY KEY,\\n    name VARCHAR(50) NOT NULL,\\n    description TEXT,\\n    color VARCHAR(20) DEFAULT '#67C23A',\\n    tag_type VARCHAR(50) NOT NULL CHECK (tag_type IN ('behavior', 'preference', 'custom', 'system')),\\n    usage_count INT NOT NULL DEFAULT 0,\\n    created_by VARCHAR(36),\\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\n    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\\n);\\n```\\n\\n### 3.4 客户生命周期表 (customer_lifecycle)\\n\\n```sql\\nCREATE TABLE customer_lifecycle (\\n    id VARCHAR(36) PRIMARY KEY,\\n    customer_id VARCHAR(36) NOT NULL,\\n    current_stage VARCHAR(50) NOT NULL,\\n    previous_stage VARCHAR(50),\\n    stage_changed_at TIMESTAMP NOT NULL,\\n    days_in_current_stage INT NOT NULL DEFAULT 0,\\n    total_days_in_lifecycle INT NOT NULL DEFAULT 0,\\n    metadata JSONB,\\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\n    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\n    FOREIGN KEY (customer_id) REFERENCES customers(id) ON DELETE CASCADE\\n);\\n```\\n\\n### 3.5 RFM评分表 (rfm_scores)\\n\\n```sql\\nCREATE TABLE rfm_scores (\\n    id VARCHAR(36) PRIMARY KEY,\\n    customer_id VARCHAR(36) NOT NULL,\\n    recency_score INT NOT NULL,\\n    frequency_score INT NOT NULL,\\n    monetary_score INT NOT NULL,\\n    rfm_score INT NOT NULL,\\n    customer_level VARCHAR(20) NOT NULL,\\n    calculated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\n    FOREIGN KEY (customer_id) REFERENCES customers(id) ON DELETE CASCADE\\n);\\n```\\n\\n---\\n\\n## 4. API接口\\n\\n### 4.1 客户管理接口\\n\\n#### 4.1.1 获取客户列表\\n\\n```typescript\\nGET /api/customers\\n```\\n\\n**请求参数**：\\n\\n| 参数名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| keyword | string | 否 | 关键词搜索 |\\n| phone | string | 否 | 手机号 |\\n| email | string | 否 | 邮箱 |\\n| status | string | 否 | 状态 |\\n| page | number | 否 | 页码 |\\n| size | number | 否 | 每页数量 |\\n\\n**响应示例**：\\n\\n```json\\n{\\n  \\\"code\\\": 200,\\n  \\\"message\\\": \\\"success\\\",\\n  \\\"data\\\": {\\n    \\\"data\\\": [\\n      {\\n        \\\"id\\\": \\\"xxx\\\",\\n        \\\"name\\\": \\\"张三\\\",\\n        \\\"phone\\\": \\\"13800138000\\\",\\n        \\\"email\\\": \\\"zhangsan@example.com\\\",\\n        \\\"status\\\": \\\"active\\\",\\n        \\\"totalSpent\\\": 1000.00,\\n        \\\"totalOrders\\\": 10,\\n        \\\"points\\\": 500,\\n        \\\"createdAt\\\": \\\"2026-01-01T00:00:00Z\\\"\\n      }\\n    ],\\n    \\\"total\\\": 100\\n  }\\n}\\n```\\n\\n#### 4.1.2 获取客户详情\\n\\n```typescript\\nGET /api/customers/:id\\n```\\n\\n**路径参数**：\\n\\n| 参数名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | string | 是 | 客户ID |\\n\\n**响应示例**：\\n\\n```json\\n{\\n  \\\"code\\\": 200,\\n  \\\"message\\\": \\\"success\\\",\\n  \\\"data\\\": {\\n    \\\"id\\\": \\\"xxx\\\",\\n    \\\"name\\\": \\\"张三\\\",\\n    \\\"phone\\\": \\\"13800138000\\\",\\n    \\\"email\\\": \\\"zhangsan@example.com\\\",\\n    \\\"status\\\": \\\"active\\\",\\n    \\\"totalSpent\\\": 1000.00,\\n    \\\"totalOrders\\\": 10,\\n    \\\"points\\\": 500,\\n    \\\"createdAt\\\": \\\"2026-01-01T00:00:00Z\\\"\\n  }\\n}\\n```\\n\\n#### 4.1.3 创建客户\\n\\n```typescript\\nPOST /api/customers\\n```\\n\\n**请求体**：\\n\\n```json\\n{\\n  \\\"name\\\": \\\"张三\\\",\\n  \\\"phone\\\": \\\"13800138000\\\",\\n  \\\"email\\\": \\\"zhangsan@example.com\\\",\\n  \\\"gender\\\": \\\"male\\\",\\n  \\\"birthday\\\": \\\"1990-01-01\\\"\\n}\\n```\\n\\n**响应示例**：\\n\\n```json\\n{\\n  \\\"code\\\": 200,\\n  \\\"message\\\": \\\"创建成功\\\",\\n  \\\"data\\\": {\\n    \\\"id\\\": \\\"xxx\\\",\\n    \\\"name\\\": \\\"张三\\\",\\n    \\\"phone\\\": \\\"13800138000\\\",\\n    \\\"email\\\": \\\"zhangsan@example.com\\\",\\n    \\\"status\\\": \\\"active\\\",\\n    \\\"createdAt\\\": \\\"2026-01-20T00:00:00Z\\\"\\n  }\\n}\\n```\\n\\n#### 4.1.4 更新客户\\n\\n```typescript\\nPUT /api/customers/:id\\n```\\n\\n**路径参数**：\\n\\n| 参数名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | string | 是 | 客户ID |\\n\\n**请求体**：\\n\\n```json\\n{\\n  \\\"name\\\": \\\"张三\\\",\\n  \\\"email\\\": \\\"zhangsan_new@example.com\\\"\\n}\\n```\\n\\n**响应示例**：\\n\\n```json\\n{\\n  \\\"code\\\": 200,\\n  \\\"message\\\": \\\"更新成功\\\",\\n  \\\"data\\\": {\\n    \\\"id\\\": \\\"xxx\\\",\\n    \\\"name\\\": \\\"张三\\\",\\n    \\\"email\\\": \\\"zhangsan_new@example.com\\\"\\n  }\\n}\\n```\\n\\n#### 4.1.5 删除客户\\n\\n```typescript\\nDELETE /api/customers/:id\\n```\\n\\n**路径参数**：\\n\\n| 参数名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | string | 是 | 客户ID |\\n\\n**响应示例**：\\n\\n```json\\n{\\n  \\\"code\\\": 200,\\n  \\\"message\\\": \\\"删除成功\\\"\\n}\\n```\\n\\n### 4.2 客户分群接口\\n\\n#### 4.2.1 获取客户分群列表\\n\\n```typescript\\nGET /api/customer-groups\\n```\\n\\n**请求参数**：\\n\\n| 参数名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| groupType | string | 否 | 分群类型 |\\n| enabled | boolean | 否 | 是否启用 |\\n| page | number | 否 | 页码 |\\n| size | number | 否 | 每页数量 |\\n\\n**响应示例**：\\n\\n```json\\n{\\n  \\\"code\\\": 200,\\n  \\\"message\\\": \\\"success\\\",\\n  \\\"data\\\": {\\n    \\\"data\\\": [\\n      {\\n        \\\"id\\\": \\\"xxx\\\",\\n        \\\"name\\\": \\\"高价值客户\\\",\\n        \\\"groupType\\\": \\\"rfm\\\",\\n        \\\"memberCount\\\": 100,\\n        \\\"enabled\\\": true,\\n        \\\"createdAt\\\": \\\"2026-01-01T00:00:00Z\\\"\\n      }\\n    ],\\n    \\\"total\\\": 10\\n  }\\n}\\n```\\n\\n#### 4.2.2 创建客户分群\\n\\n```typescript\\nPOST /api/customer-groups\\n```\\n\\n**请求体**：\\n\\n```json\\n{\\n  \\\"name\\\": \\\"高价值客户\\\",\\n  \\\"description\\\": \\\"RFM评分大于等于4的客户\\\",\\n  \\\"groupType\\\": \\\"rfm\\\",\\n  \\\"color\\\": \\\"#409EFF\\\",\\n  \\\"priority\\\": 1,\\n  \\\"enabled\\\": true\\n}\\n```\\n\\n**响应示例**：\\n\\n```json\\n{\\n  \\\"code\\\": 200,\\n  \\\"message\\\": \\\"创建成功\\\",\\n  \\\"data\\\": {\\n    \\\"id\\\": \\\"xxx\\\",\\n    \\\"name\\\": \\\"高价值客户\\\",\\n    \\\"groupType\\\": \\\"rfm\\\",\\n    \\\"memberCount\\\": 0,\\n    \\\"enabled\\\": true,\\n    \\\"createdAt\\\": \\\"2026-01-20T00:00:00Z\\\"\\n  }\\n}\\n```\\n\\n### 4.3 客户生命周期接口\\n\\n#### 4.3.1 获取客户生命周期信息\\n\\n```typescript\\nGET /api/customers/:id/lifecycle\\n```\\n\\n**路径参数**：\\n\\n| 参数名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | string | 是 | 客户ID |\\n\\n**响应示例**：\\n\\n```json\\n{\\n  \\\"code\\\": 200,\\n  \\\"message\\\": \\\"success\\\",\\n  \\\"data\\\": {\\n    \\\"id\\\": \\\"xxx\\\",\\n    \\\"customerId\\\": \\\"xxx\\\",\\n    \\\"currentStage\\\": \\\"active\\\",\\n    \\\"previousStage\\\": \\\"new\\\",\\n    \\\"stageChangedAt\\\": \\\"2026-01-15T00:00:00Z\\\",\\n    \\\"daysInCurrentStage\\\": 5,\\n    \\\"totalDaysInLifecycle\\\": 30\\n  }\\n}\\n```\\n\\n#### 4.3.2 更新客户生命周期阶段\\n\\n```typescript\\nPUT /api/customers/:id/lifecycle/stage\\n```\\n\\n**路径参数**：\\n\\n| 参数名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | string | 是 | 客户ID |\\n\\n**请求体**：\\n\\n```json\\n{\\n  \\\"stage\\\": \\\"loyal\\\",\\n  \\\"reason\\\": \\\"客户消费频次和金额达到忠诚客户标准\\\"\\n}\\n```\\n\\n**响应示例**：\\n\\n```json\\n{\\n  \\\"code\\\": 200,\\n  \\\"message\\\": \\\"更新成功\\\",\\n  \\\"data\\\": {\\n    \\\"id\\\": \\\"xxx\\\",\\n    \\\"currentStage\\\": \\\"loyal\\\",\\n    \\\"stageChangedAt\\\": \\\"2026-01-20T00:00:00Z\\\"\\n  }\\n}\\n```\\n\\n### 4.4 RFM分析接口\\n\\n#### 4.4.1 计算客户RFM评分\\n\\n```typescript\\nPOST /api/rfm/calculate\\n```\\n\\n**请求体**：\\n\\n```json\\n{\\n  \\\"customerIds\\\": [\\\"xxx\\\", \\\"yyy\\\"]\\n}\\n```\\n\\n**响应示例**：\\n\\n```json\\n{\\n  \\\"code\\\": 200,\\n  \\\"message\\\": \\\"计算成功\\\",\\n  \\\"data\\\": [\\n    {\\n      \\\"customerId\\\": \\\"xxx\\\",\\n      \\\"recencyScore\\\": 5,\\n      \\\"frequencyScore\\\": 4,\\n      \\\"monetaryScore\\\": 5,\\n      \\\"rfmScore\\\": 14,\\n      \\\"customerLevel\\\": \\\"超级VIP\\\"\\n    }\\n  ]\\n}\\n```\\n\\n### 4.5 流失预测接口\\n\\n#### 4.5.1 预测客户流失\\n\\n```typescript\\nPOST /api/churn-predictions/predict\\n```\\n\\n**请求体**：\\n\\n```json\\n{\\n  \\\"customerIds\\\": [\\\"xxx\\\", \\\"yyy\\\"]\\n}\\n```\\n\\n**响应示例**：\\n\\n```json\\n{\\n  \\\"code\\\": 200,\\n  \\\"message\\\": \\\"预测成功\\\",\\n  \\\"data\\\": [\\n    {\\n      \\\"customerId\\\": \\\"xxx\\\",\\n      \\\"customerName\\\": \\\"张三\\\",\\n      \\\"churnProbability\\\": 0.75,\\n      \\\"riskLevel\\\": \\\"high\\\",\\n      \\\"riskFactors\\\": [\\\"60天未消费\\\", \\\"消费频次下降50%\\\"],\\n      \\\"predictedChurnDate\\\": \\\"2026-03-20T00:00:00Z\\\"\\n    }\\n  ]\\n}\\n```\\n\\n---\\n\\n## 5. 组件设计\\n\\n### 5.1 CustomerStatusTracker.vue\\n\\n#### 5.1.1 组件说明\\n\\n客户状态跟踪组件，用于实时监控客户状态变化，支持状态修改和历史查询。\\n\\n#### 5.1.2 主要功能\\n\\n- 状态统计展示\\n- 客户列表查询\\n- 客户状态修改\\n- 客户状态历史查询\\n\\n#### 5.1.3 组件结构\\n\\n```vue\\n<template>\\n  <div class=\\\"customer-status-tracker\\\">\\n    <!-- 状态统计卡片 -->\\n    <el-card class=\\\"status-card\\\">\\n      <div class=\\\"status-overview\\\">\\n        <div class=\\\"status-item active\\\">\\n          <div class=\\\"status-count\\\">{{ statistics.active }}</div>\\n          <div class=\\\"status-label\\\">活跃客户</div>\\n        </div>\\n        <!-- 其他状态统计 -->\\n      </div>\\n    </el-card>\\n\\n    <!-- 筛选条件 -->\\n    <el-card class=\\\"filter-card\\\">\\n      <el-form :model=\\\"filters\\\" inline>\\n        <!-- 筛选表单 -->\\n      </el-form>\\n    </el-card>\\n\\n    <!-- 客户列表 -->\\n    <el-card class=\\\"table-card\\\">\\n      <el-table :data=\\\"customerList\\\">\\n        <!-- 表格列 -->\\n      </el-table>\\n    </el-card>\\n\\n    <!-- 状态修改对话框 -->\\n    <el-dialog v-model=\\\"statusDialogVisible\\\">\\n      <!-- 状态修改表单 -->\\n    </el-dialog>\\n\\n    <!-- 状态历史对话框 -->\\n    <el-dialog v-model=\\\"historyDialogVisible\\\">\\n      <!-- 状态历史表格 -->\\n    </el-dialog>\\n  </div>\\n</template>\\n```\\n\\n#### 5.1.4 核心方法\\n\\n```typescript\\nconst loadStatistics = async () => {\\n  const data = await getCustomerStatistics()\\n  Object.assign(statistics, data)\\n}\\n\\nconst loadCustomerList = async () => {\\n  const result = await getCustomers(params)\\n  customerList.value = result.data\\n  pagination.total = result.total\\n}\\n\\nconst handleChangeStatus = (row: Customer) => {\\n  statusForm.customerId = row.id\\n  statusForm.currentStatus = row.status\\n  statusDialogVisible.value = true\\n}\\n\\nconst handleStatusSubmit = async () => {\\n  await updateCustomerStatus(statusForm.customerId, statusForm.newStatus)\\n  ElMessage.success('状态修改成功')\\n  refreshData()\\n}\\n```\\n\\n### 5.2 CustomerHistoryQuery.vue\\n\\n#### 5.2.1 组件说明\\n\\n客户历史查询组件，用于查询客户的订单历史、积分历史、状态历史、访问记录等。\\n\\n#### 5.2.2 主要功能\\n\\n- 客户基本信息展示\\n- 订单历史查询\\n- 积分历史查询\\n- 状态历史查询\\n- 访问记录查询\\n\\n#### 5.2.3 组件结构\\n\\n```vue\\n<template>\\n  <div class=\\\"customer-history-query\\\">\\n    <!-- 客户信息卡片 -->\\n    <el-card class=\\\"customer-info-card\\\">\\n      <div class=\\\"customer-info\\\">\\n        <!-- 客户基本信息 -->\\n      </div>\\n    </el-card>\\n\\n    <!-- 历史记录标签页 -->\\n    <el-card class=\\\"history-tabs-card\\\">\\n      <el-tabs v-model=\\\"activeTab\\\">\\n        <el-tab-pane label=\\\"订单历史\\\" name=\\\"orders\\\">\\n          <!-- 订单历史表格 -->\\n        </el-tab-pane>\\n        <el-tab-pane label=\\\"积分历史\\\" name=\\\"points\\\">\\n          <!-- 积分历史表格 -->\\n        </el-tab-pane>\\n        <el-tab-pane label=\\\"状态历史\\\" name=\\\"status\\\">\\n          <!-- 状态历史表格 -->\\n        </el-tab-pane>\\n        <el-tab-pane label=\\\"访问记录\\\" name=\\\"visits\\\">\\n          <!-- 访问记录表格 -->\\n        </el-tab-pane>\\n      </el-tabs>\\n    </el-card>\\n  </div>\\n</template>\\n```\\n\\n### 5.3 CustomerGroupManagement.vue\\n\\n#### 5.3.1 组件说明\\n\\n客户分群管理组件，用于管理客户分群，支持创建、编辑、删除分群，以及分群成员管理。\\n\\n#### 5.3.2 主要功能\\n\\n- 分群统计展示\\n- 分群列表管理\\n- 分群创建和编辑\\n- 分群成员管理\\n- 批量添加和移除成员\\n\\n#### 5.3.3 组件结构\\n\\n```vue\\n<template>\\n  <div class=\\\"customer-group-management\\\">\\n    <!-- 统计卡片 -->\\n    <el-card class=\\\"statistics-card\\\">\\n      <div class=\\\"statistics-overview\\\">\\n        <!-- 统计数据 -->\\n      </div>\\n    </el-card>\\n\\n    <!-- 筛选条件 -->\\n    <el-card class=\\\"filter-card\\\">\\n      <el-form :model=\\\"filters\\\" inline>\\n        <!-- 筛选表单 -->\\n      </el-form>\\n    </el-card>\\n\\n    <!-- 分群列表 -->\\n    <el-card class=\\\"table-card\\\">\\n      <el-table :data=\\\"groupList\\\">\\n        <!-- 表格列 -->\\n      </el-table>\\n    </el-card>\\n\\n    <!-- 分群编辑对话框 -->\\n    <el-dialog v-model=\\\"groupDialogVisible\\\">\\n      <!-- 分群表单 -->\\n    </el-dialog>\\n\\n    <!-- 分群成员管理对话框 -->\\n    <el-dialog v-model=\\\"membersDialogVisible\\\">\\n      <!-- 成员列表 -->\\n    </el-dialog>\\n  </div>\\n</template>\\n```\\n\\n### 5.4 CustomerLifecycleDashboard.vue\\n\\n#### 5.4.1 组件说明\\n\\n客户生命周期数据分析看板，用于展示客户生命周期相关的数据分析和可视化图表。\\n\\n#### 5.4.2 主要功能\\n\\n- 生命周期阶段分布\\n- 客户价值分布（RFM）\\n- 生命周期流转趋势\\n- 客户留存率趋势\\n- 客户生命周期价值分布\\n- 流失预警管理\\n- 关怀提醒管理\\n\\n#### 5.4.3 组件结构\\n\\n```vue\\n<template>\\n  <div class=\\\"customer-lifecycle-dashboard\\\">\\n    <!-- 头部操作栏 -->\\n    <div class=\\\"dashboard-header\\\">\\n      <h1>客户生命周期管理看板</h1>\\n      <div class=\\\"header-actions\\\">\\n        <!-- 操作按钮 -->\\n      </div>\\n    </div>\\n\\n    <!-- 概览指标 -->\\n    <el-row :gutter=\\\"20\\\" class=\\\"metrics-row\\\">\\n      <el-col :span=\\\"4\\\" v-for=\\\"metric in overviewMetrics\\\">\\n        <el-card class=\\\"metric-card\\\">\\n          <!-- 指标卡片 -->\\n        </el-card>\\n      </el-col>\\n    </el-row>\\n\\n    <!-- 图表区域 -->\\n    <el-row :gutter=\\\"20\\\" class=\\\"charts-row\\\">\\n      <el-col :span=\\\"12\\\">\\n        <el-card class=\\\"chart-card\\\">\\n          <!-- 生命周期阶段分布图 -->\\n        </el-card>\\n      </el-col>\\n      <el-col :span=\\\"12\\\">\\n        <el-card class=\\\"chart-card\\\">\\n          <!-- 客户价值分布图 -->\\n        </el-card>\\n      </el-col>\\n    </el-row>\\n\\n    <!-- 流失预警和关怀提醒 -->\\n    <el-row :gutter=\\\"20\\\" class=\\\"alerts-row\\\">\\n      <el-col :span=\\\"12\\\">\\n        <el-card class=\\\"alert-card\\\">\\n          <!-- 流失预警列表 -->\\n        </el-card>\\n      </el-col>\\n      <el-col :span=\\\"12\\\">\\n        <el-card class=\\\"alert-card\\\">\\n          <!-- 关怀提醒列表 -->\\n        </el-card>\\n      </el-col>\\n    </el-row>\\n  </div>\\n</template>\\n```\\n\\n---\\n\\n## 6. 核心功能\\n\\n### 6.1 客户生命周期管理\\n\\n#### 6.1.1 生命周期阶段定义\\n\\n```typescript\\nexport const LIFECYCLE_STAGES = {\\n  POTENTIAL: 'potential',\\n  NEW: 'new',\\n  ACTIVE: 'active',\\n  LOYAL: 'loyal',\\n  DORMANT: 'dormant',\\n  CHURNED: 'churned'\\n} as const\\n```\\n\\n#### 6.1.2 阶段转换规则\\n\\n```typescript\\nexport const STAGE_TRANSITION_RULES = [\\n  {\\n    from: [LIFECYCLE_STAGES.POTENTIAL],\\n    to: LIFECYCLE_STAGES.NEW,\\n    condition: (customer: Customer) => {\\n      return customer.totalOrders > 0\\n    },\\n    reason: '首次下单'\\n  },\\n  {\\n    from: [LIFECYCLE_STAGES.NEW],\\n    to: LIFECYCLE_STAGES.ACTIVE,\\n    condition: (customer: Customer) => {\\n      const daysSinceFirstOrder = getDaysSince(customer.firstOrderAt)\\n      return daysSinceFirstOrder <= 30 && customer.totalOrders >= 2\\n    },\\n    reason: '30天内多次消费'\\n  },\\n  // 更多规则...\\n]\\n```\\n\\n### 6.2 RFM客户价值评估\\n\\n#### 6.2.1 RFM评分计算\\n\\n```typescript\\nclass RFMModel {\\n  calculateRFMScore(customer: Customer): RFMScore {\\n    const recencyScore = this.calculateRecencyScore(customer.lastOrderAt)\\n    const frequencyScore = this.calculateFrequencyScore(customer.totalOrders)\\n    const monetaryScore = this.calculateMonetaryScore(customer.totalSpent)\\n\\n    const rfmScore = recencyScore + frequencyScore + monetaryScore\\n    const customerLevel = this.getCustomerLevel(rfmScore)\\n\\n    return {\\n      customerId: customer.id,\\n      recencyScore,\\n      frequencyScore,\\n      monetaryScore,\\n      rfmScore,\\n      customerLevel,\\n      calculatedAt: new Date()\\n    }\\n  }\\n\\n  private calculateRecencyScore(lastOrderAt: Date): number {\\n    const daysSinceLastOrder = getDaysSince(lastOrderAt)\\n\\n    if (daysSinceLastOrder <= 7) return 5\\n    if (daysSinceLastOrder <= 14) return 4\\n    if (daysSinceLastOrder <= 30) return 3\\n    if (daysSinceLastOrder <= 60) return 2\\n    return 1\\n  }\\n\\n  private calculateFrequencyScore(totalOrders: number): number {\\n    if (totalOrders >= 20) return 5\\n    if (totalOrders >= 10) return 4\\n    if (totalOrders >= 5) return 3\\n    if (totalOrders >= 2) return 2\\n    return 1\\n  }\\n\\n  private calculateMonetaryScore(totalSpent: number): number {\\n    if (totalSpent >= 5000) return 5\\n    if (totalSpent >= 2000) return 4\\n    if (totalSpent >= 1000) return 3\\n    if (totalSpent >= 500) return 2\\n    return 1\\n  }\\n\\n  private getCustomerLevel(rfmScore: number): string {\\n    if (rfmScore >= 13) return '超级VIP'\\n    if (rfmScore >= 10) return 'VIP'\\n    if (rfmScore >= 7) return '会员'\\n    if (rfmScore >= 4) return '普通'\\n    return '低价值'\\n  }\\n}\\n```\\n\\n### 6.3 客户流失预测\\n\\n#### 6.3.1 流失风险因素\\n\\n```typescript\\nclass ChurnPredictionModel {\\n  predictChurn(customer: Customer): ChurnPrediction {\\n    const riskFactors: string[] = []\\n    let churnProbability = 0\\n\\n    const daysSinceLastOrder = this.getDaysSince(customer.lastOrderAt)\\n    const frequencyDrop = this.calculateFrequencyDrop(customer)\\n    const spendingDrop = this.calculateSpendingDrop(customer)\\n\\n    if (this.isInactive(customer, 30)) {\\n      churnProbability += 0.2\\n      riskFactors.push('30天未消费')\\n    }\\n\\n    if (this.isInactive(customer, 60)) {\\n      churnProbability += 0.3\\n      riskFactors.push('60天未消费')\\n    }\\n\\n    if (frequencyDrop <= -0.5) {\\n      churnProbability += 0.25\\n      riskFactors.push(`消费频次下降${Math.abs(frequencyDrop * 100).toFixed(0)}%`)\\n    }\\n\\n    if (spendingDrop <= -0.5) {\\n      churnProbability += 0.15\\n      riskFactors.push(`消费金额下降${Math.abs(spendingDrop * 100).toFixed(0)}%`)\\n    }\\n\\n    if (customer.satisfactionScore < 3.5) {\\n      churnProbability += 0.1\\n      riskFactors.push(`满意度评分${customer.satisfactionScore}分`)\\n    }\\n\\n    churnProbability = Math.min(churnProbability, 1.0)\\n\\n    const riskLevel = this.getRiskLevel(churnProbability)\\n    const predictedChurnDate = this.predictChurnDate(churnProbability)\\n    const recommendations = this.generateRecommendations(riskFactors)\\n\\n    return {\\n      customerId: customer.id,\\n      customerName: customer.name,\\n      customerPhone: customer.phone,\\n      customerEmail: customer.email,\\n      churnProbability: Math.round(churnProbability * 100) / 100,\\n      riskLevel,\\n      riskFactors,\\n      predictedChurnDate,\\n      recommendations,\\n      assignedTo: null,\\n      status: 'pending',\\n      createdAt: new Date(),\\n      updatedAt: new Date()\\n    }\\n  }\\n}\\n```\\n\\n### 6.4 智能客户关怀\\n\\n#### 6.4.1 关怀提醒生成\\n\\n```typescript\\nclass CareReminderEngine {\\n  generateReminders(customer: Customer): CareReminder[] {\\n    const reminders: CareReminder[] = []\\n\\n    const daysSinceLastOrder = this.getDaysSince(customer.lastOrderAt)\\n    const lifecycle = this.getCustomerLifecycle(customer.id)\\n\\n    if (daysSinceLastOrder === 7) {\\n      reminders.push({\\n        customerId: customer.id,\\n        reminderType: 'revisit',\\n        title: '7天未消费关怀',\\n        content: '亲爱的${customer.name}，您已经7天没有光顾了，我们想念您！',\\n        priority: 'medium',\\n        scheduledAt: new Date()\\n      })\\n    }\\n\\n    if (daysSinceLastOrder === 30) {\\n      reminders.push({\\n        customerId: customer.id,\\n        reminderType: 'reactivation',\\n        title: '30天未消费关怀',\\n        content: '亲爱的${customer.name}，您已经30天没有光顾了，特为您准备了一份专属优惠券！',\\n        priority: 'high',\\n        scheduledAt: new Date()\\n      })\\n    }\\n\\n    if (lifecycle.currentStage === 'loyal') {\\n      reminders.push({\\n        customerId: customer.id,\\n        reminderType: 'loyalty',\\n        title: '忠诚客户关怀',\\n        content: '亲爱的${customer.name}，感谢您一直以来的支持，特为您升级为VIP会员！',\\n        priority: 'low',\\n        scheduledAt: new Date()\\n      })\\n    }\\n\\n    return reminders\\n  }\\n}\\n```\\n\\n---\\n\\n## 7. 开发指南\\n\\n### 7.1 环境搭建\\n\\n#### 7.1.1 前端环境\\n\\n```bash\\n# 安装依赖\\ncd frontend/apps/admin-dashboard\\nnpm install\\n\\n# 启动开发服务器\\nnpm run dev\\n\\n# 构建生产版本\\nnpm run build\\n```\\n\\n#### 7.1.2 后端环境\\n\\n```bash\\n# 安装依赖\\ncd backend\\nnpm install\\n\\n# 启动开发服务器\\nnpm run dev\\n\\n# 构建生产版本\\nnpm run build\\n```\\n\\n### 7.2 代码规范\\n\\n#### 7.2.1 命名规范\\n\\n- **文件名**：使用kebab-case，如 `customer-status-tracker.vue`\\n- **组件名**：使用PascalCase，如 `CustomerStatusTracker`\\n- **变量名**：使用camelCase，如 `customerList`\\n- **常量名**：使用UPPER_SNAKE_CASE，如 `LIFECYCLE_STAGES`\\n\\n#### 7.2.2 注释规范\\n\\n```typescript\\n/**\\n * @description 客户状态跟踪组件\\n * @author YYC\\n * @created 2026-01-20\\n */\\nexport const CustomerStatusTracker = defineComponent({\\n  // 组件实现\\n})\\n```\\n\\n### 7.3 Git工作流\\n\\n#### 7.3.1 分支策略\\n\\n- `main`：主分支，用于生产环境\\n- `develop`：开发分支，用于集成开发\\n- `feature/*`：功能分支，用于开发新功能\\n- `bugfix/*`：修复分支，用于修复bug\\n\\n#### 7.3.2 提交规范\\n\\n```\\nfeat: 添加客户分群管理功能\\nfix: 修复客户状态修改bug\\ndocs: 更新API文档\\nstyle: 调整代码格式\\nrefactor: 重构RFM计算逻辑\\ntest: 添加客户管理模块测试\\nchore: 更新依赖包\\n```\\n\\n### 7.4 调试技巧\\n\\n#### 7.4.1 前端调试\\n\\n1. 使用Chrome DevTools进行调试\\n2. 使用Vue DevTools查看组件状态\\n3. 使用console.log输出调试信息\\n\\n#### 7.4.2 后端调试\\n\\n1. 使用VS Code调试器\\n2. 使用Postman测试API接口\\n3. 查看服务器日志\\n\\n---\\n\\n## 8. 测试指南\\n\\n### 8.1 单元测试\\n\\n#### 8.1.1 测试框架\\n\\n- **前端**：Vitest + Vue Test Utils\\n- **后端**：Jest\\n\\n#### 8.1.2 测试示例\\n\\n```typescript\\ndescribe('CustomerStatusTracker', () => {\\n  it('应该正确加载客户统计数据', async () => {\\n    const wrapper = mount(CustomerStatusTracker)\\n    await wrapper.vm.loadStatistics()\\n    expect(wrapper.vm.statistics.active).toBeGreaterThan(0)\\n  })\\n\\n  it('应该正确修改客户状态', async () => {\\n    const wrapper = mount(CustomerStatusTracker)\\n    await wrapper.vm.handleStatusSubmit()\\n    expect(wrapper.vm.statusDialogVisible).toBe(false)\\n  })\\n})\\n```\\n\\n### 8.2 集成测试\\n\\n#### 8.2.1 测试场景\\n\\n1. 客户创建到分群的完整流程\\n2. 客户生命周期自动流转\\n3. RFM评分计算和客户等级划分\\n4. 流失预测和预警处理\\n\\n### 8.3 E2E测试\\n\\n#### 8.3.1 测试框架\\n\\n- **Playwright**\\n\\n#### 8.3.2 测试示例\\n\\n```typescript\\ntest('客户状态跟踪完整流程', async ({ page }) => {\\n  await page.goto('/customer/status-tracker')\\n  await page.fill('input[name=\\\"keyword\\\"]', '张三')\\n  await page.click('button:has-text(\\\"搜索\\\")')\\n  await expect(page.locator('table')).toBeVisible()\\n})\\n```\\n\\n---\\n\\n## 9. 部署指南\\n\\n### 9.1 前端部署\\n\\n#### 9.1.1 构建命令\\n\\n```bash\\nnpm run build\\n```\\n\\n#### 9.1.2 部署到Nginx\\n\\n```nginx\\nserver {\\n  listen 80;\\n  server_name admin.yyc3.com;\\n\\n  root /var/www/admin-dashboard/dist;\\n  index index.html;\\n\\n  location / {\\n    try_files $uri $uri/ /index.html;\\n  }\\n\\n  location /api {\\n    proxy_pass http://localhost:3006;\\n  }\\n}\\n```\\n\\n### 9.2 后端部署\\n\\n#### 9.2.1 环境变量\\n\\n```env\\nNODE_ENV=production\\nPORT=3006\\nDATABASE_URL=postgresql://user:password@localhost:5432/yyc3\\nJWT_SECRET=your-secret-key\\n```\\n\\n#### 9.2.2 使用PM2部署\\n\\n```bash\\nnpm install -g pm2\\npm2 start npm --name \\\"yyc3-api\\\" -- start\\npm2 save\\npm2 startup\\n```\\n\\n### 9.3 数据库部署\\n\\n#### 9.3.1 创建数据库\\n\\n```sql\\nCREATE DATABASE yyc3;\\n```\\n\\n#### 9.3.2 执行迁移\\n\\n```bash\\nnpm run migrate\\n```\\n\\n---\\n\\n## 10. 常见问题\\n\\n### 10.1 开发问题\\n\\n**Q：如何添加新的客户分群类型？**\\n\\nA：在`customer.ts`中的`CustomerGroup`接口中添加新的`groupType`值，并在数据库中添加相应的CHECK约束。\\n\\n**Q：如何修改RFM评分标准？**\\n\\nA：在`useRFMModel.ts`中修改`calculateRecencyScore`、`calculateFrequencyScore`、`calculateMonetaryScore`方法的评分逻辑。\\n\\n### 10.2 性能问题\\n\\n**Q：客户列表加载缓慢怎么办？**\\n\\nA：检查数据库索引是否正确创建，考虑添加分页和缓存机制。\\n\\n**Q：RFM计算耗时过长怎么办？**\\n\\nA：考虑使用后台任务异步计算，或使用缓存存储计算结果。\\n\\n### 10.3 部署问题\\n\\n**Q：部署后API接口404怎么办？**\\n\\nA：检查Nginx配置中的`proxy_pass`是否正确，确保后端服务正在运行。\\n\\n**Q：数据库连接失败怎么办？**\\n\\nA：检查数据库连接字符串是否正确，确保数据库服务正在运行，检查防火墙设置。\\n\\n---\\n\\n## 附录\\n\\n### A. 相关文档\\n\\n- [用户操作手册](./YYC3-Cater-用户操作手册.md)\\n- [API接口文档](./YYC3-Cater-接口文档/客户生命周期管理API接口文档.md)\\n- [数据模型设计文档](../../YYC3-CP-详细设计/041-YYC3-AICP-详细设计-数据模型设计文档.md)\\n\\n### B. 版本历史\\n\\n| 版本 | 日期 | 更新内容 |\\n|------|------|----------|\\n| v1.0.0 | 2026-01-20 | 初始版本 |\\n\\n---\\n\\n> 「***YanYuCloudCube***」\\n> 「***<admin@0379.email>***」\\n> 「***Words Initiate Quadrants, Language Serves as Core for the Future***」\\n> 「***All things converge in the cloud pivot; Deep stacks ignite a new era of intelligence***」\\n\",\"originTextLength\":26640,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768913766841},{\"originRange\":{\"start\":{\"line\":893,\"character\":0},\"end\":{\"line\":901,\"character\":10}},\"modifyRange\":{\"start\":{\"line\":893,\"character\":0},\"end\":{\"line\":901,\"character\":10}},\"action\":\"None\",\"isLine\":false,\"originText\":\"\\\\nexport const LIFECYCLE_STAGE_NAMES = {\\\\n  [LIFECYCLE_STAGES.POTENTIAL]: \\\\'潜在客户\\\\',\\\\n  [LIFECYCLE_STAGES.NEW]: \\\\'新客户\\\\',\\\\n  [LIFECYCLE_STAGES.ACTIVE]: \\\\'活跃客户\\\\',\\\\n  [LIFECYCLE_STAGES.LOYAL]: \\\\'忠诚客户\\\\',\\\\n  [LIFECYCLE_STAGES.DORMANT]: \\\\'休眠客户\\\\',\\\\n  [LIFECYCLE_STAGES.CHURNED]: \\\\'流失客户\\\\'\\\\n} as const\",\"originAcceptText\":\"\\nexport const LIFECYCLE_STAGE_NAMES = {\\n  [LIFECYCLE_STAGES.POTENTIAL]: '潜在客户',\\n  [LIFECYCLE_STAGES.NEW]: '新客户',\\n  [LIFECYCLE_STAGES.ACTIVE]: '活跃客户',\\n  [LIFECYCLE_STAGES.LOYAL]: '忠诚客户',\\n  [LIFECYCLE_STAGES.DORMANT]: '休眠客户',\\n  [LIFECYCLE_STAGES.CHURNED]: '流失客户'\\n} as const\",\"originTextLength\":271,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768914454198},{\"originRange\":{\"start\":{\"line\":895,\"character\":0},\"end\":{\"line\":1109,\"character\":17}},\"modifyRange\":{\"start\":{\"line\":895,\"character\":0},\"end\":{\"line\":1109,\"character\":17}},\"action\":\"None\",\"isLine\":false,\"originText\":\"#### 6.1.2 生命周期规则引擎\\\\n\\\\n##### 6.1.2.1 规则引擎架构\\\\n\\\\n生命周期规则引擎采用事件驱动架构，基于客户行为事件自动评估和更新客户生命周期阶段。\\\\n\\\\n```typescript\\\\ninterface LifecycleRule {\\\\n  id: string\\\\n  name: string\\\\n  description: string\\\\n  triggerType: \\\\'event\\\\' | \\\\'time\\\\' | \\\\'manual\\\\'\\\\n  triggerCondition: any\\\\n  fromStages: string[]\\\\n  toStage: string\\\\n  priority: number\\\\n  enabled: boolean\\\\n}\\\\n\\\\ninterface LifecycleTransition {\\\\n  customerId: string\\\\n  fromStage: string\\\\n  toStage: string\\\\n  reason: string\\\\n  triggeredBy: \\\\'system\\\\' | \\\\'manual\\\\'\\\\n  triggeredAt: Date\\\\n}\\\\n```\\\\n\\\\n##### 6.1.2.2 规则引擎实现\\\\n\\\\n```typescript\\\\nclass LifecycleRuleEngine {\\\\n  private rules: LifecycleRule[] = []\\\\n  private eventBus: EventBus\\\\n\\\\n  constructor() {\\\\n    this.initializeRules()\\\\n    this.setupEventListeners()\\\\n  }\\\\n\\\\n  private initializeRules() {\\\\n    this.rules = [\\\\n      {\\\\n        id: \\\\'rule-001\\\\',\\\\n        name: \\\\'首次下单转化\\\\',\\\\n        description: \\\\'客户首次下单时从潜在客户转化为新客户\\\\',\\\\n        triggerType: \\\\'event\\\\',\\\\n        triggerCondition: { eventType: \\\\'order.created\\\\', isFirstOrder: true },\\\\n        fromStages: [LIFECYCLE_STAGES.POTENTIAL],\\\\n        toStage: LIFECYCLE_STAGES.NEW,\\\\n        priority: 1,\\\\n        enabled: true\\\\n      },\\\\n      {\\\\n        id: \\\\'rule-002\\\\',\\\\n        name: \\\\'活跃客户转化\\\\',\\\\n        description: \\\\'新客户30天内多次消费转化为活跃客户\\\\',\\\\n        triggerType: \\\\'event\\\\',\\\\n        triggerCondition: { eventType: \\\\'order.created\\\\', daysSinceFirstOrder: 30 },\\\\n        fromStages: [LIFECYCLE_STAGES.NEW],\\\\n        toStage: LIFECYCLE_STAGES.ACTIVE,\\\\n        priority: 2,\\\\n        enabled: true\\\\n      },\\\\n      {\\\\n        id: \\\\'rule-003\\\\',\\\\n        name: \\\\'忠诚客户转化\\\\',\\\\n        description: \\\\'高价值高频次客户转化为忠诚客户\\\\',\\\\n        triggerType: \\\\'event\\\\',\\\\n        triggerCondition: { eventType: \\\\'order.created\\\\', rfmScore: 13 },\\\\n        fromStages: [LIFECYCLE_STAGES.ACTIVE],\\\\n        toStage: LIFECYCLE_STAGES.LOYAL,\\\\n        priority: 3,\\\\n        enabled: true\\\\n      },\\\\n      {\\\\n        id: \\\\'rule-004\\\\',\\\\n        name: \\\\'休眠客户转化\\\\',\\\\n        description: \\\\'60天未消费转化为休眠客户\\\\',\\\\n        triggerType: \\\\'time\\\\',\\\\n        triggerCondition: { daysSinceLastOrder: 60 },\\\\n        fromStages: [LIFECYCLE_STAGES.ACTIVE, LIFECYCLE_STAGES.LOYAL],\\\\n        toStage: LIFECYCLE_STAGES.DORMANT,\\\\n        priority: 4,\\\\n        enabled: true\\\\n      },\\\\n      {\\\\n        id: \\\\'rule-005\\\\',\\\\n        name: \\\\'流失客户转化\\\\',\\\\n        description: \\\\'90天未消费转化为流失客户\\\\',\\\\n        triggerType: \\\\'time\\\\',\\\\n        triggerCondition: { daysSinceLastOrder: 90 },\\\\n        fromStages: [LIFECYCLE_STAGES.DORMANT],\\\\n        toStage: LIFECYCLE_STAGES.CHURNED,\\\\n        priority: 5,\\\\n        enabled: true\\\\n      },\\\\n      {\\\\n        id: \\\\'rule-006\\\\',\\\\n        name: \\\\'休眠客户激活\\\\',\\\\n        description: \\\\'休眠客户再次消费转化为活跃客户\\\\',\\\\n        triggerType: \\\\'event\\\\',\\\\n        triggerCondition: { eventType: \\\\'order.created\\\\' },\\\\n        fromStages: [LIFECYCLE_STAGES.DORMANT, LIFECYCLE_STAGES.CHURNED],\\\\n        toStage: LIFECYCLE_STAGES.ACTIVE,\\\\n        priority: 6,\\\\n        enabled: true\\\\n      }\\\\n    ]\\\\n  }\\\\n\\\\n  private setupEventListeners() {\\\\n    this.eventBus.on(\\\\'order.created\\\\', this.handleOrderCreated.bind(this))\\\\n    this.eventBus.on(\\\\'customer.registered\\\\', this.handleCustomerRegistered.bind(this))\\\\n    this.eventBus.on(\\\\'time.check\\\\', this.handleTimeCheck.bind(this))\\\\n  }\\\\n\\\\n  async handleOrderCreated(event: OrderCreatedEvent) {\\\\n    const customer = await this.customerService.getCustomer(event.customerId)\\\\n    const lifecycle = await this.lifecycleService.getLifecycle(customer.id)\\\\n\\\\n    const applicableRules = this.rules.filter(rule =>\\\\n      rule.enabled &&\\\\n      rule.fromStages.includes(lifecycle.currentStage) &&\\\\n      this.checkTriggerCondition(rule, event, customer, lifecycle)\\\\n    )\\\\n\\\\n    if (applicableRules.length > 0) {\\\\n      const rule = applicableRules.sort((a, b) => a.priority - b.priority)[0]\\\\n      await this.executeTransition(customer, lifecycle, rule, \\\\'system\\\\')\\\\n    }\\\\n  }\\\\n\\\\n  async handleTimeCheck() {\\\\n    const customers = await this.customerService.getAllCustomers()\\\\n\\\\n    for (const customer of customers) {\\\\n      const lifecycle = await this.lifecycleService.getLifecycle(customer.id)\\\\n\\\\n      const applicableRules = this.rules.filter(rule =>\\\\n        rule.enabled &&\\\\n        rule.triggerType === \\\\'time\\\\' &&\\\\n        rule.fromStages.includes(lifecycle.currentStage) &&\\\\n        this.checkTimeCondition(rule, customer, lifecycle)\\\\n      )\\\\n\\\\n      if (applicableRules.length > 0) {\\\\n        const rule = applicableRules.sort((a, b) => a.priority - b.priority)[0]\\\\n        await this.executeTransition(customer, lifecycle, rule, \\\\'system\\\\')\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  private checkTriggerCondition(\\\\n    rule: LifecycleRule,\\\\n    event: any,\\\\n    customer: Customer,\\\\n    lifecycle: Lifecycle\\\\n  ): boolean {\\\\n    const condition = rule.triggerCondition\\\\n\\\\n    if (condition.eventType !== event.type) {\\\\n      return false\\\\n    }\\\\n\\\\n    if (condition.isFirstOrder && !event.isFirstOrder) {\\\\n      return false\\\\n    }\\\\n\\\\n    if (condition.daysSinceFirstOrder) {\\\\n      const daysSinceFirstOrder = this.getDaysSince(customer.firstOrderAt)\\\\n      if (daysSinceFirstOrder > condition.daysSinceFirstOrder) {\\\\n        return false\\\\n      }\\\\n    }\\\\n\\\\n    if (condition.rfmScore) {\\\\n      const rfmScore = await this.rfmService.getLatestRFMScore(customer.id)\\\\n      if (!rfmScore || rfmScore.rfmScore < condition.rfmScore) {\\\\n        return false\\\\n      }\\\\n    }\\\\n\\\\n    return true\\\\n  }\\\\n\\\\n  private checkTimeCondition(\\\\n    rule: LifecycleRule,\\\\n    customer: Customer,\\\\n    lifecycle: Lifecycle\\\\n  ): boolean {\\\\n    const condition = rule.triggerCondition\\\\n\\\\n    if (condition.daysSinceLastOrder) {\\\\n      const daysSinceLastOrder = this.getDaysSince(customer.lastOrderAt)\\\\n      return daysSinceLastOrder >= condition.daysSinceLastOrder\\\\n    }\\\\n\\\\n    return false\\\\n  }\\\\n\\\\n  private async executeTransition(\\\\n    customer: Customer,\\\\n    lifecycle: Lifecycle,\\\\n    rule: LifecycleRule,\\\\n    triggeredBy: \\\\'system\\\\' | \\\\'manual\\\\'\\\\n  ) {\\\\n    const transition: LifecycleTransition = {\\\\n      customerId: customer.id,\\\\n      fromStage: lifecycle.currentStage,\\\\n      toStage: rule.toStage,\\\\n      reason: rule.name,\\\\n      triggeredBy,\\\\n      triggeredAt: new Date()\\\\n    }\\\\n\\\\n    await this.lifecycleService.updateLifecycleStage(\\\\n      customer.id,\\\\n      rule.toStage,\\\\n      rule.name\\\\n    )\\\\n\\\\n    await this.eventBus.emit(\\\\'lifecycle.transition\\\\', transition)\\\\n  }\\\\n\\\\n  async manualTransition(customerId: string, toStage: string, reason: string) {\\\\n    const customer = await this.customerService.getCustomer(customerId)\\\\n    const lifecycle = await this.lifecycleService.getLifecycle(customerId)\\\\n\\\\n    await this.executeTransition(customer, lifecycle, {\\\\n      id: \\\\'manual\\\\',\\\\n      name: reason,\\\\n      description: reason,\\\\n      triggerType: \\\\'manual\\\\',\\\\n      triggerCondition: {},\\\\n      fromStages: [lifecycle.currentStage],\\\\n      toStage,\\\\n      priority: 0,\\\\n      enabled: true\\\\n    }, \\\\'manual\\\\')\\\\n  }\\\\n}\\\\n```\\\\n\\\\n#### 6.1.3 阶段转换规则\",\"originAcceptText\":\"#### 6.1.2 生命周期规则引擎\\n\\n##### 6.1.2.1 规则引擎架构\\n\\n生命周期规则引擎采用事件驱动架构，基于客户行为事件自动评估和更新客户生命周期阶段。\\n\\n```typescript\\ninterface LifecycleRule {\\n  id: string\\n  name: string\\n  description: string\\n  triggerType: 'event' | 'time' | 'manual'\\n  triggerCondition: any\\n  fromStages: string[]\\n  toStage: string\\n  priority: number\\n  enabled: boolean\\n}\\n\\ninterface LifecycleTransition {\\n  customerId: string\\n  fromStage: string\\n  toStage: string\\n  reason: string\\n  triggeredBy: 'system' | 'manual'\\n  triggeredAt: Date\\n}\\n```\\n\\n##### 6.1.2.2 规则引擎实现\\n\\n```typescript\\nclass LifecycleRuleEngine {\\n  private rules: LifecycleRule[] = []\\n  private eventBus: EventBus\\n\\n  constructor() {\\n    this.initializeRules()\\n    this.setupEventListeners()\\n  }\\n\\n  private initializeRules() {\\n    this.rules = [\\n      {\\n        id: 'rule-001',\\n        name: '首次下单转化',\\n        description: '客户首次下单时从潜在客户转化为新客户',\\n        triggerType: 'event',\\n        triggerCondition: { eventType: 'order.created', isFirstOrder: true },\\n        fromStages: [LIFECYCLE_STAGES.POTENTIAL],\\n        toStage: LIFECYCLE_STAGES.NEW,\\n        priority: 1,\\n        enabled: true\\n      },\\n      {\\n        id: 'rule-002',\\n        name: '活跃客户转化',\\n        description: '新客户30天内多次消费转化为活跃客户',\\n        triggerType: 'event',\\n        triggerCondition: { eventType: 'order.created', daysSinceFirstOrder: 30 },\\n        fromStages: [LIFECYCLE_STAGES.NEW],\\n        toStage: LIFECYCLE_STAGES.ACTIVE,\\n        priority: 2,\\n        enabled: true\\n      },\\n      {\\n        id: 'rule-003',\\n        name: '忠诚客户转化',\\n        description: '高价值高频次客户转化为忠诚客户',\\n        triggerType: 'event',\\n        triggerCondition: { eventType: 'order.created', rfmScore: 13 },\\n        fromStages: [LIFECYCLE_STAGES.ACTIVE],\\n        toStage: LIFECYCLE_STAGES.LOYAL,\\n        priority: 3,\\n        enabled: true\\n      },\\n      {\\n        id: 'rule-004',\\n        name: '休眠客户转化',\\n        description: '60天未消费转化为休眠客户',\\n        triggerType: 'time',\\n        triggerCondition: { daysSinceLastOrder: 60 },\\n        fromStages: [LIFECYCLE_STAGES.ACTIVE, LIFECYCLE_STAGES.LOYAL],\\n        toStage: LIFECYCLE_STAGES.DORMANT,\\n        priority: 4,\\n        enabled: true\\n      },\\n      {\\n        id: 'rule-005',\\n        name: '流失客户转化',\\n        description: '90天未消费转化为流失客户',\\n        triggerType: 'time',\\n        triggerCondition: { daysSinceLastOrder: 90 },\\n        fromStages: [LIFECYCLE_STAGES.DORMANT],\\n        toStage: LIFECYCLE_STAGES.CHURNED,\\n        priority: 5,\\n        enabled: true\\n      },\\n      {\\n        id: 'rule-006',\\n        name: '休眠客户激活',\\n        description: '休眠客户再次消费转化为活跃客户',\\n        triggerType: 'event',\\n        triggerCondition: { eventType: 'order.created' },\\n        fromStages: [LIFECYCLE_STAGES.DORMANT, LIFECYCLE_STAGES.CHURNED],\\n        toStage: LIFECYCLE_STAGES.ACTIVE,\\n        priority: 6,\\n        enabled: true\\n      }\\n    ]\\n  }\\n\\n  private setupEventListeners() {\\n    this.eventBus.on('order.created', this.handleOrderCreated.bind(this))\\n    this.eventBus.on('customer.registered', this.handleCustomerRegistered.bind(this))\\n    this.eventBus.on('time.check', this.handleTimeCheck.bind(this))\\n  }\\n\\n  async handleOrderCreated(event: OrderCreatedEvent) {\\n    const customer = await this.customerService.getCustomer(event.customerId)\\n    const lifecycle = await this.lifecycleService.getLifecycle(customer.id)\\n\\n    const applicableRules = this.rules.filter(rule =>\\n      rule.enabled &&\\n      rule.fromStages.includes(lifecycle.currentStage) &&\\n      this.checkTriggerCondition(rule, event, customer, lifecycle)\\n    )\\n\\n    if (applicableRules.length > 0) {\\n      const rule = applicableRules.sort((a, b) => a.priority - b.priority)[0]\\n      await this.executeTransition(customer, lifecycle, rule, 'system')\\n    }\\n  }\\n\\n  async handleTimeCheck() {\\n    const customers = await this.customerService.getAllCustomers()\\n\\n    for (const customer of customers) {\\n      const lifecycle = await this.lifecycleService.getLifecycle(customer.id)\\n\\n      const applicableRules = this.rules.filter(rule =>\\n        rule.enabled &&\\n        rule.triggerType === 'time' &&\\n        rule.fromStages.includes(lifecycle.currentStage) &&\\n        this.checkTimeCondition(rule, customer, lifecycle)\\n      )\\n\\n      if (applicableRules.length > 0) {\\n        const rule = applicableRules.sort((a, b) => a.priority - b.priority)[0]\\n        await this.executeTransition(customer, lifecycle, rule, 'system')\\n      }\\n    }\\n  }\\n\\n  private checkTriggerCondition(\\n    rule: LifecycleRule,\\n    event: any,\\n    customer: Customer,\\n    lifecycle: Lifecycle\\n  ): boolean {\\n    const condition = rule.triggerCondition\\n\\n    if (condition.eventType !== event.type) {\\n      return false\\n    }\\n\\n    if (condition.isFirstOrder && !event.isFirstOrder) {\\n      return false\\n    }\\n\\n    if (condition.daysSinceFirstOrder) {\\n      const daysSinceFirstOrder = this.getDaysSince(customer.firstOrderAt)\\n      if (daysSinceFirstOrder > condition.daysSinceFirstOrder) {\\n        return false\\n      }\\n    }\\n\\n    if (condition.rfmScore) {\\n      const rfmScore = await this.rfmService.getLatestRFMScore(customer.id)\\n      if (!rfmScore || rfmScore.rfmScore < condition.rfmScore) {\\n        return false\\n      }\\n    }\\n\\n    return true\\n  }\\n\\n  private checkTimeCondition(\\n    rule: LifecycleRule,\\n    customer: Customer,\\n    lifecycle: Lifecycle\\n  ): boolean {\\n    const condition = rule.triggerCondition\\n\\n    if (condition.daysSinceLastOrder) {\\n      const daysSinceLastOrder = this.getDaysSince(customer.lastOrderAt)\\n      return daysSinceLastOrder >= condition.daysSinceLastOrder\\n    }\\n\\n    return false\\n  }\\n\\n  private async executeTransition(\\n    customer: Customer,\\n    lifecycle: Lifecycle,\\n    rule: LifecycleRule,\\n    triggeredBy: 'system' | 'manual'\\n  ) {\\n    const transition: LifecycleTransition = {\\n      customerId: customer.id,\\n      fromStage: lifecycle.currentStage,\\n      toStage: rule.toStage,\\n      reason: rule.name,\\n      triggeredBy,\\n      triggeredAt: new Date()\\n    }\\n\\n    await this.lifecycleService.updateLifecycleStage(\\n      customer.id,\\n      rule.toStage,\\n      rule.name\\n    )\\n\\n    await this.eventBus.emit('lifecycle.transition', transition)\\n  }\\n\\n  async manualTransition(customerId: string, toStage: string, reason: string) {\\n    const customer = await this.customerService.getCustomer(customerId)\\n    const lifecycle = await this.lifecycleService.getLifecycle(customerId)\\n\\n    await this.executeTransition(customer, lifecycle, {\\n      id: 'manual',\\n      name: reason,\\n      description: reason,\\n      triggerType: 'manual',\\n      triggerCondition: {},\\n      fromStages: [lifecycle.currentStage],\\n      toStage,\\n      priority: 0,\\n      enabled: true\\n    }, 'manual')\\n  }\\n}\\n```\\n\\n#### 6.1.3 阶段转换规则\",\"originTextLength\":6648,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768914454261},{\"originRange\":{\"start\":{\"line\":916,\"character\":0},\"end\":{\"line\":994,\"character\":1}},\"modifyRange\":{\"start\":{\"line\":916,\"character\":0},\"end\":{\"line\":994,\"character\":1}},\"action\":\"None\",\"isLine\":false,\"originText\":\"  {\\\\n    from: [LIFECYCLE_STAGES.ACTIVE],\\\\n    to: LIFECYCLE_STAGES.LOYAL,\\\\n    condition: (customer: Customer) => {\\\\n      return customer.totalSpent >= 5000 && customer.totalOrders >= 10\\\\n    },\\\\n    reason: \\\\'高价值高频次消费\\\\'\\\\n  },\\\\n  {\\\\n    from: [LIFECYCLE_STAGES.ACTIVE, LIFECYCLE_STAGES.LOYAL],\\\\n    to: LIFECYCLE_STAGES.DORMANT,\\\\n    condition: (customer: Customer) => {\\\\n      const daysSinceLastOrder = getDaysSince(customer.lastOrderAt)\\\\n      return daysSinceLastOrder >= 60\\\\n    },\\\\n    reason: \\\\'60天未消费\\\\'\\\\n  },\\\\n  {\\\\n    from: [LIFECYCLE_STAGES.DORMANT],\\\\n    to: LIFECYCLE_STAGES.CHURNED,\\\\n    condition: (customer: Customer) => {\\\\n      const daysSinceLastOrder = getDaysSince(customer.lastOrderAt)\\\\n      return daysSinceLastOrder >= 90\\\\n    },\\\\n    reason: \\\\'90天未消费\\\\'\\\\n  },\\\\n  {\\\\n    from: [LIFECYCLE_STAGES.DORMANT, LIFECYCLE_STAGES.CHURNED],\\\\n    to: LIFECYCLE_STAGES.ACTIVE,\\\\n    condition: (customer: Customer) => {\\\\n      const daysSinceLastOrder = getDaysSince(customer.lastOrderAt)\\\\n      return daysSinceLastOrder < 30\\\\n    },\\\\n    reason: \\\\'重新激活\\\\'\\\\n  }\\\\n]\\\\n```\\\\n\\\\n#### 6.1.4 生命周期数据看板\\\\n\\\\n生命周期数据看板提供多维度的数据分析和可视化展示：\\\\n\\\\n```typescript\\\\ninterface LifecycleDashboardData {\\\\n  overview: {\\\\n    totalCustomers: number\\\\n    potentialCustomers: number\\\\n    newCustomers: number\\\\n    activeCustomers: number\\\\n    loyalCustomers: number\\\\n    dormantCustomers: number\\\\n    churnedCustomers: number\\\\n  }\\\\n  stageDistribution: {\\\\n    stage: string\\\\n    count: number\\\\n    percentage: number\\\\n  }[]\\\\n  flowTrend: {\\\\n    date: string\\\\n    potentialToNew: number\\\\n    newToActive: number\\\\n    activeToLoyal: number\\\\n    loyalToDormant: number\\\\n    dormantToChurned: number\\\\n    churnedToActive: number\\\\n  }[]\\\\n  retentionTrend: {\\\\n    date: string\\\\n    newCustomers: number\\\\n    retentionRate: number\\\\n    retentionCount: number\\\\n    churnCount: number\\\\n  }[]\\\\n  clvDistribution: {\\\\n    range: string\\\\n    count: number\\\\n    percentage: number\\\\n  }[]\\\\n  averageCLV: number\\\\n  totalCLV: number\\\\n}\",\"originAcceptText\":\"  {\\n    from: [LIFECYCLE_STAGES.ACTIVE],\\n    to: LIFECYCLE_STAGES.LOYAL,\\n    condition: (customer: Customer) => {\\n      return customer.totalSpent >= 5000 && customer.totalOrders >= 10\\n    },\\n    reason: '高价值高频次消费'\\n  },\\n  {\\n    from: [LIFECYCLE_STAGES.ACTIVE, LIFECYCLE_STAGES.LOYAL],\\n    to: LIFECYCLE_STAGES.DORMANT,\\n    condition: (customer: Customer) => {\\n      const daysSinceLastOrder = getDaysSince(customer.lastOrderAt)\\n      return daysSinceLastOrder >= 60\\n    },\\n    reason: '60天未消费'\\n  },\\n  {\\n    from: [LIFECYCLE_STAGES.DORMANT],\\n    to: LIFECYCLE_STAGES.CHURNED,\\n    condition: (customer: Customer) => {\\n      const daysSinceLastOrder = getDaysSince(customer.lastOrderAt)\\n      return daysSinceLastOrder >= 90\\n    },\\n    reason: '90天未消费'\\n  },\\n  {\\n    from: [LIFECYCLE_STAGES.DORMANT, LIFECYCLE_STAGES.CHURNED],\\n    to: LIFECYCLE_STAGES.ACTIVE,\\n    condition: (customer: Customer) => {\\n      const daysSinceLastOrder = getDaysSince(customer.lastOrderAt)\\n      return daysSinceLastOrder < 30\\n    },\\n    reason: '重新激活'\\n  }\\n]\\n```\\n\\n#### 6.1.4 生命周期数据看板\\n\\n生命周期数据看板提供多维度的数据分析和可视化展示：\\n\\n```typescript\\ninterface LifecycleDashboardData {\\n  overview: {\\n    totalCustomers: number\\n    potentialCustomers: number\\n    newCustomers: number\\n    activeCustomers: number\\n    loyalCustomers: number\\n    dormantCustomers: number\\n    churnedCustomers: number\\n  }\\n  stageDistribution: {\\n    stage: string\\n    count: number\\n    percentage: number\\n  }[]\\n  flowTrend: {\\n    date: string\\n    potentialToNew: number\\n    newToActive: number\\n    activeToLoyal: number\\n    loyalToDormant: number\\n    dormantToChurned: number\\n    churnedToActive: number\\n  }[]\\n  retentionTrend: {\\n    date: string\\n    newCustomers: number\\n    retentionRate: number\\n    retentionCount: number\\n    churnCount: number\\n  }[]\\n  clvDistribution: {\\n    range: string\\n    count: number\\n    percentage: number\\n  }[]\\n  averageCLV: number\\n  totalCLV: number\\n}\",\"originTextLength\":1908,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768914454297},{\"originRange\":{\"start\":{\"line\":926,\"character\":0},\"end\":{\"line\":929,\"character\":66}},\"modifyRange\":{\"start\":{\"line\":926,\"character\":0},\"end\":{\"line\":929,\"character\":66}},\"action\":\"None\",\"isLine\":false,\"originText\":\"  private recencyWeights = { 7: 5, 14: 4, 30: 3, 60: 2, 90: 1 }\\\\n  private frequencyWeights = { 20: 5, 10: 4, 5: 3, 2: 2, 1: 1 }\\\\n  private monetaryWeights = { 5000: 5, 2000: 4, 1000: 3, 500: 2, 0: 1 }\\\\n\\\\n  async calculateRFMScore(customer: Customer): Promise<RFMScore> {\",\"originAcceptText\":\"  private recencyWeights = { 7: 5, 14: 4, 30: 3, 60: 2, 90: 1 }\\n  private frequencyWeights = { 20: 5, 10: 4, 5: 3, 2: 2, 1: 1 }\\n  private monetaryWeights = { 5000: 5, 2000: 4, 1000: 3, 500: 2, 0: 1 }\\n\\n  async calculateRFMScore(customer: Customer): Promise<RFMScore> {\",\"originTextLength\":267,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768914454329},{\"originRange\":{\"start\":{\"line\":934,\"character\":0},\"end\":{\"line\":935,\"character\":23}},\"modifyRange\":{\"start\":{\"line\":934,\"character\":0},\"end\":{\"line\":935,\"character\":23}},\"action\":\"None\",\"isLine\":false,\"originText\":\"    const rfmData: RFMScore = {\\\\n      id: generateId(),\",\"originAcceptText\":\"    const rfmData: RFMScore = {\\n      id: generateId(),\",\"originTextLength\":55,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768914454361},{\"originRange\":{\"start\":{\"line\":943,\"character\":0},\"end\":{\"line\":966,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":943,\"character\":0},\"end\":{\"line\":966,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"\\\\n    await this.rfmRepository.save(rfmData)\\\\n    return rfmData\\\\n  }\\\\n\\\\n  async batchCalculateRFMScores(customerIds: string[]): Promise<RFMScore[]> {\\\\n    const results: RFMScore[] = []\\\\n\\\\n    for (const customerId of customerIds) {\\\\n      const customer = await this.customerRepository.findById(customerId)\\\\n      if (customer) {\\\\n        const rfmScore = await this.calculateRFMScore(customer)\\\\n        results.push(rfmScore)\\\\n      }\\\\n    }\\\\n\\\\n    return results\\\\n  }\\\\n\\\\n  private calculateRecencyScore(lastOrderAt: Date | null): number {\\\\n    if (!lastOrderAt) return 1\\\\n\\\\n    const daysSinceLastOrder = this.getDaysSince(lastOrderAt)\\\\n\\\\n    for (const [days, score] of Object.entries(this.recencyWeights)) {\\\\n      if (daysSinceLastOrder <= parseInt(days)) {\\\\n        return score\\\\n      }\\\\n    }\\\\n\",\"originAcceptText\":\"\\n    await this.rfmRepository.save(rfmData)\\n    return rfmData\\n  }\\n\\n  async batchCalculateRFMScores(customerIds: string[]): Promise<RFMScore[]> {\\n    const results: RFMScore[] = []\\n\\n    for (const customerId of customerIds) {\\n      const customer = await this.customerRepository.findById(customerId)\\n      if (customer) {\\n        const rfmScore = await this.calculateRFMScore(customer)\\n        results.push(rfmScore)\\n      }\\n    }\\n\\n    return results\\n  }\\n\\n  private calculateRecencyScore(lastOrderAt: Date | null): number {\\n    if (!lastOrderAt) return 1\\n\\n    const daysSinceLastOrder = this.getDaysSince(lastOrderAt)\\n\\n    for (const [days, score] of Object.entries(this.recencyWeights)) {\\n      if (daysSinceLastOrder <= parseInt(days)) {\\n        return score\\n      }\\n    }\\n\",\"originTextLength\":775,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768914454391},{\"originRange\":{\"start\":{\"line\":956,\"character\":0},\"end\":{\"line\":961,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":956,\"character\":0},\"end\":{\"line\":961,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"    for (const [orders, score] of Object.entries(this.frequencyWeights)) {\\\\n      if (totalOrders >= parseInt(orders)) {\\\\n        return score\\\\n      }\\\\n    }\\\\n\",\"originAcceptText\":\"    for (const [orders, score] of Object.entries(this.frequencyWeights)) {\\n      if (totalOrders >= parseInt(orders)) {\\n        return score\\n      }\\n    }\\n\",\"originTextLength\":155,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768914454424},{\"originRange\":{\"start\":{\"line\":964,\"character\":0},\"end\":{\"line\":969,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":964,\"character\":0},\"end\":{\"line\":969,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"    for (const [amount, score] of Object.entries(this.monetaryWeights)) {\\\\n      if (totalSpent >= parseInt(amount)) {\\\\n        return score\\\\n      }\\\\n    }\\\\n\",\"originAcceptText\":\"    for (const [amount, score] of Object.entries(this.monetaryWeights)) {\\n      if (totalSpent >= parseInt(amount)) {\\n        return score\\n      }\\n    }\\n\",\"originTextLength\":153,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768914454449},{\"originRange\":{\"start\":{\"line\":978,\"character\":0},\"end\":{\"line\":1019,\"character\":3}},\"modifyRange\":{\"start\":{\"line\":978,\"character\":0},\"end\":{\"line\":1019,\"character\":3}},\"action\":\"None\",\"isLine\":false,\"originText\":\"\\\\n  async getRFMStatistics(startDate?: Date, endDate?: Date): Promise<RFMStatistics> {\\\\n    const rfmScores = await this.rfmRepository.findByDateRange(startDate, endDate)\\\\n\\\\n    const totalCustomers = rfmScores.length\\\\n    const averageRFMScore = rfmScores.reduce((sum, rfm) => sum + rfm.rfmScore, 0) / totalCustomers\\\\n\\\\n    const customerLevelDistribution = this.calculateLevelDistribution(rfmScores)\\\\n    const recencyDistribution = this.calculateScoreDistribution(rfmScores, \\\\'recencyScore\\\\')\\\\n    const frequencyDistribution = this.calculateScoreDistribution(rfmScores, \\\\'frequencyScore\\\\')\\\\n    const monetaryDistribution = this.calculateScoreDistribution(rfmScores, \\\\'monetaryScore\\\\')\\\\n\\\\n    return {\\\\n      totalCustomers,\\\\n      averageRFMScore,\\\\n      customerLevelDistribution,\\\\n      recencyDistribution,\\\\n      frequencyDistribution,\\\\n      monetaryDistribution\\\\n    }\\\\n  }\\\\n\\\\n  private calculateLevelDistribution(rfmScores: RFMScore[]): any[] {\\\\n    const levels = [\\\\'超级VIP\\\\', \\\\'VIP\\\\', \\\\'会员\\\\', \\\\'普通\\\\', \\\\'低价值\\\\']\\\\n    const distribution = levels.map(level => {\\\\n      const count = rfmScores.filter(rfm => rfm.customerLevel === level).length\\\\n      return {\\\\n        level,\\\\n        count,\\\\n        percentage: (count / rfmScores.length) * 100\\\\n      }\\\\n    })\\\\n\\\\n    return distribution\\\\n  }\\\\n\\\\n  private calculateScoreDistribution(rfmScores: RFMScore[], scoreField: string): any[] {\\\\n    const distribution = []\\\\n\\\\n    for (let score = 5; score >= 1; score--) {\\\\n      const count = rfmScores.filter(rfm => rfm[scoreField] === score).length\\\\n      distribution.push({\\\\n        score,\\\\n        count,\\\\n        percentage: (count / rfmScores.length) * 100\\\\n      })\\\\n    }\\\\n\\\\n    return distribution\\\\n  }\",\"originAcceptText\":\"\\n  async getRFMStatistics(startDate?: Date, endDate?: Date): Promise<RFMStatistics> {\\n    const rfmScores = await this.rfmRepository.findByDateRange(startDate, endDate)\\n\\n    const totalCustomers = rfmScores.length\\n    const averageRFMScore = rfmScores.reduce((sum, rfm) => sum + rfm.rfmScore, 0) / totalCustomers\\n\\n    const customerLevelDistribution = this.calculateLevelDistribution(rfmScores)\\n    const recencyDistribution = this.calculateScoreDistribution(rfmScores, 'recencyScore')\\n    const frequencyDistribution = this.calculateScoreDistribution(rfmScores, 'frequencyScore')\\n    const monetaryDistribution = this.calculateScoreDistribution(rfmScores, 'monetaryScore')\\n\\n    return {\\n      totalCustomers,\\n      averageRFMScore,\\n      customerLevelDistribution,\\n      recencyDistribution,\\n      frequencyDistribution,\\n      monetaryDistribution\\n    }\\n  }\\n\\n  private calculateLevelDistribution(rfmScores: RFMScore[]): any[] {\\n    const levels = ['超级VIP', 'VIP', '会员', '普通', '低价值']\\n    const distribution = levels.map(level => {\\n      const count = rfmScores.filter(rfm => rfm.customerLevel === level).length\\n      return {\\n        level,\\n        count,\\n        percentage: (count / rfmScores.length) * 100\\n      }\\n    })\\n\\n    return distribution\\n  }\\n\\n  private calculateScoreDistribution(rfmScores: RFMScore[], scoreField: string): any[] {\\n    const distribution = []\\n\\n    for (let score = 5; score >= 1; score--) {\\n      const count = rfmScores.filter(rfm => rfm[scoreField] === score).length\\n      distribution.push({\\n        score,\\n        count,\\n        percentage: (count / rfmScores.length) * 100\\n      })\\n    }\\n\\n    return distribution\\n  }\",\"originTextLength\":1649,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768914454475},{\"originRange\":{\"start\":{\"line\":986,\"character\":0},\"end\":{\"line\":991,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":986,\"character\":0},\"end\":{\"line\":991,\"character\":0}},\"action\":\"None\",\"isLine\":f