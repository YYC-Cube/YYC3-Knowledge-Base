  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/views/__tests__/KitchenManagement.integration.test.ts": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":684,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":684,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"/**\\\\n * @fileoverview YYC³餐饮管理系统 - KitchenManagement集成测试\\\\n * @description 测试KitchenManagement组件与API、composable的集成\\\\n * @module KitchenManagement.integration.test\\\\n * @author YYC³\\\\n * @version 1.0.0\\\\n * @created 2025-01-20\\\\n */\\\\n\\\\nimport { describe, it, expect, beforeEach, vi, afterEach } from \\\\'vitest\\\\'\\\\nimport { mount, VueWrapper } from \\\\'@vue/test-utils\\\\'\\\\nimport { createPinia, setActivePinia } from \\\\'pinia\\\\'\\\\nimport ElementPlus from \\\\'element-plus\\\\'\\\\nimport * as echarts from \\\\'echarts\\\\'\\\\nimport KitchenManagement from \\\\'@/views/KitchenManagement.vue\\\\'\\\\nimport { useKitchen } from \\\\'@/composables/useKitchen\\\\'\\\\nimport { kitchenAPI } from \\\\'@/api/kitchen\\\\'\\\\nimport type {\\\\n  KitchenTask,\\\\n  KitchenEmployee,\\\\n  KitchenInventory,\\\\n  TaskStatus,\\\\n  EmployeeStatus,\\\\n  TaskStation,\\\\n  TaskPriority\\\\n} from \\\\'@/types/kitchen\\\\'\\\\n\\\\nvi.mock(\\\\'@/api/kitchen\\\\', () => ({\\\\n  kitchenAPI: {\\\\n    getStats: vi.fn(),\\\\n    getAnalytics: vi.fn(),\\\\n    getEquipment: vi.fn(),\\\\n    createEquipment: vi.fn(),\\\\n    updateEquipment: vi.fn(),\\\\n    deleteEquipment: vi.fn(),\\\\n    getEmployees: vi.fn(),\\\\n    createEmployee: vi.fn(),\\\\n    updateEmployee: vi.fn(),\\\\n    deleteEmployee: vi.fn(),\\\\n    updateEmployeeStatus: vi.fn(),\\\\n    getTasks: vi.fn(),\\\\n    createTask: vi.fn(),\\\\n    updateTask: vi.fn(),\\\\n    deleteTask: vi.fn(),\\\\n    updateTaskStatus: vi.fn(),\\\\n    assignTask: vi.fn(),\\\\n    getInventory: vi.fn(),\\\\n    createInventoryItem: vi.fn(),\\\\n    updateInventoryItem: vi.fn(),\\\\n    deleteInventoryItem: vi.fn(),\\\\n    restockInventory: vi.fn(),\\\\n    getHygieneRecords: vi.fn(),\\\\n    createHygieneRecord: vi.fn(),\\\\n    updateHygieneRecord: vi.fn(),\\\\n    getSafetyRecords: vi.fn(),\\\\n    createSafetyRecord: vi.fn(),\\\\n    updateSafetyRecord: vi.fn(),\\\\n    getDisplays: vi.fn(),\\\\n    createDisplay: vi.fn(),\\\\n    updateDisplay: vi.fn(),\\\\n    deleteDisplay: vi.fn()\\\\n  }\\\\n}))\\\\n\\\\nvi.mock(\\\\'echarts\\\\', () => ({\\\\n  default: {\\\\n    init: vi.fn(() => ({\\\\n      setOption: vi.fn(),\\\\n      resize: vi.fn(),\\\\n      dispose: vi.fn()\\\\n    }))\\\\n  }\\\\n}))\\\\n\\\\nvi.mock(\\\\'element-plus\\\\', () => ({\\\\n  ElMessage: {\\\\n    success: vi.fn(),\\\\n    error: vi.fn(),\\\\n    warning: vi.fn(),\\\\n    info: vi.fn()\\\\n  },\\\\n  ElMessageBox: {\\\\n    confirm: vi.fn()\\\\n  }\\\\n}))\\\\n\\\\ndescribe(\\\\'KitchenManagement集成测试\\\\', () => {\\\\n  let wrapper: VueWrapper<any>\\\\n  let pinia: any\\\\n\\\\n  const mockStats = {\\\\n    activeTasks: 5,\\\\n    completedToday: 42,\\\\n    efficiencyRate: 85.5,\\\\n    averagePreparationTime: 900,\\\\n    totalEmployees: 10,\\\\n    onlineEmployees: 8,\\\\n    totalEquipment: 20,\\\\n    normalEquipment: 18,\\\\n    maintenanceEquipment: 2,\\\\n    lowStockItems: 3,\\\\n    expiredItems: 1\\\\n  }\\\\n\\\\n  const mockTasks: KitchenTask[] = [\\\\n    {\\\\n      id: \\\\'task-1\\\\',\\\\n      taskId: \\\\'TASK001\\\\',\\\\n      orderNo: \\\\'ORD001\\\\',\\\\n      itemName: \\\\'红烧肉\\\\',\\\\n      quantity: 2,\\\\n      station: \\\\'hot_dish\\\\',\\\\n      priority: \\\\'high\\\\',\\\\n      status: \\\\'pending\\\\',\\\\n      tableNumber: \\\\'A01\\\\',\\\\n      estimatedTime: 15,\\\\n      assignedTo: \\\\'emp-1\\\\',\\\\n      specialRequests: \\\\'少辣\\\\',\\\\n      createdAt: \\\\'2025-01-20T10:00:00Z\\\\'\\\\n    },\\\\n    {\\\\n      id: \\\\'task-2\\\\',\\\\n      taskId: \\\\'TASK002\\\\',\\\\n      orderNo: \\\\'ORD002\\\\',\\\\n      itemName: \\\\'清蒸鱼\\\\',\\\\n      quantity: 1,\\\\n      station: \\\\'hot_dish\\\\',\\\\n      priority: \\\\'normal\\\\',\\\\n      status: \\\\'preparing\\\\',\\\\n      tableNumber: \\\\'A02\\\\',\\\\n      estimatedTime: 20,\\\\n      assignedTo: \\\\'emp-2\\\\',\\\\n      createdAt: \\\\'2025-01-20T10:05:00Z\\\\'\\\\n    }\\\\n  ]\\\\n\\\\n  const mockEmployees: KitchenEmployee[] = [\\\\n    {\\\\n      id: \\\\'emp-1\\\\',\\\\n      employeeCode: \\\\'KITCHEN001\\\\',\\\\n      name: \\\\'张三\\\\',\\\\n      avatar: \\\\'https://example.com/avatar1.jpg\\\\',\\\\n      position: \\\\'chef\\\\',\\\\n      status: \\\\'online\\\\',\\\\n      phone: \\\\'13800138000\\\\',\\\\n      email: \\\\'zhangsan@example.com\\\\',\\\\n      hireDate: \\\\'2023-01-01\\\\',\\\\n      skills: [\\\\'炒菜\\\\', \\\\'炖汤\\\\', \\\\'切配\\\\'],\\\\n      certifications: [\\\\n        {\\\\n          id: \\\\'cert-1\\\\',\\\\n          name: \\\\'厨师证\\\\',\\\\n          issueDate: \\\\'2022-01-01\\\\',\\\\n          expiryDate: \\\\'2025-01-01\\\\',\\\\n          issuer: \\\\'北京市烹饪协会\\\\'\\\\n        }\\\\n      ],\\\\n      currentTasks: 2,\\\\n      totalTasksCompleted: 150,\\\\n      efficiency: 92.5,\\\\n      averageTime: 12,\\\\n      workSchedule: [],\\\\n      createdAt: \\\\'2023-01-01T00:00:00Z\\\\'\\\\n    },\\\\n    {\\\\n      id: \\\\'emp-2\\\\',\\\\n      employeeCode: \\\\'KITCHEN002\\\\',\\\\n      name: \\\\'李四\\\\',\\\\n      avatar: \\\\'https://example.com/avatar2.jpg\\\\',\\\\n      position: \\\\'line_cook\\\\',\\\\n      status: \\\\'busy\\\\',\\\\n      phone: \\\\'13900139000\\\\',\\\\n      email: \\\\'lisi@example.com\\\\',\\\\n      hireDate: \\\\'2023-06-01\\\\',\\\\n      skills: [\\\\'切配\\\\', \\\\'备菜\\\\'],\\\\n      certifications: [],\\\\n      currentTasks: 3,\\\\n      totalTasksCompleted: 120,\\\\n      efficiency: 88.0,\\\\n      averageTime: 15,\\\\n      workSchedule: [],\\\\n      createdAt: \\\\'2023-06-01T00:00:00Z\\\\'\\\\n    }\\\\n  ]\\\\n\\\\n  const mockInventory: KitchenInventory[] = [\\\\n    {\\\\n      id: \\\\'inv-1\\\\',\\\\n      itemCode: \\\\'ING001\\\\',\\\\n      name: \\\\'猪肉\\\\',\\\\n      category: \\\\'meat\\\\',\\\\n      unit: \\\\'公斤\\\\',\\\\n      quantity: 50,\\\\n      minQuantity: 10,\\\\n      maxQuantity: 100,\\\\n      unitPrice: 50,\\\\n      supplier: \\\\'供应商A\\\\',\\\\n      lastRestockDate: \\\\'2025-01-15\\\\',\\\\n      status: \\\\'normal\\\\',\\\\n      location: \\\\'冷藏库A\\\\',\\\\n      createdAt: \\\\'2025-01-01T00:00:00Z\\\\'\\\\n    }\\\\n  ]\\\\n\\\\n  beforeEach(() => {\\\\n    pinia = createPinia()\\\\n    setActivePinia(pinia)\\\\n\\\\n    vi.clearAllMocks()\\\\n\\\\n    wrapper = mount(KitchenManagement, {\\\\n      global: {\\\\n        plugins: [pinia, ElementPlus],\\\\n        stubs: {\\\\n          \\\\'el-card\\\\': true,\\\\n          \\\\'el-row\\\\': true,\\\\n          \\\\'el-col\\\\': true,\\\\n          \\\\'el-tabs\\\\': true,\\\\n          \\\\'el-tab-pane\\\\': true,\\\\n          \\\\'el-button\\\\': true,\\\\n          \\\\'el-button-group\\\\': true,\\\\n          \\\\'el-icon\\\\': true,\\\\n          \\\\'el-tag\\\\': true,\\\\n          \\\\'el-table\\\\': true,\\\\n          \\\\'el-table-column\\\\': true,\\\\n          \\\\'el-pagination\\\\': true,\\\\n          \\\\'el-dialog\\\\': true,\\\\n          \\\\'el-form\\\\': true,\\\\n          \\\\'el-form-item\\\\': true,\\\\n          \\\\'el-input\\\\': true,\\\\n          \\\\'el-input-number\\\\': true,\\\\n          \\\\'el-select\\\\': true,\\\\n          \\\\'el-option\\\\': true,\\\\n          \\\\'el-radio\\\\': true,\\\\n          \\\\'el-radio-group\\\\': true,\\\\n          \\\\'el-date-picker\\\\': true,\\\\n          \\\\'el-time-picker\\\\': true,\\\\n          \\\\'el-switch\\\\': true,\\\\n          \\\\'el-dropdown\\\\': true,\\\\n          \\\\'el-dropdown-menu\\\\': true,\\\\n          \\\\'el-dropdown-item\\\\': true,\\\\n          \\\\'el-rate\\\\': true,\\\\n          \\\\'el-avatar\\\\': true,\\\\n          \\\\'el-divider\\\\': true,\\\\n          \\\\'el-alert\\\\': true,\\\\n          \\\\'el-tooltip\\\\': true,\\\\n          \\\\'el-popover\\\\': true,\\\\n          \\\\'el-progress\\\\': true,\\\\n          \\\\'el-statistic\\\\': true,\\\\n          \\\\'el-badge\\\\': true,\\\\n          \\\\'el-empty\\\\': true\\\\n        }\\\\n      }\\\\n    })\\\\n  })\\\\n\\\\n  afterEach(() => {\\\\n    wrapper.unmount()\\\\n  })\\\\n\\\\n  describe(\\\\'组件与API集成\\\\', () => {\\\\n    it(\\\\'应该成功加载统计数据\\\\', async () => {\\\\n      vi.mocked(kitchenAPI.getStats).mockResolvedValue({\\\\n        success: true,\\\\n        data: mockStats\\\\n      })\\\\n\\\\n      const { loadStats } = useKitchen()\\\\n      await loadStats()\\\\n\\\\n      expect(kitchenAPI.getStats).toHaveBeenCalled()\\\\n      expect(wrapper.vm.stats).toEqual(mockStats)\\\\n    })\\\\n\\\\n    it(\\\\'应该成功加载任务列表\\\\', async () => {\\\\n      vi.mocked(kitchenAPI.getTasks).mockResolvedValue({\\\\n        success: true,\\\\n        data: {\\\\n          items: mockTasks,\\\\n          pagination: { page: 1, limit: 20, total: 2, totalPages: 1 }\\\\n        }\\\\n      })\\\\n\\\\n      const { loadTasks } = useKitchen()\\\\n      await loadTasks()\\\\n\\\\n      expect(kitchenAPI.getTasks).toHaveBeenCalled()\\\\n      expect(wrapper.vm.tasks).toEqual(mockTasks)\\\\n    })\\\\n\\\\n    it(\\\\'应该成功加载员工列表\\\\', async () => {\\\\n      vi.mocked(kitchenAPI.getEmployees).mockResolvedValue({\\\\n        success: true,\\\\n        data: {\\\\n          items: mockEmployees,\\\\n          pagination: { page: 1, limit: 20, total: 2, totalPages: 1 }\\\\n        }\\\\n      })\\\\n\\\\n      const { loadEmployees } = useKitchen()\\\\n      await loadEmployees()\\\\n\\\\n      expect(kitchenAPI.getEmployees).toHaveBeenCalled()\\\\n      expect(wrapper.vm.employees).toEqual(mockEmployees)\\\\n    })\\\\n\\\\n    it(\\\\'应该成功加载库存列表\\\\', async () => {\\\\n      vi.mocked(kitchenAPI.getInventory).mockResolvedValue({\\\\n        success: true,\\\\n        data: {\\\\n          items: mockInventory,\\\\n          pagination: { page: 1, limit: 20, total: 1, totalPages: 1 }\\\\n        }\\\\n      })\\\\n\\\\n      const { loadInventory } = useKitchen()\\\\n      await loadInventory()\\\\n\\\\n      expect(kitchenAPI.getInventory).toHaveBeenCalled()\\\\n      expect(wrapper.vm.inventory).toEqual(mockInventory)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'任务管理集成\\\\', () => {\\\\n    it(\\\\'应该成功创建任务\\\\', async () => {\\\\n      const newTask = {\\\\n        taskId: \\\\'TASK003\\\\',\\\\n        orderNo: \\\\'ORD003\\\\',\\\\n        itemName: \\\\'宫保鸡丁\\\\',\\\\n        quantity: 1,\\\\n        station: \\\\'hot_dish\\\\' as TaskStation,\\\\n        priority: \\\\'normal\\\\' as TaskPriority,\\\\n        status: \\\\'pending\\\\' as TaskStatus,\\\\n        tableNumber: \\\\'A03\\\\',\\\\n        estimatedTime: 18,\\\\n        createdAt: \\\\'2025-01-20T10:10:00Z\\\\'\\\\n      }\\\\n\\\\n      vi.mocked(kitchenAPI.createTask).mockResolvedValue({\\\\n        success: true,\\\\n        data: { ...newTask, id: \\\\'task-3\\\\' }\\\\n      })\\\\n\\\\n      const { createTask } = useKitchen()\\\\n      await createTask(newTask)\\\\n\\\\n      expect(kitchenAPI.createTask).toHaveBeenCalledWith(newTask)\\\\n    })\\\\n\\\\n    it(\\\\'应该成功更新任务状态\\\\', async () => {\\\\n      const newStatus: TaskStatus = \\\\'ready\\\\'\\\\n      const updatedTask = {\\\\n        ...mockTasks[0],\\\\n        status: newStatus\\\\n      }\\\\n\\\\n      vi.mocked(kitchenAPI.updateTaskStatus).mockResolvedValue({\\\\n        success: true,\\\\n        data: updatedTask\\\\n      })\\\\n\\\\n      const { updateTaskStatus } = useKitchen()\\\\n      await updateTaskStatus(\\\\'task-1\\\\', newStatus)\\\\n\\\\n      expect(kitchenAPI.updateTaskStatus).toHaveBeenCalledWith(\\\\'task-1\\\\', newStatus)\\\\n    })\\\\n\\\\n    it(\\\\'应该成功分配任务\\\\', async () => {\\\\n      const assignedTask = {\\\\n        ...mockTasks[0],\\\\n        assignedTo: \\\\'emp-2\\\\'\\\\n      }\\\\n\\\\n      vi.mocked(kitchenAPI.assignTask).mockResolvedValue({\\\\n        success: true,\\\\n        data: assignedTask\\\\n      })\\\\n\\\\n      const { assignTask } = useKitchen()\\\\n      await assignTask(\\\\'task-1\\\\', \\\\'emp-2\\\\')\\\\n\\\\n      expect(kitchenAPI.assignTask).toHaveBeenCalledWith(\\\\'task-1\\\\', \\\\'emp-2\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该成功删除任务\\\\', async () => {\\\\n      vi.mocked(kitchenAPI.deleteTask).mockResolvedValue({\\\\n        success: true,\\\\n        data: true\\\\n      })\\\\n\\\\n      const { deleteTask } = useKitchen()\\\\n      await deleteTask(\\\\'task-1\\\\')\\\\n\\\\n      expect(kitchenAPI.deleteTask).toHaveBeenCalledWith(\\\\'task-1\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该支持任务筛选\\\\', async () => {\\\\n      vi.mocked(kitchenAPI.getTasks).mockResolvedValue({\\\\n        success: true,\\\\n        data: {\\\\n          items: mockTasks.filter(task => task.status === \\\\'pending\\\\'),\\\\n          pagination: { page: 1, limit: 20, total: 1, totalPages: 1 }\\\\n        }\\\\n      })\\\\n\\\\n      const { loadTasks } = useKitchen()\\\\n      await loadTasks({ status: \\\\'pending\\\\' as TaskStatus })\\\\n\\\\n      expect(kitchenAPI.getTasks).toHaveBeenCalledWith({ status: \\\\'pending\\\\' })\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'员工管理集成\\\\', () => {\\\\n    it(\\\\'应该成功创建员工\\\\', async () => {\\\\n      const newEmployee = {\\\\n        employeeCode: \\\\'KITCHEN003\\\\',\\\\n        name: \\\\'王五\\\\',\\\\n        position: \\\\'line_cook\\\\',\\\\n        status: \\\\'online\\\\' as EmployeeStatus,\\\\n        phone: \\\\'13700137000\\\\',\\\\n        email: \\\\'wangwu@example.com\\\\',\\\\n        hireDate: \\\\'2025-01-20\\\\',\\\\n        skills: [\\\\'切配\\\\'],\\\\n        certifications: [],\\\\n        currentTasks: 0,\\\\n        totalTasksCompleted: 0,\\\\n        efficiency: 0,\\\\n        averageTime: 0,\\\\n        workSchedule: []\\\\n      }\\\\n\\\\n      vi.mocked(kitchenAPI.createEmployee).mockResolvedValue({\\\\n        success: true,\\\\n        data: { ...newEmployee, id: \\\\'emp-3\\\\', createdAt: \\\\'2025-01-20T00:00:00Z\\\\' }\\\\n      })\\\\n\\\\n      const { createEmployee } = useKitchen()\\\\n      await createEmployee(newEmployee)\\\\n\\\\n      expect(kitchenAPI.createEmployee).toHaveBeenCalledWith(newEmployee)\\\\n    })\\\\n\\\\n    it(\\\\'应该成功更新员工状态\\\\', async () => {\\\\n      const newStatus: EmployeeStatus = \\\\'break\\\\'\\\\n      const updatedEmployee = {\\\\n        ...mockEmployees[0],\\\\n        status: newStatus\\\\n      }\\\\n\\\\n      vi.mocked(kitchenAPI.updateEmployeeStatus).mockResolvedValue({\\\\n        success: true,\\\\n        data: updatedEmployee\\\\n      })\\\\n\\\\n      const { updateEmployeeStatus } = useKitchen()\\\\n      await updateEmployeeStatus(\\\\'emp-1\\\\', newStatus)\\\\n\\\\n      expect(kitchenAPI.updateEmployeeStatus).toHaveBeenCalledWith(\\\\'emp-1\\\\', newStatus)\\\\n    })\\\\n\\\\n    it(\\\\'应该成功删除员工\\\\', async () => {\\\\n      vi.mocked(kitchenAPI.deleteEmployee).mockResolvedValue({\\\\n        success: true,\\\\n        data: true\\\\n      })\\\\n\\\\n      const { deleteEmployee } = useKitchen()\\\\n      await deleteEmployee(\\\\'emp-1\\\\')\\\\n\\\\n      expect(kitchenAPI.deleteEmployee).toHaveBeenCalledWith(\\\\'emp-1\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该支持员工筛选\\\\', async () => {\\\\n      vi.mocked(kitchenAPI.getEmployees).mockResolvedValue({\\\\n        success: true,\\\\n        data: {\\\\n          items: mockEmployees.filter(emp => emp.status === \\\\'online\\\\'),\\\\n          pagination: { page: 1, limit: 20, total: 1, totalPages: 1 }\\\\n        }\\\\n      })\\\\n\\\\n      const { loadEmployees } = useKitchen()\\\\n      await loadEmployees({ status: \\\\'online\\\\' as EmployeeStatus })\\\\n\\\\n      expect(kitchenAPI.getEmployees).toHaveBeenCalledWith({ status: \\\\'online\\\\' })\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'库存管理集成\\\\', () => {\\\\n    it(\\\\'应该成功创建库存项\\\\', async () => {\\\\n      const newItem = {\\\\n        itemCode: \\\\'ING002\\\\',\\\\n        name: \\\\'鸡肉\\\\',\\\\n        category: \\\\'meat\\\\',\\\\n        unit: \\\\'公斤\\\\',\\\\n        quantity: 30,\\\\n        minQuantity: 10,\\\\n        maxQuantity: 100,\\\\n        unitPrice: 30,\\\\n        supplier: \\\\'供应商B\\\\',\\\\n        lastRestockDate: \\\\'2025-01-20\\\\',\\\\n        status: \\\\'normal\\\\',\\\\n        location: \\\\'冷藏库B\\\\'\\\\n      }\\\\n\\\\n      vi.mocked(kitchenAPI.createInventoryItem).mockResolvedValue({\\\\n        success: true,\\\\n        data: { ...newItem, id: \\\\'inv-2\\\\', createdAt: \\\\'2025-01-20T00:00:00Z\\\\' }\\\\n      })\\\\n\\\\n      const { createInventoryItem } = useKitchen()\\\\n      await createInventoryItem(newItem)\\\\n\\\\n      expect(kitchenAPI.createInventoryItem).toHaveBeenCalledWith(newItem)\\\\n    })\\\\n\\\\n    it(\\\\'应该成功更新库存项\\\\', async () => {\\\\n      const updatedItem = {\\\\n        ...mockInventory[0],\\\\n        quantity: 60\\\\n      }\\\\n\\\\n      vi.mocked(kitchenAPI.updateInventoryItem).mockResolvedValue({\\\\n        success: true,\\\\n        data: updatedItem\\\\n      })\\\\n\\\\n      const { updateInventoryItem } = useKitchen()\\\\n      await updateInventoryItem(\\\\'inv-1\\\\', updatedItem)\\\\n\\\\n      expect(kitchenAPI.updateInventoryItem).toHaveBeenCalledWith(\\\\'inv-1\\\\', updatedItem)\\\\n    })\\\\n\\\\n    it(\\\\'应该成功删除库存项\\\\', async () => {\\\\n      vi.mocked(kitchenAPI.deleteInventoryItem).mockResolvedValue({\\\\n        success: true,\\\\n        data: true\\\\n      })\\\\n\\\\n      const { deleteInventoryItem } = useKitchen()\\\\n      await deleteInventoryItem(\\\\'inv-1\\\\')\\\\n\\\\n      expect(kitchenAPI.deleteInventoryItem).toHaveBeenCalledWith(\\\\'inv-1\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该成功补货\\\\', async () => {\\\\n      const restockedItem = {\\\\n        ...mockInventory[0],\\\\n        quantity: 80\\\\n      }\\\\n\\\\n      vi.mocked(kitchenAPI.restockInventory).mockResolvedValue({\\\\n        success: true,\\\\n        data: restockedItem\\\\n      })\\\\n\\\\n      const { restockInventory } = useKitchen()\\\\n      await restockInventory(\\\\'inv-1\\\\', 30)\\\\n\\\\n      expect(kitchenAPI.restockInventory).toHaveBeenCalledWith(\\\\'inv-1\\\\', 30)\\\\n    })\\\\n\\\\n    it(\\\\'应该支持库存筛选\\\\', async () => {\\\\n      vi.mocked(kitchenAPI.getInventory).mockResolvedValue({\\\\n        success: true,\\\\n        data: {\\\\n          items: mockInventory.filter(item => item.category === \\\\'meat\\\\'),\\\\n          pagination: { page: 1, limit: 20, total: 1, totalPages: 1 }\\\\n        }\\\\n      })\\\\n\\\\n      const { loadInventory } = useKitchen()\\\\n      await loadInventory({ category: \\\\'meat\\\\' })\\\\n\\\\n      expect(kitchenAPI.getInventory).toHaveBeenCalledWith({ category: \\\\'meat\\\\' })\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'数据分析集成\\\\', () => {\\\\n    it(\\\\'应该成功加载分析数据\\\\', async () => {\\\\n      const mockAnalytics = {\\\\n        taskDistribution: [\\\\n          { status: \\\\'pending\\\\', count: 5, percentage: 25 },\\\\n          { status: \\\\'preparing\\\\', count: 3, percentage: 15 }\\\\n        ],\\\\n        stationDistribution: [\\\\n          { station: \\\\'hot_dish\\\\', count: 10, percentage: 50 }\\\\n        ],\\\\n        staffEfficiency: [\\\\n          { employeeId: \\\\'emp-1\\\\', employeeName: \\\\'张三\\\\', tasksCompleted: 50, averageTime: 12, efficiency: 92.5 }\\\\n        ],\\\\n        peakHours: [\\\\n          { hour: 12, taskCount: 20, orderCount: 15 }\\\\n        ],\\\\n        equipmentUtilization: [\\\\n          { equipmentId: \\\\'eq-1\\\\', equipmentName: \\\\'蒸柜\\\\', usageHours: 8, utilizationRate: 80 }\\\\n        ],\\\\n        inventoryTrends: [\\\\n          { date: \\\\'2025-01-20\\\\', itemCount: 100, value: 50000 }\\\\n        ]\\\\n      }\\\\n\\\\n      vi.mocked(kitchenAPI.getAnalytics).mockResolvedValue({\\\\n        success: true,\\\\n        data: mockAnalytics\\\\n      })\\\\n\\\\n      const { loadAnalytics } = useKitchen()\\\\n      await loadAnalytics({ startDate: \\\\'2025-01-01\\\\', endDate: \\\\'2025-01-20\\\\' })\\\\n\\\\n      expect(kitchenAPI.getAnalytics).toHaveBeenCalledWith({\\\\n        startDate: \\\\'2025-01-01\\\\',\\\\n        endDate: \\\\'2025-01-20\\\\'\\\\n      })\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'数据刷新集成\\\\', () => {\\\\n    it(\\\\'应该成功刷新所有数据\\\\', async () => {\\\\n      vi.mocked(kitchenAPI.getStats).mockResolvedValue({\\\\n        success: true,\\\\n        data: mockStats\\\\n      })\\\\n      vi.mocked(kitchenAPI.getTasks).mockResolvedValue({\\\\n        success: true,\\\\n        data: {\\\\n          items: mockTasks,\\\\n          pagination: { page: 1, limit: 20, total: 2, totalPages: 1 }\\\\n        }\\\\n      })\\\\n      vi.mocked(kitchenAPI.getEmployees).mockResolvedValue({\\\\n        success: true,\\\\n        data: {\\\\n          items: mockEmployees,\\\\n          pagination: { page: 1, limit: 20, total: 2, totalPages: 1 }\\\\n        }\\\\n      })\\\\n\\\\n      const { refreshData } = useKitchen()\\\\n      await refreshData()\\\\n\\\\n      expect(kitchenAPI.getStats).toHaveBeenCalled()\\\\n      expect(kitchenAPI.getTasks).toHaveBeenCalled()\\\\n      expect(kitchenAPI.getEmployees).toHaveBeenCalled()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'错误处理集成\\\\', () => {\\\\n    it(\\\\'应该正确处理API错误\\\\', async () => {\\\\n      vi.mocked(kitchenAPI.getTasks).mockRejectedValue(new Error(\\\\'网络错误\\\\'))\\\\n\\\\n      const { loadTasks } = useKitchen()\\\\n      await loadTasks()\\\\n\\\\n      expect(kitchenAPI.getTasks).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该在加载失败时显示错误消息\\\\', async () => {\\\\n      vi.mocked(kitchenAPI.getTasks).mockRejectedValue(new Error(\\\\'加载失败\\\\'))\\\\n\\\\n      const { loadTasks } = useKitchen()\\\\n      await loadTasks()\\\\n\\\\n      expect(wrapper.vm.loading).toBe(false)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'状态管理集成\\\\', () => {\\\\n    it(\\\\'应该正确管理加载状态\\\\', async () => {\\\\n      const { loading } = useKitchen()\\\\n      expect(loading.value).toBe(false)\\\\n    })\\\\n\\\\n    it(\\\\'应该在加载时更新状态\\\\', async () => {\\\\n      vi.mocked(kitchenAPI.getTasks).mockImplementation(() => {\\\\n        const { loading } = useKitchen()\\\\n        loading.value = true\\\\n        return Promise.resolve({\\\\n          success: true,\\\\n          data: {\\\\n            items: mockTasks,\\\\n            pagination: { page: 1, limit: 20, total: 2, totalPages: 1 }\\\\n          }\\\\n        })\\\\n      })\\\\n\\\\n      const { loadTasks, loading } = useKitchen()\\\\n      await loadTasks()\\\\n\\\\n      expect(loading.value).toBe(false)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'分页集成\\\\', () => {\\\\n    it(\\\\'应该正确处理分页\\\\', async () => {\\\\n      vi.mocked(kitchenAPI.getTasks).mockResolvedValue({\\\\n        success: true,\\\\n        data: {\\\\n          items: mockTasks,\\\\n          pagination: { page: 2, limit: 20, total: 2, totalPages: 1 }\\\\n        }\\\\n      })\\\\n\\\\n      const { loadTasks } = useKitchen()\\\\n      await loadTasks({ page: 2, limit: 20 })\\\\n\\\\n      expect(kitchenAPI.getTasks).toHaveBeenCalledWith({ page: 2, limit: 20 })\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'图表集成\\\\', () => {\\\\n    it(\\\\'应该正确初始化图表\\\\', async () => {\\\\n      await wrapper.vm.handleTabChange(\\\\'analytics\\\\')\\\\n\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该在数据更新时刷新图表\\\\', async () => {\\\\n      vi.mocked(kitchenAPI.getAnalytics).mockResolvedValue({\\\\n        success: true,\\\\n        data: {\\\\n          taskDistribution: [],\\\\n          stationDistribution: [],\\\\n          staffEfficiency: [],\\\\n          peakHours: [],\\\\n          equipmentUtilization: [],\\\\n          inventoryTrends: []\\\\n        }\\\\n      })\\\\n\\\\n      await wrapper.vm.handleTabChange(\\\\'analytics\\\\')\\\\n\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'业务流程集成\\\\', () => {\\\\n    it(\\\\'应该完整执行任务创建流程\\\\', async () => {\\\\n      const newTask = {\\\\n        taskId: \\\\'TASK003\\\\',\\\\n        orderNo: \\\\'ORD003\\\\',\\\\n        itemName: \\\\'宫保鸡丁\\\\',\\\\n        quantity: 1,\\\\n        station: \\\\'hot_dish\\\\' as TaskStation,\\\\n        priority: \\\\'normal\\\\' as TaskPriority,\\\\n        status: \\\\'pending\\\\' as TaskStatus,\\\\n        tableNumber: \\\\'A03\\\\',\\\\n        estimatedTime: 18,\\\\n        createdAt: \\\\'2025-01-20T10:10:00Z\\\\'\\\\n      }\\\\n\\\\n      vi.mocked(kitchenAPI.createTask).mockResolvedValue({\\\\n        success: true,\\\\n        data: { ...newTask, id: \\\\'task-3\\\\' }\\\\n      })\\\\n\\\\n      const { createTask, loadTasks } = useKitchen()\\\\n      await createTask(newTask)\\\\n      await loadTasks()\\\\n\\\\n      expect(kitchenAPI.createTask).toHaveBeenCalledWith(newTask)\\\\n      expect(kitchenAPI.getTasks).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该完整执行任务分配流程\\\\', async () => {\\\\n      vi.mocked(kitchenAPI.assignTask).mockResolvedValue({\\\\n        success: true,\\\\n        data: { ...mockTasks[0], assignedTo: \\\\'emp-2\\\\' }\\\\n      })\\\\n\\\\n      const { assignTask, updateEmployeeStatus } = useKitchen()\\\\n      await assignTask(\\\\'task-1\\\\', \\\\'emp-2\\\\')\\\\n      await updateEmployeeStatus(\\\\'emp-2\\\\', \\\\'busy\\\\' as EmployeeStatus)\\\\n\\\\n      expect(kitchenAPI.assignTask).toHaveBeenCalledWith(\\\\'task-1\\\\', \\\\'emp-2\\\\')\\\\n      expect(kitchenAPI.updateEmployeeStatus).toHaveBeenCalledWith(\\\\'emp-2\\\\', \\\\'busy\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该完整执行任务状态更新流程\\\\', async () => {\\\\n      const statuses: TaskStatus[] = [\\\\'pending\\\\', \\\\'preparing\\\\', \\\\'ready\\\\', \\\\'served\\\\']\\\\n\\\\n      for (const status of statuses) {\\\\n        vi.mocked(kitchenAPI.updateTaskStatus).mockResolvedValue({\\\\n          success: true,\\\\n          data: { ...mockTasks[0], status }\\\\n        })\\\\n\\\\n        const { updateTaskStatus } = useKitchen()\\\\n        await updateTaskStatus(\\\\'task-1\\\\', status)\\\\n\\\\n        expect(kitchenAPI.updateTaskStatus).toHaveBeenCalledWith(\\\\'task-1\\\\', status)\\\\n      }\\\\n    })\\\\n  })\\\\n})\\\\n\",\"originAcceptText\":\"/**\\n * @fileoverview YYC³餐饮管理系统 - KitchenManagement集成测试\\n * @description 测试KitchenManagement组件与API、composable的集成\\n * @module KitchenManagement.integration.test\\n * @author YYC³\\n * @version 1.0.0\\n * @created 2025-01-20\\n */\\n\\nimport { describe, it, expect, beforeEach, vi, afterEach } from 'vitest'\\nimport { mount, VueWrapper } from '@vue/test-utils'\\nimport { createPinia, setActivePinia } from 'pinia'\\nimport ElementPlus from 'element-plus'\\nimport * as echarts from 'echarts'\\nimport KitchenManagement from '@/views/KitchenManagement.vue'\\nimport { useKitchen } from '@/composables/useKitchen'\\nimport { kitchenAPI } from '@/api/kitchen'\\nimport type {\\n  KitchenTask,\\n  KitchenEmployee,\\n  KitchenInventory,\\n  TaskStatus,\\n  EmployeeStatus,\\n  TaskStation,\\n  TaskPriority\\n} from '@/types/kitchen'\\n\\nvi.mock('@/api/kitchen', () => ({\\n  kitchenAPI: {\\n    getStats: vi.fn(),\\n    getAnalytics: vi.fn(),\\n    getEquipment: vi.fn(),\\n    createEquipment: vi.fn(),\\n    updateEquipment: vi.fn(),\\n    deleteEquipment: vi.fn(),\\n    getEmployees: vi.fn(),\\n    createEmployee: vi.fn(),\\n    updateEmployee: vi.fn(),\\n    deleteEmployee: vi.fn(),\\n    updateEmployeeStatus: vi.fn(),\\n    getTasks: vi.fn(),\\n    createTask: vi.fn(),\\n    updateTask: vi.fn(),\\n    deleteTask: vi.fn(),\\n    updateTaskStatus: vi.fn(),\\n    assignTask: vi.fn(),\\n    getInventory: vi.fn(),\\n    createInventoryItem: vi.fn(),\\n    updateInventoryItem: vi.fn(),\\n    deleteInventoryItem: vi.fn(),\\n    restockInventory: vi.fn(),\\n    getHygieneRecords: vi.fn(),\\n    createHygieneRecord: vi.fn(),\\n    updateHygieneRecord: vi.fn(),\\n    getSafetyRecords: vi.fn(),\\n    createSafetyRecord: vi.fn(),\\n    updateSafetyRecord: vi.fn(),\\n    getDisplays: vi.fn(),\\n    createDisplay: vi.fn(),\\n    updateDisplay: vi.fn(),\\n    deleteDisplay: vi.fn()\\n  }\\n}))\\n\\nvi.mock('echarts', () => ({\\n  default: {\\n    init: vi.fn(() => ({\\n      setOption: vi.fn(),\\n      resize: vi.fn(),\\n      dispose: vi.fn()\\n    }))\\n  }\\n}))\\n\\nvi.mock('element-plus', () => ({\\n  ElMessage: {\\n    success: vi.fn(),\\n    error: vi.fn(),\\n    warning: vi.fn(),\\n    info: vi.fn()\\n  },\\n  ElMessageBox: {\\n    confirm: vi.fn()\\n  }\\n}))\\n\\ndescribe('KitchenManagement集成测试', () => {\\n  let wrapper: VueWrapper<any>\\n  let pinia: any\\n\\n  const mockStats = {\\n    activeTasks: 5,\\n    completedToday: 42,\\n    efficiencyRate: 85.5,\\n    averagePreparationTime: 900,\\n    totalEmployees: 10,\\n    onlineEmployees: 8,\\n    totalEquipment: 20,\\n    normalEquipment: 18,\\n    maintenanceEquipment: 2,\\n    lowStockItems: 3,\\n    expiredItems: 1\\n  }\\n\\n  const mockTasks: KitchenTask[] = [\\n    {\\n      id: 'task-1',\\n      taskId: 'TASK001',\\n      orderNo: 'ORD001',\\n      itemName: '红烧肉',\\n      quantity: 2,\\n      station: 'hot_dish',\\n      priority: 'high',\\n      status: 'pending',\\n      tableNumber: 'A01',\\n      estimatedTime: 15,\\n      assignedTo: 'emp-1',\\n      specialRequests: '少辣',\\n      createdAt: '2025-01-20T10:00:00Z'\\n    },\\n    {\\n      id: 'task-2',\\n      taskId: 'TASK002',\\n      orderNo: 'ORD002',\\n      itemName: '清蒸鱼',\\n      quantity: 1,\\n      station: 'hot_dish',\\n      priority: 'normal',\\n      status: 'preparing',\\n      tableNumber: 'A02',\\n      estimatedTime: 20,\\n      assignedTo: 'emp-2',\\n      createdAt: '2025-01-20T10:05:00Z'\\n    }\\n  ]\\n\\n  const mockEmployees: KitchenEmployee[] = [\\n    {\\n      id: 'emp-1',\\n      employeeCode: 'KITCHEN001',\\n      name: '张三',\\n      avatar: 'https://example.com/avatar1.jpg',\\n      position: 'chef',\\n      status: 'online',\\n      phone: '13800138000',\\n      email: 'zhangsan@example.com',\\n      hireDate: '2023-01-01',\\n      skills: ['炒菜', '炖汤', '切配'],\\n      certifications: [\\n        {\\n          id: 'cert-1',\\n          name: '厨师证',\\n          issueDate: '2022-01-01',\\n          expiryDate: '2025-01-01',\\n          issuer: '北京市烹饪协会'\\n        }\\n      ],\\n      currentTasks: 2,\\n      totalTasksCompleted: 150,\\n      efficiency: 92.5,\\n      averageTime: 12,\\n      workSchedule: [],\\n      createdAt: '2023-01-01T00:00:00Z'\\n    },\\n    {\\n      id: 'emp-2',\\n      employeeCode: 'KITCHEN002',\\n      name: '李四',\\n      avatar: 'https://example.com/avatar2.jpg',\\n      position: 'line_cook',\\n      status: 'busy',\\n      phone: '13900139000',\\n      email: 'lisi@example.com',\\n      hireDate: '2023-06-01',\\n      skills: ['切配', '备菜'],\\n      certifications: [],\\n      currentTasks: 3,\\n      totalTasksCompleted: 120,\\n      efficiency: 88.0,\\n      averageTime: 15,\\n      workSchedule: [],\\n      createdAt: '2023-06-01T00:00:00Z'\\n    }\\n  ]\\n\\n  const mockInventory: KitchenInventory[] = [\\n    {\\n      id: 'inv-1',\\n      itemCode: 'ING001',\\n      name: '猪肉',\\n      category: 'meat',\\n      unit: '公斤',\\n      quantity: 50,\\n      minQuantity: 10,\\n      maxQuantity: 100,\\n      unitPrice: 50,\\n      supplier: '供应商A',\\n      lastRestockDate: '2025-01-15',\\n      status: 'normal',\\n      location: '冷藏库A',\\n      createdAt: '2025-01-01T00:00:00Z'\\n    }\\n  ]\\n\\n  beforeEach(() => {\\n    pinia = createPinia()\\n    setActivePinia(pinia)\\n\\n    vi.clearAllMocks()\\n\\n    wrapper = mount(KitchenManagement, {\\n      global: {\\n        plugins: [pinia, ElementPlus],\\n        stubs: {\\n          'el-card': true,\\n          'el-row': true,\\n          'el-col': true,\\n          'el-tabs': true,\\n          'el-tab-pane': true,\\n          'el-button': true,\\n          'el-button-group': true,\\n          'el-icon': true,\\n          'el-tag': true,\\n          'el-table': true,\\n          'el-table-column': true,\\n          'el-pagination': true,\\n          'el-dialog': true,\\n          'el-form': true,\\n          'el-form-item': true,\\n          'el-input': true,\\n          'el-input-number': true,\\n          'el-select': true,\\n          'el-option': true,\\n          'el-radio': true,\\n          'el-radio-group': true,\\n          'el-date-picker': true,\\n          'el-time-picker': true,\\n          'el-switch': true,\\n          'el-dropdown': true,\\n          'el-dropdown-menu': true,\\n          'el-dropdown-item': true,\\n          'el-rate': true,\\n          'el-avatar': true,\\n          'el-divider': true,\\n          'el-alert': true,\\n          'el-tooltip': true,\\n          'el-popover': true,\\n          'el-progress': true,\\n          'el-statistic': true,\\n          'el-badge': true,\\n          'el-empty': true\\n        }\\n      }\\n    })\\n  })\\n\\n  afterEach(() => {\\n    wrapper.unmount()\\n  })\\n\\n  describe('组件与API集成', () => {\\n    it('应该成功加载统计数据', async () => {\\n      vi.mocked(kitchenAPI.getStats).mockResolvedValue({\\n        success: true,\\n        data: mockStats\\n      })\\n\\n      const { loadStats } = useKitchen()\\n      await loadStats()\\n\\n      expect(kitchenAPI.getStats).toHaveBeenCalled()\\n      expect(wrapper.vm.stats).toEqual(mockStats)\\n    })\\n\\n    it('应该成功加载任务列表', async () => {\\n      vi.mocked(kitchenAPI.getTasks).mockResolvedValue({\\n        success: true,\\n        data: {\\n          items: mockTasks,\\n          pagination: { page: 1, limit: 20, total: 2, totalPages: 1 }\\n        }\\n      })\\n\\n      const { loadTasks } = useKitchen()\\n      await loadTasks()\\n\\n      expect(kitchenAPI.getTasks).toHaveBeenCalled()\\n      expect(wrapper.vm.tasks).toEqual(mockTasks)\\n    })\\n\\n    it('应该成功加载员工列表', async () => {\\n      vi.mocked(kitchenAPI.getEmployees).mockResolvedValue({\\n        success: true,\\n        data: {\\n          items: mockEmployees,\\n          pagination: { page: 1, limit: 20, total: 2, totalPages: 1 }\\n        }\\n      })\\n\\n      const { loadEmployees } = useKitchen()\\n      await loadEmployees()\\n\\n      expect(kitchenAPI.getEmployees).toHaveBeenCalled()\\n      expect(wrapper.vm.employees).toEqual(mockEmployees)\\n    })\\n\\n    it('应该成功加载库存列表', async () => {\\n      vi.mocked(kitchenAPI.getInventory).mockResolvedValue({\\n        success: true,\\n        data: {\\n          items: mockInventory,\\n          pagination: { page: 1, limit: 20, total: 1, totalPages: 1 }\\n        }\\n      })\\n\\n      const { loadInventory } = useKitchen()\\n      await loadInventory()\\n\\n      expect(kitchenAPI.getInventory).toHaveBeenCalled()\\n      expect(wrapper.vm.inventory).toEqual(mockInventory)\\n    })\\n  })\\n\\n  describe('任务管理集成', () => {\\n    it('应该成功创建任务', async () => {\\n      const newTask = {\\n        taskId: 'TASK003',\\n        orderNo: 'ORD003',\\n        itemName: '宫保鸡丁',\\n        quantity: 1,\\n        station: 'hot_dish' as TaskStation,\\n        priority: 'normal' as TaskPriority,\\n        status: 'pending' as TaskStatus,\\n        tableNumber: 'A03',\\n        estimatedTime: 18,\\n        createdAt: '2025-01-20T10:10:00Z'\\n      }\\n\\n      vi.mocked(kitchenAPI.createTask).mockResolvedValue({\\n        success: true,\\n        data: { ...newTask, id: 'task-3' }\\n      })\\n\\n      const { createTask } = useKitchen()\\n      await createTask(newTask)\\n\\n      expect(kitchenAPI.createTask).toHaveBeenCalledWith(newTask)\\n    })\\n\\n    it('应该成功更新任务状态', async () => {\\n      const newStatus: TaskStatus = 'ready'\\n      const updatedTask = {\\n        ...mockTasks[0],\\n        status: newStatus\\n      }\\n\\n      vi.mocked(kitchenAPI.updateTaskStatus).mockResolvedValue({\\n        success: true,\\n        data: updatedTask\\n      })\\n\\n      const { updateTaskStatus } = useKitchen()\\n      await updateTaskStatus('task-1', newStatus)\\n\\n      expect(kitchenAPI.updateTaskStatus).toHaveBeenCalledWith('task-1', newStatus)\\n    })\\n\\n    it('应该成功分配任务', async () => {\\n      const assignedTask = {\\n        ...mockTasks[0],\\n        assignedTo: 'emp-2'\\n      }\\n\\n      vi.mocked(kitchenAPI.assignTask).mockResolvedValue({\\n        success: true,\\n        data: assignedTask\\n      })\\n\\n      const { assignTask } = useKitchen()\\n      await assignTask('task-1', 'emp-2')\\n\\n      expect(kitchenAPI.assignTask).toHaveBeenCalledWith('task-1', 'emp-2')\\n    })\\n\\n    it('应该成功删除任务', async () => {\\n      vi.mocked(kitchenAPI.deleteTask).mockResolvedValue({\\n        success: true,\\n        data: true\\n      })\\n\\n      const { deleteTask } = useKitchen()\\n      await deleteTask('task-1')\\n\\n      expect(kitchenAPI.deleteTask).toHaveBeenCalledWith('task-1')\\n    })\\n\\n    it('应该支持任务筛选', async () => {\\n      vi.mocked(kitchenAPI.getTasks).mockResolvedValue({\\n        success: true,\\n        data: {\\n          items: mockTasks.filter(task => task.status === 'pending'),\\n          pagination: { page: 1, limit: 20, total: 1, totalPages: 1 }\\n        }\\n      })\\n\\n      const { loadTasks } = useKitchen()\\n      await loadTasks({ status: 'pending' as TaskStatus })\\n\\n      expect(kitchenAPI.getTasks).toHaveBeenCalledWith({ status: 'pending' })\\n    })\\n  })\\n\\n  describe('员工管理集成', () => {\\n    it('应该成功创建员工', async () => {\\n      const newEmployee = {\\n        employeeCode: 'KITCHEN003',\\n        name: '王五',\\n        position: 'line_cook',\\n        status: 'online' as EmployeeStatus,\\n        phone: '13700137000',\\n        email: 'wangwu@example.com',\\n        hireDate: '2025-01-20',\\n        skills: ['切配'],\\n        certifications: [],\\n        currentTasks: 0,\\n        totalTasksCompleted: 0,\\n        efficiency: 0,\\n        averageTime: 0,\\n        workSchedule: []\\n      }\\n\\n      vi.mocked(kitchenAPI.createEmployee).mockResolvedValue({\\n        success: true,\\n        data: { ...newEmployee, id: 'emp-3', createdAt: '2025-01-20T00:00:00Z' }\\n      })\\n\\n      const { createEmployee } = useKitchen()\\n      await createEmployee(newEmployee)\\n\\n      expect(kitchenAPI.createEmployee).toHaveBeenCalledWith(newEmployee)\\n    })\\n\\n    it('应该成功更新员工状态', async () => {\\n      const newStatus: EmployeeStatus = 'break'\\n      const updatedEmployee = {\\n        ...mockEmployees[0],\\n        status: newStatus\\n      }\\n\\n      vi.mocked(kitchenAPI.updateEmployeeStatus).mockResolvedValue({\\n        success: true,\\n        data: updatedEmployee\\n      })\\n\\n      const { updateEmployeeStatus } = useKitchen()\\n      await updateEmployeeStatus('emp-1', newStatus)\\n\\n      expect(kitchenAPI.updateEmployeeStatus).toHaveBeenCalledWith('emp-1', newStatus)\\n    })\\n\\n    it('应该成功删除员工', async () => {\\n      vi.mocked(kitchenAPI.deleteEmployee).mockResolvedValue({\\n        success: true,\\n        data: true\\n      })\\n\\n      const { deleteEmployee } = useKitchen()\\n      await deleteEmployee('emp-1')\\n\\n      expect(kitchenAPI.deleteEmployee).toHaveBeenCalledWith('emp-1')\\n    })\\n\\n    it('应该支持员工筛选', async () => {\\n      vi.mocked(kitchenAPI.getEmployees).mockResolvedValue({\\n        success: true,\\n        data: {\\n          items: mockEmployees.filter(emp => emp.status === 'online'),\\n          pagination: { page: 1, limit: 20, total: 1, totalPages: 1 }\\n        }\\n      })\\n\\n      const { loadEmployees } = useKitchen()\\n      await loadEmployees({ status: 'online' as EmployeeStatus })\\n\\n      expect(kitchenAPI.getEmployees).toHaveBeenCalledWith({ status: 'online' })\\n    })\\n  })\\n\\n  describe('库存管理集成', () => {\\n    it('应该成功创建库存项', async () => {\\n      const newItem = {\\n        itemCode: 'ING002',\\n        name: '鸡肉',\\n        category: 'meat',\\n        unit: '公斤',\\n        quantity: 30,\\n        minQuantity: 10,\\n        maxQuantity: 100,\\n        unitPrice: 30,\\n        supplier: '供应商B',\\n        lastRestockDate: '2025-01-20',\\n        status: 'normal',\\n        location: '冷藏库B'\\n      }\\n\\n      vi.mocked(kitchenAPI.createInventoryItem).mockResolvedValue({\\n        success: true,\\n        data: { ...newItem, id: 'inv-2', createdAt: '2025-01-20T00:00:00Z' }\\n      })\\n\\n      const { createInventoryItem } = useKitchen()\\n      await createInventoryItem(newItem)\\n\\n      expect(kitchenAPI.createInventoryItem).toHaveBeenCalledWith(newItem)\\n    })\\n\\n    it('应该成功更新库存项', async () => {\\n      const updatedItem = {\\n        ...mockInventory[0],\\n        quantity: 60\\n      }\\n\\n      vi.mocked(kitchenAPI.updateInventoryItem).mockResolvedValue({\\n        success: true,\\n        data: updatedItem\\n      })\\n\\n      const { updateInventoryItem } = useKitchen()\\n      await updateInventoryItem('inv-1', updatedItem)\\n\\n      expect(kitchenAPI.updateInventoryItem).toHaveBeenCalledWith('inv-1', updatedItem)\\n    })\\n\\n    it('应该成功删除库存项', async () => {\\n      vi.mocked(kitchenAPI.deleteInventoryItem).mockResolvedValue({\\n        success: true,\\n        data: true\\n      })\\n\\n      const { deleteInventoryItem } = useKitchen()\\n      await deleteInventoryItem('inv-1')\\n\\n      expect(kitchenAPI.deleteInventoryItem).toHaveBeenCalledWith('inv-1')\\n    })\\n\\n    it('应该成功补货', async () => {\\n      const restockedItem = {\\n        ...mockInventory[0],\\n        quantity: 80\\n      }\\n\\n      vi.mocked(kitchenAPI.restockInventory).mockResolvedValue({\\n        success: true,\\n        data: restockedItem\\n      })\\n\\n      const { restockInventory } = useKitchen()\\n      await restockInventory('inv-1', 30)\\n\\n      expect(kitchenAPI.restockInventory).toHaveBeenCalledWith('inv-1', 30)\\n    })\\n\\n    it('应该支持库存筛选', async () => {\\n      vi.mocked(kitchenAPI.getInventory).mockResolvedValue({\\n        success: true,\\n        data: {\\n          items: mockInventory.filter(item => item.category === 'meat'),\\n          pagination: { page: 1, limit: 20, total: 1, totalPages: 1 }\\n        }\\n      })\\n\\n      const { loadInventory } = useKitchen()\\n      await loadInventory({ category: 'meat' })\\n\\n      expect(kitchenAPI.getInventory).toHaveBeenCalledWith({ category: 'meat' })\\n    })\\n  })\\n\\n  describe('数据分析集成', () => {\\n    it('应该成功加载分析数据', async () => {\\n      const mockAnalytics = {\\n        taskDistribution: [\\n          { status: 'pending', count: 5, percentage: 25 },\\n          { status: 'preparing', count: 3, percentage: 15 }\\n        ],\\n        stationDistribution: [\\n          { station: 'hot_dish', count: 10, percentage: 50 }\\n        ],\\n        staffEfficiency: [\\n          { employeeId: 'emp-1', employeeName: '张三', tasksCompleted: 50, averageTime: 12, efficiency: 92.5 }\\n        ],\\n        peakHours: [\\n          { hour: 12, taskCount: 20, orderCount: 15 }\\n        ],\\n        equipmentUtilization: [\\n          { equipmentId: 'eq-1', equipmentName: '蒸柜', usageHours: 8, utilizationRate: 80 }\\n        ],\\n        inventoryTrends: [\\n          { date: '2025-01-20', itemCount: 100, value: 50000 }\\n        ]\\n      }\\n\\n      vi.mocked(kitchenAPI.getAnalytics).mockResolvedValue({\\n        success: true,\\n        data: mockAnalytics\\n      })\\n\\n      const { loadAnalytics } = useKitchen()\\n      await loadAnalytics({ startDate: '2025-01-01', endDate: '2025-01-20' })\\n\\n      expect(kitchenAPI.getAnalytics).toHaveBeenCalledWith({\\n        startDate: '2025-01-01',\\n        endDate: '2025-01-20'\\n      })\\n    })\\n  })\\n\\n  describe('数据刷新集成', () => {\\n    it('应该成功刷新所有数据', async () => {\\n      vi.mocked(kitchenAPI.getStats).mockResolvedValue({\\n        success: true,\\n        data: mockStats\\n      })\\n      vi.mocked(kitchenAPI.getTasks).mockResolvedValue({\\n        success: true,\\n        data: {\\n          items: mockTasks,\\n          pagination: { page: 1, limit: 20, total: 2, totalPages: 1 }\\n        }\\n      })\\n      vi.mocked(kitchenAPI.getEmployees).mockResolvedValue({\\n        success: true,\\n        data: {\\n          items: mockEmployees,\\n          pagination: { page: 1, limit: 20, total: 2, totalPages: 1 }\\n        }\\n      })\\n\\n      const { refreshData } = useKitchen()\\n      await refreshData()\\n\\n      expect(kitchenAPI.getStats).toHaveBeenCalled()\\n      expect(kitchenAPI.getTasks).toHaveBeenCalled()\\n      expect(kitchenAPI.getEmployees).toHaveBeenCalled()\\n    })\\n  })\\n\\n  describe('错误处理集成', () => {\\n    it('应该正确处理API错误', async () => {\\n      vi.mocked(kitchenAPI.getTasks).mockRejectedValue(new Error('网络错误'))\\n\\n      const { loadTasks } = useKitchen()\\n      await loadTasks()\\n\\n      expect(kitchenAPI.getTasks).toHaveBeenCalled()\\n    })\\n\\n    it('应该在加载失败时显示错误消息', async () => {\\n      vi.mocked(kitchenAPI.getTasks).mockRejectedValue(new Error('加载失败'))\\n\\n      const { loadTasks } = useKitchen()\\n      await loadTasks()\\n\\n      expect(wrapper.vm.loading).toBe(false)\\n    })\\n  })\\n\\n  describe('状态管理集成', () => {\\n    it('应该正确管理加载状态', async () => {\\n      const { loading } = useKitchen()\\n      expect(loading.value).toBe(false)\\n    })\\n\\n    it('应该在加载时更新状态', async () => {\\n      vi.mocked(kitchenAPI.getTasks).mockImplementation(() => {\\n        const { loading } = useKitchen()\\n        loading.value = true\\n        return Promise.resolve({\\n          success: true,\\n          data: {\\n            items: mockTasks,\\n            pagination: { page: 1, limit: 20, total: 2, totalPages: 1 }\\n          }\\n        })\\n      })\\n\\n      const { loadTasks, loading } = useKitchen()\\n      await loadTasks()\\n\\n      expect(loading.value).toBe(false)\\n    })\\n  })\\n\\n  describe('分页集成', () => {\\n    it('应该正确处理分页', async () => {\\n      vi.mocked(kitchenAPI.getTasks).mockResolvedValue({\\n        success: true,\\n        data: {\\n          items: mockTasks,\\n          pagination: { page: 2, limit: 20, total: 2, totalPages: 1 }\\n        }\\n      })\\n\\n      const { loadTasks } = useKitchen()\\n      await loadTasks({ page: 2, limit: 20 })\\n\\n      expect(kitchenAPI.getTasks).toHaveBeenCalledWith({ page: 2, limit: 20 })\\n    })\\n  })\\n\\n  describe('图表集成', () => {\\n    it('应该正确初始化图表', async () => {\\n      await wrapper.vm.handleTabChange('analytics')\\n\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n\\n    it('应该在数据更新时刷新图表', async () => {\\n      vi.mocked(kitchenAPI.getAnalytics).mockResolvedValue({\\n        success: true,\\n        data: {\\n          taskDistribution: [],\\n          stationDistribution: [],\\n          staffEfficiency: [],\\n          peakHours: [],\\n          equipmentUtilization: [],\\n          inventoryTrends: []\\n        }\\n      })\\n\\n      await wrapper.vm.handleTabChange('analytics')\\n\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n  })\\n\\n  describe('业务流程集成', () => {\\n    it('应该完整执行任务创建流程', async () => {\\n      const newTask = {\\n        taskId: 'TASK003',\\n        orderNo: 'ORD003',\\n        itemName: '宫保鸡丁',\\n        quantity: 1,\\n        station: 'hot_dish' as TaskStation,\\n        priority: 'normal' as TaskPriority,\\n        status: 'pending' as TaskStatus,\\n        tableNumber: 'A03',\\n        estimatedTime: 18,\\n        createdAt: '2025-01-20T10:10:00Z'\\n      }\\n\\n      vi.mocked(kitchenAPI.createTask).mockResolvedValue({\\n        success: true,\\n        data: { ...newTask, id: 'task-3' }\\n      })\\n\\n      const { createTask, loadTasks } = useKitchen()\\n      await createTask(newTask)\\n      await loadTasks()\\n\\n      expect(kitchenAPI.createTask).toHaveBeenCalledWith(newTask)\\n      expect(kitchenAPI.getTasks).toHaveBeenCalled()\\n    })\\n\\n    it('应该完整执行任务分配流程', async () => {\\n      vi.mocked(kitchenAPI.assignTask).mockResolvedValue({\\n        success: true,\\n        data: { ...mockTasks[0], assignedTo: 'emp-2' }\\n      })\\n\\n      const { assignTask, updateEmployeeStatus } = useKitchen()\\n      await assignTask('task-1', 'emp-2')\\n      await updateEmployeeStatus('emp-2', 'busy' as EmployeeStatus)\\n\\n      expect(kitchenAPI.assignTask).toHaveBeenCalledWith('task-1', 'emp-2')\\n      expect(kitchenAPI.updateEmployeeStatus).toHaveBeenCalledWith('emp-2', 'busy')\\n    })\\n\\n    it('应该完整执行任务状态更新流程', async () => {\\n      const statuses: TaskStatus[] = ['pending', 'preparing', 'ready', 'served']\\n\\n      for (const status of statuses) {\\n        vi.mocked(kitchenAPI.updateTaskStatus).mockResolvedValue({\\n          success: true,\\n          data: { ...mockTasks[0], status }\\n        })\\n\\n        const { updateTaskStatus } = useKitchen()\\n        await updateTaskStatus('task-1', status)\\n\\n        expect(kitchenAPI.updateTaskStatus).toHaveBeenCalledWith('task-1', status)\\n      }\\n    })\\n  })\\n})\\n\",\"originTextLength\":21101,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768887651402}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/docs/YYC3-Cater-Platform-%E6%96%87%E6%A1%A3%E9%97%AD%E7%8E%AF/YYC3-Cater-%E9%9C%80%E6%B1%82%E8%AE%BE%E8%AE%A1%E6%96%87%E6%A1%A3/%E8%AE%A2%E5%8D%95%E7%AE%A1%E7%90%86%E5%8A%9F%E8%83%BD%E6%A8%A1%E5%9D%97%E9%9C%80%E6%B1%82%E5%88%86%E6%9E%90%E4%B8%8E%E8%AE%BE%E8%AE%A1%E6%96%87%E6%A1%A3.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":685,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":685,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# YYC³餐饮管理系统 - 订单管理功能模块需求分析与设计文档\\\\n\\\\n## 文档信息\\\\n\\\\n| 项目 | 内容 |\\\\n|------|------|\\\\n| 文档名称 | 订单管理功能模块需求分析与设计文档 |\\\\n| 文档版本 | V1.0.0 |\\\\n| 创建日期 | 2025-01-20 |\\\\n| 作者 | YYC³团队 |\\\\n| 文档状态 | 正式发布 |\\\\n\\\\n## 1. 概述\\\\n\\\\n### 1.1 模块简介\\\\n\\\\n订单管理模块是YYC³餐饮管理系统的核心业务模块，负责订单创建、查询、更新、批量操作等全方位的订单管理功能。该模块为餐饮企业提供了完整的订单管理解决方案，实现了订单处理流程的标准化、规范化和数字化。\\\\n\\\\n### 1.2 模块目标\\\\n\\\\n- 提供完整的订单创建和管理功能\\\\n- 实现订单状态跟踪和流程可视化\\\\n- 支持多种订单类型（堂食、外卖、自提等）\\\\n- 提供订单搜索、筛选和排序功能\\\\n- 实现订单批量操作\\\\n- 支持订单详情查看和编辑\\\\n- 提供订单数据统计和分析\\\\n- 确保订单处理符合业务流程\\\\n\\\\n### 1.3 适用范围\\\\n\\\\n本模块适用于YYC³餐饮管理系统的所有版本，支持单店和连锁店的订单管理。\\\\n\\\\n## 2. 功能需求\\\\n\\\\n### 2.1 订单列表管理\\\\n\\\\n#### 2.1.1 订单列表展示\\\\n\\\\n**功能描述**：展示系统中所有订单信息，支持搜索、筛选、排序和分页。\\\\n\\\\n**输入参数**：\\\\n- 关键词：订单号、客户姓名、电话\\\\n- 订单状态：待确认、已确认、制作中、已完成、已取消、已退款\\\\n- 订单类型：堂食、外卖、自提\\\\n- 时间范围：下单时间区间\\\\n- 支付状态：待支付、已支付、已退款\\\\n- 页码：当前页码\\\\n- 每页数量：每页显示数量\\\\n\\\\n**输出结果**：\\\\n- 订单列表：包含订单基本信息\\\\n- 总数：符合条件的订单总数\\\\n- 统计数据：各状态订单数量\\\\n\\\\n**字段说明**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | number | 是 | 订单ID |\\\\n| orderNo | string | 是 | 订单编号 |\\\\n| customerId | number | 是 | 客户ID |\\\\n| customerName | string | 是 | 客户姓名 |\\\\n| customerPhone | string | 是 | 客户电话 |\\\\n| type | string | 是 | 订单类型：dine_in/takeaway/delivery |\\\\n| status | string | 是 | 订单状态：pending/confirmed/preparing/completed/cancelled/refunded |\\\\n| paymentStatus | string | 是 | 支付状态：unpaid/paid/refunded |\\\\n| totalAmount | number | 是 | 订单总金额 |\\\\n| discountAmount | number | 否 | 优惠金额 |\\\\n| actualAmount | number | 是 | 实付金额 |\\\\n| paymentMethod | string | 是 | 支付方式：wechat/alipay/cash/card |\\\\n| tableNumber | string | 否 | 桌号（堂食订单） |\\\\n| address | object | 否 | 配送地址（外卖订单） |\\\\n| items | array | 是 | 订单商品列表 |\\\\n| notes | string | 否 | 订单备注 |\\\\n| priority | string | 是 | 优先级：normal/urgent/emergency |\\\\n| estimatedTime | number | 否 | 预计完成时间（分钟） |\\\\n| actualTime | number | 否 | 实际完成时间（分钟） |\\\\n| createdAt | string | 是 | 创建时间 |\\\\n| updatedAt | string | 否 | 更新时间 |\\\\n| completedAt | string | 否 | 完成时间 |\\\\n\\\\n**订单商品字段**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | number | 是 | 商品ID |\\\\n| itemId | number | 是 | 菜品ID |\\\\n| itemName | string | 是 | 菜品名称 |\\\\n| quantity | number | 是 | 数量 |\\\\n| price | number | 是 | 单价 |\\\\n| subtotal | number | 是 | 小计 |\\\\n| specifications | object | 否 | 规格选项 |\\\\n| notes | string | 否 | 商品备注 |\\\\n\\\\n#### 2.1.2 订单筛选\\\\n\\\\n**功能描述**：根据多种条件筛选订单列表。\\\\n\\\\n**筛选条件**：\\\\n- 订单状态：单选或多选\\\\n- 订单类型：单选或多选\\\\n- 支付状态：单选或多选\\\\n- 时间范围：日期时间范围选择\\\\n- 优先级：单选或多选\\\\n- 桌号：模糊搜索\\\\n- 配送区域：区域选择（外卖订单）\\\\n\\\\n#### 2.1.3 订单搜索\\\\n\\\\n**功能描述**：通过关键词搜索订单。\\\\n\\\\n**搜索字段**：\\\\n- 订单号：精确匹配\\\\n- 客户姓名：模糊匹配\\\\n- 客户电话：模糊匹配\\\\n- 菜品名称：模糊匹配\\\\n\\\\n#### 2.1.4 订单排序\\\\n\\\\n**功能描述**：对订单列表进行排序。\\\\n\\\\n**排序字段**：\\\\n- 下单时间：升序/降序\\\\n- 订单金额：升序/降序\\\\n- 完成时间：升序/降序\\\\n- 优先级：升序/降序\\\\n\\\\n#### 2.1.5 订单分页\\\\n\\\\n**功能描述**：实现订单列表的分页展示。\\\\n\\\\n**分页参数**：\\\\n- 当前页码\\\\n- 每页数量：10/20/50/100\\\\n- 总数\\\\n- 总页数\\\\n\\\\n### 2.2 订单创建\\\\n\\\\n#### 2.2.1 创建订单\\\\n\\\\n**功能描述**：创建新的订单。\\\\n\\\\n**输入参数**：\\\\n- 客户信息：姓名、电话、会员ID\\\\n- 订单类型：堂食/外卖/自提\\\\n- 桌号：堂食订单必填\\\\n- 配送地址：外卖订单必填\\\\n- 订单商品：菜品列表\\\\n- 订单备注：特殊要求\\\\n- 优惠信息：优惠券、折扣\\\\n- 预计时间：预计完成时间\\\\n\\\\n**验证规则**：\\\\n- 客户信息必填\\\\n- 订单商品不能为空\\\\n- 商品数量必须大于0\\\\n- 堂食订单必须选择桌号\\\\n- 外卖订单必须填写配送地址\\\\n- 订单总金额必须大于0\\\\n\\\\n**业务规则**：\\\\n- 自动生成订单编号\\\\n- 根据订单类型分配订单状态\\\\n- 堂食订单默认为待确认\\\\n- 外卖订单需要确认配送地址\\\\n- 自提订单需要确认取餐时间\\\\n- 计算订单总金额和实付金额\\\\n- 应用优惠券和折扣\\\\n\\\\n#### 2.2.2 添加商品\\\\n\\\\n**功能描述**：向订单中添加商品。\\\\n\\\\n**输入参数**：\\\\n- 菜品ID\\\\n- 数量\\\\n- 规格选项\\\\n- 商品备注\\\\n\\\\n**业务规则**：\\\\n- 检查菜品是否可用\\\\n- 检查库存是否充足\\\\n- 计算商品小计\\\\n- 更新订单总金额\\\\n\\\\n#### 2.2.3 修改商品\\\\n\\\\n**功能描述**：修改订单中的商品信息。\\\\n\\\\n**输入参数**：\\\\n- 商品ID\\\\n- 新数量\\\\n- 新规格\\\\n- 新备注\\\\n\\\\n**业务规则**：\\\\n- 数量不能为0（删除商品使用删除功能）\\\\n- 更新商品小计\\\\n- 更新订单总金额\\\\n\\\\n#### 2.2.4 删除商品\\\\n\\\\n**功能描述**：从订单中删除商品。\\\\n\\\\n**输入参数**：\\\\n- 商品ID\\\\n\\\\n**业务规则**：\\\\n- 更新订单总金额\\\\n- 如果是最后一个商品，提示确认删除\\\\n\\\\n### 2.3 订单详情\\\\n\\\\n#### 2.3.1 查看订单详情\\\\n\\\\n**功能描述**：查看订单的详细信息。\\\\n\\\\n**展示内容**：\\\\n- 订单基本信息：订单号、状态、类型、时间\\\\n- 客户信息：姓名、电话、地址\\\\n- 订单商品：商品列表、数量、金额\\\\n- 金额信息：总金额、优惠、实付\\\\n- 支付信息：支付方式、支付状态、支付时间\\\\n- 配送信息：配送地址、配送时间、配送员\\\\n- 备注信息：订单备注、商品备注\\\\n- 状态历史：订单状态变更记录\\\\n- 操作日志：订单操作记录\\\\n\\\\n#### 2.3.2 订单流程可视化\\\\n\\\\n**功能描述**：以可视化方式展示订单流程。\\\\n\\\\n**展示内容**：\\\\n- 状态步骤：当前状态、已完成步骤、待完成步骤\\\\n- 时间线：每个状态的时间点\\\\n- 操作按钮：可执行的操作\\\\n- 阻塞提示：当前阻塞原因\\\\n\\\\n**状态步骤**：\\\\n1. 待确认 → 已确认\\\\n2. 已确认 → 制作中\\\\n3. 制作中 → 已完成\\\\n4. 已完成 → 已上菜/已配送\\\\n5. 可取消：待确认、已确认\\\\n6. 可退款：已完成\\\\n\\\\n### 2.4 订单状态管理\\\\n\\\\n#### 2.4.1 确认订单\\\\n\\\\n**功能描述**：将订单状态从待确认改为已确认。\\\\n\\\\n**业务规则**：\\\\n- 只有待确认状态的订单可以确认\\\\n- 确认后订单进入制作流程\\\\n- 发送确认通知给客户\\\\n- 记录确认时间和操作人\\\\n\\\\n#### 2.4.2 开始制作\\\\n\\\\n**功能描述**：将订单状态从已确认改为制作中。\\\\n\\\\n**业务规则**：\\\\n- 只有已确认状态的订单可以开始制作\\\\n- 分配厨房任务\\\\n- 发送制作通知给厨房\\\\n- 记录开始制作时间\\\\n\\\\n#### 2.4.3 完成订单\\\\n\\\\n**功能描述**：将订单状态从制作中改为已完成。\\\\n\\\\n**业务规则**：\\\\n- 只有制作中状态的订单可以完成\\\\n- 堂食订单：通知服务员上菜\\\\n- 外卖订单：通知配送员取餐\\\\n- 自提订单：通知客户取餐\\\\n- 记录完成时间\\\\n\\\\n#### 2.4.4 上菜/配送\\\\n\\\\n**功能描述**：将订单状态从已完成改为已上菜/已配送。\\\\n\\\\n**业务规则**：\\\\n- 堂食订单：标记为已上菜\\\\n- 外卖订单：标记为已配送\\\\n- 自提订单：标记为已取餐\\\\n- 记录上菜/配送时间\\\\n\\\\n#### 2.4.5 取消订单\\\\n\\\\n**功能描述**：取消订单。\\\\n\\\\n**业务规则**：\\\\n- 待确认和已确认状态的订单可以取消\\\\n- 制作中的订单需要经理权限\\\\n- 已完成的订单不能取消\\\\n- 取消原因必填\\\\n- 发送取消通知给客户\\\\n- 处理退款（如已支付）\\\\n- 记录取消时间和原因\\\\n\\\\n#### 2.4.6 退款订单\\\\n\\\\n**功能描述**：对已完成订单进行退款。\\\\n\\\\n**业务规则**：\\\\n- 只有已完成的订单可以退款\\\\n- 退款原因必填\\\\n- 退款金额不能超过实付金额\\\\n- 处理退款流程\\\\n- 发送退款通知\\\\n- 记录退款信息\\\\n\\\\n### 2.5 订单批量操作\\\\n\\\\n#### 2.5.1 批量确认\\\\n\\\\n**功能描述**：批量确认多个订单。\\\\n\\\\n**业务规则**：\\\\n- 只能批量确认待确认状态的订单\\\\n- 显示确认数量和总金额\\\\n- 确认后发送批量通知\\\\n\\\\n#### 2.5.2 批量取消\\\\n\\\\n**功能描述**：批量取消多个订单。\\\\n\\\\n**业务规则**：\\\\n- 只能批量取消待确认和已确认状态的订单\\\\n- 取消原因统一填写\\\\n- 处理批量退款\\\\n\\\\n#### 2.5.3 批量导出\\\\n\\\\n**功能描述**：批量导出订单数据。\\\\n\\\\n**导出格式**：\\\\n- Excel格式\\\\n- CSV格式\\\\n- PDF格式\\\\n\\\\n**导出内容**：\\\\n- 订单基本信息\\\\n- 客户信息\\\\n- 订单商品\\\\n- 金额信息\\\\n- 状态信息\\\\n\\\\n#### 2.5.4 批量打印\\\\n\\\\n**功能描述**：批量打印订单小票。\\\\n\\\\n**打印内容**：\\\\n- 订单基本信息\\\\n- 订单商品\\\\n- 金额信息\\\\n- 客户信息\\\\n- 时间信息\\\\n\\\\n### 2.6 订单统计\\\\n\\\\n#### 2.6.1 订单概览统计\\\\n\\\\n**功能描述**：展示订单的概览统计数据。\\\\n\\\\n**统计指标**：\\\\n- 今日订单数\\\\n- 今日完成数\\\\n- 今日取消数\\\\n- 今日营业额\\\\n- 待处理订单数\\\\n- 制作中订单数\\\\n- 平均完成时间\\\\n- 订单完成率\\\\n\\\\n#### 2.6.2 订单趋势分析\\\\n\\\\n**功能描述**：展示订单的时间趋势。\\\\n\\\\n**分析维度**：\\\\n- 按小时：24小时趋势\\\\n- 按天：7天趋势\\\\n- 按周：4周趋势\\\\n- 按月：12个月趋势\\\\n\\\\n**展示方式**：\\\\n- 折线图\\\\n- 柱状图\\\\n\\\\n#### 2.6.3 订单类型分析\\\\n\\\\n**功能描述**：分析不同类型订单的占比。\\\\n\\\\n**分析维度**：\\\\n- 堂食订单占比\\\\n- 外卖订单占比\\\\n- 自提订单占比\\\\n\\\\n**展示方式**：\\\\n- 饼图\\\\n- 环形图\\\\n\\\\n#### 2.6.4 订单状态分析\\\\n\\\\n**功能描述**：分析订单状态的分布。\\\\n\\\\n**分析维度**：\\\\n- 各状态订单数量\\\\n- 各状态订单占比\\\\n- 状态流转时间\\\\n\\\\n**展示方式**：\\\\n- 柱状图\\\\n- 饼图\\\\n\\\\n#### 2.6.5 订单金额分析\\\\n\\\\n**功能描述**：分析订单金额的分布。\\\\n\\\\n**分析维度**：\\\\n- 金额区间分布\\\\n- 平均订单金额\\\\n- 最高/最低订单金额\\\\n- 客单价\\\\n\\\\n**展示方式**：\\\\n- 直方图\\\\n- 统计卡片\\\\n\\\\n### 2.7 订单视图模式\\\\n\\\\n#### 2.7.1 列表视图\\\\n\\\\n**功能描述**：以表格形式展示订单列表。\\\\n\\\\n**展示内容**：\\\\n- 订单号\\\\n- 客户信息\\\\n- 订单类型\\\\n- 订单状态\\\\n- 订单金额\\\\n- 下单时间\\\\n- 操作按钮\\\\n\\\\n#### 2.7.2 看板视图\\\\n\\\\n**功能描述**：以看板形式展示订单，按状态分组。\\\\n\\\\n**分组方式**：\\\\n- 待确认\\\\n- 已确认\\\\n- 制作中\\\\n- 已完成\\\\n- 已取消\\\\n\\\\n**展示内容**：\\\\n- 订单卡片\\\\n- 客户信息\\\\n- 订单商品\\\\n- 订单金额\\\\n- 时间信息\\\\n- 操作按钮\\\\n\\\\n#### 2.7.3 时间线视图\\\\n\\\\n**功能描述**：以时间线形式展示订单。\\\\n\\\\n**排序方式**：\\\\n- 按下单时间\\\\n- 按完成时间\\\\n\\\\n**展示内容**：\\\\n- 时间节点\\\\n- 订单信息\\\\n- 状态标识\\\\n- 操作按钮\\\\n\\\\n## 3. 非功能需求\\\\n\\\\n### 3.1 性能需求\\\\n\\\\n- 订单列表加载时间 < 1秒\\\\n- 订单详情加载时间 < 0.5秒\\\\n- 支持同时展示1000+订单\\\\n- 批量操作响应时间 < 2秒\\\\n- 统计数据计算时间 < 1秒\\\\n\\\\n### 3.2 可用性需求\\\\n\\\\n- 界面简洁直观，易于操作\\\\n- 支持键盘快捷键\\\\n- 提供操作提示和帮助\\\\n- 支持多语言切换\\\\n\\\\n### 3.3 安全需求\\\\n\\\\n- 订单数据加密传输\\\\n- 敏感信息脱敏显示\\\\n- 操作日志记录\\\\n- 权限控制\\\\n\\\\n### 3.4 兼容性需求\\\\n\\\\n- 支持主流浏览器\\\\n- 支持移动端访问\\\\n- 支持不同分辨率屏幕\\\\n\\\\n## 4. 接口设计\\\\n\\\\n### 4.1 订单列表接口\\\\n\\\\n**接口地址**: `GET /api/orders`\\\\n\\\\n**请求参数**:\\\\n```typescript\\\\n{\\\\n  page: number\\\\n  limit: number\\\\n  status?: string[]\\\\n  type?: string[]\\\\n  paymentStatus?: string[]\\\\n  dateRange?: [string, string]\\\\n  search?: string\\\\n  sortBy?: string\\\\n  sortOrder?: \\\\'asc\\\\' | \\\\'desc\\\\'\\\\n}\\\\n```\\\\n\\\\n**响应数据**:\\\\n```typescript\\\\n{\\\\n  success: boolean\\\\n  data: {\\\\n    items: Order[]\\\\n    pagination: {\\\\n      page: number\\\\n      limit: number\\\\n      total: number\\\\n      totalPages: number\\\\n    }\\\\n  }\\\\n}\\\\n```\\\\n\\\\n### 4.2 订单详情接口\\\\n\\\\n**接口地址**: `GET /api/orders/:id`\\\\n\\\\n**响应数据**:\\\\n```typescript\\\\n{\\\\n  success: boolean\\\\n  data: Order\\\\n}\\\\n```\\\\n\\\\n### 4.3 创建订单接口\\\\n\\\\n**接口地址**: `POST /api/orders`\\\\n\\\\n**请求参数**:\\\\n```typescript\\\\n{\\\\n  customerId?: number\\\\n  customerName: string\\\\n  customerPhone: string\\\\n  type: \\\\'dine_in\\\\' | \\\\'takeaway\\\\' | \\\\'delivery\\\\'\\\\n  tableNumber?: string\\\\n  address?: DeliveryAddress\\\\n  items: OrderItem[]\\\\n  notes?: string\\\\n  couponId?: string\\\\n  estimatedTime?: number\\\\n}\\\\n```\\\\n\\\\n**响应数据**:\\\\n```typescript\\\\n{\\\\n  success: boolean\\\\n  data: Order\\\\n}\\\\n```\\\\n\\\\n### 4.4 更新订单接口\\\\n\\\\n**接口地址**: `PUT /api/orders/:id`\\\\n\\\\n**请求参数**:\\\\n```typescript\\\\n{\\\\n  notes?: string\\\\n  estimatedTime?: number\\\\n  priority?: string\\\\n}\\\\n```\\\\n\\\\n**响应数据**:\\\\n```typescript\\\\n{\\\\n  success: boolean\\\\n  data: Order\\\\n}\\\\n```\\\\n\\\\n### 4.5 更新订单状态接口\\\\n\\\\n**接口地址**: `PUT /api/orders/:id/status`\\\\n\\\\n**请求参数**:\\\\n```typescript\\\\n{\\\\n  status: string\\\\n  reason?: string\\\\n}\\\\n```\\\\n\\\\n**响应数据**:\\\\n```typescript\\\\n{\\\\n  success: boolean\\\\n  data: Order\\\\n}\\\\n```\\\\n\\\\n### 4.6 取消订单接口\\\\n\\\\n**接口地址**: `POST /api/orders/:id/cancel`\\\\n\\\\n**请求参数**:\\\\n```typescript\\\\n{\\\\n  reason: string\\\\n}\\\\n```\\\\n\\\\n**响应数据**:\\\\n```typescript\\\\n{\\\\n  success: boolean\\\\n  message: string\\\\n}\\\\n```\\\\n\\\\n### 4.7 退款订单接口\\\\n\\\\n**接口地址**: `POST /api/orders/:id/refund`\\\\n\\\\n**请求参数**:\\\\n```typescript\\\\n{\\\\n  reason: string\\\\n  amount?: number\\\\n}\\\\n```\\\\n\\\\n**响应数据**:\\\\n```typescript\\\\n{\\\\n  success: boolean\\\\n  message: string\\\\n}\\\\n```\\\\n\\\\n### 4.8 批量操作接口\\\\n\\\\n**接口地址**: `POST /api/orders/batch`\\\\n\\\\n**请求参数**:\\\\n```typescript\\\\n{\\\\n  action: \\\\'confirm\\\\' | \\\\'cancel\\\\' | \\\\'export\\\\' | \\\\'print\\\\'\\\\n  orderIds: number[]\\\\n  reason?: string\\\\n}\\\\n```\\\\n\\\\n**响应数据**:\\\\n```typescript\\\\n{\\\\n  success: boolean\\\\n  data: {\\\\n    success: number[]\\\\n    failed: Array<{ id: number; reason: string }>\\\\n  }\\\\n}\\\\n```\\\\n\\\\n### 4.9 订单统计接口\\\\n\\\\n**接口地址**: `GET /api/orders/statistics`\\\\n\\\\n**请求参数**:\\\\n```typescript\\\\n{\\\\n  startDate?: string\\\\n  endDate?: string\\\\n  groupBy?: \\\\'hour\\\\' | \\\\'day\\\\' | \\\\'week\\\\' | \\\\'month\\\\'\\\\n}\\\\n```\\\\n\\\\n**响应数据**:\\\\n```typescript\\\\n{\\\\n  success: boolean\\\\n  data: {\\\\n    overview: OrderOverview\\\\n    trends: OrderTrend[]\\\\n    typeDistribution: TypeDistribution\\\\n    statusDistribution: StatusDistribution\\\\n    amountDistribution: AmountDistribution\\\\n  }\\\\n}\\\\n```\\\\n\\\\n## 5. 数据模型\\\\n\\\\n### 5.1 订单实体\\\\n\\\\n```typescript\\\\ninterface Order {\\\\n  id: number\\\\n  orderNo: string\\\\n  customerId?: number\\\\n  customerName: string\\\\n  customerPhone: string\\\\n  type: \\\\'dine_in\\\\' | \\\\'takeaway\\\\' | \\\\'delivery\\\\'\\\\n  status: OrderStatus\\\\n  paymentStatus: PaymentStatus\\\\n  totalAmount: number\\\\n  discountAmount: number\\\\n  actualAmount: number\\\\n  paymentMethod: PaymentMethod\\\\n  tableNumber?: string\\\\n  address?: DeliveryAddress\\\\n  items: OrderItem[]\\\\n  notes?: string\\\\n  priority: \\\\'normal\\\\' | \\\\'urgent\\\\' | \\\\'emergency\\\\'\\\\n  estimatedTime?: number\\\\n  actualTime?: number\\\\n  createdAt: string\\\\n  updatedAt?: string\\\\n  completedAt?: string\\\\n}\\\\n```\\\\n\\\\n### 5.2 订单商品实体\\\\n\\\\n```typescript\\\\ninterface OrderItem {\\\\n  id: number\\\\n  itemId: number\\\\n  itemName: string\\\\n  quantity: number\\\\n  price: number\\\\n  subtotal: number\\\\n  specifications?: ItemSpecifications\\\\n  notes?: string\\\\n}\\\\n```\\\\n\\\\n### 5.3 订单状态枚举\\\\n\\\\n```typescript\\\\nenum OrderStatus {\\\\n  PENDING = \\\\'pending\\\\',\\\\n  CONFIRMED = \\\\'confirmed\\\\',\\\\n  PREPARING = \\\\'preparing\\\\',\\\\n  COMPLETED = \\\\'completed\\\\',\\\\n  SERVED = \\\\'served\\\\',\\\\n  CANCELLED = \\\\'cancelled\\\\',\\\\n  REFUNDED = \\\\'refunded\\\\'\\\\n}\\\\n```\\\\n\\\\n### 5.4 支付状态枚举\\\\n\\\\n```typescript\\\\nenum PaymentStatus {\\\\n  UNPAID = \\\\'unpaid\\\\',\\\\n  PAID = \\\\'paid\\\\',\\\\n  REFUNDED = \\\\'refunded\\\\'\\\\n}\\\\n```\\\\n\\\\n### 5.5 支付方式枚举\\\\n\\\\n```typescript\\\\nenum PaymentMethod {\\\\n  WECHAT = \\\\'wechat\\\\',\\\\n  ALIPAY = \\\\'alipay\\\\',\\\\n  CASH = \\\\'cash\\\\',\\\\n  CARD = \\\\'card\\\\'\\\\n}\\\\n```\\\\n\\\\n## 6. 用户界面设计\\\\n\\\\n### 6.1 页面布局\\\\n\\\\n- 顶部：订单统计概览卡片\\\\n- 中部：筛选和操作工具栏\\\\n- 主体：订单列表/看板/时间线视图\\\\n- 底部：分页控件\\\\n\\\\n### 6.2 交互设计\\\\n\\\\n- 点击订单查看详情\\\\n- 拖拽改变订单状态（看板视图）\\\\n- 右键菜单快速操作\\\\n- 键盘快捷键支持\\\\n\\\\n### 6.3 响应式设计\\\\n\\\\n- 桌面端：完整功能展示\\\\n- 平板端：优化布局\\\\n- 手机端：简化界面\\\\n\\\\n## 7. 测试需求\\\\n\\\\n### 7.1 单元测试\\\\n\\\\n- 组件功能测试\\\\n- 工具函数测试\\\\n- 状态管理测试\\\\n- API接口测试\\\\n\\\\n### 7.2 集成测试\\\\n\\\\n- 订单流程测试\\\\n- 批量操作测试\\\\n- 状态流转测试\\\\n\\\\n### 7.3 性能测试\\\\n\\\\n- 大数据量测试\\\\n- 并发操作测试\\\\n- 响应时间测试\\\\n\\\\n## 8. 部署要求\\\\n\\\\n### 8.1 环境要求\\\\n\\\\n- Node.js 18+\\\\n- 浏览器支持：Chrome 90+, Firefox 88+, Safari 14+, Edge 90+\\\\n\\\\n### 8.2 配置要求\\\\n\\\\n- API接口地址配置\\\\n- 文件上传配置\\\\n- 打印配置\\\\n\\\\n## 9. 维护和升级\\\\n\\\\n### 9.1 日志记录\\\\n\\\\n- 操作日志\\\\n- 错误日志\\\\n- 性能日志\\\\n\\\\n### 9.2 监控告警\\\\n\\\\n- 订单异常监控\\\\n- 性能监控\\\\n- 错误告警\\\\n\\\\n### 9.3 版本升级\\\\n\\\\n- 数据迁移\\\\n- 功能兼容\\\\n- 用户通知\\\\n\\\\n## 10. 附录\\\\n\\\\n### 10.1 术语表\\\\n\\\\n| 术语 | 说明 |\\\\n|------|------|\\\\n| 订单 | 客户购买商品的单据 |\\\\n| 订单号 | 订单的唯一标识 |\\\\n| 订单状态 | 订单当前的处理状态 |\\\\n| 订单类型 | 订单的服务方式：堂食、外卖、自提 |\\\\n| 订单商品 | 订单中包含的商品 |\\\\n| 订单金额 | 订单的总金额 |\\\\n\\\\n### 10.2 参考文档\\\\n\\\\n- YYC³餐饮管理系统总体设计文档\\\\n- YYC³餐饮管理系统技术架构文档\\\\n- YYC³餐饮管理系统数据库设计文档\\\\n\",\"originAcceptText\":\"# YYC³餐饮管理系统 - 订单管理功能模块需求分析与设计文档\\n\\n## 文档信息\\n\\n| 项目 | 内容 |\\n|------|------|\\n| 文档名称 | 订单管理功能模块需求分析与设计文档 |\\n| 文档版本 | V1.0.0 |\\n| 创建日期 | 2025-01-20 |\\n| 作者 | YYC³团队 |\\n| 文档状态 | 正式发布 |\\n\\n## 1. 概述\\n\\n### 1.1 模块简介\\n\\n订单管理模块是YYC³餐饮管理系统的核心业务模块，负责订单创建、查询、更新、批量操作等全方位的订单管理功能。该模块为餐饮企业提供了完整的订单管理解决方案，实现了订单处理流程的标准化、规范化和数字化。\\n\\n### 1.2 模块目标\\n\\n- 提供完整的订单创建和管理功能\\n- 实现订单状态跟踪和流程可视化\\n- 支持多种订单类型（堂食、外卖、自提等）\\n- 提供订单搜索、筛选和排序功能\\n- 实现订单批量操作\\n- 支持订单详情查看和编辑\\n- 提供订单数据统计和分析\\n- 确保订单处理符合业务流程\\n\\n### 1.3 适用范围\\n\\n本模块适用于YYC³餐饮管理系统的所有版本，支持单店和连锁店的订单管理。\\n\\n## 2. 功能需求\\n\\n### 2.1 订单列表管理\\n\\n#### 2.1.1 订单列表展示\\n\\n**功能描述**：展示系统中所有订单信息，支持搜索、筛选、排序和分页。\\n\\n**输入参数**：\\n- 关键词：订单号、客户姓名、电话\\n- 订单状态：待确认、已确认、制作中、已完成、已取消、已退款\\n- 订单类型：堂食、外卖、自提\\n- 时间范围：下单时间区间\\n- 支付状态：待支付、已支付、已退款\\n- 页码：当前页码\\n- 每页数量：每页显示数量\\n\\n**输出结果**：\\n- 订单列表：包含订单基本信息\\n- 总数：符合条件的订单总数\\n- 统计数据：各状态订单数量\\n\\n**字段说明**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | number | 是 | 订单ID |\\n| orderNo | string | 是 | 订单编号 |\\n| customerId | number | 是 | 客户ID |\\n| customerName | string | 是 | 客户姓名 |\\n| customerPhone | string | 是 | 客户电话 |\\n| type | string | 是 | 订单类型：dine_in/takeaway/delivery |\\n| status | string | 是 | 订单状态：pending/confirmed/preparing/completed/cancelled/refunded |\\n| paymentStatus | string | 是 | 支付状态：unpaid/paid/refunded |\\n| totalAmount | number | 是 | 订单总金额 |\\n| discountAmount | number | 否 | 优惠金额 |\\n| actualAmount | number | 是 | 实付金额 |\\n| paymentMethod | string | 是 | 支付方式：wechat/alipay/cash/card |\\n| tableNumber | string | 否 | 桌号（堂食订单） |\\n| address | object | 否 | 配送地址（外卖订单） |\\n| items | array | 是 | 订单商品列表 |\\n| notes | string | 否 | 订单备注 |\\n| priority | string | 是 | 优先级：normal/urgent/emergency |\\n| estimatedTime | number | 否 | 预计完成时间（分钟） |\\n| actualTime | number | 否 | 实际完成时间（分钟） |\\n| createdAt | string | 是 | 创建时间 |\\n| updatedAt | string | 否 | 更新时间 |\\n| completedAt | string | 否 | 完成时间 |\\n\\n**订单商品字段**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | number | 是 | 商品ID |\\n| itemId | number | 是 | 菜品ID |\\n| itemName | string | 是 | 菜品名称 |\\n| quantity | number | 是 | 数量 |\\n| price | number | 是 | 单价 |\\n| subtotal | number | 是 | 小计 |\\n| specifications | object | 否 | 规格选项 |\\n| notes | string | 否 | 商品备注 |\\n\\n#### 2.1.2 订单筛选\\n\\n**功能描述**：根据多种条件筛选订单列表。\\n\\n**筛选条件**：\\n- 订单状态：单选或多选\\n- 订单类型：单选或多选\\n- 支付状态：单选或多选\\n- 时间范围：日期时间范围选择\\n- 优先级：单选或多选\\n- 桌号：模糊搜索\\n- 配送区域：区域选择（外卖订单）\\n\\n#### 2.1.3 订单搜索\\n\\n**功能描述**：通过关键词搜索订单。\\n\\n**搜索字段**：\\n- 订单号：精确匹配\\n- 客户姓名：模糊匹配\\n- 客户电话：模糊匹配\\n- 菜品名称：模糊匹配\\n\\n#### 2.1.4 订单排序\\n\\n**功能描述**：对订单列表进行排序。\\n\\n**排序字段**：\\n- 下单时间：升序/降序\\n- 订单金额：升序/降序\\n- 完成时间：升序/降序\\n- 优先级：升序/降序\\n\\n#### 2.1.5 订单分页\\n\\n**功能描述**：实现订单列表的分页展示。\\n\\n**分页参数**：\\n- 当前页码\\n- 每页数量：10/20/50/100\\n- 总数\\n- 总页数\\n\\n### 2.2 订单创建\\n\\n#### 2.2.1 创建订单\\n\\n**功能描述**：创建新的订单。\\n\\n**输入参数**：\\n- 客户信息：姓名、电话、会员ID\\n- 订单类型：堂食/外卖/自提\\n- 桌号：堂食订单必填\\n- 配送地址：外卖订单必填\\n- 订单商品：菜品列表\\n- 订单备注：特殊要求\\n- 优惠信息：优惠券、折扣\\n- 预计时间：预计完成时间\\n\\n**验证规则**：\\n- 客户信息必填\\n- 订单商品不能为空\\n- 商品数量必须大于0\\n- 堂食订单必须选择桌号\\n- 外卖订单必须填写配送地址\\n- 订单总金额必须大于0\\n\\n**业务规则**：\\n- 自动生成订单编号\\n- 根据订单类型分配订单状态\\n- 堂食订单默认为待确认\\n- 外卖订单需要确认配送地址\\n- 自提订单需要确认取餐时间\\n- 计算订单总金额和实付金额\\n- 应用优惠券和折扣\\n\\n#### 2.2.2 添加商品\\n\\n**功能描述**：向订单中添加商品。\\n\\n**输入参数**：\\n- 菜品ID\\n- 数量\\n- 规格选项\\n- 商品备注\\n\\n**业务规则**：\\n- 检查菜品是否可用\\n- 检查库存是否充足\\n- 计算商品小计\\n- 更新订单总金额\\n\\n#### 2.2.3 修改商品\\n\\n**功能描述**：修改订单中的商品信息。\\n\\n**输入参数**：\\n- 商品ID\\n- 新数量\\n- 新规格\\n- 新备注\\n\\n**业务规则**：\\n- 数量不能为0（删除商品使用删除功能）\\n- 更新商品小计\\n- 更新订单总金额\\n\\n#### 2.2.4 删除商品\\n\\n**功能描述**：从订单中删除商品。\\n\\n**输入参数**：\\n- 商品ID\\n\\n**业务规则**：\\n- 更新订单总金额\\n- 如果是最后一个商品，提示确认删除\\n\\n### 2.3 订单详情\\n\\n#### 2.3.1 查看订单详情\\n\\n**功能描述**：查看订单的详细信息。\\n\\n**展示内容**：\\n- 订单基本信息：订单号、状态、类型、时间\\n- 客户信息：姓名、电话、地址\\n- 订单商品：商品列表、数量、金额\\n- 金额信息：总金额、优惠、实付\\n- 支付信息：支付方式、支付状态、支付时间\\n- 配送信息：配送地址、配送时间、配送员\\n- 备注信息：订单备注、商品备注\\n- 状态历史：订单状态变更记录\\n- 操作日志：订单操作记录\\n\\n#### 2.3.2 订单流程可视化\\n\\n**功能描述**：以可视化方式展示订单流程。\\n\\n**展示内容**：\\n- 状态步骤：当前状态、已完成步骤、待完成步骤\\n- 时间线：每个状态的时间点\\n- 操作按钮：可执行的操作\\n- 阻塞提示：当前阻塞原因\\n\\n**状态步骤**：\\n1. 待确认 → 已确认\\n2. 已确认 → 制作中\\n3. 制作中 → 已完成\\n4. 已完成 → 已上菜/已配送\\n5. 可取消：待确认、已确认\\n6. 可退款：已完成\\n\\n### 2.4 订单状态管理\\n\\n#### 2.4.1 确认订单\\n\\n**功能描述**：将订单状态从待确认改为已确认。\\n\\n**业务规则**：\\n- 只有待确认状态的订单可以确认\\n- 确认后订单进入制作流程\\n- 发送确认通知给客户\\n- 记录确认时间和操作人\\n\\n#### 2.4.2 开始制作\\n\\n**功能描述**：将订单状态从已确认改为制作中。\\n\\n**业务规则**：\\n- 只有已确认状态的订单可以开始制作\\n- 分配厨房任务\\n- 发送制作通知给厨房\\n- 记录开始制作时间\\n\\n#### 2.4.3 完成订单\\n\\n**功能描述**：将订单状态从制作中改为已完成。\\n\\n**业务规则**：\\n- 只有制作中状态的订单可以完成\\n- 堂食订单：通知服务员上菜\\n- 外卖订单：通知配送员取餐\\n- 自提订单：通知客户取餐\\n- 记录完成时间\\n\\n#### 2.4.4 上菜/配送\\n\\n**功能描述**：将订单状态从已完成改为已上菜/已配送。\\n\\n**业务规则**：\\n- 堂食订单：标记为已上菜\\n- 外卖订单：标记为已配送\\n- 自提订单：标记为已取餐\\n- 记录上菜/配送时间\\n\\n#### 2.4.5 取消订单\\n\\n**功能描述**：取消订单。\\n\\n**业务规则**：\\n- 待确认和已确认状态的订单可以取消\\n- 制作中的订单需要经理权限\\n- 已完成的订单不能取消\\n- 取消原因必填\\n- 发送取消通知给客户\\n- 处理退款（如已支付）\\n- 记录取消时间和原因\\n\\n#### 2.4.6 退款订单\\n\\n**功能描述**：对已完成订单进行退款。\\n\\n**业务规则**：\\n- 只有已完成的订单可以退款\\n- 退款原因必填\\n- 退款金额不能超过实付金额\\n- 处理退款流程\\n- 发送退款通知\\n- 记录退款信息\\n\\n### 2.5 订单批量操作\\n\\n#### 2.5.1 批量确认\\n\\n**功能描述**：批量确认多个订单。\\n\\n**业务规则**：\\n- 只能批量确认待确认状态的订单\\n- 显示确认数量和总金额\\n- 确认后发送批量通知\\n\\n#### 2.5.2 批量取消\\n\\n**功能描述**：批量取消多个订单。\\n\\n**业务规则**：\\n- 只能批量取消待确认和已确认状态的订单\\n- 取消原因统一填写\\n- 处理批量退款\\n\\n#### 2.5.3 批量导出\\n\\n**功能描述**：批量导出订单数据。\\n\\n**导出格式**：\\n- Excel格式\\n- CSV格式\\n- PDF格式\\n\\n**导出内容**：\\n- 订单基本信息\\n- 客户信息\\n- 订单商品\\n- 金额信息\\n- 状态信息\\n\\n#### 2.5.4 批量打印\\n\\n**功能描述**：批量打印订单小票。\\n\\n**打印内容**：\\n- 订单基本信息\\n- 订单商品\\n- 金额信息\\n- 客户信息\\n- 时间信息\\n\\n### 2.6 订单统计\\n\\n#### 2.6.1 订单概览统计\\n\\n**功能描述**：展示订单的概览统计数据。\\n\\n**统计指标**：\\n- 今日订单数\\n- 今日完成数\\n- 今日取消数\\n- 今日营业额\\n- 待处理订单数\\n- 制作中订单数\\n- 平均完成时间\\n- 订单完成率\\n\\n#### 2.6.2 订单趋势分析\\n\\n**功能描述**：展示订单的时间趋势。\\n\\n**分析维度**：\\n- 按小时：24小时趋势\\n- 按天：7天趋势\\n- 按周：4周趋势\\n- 按月：12个月趋势\\n\\n**展示方式**：\\n- 折线图\\n- 柱状图\\n\\n#### 2.6.3 订单类型分析\\n\\n**功能描述**：分析不同类型订单的占比。\\n\\n**分析维度**：\\n- 堂食订单占比\\n- 外卖订单占比\\n- 自提订单占比\\n\\n**展示方式**：\\n- 饼图\\n- 环形图\\n\\n#### 2.6.4 订单状态分析\\n\\n**功能描述**：分析订单状态的分布。\\n\\n**分析维度**：\\n- 各状态订单数量\\n- 各状态订单占比\\n- 状态流转时间\\n\\n**展示方式**：\\n- 柱状图\\n- 饼图\\n\\n#### 2.6.5 订单金额分析\\n\\n**功能描述**：分析订单金额的分布。\\n\\n**分析维度**：\\n- 金额区间分布\\n- 平均订单金额\\n- 最高/最低订单金额\\n- 客单价\\n\\n**展示方式**：\\n- 直方图\\n- 统计卡片\\n\\n### 2.7 订单视图模式\\n\\n#### 2.7.1 列表视图\\n\\n**功能描述**：以表格形式展示订单列表。\\n\\n**展示内容**：\\n- 订单号\\n- 客户信息\\n- 订单类型\\n- 订单状态\\n- 订单金额\\n- 下单时间\\n- 操作按钮\\n\\n#### 2.7.2 看板视图\\n\\n**功能描述**：以看板形式展示订单，按状态分组。\\n\\n**分组方式**：\\n- 待确认\\n- 已确认\\n- 制作中\\n- 已完成\\n- 已取消\\n\\n**展示内容**：\\n- 订单卡片\\n- 客户信息\\n- 订单商品\\n- 订单金额\\n- 时间信息\\n- 操作按钮\\n\\n#### 2.7.3 时间线视图\\n\\n**功能描述**：以时间线形式展示订单。\\n\\n**排序方式**：\\n- 按下单时间\\n- 按完成时间\\n\\n**展示内容**：\\n- 时间节点\\n- 订单信息\\n- 状态标识\\n- 操作按钮\\n\\n## 3. 非功能需求\\n\\n### 3.1 性能需求\\n\\n- 订单列表加载时间 < 1秒\\n- 订单详情加载时间 < 0.5秒\\n- 支持同时展示1000+订单\\n- 批量操作响应时间 < 2秒\\n- 统计数据计算时间 < 1秒\\n\\n### 3.2 可用性需求\\n\\n- 界面简洁直观，易于操作\\n- 支持键盘快捷键\\n- 提供操作提示和帮助\\n- 支持多语言切换\\n\\n### 3.3 安全需求\\n\\n- 订单数据加密传输\\n- 敏感信息脱敏显示\\n- 操作日志记录\\n- 权限控制\\n\\n### 3.4 兼容性需求\\n\\n- 支持主流浏览器\\n- 支持移动端访问\\n- 支持不同分辨率屏幕\\n\\n## 4. 接口设计\\n\\n### 4.1 订单列表接口\\n\\n**接口地址**: `GET /api/orders`\\n\\n**请求参数**:\\n```typescript\\n{\\n  page: number\\n  limit: number\\n  status?: string[]\\n  type?: string[]\\n  paymentStatus?: string[]\\n  dateRange?: [string, string]\\n  search?: string\\n  sortBy?: string\\n  sortOrder?: 'asc' | 'desc'\\n}\\n```\\n\\n**响应数据**:\\n```typescript\\n{\\n  success: boolean\\n  data: {\\n    items: Order[]\\n    pagination: {\\n      page: number\\n      limit: number\\n      total: number\\n      totalPages: number\\n    }\\n  }\\n}\\n```\\n\\n### 4.2 订单详情接口\\n\\n**接口地址**: `GET /api/orders/:id`\\n\\n**响应数据**:\\n```typescript\\n{\\n  success: boolean\\n  data: Order\\n}\\n```\\n\\n### 4.3 创建订单接口\\n\\n**接口地址**: `POST /api/orders`\\n\\n**请求参数**:\\n```typescript\\n{\\n  customerId?: number\\n  customerName: string\\n  customerPhone: string\\n  type: 'dine_in' | 'takeaway' | 'delivery'\\n  tableNumber?: string\\n  address?: DeliveryAddress\\n  items: OrderItem[]\\n  notes?: string\\n  couponId?: string\\n  estimatedTime?: number\\n}\\n```\\n\\n**响应数据**:\\n```typescript\\n{\\n  success: boolean\\n  data: Order\\n}\\n```\\n\\n### 4.4 更新订单接口\\n\\n**接口地址**: `PUT /api/orders/:id`\\n\\n**请求参数**:\\n```typescript\\n{\\n  notes?: string\\n  estimatedTime?: number\\n  priority?: string\\n}\\n```\\n\\n**响应数据**:\\n```typescript\\n{\\n  success: boolean\\n  data: Order\\n}\\n```\\n\\n### 4.5 更新订单状态接口\\n\\n**接口地址**: `PUT /api/orders/:id/status`\\n\\n**请求参数**:\\n```typescript\\n{\\n  status: string\\n  reason?: string\\n}\\n```\\n\\n**响应数据**:\\n```typescript\\n{\\n  success: boolean\\n  data: Order\\n}\\n```\\n\\n### 4.6 取消订单接口\\n\\n**接口地址**: `POST /api/orders/:id/cancel`\\n\\n**请求参数**:\\n```typescript\\n{\\n  reason: string\\n}\\n```\\n\\n**响应数据**:\\n```typescript\\n{\\n  success: boolean\\n  message: string\\n}\\n```\\n\\n### 4.7 退款订单接口\\n\\n**接口地址**: `POST /api/orders/:id/refund`\\n\\n**请求参数**:\\n```typescript\\n{\\n  reason: string\\n  amount?: number\\n}\\n```\\n\\n**响应数据**:\\n```typescript\\n{\\n  success: boolean\\n  message: string\\n}\\n```\\n\\n### 4.8 批量操作接口\\n\\n**接口地址**: `POST /api/orders/batch`\\n\\n**请求参数**:\\n```typescript\\n{\\n  action: 'confirm' | 'cancel' | 'export' | 'print'\\n  orderIds: number[]\\n  reason?: string\\n}\\n```\\n\\n**响应数据**:\\n```typescript\\n{\\n  success: boolean\\n  data: {\\n    success: number[]\\n    failed: Array<{ id: number; reason: string }>\\n  }\\n}\\n```\\n\\n### 4.9 订单统计接口\\n\\n**接口地址**: `GET /api/orders/statistics`\\n\\n**请求参数**:\\n```typescript\\n{\\n  startDate?: string\\n  endDate?: string\\n  groupBy?: 'hour' | 'day' | 'week' | 'month'\\n}\\n```\\n\\n**响应数据**:\\n```typescript\\n{\\n  success: boolean\\n  data: {\\n    overview: OrderOverview\\n    trends: OrderTrend[]\\n    typeDistribution: TypeDistribution\\n    statusDistribution: StatusDistribution\\n    amountDistribution: AmountDistribution\\n  }\\n}\\n```\\n\\n## 5. 数据模型\\n\\n### 5.1 订单实体\\n\\n```typescript\\ninterface Order {\\n  id: number\\n  orderNo: string\\n  customerId?: number\\n  customerName: string\\n  customerPhone: string\\n  type: 'dine_in' | 'takeaway' | 'delivery'\\n  status: OrderStatus\\n  paymentStatus: PaymentStatus\\n  totalAmount: number\\n  discountAmount: number\\n  actualAmount: number\\n  paymentMethod: PaymentMethod\\n  tableNumber?: string\\n  address?: DeliveryAddress\\n  items: OrderItem[]\\n  notes?: string\\n  priority: 'normal' | 'urgent' | 'emergency'\\n  estimatedTime?: number\\n  actualTime?: number\\n  createdAt: string\\n  updatedAt?: string\\n  completedAt?: string\\n}\\n```\\n\\n### 5.2 订单商品实体\\n\\n```typescript\\ninterface OrderItem {\\n  id: number\\n  itemId: number\\n  itemName: string\\n  quantity: number\\n  price: number\\n  subtotal: number\\n  specifications?: ItemSpecifications\\n  notes?: string\\n}\\n```\\n\\n### 5.3 订单状态枚举\\n\\n```typescript\\nenum OrderStatus {\\n  PENDING = 'pending',\\n  CONFIRMED = 'confirmed',\\n  PREPARING = 'preparing',\\n  COMPLETED = 'completed',\\n  SERVED = 'served',\\n  CANCELLED = 'cancelled',\\n  REFUNDED = 'refunded'\\n}\\n```\\n\\n### 5.4 支付状态枚举\\n\\n```typescript\\nenum PaymentStatus {\\n  UNPAID = 'unpaid',\\n  PAID = 'paid',\\n  REFUNDED = 'refunded'\\n}\\n```\\n\\n### 5.5 支付方式枚举\\n\\n```typescript\\nenum PaymentMethod {\\n  WECHAT = 'wechat',\\n  ALIPAY = 'alipay',\\n  CASH = 'cash',\\n  CARD = 'card'\\n}\\n```\\n\\n## 6. 用户界面设计\\n\\n### 6.1 页面布局\\n\\n- 顶部：订单统计概览卡片\\n- 中部：筛选和操作工具栏\\n- 主体：订单列表/看板/时间线视图\\n- 底部：分页控件\\n\\n### 6.2 交互设计\\n\\n- 点击订单查看详情\\n- 拖拽改变订单状态（看板视图）\\n- 右键菜单快速操作\\n- 键盘快捷键支持\\n\\n### 6.3 响应式设计\\n\\n- 桌面端：完整功能展示\\n- 平板端：优化布局\\n- 手机端：简化界面\\n\\n## 7. 测试需求\\n\\n### 7.1 单元测试\\n\\n- 组件功能测试\\n- 工具函数测试\\n- 状态管理测试\\n- API接口测试\\n\\n### 7.2 集成测试\\n\\n- 订单流程测试\\n- 批量操作测试\\n- 状态流转测试\\n\\n### 7.3 性能测试\\n\\n- 大数据量测试\\n- 并发操作测试\\n- 响应时间测试\\n\\n## 8. 部署要求\\n\\n### 8.1 环境要求\\n\\n- Node.js 18+\\n- 浏览器支持：Chrome 90+, Firefox 88+, Safari 14+, Edge 90+\\n\\n### 8.2 配置要求\\n\\n- API接口地址配置\\n- 文件上传配置\\n- 打印配置\\n\\n## 9. 维护和升级\\n\\n### 9.1 日志记录\\n\\n- 操作日志\\n- 错误日志\\n- 性能日志\\n\\n### 9.2 监控告警\\n\\n- 订单异常监控\\n- 性能监控\\n- 错误告警\\n\\n### 9.3 版本升级\\n\\n- 数据迁移\\n- 功能兼容\\n- 用户通知\\n\\n## 10. 附录\\n\\n### 10.1 术语表\\n\\n| 术语 | 说明 |\\n|------|------|\\n| 订单 | 客户购买商品的单据 |\\n| 订单号 | 订单的唯一标识 |\\n| 订单状态 | 订单当前的处理状态 |\\n| 订单类型 | 订单的服务方式：堂食、外卖、自提 |\\n| 订单商品 | 订单中包含的商品 |\\n| 订单金额 | 订单的总金额 |\\n\\n### 10.2 参考文档\\n\\n- YYC³餐饮管理系统总体设计文档\\n- YYC³餐饮管理系统技术架构文档\\n- YYC³餐饮管理系统数据库设计文档\\n\",\"originTextLength\":10648,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768892635397}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/views/__tests__/OrderManagement.test.ts": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":525,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":525,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"import { describe, it, expect, beforeEach, vi } from \\\\'vitest\\\\'\\\\nimport { mount } from \\\\'@vue/test-utils\\\\'\\\\nimport { createPinia, setActivePinia } from \\\\'pinia\\\\'\\\\nimport ElementPlus from \\\\'element-plus\\\\'\\\\nimport OrderManagement from \\\\'@/views/OrderManagement.vue\\\\'\\\\nimport * as OrderAPI from \\\\'@/api/order-management\\\\'\\\\nimport type { Order, OrderStatus } from \\\\'@/types/order\\\\'\\\\n\\\\nvi.mock(\\\\'@/api/order-management\\\\', () => ({\\\\n  default: {\\\\n    getOrders: vi.fn(),\\\\n    getOrder: vi.fn(),\\\\n    createOrder: vi.fn(),\\\\n    updateOrder: vi.fn(),\\\\n    updateOrderStatus: vi.fn(),\\\\n    cancelOrder: vi.fn(),\\\\n    refundOrder: vi.fn(),\\\\n    printOrder: vi.fn(),\\\\n    getStatistics: vi.fn(),\\\\n    batchOperation: vi.fn()\\\\n  }\\\\n}))\\\\n\\\\nvi.mock(\\\\'element-plus\\\\', async () => {\\\\n  const actual = await vi.importActual(\\\\'element-plus\\\\')\\\\n  return {\\\\n    ...actual,\\\\n    ElMessage: {\\\\n      success: vi.fn(),\\\\n      error: vi.fn(),\\\\n      warning: vi.fn(),\\\\n      info: vi.fn()\\\\n    },\\\\n    ElMessageBox: {\\\\n      confirm: vi.fn()\\\\n    }\\\\n  }\\\\n})\\\\n\\\\nconst mockOrders: Order[] = [\\\\n  {\\\\n    id: 1,\\\\n    orderNumber: \\\\'ORD20250120001\\\\',\\\\n    customerId: 1,\\\\n    customerName: \\\\'张三\\\\',\\\\n    customerPhone: \\\\'13800138000\\\\',\\\\n    type: \\\\'dine_in\\\\',\\\\n    status: \\\\'pending\\\\' as OrderStatus,\\\\n    paymentStatus: \\\\'paid\\\\',\\\\n    totalAmount: 128.00,\\\\n    discountAmount: 0,\\\\n    finalAmount: 128.00,\\\\n    paymentMethod: \\\\'wechat\\\\',\\\\n    tableNumber: \\\\'A01\\\\',\\\\n    items: [\\\\n      {\\\\n        id: 1,\\\\n        itemId: 101,\\\\n        itemName: \\\\'宫保鸡丁\\\\',\\\\n        quantity: 1,\\\\n        price: 38.00,\\\\n        subtotal: 38.00\\\\n      },\\\\n      {\\\\n        id: 2,\\\\n        itemId: 102,\\\\n        itemName: \\\\'红烧肉\\\\',\\\\n        quantity: 2,\\\\n        price: 45.00,\\\\n        subtotal: 90.00\\\\n      }\\\\n    ],\\\\n    notes: \\\\'少放辣\\\\',\\\\n    priority: \\\\'normal\\\\',\\\\n    createdAt: \\\\'2025-01-20T10:00:00Z\\\\',\\\\n    updatedAt: \\\\'2025-01-20T10:00:00Z\\\\'\\\\n  },\\\\n  {\\\\n    id: 2,\\\\n    orderNumber: \\\\'ORD20250120002\\\\',\\\\n    customerId: 2,\\\\n    customerName: \\\\'李四\\\\',\\\\n    customerPhone: \\\\'13900139000\\\\',\\\\n    type: \\\\'delivery\\\\',\\\\n    status: \\\\'confirmed\\\\' as OrderStatus,\\\\n    paymentStatus: \\\\'paid\\\\',\\\\n    totalAmount: 85.00,\\\\n    discountAmount: 5.00,\\\\n    finalAmount: 80.00,\\\\n    paymentMethod: \\\\'alipay\\\\',\\\\n    address: {\\\\n      province: \\\\'广东省\\\\',\\\\n      city: \\\\'深圳市\\\\',\\\\n      district: \\\\'南山区\\\\',\\\\n      detail: \\\\'科技园南区XX大厦\\\\',\\\\n      contactName: \\\\'李四\\\\',\\\\n      contactPhone: \\\\'13900139000\\\\'\\\\n    },\\\\n    items: [\\\\n      {\\\\n        id: 3,\\\\n        itemId: 103,\\\\n        itemName: \\\\'鱼香肉丝\\\\',\\\\n        quantity: 1,\\\\n        price: 32.00,\\\\n        subtotal: 32.00\\\\n      },\\\\n      {\\\\n        id: 4,\\\\n        itemId: 104,\\\\n        itemName: \\\\'麻婆豆腐\\\\',\\\\n        quantity: 1,\\\\n        price: 28.00,\\\\n        subtotal: 28.00\\\\n      }\\\\n    ],\\\\n    notes: \\\\'不要香菜\\\\',\\\\n    priority: \\\\'urgent\\\\',\\\\n    estimatedTime: 30,\\\\n    createdAt: \\\\'2025-01-20T11:00:00Z\\\\',\\\\n    updatedAt: \\\\'2025-01-20T11:05:00Z\\\\'\\\\n  }\\\\n]\\\\n\\\\nconst mockStatistics = {\\\\n  overview: {\\\\n    totalOrders: 150,\\\\n    completedOrders: 120,\\\\n    cancelledOrders: 5,\\\\n    totalAmount: 15000.00,\\\\n    averageAmount: 100.00,\\\\n    averagePreparationTime: 25\\\\n  },\\\\n  trends: [\\\\n    { date: \\\\'2025-01-14\\\\', count: 20, amount: 2000 },\\\\n    { date: \\\\'2025-01-15\\\\', count: 25, amount: 2500 },\\\\n    { date: \\\\'2025-01-16\\\\', count: 22, amount: 2200 },\\\\n    { date: \\\\'2025-01-17\\\\', count: 28, amount: 2800 },\\\\n    { date: \\\\'2025-01-18\\\\', count: 30, amount: 3000 },\\\\n    { date: \\\\'2025-01-19\\\\', count: 25, amount: 2500 }\\\\n  ],\\\\n  typeDistribution: [\\\\n    { type: \\\\'dine_in\\\\', count: 80, percentage: 53.33 },\\\\n    { type: \\\\'delivery\\\\', count: 50, percentage: 33.33 },\\\\n    { type: \\\\'takeaway\\\\', count: 20, percentage: 13.34 }\\\\n  ],\\\\n  statusDistribution: [\\\\n    { status: \\\\'pending\\\\', count: 10, percentage: 6.67 },\\\\n    { status: \\\\'confirmed\\\\', count: 15, percentage: 10.00 },\\\\n    { status: \\\\'preparing\\\\', count: 5, percentage: 3.33 },\\\\n    { status: \\\\'completed\\\\', count: 120, percentage: 80.00 }\\\\n  ]\\\\n}\\\\n\\\\ndescribe(\\\\'OrderManagement组件\\\\', () => {\\\\n  let wrapper: any\\\\n\\\\n  beforeEach(() => {\\\\n    setActivePinia(createPinia())\\\\n    wrapper = mount(OrderManagement, {\\\\n      global: {\\\\n        plugins: [ElementPlus],\\\\n        stubs: {\\\\n          \\\\'el-card\\\\': true,\\\\n          \\\\'el-row\\\\': true,\\\\n          \\\\'el-col\\\\': true,\\\\n          \\\\'el-icon\\\\': true,\\\\n          \\\\'el-button\\\\': true,\\\\n          \\\\'el-button-group\\\\': true,\\\\n          \\\\'el-select\\\\': true,\\\\n          \\\\'el-option\\\\': true,\\\\n          \\\\'el-date-picker\\\\': true,\\\\n          \\\\'el-input\\\\': true,\\\\n          \\\\'el-dropdown\\\\': true,\\\\n          \\\\'el-dropdown-menu\\\\': true,\\\\n          \\\\'el-dropdown-item\\\\': true,\\\\n          \\\\'el-table\\\\': true,\\\\n          \\\\'el-table-column\\\\': true,\\\\n          \\\\'el-tag\\\\': true,\\\\n          \\\\'el-pagination\\\\': true,\\\\n          \\\\'el-dialog\\\\': true,\\\\n          \\\\'el-form\\\\': true,\\\\n          \\\\'el-form-item\\\\': true,\\\\n          \\\\'el-radio-group\\\\': true,\\\\n          \\\\'el-radio\\\\': true\\\\n        }\\\\n      }\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'组件渲染\\\\', () => {\\\\n    it(\\\\'应该正确渲染组件\\\\', () => {\\\\n      expect(wrapper.exists()).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该显示页面标题\\\\', () => {\\\\n      const title = wrapper.find(\\\\'.page-header h2\\\\')\\\\n      expect(title.exists()).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该显示订单统计概览\\\\', () => {\\\\n      expect(wrapper.vm.orderStats).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该显示筛选工具栏\\\\', () => {\\\\n      expect(wrapper.vm.filters).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该显示订单列表\\\\', () => {\\\\n      expect(wrapper.vm.orders).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该显示分页控件\\\\', () => {\\\\n      expect(wrapper.vm.pagination).toBeDefined()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'订单统计\\\\', () => {\\\\n    it(\\\\'应该正确显示今日订单数\\\\', () => {\\\\n      expect(wrapper.vm.orderStats).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示今日完成数\\\\', () => {\\\\n      expect(wrapper.vm.orderStats).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示今日营业额\\\\', () => {\\\\n      expect(wrapper.vm.orderStats).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示待处理订单数\\\\', () => {\\\\n      expect(wrapper.vm.orderStats).toBeDefined()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'订单列表\\\\', () => {\\\\n    it(\\\\'应该正确加载订单列表\\\\', async () => {\\\\n      const mockAPI = OrderAPI.default\\\\n      mockAPI.getOrders.mockResolvedValue({\\\\n        success: true,\\\\n        data: {\\\\n          orders: mockOrders,\\\\n          total: 2\\\\n        }\\\\n      })\\\\n\\\\n      await wrapper.vm.loadOrders()\\\\n\\\\n      expect(mockAPI.getOrders).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示订单号\\\\', () => {\\\\n      wrapper.vm.orders = mockOrders\\\\n      const hasOrderNumber = mockOrders.some(order => order.orderNumber.includes(\\\\'ORD\\\\'))\\\\n      expect(hasOrderNumber).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示客户信息\\\\', () => {\\\\n      wrapper.vm.orders = mockOrders\\\\n      const hasCustomerName = mockOrders.some(order => order.customerName === \\\\'张三\\\\' || order.customerName === \\\\'李四\\\\')\\\\n      expect(hasCustomerName).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示订单类型\\\\', () => {\\\\n      wrapper.vm.orders = mockOrders\\\\n      const hasType = mockOrders.some(order => order.type === \\\\'dine_in\\\\' || order.type === \\\\'delivery\\\\')\\\\n      expect(hasType).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示订单状态\\\\', () => {\\\\n      wrapper.vm.orders = mockOrders\\\\n      const hasStatus = mockOrders.some(order => order.status === \\\\'pending\\\\' || order.status === \\\\'confirmed\\\\')\\\\n      expect(hasStatus).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示订单金额\\\\', () => {\\\\n      wrapper.vm.orders = mockOrders\\\\n      const hasAmount = mockOrders.some(order => order.totalAmount > 0)\\\\n      expect(hasAmount).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示订单商品数量\\\\', () => {\\\\n      wrapper.vm.orders = mockOrders\\\\n      const hasItems = mockOrders.some(order => order.items && order.items.length > 0)\\\\n      expect(hasItems).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示下单时间\\\\', () => {\\\\n      wrapper.vm.orders = mockOrders\\\\n      const hasCreatedAt = mockOrders.some(order => order.createdAt)\\\\n      expect(hasCreatedAt).toBe(true)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'订单筛选\\\\', () => {\\\\n    it(\\\\'应该支持按状态筛选\\\\', () => {\\\\n      wrapper.vm.filters.status = [\\\\'pending\\\\']\\\\n      expect(wrapper.vm.filters.status).toContain(\\\\'pending\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该支持按类型筛选\\\\', () => {\\\\n      wrapper.vm.filters.type = [\\\\'dine_in\\\\']\\\\n      expect(wrapper.vm.filters.type).toContain(\\\\'dine_in\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该支持按时间范围筛选\\\\', () => {\\\\n      const dateRange = [\\\\'2025-01-01\\\\', \\\\'2025-01-31\\\\']\\\\n      wrapper.vm.filters.dateRange = dateRange\\\\n      expect(wrapper.vm.filters.dateRange).toEqual(dateRange)\\\\n    })\\\\n\\\\n    it(\\\\'应该支持关键词搜索\\\\', () => {\\\\n      wrapper.vm.filters.search = \\\\'张三\\\\'\\\\n      expect(wrapper.vm.filters.search).toBe(\\\\'张三\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该支持多条件组合筛选\\\\', () => {\\\\n      wrapper.vm.filters = {\\\\n        status: [\\\\'pending\\\\'],\\\\n        type: [\\\\'dine_in\\\\'],\\\\n        search: \\\\'张三\\\\',\\\\n        dateRange: [\\\\'2025-01-01\\\\', \\\\'2025-01-31\\\\']\\\\n      }\\\\n      expect(wrapper.vm.filters.status).toContain(\\\\'pending\\\\')\\\\n      expect(wrapper.vm.filters.type).toContain(\\\\'dine_in\\\\')\\\\n      expect(wrapper.vm.filters.search).toBe(\\\\'张三\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'订单搜索\\\\', () => {\\\\n    it(\\\\'应该支持按订单号搜索\\\\', () => {\\\\n      wrapper.vm.filters.search = \\\\'ORD20250120001\\\\'\\\\n      expect(wrapper.vm.filters.search).toBe(\\\\'ORD20250120001\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该支持按客户姓名搜索\\\\', () => {\\\\n      wrapper.vm.filters.search = \\\\'张三\\\\'\\\\n      expect(wrapper.vm.filters.search).toBe(\\\\'张三\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该支持按客户电话搜索\\\\', () => {\\\\n      wrapper.vm.filters.search = \\\\'13800138000\\\\'\\\\n      expect(wrapper.vm.filters.search).toBe(\\\\'13800138000\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'视图模式\\\\', () => {\\\\n    it(\\\\'应该支持列表视图\\\\', () => {\\\\n      wrapper.vm.setViewMode(\\\\'list\\\\')\\\\n      expect(wrapper.vm.viewMode).toBe(\\\\'list\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该支持看板视图\\\\', () => {\\\\n      wrapper.vm.setViewMode(\\\\'kanban\\\\')\\\\n      expect(wrapper.vm.viewMode).toBe(\\\\'kanban\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该支持时间线视图\\\\', () => {\\\\n      wrapper.vm.setViewMode(\\\\'timeline\\\\')\\\\n      expect(wrapper.vm.viewMode).toBe(\\\\'timeline\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该在切换视图时保持筛选条件\\\\', () => {\\\\n      wrapper.vm.filters = { status: [\\\\'pending\\\\'], type: [\\\\'dine_in\\\\'], search: \\\\'张三\\\\' }\\\\n      wrapper.vm.setViewMode(\\\\'kanban\\\\')\\\\n      expect(wrapper.vm.filters.status).toContain(\\\\'pending\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'订单操作\\\\', () => {\\\\n    it(\\\\'应该支持查看订单详情\\\\', () => {\\\\n      wrapper.vm.orders = mockOrders\\\\n      wrapper.vm.handleOrderClick(mockOrders[0])\\\\n      expect(wrapper.vm.selectedOrder).toEqual(mockOrders[0])\\\\n    })\\\\n\\\\n    it(\\\\'应该支持创建新订单\\\\', () => {\\\\n      wrapper.vm.handleCreateOrder()\\\\n      expect(wrapper.vm.showCreateDialog).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该支持确认订单\\\\', async () => {\\\\n      const mockAPI = OrderAPI.default\\\\n      mockAPI.updateOrderStatus.mockResolvedValue({ success: true })\\\\n\\\\n      wrapper.vm.orders = mockOrders\\\\n      await wrapper.vm.confirmOrder(mockOrders[0])\\\\n\\\\n      expect(mockAPI.updateOrderStatus).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该支持取消订单\\\\', async () => {\\\\n      const mockAPI = OrderAPI.default\\\\n      mockAPI.cancelOrder.mockResolvedValue({ success: true })\\\\n\\\\n      wrapper.vm.orders = mockOrders\\\\n      await wrapper.vm.cancelOrder(mockOrders[0])\\\\n\\\\n      expect(mockAPI.cancelOrder).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该支持打印订单\\\\', async () => {\\\\n      const mockAPI = OrderAPI.default\\\\n      mockAPI.printOrder.mockResolvedValue({ success: true })\\\\n\\\\n      wrapper.vm.orders = mockOrders\\\\n      await wrapper.vm.printOrder(mockOrders[0])\\\\n\\\\n      expect(mockAPI.printOrder).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该支持退款订单\\\\', async () => {\\\\n      const mockAPI = OrderAPI.default\\\\n      mockAPI.refundOrder.mockResolvedValue({ success: true })\\\\n\\\\n      wrapper.vm.orders = mockOrders\\\\n      await wrapper.vm.refundOrder(mockOrders[0])\\\\n\\\\n      expect(mockAPI.refundOrder).toHaveBeenCalled()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'批量操作\\\\', () => {\\\\n    it(\\\\'应该支持批量选择订单\\\\', () => {\\\\n      wrapper.vm.handleSelectionChange(mockOrders)\\\\n      expect(wrapper.vm.selectedOrders).toEqual(mockOrders)\\\\n    })\\\\n\\\\n    it(\\\\'应该支持批量确认订单\\\\', async () => {\\\\n      const mockAPI = OrderAPI.default\\\\n      mockAPI.batchOperation.mockResolvedValue({ success: true })\\\\n\\\\n      wrapper.vm.selectedOrders = mockOrders\\\\n      await wrapper.vm.handleBatchAction(\\\\'confirm\\\\')\\\\n\\\\n      expect(mockAPI.batchOperation).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该支持批量取消订单\\\\', async () => {\\\\n      const mockAPI = OrderAPI.default\\\\n      mockAPI.batchOperation.mockResolvedValue({ success: true })\\\\n\\\\n      wrapper.vm.selectedOrders = mockOrders\\\\n      await wrapper.vm.handleBatchAction(\\\\'cancel\\\\')\\\\n\\\\n      expect(mockAPI.batchOperation).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该支持批量导出订单\\\\', async () => {\\\\n      const mockAPI = OrderAPI.default\\\\n      mockAPI.batchOperation.mockResolvedValue({ success: true })\\\\n\\\\n      wrapper.vm.selectedOrders = mockOrders\\\\n      await wrapper.vm.handleBatchAction(\\\\'export\\\\')\\\\n\\\\n      expect(mockAPI.batchOperation).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该支持批量打印订单\\\\', async () => {\\\\n      const mockAPI = OrderAPI.default\\\\n      mockAPI.batchOperation.mockResolvedValue({ success: true })\\\\n\\\\n      wrapper.vm.selectedOrders = mockOrders\\\\n      await wrapper.vm.handleBatchAction(\\\\'print\\\\')\\\\n\\\\n      expect(mockAPI.batchOperation).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该在未选择订单时提示\\\\', async () => {\\\\n      wrapper.vm.selectedOrders = []\\\\n      await wrapper.vm.handleBatchAction(\\\\'confirm\\\\')\\\\n      expect(wrapper.vm.selectedOrders.length).toBe(0)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'分页功能\\\\', () => {\\\\n    it(\\\\'应该支持分页\\\\', () => {\\\\n      expect(wrapper.vm.pagination).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该支持改变每页数量\\\\', () => {\\\\n      wrapper.vm.handleSizeChange(20)\\\\n      expect(wrapper.vm.pagination.pageSize).toBe(20)\\\\n    })\\\\n\\\\n    it(\\\\'应该支持跳转页码\\\\', () => {\\\\n      wrapper.vm.handlePageChange(2)\\\\n      expect(wrapper.vm.pagination.page).toBe(2)\\\\n    })\\\\n\\\\n    it(\\\\'应该在改变筛选条件时重置到第一页\\\\', () => {\\\\n      wrapper.vm.pagination.page = 5\\\\n      wrapper.vm.handleFilterChange()\\\\n      expect(wrapper.vm.pagination.page).toBe(1)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'订单统计\\\\', () => {\\\\n    it(\\\\'应该正确加载统计数据\\\\', async () => {\\\\n      const mockAPI = OrderAPI.default\\\\n      mockAPI.getStatistics.mockResolvedValue({\\\\n        success: true,\\\\n        data: mockStatistics\\\\n      })\\\\n\\\\n      expect(wrapper.vm.loadStatistics).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示订单趋势\\\\', () => {\\\\n      expect(wrapper.vm.statistics).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示订单类型分布\\\\', () => {\\\\n      expect(wrapper.vm.statistics).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示订单状态分布\\\\', () => {\\\\n      expect(wrapper.vm.statistics).toBeDefined()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'订单详情\\\\', () => {\\\\n    it(\\\\'应该正确显示订单基本信息\\\\', () => {\\\\n      wrapper.vm.selectedOrder = mockOrders[0]\\\\n      expect(wrapper.vm.selectedOrder.orderNumber).toBe(\\\\'ORD20250120001\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示客户信息\\\\', () => {\\\\n      wrapper.vm.selectedOrder = mockOrders[0]\\\\n      expect(wrapper.vm.selectedOrder.customerName).toBe(\\\\'张三\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示订单商品\\\\', () => {\\\\n      wrapper.vm.selectedOrder = mockOrders[0]\\\\n      expect(wrapper.vm.selectedOrder.items.length).toBe(2)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示金额信息\\\\', () => {\\\\n      wrapper.vm.selectedOrder = mockOrders[0]\\\\n      expect(wrapper.vm.selectedOrder.totalAmount).toBe(128.00)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示订单备注\\\\', () => {\\\\n      wrapper.vm.selectedOrder = mockOrders[0]\\\\n      expect(wrapper.vm.selectedOrder.notes).toBe(\\\\'少放辣\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'订单状态管理\\\\', () => {\\\\n    it(\\\\'应该支持订单状态流转\\\\', () => {\\\\n      const order = { ...mockOrders[0], status: \\\\'pending\\\\' as OrderStatus }\\\\n      order.status = \\\\'confirmed\\\\' as OrderStatus\\\\n      expect(order.status).toBe(\\\\'confirmed\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该支持待确认到已确认\\\\', () => {\\\\n      const order = { ...mockOrders[0], status: \\\\'pending\\\\' as OrderStatus }\\\\n      expect(order.status).toBe(\\\\'pending\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该支持已确认到制作中\\\\', () => {\\\\n      const order = { ...mockOrders[1], status: \\\\'confirmed\\\\' as OrderStatus }\\\\n      expect(order.status).toBe(\\\\'confirmed\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该支持制作中到已完成\\\\', () => {\\\\n      const order = { ...mockOrders[0], status: \\\\'preparing\\\\' as OrderStatus }\\\\n      expect(order.status).toBe(\\\\'preparing\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'响应式设计\\\\', () => {\\\\n    it(\\\\'应该在窗口大小变化时调整布局\\\\', () => {\\\\n      expect(wrapper.vm.viewMode).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该支持移动端视图\\\\', () => {\\\\n      expect(wrapper.vm.viewMode).toBeDefined()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'错误处理\\\\', () => {\\\\n    it(\\\\'应该正确处理加载失败\\\\', async () => {\\\\n      const mockAPI = OrderAPI.default\\\\n      mockAPI.getOrders.mockRejectedValue(new Error(\\\\'加载失败\\\\'))\\\\n\\\\n      try {\\\\n        await wrapper.vm.loadOrders()\\\\n      } catch (error) {\\\\n        expect(error).toBeDefined()\\\\n      }\\\\n    })\\\\n\\\\n    it(\\\\'应该正确处理操作失败\\\\', async () => {\\\\n      const mockAPI = OrderAPI.default\\\\n      mockAPI.updateOrderStatus.mockRejectedValue(new Error(\\\\'操作失败\\\\'))\\\\n\\\\n      try {\\\\n        await wrapper.vm.confirmOrder(mockOrders[0])\\\\n      } catch (error) {\\\\n        expect(error).toBeDefined()\\\\n      }\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'生命周期\\\\', () => {\\\\n    it(\\\\'应该在组件挂载时加载数据\\\\', async () => {\\\\n      expect(wrapper.vm.loadOrders).toBeDefined()\\\\n      expect(wrapper.vm.loadStatistics).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该在组件卸载时清理资源\\\\', () => {\\\\n      wrapper.unmount()\\\\n      expect(wrapper.exists()).toBe(false)\\\\n    })\\\\n  })\\\\n})\\\\n\",\"originAcceptText\":\"import { describe, it, expect, beforeEach, vi } from 'vitest'\\nimport { mount } from '@vue/test-utils'\\nimport { createPinia, setActivePinia } from 'pinia'\\nimport ElementPlus from 'element-plus'\\nimport OrderManagement from '@/views/OrderManagement.vue'\\nimport * as OrderAPI from '@/api/order-management'\\nimport type { Order, OrderStatus } from '@/types/order'\\n\\nvi.mock('@/api/order-management', () => ({\\n  default: {\\n    getOrders: vi.fn(),\\n    getOrder: vi.fn(),\\n    createOrder: vi.fn(),\\n    updateOrder: vi.fn(),\\n    updateOrderStatus: vi.fn(),\\n    cancelOrder: vi.fn(),\\n    refundOrder: vi.fn(),\\n    printOrder: vi.fn(),\\n    getStatistics: vi.fn(),\\n    batchOperation: vi.fn()\\n  }\\n}))\\n\\nvi.mock('element-plus', async () => {\\n  const actual = await vi.importActual('element-plus')\\n  return {\\n    ...actual,\\n    ElMessage: {\\n      success: vi.fn(),\\n      error: vi.fn(),\\n      warning: vi.fn(),\\n      info: vi.fn()\\n    },\\n    ElMessageBox: {\\n      confirm: vi.fn()\\n    }\\n  }\\n})\\n\\nconst mockOrders: Order[] = [\\n  {\\n    id: 1,\\n    orderNumber: 'ORD20250120001',\\n    customerId: 1,\\n    customerName: '张三',\\n    customerPhone: '13800138000',\\n    type: 'dine_in',\\n    status: 'pending' as OrderStatus,\\n    paymentStatus: 'paid',\\n    totalAmount: 128.00,\\n    discountAmount: 0,\\n    finalAmount: 128.00,\\n    paymentMethod: 'wechat',\\n    tableNumber: 'A01',\\n    items: [\\n      {\\n        id: 1,\\n        itemId: 101,\\n        itemName: '宫保鸡丁',\\n        quantity: 1,\\n        price: 38.00,\\n        subtotal: 38.00\\n      },\\n      {\\n        id: 2,\\n        itemId: 102,\\n        itemName: '红烧肉',\\n        quantity: 2,\\n        price: 45.00,\\n        subtotal: 90.00\\n      }\\n    ],\\n    notes: '少放辣',\\n    priority: 'normal',\\n    createdAt: '2025-01-20T10:00:00Z',\\n    updatedAt: '2025-01-20T10:00:00Z'\\n  },\\n  {\\n    id: 2,\\n    orderNumber: 'ORD20250120002',\\n    customerId: 2,\\n    customerName: '李四',\\n    customerPhone: '13900139000',\\n    type: 'delivery',\\n    status: 'confirmed' as OrderStatus,\\n    paymentStatus: 'paid',\\n    totalAmount: 85.00,\\n    discountAmount: 5.00,\\n    finalAmount: 80.00,\\n    paymentMethod: 'alipay',\\n    address: {\\n      province: '广东省',\\n      city: '深圳市',\\n      district: '南山区',\\n      detail: '科技园南区XX大厦',\\n      contactName: '李四',\\n      contactPhone: '13900139000'\\n    },\\n    items: [\\n      {\\n        id: 3,\\n        itemId: 103,\\n        itemName: '鱼香肉丝',\\n        quantity: 1,\\n        price: 32.00,\\n        subtotal: 32.00\\n      },\\n      {\\n        id: 4,\\n        itemId: 104,\\n        itemName: '麻婆豆腐',\\n        quantity: 1,\\n        price: 28.00,\\n        subtotal: 28.00\\n      }\\n    ],\\n    notes: '不要香菜',\\n    priority: 'urgent',\\n    estimatedTime: 30,\\n    createdAt: '2025-01-20T11:00:00Z',\\n    updatedAt: '2025-01-20T11:05:00Z'\\n  }\\n]\\n\\nconst mockStatistics = {\\n  overview: {\\n    totalOrders: 150,\\n    completedOrders: 120,\\n    cancelledOrders: 5,\\n    totalAmount: 15000.00,\\n    averageAmount: 100.00,\\n    averagePreparationTime: 25\\n  },\\n  trends: [\\n    { date: '2025-01-14', count: 20, amount: 2000 },\\n    { date: '2025-01-15', count: 25, amount: 2500 },\\n    { date: '2025-01-16', count: 22, amount: 2200 },\\n    { date: '2025-01-17', count: 28, amount: 2800 },\\n    { date: '2025-01-18', count: 30, amount: 3000 },\\n    { date: '2025-01-19', count: 25, amount: 2500 }\\n  ],\\n  typeDistribution: [\\n    { type: 'dine_in', count: 80, percentage: 53.33 },\\n    { type: 'delivery', count: 50, percentage: 33.33 },\\n    { type: 'takeaway', count: 20, percentage: 13.34 }\\n  ],\\n  statusDistribution: [\\n    { status: 'pending', count: 10, percentage: 6.67 },\\n    { status: 'confirmed', count: 15, percentage: 10.00 },\\n    { status: 'preparing', count: 5, percentage: 3.33 },\\n    { status: 'completed', count: 120, percentage: 80.00 }\\n  ]\\n}\\n\\ndescribe('OrderManagement组件', () => {\\n  let wrapper: any\\n\\n  beforeEach(() => {\\n    setActivePinia(createPinia())\\n    wrapper = mount(OrderManagement, {\\n      global: {\\n        plugins: [ElementPlus],\\n        stubs: {\\n          'el-card': true,\\n          'el-row': true,\\n          'el-col': true,\\n          'el-icon': true,\\n          'el-button': true,\\n          'el-button-group': true,\\n          'el-select': true,\\n          'el-option': true,\\n          'el-date-picker': true,\\n          'el-input': true,\\n          'el-dropdown': true,\\n          'el-dropdown-menu': true,\\n          'el-dropdown-item': true,\\n          'el-table': true,\\n          'el-table-column': true,\\n          'el-tag': true,\\n          'el-pagination': true,\\n          'el-dialog': true,\\n          'el-form': true,\\n          'el-form-item': true,\\n          'el-radio-group': true,\\n          'el-radio': true\\n        }\\n      }\\n    })\\n  })\\n\\n  describe('组件渲染', () => {\\n    it('应该正确渲染组件', () => {\\n      expect(wrapper.exists()).toBe(true)\\n    })\\n\\n    it('应该显示页面标题', () => {\\n      const title = wrapper.find('.page-header h2')\\n      expect(title.exists()).toBe(true)\\n    })\\n\\n    it('应该显示订单统计概览', () => {\\n      expect(wrapper.vm.orderStats).toBeDefined()\\n    })\\n\\n    it('应该显示筛选工具栏', () => {\\n      expect(wrapper.vm.filters).toBeDefined()\\n    })\\n\\n    it('应该显示订单列表', () => {\\n      expect(wrapper.vm.orders).toBeDefined()\\n    })\\n\\n    it('应该显示分页控件', () => {\\n      expect(wrapper.vm.pagination).toBeDefined()\\n    })\\n  })\\n\\n  describe('订单统计', () => {\\n    it('应该正确显示今日订单数', () => {\\n      expect(wrapper.vm.orderStats).toBeDefined()\\n    })\\n\\n    it('应该正确显示今日完成数', () => {\\n      expect(wrapper.vm.orderStats).toBeDefined()\\n    })\\n\\n    it('应该正确显示今日营业额', () => {\\n      expect(wrapper.vm.orderStats).toBeDefined()\\n    })\\n\\n    it('应该正确显示待处理订单数', () => {\\n      expect(wrapper.vm.orderStats).toBeDefined()\\n    })\\n  })\\n\\n  describe('订单列表', () => {\\n    it('应该正确加载订单列表', async () => {\\n      const mockAPI = OrderAPI.default\\n      mockAPI.getOrders.mockResolvedValue({\\n        success: true,\\n        data: {\\n          orders: mockOrders,\\n          total: 2\\n        }\\n      })\\n\\n      await wrapper.vm.loadOrders()\\n\\n      expect(mockAPI.getOrders).toHaveBeenCalled()\\n    })\\n\\n    it('应该正确显示订单号', () => {\\n      wrapper.vm.orders = mockOrders\\n      const hasOrderNumber = mockOrders.some(order => order.orderNumber.includes('ORD'))\\n      expect(hasOrderNumber).toBe(true)\\n    })\\n\\n    it('应该正确显示客户信息', () => {\\n      wrapper.vm.orders = mockOrders\\n      const hasCustomerName = mockOrders.some(order => order.customerName === '张三' || order.customerName === '李四')\\n      expect(hasCustomerName).toBe(true)\\n    })\\n\\n    it('应该正确显示订单类型', () => {\\n      wrapper.vm.orders = mockOrders\\n      const hasType = mockOrders.some(order => order.type === 'dine_in' || order.type === 'delivery')\\n      expect(hasType).toBe(true)\\n    })\\n\\n    it('应该正确显示订单状态', () => {\\n      wrapper.vm.orders = mockOrders\\n      const hasStatus = mockOrders.some(order => order.status === 'pending' || order.status === 'confirmed')\\n      expect(hasStatus).toBe(true)\\n    })\\n\\n    it('应该正确显示订单金额', () => {\\n      wrapper.vm.orders = mockOrders\\n      const hasAmount = mockOrders.some(order => order.totalAmount > 0)\\n      expect(hasAmount).toBe(true)\\n    })\\n\\n    it('应该正确显示订单商品数量', () => {\\n      wrapper.vm.orders = mockOrders\\n      const hasItems = mockOrders.some(order => order.items && order.items.length > 0)\\n      expect(hasItems).toBe(true)\\n    })\\n\\n    it('应该正确显示下单时间', () => {\\n      wrapper.vm.orders = mockOrders\\n      const hasCreatedAt = mockOrders.some(order => order.createdAt)\\n      expect(hasCreatedAt).toBe(true)\\n    })\\n  })\\n\\n  describe('订单筛选', () => {\\n    it('应该支持按状态筛选', () => {\\n      wrapper.vm.filters.status = ['pending']\\n      expect(wrapper.vm.filters.status).toContain('pending')\\n    })\\n\\n    it('应该支持按类型筛选', () => {\\n      wrapper.vm.filters.type = ['dine_in']\\n      expect(wrapper.vm.filters.type).toContain('dine_in')\\n    })\\n\\n    it('应该支持按时间范围筛选', () => {\\n      const dateRange = ['2025-01-01', '2025-01-31']\\n      wrapper.vm.filters.dateRange = dateRange\\n      expect(wrapper.vm.filters.dateRange).toEqual(dateRange)\\n    })\\n\\n    it('应该支持关键词搜索', () => {\\n      wrapper.vm.filters.search = '张三'\\n      expect(wrapper.vm.filters.search).toBe('张三')\\n    })\\n\\n    it('应该支持多条件组合筛选', () => {\\n      wrapper.vm.filters = {\\n        status: ['pending'],\\n        type: ['dine_in'],\\n        search: '张三',\\n        dateRange: ['2025-01-01', '2025-01-31']\\n      }\\n      expect(wrapper.vm.filters.status).toContain('pending')\\n      expect(wrapper.vm.filters.type).toContain('dine_in')\\n      expect(wrapper.vm.filters.search).toBe('张三')\\n    })\\n  })\\n\\n  describe('订单搜索', () => {\\n    it('应该支持按订单号搜索', () => {\\n      wrapper.vm.filters.search = 'ORD20250120001'\\n      expect(wrapper.vm.filters.search).toBe('ORD20250120001')\\n    })\\n\\n    it('应该支持按客户姓名搜索', () => {\\n      wrapper.vm.filters.search = '张三'\\n      expect(wrapper.vm.filters.search).toBe('张三')\\n    })\\n\\n    it('应该支持按客户电话搜索', () => {\\n      wrapper.vm.filters.search = '13800138000'\\n      expect(wrapper.vm.filters.search).toBe('13800138000')\\n    })\\n  })\\n\\n  describe('视图模式', () => {\\n    it('应该支持列表视图', () => {\\n      wrapper.vm.setViewMode('list')\\n      expect(wrapper.vm.viewMode).toBe('list')\\n    })\\n\\n    it('应该支持看板视图', () => {\\n      wrapper.vm.setViewMode('kanban')\\n      expect(wrapper.vm.viewMode).toBe('kanban')\\n    })\\n\\n    it('应该支持时间线视图', () => {\\n      wrapper.vm.setViewMode('timeline')\\n      expect(wrapper.vm.viewMode).toBe('timeline')\\n    })\\n\\n    it('应该在切换视图时保持筛选条件', () => {\\n      wrapper.vm.filters = { status: ['pending'], type: ['dine_in'], search: '张三' }\\n      wrapper.vm.setViewMode('kanban')\\n      expect(wrapper.vm.filters.status).toContain('pending')\\n    })\\n  })\\n\\n  describe('订单操作', () => {\\n    it('应该支持查看订单详情', () => {\\n      wrapper.vm.orders = mockOrders\\n      wrapper.vm.handleOrderClick(mockOrders[0])\\n      expect(wrapper.vm.selectedOrder).toEqual(mockOrders[0])\\n    })\\n\\n    it('应该支持创建新订单', () => {\\n      wrapper.vm.handleCreateOrder()\\n      expect(wrapper.vm.showCreateDialog).toBeDefined()\\n    })\\n\\n    it('应该支持确认订单', async () => {\\n      const mockAPI = OrderAPI.default\\n      mockAPI.updateOrderStatus.mockResolvedValue({ success: true })\\n\\n      wrapper.vm.orders = mockOrders\\n      await wrapper.vm.confirmOrder(mockOrders[0])\\n\\n      expect(mockAPI.updateOrderStatus).toHaveBeenCalled()\\n    })\\n\\n    it('应该支持取消订单', async () => {\\n      const mockAPI = OrderAPI.default\\n      mockAPI.cancelOrder.mockResolvedValue({ success: true })\\n\\n      wrapper.vm.orders = mockOrders\\n      await wrapper.vm.cancelOrder(mockOrders[0])\\n\\n      expect(mockAPI.cancelOrder).toHaveBeenCalled()\\n    })\\n\\n    it('应该支持打印订单', async () => {\\n      const mockAPI = OrderAPI.default\\n      mockAPI.printOrder.mockResolvedValue({ success: true })\\n\\n      wrapper.vm.orders = mockOrders\\n      await wrapper.vm.printOrder(mockOrders[0])\\n\\n      expect(mockAPI.printOrder).toHaveBeenCalled()\\n    })\\n\\n    it('应该支持退款订单', async () => {\\n      const mockAPI = OrderAPI.default\\n      mockAPI.refundOrder.mockResolvedValue({ success: true })\\n\\n      wrapper.vm.orders = mockOrders\\n      await wrapper.vm.refundOrder(mockOrders[0])\\n\\n      expect(mockAPI.refundOrder).toHaveBeenCalled()\\n    })\\n  })\\n\\n  describe('批量操作', () => {\\n    it('应该支持批量选择订单', () => {\\n      wrapper.vm.handleSelectionChange(mockOrders)\\n      expect(wrapper.vm.selectedOrders).toEqual(mockOrders)\\n    })\\n\\n    it('应该支持批量确认订单', async () => {\\n      const mockAPI = OrderAPI.default\\n      mockAPI.batchOperation.mockResolvedValue({ success: true })\\n\\n      wrapper.vm.selectedOrders = mockOrders\\n      await wrapper.vm.handleBatchAction('confirm')\\n\\n      expect(mockAPI.batchOperation).toHaveBeenCalled()\\n    })\\n\\n    it('应该支持批量取消订单', async () => {\\n      const mockAPI = OrderAPI.default\\n      mockAPI.batchOperation.mockResolvedValue({ success: true })\\n\\n      wrapper.vm.selectedOrders = mockOrders\\n      await wrapper.vm.handleBatchAction('cancel')\\n\\n      expect(mockAPI.batchOperation).toHaveBeenCalled()\\n    })\\n\\n    it('应该支持批量导出订单', async () => {\\n      const mockAPI = OrderAPI.default\\n      mockAPI.batchOperation.mockResolvedValue({ success: true })\\n\\n      wrapper.vm.selectedOrders = mockOrders\\n      await wrapper.vm.handleBatchAction('export')\\n\\n      expect(mockAPI.batchOperation).toHaveBeenCalled()\\n    })\\n\\n    it('应该支持批量打印订单', async () => {\\n      const mockAPI = OrderAPI.default\\n      mockAPI.batchOperation.mockResolvedValue({ success: true })\\n\\n      wrapper.vm.selectedOrders = mockOrders\\n      await wrapper.vm.handleBatchAction('print')\\n\\n      expect(mockAPI.batchOperation).toHaveBeenCalled()\\n    })\\n\\n    it('应该在未选择订单时提示', async () => {\\n      wrapper.vm.selectedOrders = []\\n      await wrapper.vm.handleBatchAction('confirm')\\n      expect(wrapper.vm.selectedOrders.length).toBe(0)\\n    })\\n  })\\n\\n  describe('分页功能', () => {\\n    it('应该支持分页', () => {\\n      expect(wrapper.vm.pagination).toBeDefined()\\n    })\\n\\n    it('应该支持改变每页数量', () => {\\n      wrapper.vm.handleSizeChange(20)\\n      expect(wrapper.vm.pagination.pageSize).toBe(20)\\n    })\\n\\n    it('应该支持跳转页码', () => {\\n      wrapper.vm.handlePageChange(2)\\n      expect(wrapper.vm.pagination.page).toBe(2)\\n    })\\n\\n    it('应该在改变筛选条件时重置到第一页', () => {\\n      wrapper.vm.pagination.page = 5\\n      wrapper.vm.handleFilterChange()\\n      expect(wrapper.vm.pagination.page).toBe(1)\\n    })\\n  })\\n\\n  describe('订单统计', () => {\\n    it('应该正确加载统计数据', async () => {\\n      const mockAPI = OrderAPI.default\\n      mockAPI.getStatistics.mockResolvedValue({\\n        success: true,\\n        data: mockStatistics\\n      })\\n\\n      expect(wrapper.vm.loadStatistics).toBeDefined()\\n    })\\n\\n    it('应该正确显示订单趋势', () => {\\n      expect(wrapper.vm.statistics).toBeDefined()\\n    })\\n\\n    it('应该正确显示订单类型分布', () => {\\n      expect(wrapper.vm.statistics).toBeDefined()\\n    })\\n\\n    it('应该正确显示订单状态分布', () => {\\n      expect(wrapper.vm.statistics).toBeDefined()\\n    })\\n  })\\n\\n  describe('订单详情', () => {\\n    it('应该正确显示订单基本信息', () => {\\n      wrapper.vm.selectedOrder = mockOrders[0]\\n      expect(wrapper.vm.selectedOrder.orderNumber).toBe('ORD20250120001')\\n    })\\n\\n    it('应该正确显示客户信息', () => {\\n      wrapper.vm.selectedOrder = mockOrders[0]\\n      expect(wrapper.vm.selectedOrder.customerName).toBe('张三')\\n    })\\n\\n    it('应该正确显示订单商品', () => {\\n      wrapper.vm.selectedOrder = mockOrders[0]\\n      expect(wrapper.vm.selectedOrder.items.length).toBe(2)\\n    })\\n\\n    it('应该正确显示金额信息', () => {\\n      wrapper.vm.selectedOrder = mockOrders[0]\\n      expect(wrapper.vm.selectedOrder.totalAmount).toBe(128.00)\\n    })\\n\\n    it('应该正确显示订单备注', () => {\\n      wrapper.vm.selectedOrder = mockOrders[0]\\n      expect(wrapper.vm.selectedOrder.notes).toBe('少放辣')\\n    })\\n  })\\n\\n  describe('订单状态管理', () => {\\n    it('应该支持订单状态流转', () => {\\n      const order = { ...mockOrders[0], status: 'pending' as OrderStatus }\\n      order.status = 'confirmed' as OrderStatus\\n      expect(order.status).toBe('confirmed')\\n    })\\n\\n    it('应该支持待确认到已确认', () => {\\n      const order = { ...mockOrders[0], status: 'pending' as OrderStatus }\\n      expect(order.status).toBe('pending')\\n    })\\n\\n    it('应该支持已确认到制作中', () => {\\n      const order = { ...mockOrders[1], status: 'confirmed' as OrderStatus }\\n      expect(order.status).toBe('confirmed')\\n    })\\n\\n    it('应该支持制作中到已完成', () => {\\n      const order = { ...mockOrders[0], status: 'preparing' as OrderStatus }\\n      expect(order.status).toBe('preparing')\\n    })\\n  })\\n\\n  describe('响应式设计', () => {\\n    it('应该在窗口大小变化时调整布局', () => {\\n      expect(wrapper.vm.viewMode).toBeDefined()\\n    })\\n\\n    it('应该支持移动端视图', () => {\\n      expect(wrapper.vm.viewMode).toBeDefined()\\n    })\\n  })\\n\\n  describe('错误处理', () => {\\n    it('应该正确处理加载失败', async () => {\\n      const mockAPI = OrderAPI.default\\n      mockAPI.getOrders.mockRejectedValue(new Error('加载失败'))\\n\\n      try {\\n        await wrapper.vm.loadOrders()\\n      } catch (error) {\\n        expect(error).toBeDefined()\\n      }\\n    })\\n\\n    it('应该正确处理操作失败', async () => {\\n      const mockAPI = OrderAPI.default\\n      mockAPI.updateOrderStatus.mockRejectedValue(new Error('操作失败'))\\n\\n      try {\\n        await wrapper.vm.confirmOrder(mockOrders[0])\\n      } catch (error) {\\n        expect(error).toBeDefined()\\n      }\\n    })\\n  })\\n\\n  describe('生命周期', () => {\\n    it('应该在组件挂载时加载数据', async () => {\\n      expect(wrapper.vm.loadOrders).toBeDefined()\\n      expect(wrapper.vm.loadStatistics).toBeDefined()\\n    })\\n\\n    it('应该在组件卸载时清理资源', () => {\\n      wrapper.unmount()\\n      expect(wrapper.exists()).toBe(false)\\n    })\\n  })\\n})\\n\",\"originTextLength\":16169,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768892930560},{\"originRange\":{\"start\":{\"line\":430,\"character\":0},\"end\":{\"line\":430,\"character\":80}},\"modifyRange\":{\"start\":{\"line\":430,\"character\":0},\"end\":{\"line\":430,\"character\":80}},\"action\":\"None\",\"isLine\":false,\"originText\":\"      mockAPI.batchUpdateOrders.mockResolvedValue({ success: true, updated: 2 })\",\"originAcceptText\":\"      mockAPI.batchUpdateOrders.mockResolvedValue({ success: true, updated: 2 })\",\"originTextLength\":80,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768893024036},{\"originRange\":{\"start\":{\"line\":435,\"character\":0},\"end\":{\"line\":435,\"character\":58}},\"modifyRange\":{\"start\":{\"line\":435,\"character\":0},\"end\":{\"line\":435,\"character\":58}},\"action\":\"None\",\"isLine\":false,\"originText\":\"      expect(mockAPI.batchUpdateOrders).toHaveBeenCalled()\",\"originAcceptText\":\"      expect(mockAPI.batchUpdateOrders).toHaveBeenCalled()\",\"originTextLength\":58,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768893024095},{\"originRange\":{\"start\":{\"line\":440,\"character\":0},\"end\":{\"line\":440,\"character\":80}},\"modifyRange\":{\"start\":{\"line\":440,\"character\":0},\"end\":{\"line\":440,\"character\":80}},\"action\":\"None\",\"isLine\":false,\"originText\":\"      mockAPI.batchUpdateOrders.mockResolvedValue({ success: true, updated: 2 })\",\"originAcceptText\":\"      mockAPI.batchUpdateOrders.mockResolvedValue({ success: true, updated: 2 })\",\"originTextLength\":80,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768893024127},{\"originRange\":{\"start\":{\"line\":445,\"character\":0},\"end\":{\"line\":445