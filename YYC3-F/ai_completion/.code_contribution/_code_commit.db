: sorted[Math.floor(sorted.length * 0.5)],\\n        p95: sorted[Math.floor(sorted.length * 0.95)],\\n        p99: sorted[Math.floor(sorted.length * 0.99)]\\n      });\\n    }\\n    \\n    return result;\",\"originTextLength\":4968,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1767661840770},{\"originRange\":{\"start\":{\"line\":4287,\"character\":0},\"end\":{\"line\":4299,\"character\":18}},\"modifyRange\":{\"start\":{\"line\":4287,\"character\":0},\"end\":{\"line\":4299,\"character\":18}},\"action\":\"None\",\"isLine\":false,\"originText\":\"  private cache: Map<string, any>;\\\\n  private metrics: Map<string, number[]>;\\\\n  private performanceMonitor: PerformanceMonitor;\\\\n  private errorHandler: ErrorHandler;\\\\n  private audioProcessor: AudioProcessor;\\\\n\\\\n  constructor(private config: SpeechEngineConfig) {\\\\n    this.cache = new Map();\\\\n    this.metrics = new Map();\\\\n    this.performanceMonitor = new PerformanceMonitor();\\\\n    this.errorHandler = new ErrorHandler();\\\\n    this.audioProcessor = new AudioProcessor(config.audioConfig);\\\\n  }\\\\n\\\\n  // 语音识别 - 五高性能优化\",\"originAcceptText\":\"  private cache: Map<string, any>;\\n  private metrics: Map<string, number[]>;\\n  private performanceMonitor: PerformanceMonitor;\\n  private errorHandler: ErrorHandler;\\n  private audioProcessor: AudioProcessor;\\n\\n  constructor(private config: SpeechEngineConfig) {\\n    this.cache = new Map();\\n    this.metrics = new Map();\\n    this.performanceMonitor = new PerformanceMonitor();\\n    this.errorHandler = new ErrorHandler();\\n    this.audioProcessor = new AudioProcessor(config.audioConfig);\\n  }\\n\\n  // 语音识别 - 五高性能优化\",\"originTextLength\":507,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1767661933317},{\"originRange\":{\"start\":{\"line\":4289,\"character\":0},\"end\":{\"line\":4347,\"character\":5}},\"modifyRange\":{\"start\":{\"line\":4289,\"character\":0},\"end\":{\"line\":4347,\"character\