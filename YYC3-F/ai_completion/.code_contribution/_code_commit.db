  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/views/__tests__/KitchenManagement.test.ts": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":571,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":571,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"/**\\\\n * @fileoverview YYC³餐饮管理系统 - KitchenManagement组件单元测试\\\\n * @description 测试KitchenManagement组件的功能\\\\n * @module KitchenManagement.test\\\\n * @author YYC³\\\\n * @version 1.0.0\\\\n * @created 2025-01-20\\\\n */\\\\n\\\\nimport { describe, it, expect, beforeEach, vi } from \\\\'vitest\\\\'\\\\nimport { mount, VueWrapper } from \\\\'@vue/test-utils\\\\'\\\\nimport { createPinia, setActivePinia } from \\\\'pinia\\\\'\\\\nimport ElementPlus from \\\\'element-plus\\\\'\\\\nimport * as echarts from \\\\'echarts\\\\'\\\\nimport KitchenManagement from \\\\'@/views/KitchenManagement.vue\\\\'\\\\nimport { useKitchen } from \\\\'@/composables/useKitchen\\\\'\\\\nimport type {\\\\n  KitchenTask,\\\\n  KitchenEmployee,\\\\n  TaskStatus,\\\\n  EmployeeStatus,\\\\n  TaskStation,\\\\n  TaskPriority\\\\n} from \\\\'@/types/kitchen\\\\'\\\\n\\\\nvi.mock(\\\\'@/composables/useKitchen\\\\', () => ({\\\\n  useKitchen: vi.fn(() => ({\\\\n    loading: ref(false),\\\\n    stats: ref({\\\\n      activeTasks: 5,\\\\n      completedToday: 42,\\\\n      efficiencyRate: 85.5,\\\\n      averagePreparationTime: 900,\\\\n      totalEmployees: 10,\\\\n      onlineEmployees: 8,\\\\n      totalEquipment: 20,\\\\n      normalEquipment: 18,\\\\n      maintenanceEquipment: 2,\\\\n      lowStockItems: 3,\\\\n      expiredItems: 1\\\\n    }),\\\\n    tasks: ref([]),\\\\n    employees: ref([]),\\\\n    inventory: ref([]),\\\\n    taskPagination: ref({ page: 1, limit: 20, total: 0, totalPages: 0 }),\\\\n    loadStats: vi.fn(),\\\\n    loadTasks: vi.fn(),\\\\n    loadEmployees: vi.fn(),\\\\n    updateTaskStatus: vi.fn(),\\\\n    assignTask: vi.fn(),\\\\n    updateEmployeeStatus: vi.fn(),\\\\n    refreshData: vi.fn()\\\\n  }))\\\\n}))\\\\n\\\\nvi.mock(\\\\'echarts\\\\', () => ({\\\\n  default: {\\\\n    init: vi.fn(() => ({\\\\n      setOption: vi.fn(),\\\\n      resize: vi.fn(),\\\\n      dispose: vi.fn()\\\\n    }))\\\\n  }\\\\n}))\\\\n\\\\nvi.mock(\\\\'element-plus\\\\', () => ({\\\\n  ElMessage: {\\\\n    success: vi.fn(),\\\\n    error: vi.fn(),\\\\n    warning: vi.fn(),\\\\n    info: vi.fn()\\\\n  },\\\\n  ElMessageBox: {\\\\n    confirm: vi.fn()\\\\n  }\\\\n}))\\\\n\\\\ndescribe(\\\\'KitchenManagement组件\\\\', () => {\\\\n  let wrapper: VueWrapper<any>\\\\n  let pinia: any\\\\n\\\\n  const mockTasks: KitchenTask[] = [\\\\n    {\\\\n      id: \\\\'task-1\\\\',\\\\n      taskId: \\\\'TASK001\\\\',\\\\n      orderNo: \\\\'ORD001\\\\',\\\\n      itemName: \\\\'红烧肉\\\\',\\\\n      quantity: 2,\\\\n      station: \\\\'hot_dish\\\\',\\\\n      priority: \\\\'high\\\\',\\\\n      status: \\\\'pending\\\\',\\\\n      tableNumber: \\\\'A01\\\\',\\\\n      estimatedTime: 15,\\\\n      assignedTo: \\\\'emp-1\\\\',\\\\n      specialRequests: \\\\'少辣\\\\',\\\\n      createdAt: \\\\'2025-01-20T10:00:00Z\\\\'\\\\n    },\\\\n    {\\\\n      id: \\\\'task-2\\\\',\\\\n      taskId: \\\\'TASK002\\\\',\\\\n      orderNo: \\\\'ORD002\\\\',\\\\n      itemName: \\\\'清蒸鱼\\\\',\\\\n      quantity: 1,\\\\n      station: \\\\'hot_dish\\\\',\\\\n      priority: \\\\'normal\\\\',\\\\n      status: \\\\'preparing\\\\',\\\\n      tableNumber: \\\\'A02\\\\',\\\\n      estimatedTime: 20,\\\\n      assignedTo: \\\\'emp-2\\\\',\\\\n      createdAt: \\\\'2025-01-20T10:05:00Z\\\\'\\\\n    }\\\\n  ]\\\\n\\\\n  const mockEmployees: KitchenEmployee[] = [\\\\n    {\\\\n      id: \\\\'emp-1\\\\',\\\\n      employeeCode: \\\\'KITCHEN001\\\\',\\\\n      name: \\\\'张三\\\\',\\\\n      avatar: \\\\'https://example.com/avatar1.jpg\\\\',\\\\n      position: \\\\'chef\\\\',\\\\n      status: \\\\'online\\\\',\\\\n      phone: \\\\'13800138000\\\\',\\\\n      email: \\\\'zhangsan@example.com\\\\',\\\\n      hireDate: \\\\'2023-01-01\\\\',\\\\n      skills: [\\\\'炒菜\\\\', \\\\'炖汤\\\\', \\\\'切配\\\\'],\\\\n      certifications: [\\\\n        {\\\\n          id: \\\\'cert-1\\\\',\\\\n          name: \\\\'厨师证\\\\',\\\\n          issueDate: \\\\'2022-01-01\\\\',\\\\n          expiryDate: \\\\'2025-01-01\\\\',\\\\n          issuer: \\\\'北京市烹饪协会\\\\'\\\\n        }\\\\n      ],\\\\n      currentTasks: 2,\\\\n      totalTasksCompleted: 150,\\\\n      efficiency: 92.5,\\\\n      averageTime: 12,\\\\n      workSchedule: [],\\\\n      createdAt: \\\\'2023-01-01T00:00:00Z\\\\'\\\\n    },\\\\n    {\\\\n      id: \\\\'emp-2\\\\',\\\\n      employeeCode: \\\\'KITCHEN002\\\\',\\\\n      name: \\\\'李四\\\\',\\\\n      avatar: \\\\'https://example.com/avatar2.jpg\\\\',\\\\n      position: \\\\'line_cook\\\\',\\\\n      status: \\\\'busy\\\\',\\\\n      phone: \\\\'13900139000\\\\',\\\\n      email: \\\\'lisi@example.com\\\\',\\\\n      hireDate: \\\\'2023-06-01\\\\',\\\\n      skills: [\\\\'切配\\\\', \\\\'备菜\\\\'],\\\\n      certifications: [],\\\\n      currentTasks: 3,\\\\n      totalTasksCompleted: 120,\\\\n      efficiency: 88.0,\\\\n      averageTime: 15,\\\\n      workSchedule: [],\\\\n      createdAt: \\\\'2023-06-01T00:00:00Z\\\\'\\\\n    }\\\\n  ]\\\\n\\\\n  beforeEach(() => {\\\\n    pinia = createPinia()\\\\n    setActivePinia(pinia)\\\\n\\\\n    vi.clearAllMocks()\\\\n\\\\n    wrapper = mount(KitchenManagement, {\\\\n      global: {\\\\n        plugins: [pinia, ElementPlus],\\\\n        stubs: {\\\\n          \\\\'el-card\\\\': true,\\\\n          \\\\'el-row\\\\': true,\\\\n          \\\\'el-col\\\\': true,\\\\n          \\\\'el-tabs\\\\': true,\\\\n          \\\\'el-tab-pane\\\\': true,\\\\n          \\\\'el-button\\\\': true,\\\\n          \\\\'el-button-group\\\\': true,\\\\n          \\\\'el-icon\\\\': true,\\\\n          \\\\'el-tag\\\\': true,\\\\n          \\\\'el-table\\\\': true,\\\\n          \\\\'el-table-column\\\\': true,\\\\n          \\\\'el-pagination\\\\': true,\\\\n          \\\\'el-dialog\\\\': true,\\\\n          \\\\'el-form\\\\': true,\\\\n          \\\\'el-form-item\\\\': true,\\\\n          \\\\'el-input\\\\': true,\\\\n          \\\\'el-input-number\\\\': true,\\\\n          \\\\'el-select\\\\': true,\\\\n          \\\\'el-option\\\\': true,\\\\n          \\\\'el-radio\\\\': true,\\\\n          \\\\'el-radio-group\\\\': true,\\\\n          \\\\'el-date-picker\\\\': true,\\\\n          \\\\'el-time-picker\\\\': true,\\\\n          \\\\'el-switch\\\\': true,\\\\n          \\\\'el-dropdown\\\\': true,\\\\n          \\\\'el-dropdown-menu\\\\': true,\\\\n          \\\\'el-dropdown-item\\\\': true,\\\\n          \\\\'el-rate\\\\': true,\\\\n          \\\\'el-avatar\\\\': true,\\\\n          \\\\'el-divider\\\\': true,\\\\n          \\\\'el-alert\\\\': true,\\\\n          \\\\'el-tooltip\\\\': true,\\\\n          \\\\'el-popover\\\\': true,\\\\n          \\\\'el-progress\\\\': true,\\\\n          \\\\'el-statistic\\\\': true,\\\\n          \\\\'el-badge\\\\': true,\\\\n          \\\\'el-empty\\\\': true\\\\n        }\\\\n      }\\\\n    })\\\\n  })\\\\n\\\\n  afterEach(() => {\\\\n    wrapper.unmount()\\\\n  })\\\\n\\\\n  describe(\\\\'组件渲染\\\\', () => {\\\\n    it(\\\\'应该正确渲染厨房管理页面\\\\', () => {\\\\n      expect(wrapper.find(\\\\'.kitchen-management\\\\').exists()).toBe(true)\\\\n      expect(wrapper.find(\\\\'.page-title\\\\').text()).toBe(\\\\'厨房管理\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该显示页面描述\\\\', () => {\\\\n      expect(wrapper.find(\\\\'.page-description\\\\').text()).toBe(\\\\'管理厨房任务、员工分配和效率监控\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该显示统计卡片\\\\', () => {\\\\n      const statCards = wrapper.findAll(\\\\'.stat-card\\\\')\\\\n      expect(statCards.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该显示功能标签页\\\\', () => {\\\\n      const tabs = wrapper.find(\\\\'.el-tabs\\\\')\\\\n      expect(tabs.exists()).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该显示头部操作按钮\\\\', () => {\\\\n      const buttons = wrapper.findAll(\\\\'.header-actions .el-button\\\\')\\\\n      expect(buttons.length).toBe(3)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'统计数据\\\\', () => {\\\\n    it(\\\\'应该正确显示进行中任务数\\\\', () => {\\\\n      const activeTasksValue = wrapper.find(\\\\'.stat-value\\\\').text()\\\\n      expect(activeTasksValue).toBe(\\\\'5\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示今日完成数\\\\', () => {\\\\n      expect(wrapper.vm.stats.completedToday).toBe(42)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示效率率\\\\', () => {\\\\n      expect(wrapper.vm.stats.efficiencyRate).toBe(85.5)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示平均准备时间\\\\', () => {\\\\n      expect(wrapper.vm.stats.averagePreparationTime).toBe(900)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示员工总数\\\\', () => {\\\\n      expect(wrapper.vm.stats.totalEmployees).toBe(10)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示在线员工数\\\\', () => {\\\\n      expect(wrapper.vm.stats.onlineEmployees).toBe(8)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示设备总数\\\\', () => {\\\\n      expect(wrapper.vm.stats.totalEquipment).toBe(20)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示正常设备数\\\\', () => {\\\\n      expect(wrapper.vm.stats.normalEquipment).toBe(18)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示维护设备数\\\\', () => {\\\\n      expect(wrapper.vm.stats.maintenanceEquipment).toBe(2)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示低库存项数\\\\', () => {\\\\n      expect(wrapper.vm.stats.lowStockItems).toBe(3)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示过期项数\\\\', () => {\\\\n      expect(wrapper.vm.stats.expiredItems).toBe(1)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'任务管理\\\\', () => {\\\\n    it(\\\\'应该正确加载任务列表\\\\', async () => {\\\\n      const mockComposable = useKitchen()\\\\n      mockComposable.tasks.value = mockTasks\\\\n\\\\n      await wrapper.vm.$nextTick()\\\\n\\\\n      expect(wrapper.vm.tasks).toEqual(mockTasks)\\\\n      expect(wrapper.vm.tasks.length).toBe(2)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示任务编号\\\\', () => {\\\\n      wrapper.vm.tasks = mockTasks\\\\n      const hasTaskCode = mockTasks.some(task => task.taskId.includes(\\\\'TASK\\\\'))\\\\n      expect(hasTaskCode).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示订单号\\\\', () => {\\\\n      wrapper.vm.tasks = mockTasks\\\\n      const hasOrderNo = mockTasks.some(task => task.orderNo.includes(\\\\'ORD\\\\'))\\\\n      expect(hasOrderNo).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示菜品名称\\\\', () => {\\\\n      wrapper.vm.tasks = mockTasks\\\\n      const hasItemName = mockTasks.some(task => task.itemName.includes(\\\\'肉\\\\') || task.itemName.includes(\\\\'鱼\\\\'))\\\\n      expect(hasItemName).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示数量\\\\', () => {\\\\n      wrapper.vm.tasks = mockTasks\\\\n      const hasQuantity = mockTasks.some(task => task.quantity > 0)\\\\n      expect(hasQuantity).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示工位\\\\', () => {\\\\n      wrapper.vm.tasks = mockTasks\\\\n      const hasStation = mockTasks.some(task => task.station === \\\\'hot_dish\\\\')\\\\n      expect(hasStation).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示优先级\\\\', () => {\\\\n      wrapper.vm.tasks = mockTasks\\\\n      const hasPriority = mockTasks.some(task => task.priority === \\\\'high\\\\' || task.priority === \\\\'normal\\\\')\\\\n      expect(hasPriority).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示状态\\\\', () => {\\\\n      wrapper.vm.tasks = mockTasks\\\\n      const hasStatus = mockTasks.some(task => task.status === \\\\'pending\\\\' || task.status === \\\\'preparing\\\\')\\\\n      expect(hasStatus).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示桌号\\\\', () => {\\\\n      wrapper.vm.tasks = mockTasks\\\\n      const hasTableNumber = mockTasks.some(task => task.tableNumber.includes(\\\\'A\\\\'))\\\\n      expect(hasTableNumber).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示预估时间\\\\', () => {\\\\n      wrapper.vm.tasks = mockTasks\\\\n      const hasEstimatedTime = mockTasks.some(task => task.estimatedTime > 0)\\\\n      expect(hasEstimatedTime).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示分配员工\\\\', () => {\\\\n      wrapper.vm.tasks = mockTasks\\\\n      const hasAssignedTo = mockTasks.some(task => task.assignedTo && task.assignedTo.includes(\\\\'emp\\\\'))\\\\n      expect(hasAssignedTo).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示特殊要求\\\\', () => {\\\\n      wrapper.vm.tasks = mockTasks\\\\n      const hasSpecialRequests = mockTasks.some(task => task.specialRequests && task.specialRequests.length > 0)\\\\n      expect(hasSpecialRequests).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该支持任务状态更新\\\\', async () => {\\\\n      const mockComposable = useKitchen()\\\\n      mockComposable.updateTaskStatus.mockResolvedValue({ success: true })\\\\n\\\\n      await wrapper.vm.handleTaskStatusChange(\\\\'task-1\\\\', \\\\'preparing\\\\' as TaskStatus)\\\\n\\\\n      expect(mockComposable.updateTaskStatus).toHaveBeenCalledWith(\\\\'task-1\\\\', \\\\'preparing\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该支持任务分配\\\\', async () => {\\\\n      const mockComposable = useKitchen()\\\\n      mockComposable.assignTask.mockResolvedValue({ success: true })\\\\n\\\\n      await wrapper.vm.assignTask(\\\\'task-1\\\\', \\\\'emp-2\\\\')\\\\n\\\\n      expect(mockComposable.assignTask).toHaveBeenCalledWith(\\\\'task-1\\\\', \\\\'emp-2\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该支持任务筛选\\\\', () => {\\\\n      wrapper.vm.taskFilters = {\\\\n        station: \\\\'hot_dish\\\\' as TaskStation,\\\\n        status: \\\\'pending\\\\' as TaskStatus,\\\\n        priority: \\\\'high\\\\' as TaskPriority,\\\\n        search: \\\\'红烧肉\\\\'\\\\n      }\\\\n\\\\n      expect(wrapper.vm.taskFilters.station).toBe(\\\\'hot_dish\\\\')\\\\n      expect(wrapper.vm.taskFilters.status).toBe(\\\\'pending\\\\')\\\\n      expect(wrapper.vm.taskFilters.priority).toBe(\\\\'high\\\\')\\\\n      expect(wrapper.vm.taskFilters.search).toBe(\\\\'红烧肉\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该支持任务排序\\\\', () => {\\\\n      wrapper.vm.taskSort = {\\\\n        sortBy: \\\\'priority\\\\',\\\\n        sortOrder: \\\\'desc\\\\'\\\\n      }\\\\n\\\\n      expect(wrapper.vm.taskSort.sortBy).toBe(\\\\'priority\\\\')\\\\n      expect(wrapper.vm.taskSort.sortOrder).toBe(\\\\'desc\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'员工管理\\\\', () => {\\\\n    it(\\\\'应该正确加载员工列表\\\\', async () => {\\\\n      const mockComposable = useKitchen()\\\\n      mockComposable.employees.value = mockEmployees\\\\n\\\\n      await wrapper.vm.$nextTick()\\\\n\\\\n      expect(wrapper.vm.employees).toEqual(mockEmployees)\\\\n      expect(wrapper.vm.employees.length).toBe(2)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示员工编号\\\\', () => {\\\\n      wrapper.vm.employees = mockEmployees\\\\n      const hasEmployeeCode = mockEmployees.some(emp => emp.employeeCode.includes(\\\\'KITCHEN\\\\'))\\\\n      expect(hasEmployeeCode).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示员工姓名\\\\', () => {\\\\n      wrapper.vm.employees = mockEmployees\\\\n      const hasName = mockEmployees.some(emp => emp.name === \\\\'张三\\\\' || emp.name === \\\\'李四\\\\')\\\\n      expect(hasName).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示职位\\\\', () => {\\\\n      wrapper.vm.employees = mockEmployees\\\\n      const hasPosition = mockEmployees.some(emp => emp.position === \\\\'chef\\\\' || emp.position === \\\\'line_cook\\\\')\\\\n      expect(hasPosition).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示状态\\\\', () => {\\\\n      wrapper.vm.employees = mockEmployees\\\\n      const hasStatus = mockEmployees.some(emp => emp.status === \\\\'online\\\\' || emp.status === \\\\'busy\\\\')\\\\n      expect(hasStatus).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示当前任务数\\\\', () => {\\\\n      wrapper.vm.employees = mockEmployees\\\\n      const hasCurrentTasks = mockEmployees.some(emp => emp.currentTasks > 0)\\\\n      expect(hasCurrentTasks).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示完成任务数\\\\', () => {\\\\n      wrapper.vm.employees = mockEmployees\\\\n      const hasTotalTasksCompleted = mockEmployees.some(emp => emp.totalTasksCompleted > 0)\\\\n      expect(hasTotalTasksCompleted).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示效率\\\\', () => {\\\\n      wrapper.vm.employees = mockEmployees\\\\n      const hasEfficiency = mockEmployees.some(emp => emp.efficiency > 0)\\\\n      expect(hasEfficiency).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示平均时间\\\\', () => {\\\\n      wrapper.vm.employees = mockEmployees\\\\n      const hasAverageTime = mockEmployees.some(emp => emp.averageTime > 0)\\\\n      expect(hasAverageTime).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示技能\\\\', () => {\\\\n      wrapper.vm.employees = mockEmployees\\\\n      const hasSkills = mockEmployees.some(emp => emp.skills && emp.skills.length > 0)\\\\n      expect(hasSkills).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该支持员工状态更新\\\\', async () => {\\\\n      const mockComposable = useKitchen()\\\\n      mockComposable.updateEmployeeStatus.mockResolvedValue({ success: true })\\\\n\\\\n      await wrapper.vm.handleEmployeeStatusChange(\\\\'emp-1\\\\', \\\\'break\\\\' as EmployeeStatus)\\\\n\\\\n      expect(mockComposable.updateEmployeeStatus).toHaveBeenCalledWith(\\\\'emp-1\\\\', \\\\'break\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该支持员工筛选\\\\', () => {\\\\n      wrapper.vm.employeeFilters = {\\\\n        position: \\\\'chef\\\\',\\\\n        status: \\\\'online\\\\' as EmployeeStatus,\\\\n        search: \\\\'张三\\\\'\\\\n      }\\\\n\\\\n      expect(wrapper.vm.employeeFilters.position).toBe(\\\\'chef\\\\')\\\\n      expect(wrapper.vm.employeeFilters.status).toBe(\\\\'online\\\\')\\\\n      expect(wrapper.vm.employeeFilters.search).toBe(\\\\'张三\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'标签页切换\\\\', () => {\\\\n    it(\\\\'应该正确切换到任务管理标签\\\\', async () => {\\\\n      await wrapper.vm.handleTabChange(\\\\'tasks\\\\')\\\\n      expect(wrapper.vm.activeTab).toBe(\\\\'tasks\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该正确切换到员工管理标签\\\\', async () => {\\\\n      await wrapper.vm.handleTabChange(\\\\'staff\\\\')\\\\n      expect(wrapper.vm.activeTab).toBe(\\\\'staff\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该正确切换到数据分析标签\\\\', async () => {\\\\n      await wrapper.vm.handleTabChange(\\\\'analytics\\\\')\\\\n      expect(wrapper.vm.activeTab).toBe(\\\\'analytics\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该在切换标签时重新加载数据\\\\', async () => {\\\\n      const mockComposable = useKitchen()\\\\n\\\\n      await wrapper.vm.handleTabChange(\\\\'tasks\\\\')\\\\n\\\\n      expect(mockComposable.loadTasks).toHaveBeenCalled()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'刷新数据\\\\', () => {\\\\n    it(\\\\'应该成功刷新所有数据\\\\', async () => {\\\\n      const mockComposable = useKitchen()\\\\n      mockComposable.refreshData.mockResolvedValue()\\\\n\\\\n      await wrapper.vm.refreshData()\\\\n\\\\n      expect(mockComposable.refreshData).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该在刷新时显示加载状态\\\\', async () => {\\\\n      const mockComposable = useKitchen()\\\\n      mockComposable.loading.value = true\\\\n\\\\n      await wrapper.vm.refreshData()\\\\n\\\\n      expect(mockComposable.loading.value).toBe(true)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'对话框管理\\\\', () => {\\\\n    it(\\\\'应该正确显示新建任务对话框\\\\', async () => {\\\\n      await wrapper.vm.showCreateTaskDialog()\\\\n      expect(wrapper.vm.taskDialogVisible).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示批量操作对话框\\\\', async () => {\\\\n      await wrapper.vm.showBulkOperationDialog()\\\\n      expect(wrapper.vm.bulkOperationDialogVisible).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确关闭对话框\\\\', async () => {\\\\n      wrapper.vm.taskDialogVisible = true\\\\n      await wrapper.vm.closeTaskDialog()\\\\n      expect(wrapper.vm.taskDialogVisible).toBe(false)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'表单验证\\\\', () => {\\\\n    it(\\\\'应该验证任务表单\\\\', async () => {\\\\n      wrapper.vm.taskForm = {\\\\n        taskId: \\\\'TASK003\\\\',\\\\n        orderNo: \\\\'ORD003\\\\',\\\\n        itemName: \\\\'宫保鸡丁\\\\',\\\\n        quantity: 1,\\\\n        station: \\\\'hot_dish\\\\' as TaskStation,\\\\n        priority: \\\\'normal\\\\' as TaskPriority,\\\\n        tableNumber: \\\\'A03\\\\',\\\\n        estimatedTime: 18\\\\n      }\\\\n\\\\n      const isValid = await wrapper.vm.validateTaskForm()\\\\n      expect(isValid).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该验证员工表单\\\\', async () => {\\\\n      wrapper.vm.employeeForm = {\\\\n        employeeCode: \\\\'KITCHEN003\\\\',\\\\n        name: \\\\'王五\\\\',\\\\n        position: \\\\'line_cook\\\\',\\\\n        status: \\\\'online\\\\' as EmployeeStatus,\\\\n        phone: \\\\'13700137000\\\\',\\\\n        email: \\\\'wangwu@example.com\\\\'\\\\n      }\\\\n\\\\n      const isValid = await wrapper.vm.validateEmployeeForm()\\\\n      expect(isValid).toBe(true)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'分页\\\\', () => {\\\\n    it(\\\\'应该正确处理分页变化\\\\', async () => {\\\\n      await wrapper.vm.handlePageChange(2)\\\\n      expect(wrapper.vm.taskPagination.page).toBe(2)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确处理每页数量变化\\\\', async () => {\\\\n      await wrapper.vm.handleSizeChange(50)\\\\n      expect(wrapper.vm.taskPagination.limit).toBe(50)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'数据分析\\\\', () => {\\\\n    it(\\\\'应该正确初始化图表\\\\', () => {\\\\n      expect(wrapper.vm.taskDistributionChart).toBeDefined()\\\\n      expect(wrapper.vm.stationDistributionChart).toBeDefined()\\\\n      expect(wrapper.vm.staffEfficiencyChart).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该在数据分析标签页加载图表\\\\', async () => {\\\\n      await wrapper.vm.handleTabChange(\\\\'analytics\\\\')\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确更新图表数据\\\\', async () => {\\\\n      const mockComposable = useKitchen()\\\\n      mockComposable.loadStats.mockResolvedValue()\\\\n\\\\n      await wrapper.vm.refreshData()\\\\n\\\\n      expect(mockComposable.loadStats).toHaveBeenCalled()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'响应式设计\\\\', () => {\\\\n    it(\\\\'应该在窗口大小变化时调整图表\\\\', async () => {\\\\n      const mockComposable = useKitchen()\\\\n      mockComposable.loadStats.mockResolvedValue()\\\\n\\\\n      await wrapper.vm.handleResize()\\\\n\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'错误处理\\\\', () => {\\\\n    it(\\\\'应该正确处理加载失败\\\\', async () => {\\\\n      const mockComposable = useKitchen()\\\\n      mockComposable.loadTasks.mockRejectedValue(new Error(\\\\'加载失败\\\\'))\\\\n\\\\n      await wrapper.vm.loadTasks()\\\\n\\\\n      expect(wrapper.vm.loading).toBe(false)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确处理更新失败\\\\', async () => {\\\\n      const mockComposable = useKitchen()\\\\n      mockComposable.updateTaskStatus.mockRejectedValue(new Error(\\\\'更新失败\\\\'))\\\\n\\\\n      await wrapper.vm.handleTaskStatusChange(\\\\'task-1\\\\', \\\\'preparing\\\\' as TaskStatus)\\\\n\\\\n      expect(wrapper.vm.loading).toBe(false)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'生命周期\\\\', () => {\\\\n    it(\\\\'应该在组件挂载时加载数据\\\\', async () => {\\\\n      const mockComposable = useKitchen()\\\\n      mockComposable.loadStats.mockResolvedValue()\\\\n      mockComposable.loadTasks.mockResolvedValue()\\\\n      mockComposable.loadEmployees.mockResolvedValue()\\\\n\\\\n      await wrapper.vm.onMounted()\\\\n\\\\n      expect(mockComposable.loadStats).toHaveBeenCalled()\\\\n      expect(mockComposable.loadTasks).toHaveBeenCalled()\\\\n      expect(mockComposable.loadEmployees).toHaveBeenCalled()\\\\n    })\\\\n\\\\n    it(\\\\'应该在组件卸载时清理图表\\\\', () => {\\\\n      wrapper.unmount()\\\\n\\\\n      expect(echarts.init).toHaveBeenCalled()\\\\n    })\\\\n  })\\\\n})\\\\n\",\"originAcceptText\":\"/**\\n * @fileoverview YYC³餐饮管理系统 - KitchenManagement组件单元测试\\n * @description 测试KitchenManagement组件的功能\\n * @module KitchenManagement.test\\n * @author YYC³\\n * @version 1.0.0\\n * @created 2025-01-20\\n */\\n\\nimport { describe, it, expect, beforeEach, vi } from 'vitest'\\nimport { mount, VueWrapper } from '@vue/test-utils'\\nimport { createPinia, setActivePinia } from 'pinia'\\nimport ElementPlus from 'element-plus'\\nimport * as echarts from 'echarts'\\nimport KitchenManagement from '@/views/KitchenManagement.vue'\\nimport { useKitchen } from '@/composables/useKitchen'\\nimport type {\\n  KitchenTask,\\n  KitchenEmployee,\\n  TaskStatus,\\n  EmployeeStatus,\\n  TaskStation,\\n  TaskPriority\\n} from '@/types/kitchen'\\n\\nvi.mock('@/composables/useKitchen', () => ({\\n  useKitchen: vi.fn(() => ({\\n    loading: ref(false),\\n    stats: ref({\\n      activeTasks: 5,\\n      completedToday: 42,\\n      efficiencyRate: 85.5,\\n      averagePreparationTime: 900,\\n      totalEmployees: 10,\\n      onlineEmployees: 8,\\n      totalEquipment: 20,\\n      normalEquipment: 18,\\n      maintenanceEquipment: 2,\\n      lowStockItems: 3,\\n      expiredItems: 1\\n    }),\\n    tasks: ref([]),\\n    employees: ref([]),\\n    inventory: ref([]),\\n    taskPagination: ref({ page: 1, limit: 20, total: 0, totalPages: 0 }),\\n    loadStats: vi.fn(),\\n    loadTasks: vi.fn(),\\n    loadEmployees: vi.fn(),\\n    updateTaskStatus: vi.fn(),\\n    assignTask: vi.fn(),\\n    updateEmployeeStatus: vi.fn(),\\n    refreshData: vi.fn()\\n  }))\\n}))\\n\\nvi.mock('echarts', () => ({\\n  default: {\\n    init: vi.fn(() => ({\\n      setOption: vi.fn(),\\n      resize: vi.fn(),\\n      dispose: vi.fn()\\n    }))\\n  }\\n}))\\n\\nvi.mock('element-plus', () => ({\\n  ElMessage: {\\n    success: vi.fn(),\\n    error: vi.fn(),\\n    warning: vi.fn(),\\n    info: vi.fn()\\n  },\\n  ElMessageBox: {\\n    confirm: vi.fn()\\n  }\\n}))\\n\\ndescribe('KitchenManagement组件', () => {\\n  let wrapper: VueWrapper<any>\\n  let pinia: any\\n\\n  const mockTasks: KitchenTask[] = [\\n    {\\n      id: 'task-1',\\n      taskId: 'TASK001',\\n      orderNo: 'ORD001',\\n      itemName: '红烧肉',\\n      quantity: 2,\\n      station: 'hot_dish',\\n      priority: 'high',\\n      status: 'pending',\\n      tableNumber: 'A01',\\n      estimatedTime: 15,\\n      assignedTo: 'emp-1',\\n      specialRequests: '少辣',\\n      createdAt: '2025-01-20T10:00:00Z'\\n    },\\n    {\\n      id: 'task-2',\\n      taskId: 'TASK002',\\n      orderNo: 'ORD002',\\n      itemName: '清蒸鱼',\\n      quantity: 1,\\n      station: 'hot_dish',\\n      priority: 'normal',\\n      status: 'preparing',\\n      tableNumber: 'A02',\\n      estimatedTime: 20,\\n      assignedTo: 'emp-2',\\n      createdAt: '2025-01-20T10:05:00Z'\\n    }\\n  ]\\n\\n  const mockEmployees: KitchenEmployee[] = [\\n    {\\n      id: 'emp-1',\\n      employeeCode: 'KITCHEN001',\\n      name: '张三',\\n      avatar: 'https://example.com/avatar1.jpg',\\n      position: 'chef',\\n      status: 'online',\\n      phone: '13800138000',\\n      email: 'zhangsan@example.com',\\n      hireDate: '2023-01-01',\\n      skills: ['炒菜', '炖汤', '切配'],\\n      certifications: [\\n        {\\n          id: 'cert-1',\\n          name: '厨师证',\\n          issueDate: '2022-01-01',\\n          expiryDate: '2025-01-01',\\n          issuer: '北京市烹饪协会'\\n        }\\n      ],\\n      currentTasks: 2,\\n      totalTasksCompleted: 150,\\n      efficiency: 92.5,\\n      averageTime: 12,\\n      workSchedule: [],\\n      createdAt: '2023-01-01T00:00:00Z'\\n    },\\n    {\\n      id: 'emp-2',\\n      employeeCode: 'KITCHEN002',\\n      name: '李四',\\n      avatar: 'https://example.com/avatar2.jpg',\\n      position: 'line_cook',\\n      status: 'busy',\\n      phone: '13900139000',\\n      email: 'lisi@example.com',\\n      hireDate: '2023-06-01',\\n      skills: ['切配', '备菜'],\\n      certifications: [],\\n      currentTasks: 3,\\n      totalTasksCompleted: 120,\\n      efficiency: 88.0,\\n      averageTime: 15,\\n      workSchedule: [],\\n      createdAt: '2023-06-01T00:00:00Z'\\n    }\\n  ]\\n\\n  beforeEach(() => {\\n    pinia = createPinia()\\n    setActivePinia(pinia)\\n\\n    vi.clearAllMocks()\\n\\n    wrapper = mount(KitchenManagement, {\\n      global: {\\n        plugins: [pinia, ElementPlus],\\n        stubs: {\\n          'el-card': true,\\n          'el-row': true,\\n          'el-col': true,\\n          'el-tabs': true,\\n          'el-tab-pane': true,\\n          'el-button': true,\\n          'el-button-group': true,\\n          'el-icon': true,\\n          'el-tag': true,\\n          'el-table': true,\\n          'el-table-column': true,\\n          'el-pagination': true,\\n          'el-dialog': true,\\n          'el-form': true,\\n          'el-form-item': true,\\n          'el-input': true,\\n          'el-input-number': true,\\n          'el-select': true,\\n          'el-option': true,\\n          'el-radio': true,\\n          'el-radio-group': true,\\n          'el-date-picker': true,\\n          'el-time-picker': true,\\n          'el-switch': true,\\n          'el-dropdown': true,\\n          'el-dropdown-menu': true,\\n          'el-dropdown-item': true,\\n          'el-rate': true,\\n          'el-avatar': true,\\n          'el-divider': true,\\n          'el-alert': true,\\n          'el-tooltip': true,\\n          'el-popover': true,\\n          'el-progress': true,\\n          'el-statistic': true,\\n          'el-badge': true,\\n          'el-empty': true\\n        }\\n      }\\n    })\\n  })\\n\\n  afterEach(() => {\\n    wrapper.unmount()\\n  })\\n\\n  describe('组件渲染', () => {\\n    it('应该正确渲染厨房管理页面', () => {\\n      expect(wrapper.find('.kitchen-management').exists()).toBe(true)\\n      expect(wrapper.find('.page-title').text()).toBe('厨房管理')\\n    })\\n\\n    it('应该显示页面描述', () => {\\n      expect(wrapper.find('.page-description').text()).toBe('管理厨房任务、员工分配和效率监控')\\n    })\\n\\n    it('应该显示统计卡片', () => {\\n      const statCards = wrapper.findAll('.stat-card')\\n      expect(statCards.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该显示功能标签页', () => {\\n      const tabs = wrapper.find('.el-tabs')\\n      expect(tabs.exists()).toBe(true)\\n    })\\n\\n    it('应该显示头部操作按钮', () => {\\n      const buttons = wrapper.findAll('.header-actions .el-button')\\n      expect(buttons.length).toBe(3)\\n    })\\n  })\\n\\n  describe('统计数据', () => {\\n    it('应该正确显示进行中任务数', () => {\\n      const activeTasksValue = wrapper.find('.stat-value').text()\\n      expect(activeTasksValue).toBe('5')\\n    })\\n\\n    it('应该正确显示今日完成数', () => {\\n      expect(wrapper.vm.stats.completedToday).toBe(42)\\n    })\\n\\n    it('应该正确显示效率率', () => {\\n      expect(wrapper.vm.stats.efficiencyRate).toBe(85.5)\\n    })\\n\\n    it('应该正确显示平均准备时间', () => {\\n      expect(wrapper.vm.stats.averagePreparationTime).toBe(900)\\n    })\\n\\n    it('应该正确显示员工总数', () => {\\n      expect(wrapper.vm.stats.totalEmployees).toBe(10)\\n    })\\n\\n    it('应该正确显示在线员工数', () => {\\n      expect(wrapper.vm.stats.onlineEmployees).toBe(8)\\n    })\\n\\n    it('应该正确显示设备总数', () => {\\n      expect(wrapper.vm.stats.totalEquipment).toBe(20)\\n    })\\n\\n    it('应该正确显示正常设备数', () => {\\n      expect(wrapper.vm.stats.normalEquipment).toBe(18)\\n    })\\n\\n    it('应该正确显示维护设备数', () => {\\n      expect(wrapper.vm.stats.maintenanceEquipment).toBe(2)\\n    })\\n\\n    it('应该正确显示低库存项数', () => {\\n      expect(wrapper.vm.stats.lowStockItems).toBe(3)\\n    })\\n\\n    it('应该正确显示过期项数', () => {\\n      expect(wrapper.vm.stats.expiredItems).toBe(1)\\n    })\\n  })\\n\\n  describe('任务管理', () => {\\n    it('应该正确加载任务列表', async () => {\\n      const mockComposable = useKitchen()\\n      mockComposable.tasks.value = mockTasks\\n\\n      await wrapper.vm.$nextTick()\\n\\n      expect(wrapper.vm.tasks).toEqual(mockTasks)\\n      expect(wrapper.vm.tasks.length).toBe(2)\\n    })\\n\\n    it('应该正确显示任务编号', () => {\\n      wrapper.vm.tasks = mockTasks\\n      const hasTaskCode = mockTasks.some(task => task.taskId.includes('TASK'))\\n      expect(hasTaskCode).toBe(true)\\n    })\\n\\n    it('应该正确显示订单号', () => {\\n      wrapper.vm.tasks = mockTasks\\n      const hasOrderNo = mockTasks.some(task => task.orderNo.includes('ORD'))\\n      expect(hasOrderNo).toBe(true)\\n    })\\n\\n    it('应该正确显示菜品名称', () => {\\n      wrapper.vm.tasks = mockTasks\\n      const hasItemName = mockTasks.some(task => task.itemName.includes('肉') || task.itemName.includes('鱼'))\\n      expect(hasItemName).toBe(true)\\n    })\\n\\n    it('应该正确显示数量', () => {\\n      wrapper.vm.tasks = mockTasks\\n      const hasQuantity = mockTasks.some(task => task.quantity > 0)\\n      expect(hasQuantity).toBe(true)\\n    })\\n\\n    it('应该正确显示工位', () => {\\n      wrapper.vm.tasks = mockTasks\\n      const hasStation = mockTasks.some(task => task.station === 'hot_dish')\\n      expect(hasStation).toBe(true)\\n    })\\n\\n    it('应该正确显示优先级', () => {\\n      wrapper.vm.tasks = mockTasks\\n      const hasPriority = mockTasks.some(task => task.priority === 'high' || task.priority === 'normal')\\n      expect(hasPriority).toBe(true)\\n    })\\n\\n    it('应该正确显示状态', () => {\\n      wrapper.vm.tasks = mockTasks\\n      const hasStatus = mockTasks.some(task => task.status === 'pending' || task.status === 'preparing')\\n      expect(hasStatus).toBe(true)\\n    })\\n\\n    it('应该正确显示桌号', () => {\\n      wrapper.vm.tasks = mockTasks\\n      const hasTableNumber = mockTasks.some(task => task.tableNumber.includes('A'))\\n      expect(hasTableNumber).toBe(true)\\n    })\\n\\n    it('应该正确显示预估时间', () => {\\n      wrapper.vm.tasks = mockTasks\\n      const hasEstimatedTime = mockTasks.some(task => task.estimatedTime > 0)\\n      expect(hasEstimatedTime).toBe(true)\\n    })\\n\\n    it('应该正确显示分配员工', () => {\\n      wrapper.vm.tasks = mockTasks\\n      const hasAssignedTo = mockTasks.some(task => task.assignedTo && task.assignedTo.includes('emp'))\\n      expect(hasAssignedTo).toBe(true)\\n    })\\n\\n    it('应该正确显示特殊要求', () => {\\n      wrapper.vm.tasks = mockTasks\\n      const hasSpecialRequests = mockTasks.some(task => task.specialRequests && task.specialRequests.length > 0)\\n      expect(hasSpecialRequests).toBe(true)\\n    })\\n\\n    it('应该支持任务状态更新', async () => {\\n      const mockComposable = useKitchen()\\n      mockComposable.updateTaskStatus.mockResolvedValue({ success: true })\\n\\n      await wrapper.vm.handleTaskStatusChange('task-1', 'preparing' as TaskStatus)\\n\\n      expect(mockComposable.updateTaskStatus).toHaveBeenCalledWith('task-1', 'preparing')\\n    })\\n\\n    it('应该支持任务分配', async () => {\\n      const mockComposable = useKitchen()\\n      mockComposable.assignTask.mockResolvedValue({ success: true })\\n\\n      await wrapper.vm.assignTask('task-1', 'emp-2')\\n\\n      expect(mockComposable.assignTask).toHaveBeenCalledWith('task-1', 'emp-2')\\n    })\\n\\n    it('应该支持任务筛选', () => {\\n      wrapper.vm.taskFilters = {\\n        station: 'hot_dish' as TaskStation,\\n        status: 'pending' as TaskStatus,\\n        priority: 'high' as TaskPriority,\\n        search: '红烧肉'\\n      }\\n\\n      expect(wrapper.vm.taskFilters.station).toBe('hot_dish')\\n      expect(wrapper.vm.taskFilters.status).toBe('pending')\\n      expect(wrapper.vm.taskFilters.priority).toBe('high')\\n      expect(wrapper.vm.taskFilters.search).toBe('红烧肉')\\n    })\\n\\n    it('应该支持任务排序', () => {\\n      wrapper.vm.taskSort = {\\n        sortBy: 'priority',\\n        sortOrder: 'desc'\\n      }\\n\\n      expect(wrapper.vm.taskSort.sortBy).toBe('priority')\\n      expect(wrapper.vm.taskSort.sortOrder).toBe('desc')\\n    })\\n  })\\n\\n  describe('员工管理', () => {\\n    it('应该正确加载员工列表', async () => {\\n      const mockComposable = useKitchen()\\n      mockComposable.employees.value = mockEmployees\\n\\n      await wrapper.vm.$nextTick()\\n\\n      expect(wrapper.vm.employees).toEqual(mockEmployees)\\n      expect(wrapper.vm.employees.length).toBe(2)\\n    })\\n\\n    it('应该正确显示员工编号', () => {\\n      wrapper.vm.employees = mockEmployees\\n      const hasEmployeeCode = mockEmployees.some(emp => emp.employeeCode.includes('KITCHEN'))\\n      expect(hasEmployeeCode).toBe(true)\\n    })\\n\\n    it('应该正确显示员工姓名', () => {\\n      wrapper.vm.employees = mockEmployees\\n      const hasName = mockEmployees.some(emp => emp.name === '张三' || emp.name === '李四')\\n      expect(hasName).toBe(true)\\n    })\\n\\n    it('应该正确显示职位', () => {\\n      wrapper.vm.employees = mockEmployees\\n      const hasPosition = mockEmployees.some(emp => emp.position === 'chef' || emp.position === 'line_cook')\\n      expect(hasPosition).toBe(true)\\n    })\\n\\n    it('应该正确显示状态', () => {\\n      wrapper.vm.employees = mockEmployees\\n      const hasStatus = mockEmployees.some(emp => emp.status === 'online' || emp.status === 'busy')\\n      expect(hasStatus).toBe(true)\\n    })\\n\\n    it('应该正确显示当前任务数', () => {\\n      wrapper.vm.employees = mockEmployees\\n      const hasCurrentTasks = mockEmployees.some(emp => emp.currentTasks > 0)\\n      expect(hasCurrentTasks).toBe(true)\\n    })\\n\\n    it('应该正确显示完成任务数', () => {\\n      wrapper.vm.employees = mockEmployees\\n      const hasTotalTasksCompleted = mockEmployees.some(emp => emp.totalTasksCompleted > 0)\\n      expect(hasTotalTasksCompleted).toBe(true)\\n    })\\n\\n    it('应该正确显示效率', () => {\\n      wrapper.vm.employees = mockEmployees\\n      const hasEfficiency = mockEmployees.some(emp => emp.efficiency > 0)\\n      expect(hasEfficiency).toBe(true)\\n    })\\n\\n    it('应该正确显示平均时间', () => {\\n      wrapper.vm.employees = mockEmployees\\n      const hasAverageTime = mockEmployees.some(emp => emp.averageTime > 0)\\n      expect(hasAverageTime).toBe(true)\\n    })\\n\\n    it('应该正确显示技能', () => {\\n      wrapper.vm.employees = mockEmployees\\n      const hasSkills = mockEmployees.some(emp => emp.skills && emp.skills.length > 0)\\n      expect(hasSkills).toBe(true)\\n    })\\n\\n    it('应该支持员工状态更新', async () => {\\n      const mockComposable = useKitchen()\\n      mockComposable.updateEmployeeStatus.mockResolvedValue({ success: true })\\n\\n      await wrapper.vm.handleEmployeeStatusChange('emp-1', 'break' as EmployeeStatus)\\n\\n      expect(mockComposable.updateEmployeeStatus).toHaveBeenCalledWith('emp-1', 'break')\\n    })\\n\\n    it('应该支持员工筛选', () => {\\n      wrapper.vm.employeeFilters = {\\n        position: 'chef',\\n        status: 'online' as EmployeeStatus,\\n        search: '张三'\\n      }\\n\\n      expect(wrapper.vm.employeeFilters.position).toBe('chef')\\n      expect(wrapper.vm.employeeFilters.status).toBe('online')\\n      expect(wrapper.vm.employeeFilters.search).toBe('张三')\\n    })\\n  })\\n\\n  describe('标签页切换', () => {\\n    it('应该正确切换到任务管理标签', async () => {\\n      await wrapper.vm.handleTabChange('tasks')\\n      expect(wrapper.vm.activeTab).toBe('tasks')\\n    })\\n\\n    it('应该正确切换到员工管理标签', async () => {\\n      await wrapper.vm.handleTabChange('staff')\\n      expect(wrapper.vm.activeTab).toBe('staff')\\n    })\\n\\n    it('应该正确切换到数据分析标签', async () => {\\n      await wrapper.vm.handleTabChange('analytics')\\n      expect(wrapper.vm.activeTab).toBe('analytics')\\n    })\\n\\n    it('应该在切换标签时重新加载数据', async () => {\\n      const mockComposable = useKitchen()\\n\\n      await wrapper.vm.handleTabChange('tasks')\\n\\n      expect(mockComposable.loadTasks).toHaveBeenCalled()\\n    })\\n  })\\n\\n  describe('刷新数据', () => {\\n    it('应该成功刷新所有数据', async () => {\\n      const mockComposable = useKitchen()\\n      mockComposable.refreshData.mockResolvedValue()\\n\\n      await wrapper.vm.refreshData()\\n\\n      expect(mockComposable.refreshData).toHaveBeenCalled()\\n    })\\n\\n    it('应该在刷新时显示加载状态', async () => {\\n      const mockComposable = useKitchen()\\n      mockComposable.loading.value = true\\n\\n      await wrapper.vm.refreshData()\\n\\n      expect(mockComposable.loading.value).toBe(true)\\n    })\\n  })\\n\\n  describe('对话框管理', () => {\\n    it('应该正确显示新建任务对话框', async () => {\\n      await wrapper.vm.showCreateTaskDialog()\\n      expect(wrapper.vm.taskDialogVisible).toBe(true)\\n    })\\n\\n    it('应该正确显示批量操作对话框', async () => {\\n      await wrapper.vm.showBulkOperationDialog()\\n      expect(wrapper.vm.bulkOperationDialogVisible).toBe(true)\\n    })\\n\\n    it('应该正确关闭对话框', async () => {\\n      wrapper.vm.taskDialogVisible = true\\n      await wrapper.vm.closeTaskDialog()\\n      expect(wrapper.vm.taskDialogVisible).toBe(false)\\n    })\\n  })\\n\\n  describe('表单验证', () => {\\n    it('应该验证任务表单', async () => {\\n      wrapper.vm.taskForm = {\\n        taskId: 'TASK003',\\n        orderNo: 'ORD003',\\n        itemName: '宫保鸡丁',\\n        quantity: 1,\\n        station: 'hot_dish' as TaskStation,\\n        priority: 'normal' as TaskPriority,\\n        tableNumber: 'A03',\\n        estimatedTime: 18\\n      }\\n\\n      const isValid = await wrapper.vm.validateTaskForm()\\n      expect(isValid).toBe(true)\\n    })\\n\\n    it('应该验证员工表单', async () => {\\n      wrapper.vm.employeeForm = {\\n        employeeCode: 'KITCHEN003',\\n        name: '王五',\\n        position: 'line_cook',\\n        status: 'online' as EmployeeStatus,\\n        phone: '13700137000',\\n        email: 'wangwu@example.com'\\n      }\\n\\n      const isValid = await wrapper.vm.validateEmployeeForm()\\n      expect(isValid).toBe(true)\\n    })\\n  })\\n\\n  describe('分页', () => {\\n    it('应该正确处理分页变化', async () => {\\n      await wrapper.vm.handlePageChange(2)\\n      expect(wrapper.vm.taskPagination.page).toBe(2)\\n    })\\n\\n    it('应该正确处理每页数量变化', async () => {\\n      await wrapper.vm.handleSizeChange(50)\\n      expect(wrapper.vm.taskPagination.limit).toBe(50)\\n    })\\n  })\\n\\n  describe('数据分析', () => {\\n    it('应该正确初始化图表', () => {\\n      expect(wrapper.vm.taskDistributionChart).toBeDefined()\\n      expect(wrapper.vm.stationDistributionChart).toBeDefined()\\n      expect(wrapper.vm.staffEfficiencyChart).toBeDefined()\\n    })\\n\\n    it('应该在数据分析标签页加载图表', async () => {\\n      await wrapper.vm.handleTabChange('analytics')\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n\\n    it('应该正确更新图表数据', async () => {\\n      const mockComposable = useKitchen()\\n      mockComposable.loadStats.mockResolvedValue()\\n\\n      await wrapper.vm.refreshData()\\n\\n      expect(mockComposable.loadStats).toHaveBeenCalled()\\n    })\\n  })\\n\\n  describe('响应式设计', () => {\\n    it('应该在窗口大小变化时调整图表', async () => {\\n      const mockComposable = useKitchen()\\n      mockComposable.loadStats.mockResolvedValue()\\n\\n      await wrapper.vm.handleResize()\\n\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n  })\\n\\n  describe('错误处理', () => {\\n    it('应该正确处理加载失败', async () => {\\n      const mockComposable = useKitchen()\\n      mockComposable.loadTasks.mockRejectedValue(new Error('加载失败'))\\n\\n      await wrapper.vm.loadTasks()\\n\\n      expect(wrapper.vm.loading).toBe(false)\\n    })\\n\\n    it('应该正确处理更新失败', async () => {\\n      const mockComposable = useKitchen()\\n      mockComposable.updateTaskStatus.mockRejectedValue(new Error('更新失败'))\\n\\n      await wrapper.vm.handleTaskStatusChange('task-1', 'preparing' as TaskStatus)\\n\\n      expect(wrapper.vm.loading).toBe(false)\\n    })\\n  })\\n\\n  describe('生命周期', () => {\\n    it('应该在组件挂载时加载数据', async () => {\\n      const mockComposable = useKitchen()\\n      mockComposable.loadStats.mockResolvedValue()\\n      mockComposable.loadTasks.mockResolvedValue()\\n      mockComposable.loadEmployees.mockResolvedValue()\\n\\n      await wrapper.vm.onMounted()\\n\\n      expect(mockComposable.loadStats).toHaveBeenCalled()\\n      expect(mockComposable.loadTasks).toHaveBeenCalled()\\n      expect(mockComposable.loadEmployees).toHaveBeenCalled()\\n    })\\n\\n    it('应该在组件卸载时清理图表', () => {\\n      wrapper.unmount()\\n\\n      expect(echarts.init).toHaveBeenCalled()\\n    })\\n  })\\n})\\n\",\"originTextLength\":18602,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768887473241},{\"originRange\":{\"start\":{\"line\":12,\"character\":0},\"end\":{\"line\":12,\"character\":25}},\"modifyRange\