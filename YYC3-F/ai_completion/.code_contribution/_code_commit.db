{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":35}},\"action\":\"None\",\"isLine\":false,\"originText\":\"import { defineConfig } from \\\\'vite\\\\'\",\"originAcceptText\":\"import { defineConfig } from 'vite'\",\"originTextLength\":35,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768982010372},{\"originRange\":{\"start\":{\"line\":20,\"character\":0},\"end\":{\"line\":21,\"character\":27}},\"modifyRange\":{\"start\":{\"line\":20,\"character\":0},\"end\":{\"line\":21,\"character\":27}},\"action\":\"None\",\"isLine\":false,\"originText\":\"  root: \\\\'./ui\\\\',\\\\n  publicDir: \\\\'./ui/public\\\\',\",\"originAcceptText\":\"  root: './ui',\\n  publicDir: './ui/public',\",\"originTextLength\":43,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768982010423},{\"originRange\":{\"start\":{\"line\":20,\"character\":0},\"end\":{\"line\":20,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":20,\"character\":0},\"end\":{\"line\":20,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"\",\"originAcceptText\":\"\",\"originTextLength\":0,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768982216003},{\"originRange\":{\"start\":{\"line\":20,\"character\":0},\"end\":{\"line\":29,\"character\":4}},\"modifyRange\":{\"start\":{\"line\":20,\"character\":0},\"end\":{\"line\":29,\"character\":4}},\"action\":\"None\",\"isLine\":false,\"originText\":\"  test: {\\\\n    globals: true,\\\\n    environment: \\\\'jsdom\\\\',\\\\n    setupFiles: \\\\'./vitest.setup.ts\\\\',\\\\n    css: true,\\\\n    coverage: {\\\\n      provider: \\\\'v8\\\\',\\\\n      reporter: [\\\\'text\\\\', \\\\'json\\\\', \\\\'html\\\\'],\\\\n    },\\\\n  },\",\"originAcceptText\":\"  test: {\\n    globals: true,\\n    environment: 'jsdom',\\n    setupFiles: './vitest.setup.ts',\\n    css: true,\\n    coverage: {\\n      provider: 'v8',\\n      reporter: ['text', 'json', 'html'],\\n    },\\n  },\",\"originTextLength\":198,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1769001705751},{\"originRange\":{\"start\":{\"line\":20,\"character\":0},\"end\":{\"line\":20,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":20,\"character\":0},\"end\":{\"line\":20,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"\",\"originAcceptText\":\"\",\"originTextLength\":0,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1769003583270}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/lib/integration/ui-business-integration.ts": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":474,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":474,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"/**\\\\n * @file UI层与业务逻辑层无缝对接方案\\\\n * @description 实现UI组件与后端服务的深度集成架构\\\\n * @module integration\\\\n * @author YYC³\\\\n * @version 1.0.0\\\\n * @created 2026-01-21\\\\n */\\\\n\\\\nimport { useState, useEffect, useCallback, useRef } from \\\\'react\\\\';\\\\n\\\\n/**\\\\n * API响应接口\\\\n */\\\\nexport interface ApiResponse<T = any> {\\\\n  success: boolean;\\\\n  data?: T;\\\\n  error?: {\\\\n    code: string;\\\\n    message: string;\\\\n    details?: any;\\\\n  };\\\\n  meta?: {\\\\n    total?: number;\\\\n    page?: number;\\\\n    pageSize?: number;\\\\n  };\\\\n}\\\\n\\\\n/**\\\\n * 请求配置接口\\\\n */\\\\nexport interface RequestConfig {\\\\n  method?: \\\\'GET\\\\' | \\\\'POST\\\\' | \\\\'PUT\\\\' | \\\\'DELETE\\\\' | \\\\'PATCH\\\\';\\\\n  headers?: Record<string, string>;\\\\n  params?: Record<string, any>;\\\\n  body?: any;\\\\n  timeout?: number;\\\\n  retries?: number;\\\\n  cache?: {\\\\n    enabled: boolean;\\\\n    ttl: number;\\\\n  };\\\\n}\\\\n\\\\n/**\\\\n * API客户端类\\\\n */\\\\nexport class ApiClient {\\\\n  private baseUrl: string;\\\\n  private defaultHeaders: Record<string, string>;\\\\n  private token: string | null = null;\\\\n  private tenantId: string | null = null;\\\\n\\\\n  constructor(baseUrl: string) {\\\\n    this.baseUrl = baseUrl;\\\\n    this.defaultHeaders = {\\\\n      \\\\'Content-Type\\\\': \\\\'application/json\\\\',\\\\n      \\\\'Accept\\\\': \\\\'application/json\\\\',\\\\n    };\\\\n  }\\\\n\\\\n  setToken(token: string) {\\\\n    this.token = token;\\\\n  }\\\\n\\\\n  setTenantId(tenantId: string) {\\\\n    this.tenantId = tenantId;\\\\n  }\\\\n\\\\n  private async request<T>(\\\\n    endpoint: string,\\\\n    config: RequestConfig = {}\\\\n  ): Promise<ApiResponse<T>> {\\\\n    const {\\\\n      method = \\\\'GET\\\\',\\\\n      headers = {},\\\\n      params,\\\\n      body,\\\\n      timeout = 30000,\\\\n      retries = 3,\\\\n    } = config;\\\\n\\\\n    const url = new URL(`${this.baseUrl}${endpoint}`);\\\\n\\\\n    if (params) {\\\\n      Object.entries(params).forEach(([key, value]) => {\\\\n        url.searchParams.append(key, String(value));\\\\n      });\\\\n    }\\\\n\\\\n    const requestHeaders: Record<string, string> = {\\\\n      ...this.defaultHeaders,\\\\n      ...headers,\\\\n    };\\\\n\\\\n    if (this.token) {\\\\n      requestHeaders[\\\\'Authorization\\\\'] = `Bearer ${this.token}`;\\\\n    }\\\\n\\\\n    if (this.tenantId) {\\\\n      requestHeaders[\\\\'X-Tenant-ID\\\\'] = this.tenantId;\\\\n    }\\\\n\\\\n    const requestInit: RequestInit = {\\\\n      method,\\\\n      headers: requestHeaders,\\\\n    };\\\\n\\\\n    if (body && method !== \\\\'GET\\\\') {\\\\n      requestInit.body = JSON.stringify(body);\\\\n    }\\\\n\\\\n    let lastError: Error | null = null;\\\\n\\\\n    for (let attempt = 0; attempt < retries; attempt++) {\\\\n      try {\\\\n        const controller = new AbortController();\\\\n        const timeoutId = setTimeout(() => controller.abort(), timeout);\\\\n\\\\n        const response = await fetch(url.toString(), {\\\\n          ...requestInit,\\\\n          signal: controller.signal,\\\\n        });\\\\n\\\\n        clearTimeout(timeoutId);\\\\n\\\\n        const data = await response.json();\\\\n\\\\n        if (!response.ok) {\\\\n          throw new Error(data.error?.message || `HTTP ${response.status}`);\\\\n        }\\\\n\\\\n        return data;\\\\n      } catch (error) {\\\\n        lastError = error as Error;\\\\n        \\\\n        if (attempt < retries - 1) {\\\\n          await new Promise(resolve => setTimeout(resolve, 1000 * (attempt + 1)));\\\\n        }\\\\n      }\\\\n    }\\\\n\\\\n    return {\\\\n      success: false,\\\\n      error: {\\\\n        code: \\\\'REQUEST_FAILED\\\\',\\\\n        message: lastError?.message || \\\\'请求失败\\\\',\\\\n      },\\\\n    };\\\\n  }\\\\n\\\\n  async get<T>(endpoint: string, config?: RequestConfig): Promise<ApiResponse<T>> {\\\\n    return this.request<T>(endpoint, { ...config, method: \\\\'GET\\\\' });\\\\n  }\\\\n\\\\n  async post<T>(endpoint: string, body: any, config?: RequestConfig): Promise<ApiResponse<T>> {\\\\n    return this.request<T>(endpoint, { ...config, method: \\\\'POST\\\\', body });\\\\n  }\\\\n\\\\n  async put<T>(endpoint: string, body: any, config?: RequestConfig): Promise<ApiResponse<T>> {\\\\n    return this.request<T>(endpoint, { ...config, method: \\\\'PUT\\\\', body });\\\\n  }\\\\n\\\\n  async delete<T>(endpoint: string, config?: RequestConfig): Promise<ApiResponse<T>> {\\\\n    return this.request<T>(endpoint, { ...config, method: \\\\'DELETE\\\\' });\\\\n  }\\\\n\\\\n  async patch<T>(endpoint: string, body: any, config?: RequestConfig): Promise<ApiResponse<T>> {\\\\n    return this.request<T>(endpoint, { ...config, method: \\\\'PATCH\\\\', body });\\\\n  }\\\\n}\\\\n\\\\n/**\\\\n * 创建全局API客户端实例\\\\n */\\\\nexport const apiClient = new ApiClient(process.env.NEXT_PUBLIC_API_BASE_URL || \\\\'http://localhost:3000/api\\\\');\\\\n\\\\n/**\\\\n * React Hook - 使用API数据\\\\n */\\\\nexport function useApi<T = any>(\\\\n  endpoint: string,\\\\n  config?: RequestConfig,\\\\n  deps: any[] = []\\\\n) {\\\\n  const [data, setData] = useState<T | null>(null);\\\\n  const [loading, setLoading] = useState<boolean>(false);\\\\n  const [error, setError] = useState<Error | null>(null);\\\\n\\\\n  const fetchData = useCallback(async () => {\\\\n    setLoading(true);\\\\n    setError(null);\\\\n\\\\n    try {\\\\n      const response = await apiClient.get<T>(endpoint, config);\\\\n      \\\\n      if (response.success && response.data) {\\\\n        setData(response.data);\\\\n      } else {\\\\n        throw new Error(response.error?.message || \\\\'请求失败\\\\');\\\\n      }\\\\n    } catch (err) {\\\\n      setError(err as Error);\\\\n    } finally {\\\\n      setLoading(false);\\\\n    }\\\\n  }, [endpoint, config]);\\\\n\\\\n  useEffect(() => {\\\\n    fetchData();\\\\n  }, deps);\\\\n\\\\n  return { data, loading, error, refetch: fetchData };\\\\n}\\\\n\\\\n/**\\\\n * React Hook - 使用API操作（POST/PUT/DELETE）\\\\n */\\\\nexport function useApiMutation<T = any, P = any>(\\\\n  endpoint: string,\\\\n  method: \\\\'POST\\\\' | \\\\'PUT\\\\' | \\\\'DELETE\\\\' | \\\\'PATCH\\\\' = \\\\'POST\\\\'\\\\n) {\\\\n  const [loading, setLoading] = useState<boolean>(false);\\\\n  const [error, setError] = useState<Error | null>(null);\\\\n  const [data, setData] = useState<T | null>(null);\\\\n\\\\n  const mutate = useCallback(async (payload?: P): Promise<ApiResponse<T>> => {\\\\n    setLoading(true);\\\\n    setError(null);\\\\n\\\\n    try {\\\\n      let response: ApiResponse<T>;\\\\n\\\\n      switch (method) {\\\\n        case \\\\'POST\\\\':\\\\n          response = await apiClient.post<T>(endpoint, payload);\\\\n          break;\\\\n        case \\\\'PUT\\\\':\\\\n          response = await apiClient.put<T>(endpoint, payload);\\\\n          break;\\\\n        case \\\\'DELETE\\\\':\\\\n          response = await apiClient.delete<T>(endpoint);\\\\n          break;\\\\n        case \\\\'PATCH\\\\':\\\\n          response = await apiClient.patch<T>(endpoint, payload);\\\\n          break;\\\\n        default:\\\\n          throw new Error(`不支持的HTTP方法: ${method}`);\\\\n      }\\\\n\\\\n      if (response.success) {\\\\n        setData(response.data || null);\\\\n      } else {\\\\n        throw new Error(response.error?.message || \\\\'操作失败\\\\');\\\\n      }\\\\n\\\\n      return response;\\\\n    } catch (err) {\\\\n      setError(err as Error);\\\\n      return {\\\\n        success: false,\\\\n        error: {\\\\n          code: \\\\'MUTATION_FAILED\\\\',\\\\n          message: (err as Error).message,\\\\n        },\\\\n      };\\\\n    } finally {\\\\n      setLoading(false);\\\\n    }\\\\n  }, [endpoint, method]);\\\\n\\\\n  return { mutate, loading, error, data };\\\\n}\\\\n\\\\n/**\\\\n * React Hook - 使用分页数据\\\\n */\\\\nexport function usePaginatedApi<T = any>(\\\\n  endpoint: string,\\\\n  initialPage: number = 1,\\\\n  pageSize: number = 20\\\\n) {\\\\n  const [data, setData] = useState<T[]>([]);\\\\n  const [loading, setLoading] = useState<boolean>(false);\\\\n  const [error, setError] = useState<Error | null>(null);\\\\n  const [page, setPage] = useState<number>(initialPage);\\\\n  const [total, setTotal] = useState<number>(0);\\\\n  const [hasMore, setHasMore] = useState<boolean>(true);\\\\n\\\\n  const fetchPage = useCallback(async (pageNum: number) => {\\\\n    setLoading(true);\\\\n    setError(null);\\\\n\\\\n    try {\\\\n      const response = await apiClient.get<{ items: T[]; total: number }>(endpoint, {\\\\n        params: {\\\\n          page: pageNum,\\\\n          pageSize,\\\\n        },\\\\n      });\\\\n\\\\n      if (response.success && response.data) {\\\\n        setData(response.data.items);\\\\n        setTotal(response.data.total);\\\\n        setHasMore(pageNum * pageSize < response.data.total);\\\\n      } else {\\\\n        throw new Error(response.error?.message || \\\\'请求失败\\\\');\\\\n      }\\\\n    } catch (err) {\\\\n      setError(err as Error);\\\\n    } finally {\\\\n      setLoading(false);\\\\n    }\\\\n  }, [endpoint, pageSize]);\\\\n\\\\n  useEffect(() => {\\\\n    fetchPage(page);\\\\n  }, [page, fetchPage]);\\\\n\\\\n  const loadMore = useCallback(() => {\\\\n    if (!loading && hasMore) {\\\\n      setPage(prev => prev + 1);\\\\n    }\\\\n  }, [loading, hasMore]);\\\\n\\\\n  const refresh = useCallback(() => {\\\\n    setPage(1);\\\\n    fetchPage(1);\\\\n  }, [fetchPage]);\\\\n\\\\n  return {\\\\n    data,\\\\n    loading,\\\\n    error,\\\\n    page,\\\\n    total,\\\\n    hasMore,\\\\n    loadMore,\\\\n    refresh,\\\\n    setPage,\\\\n  };\\\\n}\\\\n\\\\n/**\\\\n * React Hook - 使用实时数据（WebSocket）\\\\n */\\\\nexport function useRealtimeData<T = any>(\\\\n  endpoint: string,\\\\n  initialData?: T\\\\n) {\\\\n  const [data, setData] = useState<T | null>(initialData || null);\\\\n  const [connected, setConnected] = useState<boolean>(false);\\\\n  const wsRef = useRef<WebSocket | null>(null);\\\\n\\\\n  useEffect(() => {\\\\n    const wsUrl = endpoint.replace(\\\\'http\\\\', \\\\'ws\\\\');\\\\n    const ws = new WebSocket(wsUrl);\\\\n    wsRef.current = ws;\\\\n\\\\n    ws.onopen = () => {\\\\n      setConnected(true);\\\\n    };\\\\n\\\\n    ws.onmessage = (event) => {\\\\n      try {\\\\n        const message = JSON.parse(event.data);\\\\n        setData(message.data);\\\\n      } catch (error) {\\\\n        console.error(\\\\'解析WebSocket消息失败:\\\\', error);\\\\n      }\\\\n    };\\\\n\\\\n    ws.onerror = (error) => {\\\\n      console.error(\\\\'WebSocket错误:\\\\', error);\\\\n      setConnected(false);\\\\n    };\\\\n\\\\n    ws.onclose = () => {\\\\n      setConnected(false);\\\\n    };\\\\n\\\\n    return () => {\\\\n      ws.close();\\\\n    };\\\\n  }, [endpoint]);\\\\n\\\\n  return { data, connected };\\\\n}\\\\n\\\\n/**\\\\n * React Hook - 使用乐观更新\\\\n */\\\\nexport function useOptimisticUpdate<T = any>(\\\\n  initialData: T,\\\\n  updateFn: (data: T) => Promise<ApiResponse<T>>\\\\n) {\\\\n  const [data, setData] = useState<T>(initialData);\\\\n  const [optimisticData, setOptimisticData] = useState<T | null>(null);\\\\n  const [loading, setLoading] = useState<boolean>(false);\\\\n  const [error, setError] = useState<Error | null>(null);\\\\n\\\\n  const update = useCallback(async (newData: Partial<T>) => {\\\\n    const optimisticValue = { ...data, ...newData };\\\\n    setOptimisticData(optimisticValue);\\\\n    setLoading(true);\\\\n    setError(null);\\\\n\\\\n    try {\\\\n      const response = await updateFn(optimisticValue);\\\\n\\\\n      if (response.success && response.data) {\\\\n        setData(response.data);\\\\n      } else {\\\\n        throw new Error(response.error?.message || \\\\'更新失败\\\\');\\\\n      }\\\\n    } catch (err) {\\\\n      setError(err as Error);\\\\n      setOptimisticData(null);\\\\n    } finally {\\\\n      setLoading(false);\\\\n    }\\\\n  }, [data, updateFn]);\\\\n\\\\n  return {\\\\n    data: optimisticData || data,\\\\n    loading,\\\\n    error,\\\\n    update,\\\\n  };\\\\n}\\\\n\\\\n/**\\\\n * 业务服务层 - 订单服务\\\\n */\\\\nexport class OrderService {\\\\n  private apiClient: ApiClient;\\\\n\\\\n  constructor(apiClient: ApiClient) {\\\\n    this.apiClient = apiClient;\\\\n  }\\\\n\\\\n  async getOrders(params?: {\\\\n    page?: number;\\\\n    pageSize?: number;\\\\n    status?: string;\\\\n    startDate?: string;\\\\n    endDate?: string;\\\\n  }) {\\\\n    return this.apiClient.get(\\\\'/orders\\\\', { params });\\\\n  }\\\\n\\\\n  async getOrderById(orderId: string) {\\\\n    return this.apiClient.get(`/orders/${orderId}`);\\\\n  }\\\\n\\\\n  async createOrder(orderData: any) {\\\\n    return this.apiClient.post(\\\\'/orders\\\\', orderData);\\\\n  }\\\\n\\\\n  async updateOrder(orderId: string, orderData: any) {\\\\n    return this.apiClient.put(`/orders/${orderId}`, orderData);\\\\n  }\\\\n\\\\n  async cancelOrder(orderId: string, reason: string) {\\\\n    return this.apiClient.patch(`/orders/${orderId}/cancel`, { reason });\\\\n  }\\\\n\\\\n  async getOrderStats(params?: {\\\\n    startDate?: string;\\\\n    endDate?: string;\\\\n  }) {\\\\n    return this.apiClient.get(\\\\'/orders/stats\\\\', { params });\\\\n  }\\\\n}\\\\n\\\\n/**\\\\n * 业务服务层 - 菜单服务\\\\n */\\\\nexport class MenuService {\\\\n  private apiClient: ApiClient;\\\\n\\\\n  constructor(apiClient: ApiClient) {\\\\n    this.apiClient = apiClient;\\\\n  }\\\\n\\\\n  async getMenus(params?: {\\\\n    page?: number;\\\\n    pageSize?: number;\\\\n    category?: string;\\\\n  }) {\\\\n    return this.apiClient.get(\\\\'/menus\\\\', { params });\\\\n  }\\\\n\\\\n  async getMenuById(menuId: string) {\\\\n    return this.apiClient.get(`/menus/${menuId}`);\\\\n  }\\\\n\\\\n  async createMenu(menuData: any) {\\\\n    return this.apiClient.post(\\\\'/menus\\\\', menuData);\\\\n  }\\\\n\\\\n  async updateMenu(menuId: string, menuData: any) {\\\\n    return this.apiClient.put(`/menus/${menuId}`, menuData);\\\\n  }\\\\n\\\\n  async deleteMenu(menuId: string) {\\\\n    return this.apiClient.delete(`/menus/${menuId}`);\\\\n  }\\\\n}\\\\n\\\\n/**\\\\n * 业务服务层 - 用户服务\\\\n */\\\\nexport class UserService {\\\\n  private apiClient: ApiClient;\\\\n\\\\n  constructor(apiClient: ApiClient) {\\\\n    this.apiClient = apiClient;\\\\n  }\\\\n\\\\n  async login(credentials: { email: string; password: string }) {\\\\n    return this.apiClient.post(\\\\'/auth/login\\\\', credentials);\\\\n  }\\\\n\\\\n  async logout() {\\\\n    return this.apiClient.post(\\\\'/auth/logout\\\\', {});\\\\n  }\\\\n\\\\n  async getCurrentUser() {\\\\n    return this.apiClient.get(\\\\'/users/me\\\\');\\\\n  }\\\\n\\\\n  async updateProfile(profileData: any) {\\\\n    return this.apiClient.put(\\\\'/users/me\\\\', profileData);\\\\n  }\\\\n}\\\\n\\\\n/**\\\\n * 创建业务服务实例\\\\n */\\\\nexport const orderService = new OrderService(apiClient);\\\\nexport const menuService = new MenuService(apiClient);\\\\nexport const userService = new UserService(apiClient);\\\\n\\\\n/**\\\\n * 导出所有API和服务\\\\n */\\\\nexport default {\\\\n  apiClient,\\\\n  useApi,\\\\n  useApiMutation,\\\\n  usePaginatedApi,\\\\n  useRealtimeData,\\\\n  useOptimisticUpdate,\\\\n  orderService,\\\\n  menuService,\\\\n  userService,\\\\n};\\\\n\",\"originAcceptText\":\"/**\\n * @file UI层与业务逻辑层无缝对接方案\\n * @description 实现UI组件与后端服务的深度集成架构\\n * @module integration\\n * @author YYC³\\n * @version 1.0.0\\n * @created 2026-01-21\\n */\\n\\nimport { useState, useEffect, useCallback, useRef } from 'react';\\n\\n/**\\n * API响应接口\\n */\\nexport interface ApiResponse<T = any> {\\n  success: boolean;\\n  data?: T;\\n  error?: {\\n    code: string;\\n    message: string;\\n    details?: any;\\n  };\\n  meta?: {\\n    total?: number;\\n    page?: number;\\n    pageSize?: number;\\n  };\\n}\\n\\n/**\\n * 请求配置接口\\n */\\nexport interface RequestConfig {\\n  method?: 'GET' | 'POST' | 'PUT' | 'DELETE' | 'PATCH';\\n  headers?: Record<string, string>;\\n  params?: Record<string, any>;\\n  body?: any;\\n  timeout?: number;\\n  retries?: number;\\n  cache?: {\\n    enabled: boolean;\\n    ttl: number;\\n  };\\n}\\n\\n/**\\n * API客户端类\\n */\\nexport class ApiClient {\\n  private baseUrl: string;\\n  private defaultHeaders: Record<string, string>;\\n  private token: string | null = null;\\n  private tenantId: string | null = null;\\n\\n  constructor(baseUrl: string) {\\n    this.baseUrl = baseUrl;\\n    this.defaultHeaders = {\\n      'Content-Type': 'application/json',\\n      'Accept': 'application/json',\\n    };\\n  }\\n\\n  setToken(token: string) {\\n    this.token = token;\\n  }\\n\\n  setTenantId(tenantId: string) {\\n    this.tenantId = tenantId;\\n  }\\n\\n  private async request<T>(\\n    endpoint: string,\\n    config: RequestConfig = {}\\n  ): Promise<ApiResponse<T>> {\\n    const {\\n      method = 'GET',\\n      headers = {},\\n      params,\\n      body,\\n      timeout = 30000,\\n      retries = 3,\\n    } = config;\\n\\n    const url = new URL(`${this.baseUrl}${endpoint}`);\\n\\n    if (params) {\\n      Object.entries(params).forEach(([key, value]) => {\\n        url.searchParams.append(key, String(value));\\n      });\\n    }\\n\\n    const requestHeaders: Record<string, string> = {\\n      ...this.defaultHeaders,\\n      ...headers,\\n    };\\n\\n    if (this.token) {\\n      requestHeaders['Authorization'] = `Bearer ${this.token}`;\\n    }\\n\\n    if (this.tenantId) {\\n      requestHeaders['X-Tenant-ID'] = this.tenantId;\\n    }\\n\\n    const requestInit: RequestInit = {\\n      method,\\n      headers: requestHeaders,\\n    };\\n\\n    if (body && method !== 'GET') {\\n      requestInit.body = JSON.stringify(body);\\n    }\\n\\n    let lastError: Error | null = null;\\n\\n    for (let attempt = 0; attempt < retries; attempt++) {\\n      try {\\n        const controller = new AbortController();\\n        const timeoutId = setTimeout(() => controller.abort(), timeout);\\n\\n        const response = await fetch(url.toString(), {\\n          ...requestInit,\\n          signal: controller.signal,\\n        });\\n\\n        clearTimeout(timeoutId);\\n\\n        const data = await response.json();\\n\\n        if (!response.ok) {\\n          throw new Error(data.error?.message || `HTTP ${response.status}`);\\n        }\\n\\n        return data;\\n      } catch (error) {\\n        lastError = error as Error;\\n        \\n        if (attempt < retries - 1) {\\n          await new Promise(resolve => setTimeout(resolve, 1000 * (attempt + 1)));\\n        }\\n      }\\n    }\\n\\n    return {\\n      success: false,\\n      error: {\\n        code: 'REQUEST_FAILED',\\n        message: lastError?.message || '请求失败',\\n      },\\n    };\\n  }\\n\\n  async get<T>(endpoint: string, config?: RequestConfig): Promise<ApiResponse<T>> {\\n    return this.request<T>(endpoint, { ...config, method: 'GET' });\\n  }\\n\\n  async post<T>(endpoint: string, body: any, config?: RequestConfig): Promise<ApiResponse<T>> {\\n    return this.request<T>(endpoint, { ...config, method: 'POST', body });\\n  }\\n\\n  async put<T>(endpoint: string, body: any, config?: RequestConfig): Promise<ApiResponse<T>> {\\n    return this.request<T>(endpoint, { ...config, method: 'PUT', body });\\n  }\\n\\n  async delete<T>(endpoint: string, config?: RequestConfig): Promise<ApiResponse<T>> {\\n    return this.request<T>(endpoint, { ...config, method: 'DELETE' });\\n  }\\n\\n  async patch<T>(endpoint: string, body: any, config?: RequestConfig): Promise<ApiResponse<T>> {\\n    return this.request<T>(endpoint, { ...config, method: 'PATCH', body });\\n  }\\n}\\n\\n/**\\n * 创建全局API客户端实例\\n */\\nexport const apiClient = new ApiClient(process.env.NEXT_PUBLIC_API_BASE_URL || 'http://localhost:3000/api');\\n\\n/**\\n * React Hook - 使用API数据\\n */\\nexport function useApi<T = any>(\\n  endpoint: string,\\n  config?: RequestConfig,\\n  deps: any[] = []\\n) {\\n  const [data, setData] = useState<T | null>(null);\\n  const [loading, setLoading] = useState<boolean>(false);\\n  const [error, setError] = useState<Error | null>(null);\\n\\n  const fetchData = useCallback(async () => {\\n    setLoading(true);\\n    setError(null);\\n\\n    try {\\n      const response = await apiClient.get<T>(endpoint, config);\\n      \\n      if (response.success && response.data) {\\n        setData(response.data);\\n      } else {\\n        throw new Error(response.error?.message || '请求失败');\\n      }\\n    } catch (err) {\\n      setError(err as Error);\\n    } finally {\\n      setLoading(false);\\n    }\\n  }, [endpoint, config]);\\n\\n  useEffect(() => {\\n    fetchData();\\n  }, deps);\\n\\n  return { data, loading, error, refetch: fetchData };\\n}\\n\\n/**\\n * React Hook - 使用API操作（POST/PUT/DELETE）\\n */\\nexport function useApiMutation<T = any, P = any>(\\n  endpoint: string,\\n  method: 'POST' | 'PUT' | 'DELETE' | 'PATCH' = 'POST'\\n) {\\n  const [loading, setLoading] = useState<boolean>(false);\\n  const [error, setError] = useState<Error | null>(null);\\n  const [data, setData] = useState<T | null>(null);\\n\\n  const mutate = useCallback(async (payload?: P): Promise<ApiResponse<T>> => {\\n    setLoading(true);\\n    setError(null);\\n\\n    try {\\n      let response: ApiResponse<T>;\\n\\n      switch (method) {\\n        case 'POST':\\n          response = await apiClient.post<T>(endpoint, payload);\\n          break;\\n        case 'PUT':\\n          response = await apiClient.put<T>(endpoint, payload);\\n          break;\\n        case 'DELETE':\\n          response = await apiClient.delete<T>(endpoint);\\n          break;\\n        case 'PATCH':\\n          response = await apiClient.patch<T>(endpoint, payload);\\n          break;\\n        default:\\n          throw new Error(`不支持的HTTP方法: ${method}`);\\n      }\\n\\n      if (response.success) {\\n        setData(response.data || null);\\n      } else {\\n        throw new Error(response.error?.message || '操作失败');\\n      }\\n\\n      return response;\\n    } catch (err) {\\n      setError(err as Error);\\n      return {\\n        success: false,\\n        error: {\\n          code: 'MUTATION_FAILED',\\n          message: (err as Error).message,\\n        },\\n      };\\n    } finally {\\n      setLoading(false);\\n    }\\n  }, [endpoint, method]);\\n\\n  return { mutate, loading, error, data };\\n}\\n\\n/**\\n * React Hook - 使用分页数据\\n */\\nexport function usePaginatedApi<T = any>(\\n  endpoint: string,\\n  initialPage: number = 1,\\n  pageSize: number = 20\\n) {\\n  const [data, setData] = useState<T[]>([]);\\n  const [loading, setLoading] = useState<boolean>(false);\\n  const [error, setError] = useState<Error | null>(null);\\n  const [page, setPage] = useState<number>(initialPage);\\n  const [total, setTotal] = useState<number>(0);\\n  const [hasMore, setHasMore] = useState<boolean>(true);\\n\\n  const fetchPage = useCallback(async (pageNum: number) => {\\n    setLoading(true);\\n    setError(null);\\n\\n    try {\\n      const response = await apiClient.get<{ items: T[]; total: number }>(endpoint, {\\n        params: {\\n          page: pageNum,\\n          pageSize,\\n        },\\n      });\\n\\n      if (response.success && response.data) {\\n        setData(response.data.items);\\n        setTotal(response.data.total);\\n        setHasMore(pageNum * pageSize < response.data.total);\\n      } else {\\n        throw new Error(response.error?.message || '请求失败');\\n      }\\n    } catch (err) {\\n      setError(err as Error);\\n    } finally {\\n      setLoading(false);\\n    }\\n  }, [endpoint, pageSize]);\\n\\n  useEffect(() => {\\n    fetchPage(page);\\n  }, [page, fetchPage]);\\n\\n  const loadMore = useCallback(() => {\\n    if (!loading && hasMore) {\\n      setPage(prev => prev + 1);\\n    }\\n  }, [loading, hasMore]);\\n\\n  const refresh = useCallback(() => {\\n    setPage(1);\\n    fetchPage(1);\\n  }, [fetchPage]);\\n\\n  return {\\n    data,\\n    loading,\\n    error,\\n    page,\\n    total,\\n    hasMore,\\n    loadMore,\\n    refresh,\\n    setPage,\\n  };\\n}\\n\\n/**\\n * React Hook - 使用实时数据（WebSocket）\\n */\\nexport function useRealtimeData<T = any>(\\n  endpoint: string,\\n  initialData?: T\\n) {\\n  const [data, setData] = useState<T | null>(initialData || null);\\n  const [connected, setConnected] = useState<boolean>(false);\\n  const wsRef = useRef<WebSocket | null>(null);\\n\\n  useEffect(() => {\\n    const wsUrl = endpoint.replace('http', 'ws');\\n    const ws = new WebSocket(wsUrl);\\n    wsRef.current = ws;\\n\\n    ws.onopen = () => {\\n      setConnected(true);\\n    };\\n\\n    ws.onmessage = (event) => {\\n      try {\\n        const message = JSON.parse(event.data);\\n        setData(message.data);\\n      } catch (error) {\\n        console.error('解析WebSocket消息失败:', error);\\n      }\\n    };\\n\\n    ws.onerror = (error) => {\\n      console.error('WebSocket错误:', error);\\n      setConnected(false);\\n    };\\n\\n    ws.onclose = () => {\\n      setConnected(false);\\n    };\\n\\n    return () => {\\n      ws.close();\\n    };\\n  }, [endpoint]);\\n\\n  return { data, connected };\\n}\\n\\n/**\\n * React Hook - 使用乐观更新\\n */\\nexport function useOptimisticUpdate<T = any>(\\n  initialData: T,\\n  updateFn: (data: T) => Promise<ApiResponse<T>>\\n) {\\n  const [data, setData] = useState<T>(initialData);\\n  const [optimisticData, setOptimisticData] = useState<T | null>(null);\\n  const [loading, setLoading] = useState<boolean>(false);\\n  const [error, setError] = useState<Error | null>(null);\\n\\n  const update = useCallback(async (newData: Partial<T>) => {\\n    const optimisticValue = { ...data, ...newData };\\n    setOptimisticData(optimisticValue);\\n    setLoading(true);\\n    setError(null);\\n\\n    try {\\n      const response = await updateFn(optimisticValue);\\n\\n      if (response.success && response.data) {\\n        setData(response.data);\\n      } else {\\n        throw new Error(response.error?.message || '更新失败');\\n      }\\n    } catch (err) {\\n      setError(err as Error);\\n      setOptimisticData(null);\\n    } finally {\\n      setLoading(false);\\n    }\\n  }, [data, updateFn]);\\n\\n  return {\\n    data: optimisticData || data,\\n    loading,\\n    error,\\n    update,\\n  };\\n}\\n\\n/**\\n * 业务服务层 - 订单服务\\n */\\nexport class OrderService {\\n  private apiClient: ApiClient;\\n\\n  constructor(apiClient: ApiClient) {\\n    this.apiClient = apiClient;\\n  }\\n\\n  async getOrders(params?: {\\n    page?: number;\\n    pageSize?: number;\\n    status?: string;\\n    startDate?: string;\\n    endDate?: string;\\n  }) {\\n    return this.apiClient.get('/orders', { params });\\n  }\\n\\n  async getOrderById(orderId: string) {\\n    return this.apiClient.get(`/orders/${orderId}`);\\n  }\\n\\n  async createOrder(orderData: any) {\\n    return this.apiClient.post('/orders', orderData);\\n  }\\n\\n  async updateOrder(orderId: string, orderData: any) {\\n    return this.apiClient.put(`/orders/${orderId}`, orderData);\\n  }\\n\\n  async cancelOrder(orderId: string, reason: string) {\\n    return this.apiClient.patch(`/orders/${orderId}/cancel`, { reason });\\n  }\\n\\n  async getOrderStats(params?: {\\n    startDate?: string;\\n    endDate?: string;\\n  }) {\\n    return this.apiClient.get('/orders/stats', { params });\\n  }\\n}\\n\\n/**\\n * 业务服务层 - 菜单服务\\n */\\nexport class MenuService {\\n  private apiClient: ApiClient;\\n\\n  constructor(apiClient: ApiClient) {\\n    this.apiClient = apiClient;\\n  }\\n\\n  async getMenus(params?: {\\n    page?: number;\\n    pageSize?: number;\\n    category?: string;\\n  }) {\\n    return this.apiClient.get('/menus', { params });\\n  }\\n\\n  async getMenuById(menuId: string) {\\n    return this.apiClient.get(`/menus/${menuId}`);\\n  }\\n\\n  async createMenu(menuData: any) {\\n    return this.apiClient.post('/menus', menuData);\\n  }\\n\\n  async updateMenu(menuId: string, menuData: any) {\\n    return this.apiClient.put(`/menus/${menuId}`, menuData);\\n  }\\n\\n  async deleteMenu(menuId: string) {\\n    return this.apiClient.delete(`/menus/${menuId}`);\\n  }\\n}\\n\\n/**\\n * 业务服务层 - 用户服务\\n */\\nexport class UserService {\\n  private apiClient: ApiClient;\\n\\n  constructor(apiClient: ApiClient) {\\n    this.apiClient = apiClient;\\n  }\\n\\n  async login(credentials: { email: string; password: string }) {\\n    return this.apiClient.post('/auth/login', credentials);\\n  }\\n\\n  async logout() {\\n    return this.apiClient.post('/auth/logout', {});\\n  }\\n\\n  async getCurrentUser() {\\n    return this.apiClient.get('/users/me');\\n  }\\n\\n  async updateProfile(profileData: any) {\\n    return this.apiClient.put('/users/me', profileData);\\n  }\\n}\\n\\n/**\\n * 创建业务服务实例\\n */\\nexport const orderService = new OrderService(apiClient);\\nexport const menuService = new MenuService(apiClient);\\nexport const userService = new UserService(apiClient);\\n\\n/**\\n * 导出所有API和服务\\n */\\nexport default {\\n  apiClient,\\n  useApi,\\n  useApiMutation,\\n  usePaginatedApi,\\n  useRealtimeData,\\n  useOptimisticUpdate,\\n  orderService,\\n  menuService,\\n  userService,\\n};\\n\",\"originTextLength\":12725,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768982646534}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/lib/integration/data-layer-integration.ts": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":639,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":639,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"/**\\\\n * @file 数据层与UI层集成架构\\\\n * @description 实现数据缓存、状态管理、实时同步的完整数据层架构\\\\n * @module integration\\\\n * @author YYC³\\\\n * @version 1.0.0\\\\n * @created 2026-01-21\\\\n */\\\\n\\\\nimport { create } from \\\\'zustand\\\\';\\\\nimport { persist, createJSONStorage } from \\\\'zustand/middleware\\\\';\\\\nimport { immer } from \\\\'zustand/middleware/immer\\\\';\\\\n\\\\n/**\\\\n * 数据缓存策略\\\\n */\\\\nexport enum CacheStrategy {\\\\n  NONE = \\\\'none\\\\',\\\\n  MEMORY = \\\\'memory\\\\',\\\\n  LOCAL_STORAGE = \\\\'local_storage\\\\',\\\\n  INDEXED_DB = \\\\'indexed_db\\\\',\\\\n  SESSION_STORAGE = \\\\'session_storage\\\\',\\\\n}\\\\n\\\\n/**\\\\n * 数据同步状态\\\\n */\\\\nexport enum SyncStatus {\\\\n  IDLE = \\\\'idle\\\\',\\\\n  SYNCING = \\\\'syncing\\\\',\\\\n  SUCCESS = \\\\'success\\\\',\\\\n  ERROR = \\\\'error\\\\',\\\\n  CONFLICT = \\\\'conflict\\\\',\\\\n}\\\\n\\\\n/**\\\\n * 缓存配置接口\\\\n */\\\\nexport interface CacheConfig<T> {\\\\n  key: string;\\\\n  strategy: CacheStrategy;\\\\n  ttl?: number;\\\\n  version?: string;\\\\n  onExpire?: () => void;\\\\n}\\\\n\\\\n/**\\\\n * 数据同步配置接口\\\\n */\\\\nexport interface SyncConfig {\\\\n  endpoint: string;\\\\n  interval?: number;\\\\n  autoSync?: boolean;\\\\n  conflictResolution?: \\\\'client\\\\' | \\\\'server\\\\' | \\\\'merge\\\\';\\\\n}\\\\n\\\\n/**\\\\n * 缓存项接口\\\\n */\\\\nexport interface CacheItem<T> {\\\\n  data: T;\\\\n  timestamp: number;\\\\n  ttl: number;\\\\n  version: string;\\\\n}\\\\n\\\\n/**\\\\n * 内存缓存管理器\\\\n */\\\\nclass MemoryCache {\\\\n  private cache: Map<string, CacheItem<any>> = new Map();\\\\n\\\\n  set<T>(key: string, data: T, ttl: number = 3600000, version: string = \\\\'1.0\\\\'): void {\\\\n    this.cache.set(key, {\\\\n      data,\\\\n      timestamp: Date.now(),\\\\n      ttl,\\\\n      version,\\\\n    });\\\\n  }\\\\n\\\\n  get<T>(key: string): T | null {\\\\n    const item = this.cache.get(key);\\\\n    \\\\n    if (!item) {\\\\n      return null;\\\\n    }\\\\n\\\\n    if (Date.now() - item.timestamp > item.ttl) {\\\\n      this.cache.delete(key);\\\\n      return null;\\\\n    }\\\\n\\\\n    return item.data as T;\\\\n  }\\\\n\\\\n  has(key: string): boolean {\\\\n    const item = this.cache.get(key);\\\\n    \\\\n    if (!item) {\\\\n      return false;\\\\n    }\\\\n\\\\n    if (Date.now() - item.timestamp > item.ttl) {\\\\n      this.cache.delete(key);\\\\n      return false;\\\\n    }\\\\n\\\\n    return true;\\\\n  }\\\\n\\\\n  delete(key: string): void {\\\\n    this.cache.delete(key);\\\\n  }\\\\n\\\\n  clear(): void {\\\\n    this.cache.clear();\\\\n  }\\\\n\\\\n  size(): number {\\\\n    return this.cache.size;\\\\n  }\\\\n}\\\\n\\\\n/**\\\\n * IndexedDB缓存管理器\\\\n */\\\\nclass IndexedDBCache {\\\\n  private dbName: string = \\\\'YYC3Cache\\\\';\\\\n  private storeName: string = \\\\'cache\\\\';\\\\n  private db: IDBDatabase | null = null;\\\\n\\\\n  async init(): Promise<void> {\\\\n    return new Promise((resolve, reject) => {\\\\n      const request = indexedDB.open(this.dbName, 1);\\\\n\\\\n      request.onerror = () => reject(request.error);\\\\n      request.onsuccess = () => {\\\\n        this.db = request.result;\\\\n        resolve();\\\\n      };\\\\n\\\\n      request.onupgradeneeded = (event) => {\\\\n        const db = (event.target as IDBOpenDBRequest).result;\\\\n        \\\\n        if (!db.objectStoreNames.contains(this.storeName)) {\\\\n          const store = db.createObjectStore(this.storeName, { keyPath: \\\\'key\\\\' });\\\\n          store.createIndex(\\\\'timestamp\\\\', \\\\'timestamp\\\\', { unique: false });\\\\n        }\\\\n      };\\\\n    });\\\\n  }\\\\n\\\\n  async set<T>(key: string, data: T, ttl: number = 3600000, version: string = \\\\'1.0\\\\'): Promise<void> {\\\\n    if (!this.db) {\\\\n      await this.init();\\\\n    }\\\\n\\\\n    return new Promise((resolve, reject) => {\\\\n      const transaction = this.db!.transaction([this.storeName], \\\\'readwrite\\\\');\\\\n      const store = transaction.objectStore(this.storeName);\\\\n\\\\n      const item: CacheItem<T> = {\\\\n        data,\\\\n        timestamp: Date.now(),\\\\n        ttl,\\\\n        version,\\\\n      };\\\\n\\\\n      const request = store.put({ key, ...item });\\\\n\\\\n      request.onsuccess = () => resolve();\\\\n      request.onerror = () => reject(request.error);\\\\n    });\\\\n  }\\\\n\\\\n  async get<T>(key: string): Promise<T | null> {\\\\n    if (!this.db) {\\\\n      await this.init();\\\\n    }\\\\n\\\\n    return new Promise((resolve, reject) => {\\\\n      const transaction = this.db!.transaction([this.storeName], \\\\'readonly\\\\');\\\\n      const store = transaction.objectStore(this.storeName);\\\\n      const request = store.get(key);\\\\n\\\\n      request.onsuccess = () => {\\\\n        const result = request.result;\\\\n\\\\n        if (!result) {\\\\n          resolve(null);\\\\n          return;\\\\n        }\\\\n\\\\n        if (Date.now() - result.timestamp > result.ttl) {\\\\n          this.delete(key);\\\\n          resolve(null);\\\\n          return;\\\\n        }\\\\n\\\\n        resolve(result.data as T);\\\\n      };\\\\n\\\\n      request.onerror = () => reject(request.error);\\\\n    });\\\\n  }\\\\n\\\\n  async has(key: string): Promise<boolean> {\\\\n    const data = await this.get(key);\\\\n    return data !== null;\\\\n  }\\\\n\\\\n  async delete(key: string): Promise<void> {\\\\n    if (!this.db) {\\\\n      await this.init();\\\\n    }\\\\n\\\\n    return new Promise((resolve, reject) => {\\\\n      const transaction = this.db!.transaction([this.storeName], \\\\'readwrite\\\\');\\\\n      const store = transaction.objectStore(this.storeName);\\\\n      const request = store.delete(key);\\\\n\\\\n      request.onsuccess = () => resolve();\\\\n      request.onerror = () => reject(request.error);\\\\n    });\\\\n  }\\\\n\\\\n  async clear(): Promise<void> {\\\\n    if (!this.db) {\\\\n      await this.init();\\\\n    }\\\\n\\\\n    return new Promise((resolve, reject) => {\\\\n      const transaction = this.db!.transaction([this.storeName], \\\\'readwrite\\\\');\\\\n      const store = transaction.objectStore(this.storeName);\\\\n      const request = store.clear();\\\\n\\\\n      request.onsuccess = () => resolve();\\\\n      request.onerror = () => reject(request.error);\\\\n    });\\\\n  }\\\\n\\\\n  async size(): Promise<number> {\\\\n    if (!this.db) {\\\\n      await this.init();\\\\n    }\\\\n\\\\n    return new Promise((resolve, reject) => {\\\\n      const transaction = this.db!.transaction([this.storeName], \\\\'readonly\\\\');\\\\n      const store = transaction.objectStore(this.storeName);\\\\n      const request = store.count();\\\\n\\\\n      request.onsuccess = () => resolve(request.result);\\\\n      request.onerror = () => reject(request.error);\\\\n    });\\\\n  }\\\\n}\\\\n\\\\n/**\\\\n * 统一缓存管理器\\\\n */\\\\nexport class CacheManager {\\\\n  private memoryCache: MemoryCache;\\\\n  private indexedDBCache: IndexedDBCache;\\\\n\\\\n  constructor() {\\\\n    this.memoryCache = new MemoryCache();\\\\n    this.indexedDBCache = new IndexedDBCache();\\\\n  }\\\\n\\\\n  async set<T>(key: string, data: T, config: CacheConfig<T>): Promise<void> {\\\\n    const { strategy, ttl = 3600000, version = \\\\'1.0\\\\' } = config;\\\\n\\\\n    switch (strategy) {\\\\n      case CacheStrategy.MEMORY:\\\\n        this.memoryCache.set(key, data, ttl, version);\\\\n        break;\\\\n      case CacheStrategy.INDEXED_DB:\\\\n        await this.indexedDBCache.set(key, data, ttl, version);\\\\n        break;\\\\n      case CacheStrategy.LOCAL_STORAGE:\\\\n        const item: CacheItem<T> = {\\\\n          data,\\\\n          timestamp: Date.now(),\\\\n          ttl,\\\\n          version,\\\\n        };\\\\n        localStorage.setItem(key, JSON.stringify(item));\\\\n        break;\\\\n      case CacheStrategy.SESSION_STORAGE:\\\\n        const sessionItem: CacheItem<T> = {\\\\n          data,\\\\n          timestamp: Date.now(),\\\\n          ttl,\\\\n          version,\\\\n        };\\\\n        sessionStorage.setItem(key, JSON.stringify(sessionItem));\\\\n        break;\\\\n      case CacheStrategy.NONE:\\\\n        break;\\\\n    }\\\\n  }\\\\n\\\\n  async get<T>(key: string, strategy: CacheStrategy): Promise<T | null> {\\\\n    switch (strategy) {\\\\n      case CacheStrategy.MEMORY:\\\\n        return this.memoryCache.get<T>(key);\\\\n      case CacheStrategy.INDEXED_DB:\\\\n        return await this.indexedDBCache.get<T>(key);\\\\n      case CacheStrategy.LOCAL_STORAGE:\\\\n        const item = localStorage.getItem(key);\\\\n        if (!item) return null;\\\\n\\\\n        try {\\\\n          const parsed: CacheItem<T> = JSON.parse(item);\\\\n          \\\\n          if (Date.now() - parsed.timestamp > parsed.ttl) {\\\\n            localStorage.removeItem(key);\\\\n            return null;\\\\n          }\\\\n\\\\n          return parsed.data;\\\\n        } catch {\\\\n          return null;\\\\n        }\\\\n      case CacheStrategy.SESSION_STORAGE:\\\\n        const sessionItem = sessionStorage.getItem(key);\\\\n        if (!sessionItem) return null;\\\\n\\\\n        try {\\\\n          const parsed: CacheItem<T> = JSON.parse(sessionItem);\\\\n          \\\\n          if (Date.now() - parsed.timestamp > parsed.ttl) {\\\\n            sessionStorage.removeItem(key);\\\\n            return null;\\\\n          }\\\\n\\\\n          return parsed.data;\\\\n        } catch {\\\\n          return null;\\\\n        }\\\\n      case CacheStrategy.NONE:\\\\n        return null;\\\\n    }\\\\n  }\\\\n\\\\n  async has(key: string, strategy: CacheStrategy): Promise<boolean> {\\\\n    const data = await this.get(key, strategy);\\\\n    return data !== null;\\\\n  }\\\\n\\\\n  async delete(key: string, strategy: CacheStrategy): Promise<void> {\\\\n    switch (strategy) {\\\\n      case CacheStrategy.MEMORY:\\\\n        this.memoryCache.delete(key);\\\\n        break;\\\\n      case CacheStrategy.INDEXED_DB:\\\\n        await this.indexedDBCache.delete(key);\\\\n        break;\\\\n      case CacheStrategy.LOCAL_STORAGE:\\\\n        localStorage.removeItem(key);\\\\n        break;\\\\n      case CacheStrategy.SESSION_STORAGE:\\\\n        sessionStorage.removeItem(key);\\\\n        break;\\\\n      case CacheStrategy.NONE:\\\\n        break;\\\\n    }\\\\n  }\\\\n\\\\n  async clear(strategy: CacheStrategy): Promise<void> {\\\\n    switch (strategy) {\\\\n      case CacheStrategy.MEMORY:\\\\n        this.memoryCache.clear();\\\\n        break;\\\\n      case CacheStrategy.INDEXED_DB:\\\\n        await this.indexedDBCache.clear();\\\\n        break;\\\\n      case CacheStrategy.LOCAL_STORAGE:\\\\n        localStorage.clear();\\\\n        break;\\\\n      case CacheStrategy.SESSION_STORAGE:\\\\n        sessionStorage.clear();\\\\n        break;\\\\n      case CacheStrategy.NONE:\\\\n        break;\\\\n    }\\\\n  }\\\\n}\\\\n\\\\n/**\\\\n * 创建全局缓存管理器实例\\\\n */\\\\nexport const cacheManager = new CacheManager();\\\\n\\\\n/**\\\\n * Zustand状态管理 - 应用状态\\\\n */\\\\ninterface AppState {\\\\n  user: {\\\\n    id: string | null;\\\\n    name: string | null;\\\\n    email: string | null;\\\\n    role: string | null;\\\\n  };\\\\n  tenant: {\\\\n    id: string | null;\\\\n    name: string | null;\\\\n    config: any;\\\\n  };\\\\n  theme: \\\\'light\\\\' | \\\\'dark\\\\' | \\\\'auto\\\\';\\\\n  language: \\\\'zh-CN\\\\' | \\\\'en-US\\\\';\\\\n  notifications: any[];\\\\n  setUser: (user: Partial<AppState[\\\\'user\\\\']>) => void;\\\\n  setTenant: (tenant: Partial<AppState[\\\\'tenant\\\\']>) => void;\\\\n  setTheme: (theme: AppState[\\\\'theme\\\\']) => void;\\\\n  setLanguage: (language: AppState[\\\\'language\\\\']) => void;\\\\n  addNotification: (notification: any) => void;\\\\n  removeNotification: (id: string) => void;\\\\n  clearNotifications: () => void;\\\\n}\\\\n\\\\nexport const useAppStore = create<AppState>()(\\\\n  persist(\\\\n    (set) => ({\\\\n      user: {\\\\n        id: null,\\\\n        name: null,\\\\n        email: null,\\\\n        role: null,\\\\n      },\\\\n      tenant: {\\\\n        id: null,\\\\n        name: null,\\\\n        config: {},\\\\n      },\\\\n      theme: \\\\'light\\\\',\\\\n      language: \\\\'zh-CN\\\\',\\\\n      notifications: [],\\\\n      setUser: (user) => set((state) => ({ user: { ...state.user, ...user } })),\\\\n      setTenant: (tenant) => set((state) => ({ tenant: { ...state.tenant, ...tenant } })),\\\\n      setTheme: (theme) => set({ theme }),\\\\n      setLanguage: (language) => set({ language }),\\\\n      addNotification: (notification) => set((state) => ({\\\\n        notifications: [...state.notifications, notification],\\\\n      })),\\\\n      removeNotification: (id) => set((state) => ({\\\\n        notifications: state.notifications.filter((n) => n.id !== id),\\\\n      })),\\\\n      clearNotifications: () => set({ notifications: [] }),\\\\n    }),\\\\n    {\\\\n      name: \\\\'yyc3-app-store\\\\',\\\\n      storage: createJSONStorage(() => localStorage),\\\\n    }\\\\n  )\\\\n);\\\\n\\\\n/**\\\\n * Zustand状态管理 - 订单状态\\\\n */\\\\ninterface OrderState {\\\\n  orders: any[];\\\\n  currentOrder: any | null;\\\\n  loading: boolean;\\\\n  error: Error | null;\\\\n  syncStatus: SyncStatus;\\\\n  setOrders: (orders: any[]) => void;\\\\n  setCurrentOrder: (order: any | null) => void;\\\\n  setLoading: (loading: boolean) => void;\\\\n  setError: (error: Error | null) => void;\\\\n  setSyncStatus: (status: SyncStatus) => void;\\\\n  addOrder: (order: any) => void;\\\\n  updateOrder: (orderId: string, updates: Partial<any>) => void;\\\\n  removeOrder: (orderId: string) => void;\\\\n}\\\\n\\\\nexport const useOrderStore = create<OrderState>()(\\\\n  immer((set) => ({\\\\n    orders: [],\\\\n    currentOrder: null,\\\\n    loading: false,\\\\n    error: null,\\\\n    syncStatus: SyncStatus.IDLE,\\\\n    setOrders: (orders) => set({ orders }),\\\\n    setCurrentOrder: (order) => set({ currentOrder: order }),\\\\n    setLoading: (loading) => set({ loading }),\\\\n    setError: (error) => set({ error }),\\\\n    setSyncStatus: (status) => set({ syncStatus: status }),\\\\n    addOrder: (order) => set((state) => {\\\\n      state.orders.push(order);\\\\n    }),\\\\n    updateOrder: (orderId, updates) => set((state) => {\\\\n      const index = state.orders.findIndex((o) => o.id === orderId);\\\\n      if (index !== -1) {\\\\n        Object.assign(state.orders[index], updates);\\\\n      }\\\\n    }),\\\\n    removeOrder: (orderId) => set((state) => {\\\\n      state.orders = state.orders.filter((o) => o.id !== orderId);\\\\n    }),\\\\n  }))\\\\n);\\\\n\\\\n/**\\\\n * Zustand状态管理 - 菜单状态\\\\n */\\\\ninterface MenuState {\\\\n  menus: any[];\\\\n  currentMenu: any | null;\\\\n  loading: boolean;\\\\n  error: Error | null;\\\\n  setMenus: (menus: any[]) => void;\\\\n  setCurrentMenu: (menu: any | null) => void;\\\\n  setLoading: (loading: boolean) => void;\\\\n  setError: (error: Error | null) => void;\\\\n  addMenu: (menu: any) => void;\\\\n  updateMenu: (menuId: string, updates: Partial<any>) => void;\\\\n  removeMenu: (menuId: string) => void;\\\\n}\\\\n\\\\nexport const useMenuStore = create<MenuState>()(\\\\n  immer((set) => ({\\\\n    menus: [],\\\\n    currentMenu: null,\\\\n    loading: false,\\\\n    error: null,\\\\n    setMenus: (menus) => set({ menus }),\\\\n    setCurrentMenu: (menu) => set({ currentMenu: menu }),\\\\n    setLoading: (loading) => set({ loading }),\\\\n    setError: (error) => set({ error }),\\\\n    addMenu: (menu) => set((state) => {\\\\n      state.menus.push(menu);\\\\n    }),\\\\n    updateMenu: (menuId, updates) => set((state) => {\\\\n      const index = state.menus.findIndex((m) => m.id === menuId);\\\\n      if (index !== -1) {\\\\n        Object.assign(state.menus[index], updates);\\\\n      }\\\\n    }),\\\\n    removeMenu: (menuId) => set((state) => {\\\\n      state.menus = state.menus.filter((m) => m.id !== menuId);\\\\n    }),\\\\n  }))\\\\n);\\\\n\\\\n/**\\\\n * 数据同步管理器\\\\n */\\\\nexport class DataSyncManager {\\\\n  private syncConfigs: Map<string, SyncConfig> = new Map();\\\\n  private syncIntervals: Map<string, NodeJS.Timeout> = new Map();\\\\n  private wsConnections: Map<string, WebSocket> = new Map();\\\\n\\\\n  register(key: string, config: SyncConfig): void {\\\\n    this.syncConfigs.set(key, config);\\\\n\\\\n    if (config.autoSync && config.interval) {\\\\n      this.startAutoSync(key);\\\\n    }\\\\n  }\\\\n\\\\n  unregister(key: string): void {\\\\n    this.syncConfigs.delete(key);\\\\n\\\\n    if (this.syncIntervals.has(key)) {\\\\n      clearInterval(this.syncIntervals.get(key)!);\\\\n      this.syncIntervals.delete(key);\\\\n    }\\\\n\\\\n    if (this.wsConnections.has(key)) {\\\\n      this.wsConnections.get(key)!.close();\\\\n      this.wsConnections.delete(key);\\\\n    }\\\\n  }\\\\n\\\\n  private startAutoSync(key: string): void {\\\\n    const config = this.syncConfigs.get(key);\\\\n    if (!config || !config.interval) return;\\\\n\\\\n    const interval = setInterval(() => {\\\\n      this.sync(key);\\\\n    }, config.interval);\\\\n\\\\n    this.syncIntervals.set(key, interval);\\\\n  }\\\\n\\\\n  async sync(key: string): Promise<void> {\\\\n    const config = this.syncConfigs.get(key);\\\\n    if (!config) return;\\\\n\\\\n    try {\\\\n      const response = await fetch(config.endpoint);\\\\n      const data = await response.json();\\\\n\\\\n      if (data.success) {\\\\n        useAppStore.setState({ notifications: data.data.notifications || [] });\\\\n      }\\\\n    } catch (error) {\\\\n      console.error(`同步失败 [${key}]:`, error);\\\\n    }\\\\n  }\\\\n\\\\n  connectWebSocket(key: string, wsUrl: string): WebSocket {\\\\n    if (this.wsConnections.has(key)) {\\\\n      return this.wsConnections.get(key)!;\\\\n    }\\\\n\\\\n    const ws = new WebSocket(wsUrl);\\\\n\\\\n    ws.onopen = () => {\\\\n      console.log(`WebSocket连接已建立 [${key}]`);\\\\n    };\\\\n\\\\n    ws.onmessage = (event) => {\\\\n      try {\\\\n        const message = JSON.parse(event.data);\\\\n        this.handleWebSocketMessage(key, message);\\\\n      } catch (error) {\\\\n        console.error(\\\\'解析WebSocket消息失败:\\\\', error);\\\\n      }\\\\n    };\\\\n\\\\n    ws.onerror = (error) => {\\\\n      console.error(`WebSocket错误 [${key}]:`, error);\\\\n    };\\\\n\\\\n    ws.onclose = () => {\\\\n      console.log(`WebSocket连接已关闭 [${key}]`);\\\\n      this.wsConnections.delete(key);\\\\n    };\\\\n\\\\n    this.wsConnections.set(key, ws);\\\\n    return ws;\\\\n  }\\\\n\\\\n  private handleWebSocketMessage(key: string, message: any): void {\\\\n    switch (message.type) {\\\\n      case \\\\'order_update\\\\':\\\\n        useOrderStore.getState().updateOrder(message.data.id, message.data);\\\\n        break;\\\\n      case \\\\'menu_update\\\\':\\\\n        useMenuStore.getState().updateMenu(message.data.id, message.data);\\\\n        break;\\\\n      case \\\\'notification\\\\':\\\\n        useAppStore.getState().addNotification(message.data);\\\\n        break;\\\\n      default:\\\\n        console.warn(`未知的消息类型: ${message.type}`);\\\\n    }\\\\n  }\\\\n}\\\\n\\\\n/**\\\\n * 创建全局数据同步管理器实例\\\\n */\\\\nexport const dataSyncManager = new DataSyncManager();\\\\n\\\\n/**\\\\n * React Hook - 使用缓存数据\\\\n */\\\\nexport function useCachedData<T = any>(\\\\n  key: string,\\\\n  fetcher: () => Promise<T>,\\\\n  config: CacheConfig<T>\\\\n) {\\\\n  const [data, setData] = useState<T | null>(null);\\\\n  const [loading, setLoading] = useState<boolean>(true);\\\\n  const [error, setError] = useState<Error | null>(null);\\\\n\\\\n  useEffect(() => {\\\\n    const fetchData = async () => {\\\\n      setLoading(true);\\\\n      setError(null);\\\\n\\\\n      try {\\\\n        const cachedData = await cacheManager.get<T>(key, config.strategy);\\\\n\\\\n        if (cachedData) {\\\\n          setData(cachedData);\\\\n          setLoading(false);\\\\n          return;\\\\n        }\\\\n\\\\n        const freshData = await fetcher();\\\\n        setData(freshData);\\\\n        await cacheManager.set(key, freshData, config);\\\\n      } catch (err) {\\\\n        setError(err as Error);\\\\n      } finally {\\\\n        setLoading(false);\\\\n      }\\\\n    };\\\\n\\\\n    fetchData();\\\\n  }, [key, fetcher, config]);\\\\n\\\\n  const refresh = useCallback(async () => {\\\\n    setLoading(true);\\\\n    setError(null);\\\\n\\\\n    try {\\\\n      const freshData = await fetcher();\\\\n      setData(freshData);\\\\n      await cacheManager.set(key, freshData, config);\\\\n    } catch (err) {\\\\n      setError(err as Error);\\\\n    } finally {\\\\n      setLoading(false);\\\\n    }\\\\n  }, [key, fetcher, config]);\\\\n\\\\n  const invalidate = useCallback(async () => {\\\\n    await cacheManager.delete(key, config.strategy);\\\\n    await refresh();\\\\n  }, [key, config.strategy, refresh]);\\\\n\\\\n  return { data, loading, error, refresh, invalidate };\\\\n}\\\\n\\\\n/**\\\\n * 导出所有数据层功能\\\\n */\\\\nexport default {\\\\n  cacheManager,\\\\n  dataSyncManager,\\\\n  useAppStore,\\\\n  useOrderStore,\\\\n  useMenuStore,\\\\n  useCachedData,\\\\n  CacheStrategy,\\\\n  SyncStatus,\\\\n};\\\\n\",\"originAcceptText\":\"/**\\n * @file 数据层与UI层集成架构\\n * @description 实现数据缓存、状态管理、实时同步的完整数据层架构\\n * @module integration\\n * @author YYC³\\n * @version 1.0.0\\n * @created 2026-01-21\\n */\\n\\nimport { create } from 'zustand';\\nimport { persist, createJSONStorage } from 'zustand/middleware';\\nimport { immer } from 'zustand/middleware/immer';\\n\\n/**\\n * 数据缓存策略\\n */\\nexport enum CacheStrategy {\\n  NONE = 'none',\\n  MEMORY = 'memory',\\n  LOCAL_STORAGE = 'local_storage',\\n  INDEXED_DB = 'indexed_db',\\n  SESSION_STORAGE = 'session_storage',\\n}\\n\\n/**\\n * 数据同步状态\\n */\\nexport enum SyncStatus {\\n  IDLE = 'idle',\\n  SYNCING = 'syncing',\\n  SUCCESS = 'success',\\n  ERROR = 'error',\\n  CONFLICT = 'conflict',\\n}\\n\\n/**\\n * 缓存配置接口\\n */\\nexport interface CacheConfig<T> {\\n  key: string;\\n  strategy: CacheStrategy;\\n  ttl?: number;\\n  version?: string;\\n  onExpire?: () => void;\\n}\\n\\n/**\\n * 数据同步配置接口\\n */\\nexport interface SyncConfig {\\n  endpoint: string;\\n  interval?: number;\\n  autoSync?: boolean;\\n  conflictResolution?: 'client' | 'server' | 'merge';\\n}\\n\\n/**\\n * 缓存项接口\\n */\\nexport interface CacheItem<T> {\\n  data: T;\\n  timestamp: number;\\n  ttl: number;\\n  version: string;\\n}\\n\\n/**\\n * 内存缓存管理器\\n */\\nclass MemoryCache {\\n  private cache: Map<string, CacheItem<any>> = new Map();\\n\\n  set<T>(key: string, data: T, ttl: number = 3600000, version: string = '1.0'): void {\\n    this.cache.set(key, {\\n      data,\\n      timestamp: Date.now(),\\n      ttl,\\n      version,\\n    });\\n  }\\n\\n  get<T>(key: string): T | null {\\n    const item = this.cache.get(key);\\n    \\n    if (!item) {\\n      return null;\\n    }\\n\\n    if (Date.now() - item.timestamp > item.ttl) {\\n      this.cache.delete(key);\\n      return null;\\n    }\\n\\n    return item.data as T;\\n  }\\n\\n  has(key: string): boolean {\\n    const item = this.cache.get(key);\\n    \\n    if (!item) {\\n      return false;\\n    }\\n\\n    if (Date.now() - item.timestamp > item.ttl) {\\n      this.cache.delete(key);\\n      return false;\\n    }\\n\\n    return true;\\n  }\\n\\n  delete(key: string): void {\\n    this.cache.delete(key);\\n  }\\n\\n  clear(): void {\\n    this.cache.clear();\\n  }\\n\\n  size(): number {\\n    return this.cache.size;\\n  }\\n}\\n\\n/**\\n * IndexedDB缓存管理器\\n */\\nclass IndexedDBCache {\\n  private dbName: string = 'YYC3Cache';\\n  private storeName: string = 'cache';\\n  private db: IDBDatabase | null = null;\\n\\n  async init(): Promise<void> {\\n    return new Promise((resolve, reject) => {\\n      const request = indexedDB.open(this.dbName, 1);\\n\\n      request.onerror = () => reject(request.error);\\n      request.onsuccess = () => {\\n        this.db = request.result;\\n        resolve();\\n      };\\n\\n      request.onupgradeneeded = (event) => {\\n        const db = (event.target as IDBOpenDBRequest).result;\\n        \\n        if (!db.objectStoreNames.contains(this.storeName)) {\\n          const store = db.createObjectStore(this.storeName, { keyPath: 'key' });\\n          store.createIndex('timestamp', 'timestamp', { unique: false });\\n        }\\n      };\\n    });\\n  }\\n\\n  async set<T>(key: string, data: T, ttl: number = 3600000, version: string = '1.0'): Promise<void> {\\n    if (!this.db) {\\n      await this.init();\\n    }\\n\\n    return new Promise((resolve, reject) => {\\n      const transaction = this.db!.transaction([this.storeName], 'readwrite');\\n      const store = transaction.objectStore(this.storeName);\\n\\n      const item: CacheItem<T> = {\\n        data,\\n        timestamp: Date.now(),\\n        ttl,\\n        version,\\n      };\\n\\n      const request = store.put({ key, ...item });\\n\\n      request.onsuccess = () => resolve();\\n      request.onerror = () => reject(request.error);\\n    });\\n  }\\n\\n  async get<T>(key: string): Promise<T | null> {\\n    if (!this.db) {\\n      await this.init();\\n    }\\n\\n    return new Promise((resolve, reject) => {\\n      const transaction = this.db!.transaction([this.storeName], 'readonly');\\n      const store = transaction.objectStore(this.storeName);\\n      const request = store.get(key);\\n\\n      request.onsuccess = () => {\\n        const result = request.result;\\n\\n        if (!result) {\\n          resolve(null);\\n          return;\\n        }\\n\\n        if (Date.now() - result.timestamp > result.ttl) {\\n          this.delete(key);\\n          resolve(null);\\n          return;\\n        }\\n\\n        resolve(result.data as T);\\n      };\\n\\n      request.onerror = () => reject(request.error);\\n    });\\n  }\\n\\n  async has(key: string): Promise<boolean> {\\n    const data = await this.get(key);\\n    return data !== null;\\n  }\\n\\n  async delete(key: string): Promise<void> {\\n    if (!this.db) {\\n      await this.init();\\n    }\\n\\n    return new Promise((resolve, reject) => {\\n      const transaction = this.db!.transaction([this.storeName], 'readwrite');\\n      const store = transaction.objectStore(this.storeName);\\n      const request = store.delete(key);\\n\\n      request.onsuccess = () => resolve();\\n      request.onerror = () => reject(request.error);\\n    });\\n  }\\n\\n  async clear(): Promise<void> {\\n    if (!this.db) {\\n      await this.init();\\n    }\\n\\n    return new Promise((resolve, reject) => {\\n      const transaction = this.db!.transaction([this.storeName], 'readwrite');\\n      const store = transaction.objectStore(this.storeName);\\n      const request = store.clear();\\n\\n      request.onsuccess = () => resolve();\\n      request.onerror = () => reject(request.error);\\n    });\\n  }\\n\\n  async size(): Promise<number> {\\n    if (!this.db) {\\n      await this.init();\\n    }\\n\\n    return new Promise((resolve, reject) => {\\n      const transaction = this.db!.transaction([this.storeName], 'readonly');\\n      const store = transaction.objectStore(this.storeName);\\n      const request = store.count();\\n\\n      request.onsuccess = () => resolve(request.result);\\n      request.onerror = () => reject(request.error);\\n    });\\n  }\\n}\\n\\n/**\\n * 统一缓存管理器\\n */\\nexport class CacheManager {\\n  private memoryCache: MemoryCache;\\n  private indexedDBCache: IndexedDBCache;\\n\\n  constructor() {\\n    this.memoryCache = new MemoryCache();\\n    this.indexedDBCache = new IndexedDBCache();\\n  }\\n\\n  async set<T>(key: string, data: T, config: CacheConfig<T>): Promise<void> {\\n    const { strategy, ttl = 3600000, version = '1.0' } = config;\\n\\n    switch (strategy) {\\n      case CacheStrategy.MEMORY:\\n        this.memoryCache.set(key, data, ttl, version);\\n        break;\\n      case CacheStrategy.INDEXED_DB:\\n        await this.indexedDBCache.set(key, data, ttl, version);\\n        break;\\n      case CacheStrategy.LOCAL_STORAGE:\\n        const item: CacheItem<T> = {\\n          data,\\n          timestamp: Date.now(),\\n          ttl,\\n          version,\\n        };\\n        localStorage.setItem(key, JSON.stringify(item));\\n        break;\\n      case CacheStrategy.SESSION_STORAGE:\\n        const sessionItem: CacheItem<T> = {\\n          data,\\n          timestamp: Date.now(),\\n          ttl,\\n          version,\\n        };\\n        sessionStorage.setItem(key, JSON.stringify(sessionItem));\\n        break;\\n      case CacheStrategy.NONE:\\n        break;\\n    }\\n  }\\n\\n  async get<T>(key: string, strategy: CacheStrategy): Promise<T | null> {\\n    switch (strategy) {\\n      case CacheStrategy.MEMORY:\\n        return this.memoryCache.get<T>(key);\\n      case CacheStrategy.INDEXED_DB:\\n        return await this.indexedDBCache.get<T>(key);\\n      case CacheStrategy.LOCAL_STORAGE:\\n        const item = localStorage.getItem(key);\\n        if (!item) return null;\\n\\n        try {\\n          const parsed: CacheItem<T> = JSON.parse(item);\\n          \\n          if (Date.now() - parsed.timestamp > parsed.ttl) {\\n            localStorage.removeItem(key);\\n            return null;\\n          }\\n\\n          return parsed.data;\\n        } catch {\\n          return null;\\n        }\\n      case CacheStrategy.SESSION_STORAGE:\\n        const sessionItem = sessionStorage.getItem(key);\\n        if (!sessionItem) return null;\\n\\n        try {\\n          const parsed: CacheItem<T> = JSON.parse(sessionItem);\\n          \\n          if (Date.now() - parsed.timestamp > parsed.ttl) {\\n            sessionStorage.removeItem(key);\\n            return null;\\n          }\\n\\n          return parsed.data;\\n        } catch {\\n          return null;\\n        }\\n      case CacheStrategy.NONE:\\n        return null;\\n    }\\n  }\\n\\n  async has(key: string, strategy: CacheStrategy): Promise<boolean> {\\n    const data = await this.get(key, strategy);\\n    return data !== null;\\n  }\\n\\n  async delete(key: string, strategy: CacheStrategy): Promise<void> {\\n    switch (strategy) {\\n      case CacheStrategy.MEMORY:\\n        this.memoryCache.delete(key);\\n        break;\\n      case CacheStrategy.INDEXED_DB:\\n        await this.indexedDBCache.delete(key);\\n        break;\\n      case CacheStrategy.LOCAL_STORAGE:\\n        localStorage.removeItem(key);\\n        break;\\n      case CacheStrategy.SESSION_STORAGE:\\n        sessionStorage.removeItem(key);\\n        break;\\n      case CacheStrategy.NONE:\\n        break;\\n    }\\n  }\\n\\n  async clear(strategy: CacheStrategy): Promise<void> {\\n    switch (strategy) {\\n      case CacheStrategy.MEMORY:\\n        this.memoryCache.clear();\\n        break;\\n      case CacheStrategy.INDEXED_DB:\\n        await this.indexedDBCache.clear();\\n        break;\\n      case CacheStrategy.LOCAL_STORAGE:\\n        localStorage.clear();\\n        break;\\n      case CacheStrategy.SESSION_STORAGE:\\n        sessionStorage.clear();\\n        break;\\n      case CacheStrategy.NONE:\\n        break;\\n    }\\n  }\\n}\\n\\n/**\\n * 创建全局缓存管理器实例\\n */\\nexport const cacheManager = new CacheManager();\\n\\n/**\\n * Zustand状态管理 - 应用状态\\n */\\ninterface AppState {\\n  user: {\\n    id: string | null;\\n    name: string | null;\\n    email: string | null;\\n    role: string | null;\\n  };\\n  tenant: {\\n    id: string | null;\\n    name: string | null;\\n    config: any;\\n  };\\n  theme: 'light' | 'dark' | 'auto';\\n  language: 'zh-CN' | 'en-US';\\n  notifications: any[];\\n  setUser: (user: Partial<AppState['user']>) => void;\\n  setTenant: (tenant: Partial<AppState['tenant']>) => void;\\n  setTheme: (theme: AppState['theme']) => void;\\n  setLanguage: (language: AppState['language']) => void;\\n  addNotification: (notification: any) => void;\\n  removeNotification: (id: string) => void;\\n  clearNotifications: () => void;\\n}\\n\\nexport const useAppStore = create<AppState>()(\\n  persist(\\n    (set) => ({\\n      user: {\\n        id: null,\\n        name: null,\\n        email: null,\\n        role: null,\\n      },\\n      tenant: {\\n        id: null,\\n        name: null,\\n        config: {},\\n      },\\n      theme: 'light',\\n      language: 'zh-CN',\\n      notifications: [],\\n      setUser: (user) => set((state) => ({ user: { ...state.user, ...user } })),\\n      setTenant: (tenant) => set((state) => ({ tenant: { ...state.tenant, ...tenant } })),\\n      setTheme: (theme) => set({ theme }),\\n      setLanguage: (language) => set({ language }),\\n      addNotification: (notification) => set((state) => ({\\n        notifications: [...state.notifications, notification],\\n      })),\\n      removeNotification: (id) => set((state) => ({\\n        notifications: state.notifications.filter((n) => n.id !== id),\\n      })),\\n      clearNotifications: () => set({ notifications: [] }),\\n    }),\\n    {\\n      name: 'yyc3-app-store',\\n      storage: createJSONStorage(() => localStorage),\\n    }\\n  )\\n);\\n\\n/**\\n * Zustand状态管理 - 订单状态\\n */\\ninterface OrderState {\\n  orders: any[];\\n  currentOrder: any | null;\\n  loading: boolean;\\n  error: Error | null;\\n  syncStatus: SyncStatus;\\n  setOrders: (orders: any[]) => void;\\n  setCurrentOrder: (order: any | null) => void;\\n  setLoading: (loading: boolean) => void;\\n  setError: (error: Error | null) => void;\\n  setSyncStatus: (status: SyncStatus) => void;\\n  addOrder: (order: any) => void;\\n  updateOrder: (orderId: string, updates: Partial<any>) => void;\\n  removeOrder: (orderId: string) => void;\\n}\\n\\nexport const useOrderStore = create<OrderState>()(\\n  immer((set) => ({\\n    orders: [],\\n    currentOrder: null,\\n    loading: false,\\n    error: null,\\n    syncStatus: SyncStatus.IDLE,\\n    setOrders: (orders) => set({ orders }),\\n    setCurrentOrder: (order) => set({ currentOrder: order }),\\n    setLoading: (loading) => set({ loading }),\\n    setError: (error) => set({ error }),\\n    setSyncStatus: (status) => set({ syncStatus: status }),\\n    addOrder: (order) => set((state) => {\\n      state.orders.push(order);\\n    }),\\n    updateOrder: (orderId, updates) => set((state) => {\\n      const index = state.orders.findIndex((o) => o.id === orderId);\\n      if (index !== -1) {\\n        Object.assign(state.orders[index], updates);\\n      }\\n    }),\\n    removeOrder: (orderId) => set((state) => {\\n      state.orders = state.orders.filter((o) => o.id !== orderId);\\n    }),\\n  }))\\n);\\n\\n/**\\n * Zustand状态管理 - 菜单状态\\n */\\ninterface MenuState {\\n  menus: any[];\\n  currentMenu: any | null;\\n  loading: boolean;\\n  error: Error | null;\\n  setMenus: (menus: any[]) => void;\\n  setCurrentMenu: (menu: any | null) => void;\\n  setLoading: (loading: boolean) => void;\\n  setError: (error: Error | null) => void;\\n  addMenu: (menu: any) => void;\\n  updateMenu: (menuId: string, updates: Partial<any>) => void;\\n  removeMenu: (menuId: string) => void;\\n}\\n\\nexport const useMenuStore = create<MenuState>()(\\n  immer((set) => ({\\n    menus: [],\\n    currentMenu: null,\\n    loading: false,\\n    error: null,\\n    setMenus: (menus) => set({ menus }),\\n    setCurrentMenu: (menu) => set({ currentMenu: menu }),\\n    setLoading: (loading) => set({ loading }),\\n    setError: (error) => set({ error }),\\n    addMenu: (menu) => set((state) => {\\n      state.menus.push(menu);\\n    }),\\n    updateMenu: (menuId, updates) => set((state) => {\\n      const index = state.menus.findIndex((m) => m.id === menuId);\\n      if (index !== -1) {\\n        Object.assign(state.menus[index], updates);\\n      }\\n    }),\\n    removeMenu: (menuId) => set((state) => {\\n      state.menus = state.menus.filter((m) => m.id !== menuId);\\n    }),\\n  }))\\n);\\n\\n/**\\n * 数据同步管理器\\n */\\nexport class DataSyncManager {\\n  private syncConfigs: Map<string, SyncConfig> = new Map();\\n  private syncIntervals: Map<string, NodeJS.Timeout> = new Map();\\n  private wsConnections: Map<string, WebSocket> = new Map();\\n\\n  register(key: string, config: SyncConfig): void {\\n    this.syncConfigs.set(key, config);\\n\\n    if (config.autoSync && config.interval) {\\n      this.startAutoSync(key);\\n    }\\n  }\\n\\n  unregister(key: string): void {\\n    this.syncConfigs.delete(key);\\n\\n    if (this.syncIntervals.has(key)) {\\n      clearInterval(this.syncIntervals.get(key)!);\\n      this.syncIntervals.delete(key);\\n    }\\n\\n    if (this.wsConnections.has(key)) {\\n      this.wsConnections.get(key)!.close();\\n      this.wsConnections.delete(key);\\n    }\\n  }\\n\\n  private startAutoSync(key: string): void {\\n    const config = this.syncConfigs.get(key);\\n    if (!config || !config.interval) return;\\n\\n    const interval = setInterval(() => {\\n      this.sync(key);\\n    }, config.interval);\\n\\n    this.syncIntervals.set(key, interval);\\n  }\\n\\n  async sync(key: string): Promise<void> {\\n    const config = this.syncConfigs.get(key);\\n    if (!config) return;\\n\\n    try {\\n      const response = await fetch(config.endpoint);\\n      const data = await response.json();\\n\\n      if (data.success) {\\n        useAppStore.setState({ notifications: data.data.notifications || [] });\\n      }\\n    } catch (error) {\\n      console.error(`同步失败 [${key}]:`, error);\\n    }\\n  }\\n\\n  connectWebSocket(key: string, wsUrl: string): WebSocket {\\n    if (this.wsConnections.has(key)) {\\n      return this.wsConnections.get(key)!;\\n    }\\n\\n    const ws = new WebSocket(wsUrl);\\n\\n    ws.onopen = () => {\\n      console.log(`WebSocket连接已建立 [${key}]`);\\n    };\\n\\n    ws.onmessage = (event) => {\\n      try {\\n        const message = JSON.parse(event.data);\\n        this.handleWebSocketMessage(key, message);\\n      } catch (error) {\\n        console.error('解析WebSocket消息失败:', error);\\n      }\\n    };\\n\\n    ws.onerror = (error) => {\\n      console.error(`WebSocket错误 [${key}]:`, error);\\n    };\\n\\n    ws.onclose = () => {\\n      console.log(`WebSocket连接已关闭 [${key}]`);\\n      this.wsConnections.delete(key);\\n    };\\n\\n    this.wsConnections.set(key, ws);\\n    return ws;\\n  }\\n\\n  private handleWebSocketMessage(key: string, message: any): void {\\n    switch (message.type) {\\n      case 'order_update':\\n        useOrderStore.getState().updateOrder(message.data.id, message.data);\\n        break;\\n      case 'menu_update':\\n        useMenuStore.getState().updateMenu(message.data.id, message.data);\\n        break;\\n      case 'notification':\\n        useAppStore.getState().addNotification(message.data);\\n        break;\\n      default:\\n        console.warn(`未知的消息类型: ${message.type}`);\\n    }\\n  }\\n}\\n\\n/**\\n * 创建全局数据同步管理器实例\\n */\\nexport const dataSyncManager = new DataSyncManager();\\n\\n/**\\n * React Hook - 使用缓存数据\\n */\\nexport function useCachedData<T = any>(\\n  key: string,\\n  fetcher: () => Promise<T>,\\n  config: CacheConfig<T>\\n) {\\n  const [data, setData] = useState<T | null>(null);\\n  const [loading, setLoading] = useState<boolean>(true);\\n  const [error, setError] = useState<Error | null>(null);\\n\\n  useEffect(() => {\\n    const fetchData = async () => {\\n      setLoading(true);\\n      setError(null);\\n\\n      try {\\n        const cachedData = await cacheManager.get<T>(key, config.strategy);\\n\\n        if (cachedData) {\\n          setData(cachedData);\\n          setLoading(false);\\n          return;\\n        }\\n\\n        const freshData = await fetcher();\\n        setData(freshData);\\n        await cacheManager.set(key, freshData, config);\\n      } catch (err) {\\n        setError(err as Error);\\n      } finally {\\n        setLoading(false);\\n      }\\n    };\\n\\n    fetchData();\\n  }, [key, fetcher, config]);\\n\\n  const refresh = useCallback(async () => {\\n    setLoading(true);\\n    setError(null);\\n\\n    try {\\n      const freshData = await fetcher();\\n      setData(freshData);\\n      await cacheManager.set(key, freshData, config);\\n    } catch (err) {\\n      setError(err as Error);\\n    } finally {\\n      setLoading(false);\\n    }\\n  }, [key, fetcher, config]);\\n\\n  const invalidate = useCallback(async () => {\\n    await cacheManager.delete(key, config.strategy);\\n    await refresh();\\n  }, [key, config.strategy, refresh]);\\n\\n  return { data, loading, error, refresh, invalidate };\\n}\\n\\n/**\\n * 导出所有数据层功能\\n */\\nexport default {\\n  cacheManager,\\n  dataSyncManager,\\n  useAppStore,\\n  useOrderStore,\\n  useMenuStore,\\n  useCachedData,\\n  CacheStrategy,\\n  SyncStatus,\\n};\\n\",\"originTextLength\":18005,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768982805390}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/lib/integration/multi-platform-adapter.ts": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":515,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":515,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"/**\\\\n * @file 多端适配策略\\\\n * @description 实现Web端、移动端、小程序等多终端的一致用户体验\\\\n * @module integration\\\\n * @author YYC³\\\\n * @version 1.0.0\\\\n * @created 2026-01-21\\\\n */\\\\n\\\\nimport { useState, useEffect, useCallback, useRef } from \\\\'react\\\\';\\\\n\\\\n/**\\\\n * 设备类型枚举\\\\n */\\\\nexport enum DeviceType {\\\\n  DESKTOP = \\\\'desktop\\\\',\\\\n  TABLET = \\\\'tablet\\\\',\\\\n  MOBILE = \\\\'mobile\\\\',\\\\n  UNKNOWN = \\\\'unknown\\\\',\\\\n}\\\\n\\\\n/**\\\\n * 屏幕断点\\\\n */\\\\nexport const BREAKPOINTS = {\\\\n  xs: 0,\\\\n  sm: 640,\\\\n  md: 768,\\\\n  lg: 1024,\\\\n  xl: 1280,\\\\n  \\\\'2xl\\\\': 1536,\\\\n} as const;\\\\n\\\\n/**\\\\n * 响应式断点类型\\\\n */\\\\nexport type Breakpoint = keyof typeof BREAKPOINTS;\\\\n\\\\n/**\\\\n * 设备信息接口\\\\n */\\\\nexport interface DeviceInfo {\\\\n  type: DeviceType;\\\\n  width: number;\\\\n  height: number;\\\\n  orientation: \\\\'portrait\\\\' | \\\\'landscape\\\\';\\\\n  isTouch: boolean;\\\\n  isMobile: boolean;\\\\n  isTablet: boolean;\\\\n  isDesktop: boolean;\\\\n  pixelRatio: number;\\\\n}\\\\n\\\\n/**\\\\n * 平台信息接口\\\\n */\\\\nexport interface PlatformInfo {\\\\n  name: \\\\'web\\\\' | \\\\'mobile\\\\' | \\\\'miniprogram\\\\' | \\\\'app\\\\';\\\\n  os: \\\\'ios\\\\' | \\\\'android\\\\' | \\\\'windows\\\\' | \\\\'macos\\\\' | \\\\'linux\\\\' | \\\\'unknown\\\\';\\\\n  browser: \\\\'chrome\\\\' | \\\\'safari\\\\' | \\\\'firefox\\\\' | \\\\'edge\\\\' | \\\\'unknown\\\\';\\\\n  version: string;\\\\n}\\\\n\\\\n/**\\\\n * 响应式配置接口\\\\n */\\\\nexport interface ResponsiveConfig {\\\\n  xs?: any;\\\\n  sm?: any;\\\\n  md?: any;\\\\n  lg?: any;\\\\n  xl?: any;\\\\n  \\\\'2xl\\\\'?: any;\\\\n}\\\\n\\\\n/**\\\\n * 获取设备类型\\\\n */\\\\nexport function getDeviceType(width: number): DeviceType {\\\\n  if (width < BREAKPOINTS.sm) {\\\\n    return DeviceType.MOBILE;\\\\n  } else if (width < BREAKPOINTS.lg) {\\\\n    return DeviceType.TABLET;\\\\n  } else {\\\\n    return DeviceType.DESKTOP;\\\\n  }\\\\n}\\\\n\\\\n/**\\\\n * 获取设备信息\\\\n */\\\\nexport function getDeviceInfo(): DeviceInfo {\\\\n  if (typeof window === \\\\'undefined\\\\') {\\\\n    return {\\\\n      type: DeviceType.UNKNOWN,\\\\n      width: 0,\\\\n      height: 0,\\\\n      orientation: \\\\'portrait\\\\',\\\\n      isTouch: false,\\\\n      isMobile: false,\\\\n      isTablet: false,\\\\n      isDesktop: false,\\\\n      pixelRatio: 1,\\\\n    };\\\\n  }\\\\n\\\\n  const width = window.innerWidth;\\\\n  const height = window.innerHeight;\\\\n  const type = getDeviceType(width);\\\\n  const isTouch = \\\\'ontouchstart\\\\' in window || navigator.maxTouchPoints > 0;\\\\n\\\\n  return {\\\\n    type,\\\\n    width,\\\\n    height,\\\\n    orientation: width > height ? \\\\'landscape\\\\' : \\\\'portrait\\\\',\\\\n    isTouch,\\\\n    isMobile: type === DeviceType.MOBILE,\\\\n    isTablet: type === DeviceType.TABLET,\\\\n    isDesktop: type === DeviceType.DESKTOP,\\\\n    pixelRatio: window.devicePixelRatio || 1,\\\\n  };\\\\n}\\\\n\\\\n/**\\\\n * 获取平台信息\\\\n */\\\\nexport function getPlatformInfo(): PlatformInfo {\\\\n  if (typeof window === \\\\'undefined\\\\') {\\\\n    return {\\\\n      name: \\\\'web\\\\',\\\\n      os: \\\\'unknown\\\\',\\\\n      browser: \\\\'unknown\\\\',\\\\n      version: \\\\'\\\\',\\\\n    };\\\\n  }\\\\n\\\\n  const userAgent = navigator.userAgent.toLowerCase();\\\\n  let name: PlatformInfo[\\\\'name\\\\'] = \\\\'web\\\\';\\\\n  let os: PlatformInfo[\\\\'os\\\\'] = \\\\'unknown\\\\';\\\\n  let browser: PlatformInfo[\\\\'browser\\\\'] = \\\\'unknown\\\\';\\\\n  let version = \\\\'\\\\';\\\\n\\\\n  if (/miniprogram/i.test(userAgent)) {\\\\n    name = \\\\'miniprogram\\\\';\\\\n  } else if (/android/i.test(userAgent)) {\\\\n    os = \\\\'android\\\\';\\\\n  } else if (/iphone|ipad|ipod/i.test(userAgent)) {\\\\n    os = \\\\'ios\\\\';\\\\n  } else if (/windows/i.test(userAgent)) {\\\\n    os = \\\\'windows\\\\';\\\\n  } else if (/macintosh|mac os x/i.test(userAgent)) {\\\\n    os = \\\\'macos\\\\';\\\\n  } else if (/linux/i.test(userAgent)) {\\\\n    os = \\\\'linux\\\\';\\\\n  }\\\\n\\\\n  if (/chrome/i.test(userAgent) && !/edge|opr|brave/i.test(userAgent)) {\\\\n    browser = \\\\'chrome\\\\';\\\\n    const match = userAgent.match(/chrome\\\\\\\\/(\\\\\\\\d+\\\\\\\\.\\\\\\\\d+\\\\\\\\.\\\\\\\\d+\\\\\\\\.\\\\\\\\d+)/);\\\\n    version = match ? match[1] : \\\\'\\\\';\\\\n  } else if (/safari/i.test(userAgent) && !/chrome/i.test(userAgent)) {\\\\n    browser = \\\\'safari\\\\';\\\\n    const match = userAgent.match(/version\\\\\\\\/(\\\\\\\\d+\\\\\\\\.\\\\\\\\d+\\\\\\\\.\\\\\\\\d+)/);\\\\n    version = match ? match[1] : \\\\'\\\\';\\\\n  } else if (/firefox/i.test(userAgent)) {\\\\n    browser = \\\\'firefox\\\\';\\\\n    const match = userAgent.match(/firefox\\\\\\\\/(\\\\\\\\d+\\\\\\\\.\\\\\\\\d+)/);\\\\n    version = match ? match[1] : \\\\'\\\\';\\\\n  } else if (/edge/i.test(userAgent)) {\\\\n    browser = \\\\'edge\\\\';\\\\n    const match = userAgent.match(/edge\\\\\\\\/(\\\\\\\\d+\\\\\\\\.\\\\\\\\d+\\\\\\\\.\\\\\\\\d+\\\\\\\\.\\\\\\\\d+)/);\\\\n    version = match ? match[1] : \\\\'\\\\';\\\\n  }\\\\n\\\\n  return {\\\\n    name,\\\\n    os,\\\\n    browser,\\\\n    version,\\\\n  };\\\\n}\\\\n\\\\n/**\\\\n * React Hook - 使用设备信息\\\\n */\\\\nexport function useDeviceInfo() {\\\\n  const [deviceInfo, setDeviceInfo] = useState<DeviceInfo>(getDeviceInfo());\\\\n\\\\n  useEffect(() => {\\\\n    const handleResize = () => {\\\\n      setDeviceInfo(getDeviceInfo());\\\\n    };\\\\n\\\\n    window.addEventListener(\\\\'resize\\\\', handleResize);\\\\n    window.addEventListener(\\\\'orientationchange\\\\', handleResize);\\\\n\\\\n    return () => {\\\\n      window.removeEventListener(\\\\'resize\\\\', handleResize);\\\\n      window.removeEventListener(\\\\'orientationchange\\\\', handleResize);\\\\n    };\\\\n  }, []);\\\\n\\\\n  return deviceInfo;\\\\n}\\\\n\\\\n/**\\\\n * React Hook - 使用平台信息\\\\n */\\\\nexport function usePlatformInfo() {\\\\n  const [platformInfo, setPlatformInfo] = useState<PlatformInfo>(getPlatformInfo());\\\\n\\\\n  useEffect(() => {\\\\n    setPlatformInfo(getPlatformInfo());\\\\n  }, []);\\\\n\\\\n  return platformInfo;\\\\n}\\\\n\\\\n/**\\\\n * React Hook - 使用响应式断点\\\\n */\\\\nexport function useBreakpoint(): Breakpoint {\\\\n  const [breakpoint, setBreakpoint] = useState<Breakpoint>(\\\\'lg\\\\');\\\\n\\\\n  useEffect(() => {\\\\n    const updateBreakpoint = () => {\\\\n      const width = window.innerWidth;\\\\n\\\\n      if (width < BREAKPOINTS.sm) {\\\\n        setBreakpoint(\\\\'xs\\\\');\\\\n      } else if (width < BREAKPOINTS.md) {\\\\n        setBreakpoint(\\\\'sm\\\\');\\\\n      } else if (width < BREAKPOINTS.lg) {\\\\n        setBreakpoint(\\\\'md\\\\');\\\\n      } else if (width < BREAKPOINTS.xl) {\\\\n        setBreakpoint(\\\\'lg\\\\');\\\\n      } else if (width < BREAKPOINTS[\\\\'2xl\\\\']) {\\\\n        setBreakpoint(\\\\'xl\\\\');\\\\n      } else {\\\\n        setBreakpoint(\\\\'2xl\\\\');\\\\n      }\\\\n    };\\\\n\\\\n    updateBreakpoint();\\\\n    window.addEventListener(\\\\'resize\\\\', updateBreakpoint);\\\\n\\\\n    return () => {\\\\n      window.removeEventListener(\\\\'resize\\\\', updateBreakpoint);\\\\n    };\\\\n  }, []);\\\\n\\\\n  return breakpoint;\\\\n}\\\\n\\\\n/**\\\\n * React Hook - 使用响应式值\\\\n */\\\\nexport function useResponsive<T>(config: ResponsiveConfig): T | undefined {\\\\n  const breakpoint = useBreakpoint();\\\\n\\\\n  const getValue = useCallback((): T | undefined => {\\\\n    const breakpoints: Breakpoint[] = [\\\\'xs\\\\', \\\\'sm\\\\', \\\\'md\\\\', \\\\'lg\\\\', \\\\'xl\\\\', \\\\'2xl\\\\'];\\\\n    const currentIndex = breakpoints.indexOf(breakpoint);\\\\n\\\\n    for (let i = currentIndex; i >= 0; i--) {\\\\n      const bp = breakpoints[i];\\\\n      if (config[bp] !== undefined) {\\\\n        return config[bp] as T;\\\\n      }\\\\n    }\\\\n\\\\n    return undefined;\\\\n  }, [breakpoint, config]);\\\\n\\\\n  return getValue();\\\\n}\\\\n\\\\n/**\\\\n * React Hook - 使用媒体查询\\\\n */\\\\nexport function useMediaQuery(query: string): boolean {\\\\n  const [matches, setMatches] = useState<boolean>(false);\\\\n\\\\n  useEffect(() => {\\\\n    const mediaQuery = window.matchMedia(query);\\\\n    setMatches(mediaQuery.matches);\\\\n\\\\n    const handler = (event: MediaQueryListEvent) => {\\\\n      setMatches(event.matches);\\\\n    };\\\\n\\\\n    mediaQuery.addEventListener(\\\\'change\\\\', handler);\\\\n\\\\n    return () => {\\\\n      mediaQuery.removeEventListener(\\\\'change\\\\', handler);\\\\n    };\\\\n  }, [query]);\\\\n\\\\n  return matches;\\\\n}\\\\n\\\\n/**\\\\n * React Hook - 使用触摸手势\\\\n */\\\\nexport function useTouchGesture(\\\\n  ref: React.RefObject<HTMLElement>,\\\\n  callbacks: {\\\\n    onSwipeLeft?: () => void;\\\\n    onSwipeRight?: () => void;\\\\n    onSwipeUp?: () => void;\\\\n    onSwipeDown?: () => void;\\\\n    onTap?: () => void;\\\\n    onLongPress?: () => void;\\\\n  }\\\\n) {\\\\n  const touchStartRef = useRef<{ x: number; y: number; time: number } | null>(null);\\\\n  const longPressTimerRef = useRef<NodeJS.Timeout | null>(null);\\\\n\\\\n  useEffect(() => {\\\\n    const element = ref.current;\\\\n    if (!element) return;\\\\n\\\\n    const handleTouchStart = (e: TouchEvent) => {\\\\n      const touch = e.touches[0];\\\\n      touchStartRef.current = {\\\\n        x: touch.clientX,\\\\n        y: touch.clientY,\\\\n        time: Date.now(),\\\\n      };\\\\n\\\\n      if (callbacks.onLongPress) {\\\\n        longPressTimerRef.current = setTimeout(() => {\\\\n          callbacks.onLongPress!();\\\\n        }, 500);\\\\n      }\\\\n    };\\\\n\\\\n    const handleTouchMove = (e: TouchEvent) => {\\\\n      if (longPressTimerRef.current) {\\\\n        clearTimeout(longPressTimerRef.current);\\\\n        longPressTimerRef.current = null;\\\\n      }\\\\n    };\\\\n\\\\n    const handleTouchEnd = (e: TouchEvent) => {\\\\n      if (longPressTimerRef.current) {\\\\n        clearTimeout(longPressTimerRef.current);\\\\n        longPressTimerRef.current = null;\\\\n      }\\\\n\\\\n      const touch = e.changedTouches[0];\\\\n      const start = touchStartRef.current;\\\\n\\\\n      if (!start) return;\\\\n\\\\n      const deltaX = touch.clientX - start.x;\\\\n      const deltaY = touch.clientY - start.y;\\\\n      const deltaTime = Date.now() - start.time;\\\\n\\\\n      const minSwipeDistance = 50;\\\\n      const maxSwipeTime = 300;\\\\n\\\\n      if (Math.abs(deltaX) < minSwipeDistance && Math.abs(deltaY) < minSwipeDistance) {\\\\n        if (deltaTime < maxSwipeTime && callbacks.onTap) {\\\\n          callbacks.onTap();\\\\n        }\\\\n        return;\\\\n      }\\\\n\\\\n      if (deltaTime > maxSwipeTime) return;\\\\n\\\\n      if (Math.abs(deltaX) > Math.abs(deltaY)) {\\\\n        if (deltaX > minSwipeDistance && callbacks.onSwipeRight) {\\\\n          callbacks.onSwipeRight();\\\\n        } else if (deltaX < -minSwipeDistance && callbacks.onSwipeLeft) {\\\\n          callbacks.onSwipeLeft();\\\\n        }\\\\n      } else {\\\\n        if (deltaY > minSwipeDistance && callbacks.onSwipeDown) {\\\\n          callbacks.onSwipeDown();\\\\n        } else if (deltaY < -minSwipeDistance && callbacks.onSwipeUp) {\\\\n          callbacks.onSwipeUp();\\\\n        }\\\\n      }\\\\n    };\\\\n\\\\n    element.addEventListener(\\\\'touchstart\\\\', handleTouchStart);\\\\n    element.addEventListener(\\\\'touchmove\\\\', handleTouchMove);\\\\n    element.addEventListener(\\\\'touchend\\\\', handleTouchEnd);\\\\n\\\\n    return () => {\\\\n      element.removeEventListener(\\\\'touchstart\\\\', handleTouchStart);\\\\n      element.removeEventListener(\\\\'touchmove\\\\', handleTouchMove);\\\\n      element.removeEventListener(\\\\'touchend\\\\', handleTouchEnd);\\\\n    };\\\\n  }, [ref, callbacks]);\\\\n}\\\\n\\\\n/**\\\\n * 响应式工具函数\\\\n */\\\\nexport const responsive = {\\\\n  isMobile: () => window.innerWidth < BREAKPOINTS.md,\\\\n  isTablet: () => window.innerWidth >= BREAKPOINTS.md && window.innerWidth < BREAKPOINTS.lg,\\\\n  isDesktop: () => window.innerWidth >= BREAKPOINTS.lg,\\\\n  isPortrait: () => window.innerHeight > window.innerWidth,\\\\n  isLandscape: () => window.innerWidth > window.innerHeight,\\\\n};\\\\n\\\\n/**\\\\n * 平台适配器\\\\n */\\\\nexport class PlatformAdapter {\\\\n  private platformInfo: PlatformInfo;\\\\n  private deviceInfo: DeviceInfo;\\\\n\\\\n  constructor() {\\\\n    this.platformInfo = getPlatformInfo();\\\\n    this.deviceInfo = getDeviceInfo();\\\\n  }\\\\n\\\\n  isWeb(): boolean {\\\\n    return this.platformInfo.name === \\\\'web\\\\';\\\\n  }\\\\n\\\\n  isMobile(): boolean {\\\\n    return this.platformInfo.name === \\\\'mobile\\\\';\\\\n  }\\\\n\\\\n  isMiniProgram(): boolean {\\\\n    return this.platformInfo.name === \\\\'miniprogram\\\\';\\\\n  }\\\\n\\\\n  isIOS(): boolean {\\\\n    return this.platformInfo.os === \\\\'ios\\\\';\\\\n  }\\\\n\\\\n  isAndroid(): boolean {\\\\n    return this.platformInfo.os === \\\\'android\\\\';\\\\n  }\\\\n\\\\n  isTouchDevice(): boolean {\\\\n    return this.deviceInfo.isTouch;\\\\n  }\\\\n\\\\n  getViewport(): { width: number; height: number } {\\\\n    return {\\\\n      width: this.deviceInfo.width,\\\\n      height: this.deviceInfo.height,\\\\n    };\\\\n  }\\\\n\\\\n  getSafeArea(): { top: number; bottom: number; left: number; right: number } {\\\\n    if (typeof window === \\\\'undefined\\\\') {\\\\n      return { top: 0, bottom: 0, left: 0, right: 0 };\\\\n    }\\\\n\\\\n    const safeArea = (window as any).visualViewport;\\\\n\\\\n    if (safeArea) {\\\\n      return {\\\\n        top: safeArea.offsetTop || 0,\\\\n        bottom: window.innerHeight - (safeArea.offsetTop + safeArea.height) || 0,\\\\n        left: safeArea.offsetLeft || 0,\\\\n        right: window.innerWidth - (safeArea.offsetLeft + safeArea.width) || 0,\\\\n      };\\\\n    }\\\\n\\\\n    return { top: 0, bottom: 0, left: 0, right: 0 };\\\\n  }\\\\n\\\\n  openURL(url: string): void {\\\\n    if (this.isMiniProgram()) {\\\\n      (window as any).wx.navigateTo({\\\\n        url,\\\\n      });\\\\n    } else {\\\\n      window.open(url, \\\\'_blank\\\\');\\\\n    }\\\\n  }\\\\n\\\\n  share(content: { title: string; description: string; url: string }): void {\\\\n    if (this.isMiniProgram()) {\\\\n      (window as any).wx.shareAppMessage({\\\\n        title: content.title,\\\\n        path: content.url,\\\\n      });\\\\n    } else if (navigator.share) {\\\\n      navigator.share({\\\\n        title: content.title,\\\\n        text: content.description,\\\\n        url: content.url,\\\\n      });\\\\n    }\\\\n  }\\\\n\\\\n  copyToClipboard(text: string): Promise<boolean> {\\\\n    if (navigator.clipboard) {\\\\n      return navigator.clipboard.writeText(text)\\\\n        .then(() => true)\\\\n        .catch(() => false);\\\\n    }\\\\n\\\\n    const textarea = document.createElement(\\\\'textarea\\\\');\\\\n    textarea.value = text;\\\\n    textarea.style.position = \\\\'fixed\\\\';\\\\n    textarea.style.opacity = \\\\'0\\\\';\\\\n    document.body.appendChild(textarea);\\\\n    textarea.select();\\\\n\\\\n    try {\\\\n      document.execCommand(\\\\'copy\\\\');\\\\n      document.body.removeChild(textarea);\\\\n      return Promise.resolve(true);\\\\n    } catch {\\\\n      document.body.removeChild(textarea);\\\\n      return Promise.resolve(false);\\\\n    }\\\\n  }\\\\n\\\\n  vibrate(pattern: number | number[]): void {\\\\n    if (\\\\'vibrate\\\\' in navigator) {\\\\n      navigator.vibrate(pattern);\\\\n    }\\\\n  }\\\\n\\\\n  requestNotificationPermission(): Promise<NotificationPermission> {\\\\n    if (\\\\'Notification\\\\' in window) {\\\\n      return Notification.requestPermission();\\\\n    }\\\\n\\\\n    return Promise.resolve(\\\\'denied\\\\');\\\\n  }\\\\n\\\\n  showNotification(title: string, options?: NotificationOptions): void {\\\\n    if (\\\\'Notification\\\\' in window && Notification.permission === \\\\'granted\\\\') {\\\\n      new Notification(title, options);\\\\n    }\\\\n  }\\\\n}\\\\n\\\\n/**\\\\n * 创建全局平台适配器实例\\\\n */\\\\nexport const platformAdapter = new PlatformAdapter();\\\\n\\\\n/**\\\\n * React Hook - 使用平台适配器\\\\n */\\\\nexport function usePlatformAdapter(): PlatformAdapter {\\\\n  return platformAdapter;\\\\n}\\\\n\\\\n/**\\\\n * 响应式样式生成器\\\\n */\\\\nexport function createResponsiveStyles<T extends Record<string, any>>(\\\\n  baseStyles: T,\\\\n  responsiveStyles: Partial<Record<Breakpoint, Partial<T>>>\\\\n): (breakpoint: Breakpoint) => T {\\\\n  return (breakpoint: Breakpoint): T => {\\\\n    const breakpoints: Breakpoint[] = [\\\\'xs\\\\', \\\\'sm\\\\', \\\\'md\\\\', \\\\'lg\\\\', \\\\'xl\\\\', \\\\'2xl\\\\'];\\\\n    const currentIndex = breakpoints.indexOf(breakpoint);\\\\n\\\\n    let mergedStyles = { ...baseStyles };\\\\n\\\\n    for (let i = currentIndex; i >= 0; i--) {\\\\n      const bp = breakpoints[i];\\\\n      if (responsiveStyles[bp]) {\\\\n        mergedStyles = {\\\\n          ...mergedStyles,\\\\n          ...responsiveStyles[bp],\\\\n        };\\\\n      }\\\\n    }\\\\n\\\\n    return mergedStyles;\\\\n  };\\\\n}\\\\n\\\\n/**\\\\n * 导出所有多端适配功能\\\\n */\\\\nexport default {\\\\n  DeviceType,\\\\n  BREAKPOINTS,\\\\n  getDeviceInfo,\\\\n  getPlatformInfo,\\\\n  useDeviceInfo,\\\\n  usePlatformInfo,\\\\n  useBreakpoint,\\\\n  useResponsive,\\\\n  useMediaQuery,\\\\n  useTouchGesture,\\\\n  responsive,\\\\n  PlatformAdapter,\\\\n  platformAdapter,\\\\n  usePlatformAdapter,\\\\n  createResponsiveStyles,\\\\n};\\\\n\",\"originAcceptText\":\"/**\\n * @file 多端适配策略\\n * @description 实现Web端、移动端、小程序等多终端的一致用户体验\\n * @module integration\\n * @author YYC³\\n * @version 1.0.0\\n * @created 2026-01-21\\n */\\n\\nimport { useState, useEffect, useCallback, useRef } from 'react';\\n\\n/**\\n * 设备类型枚举\\n */\\nexport enum DeviceType {\\n  DESKTOP = 'desktop',\\n  TABLET = 'tablet',\\n  MOBILE = 'mobile',\\n  UNKNOWN = 'unknown',\\n}\\n\\n/**\\n * 屏幕断点\\n */\\nexport const BREAKPOINTS = {\\n  xs: 0,\\n  sm: 640,\\n  md: 768,\\n  lg: 1024,\\n  xl: 1280,\\n  '2xl': 1536,\\n} as const;\\n\\n/**\\n * 响应式断点类型\\n */\\nexport type Breakpoint = keyof typeof BREAKPOINTS;\\n\\n/**\\n * 设备信息接口\\n */\\nexport interface DeviceInfo {\\n  type: DeviceType;\\n  width: number;\\n  height: number;\\n  orientation: 'portrait' | 'landscape';\\n  isTouch: boolean;\\n  isMobile: boolean;\\n  isTablet: boolean;\\n  isDesktop: boolean;\\n  pixelRatio: number;\\n}\\n\\n/**\\n * 平台信息接口\\n */\\nexport interface PlatformInfo {\\n  name: 'web' | 'mobile' | 'miniprogram' | 'app';\\n  os: 'ios' | 'android' | 'windows' | 'macos' | 'linux' | 'unknown';\\n  browser: 'chrome' | 'safari' | 'firefox' | 'edge' | 'unknown';\\n  version: string;\\n}\\n\\n/**\\n * 响应式配置接口\\n */\\nexport interface ResponsiveConfig {\\n  xs?: any;\\n  sm?: any;\\n  md?: any;\\n  lg?: any;\\n  xl?: any;\\n  '2xl'?: any;\\n}\\n\\n/**\\n * 获取设备类型\\n */\\nexport function getDeviceType(width: number): DeviceType {\\n  if (width < BREAKPOINTS.sm) {\\n    return DeviceType.MOBILE;\\n  } else if (width < BREAKPOINTS.lg) {\\n    return DeviceType.TABLET;\\n  } else {\\n    return DeviceType.DESKTOP;\\n  }\\n}\\n\\n/**\\n * 获取设备信息\\n */\\nexport function getDeviceInfo(): DeviceInfo {\\n  if (typeof window === 'undefined') {\\n    return {\\n      type: DeviceType.UNKNOWN,\\n      width: 0,\\n      height: 0,\\n      orientation: 'portrait',\\n      isTouch: false,\\n      isMobile: false,\\n      isTablet: false,\\n      isDesktop: false,\\n      pixelRatio: 1,\\n    };\\n  }\\n\\n  const width = window.innerWidth;\\n  const height = window.innerHeight;\\n  const type = getDeviceType(width);\\n  const isTouch = 'ontouchstart' in window || navigator.maxTouchPoints > 0;\\n\\n  return {\\n    type,\\n    width,\\n    height,\\n    orientation: width > height ? 'landscape' : 'portrait',\\n    isTouch,\\n    isMobile: type === DeviceType.MOBILE,\\n    isTablet: type === DeviceType.TABLET,\\n    isDesktop: type === DeviceType.DESKTOP,\\n    pixelRatio: window.devicePixelRatio || 1,\\n  };\\n}\\n\\n/**\\n * 获取平台信息\\n */\\nexport function getPlatformInfo(): PlatformInfo {\\n  if (typeof window === 'undefined') {\\n    return {\\n      name: 'web',\\n      os: 'unknown',\\n      browser: 'unknown',\\n      version: '',\\n    };\\n  }\\n\\n  const userAgent = navigator.userAgent.toLowerCase();\\n  let name: PlatformInfo['name'] = 'web';\\n  let os: PlatformInfo['os'] = 'unknown';\\n  let browser: PlatformInfo['browser'] = 'unknown';\\n  let version = '';\\n\\n  if (/miniprogram/i.test(userAgent)) {\\n    name = 'miniprogram';\\n  } else if (/android/i.test(userAgent)) {\\n    os = 'android';\\n  } else if (/iphone|ipad|ipod/i.test(userAgent)) {\\n    os = 'ios';\\n  } else if (/windows/i.test(userAgent)) {\\n    os = 'windows';\\n  } else if (/macintosh|mac os x/i.test(userAgent)) {\\n    os = 'macos';\\n  } else if (/linux/i.test(userAgent)) {\\n    os = 'linux';\\n  }\\n\\n  if (/chrome/i.test(userAgent) && !/edge|opr|brave/i.test(userAgent)) {\\n    browser = 'chrome';\\n    const match = userAgent.match(/chrome\\\\/(\\\\d+\\\\.\\\\d+\\\\.\\\\d+\\\\.\\\\d+)/);\\n    version = match ? match[1] : '';\\n  } else if (/safari/i.test(userAgent) && !/chrome/i.test(userAgent)) {\\n    browser = 'safari';\\n    const match = userAgent.match(/version\\\\/(\\\\d+\\\\.\\\\d+\\\\.\\\\d+)/);\\n    version = match ? match[1] : '';\\n  } else if (/firefox/i.test(userAgent)) {\\n    browser = 'firefox';\\n    const match = userAgent.match(/firefox\\\\/(\\\\d+\\\\.\\\\d+)/);\\n    version = match ? match[1] : '';\\n  } else if (/edge/i.test(userAgent)) {\\n    browser = 'edge';\\n    const match = userAgent.match(/edge\\\\/(\\\\d+\\\\.\\\\d+\\\\.\\\\d+\\\\.\\\\d+)/);\\n    version = match ? match[1] : '';\\n  }\\n\\n  return {\\n    name,\\n    os,\\n    browser,\\n    version,\\n  };\\n}\\n\\n/**\\n * React Hook - 使用设备信息\\n */\\nexport function useDeviceInfo() {\\n  const [deviceInfo, setDeviceInfo] = useState<DeviceInfo>(getDeviceInfo());\\n\\n  useEffect(() => {\\n    const handleResize = () => {\\n      setDeviceInfo(getDeviceInfo());\\n    };\\n\\n    window.addEventListener('resize', handleResize);\\n    window.addEventListener('orientationchange', handleResize);\\n\\n    return () => {\\n      window.removeEventListener('resize', handleResize);\\n      window.removeEventListener('orientationchange', handleResize);\\n    };\\n  }, []);\\n\\n  return deviceInfo;\\n}\\n\\n/**\\n * React Hook - 使用平台信息\\n */\\nexport function usePlatformInfo() {\\n  const [platformInfo, setPlatformInfo] = useState<PlatformInfo>(getPlatformInfo());\\n\\n  useEffect(() => {\\n    setPlatformInfo(getPlatformInfo());\\n  }, []);\\n\\n  return platformInfo;\\n}\\n\\n/**\\n * React Hook - 使用响应式断点\\n */\\nexport function useBreakpoint(): Breakpoint {\\n  const [breakpoint, setBreakpoint] = useState<Breakpoint>('lg');\\n\\n  useEffect(() => {\\n    const updateBreakpoint = () => {\\n      const width = window.innerWidth;\\n\\n      if (width < BREAKPOINTS.sm) {\\n        setBreakpoint('xs');\\n      } else if (width < BREAKPOINTS.md) {\\n        setBreakpoint('sm');\\n      } else if (width < BREAKPOINTS.lg) {\\n        setBreakpoint('md');\\n      } else if (width < BREAKPOINTS.xl) {\\n        setBreakpoint('lg');\\n      } else if (width < BREAKPOINTS['2xl']) {\\n        setBreakpoint('xl');\\n      } else {\\n        setBreakpoint('2xl');\\n      }\\n    };\\n\\n    updateBreakpoint();\\n    window.addEventListener('resize', updateBreakpoint);\\n\\n    return () => {\\n      window.removeEventListener('resize', updateBreakpoint);\\n    };\\n  }, []);\\n\\n  return breakpoint;\\n}\\n\\n/**\\n * React Hook - 使用响应式值\\n */\\nexport function useResponsive<T>(config: ResponsiveConfig): T | undefined {\\n  const breakpoint = useBreakpoint();\\n\\n  const getValue = useCallback((): T | undefined => {\\n    const breakpoints: Breakpoint[] = ['xs', 'sm', 'md', 'lg', 'xl', '2xl'];\\n    const currentIndex = breakpoints.indexOf(breakpoint);\\n\\n    for (let i = currentIndex; i >= 0; i--) {\\n      const bp = breakpoints[i];\\n      if (config[bp] !== undefined) {\\n        return config[bp] as T;\\n      }\\n    }\\n\\n    return undefined;\\n  }, [breakpoint, config]);\\n\\n  return getValue();\\n}\\n\\n/**\\n * React Hook - 使用媒体查询\\n */\\nexport function useMediaQuery(query: string): boolean {\\n  const [matches, setMatches] = useState<boolean>(false);\\n\\n  useEffect(() => {\\n    const mediaQuery = window.matchMedia(query);\\n    setMatches(mediaQuery.matches);\\n\\n    const handler = (event: MediaQueryListEvent) => {\\n      setMatches(event.matches);\\n    };\\n\\n    mediaQuery.addEventListener('change', handler);\\n\\n    return () => {\\n      mediaQuery.removeEventListener('change', handler);\\n    };\\n  }, [query]);\\n\\n  return matches;\\n}\\n\\n/**\\n * React Hook - 使用触摸手势\\n */\\nexport function useTouchGesture(\\n  ref: React.RefObject<HTMLElement>,\\n  callbacks: {\\n    onSwipeLeft?: () => void;\\n    onSwipeRight?: () => void;\\n    onSwipeUp?: () => void;\\n    onSwipeDown?: () => void;\\n    onTap?: () => void;\\n    onLongPress?: () => void;\\n  }\\n) {\\n  const touchStartRef = useRef<{ x: number; y: number; time: number } | null>(null);\\n  const longPressTimerRef = useRef<NodeJS.Timeout | null>(null);\\n\\n  useEffect(() => {\\n    const element = ref.current;\\n    if (!element) return;\\n\\n    const handleTouchStart = (e: TouchEvent) => {\\n      const touch = e.touches[0];\\n      touchStartRef.current = {\\n        x: touch.clientX,\\n        y: touch.clientY,\\n        time: Date.now(),\\n      };\\n\\n      if (callbacks.onLongPress) {\\n        longPressTimerRef.current = setTimeout(() => {\\n          callbacks.onLongPress!();\\n        }, 500);\\n      }\\n    };\\n\\n    const handleTouchMove = (e: TouchEvent) => {\\n      if (longPressTimerRef.current) {\\n        clearTimeout(longPressTimerRef.current);\\n        longPressTimerRef.current = null;\\n      }\\n    };\\n\\n    const handleTouchEnd = (e: TouchEvent) => {\\n      if (longPressTimerRef.current) {\\n        clearTimeout(longPressTimerRef.current);\\n        longPressTimerRef.current = null;\\n      }\\n\\n      const touch = e.changedTouches[0];\\n      const start = touchStartRef.current;\\n\\n      if (!start) return;\\n\\n      const deltaX = touch.clientX - start.x;\\n      const deltaY = touch.clientY - start.y;\\n      const deltaTime = Date.now() - start.time;\\n\\n      const minSwipeDistance = 50;\\n      const maxSwipeTime = 300;\\n\\n      if (Math.abs(deltaX) < minSwipeDistance && Math.abs(deltaY) < minSwipeDistance) {\\n        if (deltaTime < maxSwipeTime && callbacks.onTap) {\\n          callbacks.onTap();\\n        }\\n        return;\\n      }\\n\\n      if (deltaTime > maxSwipeTime) return;\\n\\n      if (Math.abs(deltaX) > Math.abs(deltaY)) {\\n        if (deltaX > minSwipeDistance && callbacks.onSwipeRight) {\\n          callbacks.onSwipeRight();\\n        } else if (deltaX < -minSwipeDistance && callbacks.onSwipeLeft) {\\n          callbacks.onSwipeLeft();\\n        }\\n      } else {\\n        if (deltaY > minSwipeDistance && callbacks.onSwipeDown) {\\n          callbacks.onSwipeDown();\\n        } else if (deltaY < -minSwipeDistance && callbacks.onSwipeUp) {\\n          callbacks.onSwipeUp();\\n        }\\n      }\\n    };\\n\\n    element.addEventListener('touchstart', handleTouchStart);\\n    element.addEventListener('touchmove', handleTouchMove);\\n    element.addEventListener('touchend', handleTouchEnd);\\n\\n    return () => {\\n      element.removeEventListener('touchstart', handleTouchStart);\\n      element.removeEventListener('touchmove', handleTouchMove);\\n      element.removeEventListener('touchend', handleTouchEnd);\\n    };\\n  }, [ref, callbacks]);\\n}\\n\\n/**\\n * 响应式工具函数\\n */\\nexport const responsive = {\\n  isMobile: () => window.innerWidth < BREAKPOINTS.md,\\n  isTablet: () => window.innerWidth >= BREAKPOINTS.md && window.innerWidth < BREAKPOINTS.lg,\\n  isDesktop: () => window.innerWidth >= BREAKPOINTS.lg,\\n  isPortrait: () => window.innerHeight > window.innerWidth,\\n  isLandscape: () => window.innerWidth > window.innerHeight,\\n};\\n\\n/**\\n * 平台适配器\\n */\\nexport class PlatformAdapter {\\n  private platformInfo: PlatformInfo;\\n  private deviceInfo: DeviceInfo;\\n\\n  constructor() {\\n    this.platformInfo = getPlatformInfo();\\n    this.deviceInfo = getDeviceInfo();\\n  }\\n\\n  isWeb(): boolean {\\n    return this.platformInfo.name === 'web';\\n  }\\n\\n  isMobile(): boolean {\\n    return this.platformInfo.name === 'mobile';\\n  }\\n\\n  isMiniProgram(): boolean {\\n    return this.platformInfo.name === 'miniprogram';\\n  }\\n\\n  isIOS(): boolean {\\n    return this.platformInfo.os === 'ios';\\n  }\\n\\n  isAndroid(): boolean {\\n    return this.platformInfo.os === 'android';\\n  }\\n\\n  isTouchDevice(): boolean {\\n    return this.deviceInfo.isTouch;\\n  }\\n\\n  getViewport(): { width: number; height: number } {\\n    return {\\n      width: this.deviceInfo.width,\\n      height: this.deviceInfo.height,\\n    };\\n  }\\n\\n  getSafeArea(): { top: number; bottom: number; left: number; right: number } {\\n    if (typeof window === 'undefined') {\\n      return { top: 0, bottom: 0, left: 0, right: 0 };\\n    }\\n\\n    const safeArea = (window as any).visualViewport;\\n\\n    if (safeArea) {\\n      return {\\n        top: safeArea.offsetTop || 0,\\n        bottom: window.innerHeight - (safeArea.offsetTop + safeArea.height) || 0,\\n        left: safeArea.offsetLeft || 0,\\n        right: window.innerWidth - (safeArea.offsetLeft + safeArea.width) || 0,\\n      };\\n    }\\n\\n    return { top: 0, bottom: 0, left: 0, right: 0 };\\n  }\\n\\n  openURL(url: string): void {\\n    if (this.isMiniProgram()) {\\n      (window as any).wx.navigateTo({\\n        url,\\n      });\\n    } else {\\n      window.open(url, '_blank');\\n    }\\n  }\\n\\n  share(content: { title: string; description: string; url: string }): void {\\n    if (this.isMiniProgram()) {\\n      (window as any).wx.shareAppMessage({\\n        title: content.title,\\n        path: content.url,\\n      });\\n    } else if (navigator.share) {\\n      navigator.share({\\n        title: content.title,\\n        text: content.description,\\n        url: content.url,\\n      });\\n    }\\n  }\\n\\n  copyToClipboard(text: string): Promise<boolean> {\\n    if (navigator.clipboard) {\\n      return navigator.clipboard.writeText(text)\\n        .then(() => true)\\n        .catch(() => false);\\n    }\\n\\n    const textarea = document.createElement('textarea');\\n    textarea.value = text;\\n    textarea.style.position = 'fixed';\\n    textarea.style.opacity = '0';\\n    document.body.appendChild(textarea);\\n    textarea.select();\\n\\n    try {\\n      document.execCommand('copy');\\n      document.body.removeChild(textarea);\\n      return Promise.resolve(true);\\n    } catch {\\n      document.body.removeChild(textarea);\\n      return Promise.resolve(false);\\n    }\\n  }\\n\\n  vibrate(pattern: number | number[]): void {\\n    if ('vibrate' in navigator) {\\n      navigator.vibrate(pattern);\\n    }\\n  }\\n\\n  requestNotificationPermission(): Promise<NotificationPermission> {\\n    if ('Notification' in window) {\\n      return Notification.requestPermission();\\n    }\\n\\n    return Promise.resolve('denied');\\n  }\\n\\n  showNotification(title: string, options?: NotificationOptions): void {\\n    if ('Notification' in window && Notification.permission === 'granted') {\\n      new Notification(title, options);\\n    }\\n  }\\n}\\n\\n/**\\n * 创建全局平台适配器实例\\n */\\nexport const platformAdapter = new PlatformAdapter();\\n\\n/**\\n * React Hook - 使用平台适配器\\n */\\nexport function usePlatformAdapter(): PlatformAdapter {\\n  return platformAdapter;\\n}\\n\\n/**\\n * 响应式样式生成器\\n */\\nexport function createResponsiveStyles<T extends Record<string, any>>(\\n  baseStyles: T,\\n  responsiveStyles: Partial<Record<Breakpoint, Partial<T>>>\\n): (breakpoint: Breakpoint) => T {\\n  return (breakpoint: Breakpoint): T => {\\n    const breakpoints: Breakpoint[] = ['xs', 'sm', 'md', 'lg', 'xl', '2xl'];\\n    const currentIndex = breakpoints.indexOf(breakpoint);\\n\\n    let mergedStyles = { ...baseStyles };\\n\\n    for (let i = currentIndex; i >= 0; i--) {\\n      const bp = breakpoints[i];\\n      if (responsiveStyles[bp]) {\\n        mergedStyles = {\\n          ...mergedStyles,\\n          ...responsiveStyles[bp],\\n        };\\n      }\\n    }\\n\\n    return mergedStyles;\\n  };\\n}\\n\\n/**\\n * 导出所有多端适配功能\\n */\\nexport default {\\n  DeviceType,\\n  BREAKPOINTS,\\n  getDeviceInfo,\\n  getPlatformInfo,\\n  useDeviceInfo,\\n  usePlatformInfo,\\n  useBreakpoint,\\n  useResponsive,\\n  useMediaQuery,\\n  useTouchGesture,\\n  responsive,\\n  PlatformAdapter,\\n  platformAdapter,\\n  usePlatformAdapter,\\n  createResponsiveStyles,\\n};\\n\",\"originTextLength\":14170,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768982955954}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/lib/integration/cross-dimension-sync.ts": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":646,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":646,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"/**\\\\n * @file 跨维度数据交互与状态同步机制\\\\n * @description 实现多端数据同步、实时更新、离线处理的完整同步机制\\\\n * @module integration\\\\n * @author YYC³\\\\n * @version 1.0.0\\\\n * @created 2026-01-21\\\\n */\\\\n\\\\nimport { EventEmitter } from \\\\'events\\\\';\\\\n\\\\n/**\\\\n * 数据操作类型\\\\n */\\\\nexport enum DataOperationType {\\\\n  CREATE = \\\\'create\\\\',\\\\n  UPDATE = \\\\'update\\\\',\\\\n  DELETE = \\\\'delete\\\\',\\\\n  SYNC = \\\\'sync\\\\',\\\\n}\\\\n\\\\n/**\\\\n * 数据同步状态\\\\n */\\\\nexport enum SyncState {\\\\n  IDLE = \\\\'idle\\\\',\\\\n  SYNCING = \\\\'syncing\\\\',\\\\n  SUCCESS = \\\\'success\\\\',\\\\n  ERROR = \\\\'error\\\\',\\\\n  CONFLICT = \\\\'conflict\\\\',\\\\n  OFFLINE = \\\\'offline\\\\',\\\\n}\\\\n\\\\n/**\\\\n * 数据源类型\\\\n */\\\\nexport enum DataSourceType {\\\\n  LOCAL = \\\\'local\\\\',\\\\n  REMOTE = \\\\'remote\\\\',\\\\n  CACHE = \\\\'cache\\\\',\\\\n  OFFLINE_QUEUE = \\\\'offline_queue\\\\',\\\\n}\\\\n\\\\n/**\\\\n * 数据事件接口\\\\n */\\\\nexport interface DataEvent<T = any> {\\\\n  id: string;\\\\n  type: DataOperationType;\\\\n  source: DataSourceType;\\\\n  entity: string;\\\\n  entityId: string;\\\\n  data: T;\\\\n  timestamp: number;\\\\n  version: number;\\\\n  userId?: string;\\\\n  deviceId?: string;\\\\n}\\\\n\\\\n/**\\\\n * 数据同步配置接口\\\\n */\\\\nexport interface DataSyncConfig {\\\\n  entity: string;\\\\n  endpoint: string;\\\\n  syncInterval?: number;\\\\n  autoSync?: boolean;\\\\n  conflictResolution?: \\\\'local\\\\' | \\\\'remote\\\\' | \\\\'merge\\\\' | \\\\'manual\\\\';\\\\n  offlineSupport?: boolean;\\\\n  realTime?: boolean;\\\\n}\\\\n\\\\n/**\\\\n * 离线操作接口\\\\n */\\\\nexport interface OfflineOperation {\\\\n  id: string;\\\\n  operation: DataOperationType;\\\\n  entity: string;\\\\n  entityId: string;\\\\n  data: any;\\\\n  timestamp: number;\\\\n  retryCount: number;\\\\n  maxRetries: number;\\\\n}\\\\n\\\\n/**\\\\n * 数据冲突接口\\\\n */\\\\nexport interface DataConflict {\\\\n  id: string;\\\\n  entity: string;\\\\n  entityId: string;\\\\n  localData: any;\\\\n  remoteData: any;\\\\n  timestamp: number;\\\\n  resolved: boolean;\\\\n}\\\\n\\\\n/**\\\\n * 事件总线\\\\n */\\\\nexport class EventBus extends EventEmitter {\\\\n  private static instance: EventBus;\\\\n\\\\n  static getInstance(): EventBus {\\\\n    if (!EventBus.instance) {\\\\n      EventBus.instance = new EventBus();\\\\n    }\\\\n    return EventBus.instance;\\\\n  }\\\\n\\\\n  emit<T>(event: string, data: T): boolean {\\\\n    return super.emit(event, data);\\\\n  }\\\\n\\\\n  on<T>(event: string, listener: (data: T) => void): this {\\\\n    return super.on(event, listener);\\\\n  }\\\\n\\\\n  off<T>(event: string, listener: (data: T) => void): this {\\\\n    return super.off(event, listener);\\\\n  }\\\\n\\\\n  once<T>(event: string, listener: (data: T) => void): this {\\\\n    return super.once(event, listener);\\\\n  }\\\\n}\\\\n\\\\n/**\\\\n * 创建全局事件总线实例\\\\n */\\\\nexport const eventBus = EventBus.getInstance();\\\\n\\\\n/**\\\\n * 离线队列管理器\\\\n */\\\\nexport class OfflineQueueManager {\\\\n  private queue: Map<string, OfflineOperation> = new Map();\\\\n  private storageKey: string = \\\\'yyc3_offline_queue\\\\';\\\\n\\\\n  constructor() {\\\\n    this.loadFromStorage();\\\\n  }\\\\n\\\\n  private loadFromStorage(): void {\\\\n    try {\\\\n      const stored = localStorage.getItem(this.storageKey);\\\\n      if (stored) {\\\\n        const operations: OfflineOperation[] = JSON.parse(stored);\\\\n        operations.forEach(op => {\\\\n          this.queue.set(op.id, op);\\\\n        });\\\\n      }\\\\n    } catch (error) {\\\\n      console.error(\\\\'加载离线队列失败:\\\\', error);\\\\n    }\\\\n  }\\\\n\\\\n  private saveToStorage(): void {\\\\n    try {\\\\n      const operations = Array.from(this.queue.values());\\\\n      localStorage.setItem(this.storageKey, JSON.stringify(operations));\\\\n    } catch (error) {\\\\n      console.error(\\\\'保存离线队列失败:\\\\', error);\\\\n    }\\\\n  }\\\\n\\\\n  add(operation: Omit<OfflineOperation, \\\\'id\\\\' | \\\\'timestamp\\\\' | \\\\'retryCount\\\\'>): string {\\\\n    const id = `${operation.entity}_${operation.entityId}_${Date.now()}`;\\\\n    const offlineOperation: OfflineOperation = {\\\\n      id,\\\\n      ...operation,\\\\n      timestamp: Date.now(),\\\\n      retryCount: 0,\\\\n    };\\\\n\\\\n    this.queue.set(id, offlineOperation);\\\\n    this.saveToStorage();\\\\n\\\\n    eventBus.emit(\\\\'offline:operation:added\\\\', offlineOperation);\\\\n\\\\n    return id;\\\\n  }\\\\n\\\\n  remove(id: string): void {\\\\n    this.queue.delete(id);\\\\n    this.saveToStorage();\\\\n\\\\n    eventBus.emit(\\\\'offline:operation:removed\\\\', id);\\\\n  }\\\\n\\\\n  get(id: string): OfflineOperation | undefined {\\\\n    return this.queue.get(id);\\\\n  }\\\\n\\\\n  getAll(): OfflineOperation[] {\\\\n    return Array.from(this.queue.values());\\\\n  }\\\\n\\\\n  getByEntity(entity: string): OfflineOperation[] {\\\\n    return Array.from(this.queue.values()).filter(op => op.entity === entity);\\\\n  }\\\\n\\\\n  clear(): void {\\\\n    this.queue.clear();\\\\n    this.saveToStorage();\\\\n\\\\n    eventBus.emit(\\\\'offline:queue:cleared\\\\');\\\\n  }\\\\n\\\\n  size(): number {\\\\n    return this.queue.size;\\\\n  }\\\\n}\\\\n\\\\n/**\\\\n * 创建全局离线队列管理器实例\\\\n */\\\\nexport const offlineQueueManager = new OfflineQueueManager();\\\\n\\\\n/**\\\\n * 数据冲突解决器\\\\n */\\\\nexport class DataConflictResolver {\\\\n  private conflicts: Map<string, DataConflict> = new Map();\\\\n\\\\n  detectConflict(localData: any, remoteData: any): boolean {\\\\n    const localVersion = localData.version || 0;\\\\n    const remoteVersion = remoteData.version || 0;\\\\n\\\\n    return localVersion !== remoteVersion;\\\\n  }\\\\n\\\\n  createConflict(entity: string, entityId: string, localData: any, remoteData: any): DataConflict {\\\\n    const conflict: DataConflict = {\\\\n      id: `${entity}_${entityId}_${Date.now()}`,\\\\n      entity,\\\\n      entityId,\\\\n      localData,\\\\n      remoteData,\\\\n      timestamp: Date.now(),\\\\n      resolved: false,\\\\n    };\\\\n\\\\n    this.conflicts.set(conflict.id, conflict);\\\\n\\\\n    eventBus.emit(\\\\'conflict:detected\\\\', conflict);\\\\n\\\\n    return conflict;\\\\n  }\\\\n\\\\n  resolveConflict(conflictId: string, resolution: \\\\'local\\\\' | \\\\'remote\\\\' | \\\\'merge\\\\', mergedData?: any): void {\\\\n    const conflict = this.conflicts.get(conflictId);\\\\n    if (!conflict) return;\\\\n\\\\n    conflict.resolved = true;\\\\n\\\\n    eventBus.emit(\\\\'conflict:resolved\\\\', {\\\\n      conflict,\\\\n      resolution,\\\\n      mergedData,\\\\n    });\\\\n\\\\n    this.conflicts.delete(conflictId);\\\\n  }\\\\n\\\\n  getConflicts(): DataConflict[] {\\\\n    return Array.from(this.conflicts.values());\\\\n  }\\\\n\\\\n  getConflictsByEntity(entity: string): DataConflict[] {\\\\n    return Array.from(this.conflicts.values()).filter(c => c.entity === entity);\\\\n  }\\\\n}\\\\n\\\\n/**\\\\n * 创建全局数据冲突解决器实例\\\\n */\\\\nexport const dataConflictResolver = new DataConflictResolver();\\\\n\\\\n/**\\\\n * 实时数据同步管理器\\\\n */\\\\nexport class RealtimeSyncManager {\\\\n  private wsConnections: Map<string, WebSocket> = new Map();\\\\n  private reconnectIntervals: Map<string, NodeJS.Timeout> = new Map();\\\\n  private syncConfigs: Map<string, DataSyncConfig> = new Map();\\\\n\\\\n  register(config: DataSyncConfig): void {\\\\n    this.syncConfigs.set(config.entity, config);\\\\n\\\\n    if (config.realTime) {\\\\n      this.connectWebSocket(config);\\\\n    }\\\\n\\\\n    if (config.autoSync && config.syncInterval) {\\\\n      this.startAutoSync(config);\\\\n    }\\\\n  }\\\\n\\\\n  unregister(entity: string): void {\\\\n    const config = this.syncConfigs.get(entity);\\\\n    if (!config) return;\\\\n\\\\n    if (this.wsConnections.has(entity)) {\\\\n      this.wsConnections.get(entity)!.close();\\\\n      this.wsConnections.delete(entity);\\\\n    }\\\\n\\\\n    if (this.reconnectIntervals.has(entity)) {\\\\n      clearInterval(this.reconnectIntervals.get(entity)!);\\\\n      this.reconnectIntervals.delete(entity);\\\\n    }\\\\n\\\\n    this.syncConfigs.delete(entity);\\\\n  }\\\\n\\\\n  private connectWebSocket(config: DataSyncConfig): void {\\\\n    const wsUrl = config.endpoint.replace(\\\\'http\\\\', \\\\'ws\\\\');\\\\n\\\\n    const ws = new WebSocket(wsUrl);\\\\n\\\\n    ws.onopen = () => {\\\\n      console.log(`WebSocket连接已建立 [${config.entity}]`);\\\\n      eventBus.emit(\\\\'sync:connected\\\\', { entity: config.entity });\\\\n    };\\\\n\\\\n    ws.onmessage = (event) => {\\\\n      try {\\\\n        const message = JSON.parse(event.data);\\\\n        this.handleWebSocketMessage(config.entity, message);\\\\n      } catch (error) {\\\\n        console.error(\\\\'解析WebSocket消息失败:\\\\', error);\\\\n      }\\\\n    };\\\\n\\\\n    ws.onerror = (error) => {\\\\n      console.error(`WebSocket错误 [${config.entity}]:`, error);\\\\n      eventBus.emit(\\\\'sync:error\\\\', { entity: config.entity, error });\\\\n    };\\\\n\\\\n    ws.onclose = () => {\\\\n      console.log(`WebSocket连接已关闭 [${config.entity}]`);\\\\n      eventBus.emit(\\\\'sync:disconnected\\\\', { entity: config.entity });\\\\n\\\\n      if (this.syncConfigs.has(config.entity)) {\\\\n        this.scheduleReconnect(config);\\\\n      }\\\\n    };\\\\n\\\\n    this.wsConnections.set(config.entity, ws);\\\\n  }\\\\n\\\\n  private scheduleReconnect(config: DataSyncConfig): void {\\\\n    const interval = setInterval(() => {\\\\n      this.connectWebSocket(config);\\\\n    }, 5000);\\\\n\\\\n    this.reconnectIntervals.set(config.entity, interval);\\\\n  }\\\\n\\\\n  private handleWebSocketMessage(entity: string, message: any): void {\\\\n    switch (message.type) {\\\\n      case \\\\'create\\\\':\\\\n        eventBus.emit(`data:${entity}:created`, message.data);\\\\n        break;\\\\n      case \\\\'update\\\\':\\\\n        eventBus.emit(`data:${entity}:updated`, message.data);\\\\n        break;\\\\n      case \\\\'delete\\\\':\\\\n        eventBus.emit(`data:${entity}:deleted`, message.data);\\\\n        break;\\\\n      case \\\\'sync\\\\':\\\\n        eventBus.emit(`data:${entity}:synced`, message.data);\\\\n        break;\\\\n      default:\\\\n        console.warn(`未知的WebSocket消息类型: ${message.type}`);\\\\n    }\\\\n  }\\\\n\\\\n  private startAutoSync(config: DataSyncConfig): void {\\\\n    const interval = setInterval(() => {\\\\n      this.sync(config.entity);\\\\n    }, config.syncInterval!);\\\\n\\\\n    this.reconnectIntervals.set(`${config.entity}_auto`, interval);\\\\n  }\\\\n\\\\n  async sync(entity: string): Promise<void> {\\\\n    const config = this.syncConfigs.get(entity);\\\\n    if (!config) return;\\\\n\\\\n    eventBus.emit(\\\\'sync:started\\\\', { entity });\\\\n\\\\n    try {\\\\n      const response = await fetch(config.endpoint);\\\\n      const data = await response.json();\\\\n\\\\n      if (data.success) {\\\\n        eventBus.emit(`data:${entity}:synced`, data.data);\\\\n        eventBus.emit(\\\\'sync:completed\\\\', { entity, data: data.data });\\\\n      }\\\\n    } catch (error) {\\\\n      console.error(`同步失败 [${entity}]:`, error);\\\\n      eventBus.emit(\\\\'sync:error\\\\', { entity, error });\\\\n    }\\\\n  }\\\\n\\\\n  isConnected(entity: string): boolean {\\\\n    const ws = this.wsConnections.get(entity);\\\\n    return ws ? ws.readyState === WebSocket.OPEN : false;\\\\n  }\\\\n}\\\\n\\\\n/**\\\\n * 创建全局实时数据同步管理器实例\\\\n */\\\\nexport const realtimeSyncManager = new RealtimeSyncManager();\\\\n\\\\n/**\\\\n * 跨维度数据交互管理器\\\\n */\\\\nexport class CrossDimensionDataManager {\\\\n  private syncConfigs: Map<string, DataSyncConfig> = new Map();\\\\n  private syncStates: Map<string, SyncState> = new Map();\\\\n\\\\n  register(config: DataSyncConfig): void {\\\\n    this.syncConfigs.set(config.entity, config);\\\\n    this.syncStates.set(config.entity, SyncState.IDLE);\\\\n\\\\n    realtimeSyncManager.register(config);\\\\n\\\\n    eventBus.on(`data:${config.entity}:updated`, (data) => {\\\\n      this.handleDataUpdate(config.entity, data);\\\\n    });\\\\n\\\\n    eventBus.on(`data:${config.entity}:deleted`, (data) => {\\\\n      this.handleDataDelete(config.entity, data);\\\\n    });\\\\n  }\\\\n\\\\n  unregister(entity: string): void {\\\\n    this.syncConfigs.delete(entity);\\\\n    this.syncStates.delete(entity);\\\\n    realtimeSyncManager.unregister(entity);\\\\n  }\\\\n\\\\n  private handleDataUpdate(entity: string, data: any): void {\\\\n    const config = this.syncConfigs.get(entity);\\\\n    if (!config) return;\\\\n\\\\n    const event: DataEvent = {\\\\n      id: `${entity}_${data.id}_${Date.now()}`,\\\\n      type: DataOperationType.UPDATE,\\\\n      source: DataSourceType.REMOTE,\\\\n      entity,\\\\n      entityId: data.id,\\\\n      data,\\\\n      timestamp: Date.now(),\\\\n      version: data.version || 1,\\\\n    };\\\\n\\\\n    eventBus.emit(\\\\'data:event\\\\', event);\\\\n  }\\\\n\\\\n  private handleDataDelete(entity: string, data: any): void {\\\\n    const event: DataEvent = {\\\\n      id: `${entity}_${data.id}_${Date.now()}`,\\\\n      type: DataOperationType.DELETE,\\\\n      source: DataSourceType.REMOTE,\\\\n      entity,\\\\n      entityId: data.id,\\\\n      data,\\\\n      timestamp: Date.now(),\\\\n      version: data.version || 1,\\\\n    };\\\\n\\\\n    eventBus.emit(\\\\'data:event\\\\', event);\\\\n  }\\\\n\\\\n  async create<T>(entity: string, data: T): Promise<T> {\\\\n    const config = this.syncConfigs.get(entity);\\\\n    if (!config) throw new Error(`未找到实体 ${entity} 的同步配置`);\\\\n\\\\n    this.syncStates.set(entity, SyncState.SYNCING);\\\\n\\\\n    try {\\\\n      const response = await fetch(config.endpoint, {\\\\n        method: \\\\'POST\\\\',\\\\n        headers: {\\\\n          \\\\'Content-Type\\\\': \\\\'application/json\\\\',\\\\n        },\\\\n        body: JSON.stringify(data),\\\\n      });\\\\n\\\\n      const result = await response.json();\\\\n\\\\n      if (result.success) {\\\\n        this.syncStates.set(entity, SyncState.SUCCESS);\\\\n\\\\n        const event: DataEvent = {\\\\n          id: `${entity}_${result.data.id}_${Date.now()}`,\\\\n          type: DataOperationType.CREATE,\\\\n          source: DataSourceType.REMOTE,\\\\n          entity,\\\\n          entityId: result.data.id,\\\\n          data: result.data,\\\\n          timestamp: Date.now(),\\\\n          version: result.data.version || 1,\\\\n        };\\\\n\\\\n        eventBus.emit(\\\\'data:event\\\\', event);\\\\n        eventBus.emit(`data:${entity}:created`, result.data);\\\\n\\\\n        return result.data;\\\\n      } else {\\\\n        throw new Error(result.error?.message || \\\\'创建失败\\\\');\\\\n      }\\\\n    } catch (error) {\\\\n      this.syncStates.set(entity, SyncState.ERROR);\\\\n\\\\n      if (config.offlineSupport) {\\\\n        offlineQueueManager.add({\\\\n          operation: DataOperationType.CREATE,\\\\n          entity,\\\\n          entityId: (data as any).id || \\\\'pending\\\\',\\\\n          data,\\\\n          maxRetries: 3,\\\\n        });\\\\n\\\\n        this.syncStates.set(entity, SyncState.OFFLINE);\\\\n      }\\\\n\\\\n      throw error;\\\\n    }\\\\n  }\\\\n\\\\n  async update<T>(entity: string, entityId: string, data: Partial<T>): Promise<T> {\\\\n    const config = this.syncConfigs.get(entity);\\\\n    if (!config) throw new Error(`未找到实体 ${entity} 的同步配置`);\\\\n\\\\n    this.syncStates.set(entity, SyncState.SYNCING);\\\\n\\\\n    try {\\\\n      const response = await fetch(`${config.endpoint}/${entityId}`, {\\\\n        method: \\\\'PUT\\\\',\\\\n        headers: {\\\\n          \\\\'Content-Type\\\\': \\\\'application/json\\\\',\\\\n        },\\\\n        body: JSON.stringify(data),\\\\n      });\\\\n\\\\n      const result = await response.json();\\\\n\\\\n      if (result.success) {\\\\n        this.syncStates.set(entity, SyncState.SUCCESS);\\\\n\\\\n        const event: DataEvent = {\\\\n          id: `${entity}_${entityId}_${Date.now()}`,\\\\n          type: DataOperationType.UPDATE,\\\\n          source: DataSourceType.REMOTE,\\\\n          entity,\\\\n          entityId,\\\\n          data: result.data,\\\\n          timestamp: Date.now(),\\\\n          version: result.data.version || 1,\\\\n        };\\\\n\\\\n        eventBus.emit(\\\\'data:event\\\\', event);\\\\n        eventBus.emit(`data:${entity}:updated`, result.data);\\\\n\\\\n        return result.data;\\\\n      } else {\\\\n        throw new Error(result.error?.message || \\\\'更新失败\\\\');\\\\n      }\\\\n    } catch (error) {\\\\n      this.syncStates.set(entity, SyncState.ERROR);\\\\n\\\\n      if (config.offlineSupport) {\\\\n        offlineQueueManager.add({\\\\n          operation: DataOperationType.UPDATE,\\\\n          entity,\\\\n          entityId,\\\\n          data,\\\\n          maxRetries: 3,\\\\n        });\\\\n\\\\n        this.syncStates.set(entity, SyncState.OFFLINE);\\\\n      }\\\\n\\\\n      throw error;\\\\n    }\\\\n  }\\\\n\\\\n  async delete(entity: string, entityId: string): Promise<void> {\\\\n    const config = this.syncConfigs.get(entity);\\\\n    if (!config) throw new Error(`未找到实体 ${entity} 的同步配置`);\\\\n\\\\n    this.syncStates.set(entity, SyncState.SYNCING);\\\\n\\\\n    try {\\\\n      const response = await fetch(`${config.endpoint}/${entityId}`, {\\\\n        method: \\\\'DELETE\\\\',\\\\n      });\\\\n\\\\n      const result = await response.json();\\\\n\\\\n      if (result.success) {\\\\n        this.syncStates.set(entity, SyncState.SUCCESS);\\\\n\\\\n        const event: DataEvent = {\\\\n          id: `${entity}_${entityId}_${Date.now()}`,\\\\n          type: DataOperationType.DELETE,\\\\n          source: DataSourceType.REMOTE,\\\\n          entity,\\\\n          entityId,\\\\n          data: { id: entityId },\\\\n          timestamp: Date.now(),\\\\n          version: 1,\\\\n        };\\\\n\\\\n        eventBus.emit(\\\\'data:event\\\\', event);\\\\n        eventBus.emit(`data:${entity}:deleted`, { id: entityId });\\\\n      } else {\\\\n        throw new Error(result.error?.message || \\\\'删除失败\\\\');\\\\n      }\\\\n    } catch (error) {\\\\n      this.syncStates.set(entity, SyncState.ERROR);\\\\n\\\\n      if (config.offlineSupport) {\\\\n        offlineQueueManager.add({\\\\n          operation: DataOperationType.DELETE,\\\\n          entity,\\\\n          entityId,\\\\n          data: { id: entityId },\\\\n          maxRetries: 3,\\\\n        });\\\\n\\\\n        this.syncStates.set(entity, SyncState.OFFLINE);\\\\n      }\\\\n\\\\n      throw error;\\\\n    }\\\\n  }\\\\n\\\\n  getSyncState(entity: string): SyncState {\\\\n    return this.syncStates.get(entity) || SyncState.IDLE;\\\\n  }\\\\n\\\\n  async syncOfflineQueue(): Promise<void> {\\\\n    const operations = offlineQueueManager.getAll();\\\\n\\\\n    for (const operation of operations) {\\\\n      try {\\\\n        switch (operation.operation) {\\\\n          case DataOperationType.CREATE:\\\\n            await this.create(operation.entity, operation.data);\\\\n            break;\\\\n          case DataOperationType.UPDATE:\\\\n            await this.update(operation.entity, operation.entityId, operation.data);\\\\n            break;\\\\n          case DataOperationType.DELETE:\\\\n            await this.delete(operation.entity, operation.entityId);\\\\n            break;\\\\n        }\\\\n\\\\n        offlineQueueManager.remove(operation.id);\\\\n      } catch (error) {\\\\n        console.error(`同步离线操作失败 [${operation.id}]:`, error);\\\\n        operation.retryCount++;\\\\n\\\\n        if (operation.retryCount >= operation.maxRetries) {\\\\n          offlineQueueManager.remove(operation.id);\\\\n        }\\\\n      }\\\\n    }\\\\n  }\\\\n}\\\\n\\\\n/**\\\\n * 创建全局跨维度数据交互管理器实例\\\\n */\\\\nexport const crossDimensionDataManager = new CrossDimensionDataManager();\\\\n\\\\n/**\\\\n * React Hook - 使用数据事件\\\\n */\\\\nexport function useDataEvent<T = any>(\\\\n  entity: string,\\\\n  eventType: DataOperationType\\\\n) {\\\\n  const [data, setData] = useState<T | null>(null);\\\\n\\\\n  useEffect(() => {\\\\n    const handler = (eventData: T) => {\\\\n      setData(eventData);\\\\n    };\\\\n\\\\n    const eventName = `data:${entity}:${eventType}`;\\\\n    eventBus.on(eventName, handler);\\\\n\\\\n    return () => {\\\\n      eventBus.off(eventName, handler);\\\\n    };\\\\n  }, [entity, eventType]);\\\\n\\\\n  return data;\\\\n}\\\\n\\\\n/**\\\\n * React Hook - 使用同步状态\\\\n */\\\\nexport function useSyncState(entity: string) {\\\\n  const [syncState, setSyncState] = useState<SyncState>(SyncState.IDLE);\\\\n\\\\n  useEffect(() => {\\\\n    const updateState = () => {\\\\n      setSyncState(crossDimensionDataManager.getSyncState(entity));\\\\n    };\\\\n\\\\n    eventBus.on(\\\\'sync:started\\\\', updateState);\\\\n    eventBus.on(\\\\'sync:completed\\\\', updateState);\\\\n    eventBus.on(\\\\'sync:error\\\\', updateState);\\\\n\\\\n    return () => {\\\\n      eventBus.off(\\\\'sync:started\\\\', updateState);\\\\n      eventBus.off(\\\\'sync:completed\\\\', updateState);\\\\n      eventBus.off(\\\\'sync:error\\\\', updateState);\\\\n    };\\\\n  }, [entity]);\\\\n\\\\n  return syncState;\\\\n}\\\\n\\\\n/**\\\\n * React Hook - 使用离线队列\\\\n */\\\\nexport function useOfflineQueue() {\\\\n  const [operations, setOperations] = useState<OfflineOperation[]>([]);\\\\n\\\\n  useEffect(() => {\\\\n    const updateOperations = () => {\\\\n      setOperations(offlineQueueManager.getAll());\\\\n    };\\\\n\\\\n    eventBus.on(\\\\'offline:operation:added\\\\', updateOperations);\\\\n    eventBus.on(\\\\'offline:operation:removed\\\\', updateOperations);\\\\n    eventBus.on(\\\\'offline:queue:cleared\\\\', updateOperations);\\\\n\\\\n    updateOperations();\\\\n\\\\n    return () => {\\\\n      eventBus.off(\\\\'offline:operation:added\\\\', updateOperations);\\\\n      eventBus.off(\\\\'offline:operation:removed\\\\', updateOperations);\\\\n      eventBus.off(\\\\'offline:queue:cleared\\\\', updateOperations);\\\\n    };\\\\n  }, []);\\\\n\\\\n  const syncQueue = useCallback(async () => {\\\\n    await crossDimensionDataManager.syncOfflineQueue();\\\\n  }, []);\\\\n\\\\n  return {\\\\n    operations,\\\\n    size: operations.length,\\\\n    syncQueue,\\\\n  };\\\\n}\\\\n\\\\n/**\\\\n * 导出所有跨维度数据交互功能\\\\n */\\\\nexport default {\\\\n  eventBus,\\\\n  offlineQueueManager,\\\\n  dataConflictResolver,\\\\n  realtimeSyncManager,\\\\n  crossDimensionDataManager,\\\\n  useDataEvent,\\\\n  useSyncState,\\\\n  useOfflineQueue,\\\\n  DataOperationType,\\\\n  SyncState,\\\\n  DataSourceType,\\\\n};\\\\n\",\"originAcceptText\":\"/**\\n * @file 跨维度数据交互与状态同步机制\\n * @description 实现多端数据同步、实时更新、离线处理的完整同步机制\\n * @module integration\\n * @author YYC³\\n * @version 1.0.0\\n * @created 2026-01-21\\n */\\n\\nimport { EventEmitter } from 'events';\\n\\n/**\\n * 数据操作类型\\n */\\nexport enum DataOperationType {\\n  CREATE = 'create',\\n  UPDATE = 'update',\\n  DELETE = 'delete',\\n  SYNC = 'sync',\\n}\\n\\n/**\\n * 数据同步状态\\n */\\nexport enum SyncState {\\n  IDLE = 'idle',\\n  SYNCING = 'syncing',\\n  SUCCESS = 'success',\\n  ERROR = 'error',\\n  CONFLICT = 'conflict',\\n  OFFLINE = 'offline',\\n}\\n\\n/**\\n * 数据源类型\\n */\\nexport enum DataSourceType {\\n  LOCAL = 'local',\\n  REMOTE = 'remote',\\n  CACHE = 'cache',\\n  OFFLINE_QUEUE = 'offline_queue',\\n}\\n\\n/**\\n * 数据事件接口\\n */\\nexport interface DataEvent<T = any> {\\n  id: string;\\n  type: DataOperationType;\\n  source: DataSourceType;\\n  entity: string;\\n  entityId: string;\\n  data: T;\\n  timestamp: number;\\n  version: number;\\n  userId?: string;\\n  deviceId?: string;\\n}\\n\\n/**\\n * 数据同步配置接口\\n */\\nexport interface DataSyncConfig {\\n  entity: string;\\n  endpoint: string;\\n  syncInterval?: number;\\n  autoSync?: boolean;\\n  conflictResolution?: 'local' | 'remote' | 'merge' | 'manual';\\n  offlineSupport?: boolean;\\n  realTime?: boolean;\\n}\\n\\n/**\\n * 离线操作接口\\n */\\nexport interface OfflineOperation {\\n  id: string;\\n  operation: DataOperationType;\\n  entity: string;\\n  entityId: string;\\n  data: any;\\n  timestamp: number;\\n  retryCount: number;\\n  maxRetries: number;\\n}\\n\\n/**\\n * 数据冲突接口\\n */\\nexport interface DataConflict {\\n  id: string;\\n  entity: string;\\n  entityId: string;\\n  localData: any;\\n  remoteData: any;\\n  timestamp: number;\\n  resolved: boolean;\\n}\\n\\n/**\\n * 事件总线\\n */\\nexport class EventBus extends EventEmitter {\\n  private static instance: EventBus;\\n\\n  static getInstance(): EventBus {\\n    if (!EventBus.instance) {\\n      EventBus.instance = new EventBus();\\n    }\\n    return EventBus.instance;\\n  }\\n\\n  emit<T>(event: string, data: T): boolean {\\n    return super.emit(event, data);\\n  }\\n\\n  on<T>(event: string, listener: (data: T) => void): this {\\n    return super.on(event, listener);\\n  }\\n\\n  off<T>(event: string, listener: (data: T) => void): this {\\n    return super.off(event, listener);\\n  }\\n\\n  once<T>(event: string, listener: (data: T) => void): this {\\n    return super.once(event, listener);\\n  }\\n}\\n\\n/**\\n * 创建全局事件总线实例\\n */\\nexport const eventBus = EventBus.getInstance();\\n\\n/**\\n * 离线队列管理器\\n */\\nexport class OfflineQueueManager {\\n  private queue: Map<string, OfflineOperation> = new Map();\\n  private storageKey: string = 'yyc3_offline_queue';\\n\\n  constructor() {\\n    this.loadFromStorage();\\n  }\\n\\n  private loadFromStorage(): void {\\n    try {\\n      const stored = localStorage.getItem(this.storageKey);\\n      if (stored) {\\n        const operations: OfflineOperation[] = JSON.parse(stored);\\n        operations.forEach(op => {\\n          this.queue.set(op.id, op);\\n        });\\n      }\\n    } catch (error) {\\n      console.error('加载离线队列失败:', error);\\n    }\\n  }\\n\\n  private saveToStorage(): void {\\n    try {\\n      const operations = Array.from(this.queue.values());\\n      localStorage.setItem(this.storageKey, JSON.stringify(operations));\\n    } catch (error) {\\n      console.error('保存离线队列失败:', error);\\n    }\\n  }\\n\\n  add(operation: Omit<OfflineOperation, 'id' | 'timestamp' | 'retryCount'>): string {\\n    const id = `${operation.entity}_${operation.entityId}_${Date.now()}`;\\n    const offlineOperation: OfflineOperation = {\\n      id,\\n      ...operation,\\n      timestamp: Date.now(),\\n      retryCount: 0,\\n    };\\n\\n    this.queue.set(id, offlineOperation);\\n    this.saveToStorage();\\n\\n    eventBus.emit('offline:operation:added', offlineOperation);\\n\\n    return id;\\n  }\\n\\n  remove(id: string): void {\\n    this.queue.delete(id);\\n    this.saveToStorage();\\n\\n    eventBus.emit('offline:operation:removed', id);\\n  }\\n\\n  get(id: string): OfflineOperation | undefined {\\n    return this.queue.get(id);\\n  }\\n\\n  getAll(): OfflineOperation[] {\\n    return Array.from(this.queue.values());\\n  }\\n\\n  getByEntity(entity: string): OfflineOperation[] {\\n    return Array.from(this.queue.values()).filter(op => op.entity === entity);\\n  }\\n\\n  clear(): void {\\n    this.queue.clear();\\n    this.saveToStorage();\\n\\n    eventBus.emit('offline:queue:cleared');\\n  }\\n\\n  size(): number {\\n    return this.queue.size;\\n  }\\n}\\n\\n/**\\n * 创建全局离线队列管理器实例\\n */\\nexport const offlineQueueManager = new OfflineQueueManager();\\n\\n/**\\n * 数据冲突解决器\\n */\\nexport class DataConflictResolver {\\n  private conflicts: Map<string, DataConflict> = new Map();\\n\\n  detectConflict(localData: any, remoteData: any): boolean {\\n    const localVersion = localData.version || 0;\\n    const remoteVersion = remoteData.version || 0;\\n\\n    return localVersion !== remoteVersion;\\n  }\\n\\n  createConflict(entity: string, entityId: string, localData: any, remoteData: any): DataConflict {\\n    const conflict: DataConflict = {\\n      id: `${entity}_${entityId}_${Date.now()}`,\\n      entity,\\n      entityId,\\n      localData,\\n      remoteData,\\n      timestamp: Date.now(),\\n      resolved: false,\\n    };\\n\\n    this.conflicts.set(conflict.id, conflict);\\n\\n    eventBus.emit('conflict:detected', conflict);\\n\\n    return conflict;\\n  }\\n\\n  resolveConflict(conflictId: string, resolution: 'local' | 'remote' | 'merge', mergedData?: any): void {\\n    const conflict = this.conflicts.get(conflictId);\\n    if (!conflict) return;\\n\\n    conflict.resolved = true;\\n\\n    eventBus.emit('conflict:resolved', {\\n      conflict,\\n      resolution,\\n      mergedData,\\n    });\\n\\n    this.conflicts.delete(conflictId);\\n  }\\n\\n  getConflicts(): DataConflict[] {\\n    return Array.from(this.conflicts.values());\\n  }\\n\\n  getConflictsByEntity(entity: string): DataConflict[] {\\n    return Array.from(this.conflicts.values()).filter(c => c.entity === entity);\\n  }\\n}\\n\\n/**\\n * 创建全局数据冲突解决器实例\\n */\\nexport const dataConflictResolver = new DataConflictResolver();\\n\\n/**\\n * 实时数据同步管理器\\n */\\nexport class RealtimeSyncManager {\\n  private wsConnections: Map<string, WebSocket> = new Map();\\n  private reconnectIntervals: Map<string, NodeJS.Timeout> = new Map();\\n  private syncConfigs: Map<string, DataSyncConfig> = new Map();\\n\\n  register(config: DataSyncConfig): void {\\n    this.syncConfigs.set(config.entity, config);\\n\\n    if (config.realTime) {\\n      this.connectWebSocket(config);\\n    }\\n\\n    if (config.autoSync && config.syncInterval) {\\n      this.startAutoSync(config);\\n    }\\n  }\\n\\n  unregister(entity: string): void {\\n    const config = this.syncConfigs.get(entity);\\n    if (!config) return;\\n\\n    if (this.wsConnections.has(entity)) {\\n      this.wsConnections.get(entity)!.close();\\n      this.wsConnections.delete(entity);\\n    }\\n\\n    if (this.reconnectIntervals.has(entity)) {\\n      clearInterval(this.reconnectIntervals.get(entity)!);\\n      this.reconnectIntervals.delete(entity);\\n    }\\n\\n    this.syncConfigs.delete(entity);\\n  }\\n\\n  private connectWebSocket(config: DataSyncConfig): void {\\n    const wsUrl = config.endpoint.replace('http', 'ws');\\n\\n    const ws = new WebSocket(wsUrl);\\n\\n    ws.onopen = () => {\\n      console.log(`WebSocket连接已建立 [${config.entity}]`);\\n      eventBus.emit('sync:connected', { entity: config.entity });\\n    };\\n\\n    ws.onmessage = (event) => {\\n      try {\\n        const message = JSON.parse(event.data);\\n        this.handleWebSocketMessage(config.entity, message);\\n      } catch (error) {\\n        console.error('解析WebSocket消息失败:', error);\\n      }\\n    };\\n\\n    ws.onerror = (error) => {\\n      console.error(`WebSocket错误 [${config.entity}]:`, error);\\n      eventBus.emit('sync:error', { entity: config.entity, error });\\n    };\\n\\n    ws.onclose = () => {\\n      console.log(`WebSocket连接已关闭 [${config.entity}]`);\\n      eventBus.emit('sync:disconnected', { entity: config.entity });\\n\\n      if (this.syncConfigs.has(config.entity)) {\\n        this.scheduleReconnect(config);\\n      }\\n    };\\n\\n    this.wsConnections.set(config.entity, ws);\\n  }\\n\\n  private scheduleReconnect(config: DataSyncConfig): void {\\n    const interval = setInterval(() => {\\n      this.connectWebSocket(config);\\n    }, 5000);\\n\\n    this.reconnectIntervals.set(config.entity, interval);\\n  }\\n\\n  private handleWebSocketMessage(entity: string, message: any): void {\\n    switch (message.type) {\\n      case 'create':\\n        eventBus.emit(`data:${entity}:created`, message.data);\\n        break;\\n      case 'update':\\n        eventBus.emit(`data:${entity}:updated`, message.data);\\n        break;\\n      case 'delete':\\n        eventBus.emit(`data:${entity}:deleted`, message.data);\\n        break;\\n      case 'sync':\\n        eventBus.emit(`data:${entity}:synced`, message.data);\\n        break;\\n      default:\\n        console.warn(`未知的WebSocket消息类型: ${message.type}`);\\n    }\\n  }\\n\\n  private startAutoSync(config: DataSyncConfig): void {\\n    const interval = setInterval(() => {\\n      this.sync(config.entity);\\n    }, config.syncInterval!);\\n\\n    this.reconnectIntervals.set(`${config.entity}_auto`, interval);\\n  }\\n\\n  async sync(entity: string): Promise<void> {\\n    const config = this.syncConfigs.get(entity);\\n    if (!config) return;\\n\\n    eventBus.emit('sync:started', { entity });\\n\\n    try {\\n      const response = await fetch(config.endpoint);\\n      const data = await response.json();\\n\\n      if (data.success) {\\n        eventBus.emit(`data:${entity}:synced`, data.data);\\n        eventBus.emit('sync:completed', { entity, data: data.data });\\n      }\\n    } catch (error) {\\n      console.error(`同步失败 [${entity}]:`, error);\\n      eventBus.emit('sync:error', { entity, error });\\n    }\\n  }\\n\\n  isConnected(entity: string): boolean {\\n    const ws = this.wsConnections.get(entity);\\n    return ws ? ws.readyState === WebSocket.OPEN : false;\\n  }\\n}\\n\\n/**\\n * 创建全局实时数据同步管理器实例\\n */\\nexport const realtimeSyncManager = new RealtimeSyncManager();\\n\\n/**\\n * 跨维度数据交互管理器\\n */\\nexport class CrossDimensionDataManager {\\n  private syncConfigs: Map<string, DataSyncConfig> = new Map();\\n  private syncStates: Map<string, SyncState> = new Map();\\n\\n  register(config: DataSyncConfig): void {\\n    this.syncConfigs.set(config.entity, config);\\n    this.syncStates.set(config.entity, SyncState.IDLE);\\n\\n    realtimeSyncManager.register(config);\\n\\n    eventBus.on(`data:${config.entity}:updated`, (data) => {\\n      this.handleDataUpdate(config.entity, data);\\n    });\\n\\n    eventBus.on(`data:${config.entity}:deleted`, (data) => {\\n      this.handleDataDelete(config.entity, data);\\n    });\\n  }\\n\\n  unregister(entity: string): void {\\n    this.syncConfigs.delete(entity);\\n    this.syncStates.delete(entity);\\n    realtimeSyncManager.unregister(entity);\\n  }\\n\\n  private handleDataUpdate(entity: string, data: any): void {\\n    const config = this.syncConfigs.get(entity);\\n    if (!config) return;\\n\\n    const event: DataEvent = {\\n      id: `${entity}_${data.id}_${Date.now()}`,\\n      type: DataOperationType.UPDATE,\\n      source: DataSourceType.REMOTE,\\n      entity,\\n      entityId: data.id,\\n      data,\\n      timestamp: Date.now(),\\n      version: data.version || 1,\\n    };\\n\\n    eventBus.emit('data:event', event);\\n  }\\n\\n  private handleDataDelete(entity: string, data: any): void {\\n    const event: DataEvent = {\\n      id: `${entity}_${data.id}_${Date.now()}`,\\n      type: DataOperationType.DELETE,\\n      source: DataSourceType.REMOTE,\\n      entity,\\n      entityId: data.id,\\n      data,\\n      timestamp: Date.now(),\\n      version: data.version || 1,\\n    };\\n\\n    eventBus.emit('data:event', event);\\n  }\\n\\n  async create<T>(entity: string, data: T): Promise<T> {\\n    const config = this.syncConfigs.get(entity);\\n    if (!config) throw new Error(`未找到实体 ${entity} 的同步配置`);\\n\\n    this.syncStates.set(entity, SyncState.SYNCING);\\n\\n    try {\\n      const response = await fetch(config.endpoint, {\\n        method: 'POST',\\n        headers: {\\n          'Content-Type': 'application/json',\\n        },\\n        body: JSON.stringify(data),\\n      });\\n\\n      const result = await response.json();\\n\\n      if (result.success) {\\n        this.syncStates.set(entity, SyncState.SUCCESS);\\n\\n        const event: DataEvent = {\\n          id: `${entity}_${result.data.id}_${Date.now()}`,\\n          type: DataOperationType.CREATE,\\n          source: DataSourceType.REMOTE,\\n          entity,\\n          entityId: result.data.id,\\n          data: result.data,\\n          timestamp: Date.now(),\\n          version: result.data.version || 1,\\n        };\\n\\n        eventBus.emit('data:event', event);\\n        eventBus.emit(`data:${entity}:created`, result.data);\\n\\n        return result.data;\\n      } else {\\n        throw new Error(result.error?.message || '创建失败');\\n      }\\n    } catch (error) {\\n      this.syncStates.set(entity, SyncState.ERROR);\\n\\n      if (config.offlineSupport) {\\n        offlineQueueManager.add({\\n          operation: DataOperationType.CREATE,\\n          entity,\\n          entityId: (data as any).id || 'pending',\\n          data,\\n          maxRetries: 3,\\n        });\\n\\n        this.syncStates.set(entity, SyncState.OFFLINE);\\n      }\\n\\n      throw error;\\n    }\\n  }\\n\\n  async update<T>(entity: string, entityId: string, data: Partial<T>): Promise<T> {\\n    const config = this.syncConfigs.get(entity);\\n    if (!config) throw new Error(`未找到实体 ${entity} 的同步配置`);\\n\\n    this.syncStates.set(entity, SyncState.SYNCING);\\n\\n    try {\\n      const response = await fetch(`${config.endpoint}/${entityId}`, {\\n        method: 'PUT',\\n        headers: {\\n          'Content-Type': 'application/json',\\n        },\\n        body: JSON.stringify(data),\\n      });\\n\\n      const result = await response.json();\\n\\n      if (result.success) {\\n        this.syncStates.set(entity, SyncState.SUCCESS);\\n\\n        const event: DataEvent = {\\n          id: `${entity}_${entityId}_${Date.now()}`,\\n          type: DataOperationType.UPDATE,\\n          source: DataSourceType.REMOTE,\\n          entity,\\n          entityId,\\n          data: result.data,\\n          timestamp: Date.now(),\\n          version: result.data.version || 1,\\n        };\\n\\n        eventBus.emit('data:event', event);\\n        eventBus.emit(`data:${entity}:updated`, result.data);\\n\\n        return result.data;\\n      } else {\\n        throw new Error(result.error?.message || '更新失败');\\n      }\\n    } catch (error) {\\n      this.syncStates.set(entity, SyncState.ERROR);\\n\\n      if (config.offlineSupport) {\\n        offlineQueueManager.add({\\n          operation: DataOperationType.UPDATE,\\n          entity,\\n          entityId,\\n          data,\\n          maxRetries: 3,\\n        });\\n\\n        this.syncStates.set(entity, SyncState.OFFLINE);\\n      }\\n\\n      throw error;\\n    }\\n  }\\n\\n  async delete(entity: string, entityId: string): Promise<void> {\\n    const config = this.syncConfigs.get(entity);\\n    if (!config) throw new Error(`未找到实体 ${entity} 的同步配置`);\\n\\n    this.syncStates.set(entity, SyncState.SYNCING);\\n\\n    try {\\n      const response = await fetch(`${config.endpoint}/${entityId}`, {\\n        method: 'DELETE',\\n      });\\n\\n      const result = await response.json();\\n\\n      if (result.success) {\\n        this.syncStates.set(entity, SyncState.SUCCESS);\\n\\n        const event: DataEvent = {\\n          id: `${entity}_${entityId}_${Date.now()}`,\\n          type: DataOperationType.DELETE,\\n          source: DataSourceType.REMOTE,\\n          entity,\\n          entityId,\\n          data: { id: entityId },\\n          timestamp: Date.now(),\\n          version: 1,\\n        };\\n\\n        eventBus.emit('data:event', event);\\n        eventBus.emit(`data:${entity}:deleted`, { id: entityId });\\n      } else {\\n        throw new Error(result.error?.message || '删除失败');\\n      }\\n    } catch (error) {\\n      this.syncStates.set(entity, SyncState.ERROR);\\n\\n      if (config.offlineSupport) {\\n        offlineQueueManager.add({\\n          operation: DataOperationType.DELETE,\\n          entity,\\n          entityId,\\n          data: { id: entityId },\\n          maxRetries: 3,\\n        });\\n\\n        this.syncStates.set(entity, SyncState.OFFLINE);\\n      }\\n\\n      throw error;\\n    }\\n  }\\n\\n  getSyncState(entity: string): SyncState {\\n    return this.syncStates.get(entity) || SyncState.IDLE;\\n  }\\n\\n  async syncOfflineQueue(): Promise<void> {\\n    const operations = offlineQueueManager.getAll();\\n\\n    for (const operation of operations) {\\n      try {\\n        switch (operation.operation) {\\n          case DataOperationType.CREATE:\\n            await this.create(operation.entity, operation.data);\\n            break;\\n          case DataOperationType.UPDATE:\\n            await this.update(operation.entity, operation.entityId, operation.data);\\n            break;\\n          case DataOperationType.DELETE:\\n            await this.delete(operation.entity, operation.entityId);\\n            break;\\n        }\\n\\n        offlineQueueManager.remove(operation.id);\\n      } catch (error) {\\n        console.error(`同步离线操作失败 [${operation.id}]:`, error);\\n        operation.retryCount++;\\n\\n        if (operation.retryCount >= operation.maxRetries) {\\n          offlineQueueManager.remove(operation.id);\\n        }\\n      }\\n    }\\n  }\\n}\\n\\n/**\\n * 创建全局跨维度数据交互管理器实例\\n */\\nexport const crossDimensionDataManager = new CrossDimensionDataManager();\\n\\n/**\\n * React Hook - 使用数据事件\\n */\\nexport function useDataEvent<T = any>(\\n  entity: string,\\n  eventType: DataOperationType\\n) {\\n  const [data, setData] = useState<T | null>(null);\\n\\n  useEffect(() => {\\n    const handler = (eventData: T) => {\\n      setData(eventData);\\n    };\\n\\n    const eventName = `data:${entity}:${eventType}`;\\n    eventBus.on(eventName, handler);\\n\\n    return () => {\\n      eventBus.off(eventName, handler);\\n    };\\n  }, [entity, eventType]);\\n\\n  return data;\\n}\\n\\n/**\\n * React Hook - 使用同步状态\\n */\\nexport function useSyncState(entity: string) {\\n  const [syncState, setSyncState] = useState<SyncState>(SyncState.IDLE);\\n\\n  useEffect(() => {\\n    const updateState = () => {\\n      setSyncState(crossDimensionDataManager.getSyncState(entity));\\n    };\\n\\n    eventBus.on('sync:started', updateState);\\n    eventBus.on('sync:completed', updateState);\\n    eventBus.on('sync:error', updateState);\\n\\n    return () => {\\n      eventBus.off('sync:started', updateState);\\n      eventBus.off('sync:completed', updateState);\\n      eventBus.off('sync:error', updateState);\\n    };\\n  }, [entity]);\\n\\n  return syncState;\\n}\\n\\n/**\\n * React Hook - 使用离线队列\\n */\\nexport function useOfflineQueue() {\\n  const [operations, setOperations] = useState<OfflineOperation[]>([]);\\n\\n  useEffect(() => {\\n    const updateOperations = () => {\\n      setOperations(offlineQueueManager.getAll());\\n    };\\n\\n    eventBus.on('offline:operation:added', updateOperations);\\n    eventBus.on('offline:operation:removed', updateOperations);\\n    eventBus.on('offline:queue:cleared', updateOperations);\\n\\n    updateOperations();\\n\\n    return () => {\\n      eventBus.off('offline:operation:added', updateOperations);\\n      eventBus.off('offline:operation:removed', updateOperations);\\n      eventBus.off('offline:queue:cleared', updateOperations);\\n    };\\n  }, []);\\n\\n  const syncQueue = useCallback(async () => {\\n    await crossDimensionDataManager.syncOfflineQueue();\\n  }, []);\\n\\n  return {\\n    operations,\\n    size: operations.length,\\n    syncQueue,\\n  };\\n}\\n\\n/**\\n * 导出所有跨维度数据交互功能\\n */\\nexport default {\\n  eventBus,\\n  offlineQueueManager,\\n  dataConflictResolver,\\n  realtimeSyncManager,\\n  crossDimensionDataManager,\\n  useDataEvent,\\n  useSyncState,\\n  useOfflineQueue,\\n  DataOperationType,\\n  SyncState,\\n  DataSourceType,\\n};\\n\",\"originTextLength\":18981,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768983062072}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/docs/YYC3-CP-%E6%9E%B6%E6%9E%84%E8%AE%BE%E8%AE%A1/YYC3-%E7%B3%BB%E7%BB%9F%E9%9B%86%E6%88%90%E6%9E%B6%E6%9E%84%E6%96%87%E6%A1%A3.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":710,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":710,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# YYC³餐饮行业智能化平台 - 系统集成架构文档\\\\n\\\\n## 文档信息\\\\n\\\\n| 项目 | 内容 |\\\\n|-----|------|\\\\n| 文档编号 | YYC3-AICP-SIA-001 |\\\\n| 文档名称 | 系统集成架构文档 |\\\\n| 版本号 | v1.0.0 |\\\\n| 创建日期 | 2026-01-21 |\\\\n| 最后更新 | 2026-01-21 |\\\\n| 文档状态 | 正式发布 |\\\\n| 作者 | YYC³ |\\\\n\\\\n---\\\\n\\\\n## 1. 概述\\\\n\\\\n### 1.1 文档目的\\\\n\\\\n本文档详细描述YYC³餐饮行业智能化平台的系统集成架构，包括UI层与业务逻辑层的无缝对接、数据层与UI层的深度集成、多端适配策略、跨维度数据交互与状态同步机制等核心内容，确保整个系统在功能实现、用户体验和技术架构上形成有机整体。\\\\n\\\\n### 1.2 适用范围\\\\n\\\\n本文档适用于YYC³餐饮行业智能化平台的所有开发人员、架构师、项目经理、测试人员和运维人员。\\\\n\\\\n### 1.3 核心目标\\\\n\\\\n- **无缝对接**: 实现UI层与业务逻辑层的无缝对接，消除数据孤岛\\\\n- **深度集成**: 实现数据层与UI层的深度集成，提供统一的数据访问接口\\\\n- **多端适配**: 实现Web端、移动端、小程序等多终端的一致用户体验\\\\n- **实时同步**: 实现跨维度数据交互与状态同步，确保数据一致性\\\\n- **离线支持**: 实现离线数据处理和自动同步，提升用户体验\\\\n\\\\n---\\\\n\\\\n## 2. 系统整体架构\\\\n\\\\n### 2.1 架构分层\\\\n\\\\n```\\\\n┌─────────────────────────────────────────────────────────────────┐\\\\n│                        客户端层 (Client Layer)                    │\\\\n├─────────────────────────────────────────────────────────────────┤\\\\n│  Web浏览器      │  移动端H5      │  小程序      │  管理后台        │\\\\n│  (React 18)     │  (React 18)    │  (原生)       │  (React 18)      │\\\\n└─────────────────────────────────────────────────────────────────┘\\\\n                              │\\\\n                              ▼\\\\n                ┌─────────────────────────────────────────────────────────┐\\\\n                │                   UI集成层 (UI Integration Layer)            │\\\\n                ├─────────────────────────────────────────────────────────┤\\\\n                │  UI-Business Integration  │  Data Layer Integration   │\\\\n                │  Multi-Platform Adapter   │  Cross-Dimension Sync     │\\\\n                └─────────────────────────────────────────────────────────┘\\\\n                              │\\\\n                              ▼\\\\n                ┌─────────────────────────────────────────────────────────┐\\\\n                │                    业务逻辑层 (Business Layer)                  │\\\\n                ├─────────────────────────────────────────────────────────┤\\\\n                │  用户服务  │  菜单服务  │  订单服务  │  库存服务  │  财务服务  │\\\\n                │  营销服务  │  报表服务  │  消息服务  │  文件服务  │  支付服务  │\\\\n                └─────────────────────────────────────────────────────────┘\\\\n                              │\\\\n                              ▼\\\\n                ┌─────────────────────────────────────────────────────────┐\\\\n                │                    数据访问层 (Data Access Layer)            │\\\\n                ├─────────────────────────────────────────────────────────┤\\\\n                │  ORM层  │  缓存层  │  消息队列  │  数据同步                    │\\\\n                └─────────────────────────────────────────────────────────┘\\\\n                              │\\\\n                              ▼\\\\n                ┌─────────────────────────────────────────────────────────┐\\\\n                │                    数据存储层 (Data Storage Layer)            │\\\\n                ├─────────────────────────────────────────────────────────┤\\\\n                │  PostgreSQL  │  Redis  │  MinIO  │  Elasticsearch           │\\\\n                └─────────────────────────────────────────────────────────┘\\\\n```\\\\n\\\\n### 2.2 技术栈\\\\n\\\\n#### 前端技术栈\\\\n\\\\n- **核心框架**: React 18.3.1 + TypeScript 5.3+\\\\n- **构建工具**: Vite 5.0+\\\\n- **状态管理**: Zustand 4.4+ (轻量级状态管理)\\\\n- **UI组件库**: Tailwind CSS 4.1.12 + 自研YU组件库\\\\n- **数据获取**: React Query / SWR\\\\n- **实时通信**: WebSocket + Server-Sent Events\\\\n- **离线存储**: IndexedDB + LocalStorage + SessionStorage\\\\n\\\\n#### 后端技术栈\\\\n\\\\n- **核心框架**: Express.js / Nest.js\\\\n- **API网关**: Kong / Nginx\\\\n- **数据库**: PostgreSQL 15+ (多租户架构)\\\\n- **缓存**: Redis 7+\\\\n- **消息队列**: RabbitMQ / Kafka\\\\n- **搜索引擎**: Elasticsearch 8+\\\\n\\\\n---\\\\n\\\\n## 3. UI层与业务逻辑层无缝对接\\\\n\\\\n### 3.1 核心设计理念\\\\n\\\\nUI层与业务逻辑层的无缝对接基于以下核心设计理念：\\\\n\\\\n1. **统一API客户端**: 提供统一的API请求接口，封装所有HTTP请求逻辑\\\\n2. **React Hooks封装**: 提供易用的React Hooks，简化数据获取和状态管理\\\\n3. **业务服务层**: 封装业务逻辑，提供清晰的API接口\\\\n4. **错误处理**: 统一的错误处理机制，提供友好的错误提示\\\\n5. **请求重试**: 自动重试机制，提升系统稳定性\\\\n\\\\n### 3.2 API客户端\\\\n\\\\n#### 3.2.1 基础API客户端\\\\n\\\\n```typescript\\\\nimport { ApiClient } from \\\\'./lib/integration/ui-business-integration\\\\';\\\\n\\\\nconst apiClient = new ApiClient(\\\\'http://localhost:3000/api\\\\');\\\\n\\\\n// 设置认证令牌\\\\napiClient.setToken(\\\\'your-jwt-token\\\\');\\\\n\\\\n// 设置租户ID\\\\napiClient.setTenantId(\\\\'tenant-123\\\\');\\\\n\\\\n// 发送GET请求\\\\nconst response = await apiClient.get(\\\\'/orders\\\\');\\\\n\\\\n// 发送POST请求\\\\nconst response = await apiClient.post(\\\\'/orders\\\\', {\\\\n  customerId: \\\\'customer-123\\\\',\\\\n  items: [\\\\n    { productId: \\\\'product-1\\\\', quantity: 2 },\\\\n  ],\\\\n});\\\\n\\\\n// 发送PUT请求\\\\nconst response = await apiClient.put(\\\\'/orders/123\\\\', {\\\\n  status: \\\\'completed\\\\',\\\\n});\\\\n\\\\n// 发送DELETE请求\\\\nconst response = await apiClient.delete(\\\\'/orders/123\\\\');\\\\n```\\\\n\\\\n#### 3.2.2 React Hooks\\\\n\\\\n```typescript\\\\nimport { useApi, useApiMutation, usePaginatedApi } from \\\\'./lib/integration/ui-business-integration\\\\';\\\\n\\\\n// 使用API数据\\\\nfunction OrderList() {\\\\n  const { data, loading, error, refetch } = useApi(\\\\'/orders\\\\');\\\\n\\\\n  if (loading) return <div>加载中...</div>;\\\\n  if (error) return <div>加载失败: {error.message}</div>;\\\\n\\\\n  return (\\\\n    <div>\\\\n      {data?.map(order => (\\\\n        <div key={order.id}>{order.id}</div>\\\\n      ))}\\\\n      <button onClick={refetch}>刷新</button>\\\\n    </div>\\\\n  );\\\\n}\\\\n\\\\n// 使用API操作\\\\nfunction CreateOrder() {\\\\n  const { mutate, loading, error } = useApiMutation(\\\\'/orders\\\\', \\\\'POST\\\\');\\\\n\\\\n  const handleSubmit = async (orderData) => {\\\\n    const response = await mutate(orderData);\\\\n    if (response.success) {\\\\n      console.log(\\\\'订单创建成功\\\\');\\\\n    }\\\\n  };\\\\n\\\\n  return (\\\\n    <form onSubmit={handleSubmit}>\\\\n      <button disabled={loading} type=\\\\\\\"submit\\\\\\\">\\\\n        {loading ? \\\\'提交中...\\\\' : \\\\'创建订单\\\\'}\\\\n      </button>\\\\n    </form>\\\\n  );\\\\n}\\\\n\\\\n// 使用分页数据\\\\nfunction OrderListPaginated() {\\\\n  const {\\\\n    data,\\\\n    loading,\\\\n    error,\\\\n    page,\\\\n    total,\\\\n    hasMore,\\\\n    loadMore,\\\\n    refresh,\\\\n  } = usePaginatedApi(\\\\'/orders\\\\', 1, 20);\\\\n\\\\n  return (\\\\n    <div>\\\\n      {data?.map(order => (\\\\n        <div key={order.id}>{order.id}</div>\\\\n      ))}\\\\n      {hasMore && (\\\\n        <button onClick={loadMore} disabled={loading}>\\\\n          {loading ? \\\\'加载中...\\\\' : \\\\'加载更多\\\\'}\\\\n        </button>\\\\n      )}\\\\n      <button onClick={refresh}>刷新</button>\\\\n    </div>\\\\n  );\\\\n}\\\\n```\\\\n\\\\n#### 3.2.3 业务服务层\\\\n\\\\n```typescript\\\\nimport { orderService, menuService, userService } from \\\\'./lib/integration/ui-business-integration\\\\';\\\\n\\\\n// 订单服务\\\\nasync function fetchOrders() {\\\\n  const response = await orderService.getOrders({\\\\n    page: 1,\\\\n    pageSize: 20,\\\\n    status: \\\\'pending\\\\',\\\\n  });\\\\n\\\\n  if (response.success) {\\\\n    return response.data;\\\\n  }\\\\n}\\\\n\\\\nasync function createOrder(orderData) {\\\\n  const response = await orderService.createOrder(orderData);\\\\n\\\\n  if (response.success) {\\\\n    return response.data;\\\\n  }\\\\n}\\\\n\\\\n// 菜单服务\\\\nasync function fetchMenus() {\\\\n  const response = await menuService.getMenus({\\\\n    page: 1,\\\\n    pageSize: 20,\\\\n    category: \\\\'main\\\\',\\\\n  });\\\\n\\\\n  if (response.success) {\\\\n    return response.data;\\\\n  }\\\\n}\\\\n\\\\n// 用户服务\\\\nasync function login(email, password) {\\\\n  const response = await userService.login({ email, password });\\\\n\\\\n  if (response.success) {\\\\n    const { token, user } = response.data;\\\\n    apiClient.setToken(token);\\\\n    return user;\\\\n  }\\\\n}\\\\n```\\\\n\\\\n### 3.3 实时数据\\\\n\\\\n```typescript\\\\nimport { useRealtimeData } from \\\\'./lib/integration/ui-business-integration\\\\';\\\\n\\\\n// 使用实时数据\\\\nfunction RealtimeOrderList() {\\\\n  const { data, connected } = useRealtimeData(\\\\'ws://localhost:3000/orders\\\\');\\\\n\\\\n  return (\\\\n    <div>\\\\n      <div>连接状态: {connected ? \\\\'已连接\\\\' : \\\\'未连接\\\\'}</div>\\\\n      {data?.map(order => (\\\\n        <div key={order.id}>{order.id}</div>\\\\n      ))}\\\\n    </div>\\\\n  );\\\\n}\\\\n```\\\\n\\\\n### 3.4 乐观更新\\\\n\\\\n```typescript\\\\nimport { useOptimisticUpdate } from \\\\'./lib/integration/ui-business-integration\\\\';\\\\n\\\\n// 使用乐观更新\\\\nfunction OrderItem({ order }) {\\\\n  const { data, loading, error, update } = useOptimisticUpdate(\\\\n    order,\\\\n    (newData) => apiClient.put(`/orders/${order.id}`, newData)\\\\n  );\\\\n\\\\n  const handleStatusChange = async (newStatus) => {\\\\n    await update({ status: newStatus });\\\\n  };\\\\n\\\\n  return (\\\\n    <div>\\\\n      <span>订单状态: {data.status}</span>\\\\n      <button onClick={() => handleStatusChange(\\\\'completed\\\\')}>\\\\n        标记为完成\\\\n      </button>\\\\n    </div>\\\\n  );\\\\n}\\\\n```\\\\n\\\\n---\\\\n\\\\n## 4. 数据层与UI层深度集成\\\\n\\\\n### 4.1 核心设计理念\\\\n\\\\n数据层与UI层的深度集成基于以下核心设计理念：\\\\n\\\\n1. **多级缓存策略**: 支持内存、LocalStorage、IndexedDB等多种缓存策略\\\\n2. **统一状态管理**: 使用Zustand进行统一的状态管理\\\\n3. **实时数据同步**: 支持WebSocket实时数据推送\\\\n4. **离线数据支持**: 支持离线数据存储和自动同步\\\\n5. **数据版本控制**: 支持数据版本控制和冲突解决\\\\n\\\\n### 4.2 缓存管理\\\\n\\\\n#### 4.2.1 缓存策略\\\\n\\\\n```typescript\\\\nimport { cacheManager, CacheStrategy } from \\\\'./lib/integration/data-layer-integration\\\\';\\\\n\\\\n// 内存缓存\\\\nawait cacheManager.set(\\\\'user:123\\\\', userData, {\\\\n  key: \\\\'user:123\\\\',\\\\n  strategy: CacheStrategy.MEMORY,\\\\n  ttl: 3600000, // 1小时\\\\n  version: \\\\'1.0\\\\',\\\\n});\\\\n\\\\nconst cachedUser = await cacheManager.get(\\\\'user:123\\\\', CacheStrategy.MEMORY);\\\\n\\\\n// IndexedDB缓存\\\\nawait cacheManager.set(\\\\'orders:page:1\\\\', ordersData, {\\\\n  key: \\\\'orders:page:1\\\\',\\\\n  strategy: CacheStrategy.INDEXED_DB,\\\\n  ttl: 1800000, // 30分钟\\\\n  version: \\\\'1.0\\\\',\\\\n});\\\\n\\\\nconst cachedOrders = await cacheManager.get(\\\\'orders:page:1\\\\', CacheStrategy.INDEXED_DB);\\\\n\\\\n// LocalStorage缓存\\\\nawait cacheManager.set(\\\\'theme\\\\', \\\\'dark\\\\', {\\\\n  key: \\\\'theme\\\\',\\\\n  strategy: CacheStrategy.LOCAL_STORAGE,\\\\n  ttl: 86400000, // 24小时\\\\n  version: \\\\'1.0\\\\',\\\\n});\\\\n\\\\nconst cachedTheme = await cacheManager.get(\\\\'theme\\\\', CacheStrategy.LOCAL_STORAGE);\\\\n```\\\\n\\\\n#### 4.2.2 React Hooks\\\\n\\\\n```typescript\\\\nimport { useCachedData } from \\\\'./lib/integration/data-layer-integration\\\\';\\\\n\\\\n// 使用缓存数据\\\\nfunction UserProfile({ userId }) {\\\\n  const { data, loading, error, refresh, invalidate } = useCachedData(\\\\n    `user:${userId}`,\\\\n    () => fetchUser(userId),\\\\n    {\\\\n      key: `user:${userId}`,\\\\n      strategy: CacheStrategy.MEMORY,\\\\n      ttl: 3600000,\\\\n      version: \\\\'1.0\\\\',\\\\n    }\\\\n  );\\\\n\\\\n  return (\\\\n    <div>\\\\n      {loading && <div>加载中...</div>}\\\\n      {error && <div>加载失败: {error.message}</div>}\\\\n      {data && (\\\\n        <div>\\\\n          <h1>{data.name}</h1>\\\\n          <p>{data.email}</p>\\\\n          <button onClick={refresh}>刷新</button>\\\\n          <button onClick={invalidate}>清除缓存</button>\\\\n        </div>\\\\n      )}\\\\n    </div>\\\\n  );\\\\n}\\\\n```\\\\n\\\\n### 4.3 状态管理\\\\n\\\\n#### 4.3.1 应用状态\\\\n\\\\n```typescript\\\\nimport { useAppStore } from \\\\'./lib/integration/data-layer-integration\\\\';\\\\n\\\\nfunction App() {\\\\n  const { user, tenant, theme, language, setUser, setTenant, setTheme, setLanguage } = useAppStore();\\\\n\\\\n  useEffect(() => {\\\\n    // 初始化用户信息\\\\n    setUser({\\\\n      id: \\\\'user-123\\\\',\\\\n      name: \\\\'张三\\\\',\\\\n      email: \\\\'zhangsan@example.com\\\\',\\\\n      role: \\\\'admin\\\\',\\\\n    });\\\\n\\\\n    // 初始化租户信息\\\\n    setTenant({\\\\n      id: \\\\'tenant-123\\\\',\\\\n      name: \\\\'YYC³餐饮\\\\',\\\\n      config: {},\\\\n    });\\\\n  }, []);\\\\n\\\\n  return (\\\\n    <div>\\\\n      <h1>欢迎, {user?.name}</h1>\\\\n      <button onClick={() => setTheme(theme === \\\\'light\\\\' ? \\\\'dark\\\\' : \\\\'light\\\\')}>\\\\n        切换主题\\\\n      </button>\\\\n      <button onClick={() => setLanguage(language === \\\\'zh-CN\\\\' ? \\\\'en-US\\\\' : \\\\'zh-CN\\\\')}>\\\\n        切换语言\\\\n      </button>\\\\n    </div>\\\\n  );\\\\n}\\\\n```\\\\n\\\\n#### 4.3.2 订单状态\\\\n\\\\n```typescript\\\\nimport { useOrderStore } from \\\\'./lib/integration/data-layer-integration\\\\';\\\\n\\\\nfunction OrderList() {\\\\n  const { orders, loading, error, addOrder, updateOrder, removeOrder } = useOrderStore();\\\\n\\\\n  const handleAddOrder = async (orderData) => {\\\\n    const response = await apiClient.post(\\\\'/orders\\\\', orderData);\\\\n    if (response.success) {\\\\n      addOrder(response.data);\\\\n    }\\\\n  };\\\\n\\\\n  const handleUpdateOrder = async (orderId, updates) => {\\\\n    const response = await apiClient.put(`/orders/${orderId}`, updates);\\\\n    if (response.success) {\\\\n      updateOrder(orderId, updates);\\\\n    }\\\\n  };\\\\n\\\\n  const handleRemoveOrder = async (orderId) => {\\\\n    const response = await apiClient.delete(`/orders/${orderId}`);\\\\n    if (response.success) {\\\\n      removeOrder(orderId);\\\\n    }\\\\n  };\\\\n\\\\n  return (\\\\n    <div>\\\\n      {orders.map(order => (\\\\n        <div key={order.id}>\\\\n          <span>{order.id}</span>\\\\n          <button onClick={() => handleUpdateOrder(order.id, { status: \\\\'completed\\\\' })}>\\\\n            完成\\\\n          </button>\\\\n          <button onClick={() => handleRemoveOrder(order.id)}>\\\\n            删除\\\\n          </button>\\\\n        </div>\\\\n      ))}\\\\n    </div>\\\\n  );\\\\n}\\\\n```\\\\n\\\\n### 4.4 实时数据同步\\\\n\\\\n```typescript\\\\nimport { dataSyncManager } from \\\\'./lib/integration/data-layer-integration\\\\';\\\\n\\\\n// 注册数据同步\\\\ndataSyncManager.register(\\\\'orders\\\\', {\\\\n  endpoint: \\\\'ws://localhost:3000/orders\\\\',\\\\n  interval: 5000, // 5秒自动同步\\\\n  autoSync: true,\\\\n  conflictResolution: \\\\'server\\\\',\\\\n});\\\\n\\\\n// 连接WebSocket\\\\nconst ws = dataSyncManager.connectWebSocket(\\\\'orders\\\\', \\\\'ws://localhost:3000/orders\\\\');\\\\n\\\\n// 取消注册\\\\ndataSyncManager.unregister(\\\\'orders\\\\');\\\\n```\\\\n\\\\n---\\\\n\\\\n## 5. 多端适配策略\\\\n\\\\n### 5.1 核心设计理念\\\\n\\\\n多端适配策略基于以下核心设计理念：\\\\n\\\\n1. **响应式设计**: 支持多种屏幕尺寸和设备类型\\\\n2. **平台检测**: 自动检测设备类型和平台信息\\\\n3. **断点系统**: 提供灵活的断点系统，支持响应式布局\\\\n4. **手势支持**: 支持触摸手势，提升移动端体验\\\\n5. **平台适配**: 针对不同平台提供特定的适配方案\\\\n\\\\n### 5.2 设备信息\\\\n\\\\n```typescript\\\\nimport { useDeviceInfo, usePlatformInfo } from \\\\'./lib/integration/multi-platform-adapter\\\\';\\\\n\\\\nfunction DeviceInfo() {\\\\n  const deviceInfo = useDeviceInfo();\\\\n  const platformInfo = usePlatformInfo();\\\\n\\\\n  return (\\\\n    <div>\\\\n      <div>设备类型: {deviceInfo.type}</div>\\\\n      <div>屏幕尺寸: {deviceInfo.width} x {deviceInfo.height}</div>\\\\n      <div>方向: {deviceInfo.orientation}</div>\\\\n      <div>触摸设备: {deviceInfo.isTouch ? \\\\'是\\\\' : \\\\'否\\\\'}</div>\\\\n      <div>平台: {platformInfo.name}</div>\\\\n      <div>操作系统: {platformInfo.os}</div>\\\\n      <div>浏览器: {platformInfo.browser}</div>\\\\n    </div>\\\\n  );\\\\n}\\\\n```\\\\n\\\\n### 5.3 响应式断点\\\\n\\\\n```typescript\\\\nimport { useBreakpoint, useResponsive } from \\\\'./lib/integration/multi-platform-adapter\\\\';\\\\n\\\\nfunction ResponsiveComponent() {\\\\n  const breakpoint = useBreakpoint();\\\\n\\\\n  const columns = useResponsive({\\\\n    xs: 1,\\\\n    sm: 2,\\\\n    md: 3,\\\\n    lg: 4,\\\\n    xl: 5,\\\\n    \\\\'2xl\\\\': 6,\\\\n  });\\\\n\\\\n  return (\\\\n    <div>\\\\n      <div>当前断点: {breakpoint}</div>\\\\n      <div>列数: {columns}</div>\\\\n      <div style={{ display: \\\\'grid\\\\', gridTemplateColumns: `repeat(${columns}, 1fr)` }}>\\\\n        {/* 渲染内容 */}\\\\n      </div>\\\\n    </div>\\\\n  );\\\\n}\\\\n```\\\\n\\\\n### 5.4 媒体查询\\\\n\\\\n```typescript\\\\nimport { useMediaQuery } from \\\\'./lib/integration/multi-platform-adapter\\\\';\\\\n\\\\nfunction MediaQueryComponent() {\\\\n  const isMobile = useMediaQuery(\\\\'(max-width: 768px)\\\\');\\\\n  const isTablet = useMediaQuery(\\\\'(min-width: 769px) and (max-width: 1024px)\\\\');\\\\n  const isDesktop = useMediaQuery(\\\\'(min-width: 1025px)\\\\');\\\\n\\\\n  return (\\\\n    <div>\\\\n      {isMobile && <div>移动端布局</div>}\\\\n      {isTablet && <div>平板端布局</div>}\\\\n      {isDesktop && <div>桌面端布局</div>}\\\\n    </div>\\\\n  );\\\\n}\\\\n```\\\\n\\\\n### 5.5 触摸手势\\\\n\\\\n```typescript\\\\nimport { useTouchGesture } from \\\\'./lib/integration/multi-platform-adapter\\\\';\\\\n\\\\nfunction SwipeableCard() {\\\\n  const ref = useRef<HTMLDivElement>(null);\\\\n\\\\n  useTouchGesture(ref, {\\\\n    onSwipeLeft: () => console.log(\\\\'向左滑动\\\\'),\\\\n    onSwipeRight: () => console.log(\\\\'向右滑动\\\\'),\\\\n    onSwipeUp: () => console.log(\\\\'向上滑动\\\\'),\\\\n    onSwipeDown: () => console.log(\\\\'向下滑动\\\\'),\\\\n    onTap: () => console.log(\\\\'点击\\\\'),\\\\n    onLongPress: () => console.log(\\\\'长按\\\\'),\\\\n  });\\\\n\\\\n  return (\\\\n    <div ref={ref} style={{ padding: \\\\'20px\\\\', border: \\\\'1px solid #ccc\\\\' }}>\\\\n      滑动我\\\\n    </div>\\\\n  );\\\\n}\\\\n```\\\\n\\\\n### 5.6 平台适配器\\\\n\\\\n```typescript\\\\nimport { usePlatformAdapter } from \\\\'./lib/integration/multi-platform-adapter\\\\';\\\\n\\\\nfunction PlatformAdapterComponent() {\\\\n  const adapter = usePlatformAdapter();\\\\n\\\\n  const handleOpenURL = () => {\\\\n    adapter.openURL(\\\\'https://example.com\\\\');\\\\n  };\\\\n\\\\n  const handleShare = () => {\\\\n    adapter.share({\\\\n      title: \\\\'YYC³餐饮平台\\\\',\\\\n      description: \\\\'智能餐饮管理平台\\\\',\\\\n      url: \\\\'https://yyc3.com\\\\',\\\\n    });\\\\n  };\\\\n\\\\n  const handleCopy = async () => {\\\\n    const success = await adapter.copyToClipboard(\\\\'复制的内容\\\\');\\\\n    console.log(\\\\'复制结果:\\\\', success);\\\\n  };\\\\n\\\\n  const handleVibrate = () => {\\\\n    adapter.vibrate(200);\\\\n  };\\\\n\\\\n  return (\\\\n    <div>\\\\n      <button onClick={handleOpenURL}>打开链接</button>\\\\n      <button onClick={handleShare}>分享</button>\\\\n      <button onClick={handleCopy}>复制</button>\\\\n      <button onClick={handleVibrate}>震动</button>\\\\n    </div>\\\\n  );\\\\n}\\\\n```\\\\n\\\\n---\\\\n\\\\n## 6. 跨维度数据交互与状态同步\\\\n\\\\n### 6.1 核心设计理念\\\\n\\\\n跨维度数据交互与状态同步基于以下核心设计理念：\\\\n\\\\n1. **事件驱动**: 基于事件驱动的数据交互机制\\\\n2. **实时同步**: 支持WebSocket实时数据推送\\\\n3. **离线队列**: 支持离线操作队列和自动同步\\\\n4. **冲突解决**: 提供灵活的冲突解决机制\\\\n5. **版本控制**: 支持数据版本控制和并发控制\\\\n\\\\n### 6.2 事件总线\\\\n\\\\n```typescript\\\\nimport { eventBus } from \\\\'./lib/integration/cross-dimension-sync\\\\';\\\\n\\\\n// 监听事件\\\\neventBus.on(\\\\'data:orders:created\\\\', (order) => {\\\\n  console.log(\\\\'新订单创建:\\\\', order);\\\\n});\\\\n\\\\neventBus.on(\\\\'data:orders:updated\\\\', (order) => {\\\\n  console.log(\\\\'订单更新:\\\\', order);\\\\n});\\\\n\\\\neventBus.on(\\\\'data:orders:deleted\\\\', (order) => {\\\\n  console.log(\\\\'订单删除:\\\\', order);\\\\n});\\\\n\\\\n// 发送事件\\\\neventBus.emit(\\\\'data:orders:created\\\\', orderData);\\\\n\\\\n// 取消监听\\\\neventBus.off(\\\\'data:orders:created\\\\', handler);\\\\n```\\\\n\\\\n### 6.3 数据同步\\\\n\\\\n```typescript\\\\nimport { crossDimensionDataManager, DataSyncConfig } from \\\\'./lib/integration/cross-dimension-sync\\\\';\\\\n\\\\n// 注册数据同步\\\\nconst config: DataSyncConfig = {\\\\n  entity: \\\\'orders\\\\',\\\\n  endpoint: \\\\'http://localhost:3000/api/orders\\\\',\\\\n  syncInterval: 5000,\\\\n  autoSync: true,\\\\n  conflictResolution: \\\\'server\\\\',\\\\n  offlineSupport: true,\\\\n  realTime: true,\\\\n};\\\\n\\\\ncrossDimensionDataManager.register(config);\\\\n\\\\n// 创建数据\\\\nconst order = await crossDimensionDataManager.create(\\\\'orders\\\\', {\\\\n  customerId: \\\\'customer-123\\\\',\\\\n  items: [\\\\n    { productId: \\\\'product-1\\\\', quantity: 2 },\\\\n  ],\\\\n});\\\\n\\\\n// 更新数据\\\\nconst updatedOrder = await crossDimensionDataManager.update(\\\\'orders\\\\', order.id, {\\\\n  status: \\\\'completed\\\\',\\\\n});\\\\n\\\\n// 删除数据\\\\nawait crossDimensionDataManager.delete(\\\\'orders\\\\', order.id);\\\\n\\\\n// 获取同步状态\\\\nconst syncState = crossDimensionDataManager.getSyncState(\\\\'orders\\\\');\\\\n\\\\n// 取消注册\\\\ncrossDimensionDataManager.unregister(\\\\'orders\\\\');\\\\n```\\\\n\\\\n### 6.4 离线队列\\\\n\\\\n```typescript\\\\nimport { offlineQueueManager } from \\\\'./lib/integration/cross-dimension-sync\\\\';\\\\n\\\\n// 添加离线操作\\\\nconst operationId = offlineQueueManager.add({\\\\n  operation: DataOperationType.CREATE,\\\\n  entity: \\\\'orders\\\\',\\\\n  entityId: \\\\'pending-123\\\\',\\\\n  data: orderData,\\\\n  maxRetries: 3,\\\\n});\\\\n\\\\n// 获取所有离线操作\\\\nconst operations = offlineQueueManager.getAll();\\\\n\\\\n// 同步离线队列\\\\nawait crossDimensionDataManager.syncOfflineQueue();\\\\n\\\\n// 清除离线队列\\\\nofflineQueueManager.clear();\\\\n```\\\\n\\\\n### 6.5 数据冲突\\\\n\\\\n```typescript\\\\nimport { dataConflictResolver } from \\\\'./lib/integration/cross-dimension-sync\\\\';\\\\n\\\\n// 检测冲突\\\\nconst hasConflict = dataConflictResolver.detectConflict(localData, remoteData);\\\\n\\\\n// 创建冲突\\\\nconst conflict = dataConflictResolver.createConflict(\\\\n  \\\\'orders\\\\',\\\\n  \\\\'order-123\\\\',\\\\n  localData,\\\\n  remoteData\\\\n);\\\\n\\\\n// 解决冲突\\\\ndataConflictResolver.resolveConflict(conflict.id, \\\\'local\\\\');\\\\ndataConflictResolver.resolveConflict(conflict.id, \\\\'remote\\\\');\\\\ndataConflictResolver.resolveConflict(conflict.id, \\\\'merge\\\\', mergedData);\\\\n\\\\n// 获取所有冲突\\\\nconst conflicts = dataConflictResolver.getConflicts();\\\\n```\\\\n\\\\n### 6.6 React Hooks\\\\n\\\\n```typescript\\\\nimport {\\\\n  useDataEvent,\\\\n  useSyncState,\\\\n  useOfflineQueue,\\\\n} from \\\\'./lib/integration/cross-dimension-sync\\\\';\\\\n\\\\n// 使用数据事件\\\\nfunction OrderList() {\\\\n  const orders = useDataEvent(\\\\'orders\\\\', DataOperationType.CREATE);\\\\n\\\\n  return (\\\\n    <div>\\\\n      {orders?.map(order => (\\\\n        <div key={order.id}>{order.id}</div>\\\\n      ))}\\\\n    </div>\\\\n  );\\\\n}\\\\n\\\\n// 使用同步状态\\\\nfunction SyncStatus() {\\\\n  const syncState = useSyncState(\\\\'orders\\\\');\\\\n\\\\n  return (\\\\n    <div>\\\\n      同步状态: {syncState}\\\\n    </div>\\\\n  );\\\\n}\\\\n\\\\n// 使用离线队列\\\\nfunction OfflineQueue() {\\\\n  const { operations, size, syncQueue } = useOfflineQueue();\\\\n\\\\n  return (\\\\n    <div>\\\\n      <div>离线操作数量: {size}</div>\\\\n      <button onClick={syncQueue}>同步离线操作</button>\\\\n      <ul>\\\\n        {operations.map(op => (\\\\n          <li key={op.id}>{op.operation} - {op.entity}</li>\\\\n        ))}\\\\n      </ul>\\\\n    </div>\\\\n  );\\\\n}\\\\n```\\\\n\\\\n---\\\\n\\\\n## 7. 最佳实践\\\\n\\\\n### 7.1 API调用最佳实践\\\\n\\\\n1. **使用React Hooks**: 优先使用`useApi`、`useApiMutation`等React Hooks\\\\n2. **错误处理**: 始终处理API错误，提供友好的错误提示\\\\n3. **加载状态**: 显示加载状态，提升用户体验\\\\n4. **缓存策略**: 合理使用缓存，减少不必要的API调用\\\\n5. **请求重试**: 利用自动重试机制，提升系统稳定性\\\\n\\\\n### 7.2 状态管理最佳实践\\\\n\\\\n1. **单一数据源**: 每个数据实体只使用一个状态管理器\\\\n2. **不可变更新**: 使用Zustand的immer中间件进行不可变更新\\\\n3. **持久化**: 合理使用持久化中间件，保存重要状态\\\\n4. **状态分割**: 将状态按功能模块分割，避免状态过大\\\\n5. **订阅清理**: 及时清理事件订阅，避免内存泄漏\\\\n\\\\n### 7.3 多端适配最佳实践\\\\n\\\\n1. **移动优先**: 采用移动优先的设计策略\\\\n2. **响应式设计**: 使用响应式断点和媒体查询\\\\n3. **触摸友好**: 确保触摸目标足够大（至少44x44px）\\\\n4. **性能优化**: 针对移动设备进行性能优化\\\\n5. **平台特性**: 利用平台特性，提供更好的用户体验\\\\n\\\\n### 7.4 数据同步最佳实践\\\\n\\\\n1. **实时优先**: 优先使用实时数据同步\\\\n2. **离线支持**: 提供离线支持，提升用户体验\\\\n3. **冲突解决**: 提供合理的冲突解决机制\\\\n4. **版本控制**: 使用版本控制，避免数据冲突\\\\n5. **错误恢复**: 提供错误恢复机制，确保数据一致性\\\\n\\\\n---\\\\n\\\\n## 8. 总结\\\\n\\\\nYYC³餐饮行业智能化平台的系统集成架构实现了以下核心目标：\\\\n\\\\n1. **无缝对接**: UI层与业务逻辑层的无缝对接，消除了数据孤岛\\\\n2. **深度集成**: 数据层与UI层的深度集成，提供了统一的数据访问接口\\\\n3. **多端适配**: Web端、移动端、小程序等多终端的一致用户体验\\\\n4. **实时同步**: 跨维度数据交互与状态同步，确保了数据一致性\\\\n5. **离线支持**: 离线数据处理和自动同步，提升了用户体验\\\\n\\\\n通过这套完整的系统集成架构，整个系统在功能实现、用户体验和技术架构上形成了有机整体，为后续的业务扩展和技术升级奠定了坚实的基础。\\\\n\\\\n---\\\\n\\\\n**文档版本**: v1.0.0\\\\n**最后更新**: 2026-01-21\\\\n**文档状态**: 正式发布\\\\n\",\"originAcceptText\":\"# YYC³餐饮行业智能化平台 - 系统集成架构文档\\n\\n## 文档信息\\n\\n| 项目 | 内容 |\\n|-----|------|\\n| 文档编号 | YYC3-AICP-SIA-001 |\\n| 文档名称 | 系统集成架构文档 |\\n| 版本号 | v1.0.0 |\\n| 创建日期 | 2026-01-21 |\\n| 最后更新 | 2026-01-21 |\\n| 文档状态 | 正式发布 |\\n| 作者 | YYC³ |\\n\\n---\\n\\n## 1. 概述\\n\\n### 1.1 文档目的\\n\\n本文档详细描述YYC³餐饮行业智能化平台的系统集成架构，包括UI层与业务逻辑层的无缝对接、数据层与UI层的深度集成、多端适配策略、跨维度数据交互与状态同步机制等核心内容，确保整个系统在功能实现、用户体验和技术架构上形成有机整体。\\n\\n### 1.2 适用范围\\n\\n本文档适用于YYC³餐饮行业智能化平台的所有开发人员、架构师、项目经理、测试人员和运维人员。\\n\\n### 1.3 核心目标\\n\\n- **无缝对接**: 实现UI层与业务逻辑层的无缝对接，消除数据孤岛\\n- **深度集成**: 实现数据层与UI层的深度集成，提供统一的数据访问接口\\n- **多端适配**: 实现Web端、移动端、小程序等多终端的一致用户体验\\n- **实时同步**: 实现跨维度数据交互与状态同步，确保数据一致性\\n- **离线支持**: 实现离线数据处理和自动同步，提升用户体验\\n\\n---\\n\\n## 2. 系统整体架构\\n\\n### 2.1 架构分层\\n\\n```\\n┌─────────────────────────────────────────────────────────────────┐\\n│                        客户端层 (Client Layer)                    │\\n├─────────────────────────────────────────────────────────────────┤\\n│  Web浏览器      │  移动端H5      │  小程序      │  管理后台        │\\n│  (React 18)     │  (React 18)    │  (原生)       │  (React 18)      │\\n└─────────────────────────────────────────────────────────────────┘\\n                              │\\n                              ▼\\n                ┌─────────────────────────────────────────────────────────┐\\n                │                   UI集成层 (UI Integration Layer)            │\\n                ├─────────────────────────────────────────────────────────┤\\n                │  UI-Business Integration  │  Data Layer Integration   │\\n                │  Multi-Platform Adapter   │  Cross-Dimension Sync     │\\n                └─────────────────────────────────────────────────────────┘\\n                              │\\n                              ▼\\n                ┌─────────────────────────────────────────────────────────┐\\n                │                    业务逻辑层 (Business Layer)                  │\\n                ├─────────────────────────────────────────────────────────┤\\n                │  用户服务  │  菜单服务  │  订单服务  │  库存服务  │  财务服务  │\\n                │  营销服务  │  报表服务  │  消息服务  │  文件服务  │  支付服务  │\\n                └─────────────────────────────────────────────────────────┘\\n                              │\\n                              ▼\\n                ┌─────────────────────────────────────────────────────────┐\\n                │                    数据访问层 (Data Access Layer)            │\\n                ├─────────────────────────────────────────────────────────┤\\n                │  ORM层  │  缓存层  │  消息队列  │  数据同步                    │\\n                └─────────────────────────────────────────────────────────┘\\n                              │\\n                              ▼\\n                ┌─────────────────────────────────────────────────────────┐\\n                │                    数据存储层 (Data Storage Layer)            │\\n                ├─────────────────────────────────────────────────────────┤\\n                │  PostgreSQL  │  Redis  │  MinIO  │  Elasticsearch           │\\n                └─────────────────────────────────────────────────────────┘\\n```\\n\\n### 2.2 技术栈\\n\\n#### 前端技术栈\\n\\n- **核心框架**: React 18.3.1 + TypeScript 5.3+\\n- **构建工具**: Vite 5.0+\\n- **状态管理**: Zustand 4.4+ (轻量级状态管理)\\n- **UI组件库**: Tailwind CSS 4.1.12 + 自研YU组件库\\n- **数据获取**: React Query / SWR\\n- **实时通信**: WebSocket + Server-Sent Events\\n- **离线存储**: IndexedDB + LocalStorage + SessionStorage\\n\\n#### 后端技术栈\\n\\n- **核心框架**: Express.js / Nest.js\\n- **API网关**: Kong / Nginx\\n- **数据库**: PostgreSQL 15+ (多租户架构)\\n- **缓存**: Redis 7+\\n- **消息队列**: RabbitMQ / Kafka\\n- **搜索引擎**: Elasticsearch 8+\\n\\n---\\n\\n## 3. UI层与业务逻辑层无缝对接\\n\\n### 3.1 核心设计理念\\n\\nUI层与业务逻辑层的无缝对接基于以下核心设计理念：\\n\\n1. **统一API客户端**: 提供统一的API请求接口，封装所有HTTP请求逻辑\\n2. **React Hooks封装**: 提供易用的React Hooks，简化数据获取和状态管理\\n3. **业务服务层**: 封装业务逻辑，提供清晰的API接口\\n4. **错误处理**: 统一的错误处理机制，提供友好的错误提示\\n5. **请求重试**: 自动重试机制，提升系统稳定性\\n\\n### 3.2 API客户端\\n\\n#### 3.2.1 基础API客户端\\n\\n```typescript\\nimport { ApiClient } from './lib/integration/ui-business-integration';\\n\\nconst apiClient = new ApiClient('http://localhost:3000/api');\\n\\n// 设置认证令牌\\napiClient.setToken('your-jwt-token');\\n\\n// 设置租户ID\\napiClient.setTenantId('tenant-123');\\n\\n// 发送GET请求\\nconst response = await apiClient.get('/orders');\\n\\n// 发送POST请求\\nconst response = await apiClient.post('/orders', {\\n  customerId: 'customer-123',\\n  items: [\\n    { productId: 'product-1', quantity: 2 },\\n  ],\\n});\\n\\n// 发送PUT请求\\nconst response = await apiClient.put('/orders/123', {\\n  status: 'completed',\\n});\\n\\n// 发送DELETE请求\\nconst response = await apiClient.delete('/orders/123');\\n```\\n\\n#### 3.2.2 React Hooks\\n\\n```typescript\\nimport { useApi, useApiMutation, usePaginatedApi } from './lib/integration/ui-business-integration';\\n\\n// 使用API数据\\nfunction OrderList() {\\n  const { data, loading, error, refetch } = useApi('/orders');\\n\\n  if (loading) return <div>加载中...</div>;\\n  if (error) return <div>加载失败: {error.message}</div>;\\n\\n  return (\\n    <div>\\n      {data?.map(order => (\\n        <div key={order.id}>{order.id}</div>\\n      ))}\\n      <button onClick={refetch}>刷新</button>\\n    </div>\\n  );\\n}\\n\\n// 使用API操作\\nfunction CreateOrder() {\\n  const { mutate, loading, error } = useApiMutation('/orders', 'POST');\\n\\n  const handleSubmit = async (orderData) => {\\n    const response = await mutate(orderData);\\n    if (response.success) {\\n      console.log('订单创建成功');\\n    }\\n  };\\n\\n  return (\\n    <form onSubmit={handleSubmit}>\\n      <button disabled={loading} type=\\\"submit\\\">\\n        {loading ? '提交中...' : '创建订单'}\\n      </button>\\n    </form>\\n  );\\n}\\n\\n// 使用分页数据\\nfunction OrderListPaginated() {\\n  const {\\n    data,\\n    loading,\\n    error,\\n    page,\\n    total,\\n    hasMore,\\n    loadMore,\\n    refresh,\\n  } = usePaginatedApi('/orders', 1, 20);\\n\\n  return (\\n    <div>\\n      {data?.map(order => (\\n        <div key={order.id}>{order.id}</div>\\n      ))}\\n      {hasMore && (\\n        <button onClick={loadMore} disabled={loading}>\\n          {loading ? '加载中...' : '加载更多'}\\n        </button>\\n      )}\\n      <button onClick={refresh}>刷新</button>\\n    </div>\\n  );\\n}\\n```\\n\\n#### 3.2.3 业务服务层\\n\\n```typescript\\nimport { orderService, menuService, userService } from './lib/integration/ui-business-integration';\\n\\n// 订单服务\\nasync function fetchOrders() {\\n  const response = await orderService.getOrders({\\n    page: 1,\\n    pageSize: 20,\\n    status: 'pending',\\n  });\\n\\n  if (response.success) {\\n    return response.data;\\n  }\\n}\\n\\nasync function createOrder(orderData) {\\n  const response = await orderService.createOrder(orderData);\\n\\n  if (response.success) {\\n    return response.data;\\n  }\\n}\\n\\n// 菜单服务\\nasync function fetchMenus() {\\n  const response = await menuService.getMenus({\\n    page: 1,\\n    pageSize: 20,\\n    category: 'main',\\n  });\\n\\n  if (response.success) {\\n    return response.data;\\n  }\\n}\\n\\n// 用户服务\\nasync function login(email, password) {\\n  const response = await userService.login({ email, password });\\n\\n  if (response.success) {\\n    const { token, user } = response.data;\\n    apiClient.setToken(token);\\n    return user;\\n  }\\n}\\n```\\n\\n### 3.3 实时数据\\n\\n```typescript\\nimport { useRealtimeData } from './lib/integration/ui-business-integration';\\n\\n// 使用实时数据\\nfunction RealtimeOrderList() {\\n  const { data, connected } = useRealtimeData('ws://localhost:3000/orders');\\n\\n  return (\\n    <div>\\n      <div>连接状态: {connected ? '已连接' : '未连接'}</div>\\n      {data?.map(order => (\\n        <div key={order.id}>{order.id}</div>\\n      ))}\\n    </div>\\n  );\\n}\\n```\\n\\n### 3.4 乐观更新\\n\\n```typescript\\nimport { useOptimisticUpdate } from './lib/integration/ui-business-integration';\\n\\n// 使用乐观更新\\nfunction OrderItem({ order }) {\\n  const { data, loading, error, update } = useOptimisticUpdate(\\n    order,\\n    (newData) => apiClient.put(`/orders/${order.id}`, newData)\\n  );\\n\\n  const handleStatusChange = async (newStatus) => {\\n    await update({ status: newStatus });\\n  };\\n\\n  return (\\n    <div>\\n      <span>订单状态: {data.status}</span>\\n      <button onClick={() => handleStatusChange('completed')}>\\n        标记为完成\\n      </button>\\n    </div>\\n  );\\n}\\n```\\n\\n---\\n\\n## 4. 数据层与UI层深度集成\\n\\n### 4.1 核心设计理念\\n\\n数据层与UI层的深度集成基于以下核心设计理念：\\n\\n1. **多级缓存策略**: 支持内存、LocalStorage、IndexedDB等多种缓存策略\\n2. **统一状态管理**: 使用Zustand进行统一的状态管理\\n3. **实时数据同步**: 支持WebSocket实时数据推送\\n4. **离线数据支持**: 支持离线数据存储和自动同步\\n5. **数据版本控制**: 支持数据版本控制和冲突解决\\n\\n### 4.2 缓存管理\\n\\n#### 4.2.1 缓存策略\\n\\n```typescript\\nimport { cacheManager, CacheStrategy } from './lib/integration/data-layer-integration';\\n\\n// 内存缓存\\nawait cacheManager.set('user:123', userData, {\\n  key: 'user:123',\\n  strategy: CacheStrategy.MEMORY,\\n  ttl: 3600000, // 1小时\\n  version: '1.0',\\n});\\n\\nconst cachedUser = await cacheManager.get('user:123', CacheStrategy.MEMORY);\\n\\n// IndexedDB缓存\\nawait cacheManager.set('orders:page:1', ordersData, {\\n  key: 'orders:page:1',\\n  strategy: CacheStrategy.INDEXED_DB,\\n  ttl: 1800000, // 30分钟\\n  version: '1.0',\\n});\\n\\nconst cachedOrders = await cacheManager.get('orders:page:1', CacheStrategy.INDEXED_DB);\\n\\n// LocalStorage缓存\\nawait cacheManager.set('theme', 'dark', {\\n  key: 'theme',\\n  strategy: CacheStrategy.LOCAL_STORAGE,\\n  ttl: 86400000, // 24小时\\n  version: '1.0',\\n});\\n\\nconst cachedTheme = await cacheManager.get('theme', CacheStrategy.LOCAL_STORAGE);\\n```\\n\\n#### 4.2.2 React Hooks\\n\\n```typescript\\nimport { useCachedData } from './lib/integration/data-layer-integration';\\n\\n// 使用缓存数据\\nfunction UserProfile({ userId }) {\\n  const { data, loading, error, refresh, invalidate } = useCachedData(\\n    `user:${userId}`,\\n    () => fetchUser(userId),\\n    {\\n      key: `user:${userId}`,\\n      strategy: CacheStrategy.MEMORY,\\n      ttl: 3600000,\\n      version: '1.0',\\n    }\\n  );\\n\\n  return (\\n    <div>\\n      {loading && <div>加载中...</div>}\\n      {error && <div>加载失败: {error.message}</div>}\\n      {data && (\\n        <div>\\n          <h1>{data.name}</h1>\\n          <p>{data.email}</p>\\n          <button onClick={refresh}>刷新</button>\\n          <button onClick={invalidate}>清除缓存</button>\\n        </div>\\n      )}\\n    </div>\\n  );\\n}\\n```\\n\\n### 4.3 状态管理\\n\\n#### 4.3.1 应用状态\\n\\n```typescript\\nimport { useAppStore } from './lib/integration/data-layer-integration';\\n\\nfunction App() {\\n  const { user, tenant, theme, language, setUser, setTenant, setTheme, setLanguage } = useAppStore();\\n\\n  useEffect(() => {\\n    // 初始化用户信息\\n    setUser({\\n      id: 'user-123',\\n      name: '张三',\\n      email: 'zhangsan@example.com',\\n      role: 'admin',\\n    });\\n\\n    // 初始化租户信息\\n    setTenant({\\n      id: 'tenant-123',\\n      name: 'YYC³餐饮',\\n      config: {},\\n    });\\n  }, []);\\n\\n  return (\\n    <div>\\n      <h1>欢迎, {user?.name}</h1>\\n      <button onClick={() => setTheme(theme === 'light' ? 'dark' : 'light')}>\\n        切换主题\\n      </button>\\n      <button onClick={() => setLanguage(language === 'zh-CN' ? 'en-US' : 'zh-CN')}>\\n        切换语言\\n      </button>\\n    </div>\\n  );\\n}\\n```\\n\\n#### 4.3.2 订单状态\\n\\n```typescript\\nimport { useOrderStore } from './lib/integration/data-layer-integration';\\n\\nfunction OrderList() {\\n  const { orders, loading, error, addOrder, updateOrder, removeOrder } = useOrderStore();\\n\\n  const handleAddOrder = async (orderData) => {\\n    const response = await apiClient.post('/orders', orderData);\\n    if (response.success) {\\n      addOrder(response.data);\\n    }\\n  };\\n\\n  const handleUpdateOrder = async (orderId, updates) => {\\n    const response = await apiClient.put(`/orders/${orderId}`, updates);\\n    if (response.success) {\\n      updateOrder(orderId, updates);\\n    }\\n  };\\n\\n  const handleRemoveOrder = async (orderId) => {\\n    const response = await apiClient.delete(`/orders/${orderId}`);\\n    if (response.success) {\\n      removeOrder(orderId);\\n    }\\n  };\\n\\n  return (\\n    <div>\\n      {orders.map(order => (\\n        <div key={order.id}>\\n          <span>{order.id}</span>\\n          <button onClick={() => handleUpdateOrder(order.id, { status: 'completed' })}>\\n            完成\\n          </button>\\n          <button onClick={() => handleRemoveOrder(order.id)}>\\n            删除\\n          </button>\\n        </div>\\n      ))}\\n    </div>\\n  );\\n}\\n```\\n\\n### 4.4 实时数据同步\\n\\n```typescript\\nimport { dataSyncManager } from './lib/integration/data-layer-integration';\\n\\n// 注册数据同步\\ndataSyncManager.register('orders', {\\n  endpoint: 'ws://localhost:3000/orders',\\n  interval: 5000, // 5秒自动同步\\n  autoSync: true,\\n  conflictResolution: 'server',\\n});\\n\\n// 连接WebSocket\\nconst ws = dataSyncManager.connectWebSocket('orders', 'ws://localhost:3000/orders');\\n\\n// 取消注册\\ndataSyncManager.unregister('orders');\\n```\\n\\n---\\n\\n## 5. 多端适配策略\\n\\n### 5.1 核心设计理念\\n\\n多端适配策略基于以下核心设计理念：\\n\\n1. **响应式设计**: 支持多种屏幕尺寸和设备类型\\n2. **平台检测**: 自动检测设备类型和平台信息\\n3. **断点系统**: 提供灵活的断点系统，支持响应式布局\\n4. **手势支持**: 支持触摸手势，提升移动端体验\\n5. **平台适配**: 针对不同平台提供特定的适配方案\\n\\n### 5.2 设备信息\\n\\n```typescript\\nimport { useDeviceInfo, usePlatformInfo } from './lib/integration/multi-platform-adapter';\\n\\nfunction DeviceInfo() {\\n  const deviceInfo = useDeviceInfo();\\n  const platformInfo = usePlatformInfo();\\n\\n  return (\\n    <div>\\n      <div>设备类型: {deviceInfo.type}</div>\\n      <div>屏幕尺寸: {deviceInfo.width} x {deviceInfo.height}</div>\\n      <div>方向: {deviceInfo.orientation}</div>\\n      <div>触摸设备: {deviceInfo.isTouch ? '是' : '否'}</div>\\n      <div>平台: {platformInfo.name}</div>\\n      <div>操作系统: {platformInfo.os}</div>\\n      <div>浏览器: {platformInfo.browser}</div>\\n    </div>\\n  );\\n}\\n```\\n\\n### 5.3 响应式断点\\n\\n```typescript\\nimport { useBreakpoint, useResponsive } from './lib/integration/multi-platform-adapter';\\n\\nfunction ResponsiveComponent() {\\n  const breakpoint = useBreakpoint();\\n\\n  const columns = useResponsive({\\n    xs: 1,\\n    sm: 2,\\n    md: 3,\\n    lg: 4,\\n    xl: 5,\\n    '2xl': 6,\\n  });\\n\\n  return (\\n    <div>\\n      <div>当前断点: {breakpoint}</div>\\n      <div>列数: {columns}</div>\\n      <div style={{ display: 'grid', gridTemplateColumns: `repeat(${columns}, 1fr)` }}>\\n        {/* 渲染内容 */}\\n      </div>\\n    </div>\\n  );\\n}\\n```\\n\\n### 5.4 媒体查询\\n\\n```typescript\\nimport { useMediaQuery } from './lib/integration/multi-platform-adapter';\\n\\nfunction MediaQueryComponent() {\\n  const isMobile = useMediaQuery('(max-width: 768px)');\\n  const isTablet = useMediaQuery('(min-width: 769px) and (max-width: 1024px)');\\n  const isDesktop = useMediaQuery('(min-width: 1025px)');\\n\\n  return (\\n    <div>\\n      {isMobile && <div>移动端布局</div>}\\n      {isTablet && <div>平板端布局</div>}\\n      {isDesktop && <div>桌面端布局</div>}\\n    </div>\\n  );\\n}\\n```\\n\\n### 5.5 触摸手势\\n\\n```typescript\\nimport { useTouchGesture } from './lib/integration/multi-platform-adapter';\\n\\nfunction SwipeableCard() {\\n  const ref = useRef<HTMLDivElement>(null);\\n\\n  useTouchGesture(ref, {\\n    onSwipeLeft: () => console.log('向左滑动'),\\n    onSwipeRight: () => console.log('向右滑动'),\\n    onSwipeUp: () => console.log('向上滑动'),\\n    onSwipeDown: () => console.log('向下滑动'),\\n    onTap: () => console.log('点击'),\\n    onLongPress: () => console.log('长按'),\\n  });\\n\\n  return (\\n    <div ref={ref} style={{ padding: '20px', border: '1px solid #ccc' }}>\\n      滑动我\\n    </div>\\n  );\\n}\\n```\\n\\n### 5.6 平台适配器\\n\\n```typescript\\nimport { usePlatformAdapter } from './lib/integration/multi-platform-adapter';\\n\\nfunction PlatformAdapterComponent() {\\n  const adapter = usePlatformAdapter();\\n\\n  const handleOpenURL = () => {\\n    adapter.openURL('https://example.com');\\n  };\\n\\n  const handleShare = () => {\\n    adapter.share({\\n      title: 'YYC³餐饮平台',\\n      description: '智能餐饮管理平台',\\n      url: 'https://yyc3.com',\\n    });\\n  };\\n\\n  const handleCopy = async () => {\\n    const success = await adapter.copyToClipboard('复制的内容');\\n    console.log('复制结果:', success);\\n  };\\n\\n  const handleVibrate = () => {\\n    adapter.vibrate(200);\\n  };\\n\\n  return (\\n    <div>\\n      <button onClick={handleOpenURL}>打开链接</button>\\n      <button onClick={handleShare}>分享</button>\\n      <button onClick={handleCopy}>复制</button>\\n      <button onClick={handleVibrate}>震动</button>\\n    </div>\\n  );\\n}\\n```\\n\\n---\\n\\n## 6. 跨维度数据交互与状态同步\\n\\n### 6.1 核心设计理念\\n\\n跨维度数据交互与状态同步基于以下核心设计理念：\\n\\n1. **事件驱动**: 基于事件驱动的数据交互机制\\n2. **实时同步**: 支持WebSocket实时数据推送\\n3. **离线队列**: 支持离线操作队列和自动同步\\n4. **冲突解决**: 提供灵活的冲突解决机制\\n5. **版本控制**: 支持数据版本控制和并发控制\\n\\n### 6.2 事件总线\\n\\n```typescript\\nimport { eventBus } from './lib/integration/cross-dimension-sync';\\n\\n// 监听事件\\neventBus.on('data:orders:created', (order) => {\\n  console.log('新订单创建:', order);\\n});\\n\\neventBus.on('data:orders:updated', (order) => {\\n  console.log('订单更新:', order);\\n});\\n\\neventBus.on('data:orders:deleted', (order) => {\\n  console.log('订单删除:', order);\\n});\\n\\n// 发送事件\\neventBus.emit('data:orders:created', orderData);\\n\\n// 取消监听\\neventBus.off('data:orders:created', handler);\\n```\\n\\n### 6.3 数据同步\\n\\n```typescript\\nimport { crossDimensionDataManager, DataSyncConfig } from './lib/integration/cross-dimension-sync';\\n\\n// 注册数据同步\\nconst config: DataSyncConfig = {\\n  entity: 'orders',\\n  endpoint: 'http://localhost:3000/api/orders',\\n  syncInterval: 5000,\\n  autoSync: true,\\n  conflictResolution: 'server',\\n  offlineSupport: true,\\n  realTime: true,\\n};\\n\\ncrossDimensionDataManager.register(config);\\n\\n// 创建数据\\nconst order = await crossDimensionDataManager.create('orders', {\\n  customerId: 'customer-123',\\n  items: [\\n    { productId: 'product-1', quantity: 2 },\\n  ],\\n});\\n\\n// 更新数据\\nconst updatedOrder = await crossDimensionDataManager.update('orders', order.id, {\\n  status: 'completed',\\n});\\n\\n// 删除数据\\nawait crossDimensionDataManager.delete('orders', order.id);\\n\\n// 获取同步状态\\nconst syncState = crossDimensionDataManager.getSyncState('orders');\\n\\n// 取消注册\\ncrossDimensionDataManager.unregister('orders');\\n```\\n\\n### 6.4 离线队列\\n\\n```typescript\\nimport { offlineQueueManager } from './lib/integration/cross-dimension-sync';\\n\\n// 添加离线操作\\nconst operationId = offlineQueueManager.add({\\n  operation: DataOperationType.CREATE,\\n  entity: 'orders',\\n  entityId: 'pending-123',\\n  data: orderData,\\n  maxRetries: 3,\\n});\\n\\n// 获取所有离线操作\\nconst operations = offlineQueueManager.getAll();\\n\\n// 同步离线队列\\nawait crossDimensionDataManager.syncOfflineQueue();\\n\\n// 清除离线队列\\nofflineQueueManager.clear();\\n```\\n\\n### 6.5 数据冲突\\n\\n```typescript\\nimport { dataConflictResolver } from './lib/integration/cross-dimension-sync';\\n\\n// 检测冲突\\nconst hasConflict = dataConflictResolver.detectConflict(localData, remoteData);\\n\\n// 创建冲突\\nconst conflict = dataConflictResolver.createConflict(\\n  'orders',\\n  'order-123',\\n  localData,\\n  remoteData\\n);\\n\\n// 解决冲突\\ndataConflictResolver.resolveConflict(conflict.id, 'local');\\ndataConflictResolver.resolveConflict(conflict.id, 'remote');\\ndataConflictResolver.resolveConflict(conflict.id, 'merge', mergedData);\\n\\n// 获取所有冲突\\nconst conflicts = dataConflictResolver.getConflicts();\\n```\\n\\n### 6.6 React Hooks\\n\\n```typescript\\nimport {\\n  useDataEvent,\\n  useSyncState,\\n  useOfflineQueue,\\n} from './lib/integration/cross-dimension-sync';\\n\\n// 使用数据事件\\nfunction OrderList() {\\n  const orders = useDataEvent('orders', DataOperationType.CREATE);\\n\\n  return (\\n    <div>\\n      {orders?.map(order => (\\n        <div key={order.id}>{order.id}</div>\\n      ))}\\n    </div>\\n  );\\n}\\n\\n// 使用同步状态\\nfunction SyncStatus() {\\n  const syncState = useSyncState('orders');\\n\\n  return (\\n    <div>\\n      同步状态: {syncState}\\n    </div>\\n  );\\n}\\n\\n// 使用离线队列\\nfunction OfflineQueue() {\\n  const { operations, size, syncQueue } = useOfflineQueue();\\n\\n  return (\\n    <div>\\n      <div>离线操作数量: {size}</div>\\n      <button onClick={syncQueue}>同步离线操作</button>\\n      <ul>\\n        {operations.map(op => (\\n          <li key={op.id}>{op.operation} - {op.entity}</li>\\n        ))}\\n      </ul>\\n    </div>\\n  );\\n}\\n```\\n\\n---\\n\\n## 7. 最佳实践\\n\\n### 7.1 API调用最佳实践\\n\\n1. **使用React Hooks**: 优先使用`useApi`、`useApiMutation`等React Hooks\\n2. **错误处理**: 始终处理API错误，提供友好的错误提示\\n3. **加载状态**: 显示加载状态，提升用户体验\\n4. **缓存策略**: 合理使用缓存，减少不必要的API调用\\n5. **请求重试**: 利用自动重试机制，提升系统稳定性\\n\\n### 7.2 状态管理最佳实践\\n\\n1. **单一数据源**: 每个数据实体只使用一个状态管理器\\n2. **不可变更新**: 使用Zustand的immer中间件进行不可变更新\\n3. **持久化**: 合理使用持久化中间件，保存重要状态\\n4. **状态分割**: 将状态按功能模块分割，避免状态过大\\n5. **订阅清理**: 及时清理事件订阅，避免内存泄漏\\n\\n### 7.3 多端适配最佳实践\\n\\n1. **移动优先**: 采用移动优先的设计策略\\n2. **响应式设计**: 使用响应式断点和媒体查询\\n3. **触摸友好**: 确保触摸目标足够大（至少44x44px）\\n4. **性能优化**: 针对移动设备进行性能优化\\n5. **平台特性**: 利用平台特性，提供更好的用户体验\\n\\n### 7.4 数据同步最佳实践\\n\\n1. **实时优先**: 优先使用实时数据同步\\n2. **离线支持**: 提供离线支持，提升用户体验\\n3. **冲突解决**: 提供合理的冲突解决机制\\n4. **版本控制**: 使用版本控制，避免数据冲突\\n5. **错误恢复**: 提供错误恢复机制，确保数据一致性\\n\\n---\\n\\n## 8. 总结\\n\\nYYC³餐饮行业智能化平台的系统集成架构实现了以下核心目标：\\n\\n1. **无缝对接**: UI层与业务逻辑层的无缝对接，消除了数据孤岛\\n2. **深度集成**: 数据层与UI层的深度集成，提供了统一的数据访问接口\\n3. **多端适配**: Web端、移动端、小程序等多终端的一致用户体验\\n4. **实时同步**: 跨维度数据交互与状态同步，确保了数据一致性\\n5. **离线支持**: 离线数据处理和自动同步，提升了用户体验\\n\\n通过这套完整的系统集成架构，整个系统在功能实现、用户体验和技术架构上形成了有机整体，为后续的业务扩展和技术升级奠定了坚实的基础。\\n\\n---\\n\\n**文档版本**: v1.0.0\\n**最后更新**: 2026-01-21\\n**文档状态**: 正式发布\\n\",\"originTextLength\":19840,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768983181958}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/docs/YYC3-CP-%E6%9E%B6%E6%9E%84%E8%AE%BE%E8%AE%A1/YYC3-%E7%B3%BB%E7%BB%9F%E9%9B%86%E6%88%90%E6%8C%87%E5%8D%97.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":663,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":663,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# YYC³餐饮行业智能化平台 - 系统集成指南\\\\n\\\\n## 文档信息\\\\n\\\\n| 项目 | 内容 |\\\\n|-----|------|\\\\n| 文档编号 | YYC3-AICP-SIG-001 |\\\\n| 文档名称 | 系统集成指南 |\\\\n| 版本号 | v1.0.0 |\\\\n| 创建日期 | 2026-01-21 |\\\\n| 最后更新 | 2026-01-21 |\\\\n| 文档状态 | 正式发布 |\\\\n| 作者 | YYC³ |\\\\n\\\\n---\\\\n\\\\n## 1. 快速开始\\\\n\\\\n### 1.1 安装依赖\\\\n\\\\n```bash\\\\n# 安装必要的依赖\\\\nnpm install zustand immer\\\\nnpm install -D @types/node\\\\n```\\\\n\\\\n### 1.2 配置环境变量\\\\n\\\\n在`.env.local`文件中添加以下环境变量：\\\\n\\\\n```env\\\\n# API基础URL\\\\nNEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api\\\\n\\\\n# WebSocket基础URL\\\\nNEXT_PUBLIC_WS_BASE_URL=ws://localhost:3000\\\\n\\\\n# 租户ID（可选）\\\\nNEXT_PUBLIC_TENANT_ID=your-tenant-id\\\\n```\\\\n\\\\n### 1.3 初始化API客户端\\\\n\\\\n```typescript\\\\nimport { apiClient } from \\\\'@/lib/integration/ui-business-integration\\\\';\\\\n\\\\n// 设置认证令牌\\\\napiClient.setToken(\\\\'your-jwt-token\\\\');\\\\n\\\\n// 设置租户ID\\\\napiClient.setTenantId(\\\\'your-tenant-id\\\\');\\\\n```\\\\n\\\\n---\\\\n\\\\n## 2. UI层与业务逻辑层集成\\\\n\\\\n### 2.1 基础API调用\\\\n\\\\n#### 2.1.1 使用API客户端\\\\n\\\\n```typescript\\\\nimport { apiClient } from \\\\'@/lib/integration/ui-business-integration\\\\';\\\\n\\\\n// GET请求\\\\nconst response = await apiClient.get(\\\\'/orders\\\\');\\\\nif (response.success) {\\\\n  console.log(response.data);\\\\n}\\\\n\\\\n// POST请求\\\\nconst response = await apiClient.post(\\\\'/orders\\\\', {\\\\n  customerId: \\\\'customer-123\\\\',\\\\n  items: [\\\\n    { productId: \\\\'product-1\\\\', quantity: 2 },\\\\n  ],\\\\n});\\\\n\\\\n// PUT请求\\\\nconst response = await apiClient.put(\\\\'/orders/123\\\\', {\\\\n  status: \\\\'completed\\\\',\\\\n});\\\\n\\\\n// DELETE请求\\\\nconst response = await apiClient.delete(\\\\'/orders/123\\\\');\\\\n```\\\\n\\\\n#### 2.1.2 使用React Hooks\\\\n\\\\n```typescript\\\\nimport { useApi, useApiMutation } from \\\\'@/lib/integration/ui-business-integration\\\\';\\\\n\\\\n// 使用API数据\\\\nfunction OrderList() {\\\\n  const { data, loading, error, refetch } = useApi(\\\\'/orders\\\\');\\\\n\\\\n  if (loading) return <div>加载中...</div>;\\\\n  if (error) return <div>加载失败: {error.message}</div>;\\\\n\\\\n  return (\\\\n    <div>\\\\n      {data?.map(order => (\\\\n        <div key={order.id}>{order.id}</div>\\\\n      ))}\\\\n      <button onClick={refetch}>刷新</button>\\\\n    </div>\\\\n  );\\\\n}\\\\n\\\\n// 使用API操作\\\\nfunction CreateOrder() {\\\\n  const { mutate, loading, error } = useApiMutation(\\\\'/orders\\\\', \\\\'POST\\\\');\\\\n\\\\n  const handleSubmit = async (orderData) => {\\\\n    const response = await mutate(orderData);\\\\n    if (response.success) {\\\\n      console.log(\\\\'订单创建成功\\\\');\\\\n    }\\\\n  };\\\\n\\\\n  return (\\\\n    <form onSubmit={handleSubmit}>\\\\n      <button disabled={loading} type=\\\\\\\"submit\\\\\\\">\\\\n        {loading ? \\\\'提交中...\\\\' : \\\\'创建订单\\\\'}\\\\n      </button>\\\\n    </form>\\\\n  );\\\\n}\\\\n```\\\\n\\\\n### 2.2 业务服务层\\\\n\\\\n```typescript\\\\nimport { orderService, menuService, userService } from \\\\'@/lib/integration/ui-business-integration\\\\';\\\\n\\\\n// 订单服务\\\\nasync function fetchOrders() {\\\\n  const response = await orderService.getOrders({\\\\n    page: 1,\\\\n    pageSize: 20,\\\\n    status: \\\\'pending\\\\',\\\\n  });\\\\n\\\\n  if (response.success) {\\\\n    return response.data;\\\\n  }\\\\n}\\\\n\\\\nasync function createOrder(orderData) {\\\\n  const response = await orderService.createOrder(orderData);\\\\n\\\\n  if (response.success) {\\\\n    return response.data;\\\\n  }\\\\n}\\\\n\\\\n// 菜单服务\\\\nasync function fetchMenus() {\\\\n  const response = await menuService.getMenus({\\\\n    page: 1,\\\\n    pageSize: 20,\\\\n    category: \\\\'main\\\\',\\\\n  });\\\\n\\\\n  if (response.success) {\\\\n    return response.data;\\\\n  }\\\\n}\\\\n\\\\n// 用户服务\\\\nasync function login(email, password) {\\\\n  const response = await userService.login({ email, password });\\\\n\\\\n  if (response.success) {\\\\n    const { token, user } = response.data;\\\\n    apiClient.setToken(token);\\\\n    return user;\\\\n  }\\\\n}\\\\n```\\\\n\\\\n### 2.3 实时数据\\\\n\\\\n```typescript\\\\nimport { useRealtimeData } from \\\\'@/lib/integration/ui-business-integration\\\\';\\\\n\\\\n// 使用实时数据\\\\nfunction RealtimeOrderList() {\\\\n  const { data, connected } = useRealtimeData(\\\\'ws://localhost:3000/orders\\\\');\\\\n\\\\n  return (\\\\n    <div>\\\\n      <div>连接状态: {connected ? \\\\'已连接\\\\' : \\\\'未连接\\\\'}</div>\\\\n      {data?.map(order => (\\\\n        <div key={order.id}>{order.id}</div>\\\\n      ))}\\\\n    </div>\\\\n  );\\\\n}\\\\n```\\\\n\\\\n---\\\\n\\\\n## 3. 数据层与UI层集成\\\\n\\\\n### 3.1 缓存管理\\\\n\\\\n#### 3.1.1 使用缓存管理器\\\\n\\\\n```typescript\\\\nimport { cacheManager, CacheStrategy } from \\\\'@/lib/integration/data-layer-integration\\\\';\\\\n\\\\n// 内存缓存\\\\nawait cacheManager.set(\\\\'user:123\\\\', userData, {\\\\n  key: \\\\'user:123\\\\',\\\\n  strategy: CacheStrategy.MEMORY,\\\\n  ttl: 3600000, // 1小时\\\\n  version: \\\\'1.0\\\\',\\\\n});\\\\n\\\\nconst cachedUser = await cacheManager.get(\\\\'user:123\\\\', CacheStrategy.MEMORY);\\\\n\\\\n// IndexedDB缓存\\\\nawait cacheManager.set(\\\\'orders:page:1\\\\', ordersData, {\\\\n  key: \\\\'orders:page:1\\\\',\\\\n  strategy: CacheStrategy.INDEXED_DB,\\\\n  ttl: 1800000, // 30分钟\\\\n  version: \\\\'1.0\\\\',\\\\n});\\\\n\\\\nconst cachedOrders = await cacheManager.get(\\\\'orders:page:1\\\\', CacheStrategy.INDEXED_DB);\\\\n\\\\n// LocalStorage缓存\\\\nawait cacheManager.set(\\\\'theme\\\\', \\\\'dark\\\\', {\\\\n  key: \\\\'theme\\\\',\\\\n  strategy: CacheStrategy.LOCAL_STORAGE,\\\\n  ttl: 86400000, // 24小时\\\\n  version: \\\\'1.0\\\\',\\\\n});\\\\n\\\\nconst cachedTheme = await cacheManager.get(\\\\'theme\\\\', CacheStrategy.LOCAL_STORAGE);\\\\n```\\\\n\\\\n#### 3.1.2 使用React Hooks\\\\n\\\\n```typescript\\\\nimport { useCachedData } from \\\\'@/lib/integration/data-layer-integration\\\\';\\\\n\\\\n// 使用缓存数据\\\\nfunction UserProfile({ userId }) {\\\\n  const { data, loading, error, refresh, invalidate } = useCachedData(\\\\n    `user:${userId}`,\\\\n    () => fetchUser(userId),\\\\n    {\\\\n      key: `user:${userId}`,\\\\n      strategy: CacheStrategy.MEMORY,\\\\n      ttl: 3600000,\\\\n      version: \\\\'1.0\\\\',\\\\n    }\\\\n  );\\\\n\\\\n  return (\\\\n    <div>\\\\n      {loading && <div>加载中...</div>}\\\\n      {error && <div>加载失败: {error.message}</div>}\\\\n      {data && (\\\\n        <div>\\\\n          <h1>{data.name}</h1>\\\\n          <p>{data.email}</p>\\\\n          <button onClick={refresh}>刷新</button>\\\\n          <button onClick={invalidate}>清除缓存</button>\\\\n        </div>\\\\n      )}\\\\n    </div>\\\\n  );\\\\n}\\\\n```\\\\n\\\\n### 3.2 状态管理\\\\n\\\\n#### 3.2.1 应用状态\\\\n\\\\n```typescript\\\\nimport { useAppStore } from \\\\'@/lib/integration/data-layer-integration\\\\';\\\\n\\\\nfunction App() {\\\\n  const { user, tenant, theme, language, setUser, setTenant, setTheme, setLanguage } = useAppStore();\\\\n\\\\n  useEffect(() => {\\\\n    // 初始化用户信息\\\\n    setUser({\\\\n      id: \\\\'user-123\\\\',\\\\n      name: \\\\'张三\\\\',\\\\n      email: \\\\'zhangsan@example.com\\\\',\\\\n      role: \\\\'admin\\\\',\\\\n    });\\\\n\\\\n    // 初始化租户信息\\\\n    setTenant({\\\\n      id: \\\\'tenant-123\\\\',\\\\n      name: \\\\'YYC³餐饮\\\\',\\\\n      config: {},\\\\n    });\\\\n  }, []);\\\\n\\\\n  return (\\\\n    <div>\\\\n      <h1>欢迎, {user?.name}</h1>\\\\n      <button onClick={() => setTheme(theme === \\\\'light\\\\' ? \\\\'dark\\\\' : \\\\'light\\\\')}>\\\\n        切换主题\\\\n      </button>\\\\n      <button onClick={() => setLanguage(language === \\\\'zh-CN\\\\' ? \\\\'en-US\\\\' : \\\\'zh-CN\\\\')}>\\\\n        切换语言\\\\n      </button>\\\\n    </div>\\\\n  );\\\\n}\\\\n```\\\\n\\\\n#### 3.2.2 订单状态\\\\n\\\\n```typescript\\\\nimport { useOrderStore } from \\\\'@/lib/integration/data-layer-integration\\\\';\\\\n\\\\nfunction OrderList() {\\\\n  const { orders, loading, error, addOrder, updateOrder, removeOrder } = useOrderStore();\\\\n\\\\n  const handleAddOrder = async (orderData) => {\\\\n    const response = await apiClient.post(\\\\'/orders\\\\', orderData);\\\\n    if (response.success) {\\\\n      addOrder(response.data);\\\\n    }\\\\n  };\\\\n\\\\n  const handleUpdateOrder = async (orderId, updates) => {\\\\n    const response = await apiClient.put(`/orders/${orderId}`, updates);\\\\n    if (response.success) {\\\\n      updateOrder(orderId, updates);\\\\n    }\\\\n  };\\\\n\\\\n  const handleRemoveOrder = async (orderId) => {\\\\n    const response = await apiClient.delete(`/orders/${orderId}`);\\\\n    if (response.success) {\\\\n      removeOrder(orderId);\\\\n    }\\\\n  };\\\\n\\\\n  return (\\\\n    <div>\\\\n      {orders.map(order => (\\\\n        <div key={order.id}>\\\\n          <span>{order.id}</span>\\\\n          <button onClick={() => handleUpdateOrder(order.id, { status: \\\\'completed\\\\' })}>\\\\n            完成\\\\n          </button>\\\\n          <button onClick={() => handleRemoveOrder(order.id)}>\\\\n            删除\\\\n          </button>\\\\n        </div>\\\\n      ))}\\\\n    </div>\\\\n  );\\\\n}\\\\n```\\\\n\\\\n---\\\\n\\\\n## 4. 多端适配\\\\n\\\\n### 4.1 设备信息\\\\n\\\\n```typescript\\\\nimport { useDeviceInfo, usePlatformInfo } from \\\\'@/lib/integration/multi-platform-adapter\\\\';\\\\n\\\\nfunction DeviceInfo() {\\\\n  const deviceInfo = useDeviceInfo();\\\\n  const platformInfo = usePlatformInfo();\\\\n\\\\n  return (\\\\n    <div>\\\\n      <div>设备类型: {deviceInfo.type}</div>\\\\n      <div>屏幕尺寸: {deviceInfo.width} x {deviceInfo.height}</div>\\\\n      <div>方向: {deviceInfo.orientation}</div>\\\\n      <div>触摸设备: {deviceInfo.isTouch ? \\\\'是\\\\' : \\\\'否\\\\'}</div>\\\\n      <div>平台: {platformInfo.name}</div>\\\\n      <div>操作系统: {platformInfo.os}</div>\\\\n      <div>浏览器: {platformInfo.browser}</div>\\\\n    </div>\\\\n  );\\\\n}\\\\n```\\\\n\\\\n### 4.2 响应式断点\\\\n\\\\n```typescript\\\\nimport { useBreakpoint, useResponsive } from \\\\'@/lib/integration/multi-platform-adapter\\\\';\\\\n\\\\nfunction ResponsiveComponent() {\\\\n  const breakpoint = useBreakpoint();\\\\n\\\\n  const columns = useResponsive({\\\\n    xs: 1,\\\\n    sm: 2,\\\\n    md: 3,\\\\n    lg: 4,\\\\n    xl: 5,\\\\n    \\\\'2xl\\\\': 6,\\\\n  });\\\\n\\\\n  return (\\\\n    <div>\\\\n      <div>当前断点: {breakpoint}</div>\\\\n      <div>列数: {columns}</div>\\\\n      <div style={{ display: \\\\'grid\\\\', gridTemplateColumns: `repeat(${columns}, 1fr)` }}>\\\\n        {/* 渲染内容 */}\\\\n      </div>\\\\n    </div>\\\\n  );\\\\n}\\\\n```\\\\n\\\\n### 4.3 媒体查询\\\\n\\\\n```typescript\\\\nimport { useMediaQuery } from \\\\'@/lib/integration/multi-platform-adapter\\\\';\\\\n\\\\nfunction MediaQueryComponent() {\\\\n  const isMobile = useMediaQuery(\\\\'(max-width: 768px)\\\\');\\\\n  const isTablet = useMediaQuery(\\\\'(min-width: 769px) and (max-width: 1024px)\\\\');\\\\n  const isDesktop = useMediaQuery(\\\\'(min-width: 1025px)\\\\');\\\\n\\\\n  return (\\\\n    <div>\\\\n      {isMobile && <div>移动端布局</div>}\\\\n      {isTablet && <div>平板端布局</div>}\\\\n      {isDesktop && <div>桌面端布局</div>}\\\\n    </div>\\\\n  );\\\\n}\\\\n```\\\\n\\\\n### 4.4 触摸手势\\\\n\\\\n```typescript\\\\nimport { useTouchGesture } from \\\\'@/lib/integration/multi-platform-adapter\\\\';\\\\n\\\\nfunction SwipeableCard() {\\\\n  const ref = useRef<HTMLDivElement>(null);\\\\n\\\\n  useTouchGesture(ref, {\\\\n    onSwipeLeft: () => console.log(\\\\'向左滑动\\\\'),\\\\n    onSwipeRight: () => console.log(\\\\'向右滑动\\\\'),\\\\n    onSwipeUp: () => console.log(\\\\'向上滑动\\\\'),\\\\n    onSwipeDown: () => console.log(\\\\'向下滑动\\\\'),\\\\n    onTap: () => console.log(\\\\'点击\\\\'),\\\\n    onLongPress: () => console.log(\\\\'长按\\\\'),\\\\n  });\\\\n\\\\n  return (\\\\n    <div ref={ref} style={{ padding: \\\\'20px\\\\', border: \\\\'1px solid #ccc\\\\' }}>\\\\n      滑动我\\\\n    </div>\\\\n  );\\\\n}\\\\n```\\\\n\\\\n### 4.5 平台适配器\\\\n\\\\n```typescript\\\\nimport { usePlatformAdapter } from \\\\'@/lib/integration/multi-platform-adapter\\\\';\\\\n\\\\nfunction PlatformAdapterComponent() {\\\\n  const adapter = usePlatformAdapter();\\\\n\\\\n  const handleOpenURL = () => {\\\\n    adapter.openURL(\\\\'https://example.com\\\\');\\\\n  };\\\\n\\\\n  const handleShare = () => {\\\\n    adapter.share({\\\\n      title: \\\\'YYC³餐饮平台\\\\',\\\\n      description: \\\\'智能餐饮管理平台\\\\',\\\\n      url: \\\\'https://yyc3.com\\\\',\\\\n    });\\\\n  };\\\\n\\\\n  const handleCopy = async () => {\\\\n    const success = await adapter.copyToClipboard(\\\\'复制的内容\\\\');\\\\n    console.log(\\\\'复制结果:\\\\', success);\\\\n  };\\\\n\\\\n  const handleVibrate = () => {\\\\n    adapter.vibrate(200);\\\\n  };\\\\n\\\\n  return (\\\\n    <div>\\\\n      <button onClick={handleOpenURL}>打开链接</button>\\\\n      <button onClick={handleShare}>分享</button>\\\\n      <button onClick={handleCopy}>复制</button>\\\\n      <button onClick={handleVibrate}>震动</button>\\\\n    </div>\\\\n  );\\\\n}\\\\n```\\\\n\\\\n---\\\\n\\\\n## 5. 跨维度数据交互与状态同步\\\\n\\\\n### 5.1 事件总线\\\\n\\\\n```typescript\\\\nimport { eventBus } from \\\\'@/lib/integration/cross-dimension-sync\\\\';\\\\n\\\\n// 监听事件\\\\neventBus.on(\\\\'data:orders:created\\\\', (order) => {\\\\n  console.log(\\\\'新订单创建:\\\\', order);\\\\n});\\\\n\\\\neventBus.on(\\\\'data:orders:updated\\\\', (order) => {\\\\n  console.log(\\\\'订单更新:\\\\', order);\\\\n});\\\\n\\\\neventBus.on(\\\\'data:orders:deleted\\\\', (order) => {\\\\n  console.log(\\\\'订单删除:\\\\', order);\\\\n});\\\\n\\\\n// 发送事件\\\\neventBus.emit(\\\\'data:orders:created\\\\', orderData);\\\\n\\\\n// 取消监听\\\\neventBus.off(\\\\'data:orders:created\\\\', handler);\\\\n```\\\\n\\\\n### 5.2 数据同步\\\\n\\\\n```typescript\\\\nimport { crossDimensionDataManager, DataSyncConfig } from \\\\'@/lib/integration/cross-dimension-sync\\\\';\\\\n\\\\n// 注册数据同步\\\\nconst config: DataSyncConfig = {\\\\n  entity: \\\\'orders\\\\',\\\\n  endpoint: \\\\'http://localhost:3000/api/orders\\\\',\\\\n  syncInterval: 5000,\\\\n  autoSync: true,\\\\n  conflictResolution: \\\\'server\\\\',\\\\n  offlineSupport: true,\\\\n  realTime: true,\\\\n};\\\\n\\\\ncrossDimensionDataManager.register(config);\\\\n\\\\n// 创建数据\\\\nconst order = await crossDimensionDataManager.create(\\\\'orders\\\\', {\\\\n  customerId: \\\\'customer-123\\\\',\\\\n  items: [\\\\n    { productId: \\\\'product-1\\\\', quantity: 2 },\\\\n  ],\\\\n});\\\\n\\\\n// 更新数据\\\\nconst updatedOrder = await crossDimensionDataManager.update(\\\\'orders\\\\', order.id, {\\\\n  status: \\\\'completed\\\\',\\\\n});\\\\n\\\\n// 删除数据\\\\nawait crossDimensionDataManager.delete(\\\\'orders\\\\', order.id);\\\\n\\\\n// 获取同步状态\\\\nconst syncState = crossDimensionDataManager.getSyncState(\\\\'orders\\\\');\\\\n\\\\n// 取消注册\\\\ncrossDimensionDataManager.unregister(\\\\'orders\\\\');\\\\n```\\\\n\\\\n### 5.3 离线队列\\\\n\\\\n```typescript\\\\nimport { offlineQueueManager } from \\\\'@/lib/integration/cross-dimension-sync\\\\';\\\\n\\\\n// 添加离线操作\\\\nconst operationId = offlineQueueManager.add({\\\\n  operation: DataOperationType.CREATE,\\\\n  entity: \\\\'orders\\\\',\\\\n  entityId: \\\\'pending-123\\\\',\\\\n  data: orderData,\\\\n  maxRetries: 3,\\\\n});\\\\n\\\\n// 获取所有离线操作\\\\nconst operations = offlineQueueManager.getAll();\\\\n\\\\n// 同步离线队列\\\\nawait crossDimensionDataManager.syncOfflineQueue();\\\\n\\\\n// 清除离线队列\\\\nofflineQueueManager.clear();\\\\n```\\\\n\\\\n### 5.4 React Hooks\\\\n\\\\n```typescript\\\\nimport {\\\\n  useDataEvent,\\\\n  useSyncState,\\\\n  useOfflineQueue,\\\\n} from \\\\'@/lib/integration/cross-dimension-sync\\\\';\\\\n\\\\n// 使用数据事件\\\\nfunction OrderList() {\\\\n  const orders = useDataEvent(\\\\'orders\\\\', DataOperationType.CREATE);\\\\n\\\\n  return (\\\\n    <div>\\\\n      {orders?.map(order => (\\\\n        <div key={order.id}>{order.id}</div>\\\\n      ))}\\\\n    </div>\\\\n  );\\\\n}\\\\n\\\\n// 使用同步状态\\\\nfunction SyncStatus() {\\\\n  const syncState = useSyncState(\\\\'orders\\\\');\\\\n\\\\n  return (\\\\n    <div>\\\\n      同步状态: {syncState}\\\\n    </div>\\\\n  );\\\\n}\\\\n\\\\n// 使用离线队列\\\\nfunction OfflineQueue() {\\\\n  const { operations, size, syncQueue } = useOfflineQueue();\\\\n\\\\n  return (\\\\n    <div>\\\\n      <div>离线操作数量: {size}</div>\\\\n      <button onClick={syncQueue}>同步离线操作</button>\\\\n      <ul>\\\\n        {operations.map(op => (\\\\n          <li key={op.id}>{op.operation} - {op.entity}</li>\\\\n        ))}\\\\n      </ul>\\\\n    </div>\\\\n  );\\\\n}\\\\n```\\\\n\\\\n---\\\\n\\\\n## 6. 完整示例\\\\n\\\\n### 6.1 订单管理页面\\\\n\\\\n```typescript\\\\nimport { useState, useEffect } from \\\\'react\\\\';\\\\nimport { useApi, useApiMutation } from \\\\'@/lib/integration/ui-business-integration\\\\';\\\\nimport { useOrderStore } from \\\\'@/lib/integration/data-layer-integration\\\\';\\\\nimport { useCachedData } from \\\\'@/lib/integration/data-layer-integration\\\\';\\\\nimport { useBreakpoint } from \\\\'@/lib/integration/multi-platform-adapter\\\\';\\\\nimport { useDataEvent } from \\\\'@/lib/integration/cross-dimension-sync\\\\';\\\\n\\\\nfunction OrderManagementPage() {\\\\n  const breakpoint = useBreakpoint();\\\\n  const { orders, addOrder, updateOrder, removeOrder } = useOrderStore();\\\\n  \\\\n  const { data, loading, error, refetch } = useCachedData(\\\\n    \\\\'orders:page:1\\\\',\\\\n    () => apiClient.get(\\\\'/orders\\\\'),\\\\n    {\\\\n      key: \\\\'orders:page:1\\\\',\\\\n      strategy: CacheStrategy.MEMORY,\\\\n      ttl: 300000,\\\\n      version: \\\\'1.0\\\\',\\\\n    }\\\\n  );\\\\n\\\\n  const { mutate: createOrder, loading: creating } = useApiMutation(\\\\'/orders\\\\', \\\\'POST\\\\');\\\\n\\\\n  const newOrder = useDataEvent(\\\\'orders\\\\', DataOperationType.CREATE);\\\\n\\\\n  useEffect(() => {\\\\n    if (newOrder) {\\\\n      addOrder(newOrder);\\\\n    }\\\\n  }, [newOrder, addOrder]);\\\\n\\\\n  const handleCreateOrder = async (orderData) => {\\\\n    const response = await createOrder(orderData);\\\\n    if (response.success) {\\\\n      addOrder(response.data);\\\\n    }\\\\n  };\\\\n\\\\n  const handleUpdateOrder = async (orderId, updates) => {\\\\n    const response = await apiClient.put(`/orders/${orderId}`, updates);\\\\n    if (response.success) {\\\\n      updateOrder(orderId, updates);\\\\n    }\\\\n  };\\\\n\\\\n  const handleRemoveOrder = async (orderId) => {\\\\n    const response = await apiClient.delete(`/orders/${orderId}`);\\\\n    if (response.success) {\\\\n      removeOrder(orderId);\\\\n    }\\\\n  };\\\\n\\\\n  if (loading) return <div>加载中...</div>;\\\\n  if (error) return <div>加载失败: {error.message}</div>;\\\\n\\\\n  return (\\\\n    <div>\\\\n      <h1>订单管理</h1>\\\\n      <div>当前断点: {breakpoint}</div>\\\\n      <button onClick={refetch}>刷新</button>\\\\n      <button onClick={() => handleCreateOrder({ customerId: \\\\'customer-123\\\\', items: [] })}>\\\\n        创建订单\\\\n      </button>\\\\n      <div style={{ display: \\\\'grid\\\\', gridTemplateColumns: breakpoint === \\\\'xs\\\\' ? \\\\'1fr\\\\' : \\\\'repeat(3, 1fr)\\\\' }}>\\\\n        {orders.map(order => (\\\\n          <div key={order.id} style={{ padding: \\\\'10px\\\\', border: \\\\'1px solid #ccc\\\\' }}>\\\\n            <h3>订单 #{order.id}</h3>\\\\n            <p>状态: {order.status}</p>\\\\n            <button onClick={() => handleUpdateOrder(order.id, { status: \\\\'completed\\\\' })}>\\\\n              完成\\\\n            </button>\\\\n            <button onClick={() => handleRemoveOrder(order.id)}>\\\\n              删除\\\\n            </button>\\\\n          </div>\\\\n        ))}\\\\n      </div>\\\\n    </div>\\\\n  );\\\\n}\\\\n\\\\nexport default OrderManagementPage;\\\\n```\\\\n\\\\n---\\\\n\\\\n## 7. 常见问题\\\\n\\\\n### 7.1 如何处理API错误？\\\\n\\\\n```typescript\\\\nconst { data, loading, error } = useApi(\\\\'/orders\\\\');\\\\n\\\\nif (error) {\\\\n  // 显示错误信息\\\\n  return <div>错误: {error.message}</div>;\\\\n}\\\\n```\\\\n\\\\n### 7.2 如何实现离线支持？\\\\n\\\\n```typescript\\\\nimport { offlineQueueManager } from \\\\'@/lib/integration/cross-dimension-sync\\\\';\\\\n\\\\n// 添加离线操作\\\\nofflineQueueManager.add({\\\\n  operation: DataOperationType.CREATE,\\\\n  entity: \\\\'orders\\\\',\\\\n  entityId: \\\\'pending-123\\\\',\\\\n  data: orderData,\\\\n  maxRetries: 3,\\\\n});\\\\n\\\\n// 同步离线操作\\\\nawait crossDimensionDataManager.syncOfflineQueue();\\\\n```\\\\n\\\\n### 7.3 如何实现实时数据更新？\\\\n\\\\n```typescript\\\\nimport { useRealtimeData } from \\\\'@/lib/integration/ui-business-integration\\\\';\\\\n\\\\nfunction RealtimeOrderList() {\\\\n  const { data, connected } = useRealtimeData(\\\\'ws://localhost:3000/orders\\\\');\\\\n\\\\n  return (\\\\n    <div>\\\\n      <div>连接状态: {connected ? \\\\'已连接\\\\' : \\\\'未连接\\\\'}</div>\\\\n      {data?.map(order => (\\\\n        <div key={order.id}>{order.id}</div>\\\\n      ))}\\\\n    </div>\\\\n  );\\\\n}\\\\n```\\\\n\\\\n### 7.4 如何实现响应式布局？\\\\n\\\\n```typescript\\\\nimport { useBreakpoint, useResponsive } from \\\\'@/lib/integration/multi-platform-adapter\\\\';\\\\n\\\\nfunction ResponsiveComponent() {\\\\n  const breakpoint = useBreakpoint();\\\\n  const columns = useResponsive({\\\\n    xs: 1,\\\\n    sm: 2,\\\\n    md: 3,\\\\n    lg: 4,\\\\n  });\\\\n\\\\n  return (\\\\n    <div style={{ display: \\\\'grid\\\\', gridTemplateColumns: `repeat(${columns}, 1fr)` }}>\\\\n      {/* 渲染内容 */}\\\\n    </div>\\\\n  );\\\\n}\\\\n```\\\\n\\\\n---\\\\n\\\\n## 8. 总结\\\\n\\\\nYYC³餐饮行业智能化平台的系统集成架构提供了完整的解决方案，包括：\\\\n\\\\n1. **UI层与业务逻辑层无缝对接**: 提供统一的API客户端和React Hooks\\\\n2. **数据层与UI层深度集成**: 提供多级缓存策略和统一状态管理\\\\n3. **多端适配策略**: 支持Web端、移动端、小程序等多终端\\\\n4. **跨维度数据交互与状态同步**: 提供实时数据同步和离线支持\\\\n\\\\n通过这套完整的系统集成架构，开发者可以快速构建高质量、高性能、高可用的餐饮管理应用。\\\\n\\\\n---\\\\n\\\\n**文档版本**: v1.0.0\\\\n**最后更新**: 2026-01-21\\\\n**文档状态**: 正式发布\\\\n\",\"originAcceptText\":\"# YYC³餐饮行业智能化平台 - 系统集成指南\\n\\n## 文档信息\\n\\n| 项目 | 内容 |\\n|-----|------|\\n| 文档编号 | YYC3-AICP-SIG-001 |\\n| 文档名称 | 系统集成指南 |\\n| 版本号 | v1.0.0 |\\n| 创建日期 | 2026-01-21 |\\n| 最后更新 | 2026-01-21 |\\n| 文档状态 | 正式发布 |\\n| 作者 | YYC³ |\\n\\n---\\n\\n## 1. 快速开始\\n\\n### 1.1 安装依赖\\n\\n```bash\\n# 安装必要的依赖\\nnpm install zustand immer\\nnpm install -D @types/node\\n```\\n\\n### 1.2 配置环境变量\\n\\n在`.env.local`文件中添加以下环境变量：\\n\\n```env\\n# API基础URL\\nNEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api\\n\\n# WebSocket基础URL\\nNEXT_PUBLIC_WS_BASE_URL=ws://localhost:3000\\n\\n# 租户ID（可选）\\nNEXT_PUBLIC_TENANT_ID=your-tenant-id\\n```\\n\\n### 1.3 初始化API客户端\\n\\n```typescript\\nimport { apiClient } from '@/lib/integration/ui-business-integration';\\n\\n// 设置认证令牌\\napiClient.setToken('your-jwt-token');\\n\\n// 设置租户ID\\napiClient.setTenantId('your-tenant-id');\\n```\\n\\n---\\n\\n## 2. UI层与业务逻辑层集成\\n\\n### 2.1 基础API调用\\n\\n#### 2.1.1 使用API客户端\\n\\n```typescript\\nimport { apiClient } from '@/lib/integration/ui-business-integration';\\n\\n// GET请求\\nconst response = await apiClient.get('/orders');\\nif (response.success) {\\n  console.log(response.data);\\n}\\n\\n// POST请求\\nconst response = await apiClient.post('/orders', {\\n  customerId: 'customer-123',\\n  items: [\\n    { productId: 'product-1', quantity: 2 },\\n  ],\\n});\\n\\n// PUT请求\\nconst response = await apiClient.put('/orders/123', {\\n  status: 'completed',\\n});\\n\\n// DELETE请求\\nconst response = await apiClient.delete('/orders/123');\\n```\\n\\n#### 2.1.2 使用React Hooks\\n\\n```typescript\\nimport { useApi, useApiMutation } from '@/lib/integration/ui-business-integration';\\n\\n// 使用API数据\\nfunction OrderList() {\\n  const { data, loading, error, refetch } = useApi('/orders');\\n\\n  if (loading) return <div>加载中...</div>;\\n  if (error) return <div>加载失败: {error.message}</div>;\\n\\n  return (\\n    <div>\\n      {data?.map(order => (\\n        <div key={order.id}>{order.id}</div>\\n      ))}\\n      <button onClick={refetch}>刷新</button>\\n    </div>\\n  );\\n}\\n\\n// 使用API操作\\nfunction CreateOrder() {\\n  const { mutate, loading, error } = useApiMutation('/orders', 'POST');\\n\\n  const handleSubmit = async (orderData) => {\\n    const response = await mutate(orderData);\\n    if (response.success) {\\n      console.log('订单创建成功');\\n    }\\n  };\\n\\n  return (\\n    <form onSubmit={handleSubmit}>\\n      <button disabled={loading} type=\\\"submit\\\">\\n        {loading ? '提交中...' : '创建订单'}\\n      </button>\\n    </form>\\n  );\\n}\\n```\\n\\n### 2.2 业务服务层\\n\\n```typescript\\nimport { orderService, menuService, userService } from '@/lib/integration/ui-business-integration';\\n\\n// 订单服务\\nasync function fetchOrders() {\\n  const response = await orderService.getOrders({\\n    page: 1,\\n    pageSize: 20,\\n    status: 'pending',\\n  });\\n\\n  if (response.success) {\\n    return response.data;\\n  }\\n}\\n\\nasync function createOrder(orderData) {\\n  const response = await orderService.createOrder(orderData);\\n\\n  if (response.success) {\\n    return response.data;\\n  }\\n}\\n\\n// 菜单服务\\nasync function fetchMenus() {\\n  const response = await menuService.getMenus({\\n    page: 1,\\n    pageSize: 20,\\n    category: 'main',\\n  });\\n\\n  if (response.success) {\\n    return response.data;\\n  }\\n}\\n\\n// 用户服务\\nasync function login(email, password) {\\n  const response = await userService.login({ email, password });\\n\\n  if (response.success) {\\n    const { token, user } = response.data;\\n    apiClient.setToken(token);\\n    return user;\\n  }\\n}\\n```\\n\\n### 2.3 实时数据\\n\\n```typescript\\nimport { useRealtimeData } from '@/lib/integration/ui-business-integration';\\n\\n// 使用实时数据\\nfunction RealtimeOrderList() {\\n  const { data, connected } = useRealtimeData('ws://localhost:3000/orders');\\n\\n  return (\\n    <div>\\n      <div>连接状态: {connected ? '已连接' : '未连接'}</div>\\n      {data?.map(order => (\\n        <div key={order.id}>{order.id}</div>\\n      ))}\\n    </div>\\n  );\\n}\\n```\\n\\n---\\n\\n## 3. 数据层与UI层集成\\n\\n### 3.1 缓存管理\\n\\n#### 3.1.1 使用缓存管理器\\n\\n```typescript\\nimport { cacheManager, CacheStrategy } from '@/lib/integration/data-layer-integration';\\n\\n// 内存缓存\\nawait cacheManager.set('user:123', userData, {\\n  key: 'user:123',\\n  strategy: CacheStrategy.MEMORY,\\n  ttl: 3600000, // 1小时\\n  version: '1.0',\\n});\\n\\nconst cachedUser = await cacheManager.get('user:123', CacheStrategy.MEMORY);\\n\\n// IndexedDB缓存\\nawait cacheManager.set('orders:page:1', ordersData, {\\n  key: 'orders:page:1',\\n  strategy: CacheStrategy.INDEXED_DB,\\n  ttl: 1800000, // 30分钟\\n  version: '1.0',\\n});\\n\\nconst cachedOrders = await cacheManager.get('orders:page:1', CacheStrategy.INDEXED_DB);\\n\\n// LocalStorage缓存\\nawait cacheManager.set('theme', 'dark', {\\n  key: 'theme',\\n  strategy: CacheStrategy.LOCAL_STORAGE,\\n  ttl: 86400000, // 24小时\\n  version: '1.0',\\n});\\n\\nconst cachedTheme = await cacheManager.get('theme', CacheStrategy.LOCAL_STORAGE);\\n```\\n\\n#### 3.1.2 使用React Hooks\\n\\n```typescript\\nimport { useCachedData } from '@/lib/integration/data-layer-integration';\\n\\n// 使用缓存数据\\nfunction UserProfile({ userId }) {\\n  const { data, loading, error, refresh, invalidate } = useCachedData(\\n    `user:${userId}`,\\n    () => fetchUser(userId),\\n    {\\n      key: `user:${userId}`,\\n      strategy: CacheStrategy.MEMORY,\\n      ttl: 3600000,\\n      version: '1.0',\\n    }\\n  );\\n\\n  return (\\n    <div>\\n      {loading && <div>加载中...</div>}\\n      {error && <div>加载失败: {error.message}</div>}\\n      {data && (\\n        <div>\\n          <h1>{data.name}</h1>\\n          <p>{data.email}</p>\\n          <button onClick={refresh}>刷新</button>\\n          <button onClick={invalidate}>清除缓存</button>\\n        </div>\\n      )}\\n    </div>\\n  );\\n}\\n```\\n\\n### 3.2 状态管理\\n\\n#### 3.2.1 应用状态\\n\\n```typescript\\nimport { useAppStore } from '@/lib/integration/data-layer-integration';\\n\\nfunction App() {\\n  const { user, tenant, theme, language, setUser, setTenant, setTheme, setLanguage } = useAppStore();\\n\\n  useEffect(() => {\\n    // 初始化用户信息\\n    setUser({\\n      id: 'user-123',\\n      name: '张三',\\n      email: 'zhangsan@example.com',\\n      role: 'admin',\\n    });\\n\\n    // 初始化租户信息\\n    setTenant({\\n      id: 'tenant-123',\\n      name: 'YYC³餐饮',\\n      config: {},\\n    });\\n  }, []);\\n\\n  return (\\n    <div>\\n      <h1>欢迎, {user?.name}</h1>\\n      <button onClick={() => setTheme(theme === 'light' ? 'dark' : 'light')}>\\n        切换主题\\n      </button>\\n      <button onClick={() => setLanguage(language === 'zh-CN' ? 'en-US' : 'zh-CN')}>\\n        切换语言\\n      </button>\\n    </div>\\n  );\\n}\\n```\\n\\n#### 3.2.2 订单状态\\n\\n```typescript\\nimport { useOrderStore } from '@/lib/integration/data-layer-integration';\\n\\nfunction OrderList() {\\n  const { orders, loading, error, addOrder, updateOrder, removeOrder } = useOrderStore();\\n\\n  const handleAddOrder = async (orderData) => {\\n    const response = await apiClient.post('/orders', orderData);\\n    if (response.success) {\\n      addOrder(response.data);\\n    }\\n  };\\n\\n  const handleUpdateOrder = async (orderId, updates) => {\\n    const response = await apiClient.put(`/orders/${orderId}`, updates);\\n    if (response.success) {\\n      updateOrder(orderId, updates);\\n    }\\n  };\\n\\n  const handleRemoveOrder = async (orderId) => {\\n    const response = await apiClient.delete(`/orders/${orderId}`);\\n    if (response.success) {\\n      removeOrder(orderId);\\n    }\\n  };\\n\\n  return (\\n    <div>\\n      {orders.map(order => (\\n        <div key={order.id}>\\n          <span>{order.id}</span>\\n          <button onClick={() => handleUpdateOrder(order.id, { status: 'completed' })}>\\n            完成\\n          </button>\\n          <button onClick={() => handleRemoveOrder(order.id)}>\\n            删除\\n          </button>\\n        </div>\\n      ))}\\n    </div>\\n  );\\n}\\n```\\n\\n---\\n\\n## 4. 多端适配\\n\\n### 4.1 设备信息\\n\\n```typescript\\nimport { useDeviceInfo, usePlatformInfo } from '@/lib/integration/multi-platform-adapter';\\n\\nfunction DeviceInfo() {\\n  const deviceInfo = useDeviceInfo();\\n  const platformInfo = usePlatformInfo();\\n\\n  return (\\n    <div>\\n      <div>设备类型: {deviceInfo.type}</div>\\n      <div>屏幕尺寸: {deviceInfo.width} x {deviceInfo.height}</div>\\n      <div>方向: {deviceInfo.orientation}</div>\\n      <div>触摸设备: {deviceInfo.isTouch ? '是' : '否'}</div>\\n      <div>平台: {platformInfo.name}</div>\\n      <div>操作系统: {platformInfo.os}</div>\\n      <div>浏览器: {platformInfo.browser}</div>\\n    </div>\\n  );\\n}\\n```\\n\\n### 4.2 响应式断点\\n\\n```typescript\\nimport { useBreakpoint, useResponsive } from '@/lib/integration/multi-platform-adapter';\\n\\nfunction ResponsiveComponent() {\\n  const breakpoint = useBreakpoint();\\n\\n  const columns = useResponsive({\\n    xs: 1,\\n    sm: 2,\\n    md: 3,\\n    lg: 4,\\n    xl: 5,\\n    '2xl': 6,\\n  });\\n\\n  return (\\n    <div>\\n      <div>当前断点: {breakpoint}</div>\\n      <div>列数: {columns}</div>\\n      <div style={{ display: 'grid', gridTemplateColumns: `repeat(${columns}, 1fr)` }}>\\n        {/* 渲染内容 */}\\n      </div>\\n    </div>\\n  );\\n}\\n```\\n\\n### 4.3 媒体查询\\n\\n```typescript\\nimport { useMediaQuery } from '@/lib/integration/multi-platform-adapter';\\n\\nfunction MediaQueryComponent() {\\n  const isMobile = useMediaQuery('(max-width: 768px)');\\n  const isTablet = useMediaQuery('(min-width: 769px) and (max-width: 1024px)');\\n  const isDesktop = useMediaQuery('(min-width: 1025px)');\\n\\n  return (\\n    <div>\\n      {isMobile && <div>移动端布局</div>}\\n      {isTablet && <div>平板端布局</div>}\\n      {isDesktop && <div>桌面端布局</div>}\\n    </div>\\n  );\\n}\\n```\\n\\n### 4.4 触摸手势\\n\\n```typescript\\nimport { useTouchGesture } from '@/lib/integration/multi-platform-adapter';\\n\\nfunction SwipeableCard() {\\n  const ref = useRef<HTMLDivElement>(null);\\n\\n  useTouchGesture(ref, {\\n    onSwipeLeft: () => console.log('向左滑动'),\\n    onSwipeRight: () => console.log('向右滑动'),\\n    onSwipeUp: () => console.log('向上滑动'),\\n    onSwipeDown: () => console.log('向下滑动'),\\n    onTap: () => console.log('点击'),\\n    onLongPress: () => console.log('长按'),\\n  });\\n\\n  return (\\n    <div ref={ref} style={{ padding: '20px', border: '1px solid #ccc' }}>\\n      滑动我\\n    </div>\\n  );\\n}\\n```\\n\\n### 4.5 平台适配器\\n\\n```typescript\\nimport { usePlatformAdapter } from '@/lib/integration/multi-platform-adapter';\\n\\nfunction PlatformAdapterComponent() {\\n  const adapter = usePlatformAdapter();\\n\\n  const handleOpenURL = () => {\\n    adapter.openURL('https://example.com');\\n  };\\n\\n  const handleShare = () => {\\n    adapter.share({\\n      title: 'YYC³餐饮平台',\\n      description: '智能餐饮管理平台',\\n      url: 'https://yyc3.com',\\n    });\\n  };\\n\\n  const handleCopy = async () => {\\n    const success = await adapter.copyToClipboard('复制的内容');\\n    console.log('复制结果:', success);\\n  };\\n\\n  const handleVibrate = () => {\\n    adapter.vibrate(200);\\n  };\\n\\n  return (\\n    <div>\\n      <button onClick={handleOpenURL}>打开链接</button>\\n      <button onClick={handleShare}>分享</button>\\n      <button onClick={handleCopy}>复制</button>\\n      <button onClick={handleVibrate}>震动</button>\\n    </div>\\n  );\\n}\\n```\\n\\n---\\n\\n## 5. 跨维度数据交互与状态同步\\n\\n### 5.1 事件总线\\n\\n```typescript\\nimport { eventBus } from '@/lib/integration/cross-dimension-sync';\\n\\n// 监听事件\\neventBus.on('data:orders:created', (order) => {\\n  console.log('新订单创建:', order);\\n});\\n\\neventBus.on('data:orders:updated', (order) => {\\n  console.log('订单更新:', order);\\n});\\n\\neventBus.on('data:orders:deleted', (order) => {\\n  console.log('订单删除:', order);\\n});\\n\\n// 发送事件\\neventBus.emit('data:orders:created', orderData);\\n\\n// 取消监听\\neventBus.off('data:orders:created', handler);\\n```\\n\\n### 5.2 数据同步\\n\\n```typescript\\nimport { crossDimensionDataManager, DataSyncConfig } from '@/lib/integration/cross-dimension-sync';\\n\\n// 注册数据同步\\nconst config: DataSyncConfig = {\\n  entity: 'orders',\\n  endpoint: 'http://localhost:3000/api/orders',\\n  syncInterval: 5000,\\n  autoSync: true,\\n  conflictResolution: 'server',\\n  offlineSupport: true,\\n  realTime: true,\\n};\\n\\ncrossDimensionDataManager.register(config);\\n\\n// 创建数据\\nconst order = await crossDimensionDataManager.create('orders', {\\n  customerId: 'customer-123',\\n  items: [\\n    { productId: 'product-1', quantity: 2 },\\n  ],\\n});\\n\\n// 更新数据\\nconst updatedOrder = await crossDimensionDataManager.update('orders', order.id, {\\n  status: 'completed',\\n});\\n\\n// 删除数据\\nawait crossDimensionDataManager.delete('orders', order.id);\\n\\n// 获取同步状态\\nconst syncState = crossDimensionDataManager.getSyncState('orders');\\n\\n// 取消注册\\ncrossDimensionDataManager.unregister('orders');\\n```\\n\\n### 5.3 离线队列\\n\\n```typescript\\nimport { offlineQueueManager } from '@/lib/integration/cross-dimension-sync';\\n\\n// 添加离线操作\\nconst operationId = offlineQueueManager.add({\\n  operation: DataOperationType.CREATE,\\n  entity: 'orders',\\n  entityId: 'pending-123',\\n  data: orderData,\\n  maxRetries: 3,\\n});\\n\\n// 获取所有离线操作\\nconst operations = offlineQueueManager.getAll();\\n\\n// 同步离线队列\\nawait crossDimensionDataManager.syncOfflineQueue();\\n\\n// 清除离线队列\\nofflineQueueManager.clear();\\n```\\n\\n### 5.4 React Hooks\\n\\n```typescript\\nimport {\\n  useDataEvent,\\n  useSyncState,\\n  useOfflineQueue,\\n} from '@/lib/integration/cross-dimension-sync';\\n\\n// 使用数据事件\\nfunction OrderList() {\\n  const orders = useDataEvent('orders', DataOperationType.CREATE);\\n\\n  return (\\n    <div>\\n      {orders?.map(order => (\\n        <div key={order.id}>{order.id}</div>\\n      ))}\\n    </div>\\n  );\\n}\\n\\n// 使用同步状态\\nfunction SyncStatus() {\\n  const syncState = useSyncState('orders');\\n\\n  return (\\n    <div>\\n      同步状态: {syncState}\\n    </div>\\n  );\\n}\\n\\n// 使用离线队列\\nfunction OfflineQueue() {\\n  const { operations, size, syncQueue } = useOfflineQueue();\\n\\n  return (\\n    <div>\\n      <div>离线操作数量: {size}</div>\\n      <button onClick={syncQueue}>同步离线操作</button>\\n      <ul>\\n        {operations.map(op => (\\n          <li key={op.id}>{op.operation} - {op.entity}</li>\\n        ))}\\n      </ul>\\n    </div>\\n  );\\n}\\n```\\n\\n---\\n\\n## 6. 完整示例\\n\\n### 6.1 订单管理页面\\n\\n```typescript\\nimport { useState, useEffect } from 'react';\\nimport { useApi, useApiMutation } from '@/lib/integration/ui-business-integration';\\nimport { useOrderStore } from '@/lib/integration/data-layer-integration';\\nimport { useCachedData } from '@/lib/integration/data-layer-integration';\\nimport { useBreakpoint } from '@/lib/integration/multi-platform-adapter';\\nimport { useDataEvent } from '@/lib/integration/cross-dimension-sync';\\n\\nfunction OrderManagementPage() {\\n  const breakpoint = useBreakpoint();\\n  const { orders, addOrder, updateOrder, removeOrder } = useOrderStore();\\n  \\n  const { data, loading, error, refetch } = useCachedData(\\n    'orders:page:1',\\n    () => apiClient.get('/orders'),\\n    {\\n      key: 'orders:page:1',\\n      strategy: CacheStrategy.MEMORY,\\n      ttl: 300000,\\n      version: '1.0',\\n    }\\n  );\\n\\n  const { mutate: createOrder, loading: creating } = useApiMutation('/orders', 'POST');\\n\\n  const newOrder = useDataEvent('orders', DataOperationType.CREATE);\\n\\n  useEffect(() => {\\n    if (newOrder) {\\n      addOrder(newOrder);\\n    }\\n  }, [newOrder, addOrder]);\\n\\n  const handleCreateOrder = async (orderData) => {\\n    const response = await createOrder(orderData);\\n    if (response.success) {\\n      addOrder(response.data);\\n    }\\n  };\\n\\n  const handleUpdateOrder = async (orderId, updates) => {\\n    const response = await apiClient.put(`/orders/${orderId}`, updates);\\n    if (response.success) {\\n      updateOrder(orderId, updates);\\n    }\\n  };\\n\\n  const handleRemoveOrder = async (orderId) => {\\n    const response = await apiClient.delete(`/orders/${orderId}`);\\n    if (response.success) {\\n      removeOrder(orderId);\\n    }\\n  };\\n\\n  if (loading) return <div>加载中...</div>;\\n  if (error) return <div>加载失败: {error.message}</div>;\\n\\n  return (\\n    <div>\\n      <h1>订单管理</h1>\\n      <div>当前断点: {breakpoint}</div>\\n      <button onClick={refetch}>刷新</button>\\n      <button onClick={() => handleCreateOrder({ customerId: 'customer-123', items: [] })}>\\n        创建订单\\n      </button>\\n      <div style={{ display: 'grid', gridTemplateColumns: breakpoint === 'xs' ? '1fr' : 'repeat(3, 1fr)' }}>\\n        {orders.map(order => (\\n          <div key={order.id} style={{ padding: '10px', border: '1px solid #ccc' }}>\\n            <h3>订单 #{order.id}</h3>\\n            <p>状态: {order.status}</p>\\n            <button onClick={() => handleUpdateOrder(order.id, { status: 'completed' })}>\\n              完成\\n            </button>\\n            <button onClick={() => handleRemoveOrder(order.id)}>\\n              删除\\n            </button>\\n          </div>\\n        ))}\\n      </div>\\n    </div>\\n  );\\n}\\n\\nexport default OrderManagementPage;\\n```\\n\\n---\\n\\n## 7. 常见问题\\n\\n### 7.1 如何处理API错误？\\n\\n```typescript\\nconst { data, loading, error } = useApi('/orders');\\n\\nif (error) {\\n  // 显示错误信息\\n  return <div>错误: {error.message}</div>;\\n}\\n```\\n\\n### 7.2 如何实现离线支持？\\n\\n```typescript\\nimport { offlineQueueManager } from '@/lib/integration/cross-dimension-sync';\\n\\n// 添加离线操作\\nofflineQueueManager.add({\\n  operation: DataOperationType.CREATE,\\n  entity: 'orders',\\n  entityId: 'pending-123',\\n  data: orderData,\\n  maxRetries: 3,\\n});\\n\\n// 同步离线操作\\nawait crossDimensionDataManager.syncOfflineQueue();\\n```\\n\\n### 7.3 如何实现实时数据更新？\\n\\n```typescript\\nimport { useRealtimeData } from '@/lib/integration/ui-business-integration';\\n\\nfunction RealtimeOrderList() {\\n  const { data, connected } = useRealtimeData('ws://localhost:3000/orders');\\n\\n  return (\\n    <div>\\n      <div>连接状态: {connected ? '已连接' : '未连接'}</div>\\n      {data?.map(order => (\\n        <div key={order.id}>{order.id}</div>\\n      ))}\\n    </div>\\n  );\\n}\\n```\\n\\n### 7.4 如何实现响应式布局？\\n\\n```typescript\\nimport { useBreakpoint, useResponsive } from '@/lib/integration/multi-platform-adapter';\\n\\nfunction ResponsiveComponent() {\\n  const breakpoint = useBreakpoint();\\n  const columns = useResponsive({\\n    xs: 1,\\n    sm: 2,\\n    md: 3,\\n    lg: 4,\\n  });\\n\\n  return (\\n    <div style={{ display: 'grid', gridTemplateColumns: `repeat(${columns}, 1fr)` }}>\\n      {/* 渲染内容 */}\\n    </div>\\n  );\\n}\\n```\\n\\n---\\n\\n## 8. 总结\\n\\nYYC³餐饮行业智能化平台的系统集成架构提供了完整的解决方案，包括：\\n\\n1. **UI层与业务逻辑层无缝对接**: 提供统一的API客户端和React Hooks\\n2. **数据层与UI层深度集成**: 提供多级缓存策略和统一状态管理\\n3. **多端适配策略**: 支持Web端、移动端、小程序等多终端\\n4. **跨维度数据交互与状态同步**: 提供实时数据同步和离线支持\\n\\n通过这套完整的系统集成架构，开发者可以快速构建高质量、高性能、高可用的餐饮管理应用。\\n\\n---\\n\\n**文档版本**: v1.0.0\\n**最后更新**: 2026-01-21\\n**文档状态**: 正式发布\\n\",\"originTextLength\":17363,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768983284245}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/lib/integration/index.ts": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":391,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":391,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"/**\\\\n * @file YYC³餐饮行业智能化平台 - 系统集成统一入口\\\\n * @description 导出所有系统集成模块，提供统一的集成接口\\\\n * @module integration\\\\n * @author YYC³\\\\n * @version 1.0.0\\\\n * @created 2026-01-21\\\\n */\\\\n\\\\n// UI层与业务逻辑层集成\\\\nexport {\\\\n  ApiClient,\\\\n  useApi,\\\\n  useApiMutation,\\\\n  usePaginatedApi,\\\\n  useRealtimeData,\\\\n  useOptimisticUpdate,\\\\n  OrderService,\\\\n  MenuService,\\\\n  UserService,\\\\n  apiClient,\\\\n  orderService,\\\\n  menuService,\\\\n  userService,\\\\n} from \\\\'./ui-business-integration\\\\';\\\\n\\\\nexport type {\\\\n  ApiResponse,\\\\n  RequestConfig,\\\\n} from \\\\'./ui-business-integration\\\\';\\\\n\\\\n// 数据层与UI层集成\\\\nexport {\\\\n  CacheManager,\\\\n  cacheManager,\\\\n  DataSyncManager,\\\\n  dataSyncManager,\\\\n  useAppStore,\\\\n  useOrderStore,\\\\n  useMenuStore,\\\\n  useCachedData,\\\\n  CacheStrategy,\\\\n  SyncStatus,\\\\n} from \\\\'./data-layer-integration\\\\';\\\\n\\\\nexport type {\\\\n  CacheConfig,\\\\n  CacheItem,\\\\n  SyncConfig,\\\\n  AppState,\\\\n  OrderState,\\\\n  MenuState,\\\\n} from \\\\'./data-layer-integration\\\\';\\\\n\\\\n// 多端适配\\\\nexport {\\\\n  DeviceType,\\\\n  BREAKPOINTS,\\\\n  getDeviceInfo,\\\\n  getPlatformInfo,\\\\n  useDeviceInfo,\\\\n  usePlatformInfo,\\\\n  useBreakpoint,\\\\n  useResponsive,\\\\n  useMediaQuery,\\\\n  useTouchGesture,\\\\n  responsive,\\\\n  PlatformAdapter,\\\\n  platformAdapter,\\\\n  usePlatformAdapter,\\\\n  createResponsiveStyles,\\\\n} from \\\\'./multi-platform-adapter\\\\';\\\\n\\\\nexport type {\\\\n  DeviceInfo,\\\\n  PlatformInfo,\\\\n  ResponsiveConfig,\\\\n  Breakpoint,\\\\n} from \\\\'./multi-platform-adapter\\\\';\\\\n\\\\n// 跨维度数据交互与状态同步\\\\nexport {\\\\n  EventBus,\\\\n  eventBus,\\\\n  OfflineQueueManager,\\\\n  offlineQueueManager,\\\\n  DataConflictResolver,\\\\n  dataConflictResolver,\\\\n  RealtimeSyncManager,\\\\n  realtimeSyncManager,\\\\n  CrossDimensionDataManager,\\\\n  crossDimensionDataManager,\\\\n  useDataEvent,\\\\n  useSyncState,\\\\n  useOfflineQueue,\\\\n  DataOperationType,\\\\n  SyncState,\\\\n  DataSourceType,\\\\n} from \\\\'./cross-dimension-sync\\\\';\\\\n\\\\nexport type {\\\\n  DataEvent,\\\\n  DataSyncConfig,\\\\n  OfflineOperation,\\\\n  DataConflict,\\\\n} from \\\\'./cross-dimension-sync\\\\';\\\\n\\\\n/**\\\\n * YYC³系统集成核心类\\\\n * 提供统一的系统集成接口\\\\n */\\\\nexport class YYC3Integration {\\\\n  private static instance: YYC3Integration;\\\\n\\\\n  private constructor() {\\\\n    this.initialize();\\\\n  }\\\\n\\\\n  static getInstance(): YYC3Integration {\\\\n    if (!YYC3Integration.instance) {\\\\n      YYC3Integration.instance = new YYC3Integration();\\\\n    }\\\\n    return YYC3Integration.instance;\\\\n  }\\\\n\\\\n  private initialize(): void {\\\\n    console.log(\\\\'YYC³系统集成初始化中...\\\\');\\\\n\\\\n    // 初始化API客户端\\\\n    if (typeof window !== \\\\'undefined\\\\') {\\\\n      const apiBaseUrl = process.env.NEXT_PUBLIC_API_BASE_URL || \\\\'http://localhost:3000/api\\\\';\\\\n      const wsBaseUrl = process.env.NEXT_PUBLIC_WS_BASE_URL || \\\\'ws://localhost:3000\\\\';\\\\n\\\\n      console.log(\\\\'API基础URL:\\\\', apiBaseUrl);\\\\n      console.log(\\\\'WebSocket基础URL:\\\\', wsBaseUrl);\\\\n    }\\\\n\\\\n    console.log(\\\\'YYC³系统集成初始化完成\\\\');\\\\n  }\\\\n\\\\n  /**\\\\n   * 设置认证令牌\\\\n   */\\\\n  setAuthToken(token: string): void {\\\\n    const { apiClient } = require(\\\\'./ui-business-integration\\\\');\\\\n    apiClient.setToken(token);\\\\n  }\\\\n\\\\n  /**\\\\n   * 设置租户ID\\\\n   */\\\\n  setTenantId(tenantId: string): void {\\\\n    const { apiClient } = require(\\\\'./ui-business-integration\\\\');\\\\n    apiClient.setTenantId(tenantId);\\\\n  }\\\\n\\\\n  /**\\\\n   * 注册数据同步\\\\n   */\\\\n  registerDataSync(config: any): void {\\\\n    const { crossDimensionDataManager } = require(\\\\'./cross-dimension-sync\\\\');\\\\n    crossDimensionDataManager.register(config);\\\\n  }\\\\n\\\\n  /**\\\\n   * 取消注册数据同步\\\\n   */\\\\n  unregisterDataSync(entity: string): void {\\\\n    const { crossDimensionDataManager } = require(\\\\'./cross-dimension-sync\\\\');\\\\n    crossDimensionDataManager.unregister(entity);\\\\n  }\\\\n\\\\n  /**\\\\n   * 同步离线队列\\\\n   */\\\\n  async syncOfflineQueue(): Promise<void> {\\\\n    const { crossDimensionDataManager } = require(\\\\'./cross-dimension-sync\\\\');\\\\n    await crossDimensionDataManager.syncOfflineQueue();\\\\n  }\\\\n\\\\n  /**\\\\n   * 清除所有缓存\\\\n   */\\\\n  async clearAllCache(): Promise<void> {\\\\n    const { cacheManager, CacheStrategy } = require(\\\\'./data-layer-integration\\\\');\\\\n    await cacheManager.clear(CacheStrategy.MEMORY);\\\\n    await cacheManager.clear(CacheStrategy.INDEXED_DB);\\\\n    await cacheManager.clear(CacheStrategy.LOCAL_STORAGE);\\\\n    await cacheManager.clear(CacheStrategy.SESSION_STORAGE);\\\\n  }\\\\n\\\\n  /**\\\\n   * 获取设备信息\\\\n   */\\\\n  getDeviceInfo() {\\\\n    const { getDeviceInfo } = require(\\\\'./multi-platform-adapter\\\\');\\\\n    return getDeviceInfo();\\\\n  }\\\\n\\\\n  /**\\\\n   * 获取平台信息\\\\n   */\\\\n  getPlatformInfo() {\\\\n    const { getPlatformInfo } = require(\\\\'./multi-platform-adapter\\\\');\\\\n    return getPlatformInfo();\\\\n  }\\\\n\\\\n  /**\\\\n   * 获取同步状态\\\\n   */\\\\n  getSyncState(entity: string): any {\\\\n    const { crossDimensionDataManager } = require(\\\\'./cross-dimension-sync\\\\');\\\\n    return crossDimensionDataManager.getSyncState(entity);\\\\n  }\\\\n\\\\n  /**\\\\n   * 获取离线队列大小\\\\n   */\\\\n  getOfflineQueueSize(): number {\\\\n    const { offlineQueueManager } = require(\\\\'./cross-dimension-sync\\\\');\\\\n    return offlineQueueManager.size();\\\\n  }\\\\n\\\\n  /**\\\\n   * 获取所有离线操作\\\\n   */\\\\n  getOfflineOperations(): any[] {\\\\n    const { offlineQueueManager } = require(\\\\'./cross-dimension-sync\\\\');\\\\n    return offlineQueueManager.getAll();\\\\n  }\\\\n\\\\n  /**\\\\n   * 获取所有数据冲突\\\\n   */\\\\n  getConflicts(): any[] {\\\\n    const { dataConflictResolver } = require(\\\\'./cross-dimension-sync\\\\');\\\\n    return dataConflictResolver.getConflicts();\\\\n  }\\\\n\\\\n  /**\\\\n   * 解决数据冲突\\\\n   */\\\\n  resolveConflict(conflictId: string, resolution: \\\\'local\\\\' | \\\\'remote\\\\' | \\\\'merge\\\\', mergedData?: any): void {\\\\n    const { dataConflictResolver } = require(\\\\'./cross-dimension-sync\\\\');\\\\n    dataConflictResolver.resolveConflict(conflictId, resolution, mergedData);\\\\n  }\\\\n\\\\n  /**\\\\n   * 获取应用状态\\\\n   */\\\\n  getAppState() {\\\\n    const { useAppStore } = require(\\\\'./data-layer-integration\\\\');\\\\n    return useAppStore.getState();\\\\n  }\\\\n\\\\n  /**\\\\n   * 获取订单状态\\\\n   */\\\\n  getOrderState() {\\\\n    const { useOrderStore } = require(\\\\'./data-layer-integration\\\\');\\\\n    return useOrderStore.getState();\\\\n  }\\\\n\\\\n  /**\\\\n   * 获取菜单状态\\\\n   */\\\\n  getMenuState() {\\\\n    const { useMenuStore } = require(\\\\'./data-layer-integration\\\\');\\\\n    return useMenuStore.getState();\\\\n  }\\\\n\\\\n  /**\\\\n   * 订阅事件\\\\n   */\\\\n  on(event: string, listener: any): void {\\\\n    const { eventBus } = require(\\\\'./cross-dimension-sync\\\\');\\\\n    eventBus.on(event, listener);\\\\n  }\\\\n\\\\n  /**\\\\n   * 取消订阅事件\\\\n   */\\\\n  off(event: string, listener: any): void {\\\\n    const { eventBus } = require(\\\\'./cross-dimension-sync\\\\');\\\\n    eventBus.off(event, listener);\\\\n  }\\\\n\\\\n  /**\\\\n   * 发送事件\\\\n   */\\\\n  emit(event: string, data: any): void {\\\\n    const { eventBus } = require(\\\\'./cross-dimension-sync\\\\');\\\\n    eventBus.emit(event, data);\\\\n  }\\\\n\\\\n  /**\\\\n   * 连接WebSocket\\\\n   */\\\\n  connectWebSocket(entity: string, wsUrl: string): WebSocket {\\\\n    const { realtimeSyncManager } = require(\\\\'./cross-dimension-sync\\\\');\\\\n    return realtimeSyncManager.connectWebSocket(entity, wsUrl);\\\\n  }\\\\n\\\\n  /**\\\\n   * 检查WebSocket连接状态\\\\n   */\\\\n  isWebSocketConnected(entity: string): boolean {\\\\n    const { realtimeSyncManager } = require(\\\\'./cross-dimension-sync\\\\');\\\\n    return realtimeSyncManager.isConnected(entity);\\\\n  }\\\\n\\\\n  /**\\\\n   * 获取平台适配器\\\\n   */\\\\n  getPlatformAdapter() {\\\\n    const { platformAdapter } = require(\\\\'./multi-platform-adapter\\\\');\\\\n    return platformAdapter;\\\\n  }\\\\n\\\\n  /**\\\\n   * 获取缓存管理器\\\\n   */\\\\n  getCacheManager() {\\\\n    const { cacheManager } = require(\\\\'./data-layer-integration\\\\');\\\\n    return cacheManager;\\\\n  }\\\\n\\\\n  /**\\\\n   * 获取API客户端\\\\n   */\\\\n  getApiClient() {\\\\n    const { apiClient } = require(\\\\'./ui-business-integration\\\\');\\\\n    return apiClient;\\\\n  }\\\\n\\\\n  /**\\\\n   * 获取订单服务\\\\n   */\\\\n  getOrderService() {\\\\n    const { orderService } = require(\\\\'./ui-business-integration\\\\');\\\\n    return orderService;\\\\n  }\\\\n\\\\n  /**\\\\n   * 获取菜单服务\\\\n   */\\\\n  getMenuService() {\\\\n    const { menuService } = require(\\\\'./ui-business-integration\\\\');\\\\n    return menuService;\\\\n  }\\\\n\\\\n  /**\\\\n   * 获取用户服务\\\\n   */\\\\n  getUserService() {\\\\n    const { userService } = require(\\\\'./ui-business-integration\\\\');\\\\n    return userService;\\\\n  }\\\\n\\\\n  /**\\\\n   * 获取数据同步管理器\\\\n   */\\\\n  getDataSyncManager() {\\\\n    const { dataSyncManager } = require(\\\\'./data-layer-integration\\\\');\\\\n    return dataSyncManager;\\\\n  }\\\\n\\\\n  /**\\\\n   * 获取实时同步管理器\\\\n   */\\\\n  getRealtimeSyncManager() {\\\\n    const { realtimeSyncManager } = require(\\\\'./cross-dimension-sync\\\\');\\\\n    return realtimeSyncManager;\\\\n  }\\\\n\\\\n  /**\\\\n   * 获取跨维度数据管理器\\\\n   */\\\\n  getCrossDimensionDataManager() {\\\\n    const { crossDimensionDataManager } = require(\\\\'./cross-dimension-sync\\\\');\\\\n    return crossDimensionDataManager;\\\\n  }\\\\n\\\\n  /**\\\\n   * 获取离线队列管理器\\\\n   */\\\\n  getOfflineQueueManager() {\\\\n    const { offlineQueueManager } = require(\\\\'./cross-dimension-sync\\\\');\\\\n    return offlineQueueManager;\\\\n  }\\\\n\\\\n  /**\\\\n   * 获取数据冲突解决器\\\\n   */\\\\n  getDataConflictResolver() {\\\\n    const { dataConflictResolver } = require(\\\\'./cross-dimension-sync\\\\');\\\\n    return dataConflictResolver;\\\\n  }\\\\n\\\\n  /**\\\\n   * 获取事件总线\\\\n   */\\\\n  getEventBus() {\\\\n    const { eventBus } = require(\\\\'./cross-dimension-sync\\\\');\\\\n    return eventBus;\\\\n  }\\\\n\\\\n  /**\\\\n   * 获取应用状态管理器\\\\n   */\\\\n  getAppStore() {\\\\n    const { useAppStore } = require(\\\\'./data-layer-integration\\\\');\\\\n    return useAppStore;\\\\n  }\\\\n\\\\n  /**\\\\n   * 获取订单状态管理器\\\\n   */\\\\n  getOrderStore() {\\\\n    const { useOrderStore } = require(\\\\'./data-layer-integration\\\\');\\\\n    return useOrderStore;\\\\n  }\\\\n\\\\n  /**\\\\n   * 获取菜单状态管理器\\\\n   */\\\\n  getMenuStore() {\\\\n    const { useMenuStore } = require(\\\\'./data-layer-integration\\\\');\\\\n    return useMenuStore;\\\\n  }\\\\n}\\\\n\\\\n/**\\\\n * 创建全局系统集成实例\\\\n */\\\\nexport const yyc3Integration = YYC3Integration.getInstance();\\\\n\\\\n/**\\\\n * 默认导出\\\\n */\\\\nexport default {\\\\n  YYC3Integration,\\\\n  yyc3Integration,\\\\n};\\\\n\",\"originAcceptText\":\"/**\\n * @file YYC³餐饮行业智能化平台 - 系统集成统一入口\\n * @description 导出所有系统集成模块，提供统一的集成接口\\n * @module integration\\n * @author YYC³\\n * @version 1.0.0\\n * @created 2026-01-21\\n */\\n\\n// UI层与业务逻辑层集成\\nexport {\\n  ApiClient,\\n  useApi,\\n  useApiMutation,\\n  usePaginatedApi,\\n  useRealtimeData,\\n  useOptimisticUpdate,\\n  OrderService,\\n  MenuService,\\n  UserService,\\n  apiClient,\\n  orderService,\\n  menuService,\\n  userService,\\n} from './ui-business-integration';\\n\\nexport type {\\n  ApiResponse,\\n  RequestConfig,\\n} from './ui-business-integration';\\n\\n// 数据层与UI层集成\\nexport {\\n  CacheManager,\\n  cacheManager,\\n  DataSyncManager,\\n  dataSyncManager,\\n  useAppStore,\\n  useOrderStore,\\n  useMenuStore,\\n  useCachedData,\\n  CacheStrategy,\\n  SyncStatus,\\n} from './data-layer-integration';\\n\\nexport type {\\n  CacheConfig,\\n  CacheItem,\\n  SyncConfig,\\n  AppState,\\n  OrderState,\\n  MenuState,\\n} from './data-layer-integration';\\n\\n// 多端适配\\nexport {\\n  DeviceType,\\n  BREAKPOINTS,\\n  getDeviceInfo,\\n  getPlatformInfo,\\n  useDeviceInfo,\\n  usePlatformInfo,\\n  useBreakpoint,\\n  useResponsive,\\n  useMediaQuery,\\n  useTouchGesture,\\n  responsive,\\n  PlatformAdapter,\\n  platformAdapter,\\n  usePlatformAdapter,\\n  createResponsiveStyles,\\n} from './multi-platform-adapter';\\n\\nexport type {\\n  DeviceInfo,\\n  PlatformInfo,\\n  ResponsiveConfig,\\n  Breakpoint,\\n} from './multi-platform-adapter';\\n\\n// 跨维度数据交互与状态同步\\nexport {\\n  EventBus,\\n  eventBus,\\n  OfflineQueueManager,\\n  offlineQueueManager,\\n  DataConflictResolver,\\n  dataConflictResolver,\\n  RealtimeSyncManager,\\n  realtimeSyncManager,\\n  CrossDimensionDataManager,\\n  crossDimensionDataManager,\\n  useDataEvent,\\n  useSyncState,\\n  useOfflineQueue,\\n  DataOperationType,\\n  SyncState,\\n  DataSourceType,\\n} from './cross-dimension-sync';\\n\\nexport type {\\n  DataEvent,\\n  DataSyncConfig,\\n  OfflineOperation,\\n  DataConflict,\\n} from './cross-dimension-sync';\\n\\n/**\\n * YYC³系统集成核心类\\n * 提供统一的系统集成接口\\n */\\nexport class YYC3Integration {\\n  private static instance: YYC3Integration;\\n\\n  private constructor() {\\n    this.initialize();\\n  }\\n\\n  static getInstance(): YYC3Integration {\\n    if (!YYC3Integration.instance) {\\n      YYC3Integration.instance = new YYC3Integration();\\n    }\\n    return YYC3Integration.instance;\\n  }\\n\\n  private initialize(): void {\\n    console.log('YYC³系统集成初始化中...');\\n\\n    // 初始化API客户端\\n    if (typeof window !== 'undefined') {\\n      const apiBaseUrl = process.env.NEXT_PUBLIC_API_BASE_URL || 'http://localhost:3000/api';\\n      const wsBaseUrl = process.env.NEXT_PUBLIC_WS_BASE_URL || 'ws://localhost:3000';\\n\\n      console.log('API基础URL:', apiBaseUrl);\\n      console.log('WebSocket基础URL:', wsBaseUrl);\\n    }\\n\\n    console.log('YYC³系统集成初始化完成');\\n  }\\n\\n  /**\\n   * 设置认证令牌\\n   */\\n  setAuthToken(token: string): void {\\n    const { apiClient } = require('./ui-business-integration');\\n    apiClient.setToken(token);\\n  }\\n\\n  /**\\n   * 设置租户ID\\n   */\\n  setTenantId(tenantId: string): void {\\n    const { apiClient } = require('./ui-business-integration');\\n    apiClient.setTenantId(tenantId);\\n  }\\n\\n  /**\\n   * 注册数据同步\\n   */\\n  registerDataSync(config: any): void {\\n    const { crossDimensionDataManager } = require('./cross-dimension-sync');\\n    crossDimensionDataManager.register(config);\\n  }\\n\\n  /**\\n   * 取消注册数据同步\\n   */\\n  unregisterDataSync(entity: string): void {\\n    const { crossDimensionDataManager } = require('./cross-dimension-sync');\\n    crossDimensionDataManager.unregister(entity);\\n  }\\n\\n  /**\\n   * 同步离线队列\\n   */\\n  async syncOfflineQueue(): Promise<void> {\\n    const { crossDimensionDataManager } = require('./cross-dimension-sync');\\n    await crossDimensionDataManager.syncOfflineQueue();\\n  }\\n\\n  /**\\n   * 清除所有缓存\\n   */\\n  async clearAllCache(): Promise<void> {\\n    const { cacheManager, CacheStrategy } = require('./data-layer-integration');\\n    await cacheManager.clear(CacheStrategy.MEMORY);\\n    await cacheManager.clear(CacheStrategy.INDEXED_DB);\\n    await cacheManager.clear(CacheStrategy.LOCAL_STORAGE);\\n    await cacheManager.clear(CacheStrategy.SESSION_STORAGE);\\n  }\\n\\n  /**\\n   * 获取设备信息\\n   */\\n  getDeviceInfo() {\\n    const { getDeviceInfo } = require('./multi-platform-adapter');\\n    return getDeviceInfo();\\n  }\\n\\n  /**\\n   * 获取平台信息\\n   */\\n  getPlatformInfo() {\\n    const { getPlatformInfo } = require('./multi-platform-adapter');\\n    return getPlatformInfo();\\n  }\\n\\n  /**\\n   * 获取同步状态\\n   */\\n  getSyncState(entity: string): any {\\n    const { crossDimensionDataManager } = require('./cross-dimension-sync');\\n    return crossDimensionDataManager.getSyncState(entity);\\n  }\\n\\n  /**\\n   * 获取离线队列大小\\n   */\\n  getOfflineQueueSize(): number {\\n    const { offlineQueueManager } = require('./cross-dimension-sync');\\n    return offlineQueueManager.size();\\n  }\\n\\n  /**\\n   * 获取所有离线操作\\n   */\\n  getOfflineOperations(): any[] {\\n    const { offlineQueueManager } = require('./cross-dimension-sync');\\n    return offlineQueueManager.getAll();\\n  }\\n\\n  /**\\n   * 获取所有数据冲突\\n   */\\n  getConflicts(): any[] {\\n    const { dataConflictResolver } = require('./cross-dimension-sync');\\n    return dataConflictResolver.getConflicts();\\n  }\\n\\n  /**\\n   * 解决数据冲突\\n   */\\n  resolveConflict(conflictId: string, resolution: 'local' | 'remote' | 'merge', mergedData?: any): void {\\n    const { dataConflictResolver } = require('./cross-dimension-sync');\\n    dataConflictResolver.resolveConflict(conflictId, resolution, mergedData);\\n  }\\n\\n  /**\\n   * 获取应用状态\\n   */\\n  getAppState() {\\n    const { useAppStore } = require('./data-layer-integration');\\n    return useAppStore.getState();\\n  }\\n\\n  /**\\n   * 获取订单状态\\n   */\\n  getOrderState() {\\n    const { useOrderStore } = require('./data-layer-integration');\\n    return useOrderStore.getState();\\n  }\\n\\n  /**\\n   * 获取菜单状态\\n   */\\n  getMenuState() {\\n    const { useMenuStore } = require('./data-layer-integration');\\n    return useMenuStore.getState();\\n  }\\n\\n  /**\\n   * 订阅事件\\n   */\\n  on(event: string, listener: any): void {\\n    const { eventBus } = require('./cross-dimension-sync');\\n    eventBus.on(event, listener);\\n  }\\n\\n  /**\\n   * 取消订阅事件\\n   */\\n  off(event: string, listener: any): void {\\n    const { eventBus } = require('./cross-dimension-sync');\\n    eventBus.off(event, listener);\\n  }\\n\\n  /**\\n   * 发送事件\\n   */\\n  emit(event: string, data: any): void {\\n    const { eventBus } = require('./cross-dimension-sync');\\n    eventBus.emit(event, data);\\n  }\\n\\n  /**\\n   * 连接WebSocket\\n   */\\n  connectWebSocket(entity: string, wsUrl: string): WebSocket {\\n    const { realtimeSyncManager } = require('./cross-dimension-sync');\\n    return realtimeSyncManager.connectWebSocket(entity, wsUrl);\\n  }\\n\\n  /**\\n   * 检查WebSocket连接状态\\n   */\\n  isWebSocketConnected(entity: string): boolean {\\n    const { realtimeSyncManager } = require('./cross-dimension-sync');\\n    return realtimeSyncManager.isConnected(entity);\\n  }\\n\\n  /**\\n   * 获取平台适配器\\n   */\\n  getPlatformAdapter() {\\n    const { platformAdapter } = require('./multi-platform-adapter');\\n    return platformAdapter;\\n  }\\n\\n  /**\\n   * 获取缓存管理器\\n   */\\n  getCacheManager() {\\n    const { cacheManager } = require('./data-layer-integration');\\n    return cacheManager;\\n  }\\n\\n  /**\\n   * 获取API客户端\\n   */\\n  getApiClient() {\\n    const { apiClient } = require('./ui-business-integration');\\n    return apiClient;\\n  }\\n\\n  /**\\n   * 获取订单服务\\n   */\\n  getOrderService() {\\n    const { orderService } = require('./ui-business-integration');\\n    return orderService;\\n  }\\n\\n  /**\\n   * 获取菜单服务\\n   */\\n  getMenuService() {\\n    const { menuService } = require('./ui-business-integration');\\n    return menuService;\\n  }\\n\\n  /**\\n   * 获取用户服务\\n   */\\n  getUserService() {\\n    const { userService } = require('./ui-business-integration');\\n    return userService;\\n  }\\n\\n  /**\\n   * 获取数据同步管理器\\n   */\\n  getDataSyncManager() {\\n    const { dataSyncManager } = require('./data-layer-integration');\\n    return dataSyncManager;\\n  }\\n\\n  /**\\n   * 获取实时同步管理器\\n   */\\n  getRealtimeSyncManager() {\\n    const { realtimeSyncManager } = require('./cross-dimension-sync');\\n    return realtimeSyncManager;\\n  }\\n\\n  /**\\n   * 获取跨维度数据管理器\\n   */\\n  getCrossDimensionDataManager() {\\n    const { crossDimensionDataManager } = require('./cross-dimension-sync');\\n    return crossDimensionDataManager;\\n  }\\n\\n  /**\\n   * 获取离线队列管理器\\n   */\\n  getOfflineQueueManager() {\\n    const { offlineQueueManager } = require('./cross-dimension-sync');\\n    return offlineQueueManager;\\n  }\\n\\n  /**\\n   * 获取数据冲突解决器\\n   */\\n  getDataConflictResolver() {\\n    const { dataConflictResolver } = require('./cross-dimension-sync');\\n    return dataConflictResolver;\\n  }\\n\\n  /**\\n   * 获取事件总线\\n   */\\n  getEventBus() {\\n    const { eventBus } = require('./cross-dimension-sync');\\n    return eventBus;\\n  }\\n\\n  /**\\n   * 获取应用状态管理器\\n   */\\n  getAppStore() {\\n    const { useAppStore } = require('./data-layer-integration');\\n    return useAppStore;\\n  }\\n\\n  /**\\n   * 获取订单状态管理器\\n   */\\n  getOrderStore() {\\n    const { useOrderStore } = require('./data-layer-integration');\\n    return useOrderStore;\\n  }\\n\\n  /**\\n   * 获取菜单状态管理器\\n   */\\n  getMenuStore() {\\n    const { useMenuStore } = require('./data-layer-integration');\\n    return useMenuStore;\\n  }\\n}\\n\\n/**\\n * 创建全局系统集成实例\\n */\\nexport const yyc3Integration = YYC3Integration.getInstance();\\n\\n/**\\n * 默认导出\\n */\\nexport default {\\n  YYC3Integration,\\n  yyc3Integration,\\n};\\n\",\"originTextLength\":9011,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768983360754}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/docs/YYC3-CP-%E6%9E%B6%E6%9E%84%E8%AE%BE%E8%AE%A1/YYC3-%E7%B3%BB%E7%BB%9F%E9%9B%86%E6%88%90%E6%9E%B6%E6%9E%84%E5%AE%9E%E6%96%BD%E6%8A%A5%E5%91%8A.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":448,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":448,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# YYC³餐饮行业智能化平台 - 系统集成架构实施报告\\\\n\\\\n## 文档信息\\\\n\\\\n| 项目 | 内容 |\\\\n|-----|------|\\\\n| 文档编号 | YYC3-AICP-SIAR-001 |\\\\n| 文档名称 | 系统集成架构实施报告 |\\\\n| 版本号 | v1.0.0 |\\\\n| 创建日期 | 2026-01-21 |\\\\n| 最后更新 | 2026-01-21 |\\\\n| 文档状态 | 正式发布 |\\\\n| 作者 | YYC³ |\\\\n\\\\n---\\\\n\\\\n## 1. 项目概述\\\\n\\\\n### 1.1 项目背景\\\\n\\\\nYYC³餐饮行业智能化平台是一个面向餐饮行业的综合性管理平台，旨在通过智能化技术提升餐饮企业的运营效率和管理水平。在项目设计与开发过程中，需要重点关注系统架构的整体性与多端多维融合，实现项目与UI的深度融合衔接，构建一个多端适配、多维交互的一体化解决方案。\\\\n\\\\n### 1.2 实施目标\\\\n\\\\n本次系统集成架构实施的核心目标是：\\\\n\\\\n1. **无缝对接**: 实现UI层与业务逻辑层的无缝对接，消除数据孤岛\\\\n2. **深度集成**: 实现数据层与UI层的深度集成，提供统一的数据访问接口\\\\n3. **多端适配**: 实现Web端、移动端、小程序等多终端的一致用户体验\\\\n4. **实时同步**: 实现跨维度数据交互与状态同步，确保数据一致性\\\\n5. **离线支持**: 实现离线数据处理和自动同步，提升用户体验\\\\n\\\\n### 1.3 实施范围\\\\n\\\\n本次系统集成架构实施涵盖以下范围：\\\\n\\\\n- UI层与业务逻辑层集成\\\\n- 数据层与UI层集成\\\\n- 多端适配策略\\\\n- 跨维度数据交互与状态同步机制\\\\n- 系统架构文档和集成指南\\\\n\\\\n---\\\\n\\\\n## 2. 实施内容\\\\n\\\\n### 2.1 UI层与业务逻辑层集成\\\\n\\\\n#### 2.1.1 实施内容\\\\n\\\\nUI层与业务逻辑层集成主要包括以下内容：\\\\n\\\\n1. **API客户端**: 实现统一的API请求接口，封装所有HTTP请求逻辑\\\\n2. **React Hooks**: 提供易用的React Hooks，简化数据获取和状态管理\\\\n3. **业务服务层**: 封装业务逻辑，提供清晰的API接口\\\\n4. **错误处理**: 统一的错误处理机制，提供友好的错误提示\\\\n5. **请求重试**: 自动重试机制，提升系统稳定性\\\\n\\\\n#### 2.1.2 实施文件\\\\n\\\\n- `/frontend/apps/admin-dashboard/src/lib/integration/ui-business-integration.ts`\\\\n\\\\n#### 2.1.3 核心功能\\\\n\\\\n- **ApiClient类**: 提供统一的API请求接口，支持GET、POST、PUT、DELETE等HTTP方法\\\\n- **useApi Hook**: 简化API数据获取，自动处理加载状态和错误\\\\n- **useApiMutation Hook**: 简化API操作，支持乐观更新\\\\n- **usePaginatedApi Hook**: 支持分页数据获取\\\\n- **useRealtimeData Hook**: 支持实时数据更新\\\\n- **useOptimisticUpdate Hook**: 支持乐观更新\\\\n- **业务服务类**: 封装订单、菜单、用户等业务逻辑\\\\n\\\\n#### 2.1.4 实施成果\\\\n\\\\n✅ 完成API客户端实现，支持所有HTTP方法\\\\n✅ 完成React Hooks实现，简化数据获取和状态管理\\\\n✅ 完成业务服务层实现，封装核心业务逻辑\\\\n✅ 完成错误处理机制，提供友好的错误提示\\\\n✅ 完成请求重试机制，提升系统稳定性\\\\n\\\\n---\\\\n\\\\n### 2.2 数据层与UI层集成\\\\n\\\\n#### 2.2.1 实施内容\\\\n\\\\n数据层与UI层集成主要包括以下内容：\\\\n\\\\n1. **多级缓存策略**: 支持内存、LocalStorage、IndexedDB等多种缓存策略\\\\n2. **统一状态管理**: 使用Zustand进行统一的状态管理\\\\n3. **实时数据同步**: 支持WebSocket实时数据推送\\\\n4. **离线数据支持**: 支持离线数据存储和自动同步\\\\n5. **数据版本控制**: 支持数据版本控制和冲突解决\\\\n\\\\n#### 2.2.2 实施文件\\\\n\\\\n- `/frontend/apps/admin-dashboard/src/lib/integration/data-layer-integration.ts`\\\\n\\\\n#### 2.2.3 核心功能\\\\n\\\\n- **CacheManager类**: 提供统一的缓存管理接口，支持多种缓存策略\\\\n- **useCachedData Hook**: 简化缓存数据获取，自动处理缓存失效\\\\n- **Zustand状态管理**: 使用Zustand进行统一的状态管理\\\\n- **DataSyncManager类**: 提供数据同步管理，支持WebSocket实时同步\\\\n- **useAppStore Hook**: 应用状态管理\\\\n- **useOrderStore Hook**: 订单状态管理\\\\n- **useMenuStore Hook**: 菜单状态管理\\\\n\\\\n#### 2.2.4 实施成果\\\\n\\\\n✅ 完成缓存管理器实现，支持多种缓存策略\\\\n✅ 完成状态管理实现，使用Zustand进行统一管理\\\\n✅ 完成实时数据同步实现，支持WebSocket实时推送\\\\n✅ 完成离线数据支持实现，支持离线存储和自动同步\\\\n✅ 完成数据版本控制实现，支持版本控制和冲突解决\\\\n\\\\n---\\\\n\\\\n### 2.3 多端适配策略\\\\n\\\\n#### 2.3.1 实施内容\\\\n\\\\n多端适配策略主要包括以下内容：\\\\n\\\\n1. **响应式设计**: 支持多种屏幕尺寸和设备类型\\\\n2. **平台检测**: 自动检测设备类型和平台信息\\\\n3. **断点系统**: 提供灵活的断点系统，支持响应式布局\\\\n4. **手势支持**: 支持触摸手势，提升移动端体验\\\\n5. **平台适配**: 针对不同平台提供特定的适配方案\\\\n\\\\n#### 2.3.2 实施文件\\\\n\\\\n- `/frontend/apps/admin-dashboard/src/lib/integration/multi-platform-adapter.ts`\\\\n\\\\n#### 2.3.3 核心功能\\\\n\\\\n- **设备类型检测**: 自动检测设备类型（桌面、平板、手机）\\\\n- **平台信息检测**: 自动检测平台信息（Web、移动端、小程序）\\\\n- **断点系统**: 提供灵活的断点系统（xs、sm、md、lg、xl、2xl）\\\\n- **useBreakpoint Hook**: 获取当前断点\\\\n- **useResponsive Hook**: 根据断点返回对应的值\\\\n- **useMediaQuery Hook**: 使用媒体查询\\\\n- **useTouchGesture Hook**: 支持触摸手势\\\\n- **PlatformAdapter类**: 平台适配器，提供平台特定的功能\\\\n\\\\n#### 2.3.4 实施成果\\\\n\\\\n✅ 完成设备类型检测实现，支持桌面、平板、手机\\\\n✅ 完成平台信息检测实现，支持Web、移动端、小程序\\\\n✅ 完成断点系统实现，支持6个断点\\\\n✅ 完成响应式布局实现，支持多种屏幕尺寸\\\\n✅ 完成触摸手势支持实现，提升移动端体验\\\\n✅ 完成平台适配器实现，提供平台特定功能\\\\n\\\\n---\\\\n\\\\n### 2.4 跨维度数据交互与状态同步机制\\\\n\\\\n#### 2.4.1 实施内容\\\\n\\\\n跨维度数据交互与状态同步机制主要包括以下内容：\\\\n\\\\n1. **事件驱动**: 基于事件驱动的数据交互机制\\\\n2. **实时同步**: 支持WebSocket实时数据推送\\\\n3. **离线队列**: 支持离线操作队列和自动同步\\\\n4. **冲突解决**: 提供灵活的冲突解决机制\\\\n5. **版本控制**: 支持数据版本控制和并发控制\\\\n\\\\n#### 2.4.2 实施文件\\\\n\\\\n- `/frontend/apps/admin-dashboard/src/lib/integration/cross-dimension-sync.ts`\\\\n\\\\n#### 2.4.3 核心功能\\\\n\\\\n- **EventBus类**: 事件总线，提供事件发布订阅机制\\\\n- **OfflineQueueManager类**: 离线队列管理器，支持离线操作队列\\\\n- **DataConflictResolver类**: 数据冲突解决器，支持冲突检测和解决\\\\n- **RealtimeSyncManager类**: 实时同步管理器，支持WebSocket实时同步\\\\n- **CrossDimensionDataManager类**: 跨维度数据管理器，提供统一的数据操作接口\\\\n- **useDataEvent Hook**: 使用数据事件\\\\n- **useSyncState Hook**: 使用同步状态\\\\n- **useOfflineQueue Hook**: 使用离线队列\\\\n\\\\n#### 2.4.4 实施成果\\\\n\\\\n✅ 完成事件总线实现，提供事件发布订阅机制\\\\n✅ 完成离线队列管理器实现，支持离线操作队列\\\\n✅ 完成数据冲突解决器实现，支持冲突检测和解决\\\\n✅ 完成实时同步管理器实现，支持WebSocket实时同步\\\\n✅ 完成跨维度数据管理器实现，提供统一的数据操作接口\\\\n✅ 完成React Hooks实现，简化数据交互和状态同步\\\\n\\\\n---\\\\n\\\\n### 2.5 系统架构文档和集成指南\\\\n\\\\n#### 2.5.1 实施内容\\\\n\\\\n系统架构文档和集成指南主要包括以下内容：\\\\n\\\\n1. **系统架构文档**: 详细描述系统集成架构，包括各层的集成方式和核心功能\\\\n2. **集成指南**: 提供详细的集成指南，包括快速开始、使用示例、最佳实践等\\\\n3. **统一入口**: 提供统一的集成入口，简化集成流程\\\\n\\\\n#### 2.5.2 实施文件\\\\n\\\\n- `/docs/YYC3-CP-架构设计/YYC3-系统集成架构文档.md`\\\\n- `/docs/YYC3-CP-架构设计/YYC3-系统集成指南.md`\\\\n- `/frontend/apps/admin-dashboard/src/lib/integration/index.ts`\\\\n\\\\n#### 2.5.3 核心内容\\\\n\\\\n- **系统架构文档**: 详细描述系统集成架构，包括各层的集成方式和核心功能\\\\n- **集成指南**: 提供详细的集成指南，包括快速开始、使用示例、最佳实践等\\\\n- **统一入口**: 提供统一的集成入口，简化集成流程\\\\n\\\\n#### 2.5.4 实施成果\\\\n\\\\n✅ 完成系统架构文档编写，详细描述系统集成架构\\\\n✅ 完成集成指南编写，提供详细的集成指南\\\\n✅ 完成统一入口实现，提供统一的集成接口\\\\n✅ 完成最佳实践总结，提供开发指导\\\\n\\\\n---\\\\n\\\\n## 3. 技术架构\\\\n\\\\n### 3.1 整体架构\\\\n\\\\n```\\\\n┌─────────────────────────────────────────────────────────────────┐\\\\n│                        客户端层 (Client Layer)                    │\\\\n├─────────────────────────────────────────────────────────────────┤\\\\n│  Web浏览器      │  移动端H5      │  小程序      │  管理后台        │\\\\n│  (React 18)     │  (React 18)    │  (原生)       │  (React 18)      │\\\\n└─────────────────────────────────────────────────────────────────┘\\\\n                              │\\\\n                              ▼\\\\n                ┌─────────────────────────────────────────────────────────┐\\\\n                │                   UI集成层 (UI Integration Layer)            │\\\\n                ├─────────────────────────────────────────────────────────┤\\\\n                │  UI-Business Integration  │  Data Layer Integration   │\\\\n                │  Multi-Platform Adapter   │  Cross-Dimension Sync     │\\\\n                └─────────────────────────────────────────────────────────┘\\\\n                              │\\\\n                              ▼\\\\n                ┌─────────────────────────────────────────────────────────┐\\\\n                │                    业务逻辑层 (Business Layer)                  │\\\\n                ├─────────────────────────────────────────────────────────┤\\\\n                │  用户服务  │  菜单服务  │  订单服务  │  库存服务  │  财务服务  │\\\\n                │  营销服务  │  报表服务  │  消息服务  │  文件服务  │  支付服务  │\\\\n                └─────────────────────────────────────────────────────────┘\\\\n                              │\\\\n                              ▼\\\\n                ┌─────────────────────────────────────────────────────────┐\\\\n                │                    数据访问层 (Data Access Layer)            │\\\\n                ├─────────────────────────────────────────────────────────┤\\\\n                │  ORM层  │  缓存层  │  消息队列  │  数据同步                    │\\\\n                └─────────────────────────────────────────────────────────┘\\\\n                              │\\\\n                              ▼\\\\n                ┌─────────────────────────────────────────────────────────┐\\\\n                │                    数据存储层 (Data Storage Layer)            │\\\\n                ├─────────────────────────────────────────────────────────┤\\\\n                │  PostgreSQL  │  Redis  │  MinIO  │  Elasticsearch           │\\\\n                └─────────────────────────────────────────────────────────┘\\\\n```\\\\n\\\\n### 3.2 技术栈\\\\n\\\\n#### 前端技术栈\\\\n\\\\n- **核心框架**: React 18.3.1 + TypeScript 5.3+\\\\n- **构建工具**: Vite 5.0+\\\\n- **状态管理**: Zustand 4.4+ (轻量级状态管理)\\\\n- **UI组件库**: Tailwind CSS 4.1.12 + 自研YU组件库\\\\n- **数据获取**: React Query / SWR\\\\n- **实时通信**: WebSocket + Server-Sent Events\\\\n- **离线存储**: IndexedDB + LocalStorage + SessionStorage\\\\n\\\\n#### 后端技术栈\\\\n\\\\n- **核心框架**: Express.js / Nest.js\\\\n- **API网关**: Kong / Nginx\\\\n- **数据库**: PostgreSQL 15+ (多租户架构)\\\\n- **缓存**: Redis 7+\\\\n- **消息队列**: RabbitMQ / Kafka\\\\n- **搜索引擎**: Elasticsearch 8+\\\\n\\\\n---\\\\n\\\\n## 4. 实施成果\\\\n\\\\n### 4.1 功能完成度\\\\n\\\\n| 模块 | 功能 | 完成度 | 状态 |\\\\n|-----|------|--------|------|\\\\n| UI层与业务逻辑层集成 | API客户端 | 100% | ✅ 完成 |\\\\n| UI层与业务逻辑层集成 | React Hooks | 100% | ✅ 完成 |\\\\n| UI层与业务逻辑层集成 | 业务服务层 | 100% | ✅ 完成 |\\\\n| UI层与业务逻辑层集成 | 错误处理 | 100% | ✅ 完成 |\\\\n| UI层与业务逻辑层集成 | 请求重试 | 100% | ✅ 完成 |\\\\n| 数据层与UI层集成 | 缓存管理 | 100% | ✅ 完成 |\\\\n| 数据层与UI层集成 | 状态管理 | 100% | ✅ 完成 |\\\\n| 数据层与UI层集成 | 实时数据同步 | 100% | ✅ 完成 |\\\\n| 数据层与UI层集成 | 离线数据支持 | 100% | ✅ 完成 |\\\\n| 数据层与UI层集成 | 数据版本控制 | 100% | ✅ 完成 |\\\\n| 多端适配策略 | 设备类型检测 | 100% | ✅ 完成 |\\\\n| 多端适配策略 | 平台信息检测 | 100% | ✅ 完成 |\\\\n| 多端适配策略 | 断点系统 | 100% | ✅ 完成 |\\\\n| 多端适配策略 | 响应式布局 | 100% | ✅ 完成 |\\\\n| 多端适配策略 | 触摸手势支持 | 100% | ✅ 完成 |\\\\n| 多端适配策略 | 平台适配器 | 100% | ✅ 完成 |\\\\n| 跨维度数据交互与状态同步机制 | 事件总线 | 100% | ✅ 完成 |\\\\n| 跨维度数据交互与状态同步机制 | 离线队列管理器 | 100% | ✅ 完成 |\\\\n| 跨维度数据交互与状态同步机制 | 数据冲突解决器 | 100% | ✅ 完成 |\\\\n| 跨维度数据交互与状态同步机制 | 实时同步管理器 | 100% | ✅ 完成 |\\\\n| 跨维度数据交互与状态同步机制 | 跨维度数据管理器 | 100% | ✅ 完成 |\\\\n| 跨维度数据交互与状态同步机制 | React Hooks | 100% | ✅ 完成 |\\\\n| 系统架构文档和集成指南 | 系统架构文档 | 100% | ✅ 完成 |\\\\n| 系统架构文档和集成指南 | 集成指南 | 100% | ✅ 完成 |\\\\n| 系统架构文档和集成指南 | 统一入口 | 100% | ✅ 完成 |\\\\n| 系统架构文档和集成指南 | 最佳实践 | 100% | ✅ 完成 |\\\\n\\\\n**总体完成度**: 100% ✅\\\\n\\\\n### 4.2 文件清单\\\\n\\\\n| 文件路径 | 描述 | 状态 |\\\\n|---------|------|------|\\\\n| `/frontend/apps/admin-dashboard/src/lib/integration/ui-business-integration.ts` | UI层与业务逻辑层集成 | ✅ 完成 |\\\\n| `/frontend/apps/admin-dashboard/src/lib/integration/data-layer-integration.ts` | 数据层与UI层集成 | ✅ 完成 |\\\\n| `/frontend/apps/admin-dashboard/src/lib/integration/multi-platform-adapter.ts` | 多端适配策略 | ✅ 完成 |\\\\n| `/frontend/apps/admin-dashboard/src/lib/integration/cross-dimension-sync.ts` | 跨维度数据交互与状态同步机制 | ✅ 完成 |\\\\n| `/frontend/apps/admin-dashboard/src/lib/integration/index.ts` | 统一集成入口 | ✅ 完成 |\\\\n| `/docs/YYC3-CP-架构设计/YYC3-系统集成架构文档.md` | 系统架构文档 | ✅ 完成 |\\\\n| `/docs/YYC3-CP-架构设计/YYC3-系统集成指南.md` | 集成指南 | ✅ 完成 |\\\\n\\\\n---\\\\n\\\\n## 5. 技术亮点\\\\n\\\\n### 5.1 统一的API客户端\\\\n\\\\n提供统一的API客户端，封装所有HTTP请求逻辑，支持自动重试、错误处理、请求拦截等功能，大大简化了API调用。\\\\n\\\\n### 5.2 丰富的React Hooks\\\\n\\\\n提供丰富的React Hooks，包括`useApi`、`useApiMutation`、`usePaginatedApi`、`useRealtimeData`、`useOptimisticUpdate`等，简化了数据获取和状态管理。\\\\n\\\\n### 5.3 多级缓存策略\\\\n\\\\n支持内存、LocalStorage、IndexedDB等多种缓存策略，根据数据特点选择合适的缓存策略，提升系统性能。\\\\n\\\\n### 5.4 统一状态管理\\\\n\\\\n使用Zustand进行统一的状态管理，支持持久化、中间件、DevTools等功能，提供更好的开发体验。\\\\n\\\\n### 5.5 实时数据同步\\\\n\\\\n支持WebSocket实时数据推送，实现数据的实时更新，提升用户体验。\\\\n\\\\n### 5.6 离线数据支持\\\\n\\\\n支持离线数据存储和自动同步，确保用户在离线状态下也能正常使用应用，提升用户体验。\\\\n\\\\n### 5.7 灵活的断点系统\\\\n\\\\n提供灵活的断点系统，支持6个断点（xs、sm、md、lg、xl、2xl），支持响应式布局。\\\\n\\\\n### 5.8 触摸手势支持\\\\n\\\\n支持触摸手势，包括滑动、点击、长按等，提升移动端体验。\\\\n\\\\n### 5.9 平台适配器\\\\n\\\\n提供平台适配器，针对不同平台提供特定的适配方案，包括打开链接、分享、复制、震动等功能。\\\\n\\\\n### 5.10 事件驱动架构\\\\n\\\\n基于事件驱动的数据交互机制，提供事件发布订阅机制，实现组件间的松耦合。\\\\n\\\\n### 5.11 数据冲突解决\\\\n\\\\n提供灵活的数据冲突解决机制，支持本地优先、远程优先、合并、手动等多种策略。\\\\n\\\\n### 5.12 统一的集成入口\\\\n\\\\n提供统一的集成入口，简化集成流程，开发者可以通过一个入口访问所有集成功能。\\\\n\\\\n---\\\\n\\\\n## 6. 使用示例\\\\n\\\\n### 6.1 快速开始\\\\n\\\\n```typescript\\\\nimport { yyc3Integration } from \\\\'@/lib/integration\\\\';\\\\n\\\\n// 设置认证令牌\\\\nyyc3Integration.setAuthToken(\\\\'your-jwt-token\\\\');\\\\n\\\\n// 设置租户ID\\\\nyyc3Integration.setTenantId(\\\\'your-tenant-id\\\\');\\\\n\\\\n// 注册数据同步\\\\nyyc3Integration.registerDataSync({\\\\n  entity: \\\\'orders\\\\',\\\\n  endpoint: \\\\'http://localhost:3000/api/orders\\\\',\\\\n  syncInterval: 5000,\\\\n  autoSync: true,\\\\n  conflictResolution: \\\\'server\\\\',\\\\n  offlineSupport: true,\\\\n  realTime: true,\\\\n});\\\\n```\\\\n\\\\n### 6.2 使用API客户端\\\\n\\\\n```typescript\\\\nimport { useApi, useApiMutation } from \\\\'@/lib/integration\\\\';\\\\n\\\\n// 使用API数据\\\\nfunction OrderList() {\\\\n  const { data, loading, error, refetch } = useApi(\\\\'/orders\\\\');\\\\n\\\\n  if (loading) return <div>加载中...</div>;\\\\n  if (error) return <div>加载失败: {error.message}</div>;\\\\n\\\\n  return (\\\\n    <div>\\\\n      {data?.map(order => (\\\\n        <div key={order.id}>{order.id}</div>\\\\n      ))}\\\\n      <button onClick={refetch}>刷新</button>\\\\n    </div>\\\\n  );\\\\n}\\\\n\\\\n// 使用API操作\\\\nfunction CreateOrder() {\\\\n  const { mutate, loading } = useApiMutation(\\\\'/orders\\\\', \\\\'POST\\\\');\\\\n\\\\n  const handleSubmit = async (orderData) => {\\\\n    const response = await mutate(orderData);\\\\n    if (response.success) {\\\\n      console.log(\\\\'订单创建成功\\\\');\\\\n    }\\\\n  };\\\\n\\\\n  return (\\\\n    <form onSubmit={handleSubmit}>\\\\n      <button disabled={loading} type=\\\\\\\"submit\\\\\\\">\\\\n        {loading ? \\\\'提交中...\\\\' : \\\\'创建订单\\\\'}\\\\n      </button>\\\\n    </form>\\\\n  );\\\\n}\\\\n```\\\\n\\\\n### 6.3 使用状态管理\\\\n\\\\n```typescript\\\\nimport { useOrderStore } from \\\\'@/lib/integration\\\\';\\\\n\\\\nfunction OrderList() {\\\\n  const { orders, addOrder, updateOrder, removeOrder } = useOrderStore();\\\\n\\\\n  const handleAddOrder = async (orderData) => {\\\\n    const response = await apiClient.post(\\\\'/orders\\\\', orderData);\\\\n    if (response.success) {\\\\n      addOrder(response.data);\\\\n    }\\\\n  };\\\\n\\\\n  return (\\\\n    <div>\\\\n      {orders.map(order => (\\\\n        <div key={order.id}>\\\\n          <span>{order.id}</span>\\\\n          <button onClick={() => handleUpdateOrder(order.id, { status: \\\\'completed\\\\' })}>\\\\n            完成\\\\n          </button>\\\\n          <button onClick={() => handleRemoveOrder(order.id)}>\\\\n            删除\\\\n          </button>\\\\n        </div>\\\\n      ))}\\\\n    </div>\\\\n  );\\\\n}\\\\n```\\\\n\\\\n### 6.4 使用多端适配\\\\n\\\\n```typescript\\\\nimport { useBreakpoint, useResponsive } from \\\\'@/lib/integration\\\\';\\\\n\\\\nfunction ResponsiveComponent() {\\\\n  const breakpoint = useBreakpoint();\\\\n  const columns = useResponsive({\\\\n    xs: 1,\\\\n    sm: 2,\\\\n    md: 3,\\\\n    lg: 4,\\\\n  });\\\\n\\\\n  return (\\\\n    <div>\\\\n      <div>当前断点: {breakpoint}</div>\\\\n      <div style={{ display: \\\\'grid\\\\', gridTemplateColumns: `repeat(${columns}, 1fr)` }}>\\\\n        {/* 渲染内容 */}\\\\n      </div>\\\\n    </div>\\\\n  );\\\\n}\\\\n```\\\\n\\\\n### 6.5 使用跨维度数据同步\\\\n\\\\n```typescript\\\\nimport { useDataEvent, useSyncState, useOfflineQueue } from \\\\'@/lib/integration\\\\';\\\\n\\\\n// 使用数据事件\\\\nfunction OrderList() {\\\\n  const orders = useDataEvent(\\\\'orders\\\\', DataOperationType.CREATE);\\\\n\\\\n  return (\\\\n    <div>\\\\n      {orders?.map(order => (\\\\n        <div key={order.id}>{order.id}</div>\\\\n      ))}\\\\n    </div>\\\\n  );\\\\n}\\\\n\\\\n// 使用同步状态\\\\nfunction SyncStatus() {\\\\n  const syncState = useSyncState(\\\\'orders\\\\');\\\\n\\\\n  return (\\\\n    <div>\\\\n      同步状态: {syncState}\\\\n    </div>\\\\n  );\\\\n}\\\\n\\\\n// 使用离线队列\\\\nfunction OfflineQueue() {\\\\n  const { operations, size, syncQueue } = useOfflineQueue();\\\\n\\\\n  return (\\\\n    <div>\\\\n      <div>离线操作数量: {size}</div>\\\\n      <button onClick={syncQueue}>同步离线操作</button>\\\\n      <ul>\\\\n        {operations.map(op => (\\\\n          <li key={op.id}>{op.operation} - {op.entity}</li>\\\\n        ))}\\\\n      </ul>\\\\n    </div>\\\\n  );\\\\n}\\\\n```\\\\n\\\\n---\\\\n\\\\n## 7. 总结\\\\n\\\\nYYC³餐饮行业智能化平台的系统集成架构实施已经全部完成，实现了以下核心目标：\\\\n\\\\n1. **无缝对接**: UI层与业务逻辑层的无缝对接，消除了数据孤岛\\\\n2. **深度集成**: 数据层与UI层的深度集成，提供了统一的数据访问接口\\\\n3. **多端适配**: Web端、移动端、小程序等多终端的一致用户体验\\\\n4. **实时同步**: 跨维度数据交互与状态同步，确保了数据一致性\\\\n5. **离线支持**: 离线数据处理和自动同步，提升了用户体验\\\\n\\\\n通过这套完整的系统集成架构，整个系统在功能实现、用户体验和技术架构上形成了有机整体，为后续的业务扩展和技术升级奠定了坚实的基础。\\\\n\\\\n### 7.1 核心优势\\\\n\\\\n- **统一性**: 提供统一的API客户端、状态管理、缓存管理等，简化开发流程\\\\n- **灵活性**: 支持多种缓存策略、断点系统、冲突解决策略等，满足不同场景需求\\\\n- **可扩展性**: 基于事件驱动架构，支持灵活扩展\\\\n- **高性能**: 多级缓存策略、实时数据同步、离线支持等，提升系统性能\\\\n- **易用性**: 丰富的React Hooks、统一的集成入口、详细的文档等，降低开发门槛\\\\n\\\\n### 7.2 未来展望\\\\n\\\\n基于当前系统集成架构，未来可以进一步扩展以下功能：\\\\n\\\\n1. **多租户支持**: 进一步完善多租户支持，实现租户级别的数据隔离和权限控制\\\\n2. **国际化支持**: 完善国际化支持，支持多语言、多货币、多时区等\\\\n3. **性能优化**: 进一步优化性能，包括代码分割、懒加载、预加载等\\\\n4. **监控告警**: 完善监控告警系统，实现实时监控和告警\\\\n5. **自动化测试**: 完善自动化测试，提升代码质量和稳定性\\\\n\\\\n---\\\\n\\\\n**文档版本**: v1.0.0\\\\n**最后更新**: 2026-01-21\\\\n**文档状态**: 正式发布\\\\n\",\"originAcceptText\":\"# YYC³餐饮行业智能化平台 - 系统集成架构实施报告\\n\\n## 文档信息\\n\\n| 项目 | 内容 |\\n|-----|------|\\n| 文档编号 | YYC3-AICP-SIAR-001 |\\n| 文档名称 | 系统集成架构实施报告 |\\n| 版本号 | v1.0.0 |\\n| 创建日期 | 2026-01-21 |\\n| 最后更新 | 2026-01-21 |\\n| 文档状态 | 正式发布 |\\n| 作者 | YYC³ |\\n\\n---\\n\\n## 1. 项目概述\\n\\n### 1.1 项目背景\\n\\nYYC³餐饮行业智能化平台是一个面向餐饮行业的综合性管理平台，旨在通过智能化技术提升餐饮企业的运营效率和管理水平。在项目设计与开发过程中，需要重点关注系统架构的整体性与多端多维融合，实现项目与UI的深度融合衔接，构建一个多端适配、多维交互的一体化解决方案。\\n\\n### 1.2 实施目标\\n\\n本次系统集成架构实施的核心目标是：\\n\\n1. **无缝对接**: 实现UI层与业务逻辑层的无缝对接，消除数据孤岛\\n2. **深度集成**: 实现数据层与UI层的深度集成，提供统一的数据访问接口\\n3. **多端适配**: 实现Web端、移动端、小程序等多终端的一致用户体验\\n4. **实时同步**: 实现跨维度数据交互与状态同步，确保数据一致性\\n5. **离线支持**: 实现离线数据处理和自动同步，提升用户体验\\n\\n### 1.3 实施范围\\n\\n本次系统集成架构实施涵盖以下范围：\\n\\n- UI层与业务逻辑层集成\\n- 数据层与UI层集成\\n- 多端适配策略\\n- 跨维度数据交互与状态同步机制\\n- 系统架构文档和集成指南\\n\\n---\\n\\n## 2. 实施内容\\n\\n### 2.1 UI层与业务逻辑层集成\\n\\n#### 2.1.1 实施内容\\n\\nUI层与业务逻辑层集成主要包括以下内容：\\n\\n1. **API客户端**: 实现统一的API请求接口，封装所有HTTP请求逻辑\\n2. **React Hooks**: 提供易用的React Hooks，简化数据获取和状态管理\\n3. **业务服务层**: 封装业务逻辑，提供清晰的API接口\\n4. **错误处理**: 统一的错误处理机制，提供友好的错误提示\\n5. **请求重试**: 自动重试机制，提升系统稳定性\\n\\n#### 2.1.2 实施文件\\n\\n- `/frontend/apps/admin-dashboard/src/lib/integration/ui-business-integration.ts`\\n\\n#### 2.1.3 核心功能\\n\\n- **ApiClient类**: 提供统一的API请求接口，支持GET、POST、PUT、DELETE等HTTP方法\\n- **useApi Hook**: 简化API数据获取，自动处理加载状态和错误\\n- **useApiMutation Hook**: 简化API操作，支持乐观更新\\n- **usePaginatedApi Hook**: 支持分页数据获取\\n- **useRealtimeData Hook**: 支持实时数据更新\\n- **useOptimisticUpdate Hook**: 支持乐观更新\\n- **业务服务类**: 封装订单、菜单、用户等业务逻辑\\n\\n#### 2.1.4 实施成果\\n\\n✅ 完成API客户端实现，支持所有HTTP方法\\n✅ 完成React Hooks实现，简化数据获取和状态管理\\n✅ 完成业务服务层实现，封装核心业务逻辑\\n✅ 完成错误处理机制，提供友好的错误提示\\n✅ 完成请求重试机制，提升系统稳定性\\n\\n---\\n\\n### 2.2 数据层与UI层集成\\n\\n#### 2.2.1 实施内容\\n\\n数据层与UI层集成主要包括以下内容：\\n\\n1. **多级缓存策略**: 支持内存、LocalStorage、IndexedDB等多种缓存策略\\n2. **统一状态管理**: 使用Zustand进行统一的状态管理\\n3. **实时数据同步**: 支持WebSocket实时数据推送\\n4. **离线数据支持**: 支持离线数据存储和自动同步\\n5. **数据版本控制**: 支持数据版本控制和冲突解决\\n\\n#### 2.2.2 实施文件\\n\\n- `/frontend/apps/admin-dashboard/src/lib/integration/data-layer-integration.ts`\\n\\n#### 2.2.3 核心功能\\n\\n- **CacheManager类**: 提供统一的缓存管理接口，支持多种缓存策略\\n- **useCachedData Hook**: 简化缓存数据获取，自动处理缓存失效\\n- **Zustand状态管理**: 使用Zustand进行统一的状态管理\\n- **DataSyncManager类**: 提供数据同步管理，支持WebSocket实时同步\\n- **useAppStore Hook**: 应用状态管理\\n- **useOrderStore Hook**: 订单状态管理\\n- **useMenuStore Hook**: 菜单状态管理\\n\\n#### 2.2.4 实施成果\\n\\n✅ 完成缓存管理器实现，支持多种缓存策略\\n✅ 完成状态管理实现，使用Zustand进行统一管理\\n✅ 完成实时数据同步实现，支持WebSocket实时推送\\n✅ 完成离线数据支持实现，支持离线存储和自动同步\\n✅ 完成数据版本控制实现，支持版本控制和冲突解决\\n\\n---\\n\\n### 2.3 多端适配策略\\n\\n#### 2.3.1 实施内容\\n\\n多端适配策略主要包括以下内容：\\n\\n1. **响应式设计**: 支持多种屏幕尺寸和设备类型\\n2. **平台检测**: 自动检测设备类型和平台信息\\n3. **断点系统**: 提供灵活的断点系统，支持响应式布局\\n4. **手势支持**: 支持触摸手势，提升移动端体验\\n5. **平台适配**: 针对不同平台提供特定的适配方案\\n\\n#### 2.3.2 实施文件\\n\\n- `/frontend/apps/admin-dashboard/src/lib/integration/multi-platform-adapter.ts`\\n\\n#### 2.3.3 核心功能\\n\\n- **设备类型检测**: 自动检测设备类型（桌面、平板、手机）\\n- **平台信息检测**: 自动检测平台信息（Web、移动端、小程序）\\n- **断点系统**: 提供灵活的断点系统（xs、sm、md、lg、xl、2xl）\\n- **useBreakpoint Hook**: 获取当前断点\\n- **useResponsive Hook**: 根据断点返回对应的值\\n- **useMediaQuery Hook**: 使用媒体查询\\n- **useTouchGesture Hook**: 支持触摸手势\\n- **PlatformAdapter类**: 平台适配器，提供平台特定的功能\\n\\n#### 2.3.4 实施成果\\n\\n✅ 完成设备类型检测实现，支持桌面、平板、手机\\n✅ 完成平台信息检测实现，支持Web、移动端、小程序\\n✅ 完成断点系统实现，支持6个断点\\n✅ 完成响应式布局实现，支持多种屏幕尺寸\\n✅ 完成触摸手势支持实现，提升移动端体验\\n✅ 完成平台适配器实现，提供平台特定功能\\n\\n---\\n\\n### 2.4 跨维度数据交互与状态同步机制\\n\\n#### 2.4.1 实施内容\\n\\n跨维度数据交互与状态同步机制主要包括以下内容：\\n\\n1. **事件驱动**: 基于事件驱动的数据交互机制\\n2. **实时同步**: 支持WebSocket实时数据推送\\n3. **离线队列**: 支持离线操作队列和自动同步\\n4. **冲突解决**: 提供灵活的冲突解决机制\\n5. **版本控制**: 支持数据版本控制和并发控制\\n\\n#### 2.4.2 实施文件\\n\\n- `/frontend/apps/admin-dashboard/src/lib/integration/cross-dimension-sync.ts`\\n\\n#### 2.4.3 核心功能\\n\\n- **EventBus类**: 事件总线，提供事件发布订阅机制\\n- **OfflineQueueManager类**: 离线队列管理器，支持离线操作队列\\n- **DataConflictResolver类**: 数据冲突解决器，支持冲突检测和解决\\n- **RealtimeSyncManager类**: 实时同步管理器，支持WebSocket实时同步\\n- **CrossDimensionDataManager类**: 跨维度数据管理器，提供统一的数据操作接口\\n- **useDataEvent Hook**: 使用数据事件\\n- **useSyncState Hook**: 使用同步状态\\n- **useOfflineQueue Hook**: 使用离线队列\\n\\n#### 2.4.4 实施成果\\n\\n✅ 完成事件总线实现，提供事件发布订阅机制\\n✅ 完成离线队列管理器实现，支持离线操作队列\\n✅ 完成数据冲突解决器实现，支持冲突检测和解决\\n✅ 完成实时同步管理器实现，支持WebSocket实时同步\\n✅ 完成跨维度数据管理器实现，提供统一的数据操作接口\\n✅ 完成React Hooks实现，简化数据交互和状态同步\\n\\n---\\n\\n### 2.5 系统架构文档和集成指南\\n\\n#### 2.5.1 实施内容\\n\\n系统架构文档和集成指南主要包括以下内容：\\n\\n1. **系统架构文档**: 详细描述系统集成架构，包括各层的集成方式和核心功能\\n2. **集成指南**: 提供详细的集成指南，包括快速开始、使用示例、最佳实践等\\n3. **统一入口**: 提供统一的集成入口，简化集成流程\\n\\n#### 2.5.2 实施文件\\n\\n- `/docs/YYC3-CP-架构设计/YYC3-系统集成架构文档.md`\\n- `/docs/YYC3-CP-架构设计/YYC3-系统集成指南.md`\\n- `/frontend/apps/admin-dashboard/src/lib/integration/index.ts`\\n\\n#### 2.5.3 核心内容\\n\\n- **系统架构文档**: 详细描述系统集成架构，包括各层的集成方式和核心功能\\n- **集成指南**: 提供详细的集成指南，包括快速开始、使用示例、最佳实践等\\n- **统一入口**: 提供统一的集成入口，简化集成流程\\n\\n#### 2.5.4 实施成果\\n\\n✅ 完成系统架构文档编写，详细描述系统集成架构\\n✅ 完成集成指南编写，提供详细的集成指南\\n✅ 完成统一入口实现，提供统一的集成接口\\n✅ 完成最佳实践总结，提供开发指导\\n\\n---\\n\\n## 3. 技术架构\\n\\n### 3.1 整体架构\\n\\n```\\n┌─────────────────────────────────────────────────────────────────┐\\n│                        客户端层 (Client Layer)                    │\\n├─────────────────────────────────────────────────────────────────┤\\n│  Web浏览器      │  移动端H5      │  小程序      │  管理后台        │\\n│  (React 18)     │  (React 18)    │  (原生)       │  (React 18)      │\\n└─────────────────────────────────────────────────────────────────┘\\n                              │\\n                              ▼\\n                ┌─────────────────────────────────────────────────────────┐\\n                │                   UI集成层 (UI Integration Layer)            │\\n                ├─────────────────────────────────────────────────────────┤\\n                │  UI-Business Integration  │  Data Layer Integration   │\\n                │  Multi-Platform Adapter   │  Cross-Dimension Sync     │\\n                └─────────────────────────────────────────────────────────┘\\n                              │\\n                              ▼\\n                ┌─────────────────────────────────────────────────────────┐\\n                │                    业务逻辑层 (Business Layer)                  │\\n                ├─────────────────────────────────────────────────────────┤\\n                │  用户服务  │  菜单服务  │  订单服务  │  库存服务  │  财务服务  │\\n                │  营销服务  │  报表服务  │  消息服务  │  文件服务  │  支付服务  │\\n                └─────────────────────────────────────────────────────────┘\\n                              │\\n                              ▼\\n                ┌─────────────────────────────────────────────────────────┐\\n                │                    数据访问层 (Data Access Layer)            │\\n                ├─────────────────────────────────────────────────────────┤\\n                │  ORM层  │  缓存层  │  消息队列  │  数据同步                    │\\n                └─────────────────────────────────────────────────────────┘\\n                              │\\n                              ▼\\n                ┌─────────────────────────────────────────────────────────┐\\n                │                    数据存储层 (Data Storage Layer)            │\\n                ├─────────────────────────────────────────────────────────┤\\n                │  PostgreSQL  │  Redis  │  MinIO  │  Elasticsearch           │\\n                └─────────────────────────────────────────────────────────┘\\n```\\n\\n### 3.2 技术栈\\n\\n#### 前端技术栈\\n\\n- **核心框架**: React 18.3.1 + TypeScript 5.3+\\n- **构建工具**: Vite 5.0+\\n- **状态管理**: Zustand 4.4+ (轻量级状态管理)\\n- **UI组件库**: Tailwind CSS 4.1.12 + 自研YU组件库\\n- **数据获取**: React Query / SWR\\n- **实时通信**: WebSocket + Server-Sent Events\\n- **离线存储**: IndexedDB + LocalStorage + SessionStorage\\n\\n#### 后端技术栈\\n\\n- **核心框架**: Express.js / Nest.js\\n- **API网关**: Kong / Nginx\\n- **数据库**: PostgreSQL 15+ (多租户架构)\\n- **缓存**: Redis 7+\\n- **消息队列**: RabbitMQ / Kafka\\n- **搜索引擎**: Elasticsearch 8+\\n\\n---\\n\\n## 4. 实施成果\\n\\n### 4.1 功能完成度\\n\\n| 模块 | 功能 | 完成度 | 状态 |\\n|-----|------|--------|------|\\n| UI层与业务逻辑层集成 | API客户端 | 100% | ✅ 完成 |\\n| UI层与业务逻辑层集成 | React Hooks | 100% | ✅ 完成 |\\n| UI层与业务逻辑层集成 | 业务服务层 | 100% | ✅ 完成 |\\n| UI层与业务逻辑层集成 | 错误处理 | 100% | ✅ 完成 |\\n| UI层与业务逻辑层集成 | 请求重试 | 100% | ✅ 完成 |\\n| 数据层与UI层集成 | 缓存管理 | 100% | ✅ 完成 |\\n| 数据层与UI层集成 | 状态管理 | 100% | ✅ 完成 |\\n| 数据层与UI层集成 | 实时数据同步 | 100% | ✅ 完成 |\\n| 数据层与UI层集成 | 离线数据支持 | 100% | ✅ 完成 |\\n| 数据层与UI层集成 | 数据版本控制 | 100% | ✅ 完成 |\\n| 多端适配策略 | 设备类型检测 | 100% | ✅ 完成 |\\n| 多端适配策略 | 平台信息检测 | 100% | ✅ 完成 |\\n| 多端适配策略 | 断点系统 | 100% | ✅ 完成 |\\n| 多端适配策略 | 响应式布局 | 100% | ✅ 完成 |\\n| 多端适配策略 | 触摸手势支持 | 100% | ✅ 完成 |\\n| 多端适配策略 | 平台适配器 | 100% | ✅ 完成 |\\n| 跨维度数据交互与状态同步机制 | 事件总线 | 100% | ✅ 完成 |\\n| 跨维度数据交互与状态同步机制 | 离线队列管理器 | 100% | ✅ 完成 |\\n| 跨维度数据交互与状态同步机制 | 数据冲突解决器 | 100% | ✅ 完成 |\\n| 跨维度数据交互与状态同步机制 | 实时同步管理器 | 100% | ✅ 完成 |\\n| 跨维度数据交互与状态同步机制 | 跨维度数据管理器 | 100% | ✅ 完成 |\\n| 跨维度数据交互与状态同步机制 | React Hooks | 100% | ✅ 完成 |\\n| 系统架构文档和集成指南 | 系统架构文档 | 100% | ✅ 完成 |\\n| 系统架构文档和集成指南 | 集成指南 | 100% | ✅ 完成 |\\n| 系统架构文档和集成指南 | 统一入口 | 100% | ✅ 完成 |\\n| 系统架构文档和集成指南 | 最佳实践 | 100% | ✅ 完成 |\\n\\n**总体完成度**: 100% ✅\\n\\n### 4.2 文件清单\\n\\n| 文件路径 | 描述 | 状态 |\\n|---------|------|------|\\n| `/frontend/apps/admin-dashboard/src/lib/integration/ui-business-integration.ts` | UI层与业务逻辑层集成 | ✅ 完成 |\\n| `/frontend/apps/admin-dashboard/src/lib/integration/data-layer-integration.ts` | 数据层与UI层集成 | ✅ 完成 |\\n| `/frontend/apps/admin-dashboard/src/lib/integration/multi-platform-adapter.ts` | 多端适配策略 | ✅ 完成 |\\n| `/frontend/apps/admin-dashboard/src/lib/integration/cross-dimension-sync.ts` | 跨维度数据交互与状态同步机制 | ✅ 完成 |\\n| `/frontend/apps/admin-dashboard/src/lib/integration/index.ts` | 统一集成入口 | ✅ 完成 |\\n| `/docs/YYC3-CP-架构设计/YYC3-系统集成架构文档.md` | 系统架构文档 | ✅ 完成 |\\n| `/docs/YYC3-CP-架构设计/YYC3-系统集成指南.md` | 集成指南 | ✅ 完成 |\\n\\n---\\n\\n## 5. 技术亮点\\n\\n### 5.1 统一的API客户端\\n\\n提供统一的API客户端，封装所有HTTP请求逻辑，支持自动重试、错误处理、请求拦截等功能，大大简化了API调用。\\n\\n### 5.2 丰富的React Hooks\\n\\n提供丰富的React Hooks，包括`useApi`、`useApiMutation`、`usePaginatedApi`、`useRealtimeData`、`useOptimisticUpdate`等，简化了数据获取和状态管理。\\n\\n### 5.3 多级缓存策略\\n\\n支持内存、LocalStorage、IndexedDB等多种缓存策略，根据数据特点选择合适的缓存策略，提升系统性能。\\n\\n### 5.4 统一状态管理\\n\\n使用Zustand进行统一的状态管理，支持持久化、中间件、DevTools等功能，提供更好的开发体验。\\n\\n### 5.5 实时数据同步\\n\\n支持WebSocket实时数据推送，实现数据的实时更新，提升用户体验。\\n\\n### 5.6 离线数据支持\\n\\n支持离线数据存储和自动同步，确保用户在离线状态下也能正常使用应用，提升用户体验。\\n\\n### 5.7 灵活的断点系统\\n\\n提供灵活的断点系统，支持6个断点（xs、sm、md、lg、xl、2xl），支持响应式布局。\\n\\n### 5.8 触摸手势支持\\n\\n支持触摸手势，包括滑动、点击、长按等，提升移动端体验。\\n\\n### 5.9 平台适配器\\n\\n提供平台适配器，针对不同平台提供特定的适配方案，包括打开链接、分享、复制、震动等功能。\\n\\n### 5.10 事件驱动架构\\n\\n基于事件驱动的数据交互机制，提供事件发布订阅机制，实现组件间的松耦合。\\n\\n### 5.11 数据冲突解决\\n\\n提供灵活的数据冲突解决机制，支持本地优先、远程优先、合并、手动等多种策略。\\n\\n### 5.12 统一的集成入口\\n\\n提供统一的集成入口，简化集成流程，开发者可以通过一个入口访问所有集成功能。\\n\\n---\\n\\n## 6. 使用示例\\n\\n### 6.1 快速开始\\n\\n```typescript\\nimport { yyc3Integration } from '@/lib/integration';\\n\\n// 设置认证令牌\\nyyc3Integration.setAuthToken('your-jwt-token');\\n\\n// 设置租户ID\\nyyc3Integration.setTenantId('your-tenant-id');\\n\\n// 注册数据同步\\nyyc3Integration.registerDataSync({\\n  entity: 'orders',\\n  endpoint: 'http://localhost:3000/api/orders',\\n  syncInterval: 5000,\\n  autoSync: true,\\n  conflictResolution: 'server',\\n  offlineSupport: true,\\n  realTime: true,\\n});\\n```\\n\\n### 6.2 使用API客户端\\n\\n```typescript\\nimport { useApi, useApiMutation } from '@/lib/integration';\\n\\n// 使用API数据\\nfunction OrderList() {\\n  const { data, loading, error, refetch } = useApi('/orders');\\n\\n  if (loading) return <div>加载中...</div>;\\n  if (error) return <div>加载失败: {error.message}</div>;\\n\\n  return (\\n    <div>\\n      {data?.map(order => (\\n        <div key={order.id}>{order.id}</div>\\n      ))}\\n      <button onClick={refetch}>刷新</button>\\n    </div>\\n  );\\n}\\n\\n// 使用API操作\\nfunction CreateOrder() {\\n  const { mutate, loading } = useApiMutation('/orders', 'POST');\\n\\n  const handleSubmit = async (orderData) => {\\n    const response = await mutate(orderData);\\n    if (response.success) {\\n      console.log('订单创建成功');\\n    }\\n  };\\n\\n  return (\\n    <form onSubmit={handleSubmit}>\\n      <button disabled={loading} type=\\\"submit\\\">\\n        {loading ? '提交中...' : '创建订单'}\\n      </button>\\n    </form>\\n  );\\n}\\n```\\n\\n### 6.3 使用状态管理\\n\\n```typescript\\nimport { useOrderStore } from '@/lib/integration';\\n\\nfunction OrderList() {\\n  const { orders, addOrder, updateOrder, removeOrder } = useOrderStore();\\n\\n  const handleAddOrder = async (orderData) => {\\n    const response = await apiClient.post('/orders', orderData);\\n    if (response.success) {\\n      addOrder(response.data);\\n    }\\n  };\\n\\n  return (\\n    <div>\\n      {orders.map(order => (\\n        <div key={order.id}>\\n          <span>{order.id}</span>\\n          <button onClick={() => handleUpdateOrder(order.id, { status: 'completed' })}>\\n            完成\\n          </button>\\n          <button onClick={() => handleRemoveOrder(order.id)}>\\n            删除\\n          </button>\\n        </div>\\n      ))}\\n    </div>\\n  );\\n}\\n```\\n\\n### 6.4 使用多端适配\\n\\n```typescript\\nimport { useBreakpoint, useResponsive } from '@/lib/integration';\\n\\nfunction ResponsiveComponent() {\\n  const breakpoint = useBreakpoint();\\n  const columns = useResponsive({\\n    xs: 1,\\n    sm: 2,\\n    md: 3,\\n    lg: 4,\\n  });\\n\\n  return (\\n    <div>\\n      <div>当前断点: {breakpoint}</div>\\n      <div style={{ display: 'grid', gridTemplateColumns: `repeat(${columns}, 1fr)` }}>\\n        {/* 渲染内容 */}\\n      </div>\\n    </div>\\n  );\\n}\\n```\\n\\n### 6.5 使用跨维度数据同步\\n\\n```typescript\\nimport { useDataEvent, useSyncState, useOfflineQueue } from '@/lib/integration';\\n\\n// 使用数据事件\\nfunction OrderList() {\\n  const orders = useDataEvent('orders', DataOperationType.CREATE);\\n\\n  return (\\n    <div>\\n      {orders?.map(order => (\\n        <div key={order.id}>{order.id}</div>\\n      ))}\\n    </div>\\n  );\\n}\\n\\n// 使用同步状态\\nfunction SyncStatus() {\\n  const syncState = useSyncState('orders');\\n\\n  return (\\n    <div>\\n      同步状态: {syncState}\\n    </div>\\n  );\\n}\\n\\n// 使用离线队列\\nfunction OfflineQueue() {\\n  const { operations, size, syncQueue } = useOfflineQueue();\\n\\n  return (\\n    <div>\\n      <div>离线操作数量: {size}</div>\\n      <button onClick={syncQueue}>同步离线操作</button>\\n      <ul>\\n        {operations.map(op => (\\n          <li key={op.id}>{op.operation} - {op.entity}</li>\\n        ))}\\n      </ul>\\n    </div>\\n  );\\n}\\n```\\n\\n---\\n\\n## 7. 总结\\n\\nYYC³餐饮行业智能化平台的系统集成架构实施已经全部完成，实现了以下核心目标：\\n\\n1. **无缝对接**: UI层与业务逻辑层的无缝对接，消除了数据孤岛\\n2. **深度集成**: 数据层与UI层的深度集成，提供了统一的数据访问接口\\n3. **多端适配**: Web端、移动端、小程序等多终端的一致用户体验\\n4. **实时同步**: 跨维度数据交互与状态同步，确保了数据一致性\\n5. **离线支持**: 离线数据处理和自动同步，提升了用户体验\\n\\n通过这套完整的系统集成架构，整个系统在功能实现、用户体验和技术架构上形成了有机整体，为后续的业务扩展和技术升级奠定了坚实的基础。\\n\\n### 7.1 核心优势\\n\\n- **统一性**: 提供统一的API客户端、状态管理、缓存管理等，简化开发流程\\n- **灵活性**: 支持多种缓存策略、断点系统、冲突解决策略等，满足不同场景需求\\n- **可扩展性**: 基于事件驱动架构，支持灵活扩展\\n- **高性能**: 多级缓存策略、实时数据同步、离线支持等，提升系统性能\\n- **易用性**: 丰富的React Hooks、统一的集成入口、详细的文档等，降低开发门槛\\n\\n### 7.2 未来展望\\n\\n基于当前系统集成架构，未来可以进一步扩展以下功能：\\n\\n1. **多租户支持**: 进一步完善多租户支持，实现租户级别的数据隔离和权限控制\\n2. **国际化支持**: 完善国际化支持，支持多语言、多货币、多时区等\\n3. **性能优化**: 进一步优化性能，包括代码分割、懒加载、预加载等\\n4. **监控告警**: 完善监控告警系统，实现实时监控和告警\\n5. **自动化测试**: 完善自动化测试，提升代码质量和稳定性\\n\\n---\\n\\n**文档版本**: v1.0.0\\n**最后更新**: 2026-01-21\\n**文档状态**: 正式发布\\n\",\"originTextLength\":13986,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768983543514}]",
