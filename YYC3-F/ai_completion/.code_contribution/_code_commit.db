talPages: 0 }\\\\n        }\\\\n      }\\\\n\\\\n      const mockGet = vi.fn().mockResolvedValue({ data: mockResponse })\\\\n      mockAxios.create.mockReturnValue({\\\\n        get: mockGet\\\\n      })\\\\n\\\\n      await kitchenAPI.getInventory({\\\\n        category: \\\\'meat\\\\' as InventoryCategory,\\\\n        status: \\\\'normal\\\\' as InventoryStatus,\\\\n        search: \\\\'猪肉\\\\'\\\\n      })\\\\n\\\\n      expect(mockGet).toHaveBeenCalled()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'createInventoryItem\\\\', () => {\\\\n    it(\\\\'应该成功创建库存项\\\\', async () => {\\\\n      const newItem = {\\\\n        itemCode: \\\\'ING002\\\\',\\\\n        name: \\\\'鸡肉\\\\',\\\\n        category: \\\\'meat\\\\' as InventoryCategory,\\\\n        unit: \\\\'公斤\\\\',\\\\n        quantity: 30,\\\\n        minQuantity: 10,\\\\n        maxQuantity: 100,\\\\n        unitPrice: 30,\\\\n        supplier: \\\\'供应商B\\\\',\\\\n        lastRestockDate: \\\\'2025-01-20\\\\',\\\\n        status: \\\\'normal\\\\' as InventoryStatus,\\\\n        location: \\\\'冷藏库B\\\\'\\\\n      }\\\\n\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: { ...newItem, id: \\\\'inv-2\\\\', createdAt: \\\\'2025-01-20T00:00:00Z\\\\' }\\\\n      }\\\\n\\\\n      mockAxios.create.mockReturnValue({\\\\n        post: vi.fn().mockResolvedValue({ data: mockResponse })\\\\n      })\\\\n\\\\n      const result = await kitchenAPI.createInventoryItem(newItem)\\\\n\\\\n      expect(result.success).toBe(true)\\\\n      expect(result.data.id).toBe(\\\\'inv-2\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'updateInventoryItem\\\\', () => {\\\\n    it(\\\\'应该成功更新库存项\\\\', async () => {\\\\n      const updatedData = {\\\\n        quantity: 60\\\\n      }\\\\n\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: { ...updatedData, id: \\\\'inv-1\\\\' }\\\\n      }\\\\n\\\\n      mockAxios.create.mockReturnValue({\\\\n        put: vi.fn().mockResolvedValue({ data: mockResponse })\\\\n      })\\\\n\\\\n      const result = await kitchenAPI.updateInventoryItem(\\\\'inv-1\\\\', updatedData)\\\\n\\\\n      expect(result.success).toBe(true)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'deleteInventoryItem\\\\', () => {\\\\n    it(\\\\'应该成功删除库存项\\\\', async () => {\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: true\\\\n      }\\\\n\\\\n      mockAxios.create.mockReturnValue({\\\\n        delete: vi.fn().mockResolvedValue({ data: mockResponse })\\\\n      })\\\\n\\\\n      const result = await kitchenAPI.deleteInventoryItem(\\\\'inv-1\\\\')\\\\n\\\\n      expect(result.success).toBe(true)\\\\n      expect(result.data).toBe(true)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'restockInventory\\\\', () => {\\\\n    it(\\\\'应该成功补货\\\\', async () => {\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: {\\\\n          id: \\\\'inv-1\\\\',\\\\n          quantity: 80\\\\n        }\\\\n      }\\\\n\\\\n      mockAxios.create.mockReturnValue({\\\\n        post: vi.fn().mockResolvedValue({ data: mockResponse })\\\\n      })\\\\n\\\\n      const result = await kitchenAPI.restockInventory(\\\\'inv-1\\\\', 30)\\\\n\\\\n      expect(result.success).toBe(true)\\\\n      expect(result.data.quantity).toBe(80)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'getHygieneRecords\\\\', () => {\\\\n    it(\\\\'应该成功获取卫生记录\\\\', async () => {\\\\n      const mockRecords: HygieneRecord[] = [\\\\n        {\\\\n          id: \\\\'hyg-1\\\\',\\\\n          recordCode: \\\\'HYG001\\\\',\\\\n          type: \\\\'daily\\\\',\\\\n          area: \\\\'后厨A区\\\\',\\\\n          inspectorId: \\\\'emp-1\\\\',\\\\n          inspectorName: \\\\'张三\\\\',\\\\n          checkDate: \\\\'2025-01-20\\\\',\\\\n          checkTime: \\\\'08:00\\\\',\\\\n          items: [],\\\\n          result: \\\\'pass\\\\',\\\\n          score: 100,\\\\n          issues: [],\\\\n          photos: [],\\\\n          createdAt: \\\\'2025-01-20T08:00:00Z\\\\'\\\\n        }\\\\n      ]\\\\n\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: {\\\\n          items: mockRecords,\\\\n          pagination: { page: 1, limit: 20, total: 1, totalPages: 1 }\\\\n        }\\\\n      }\\\\n\\\\n      mockAxios.create.mockReturnValue({\\\\n        get: vi.fn().mockResolvedValue({ data: mockResponse })\\\\n      })\\\\n\\\\n      const result = await kitchenAPI.getHygieneRecords()\\\\n\\\\n      expect(result.success).toBe(true)\\\\n      expect(result.data.items).toHaveLength(1)\\\\n    })\\\\n\\\\n    it(\\\\'应该支持卫生记录筛选\\\\', async () => {\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: {\\\\n          items: [],\\\\n          pagination: { page: 1, limit: 20, total: 0, totalPages: 0 }\\\\n        }\\\\n      }\\\\n\\\\n      const mockGet = vi.fn().mockResolvedValue({ data: mockResponse })\\\\n      mockAxios.create.mockReturnValue({\\\\n        get: mockGet\\\\n      })\\\\n\\\\n      await kitchenAPI.getHygieneRecords({\\\\n        type: \\\\'daily\\\\' as HygieneType\\\\n      })\\\\n\\\\n      expect(mockGet).toHaveBeenCalled()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'createHygieneRecord\\\\', () => {\\\\n    it(\\\\'应该成功创建卫生记录\\\\', async () => {\\\\n      const newRecord = {\\\\n        recordCode: \\\\'HYG002\\\\',\\\\n        type: \\\\'daily\\\\' as HygieneType,\\\\n        area: \\\\'后厨B区\\\\',\\\\n        inspectorId: \\\\'emp-2\\\\',\\\\n        inspectorName: \\\\'李四\\\\',\\\\n        checkDate: \\\\'2025-01-20\\\\',\\\\n        checkTime: \\\\'09:00\\\\',\\\\n        items: [],\\\\n        result: \\\\'pass\\\\',\\\\n        score: 100,\\\\n        issues: [],\\\\n        photos: []\\\\n      }\\\\n\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: { ...newRecord, id: \\\\'hyg-2\\\\', createdAt: \\\\'2025-01-20T09:00:00Z\\\\' }\\\\n      }\\\\n\\\\n      mockAxios.create.mockReturnValue({\\\\n        post: vi.fn().mockResolvedValue({ data: mockResponse })\\\\n      })\\\\n\\\\n      const result = await kitchenAPI.createHygieneRecord(newRecord)\\\\n\\\\n      expect(result.success).toBe(true)\\\\n      expect(result.data.id).toBe(\\\\'hyg-2\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'updateHygieneRecord\\\\', () => {\\\\n    it(\\\\'应该成功更新卫生记录\\\\', async () => {\\\\n      const updatedData = {\\\\n        score: 95\\\\n      }\\\\n\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: { ...updatedData, id: \\\\'hyg-1\\\\' }\\\\n      }\\\\n\\\\n      mockAxios.create.mockReturnValue({\\\\n        put: vi.fn().mockResolvedValue({ data: mockResponse })\\\\n      })\\\\n\\\\n      const result = await kitchenAPI.updateHygieneRecord(\\\\'hyg-1\\\\', updatedData)\\\\n\\\\n      expect(result.success).toBe(true)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'getSafetyRecords\\\\', () => {\\\\n    it(\\\\'应该成功获取安全记录\\\\', async () => {\\\\n      const mockRecords: SafetyRecord[] = [\\\\n        {\\\\n          id: \\\\'safe-1\\\\',\\\\n          recordCode: \\\\'SAFE001\\\\',\\\\n          type: \\\\'injury\\\\',\\\\n          location: \\\\'后厨A区\\\\',\\\\n          reporterId: \\\\'emp-1\\\\',\\\\n          reporterName: \\\\'张三\\\\',\\\\n          incidentDate: \\\\'2025-01-20\\\\',\\\\n          incidentTime: \\\\'10:00\\\\',\\\\n          description: \\\\'轻微烫伤\\\\',\\\\n          severity: \\\\'minor\\\\',\\\\n          status: \\\\'resolved\\\\',\\\\n          photos: [],\\\\n          witnesses: [],\\\\n          actions: [],\\\\n          createdAt: \\\\'2025-01-20T10:00:00Z\\\\'\\\\n        }\\\\n      ]\\\\n\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: {\\\\n          items: mockRecords,\\\\n          pagination: { page: 1, limit: 20, total: 1, totalPages: 1 }\\\\n        }\\\\n      }\\\\n\\\\n      mockAxios.create.mockReturnValue({\\\\n        get: vi.fn().mockResolvedValue({ data: mockResponse })\\\\n      })\\\\n\\\\n      const result = await kitchenAPI.getSafetyRecords()\\\\n\\\\n      expect(result.success).toBe(true)\\\\n      expect(result.data.items).toHaveLength(1)\\\\n    })\\\\n\\\\n    it(\\\\'应该支持安全记录筛选\\\\', async () => {\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: {\\\\n          items: [],\\\\n          pagination: { page: 1, limit: 20, total: 0, totalPages: 0 }\\\\n        }\\\\n      }\\\\n\\\\n      const mockGet = vi.fn().mockResolvedValue({ data: mockResponse })\\\\n      mockAxios.create.mockReturnValue({\\\\n        get: mockGet\\\\n      })\\\\n\\\\n      await kitchenAPI.getSafetyRecords({\\\\n        type: \\\\'injury\\\\' as SafetyType,\\\\n        severity: \\\\'minor\\\\' as SafetySeverity,\\\\n        status: \\\\'resolved\\\\' as SafetyStatus\\\\n      })\\\\n\\\\n      expect(mockGet).toHaveBeenCalled()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'createSafetyRecord\\\\', () => {\\\\n    it(\\\\'应该成功创建安全记录\\\\', async () => {\\\\n      const newRecord = {\\\\n        recordCode: \\\\'SAFE002\\\\',\\\\n        type: \\\\'equipment\\\\' as SafetyType,\\\\n        location: \\\\'后厨B区\\\\',\\\\n        reporterId: \\\\'emp-2\\\\',\\\\n        reporterName: \\\\'李四\\\\',\\\\n        incidentDate: \\\\'2025-01-20\\\\',\\\\n        incidentTime: \\\\'11:00\\\\',\\\\n        description: \\\\'设备故障\\\\',\\\\n        severity: \\\\'moderate\\\\' as SafetySeverity,\\\\n        status: \\\\'reported\\\\' as SafetyStatus,\\\\n        photos: [],\\\\n        witnesses: [],\\\\n        actions: []\\\\n      }\\\\n\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: { ...newRecord, id: \\\\'safe-2\\\\', createdAt: \\\\'2025-01-20T11:00:00Z\\\\' }\\\\n      }\\\\n\\\\n      mockAxios.create.mockReturnValue({\\\\n        post: vi.fn().mockResolvedValue({ data: mockResponse })\\\\n      })\\\\n\\\\n      const result = await kitchenAPI.createSafetyRecord(newRecord)\\\\n\\\\n      expect(result.success).toBe(true)\\\\n      expect(result.data.id).toBe(\\\\'safe-2\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'updateSafetyRecord\\\\', () => {\\\\n    it(\\\\'应该成功更新安全记录\\\\', async () => {\\\\n      const updatedData = {\\\\n        status: \\\\'resolved\\\\' as SafetyStatus\\\\n      }\\\\n\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: { ...updatedData, id: \\\\'safe-1\\\\' }\\\\n      }\\\\n\\\\n      mockAxios.create.mockReturnValue({\\\\n        put: vi.fn().mockResolvedValue({ data: mockResponse })\\\\n      })\\\\n\\\\n      const result = await kitchenAPI.updateSafetyRecord(\\\\'safe-1\\\\', updatedData)\\\\n\\\\n      expect(result.success).toBe(true)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'updateSafetyRecordStatus\\\\', () => {\\\\n    it(\\\\'应该成功更新安全记录状态\\\\', async () => {\\\\n      const newStatus: SafetyStatus = \\\\'investigating\\\\'\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: { id: \\\\'safe-1\\\\', status: newStatus }\\\\n      }\\\\n\\\\n      mockAxios.create.mockReturnValue({\\\\n        patch: vi.fn().mockResolvedValue({ data: mockResponse })\\\\n      })\\\\n\\\\n      const result = await kitchenAPI.updateSafetyRecordStatus(\\\\'safe-1\\\\', newStatus)\\\\n\\\\n      expect(result.success).toBe(true)\\\\n      expect(result.data.status).toBe(newStatus)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'getDisplays\\\\', () => {\\\\n    it(\\\\'应该成功获取显示配置\\\\', async () => {\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: [\\\\n          {\\\\n            id: \\\\'disp-1\\\\',\\\\n            displayName: \\\\'热菜显示\\\\',\\\\n            station: \\\\'hot_dish\\\\',\\\\n            type: \\\\'task\\\\',\\\\n            layout: { columns: 3, rows: 4, cardSize: \\\\'medium\\\\', showDetails: true, showTimer: true },\\\\n            filters: [],\\\\n            refreshInterval: 30,\\\\n            isActive: true,\\\\n            createdAt: \\\\'2025-01-01T00:00:00Z\\\\'\\\\n          }\\\\n        ]\\\\n      }\\\\n\\\\n      mockAxios.create.mockReturnValue({\\\\n        get: vi.fn().mockResolvedValue({ data: mockResponse })\\\\n      })\\\\n\\\\n      const result = await kitchenAPI.getDisplays()\\\\n\\\\n      expect(result.success).toBe(true)\\\\n      expect(result.data).toHaveLength(1)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'createDisplay\\\\', () => {\\\\n    it(\\\\'应该成功创建显示配置\\\\', async () => {\\\\n      const newDisplay = {\\\\n        displayName: \\\\'凉菜显示\\\\',\\\\n        station: \\\\'cold_dish\\\\',\\\\n        type: \\\\'task\\\\',\\\\n        layout: { columns: 2, rows: 3, cardSize: \\\\'small\\\\', showDetails: false, showTimer: true },\\\\n        filters: [],\\\\n        refreshInterval: 30,\\\\n        isActive: true\\\\n      }\\\\n\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: { ...newDisplay, id: \\\\'disp-2\\\\', createdAt: \\\\'2025-01-20T00:00:00Z\\\\' }\\\\n      }\\\\n\\\\n      mockAxios.create.mockReturnValue({\\\\n        post: vi.fn().mockResolvedValue({ data: mockResponse })\\\\n      })\\\\n\\\\n      const result = await kitchenAPI.createDisplay(newDisplay)\\\\n\\\\n      expect(result.success).toBe(true)\\\\n      expect(result.data.id).toBe(\\\\'disp-2\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'updateDisplay\\\\', () => {\\\\n    it(\\\\'应该成功更新显示配置\\\\', async () => {\\\\n      const updatedData = {\\\\n        isActive: false\\\\n      }\\\\n\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: { ...updatedData, id: \\\\'disp-1\\\\' }\\\\n      }\\\\n\\\\n      mockAxios.create.mockReturnValue({\\\\n        put: vi.fn().mockResolvedValue({ data: mockResponse })\\\\n      })\\\\n\\\\n      const result = await kitchenAPI.updateDisplay(\\\\'disp-1\\\\', updatedData)\\\\n\\\\n      expect(result.success).toBe(true)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'deleteDisplay\\\\', () => {\\\\n    it(\\\\'应该成功删除显示配置\\\\', async () => {\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: true\\\\n      }\\\\n\",\"originAcceptText\":\"          patch: vi.fn().mockResolvedValue({ data: mockResponse })\\n        })\\n\\n        const result = await kitchenAPI.updateEmployeeStatus('emp-1', status)\\n\\n        expect(result.success).toBe(true)\\n        expect(result.data.status).toBe(status)\\n      }\\n    })\\n  })\\n\\n  describe('getTasks', () => {\\n    it('应该成功获取任务列表', async () => {\\n      const mockTasks: KitchenTask[] = [\\n        {\\n          id: 'task-1',\\n          taskId: 'TASK001',\\n          orderNo: 'ORD001',\\n          itemName: '红烧肉',\\n          quantity: 2,\\n          station: 'hot_dish',\\n          priority: 'high',\\n          status: 'pending',\\n          tableNumber: 'A01',\\n          estimatedTime: 15,\\n          assignedTo: 'emp-1',\\n          createdAt: '2025-01-20T10:00:00Z'\\n        }\\n      ]\\n\\n      const mockResponse = {\\n        success: true,\\n        data: {\\n          items: mockTasks,\\n          pagination: { page: 1, limit: 20, total: 1, totalPages: 1 }\\n        }\\n      }\\n\\n      mockAxios.create.mockReturnValue({\\n        get: vi.fn().mockResolvedValue({ data: mockResponse })\\n      })\\n\\n      const result = await kitchenAPI.getTasks()\\n\\n      expect(result.success).toBe(true)\\n      expect(result.data.items).toHaveLength(1)\\n      expect(result.data.items[0].itemName).toBe('红烧肉')\\n    })\\n\\n    it('应该支持任务筛选', async () => {\\n      const mockResponse = {\\n        success: true,\\n        data: {\\n          items: [],\\n          pagination: { page: 1, limit: 20, total: 0, totalPages: 0 }\\n        }\\n      }\\n\\n      const mockGet = vi.fn().mockResolvedValue({ data: mockResponse })\\n      mockAxios.create.mockReturnValue({\\n        get: mockGet\\n      })\\n\\n      await kitchenAPI.getTasks({\\n        station: 'hot_dish' as TaskStation,\\n        status: 'pending' as TaskStatus,\\n        priority: 'high' as TaskPriority,\\n        search: '红烧肉'\\n      })\\n\\n      expect(mockGet).toHaveBeenCalled()\\n    })\\n  })\\n\\n  describe('createTask', () => {\\n    it('应该成功创建任务', async () => {\\n      const newTask = {\\n        taskId: 'TASK002',\\n        orderNo: 'ORD002',\\n        itemName: '宫保鸡丁',\\n        quantity: 1,\\n        station: 'hot_dish' as TaskStation,\\n        priority: 'normal' as TaskPriority,\\n        status: 'pending' as TaskStatus,\\n        tableNumber: 'A02',\\n        estimatedTime: 18,\\n        createdAt: '2025-01-20T10:10:00Z'\\n      }\\n\\n      const mockResponse = {\\n        success: true,\\n        data: { ...newTask, id: 'task-2' }\\n      }\\n\\n      mockAxios.create.mockReturnValue({\\n        post: vi.fn().mockResolvedValue({ data: mockResponse })\\n      })\\n\\n      const result = await kitchenAPI.createTask(newTask)\\n\\n      expect(result.success).toBe(true)\\n      expect(result.data.id).toBe('task-2')\\n    })\\n  })\\n\\n  describe('updateTask', () => {\\n    it('应该成功更新任务', async () => {\\n      const updatedData = {\\n        status: 'preparing' as TaskStatus\\n      }\\n\\n      const mockResponse = {\\n        success: true,\\n        data: { ...updatedData, id: 'task-1' }\\n      }\\n\\n      mockAxios.create.mockReturnValue({\\n        put: vi.fn().mockResolvedValue({ data: mockResponse })\\n      })\\n\\n      const result = await kitchenAPI.updateTask('task-1', updatedData)\\n\\n      expect(result.success).toBe(true)\\n    })\\n  })\\n\\n  describe('deleteTask', () => {\\n    it('应该成功删除任务', async () => {\\n      const mockResponse = {\\n        success: true,\\n        data: true\\n      }\\n\\n      mockAxios.create.mockReturnValue({\\n        delete: vi.fn().mockResolvedValue({ data: mockResponse })\\n      })\\n\\n      const result = await kitchenAPI.deleteTask('task-1')\\n\\n      expect(result.success).toBe(true)\\n      expect(result.data).toBe(true)\\n    })\\n  })\\n\\n  describe('updateTaskStatus', () => {\\n    it('应该成功更新任务状态', async () => {\\n      const newStatus: TaskStatus = 'ready'\\n      const mockResponse = {\\n        success: true,\\n        data: { id: 'task-1', status: newStatus }\\n      }\\n\\n      mockAxios.create.mockReturnValue({\\n        patch: vi.fn().mockResolvedValue({ data: mockResponse })\\n      })\\n\\n      const result = await kitchenAPI.updateTaskStatus('task-1', newStatus)\\n\\n      expect(result.success).toBe(true)\\n      expect(result.data.status).toBe(newStatus)\\n    })\\n\\n    it('应该支持所有任务状态', async () => {\\n      const statuses: TaskStatus[] = ['pending', 'preparing', 'ready', 'served', 'cancelled']\\n\\n      for (const status of statuses) {\\n        const mockResponse = {\\n          success: true,\\n          data: { id: 'task-1', status }\\n        }\\n\\n        mockAxios.create.mockReturnValue({\\n          patch: vi.fn().mockResolvedValue({ data: mockResponse })\\n        })\\n\\n        const result = await kitchenAPI.updateTaskStatus('task-1', status)\\n\\n        expect(result.success).toBe(true)\\n        expect(result.data.status).toBe(status)\\n      }\\n    })\\n  })\\n\\n  describe('assignTask', () => {\\n    it('应该成功分配任务', async () => {\\n      const mockResponse = {\\n        success: true,\\n        data: {\\n          id: 'task-1',\\n          assignedTo: 'emp-2'\\n        }\\n      }\\n\\n      mockAxios.create.mockReturnValue({\\n        patch: vi.fn().mockResolvedValue({ data: mockResponse })\\n      })\\n\\n      const result = await kitchenAPI.assignTask('task-1', 'emp-2')\\n\\n      expect(result.success).toBe(true)\\n      expect(result.data.assignedTo).toBe('emp-2')\\n    })\\n  })\\n\\n  describe('getInventory', () => {\\n    it('应该成功获取库存列表', async () => {\\n      const mockInventory: KitchenInventory[] = [\\n        {\\n          id: 'inv-1',\\n          itemCode: 'ING001',\\n          name: '猪肉',\\n          category: 'meat',\\n          unit: 