ect(wrapper.vm.tasks[0].status).toBe('preparing')\",\"originTextLength\":58,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768891628563},{\"originRange\":{\"start\":{\"line\":312,\"character\":0},\"end\":{\"line\":312,\"character\":48}},\"modifyRange\":{\"start\":{\"line\":312,\"character\":0},\"end\":{\"line\":312,\"character\":48}},\"action\":\"None\",\"isLine\":false,\"originText\":\"      expect(wrapper.vm.loadTasks).toBeDefined()\",\"originAcceptText\":\"      expect(wrapper.vm.loadTasks).toBeDefined()\",\"originTextLength\":48,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768891646181},{\"originRange\":{\"start\":{\"line\":258,\"character\":0},\"end\":{\"line\":258,\"character\":48}},\"modifyRange\":{\"start\":{\"line\":258,\"character\":0},\"end\":{\"line\":258,\"character\":48}},\"action\":\"None\",\"isLine\":false,\"originText\":\"      expect(wrapper.vm.activeTab).toBeDefined()\",\"originAcceptText\":\"      expect(wrapper.vm.activeTab).toBeDefined()\",\"originTextLength\":48,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768891689167},{\"originRange\":{\"start\":{\"line\":265,\"character\":0},\"end\":{\"line\":265,\"character\":50}},\"modifyRange\":{\"start\":{\"line\":265,\"character\":0},\"end\":{\"line\":265,\"character\":50}},\"action\":\"None\",\"isLine\":false,\"originText\":\"      expect(wrapper.vm.stats.activeTasks).toBe(5)\",\"originAcceptText\":\"      expect(wrapper.vm.stats.activeTasks).toBe(5)\",\"originTextLength\":50,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768891689211},{\"originRange\":{\"start\":{\"line\":253,\"character\":0},\"end\":{\"line\":253,\"character\":48}},\"modifyRange\":{\"start\":{\"line\":253,\"character\":0},\"end\":{\"line\":253,\"character\":48}},\"action\":\"None\",\"isLine\":false,\"originText\":\"      expect(wrapper.vm.activeTab).toBeDefined()\",\"originAcceptText\":\"      expect(wrapper.vm.activeTab).toBeDefined()\",\"origin