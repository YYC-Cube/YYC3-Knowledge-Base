urnRate\\\\\\\": 0.04\",\"originAcceptText\":\"        \\\"date\\\": \\\"2026-01-01\\\",\\n        \\\"churnCount\\\": 5,\\n        \\\"churnRate\\\": 0.05\\n      },\\n      {\\n        \\\"date\\\": \\\"2026-01-02\\\",\\n        \\\"churnCount\\\": 4,\\n        \\\"churnRate\\\": 0.04\",\"originTextLength\":178,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768914044038},{\"originRange\":{\"start\":{\"line\":493,\"character\":0},\"end\":{\"line\":507,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":493,\"character\":0},\"end\":{\"line\":507,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"### 5.7 获取流失趋势分析\\\\n\\\\n#### 5.7.1 接口说明\\\\n\\\\n获取流失趋势分析数据。\\\\n\\\\n#### 5.7.2 请求方式\\\\n\\\\n```http\\\\nGET /api/v1/churn-predictions/trends\\\\n```\\\\n\\\\n#### 5.7.3 请求参数\\\\n\\\\n| 参数名 | 类型 | 位置 | 必填 | 说明 |\\\\n|--------|------|------|------|------|\\\\n| startDate | string | query | 否 | 开始日期 |\\\\n| endDate | string | query | 否 | 结束日期 |\\\\n| granularity | string | query | 否 | 时间粒度（day/week/month），默认day |\\\\n\\\\n#### 5.7.4 响应示例\\\\n\",\"originAcceptText\":\"### 5.7 获取流失趋势分析\\n\\n#### 5.7.1 接口说明\\n\\n获取流失趋势分析数据。\\n\\n#### 5.7.2 请求方式\\n\\n```http\\nGET /api/v1/churn-predictions/trends\\n```\\n\\n#### 5.7.3 请求参数\\n\\n| 参数名 | 类型 | 位置 | 必填 | 说明 |\\n|--------|------|------|------|------|\\n| startDate | string | query | 否 | 开始日期 |\\n| endDate | string | query | 否 | 结束日期 |\\n| granularity | string | query | 否 | 时间粒度（day/week/month），默认day |\\n\\n#### 5.7.4 响应示例\\n\",\"originTextLength\":364,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768914044066},{\"originRange\":{\"start\":{\"line\":500,\"character\":0},\"end\":{\"line\":557,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":500,\"character\":0},\"end\":{\"line\":557,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"  \\\\\\\"code\\\\\\\": 200,\\\\n  \\\\\\\"message\\\\\\\": \\\\\\\"success\\\\\\\",\\\\n  \\\\\\\"data\\\\\\\": {\\\\n    \\\\\\\"trends\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"date\\\\\\\": \\\\\\\"2026-01-01\\\\\\\",\\\\n        \\\\\\\"highRiskCount\\\\\\\": 2,\\\\n        \\\\\\\"mediumRiskCount\\\\\\\": 5,\\\\n        \\\\\\\"lowRiskCount\\\\\\\": 3,\\\\n        \\\\\\\"totalChurned\\\\\\\": 5,\\\\n        \\\\\\\"churnRate\\\\\\\": 0.05\\\\n      },\\\\n      {\\\\n        \\\\\\\"date\\\\\\\": \\\\\\\"2026-01-02\\\\\\\",\\\\n        \\\\\\\"highRiskCount\\\\\\\": 3,\\\\n        \\\\\\\"mediumRiskCount\\\\\\\": 4,\\\\n        \\\\\\\"lowRiskCount\\\\\\\": 2,\\\\n        \\\\\\\"totalChurned\\\\\\\": 4,\\\\n        \\\\\\\"churnRate\\\\\\\": 0.04\\\\n      }\\\\n    ]\\\\n  }\\\\n}\\\\n```\\\\n\\\\n### 5.8 导出流失预警报告\\\\n\\\\n#### 5.8.1 接口说明\\\\n\\\\n导出流失预警报告。\\\\n\\\\n#### 5.8.2 请求方式\\\\n\\\\n```http\\\\nGET /api/v1/churn-predictions/export\\\\n```\\\\n\\\\n#### 5.8.3 请求参数\\\\n\\\\n| 参数名 | 类型 | 位置 | 必填 | 说明 |\\\\n|--------|------|------|------|------|\\\\n| startDate | string | query | 否 | 开始日期 |\\\\n| endDate | string | query | 否 | 结束日期 |\\\\n| format | string | query | 否 | 导出格式（pdf/excel），默认excel |\\\\n\\\\n#### 5.8.4 响应\\\\n\\\\n返回文件流，Content-Type为`application/pdf`或`application/vnd.ms-excel`。\\\\n\\\\n---\\\\n\\\\n## 6. 关怀提醒接口\\\\n\\\\n### 6.1 获取关怀提醒列表\\\\n\\\\n#### 6.1.1 接口说明\\\\n\\\\n获取客户关怀提醒列表。\\\\n\\\\n#### 6.1.2 请求方式\\\\n\\\\n```http\\\\nGET /api/v1/care-reminders\\\\n```\\\\n\\\\n#### 6.1.3 请求参数\\\\n\\\\n| 参数名 | 类型 | 位置 | 必填 | 说明 |\\\\n|--------|------|------|------|------|\\\\n| customerId | string | query | 否 | 客户ID |\\\\n| reminderType | string | query | 否 | 提醒类型 |\\\\n| status | string | query | 否 | 状态（pending/sent/failed） |\\\\n| page | number | query | 否 | 页码 |\\\\n| size | number | query | 否 | 每页数量 |\\\\n\\\\n#### 6.1.4 响应示例\\\\n\",\"originAcceptText\":\"  \\\"code\\\": 200,\\n  \\\"message\\\": \\\"success\\\",\\n  \\\"data\\\": {\\n    \\\"trends\\\": [\\n      {\\n        \\\"date\\\": \\\"2026-01-01\\\",\\n        \\\"highRiskCount\\\": 2,\\n        \\\"mediumRiskCount\\\": 5,\\n        \\\"lowRiskCount\\\": 3,\\n        \\\"totalChurned\\\": 5,\\n        \\\"churnRate\\\": 0.05\\n      },\\n      {\\n        \\\"date\\\": \\\"2026-01-02\\\",\\n        \\\"highRiskCount\\\": 3,\\n        \\\"mediumRiskCount\\\": 4,\\n        \\\"lowRiskCount\\\": 2,\\n        \\\"totalChurned\\\": 4,\\n        \\\"churnRate\\\": 0.04\\n      }\\n    ]\\n  }\\n}\\n```\\n\\n### 5.8 导出流失预警报告\\n\\n#### 5.8.1 接口说明\\n\\n导出流失预警报告。\\n\\n#### 5.8.2 请求方式\\n\\n```http\\nGET /api/v1/churn-predictions/export\\n```\\n\\n#### 5.8.3 请求参数\\n\\n| 参数名 | 类型 | 位置 | 必填 | 说明 |\\n|--------|------|------|------|------|\\n| startDate | string | query | 否 | 开始日期 |\\n| endDate | string | query | 否 | 结束日期 |\\n| format | string | query | 否 | 导出格式（pdf/excel），默认excel |\\n\\n#### 5.8.4 响应\\n\\n返回文件流，Content-Type为`application/pdf`或`application/vnd.ms-excel`。\\n\\n---\\n\\n## 6. 关怀提醒接口\\n\\n### 6.1 获取关怀提醒列表\\n\\n#### 6.1.1 接口说明\\n\\n获取客户关怀提醒列表。\\n\\n#### 6.1.2 请求方式\\n\\n```http\\nGET /api/v1/care-reminders\\n```\\n\\n#### 6.1.3 请求参数\\n\\n| 参数名 | 类型 | 位置 | 必填 | 说明 |\\n|--------|------|------|------|------|\\n| customerId | string | query | 否 | 客户ID |\\n| reminderType | string | query | 否 | 提醒类型 |\\n| status | string | query | 否 | 状态（pending/sent/failed） |\\n| page | number | query | 否 | 页码 |\\n| size | number | query | 否 | 每页数量 |\\n\\n#### 6.1.4 响应示例\\n\",\"originTextLength\":1315,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768914044092},{\"originRange\":{\"start\":{\"line\":514,\"character\":0},\"end\":{\"line\":515,\"character\":23}},\"modifyRange\":{\"start\":{\"line\":514,\"character\":0},\"end\":{\"line\":515,\"character\":23}},\"action\":\"None\",\"isLine\":false,\"originText\":\"  \\\\\\\"code\\\\\\\": 200,\\\\n  \\\\\\\"message\\\\\\\": \\\\\\\"success\\\\\\\",\",\"originAcceptText\":\"  \\\"code\\\": 200,\\n  \\\"message\\\": \\\"success\\\",\",\"originTextLength\":38,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"update