\',\\\\n      aboutUs: \\\\'About Us\\\\',\\\\n      terms: \\\\'Terms\\\\',\\\\n      privacyPolicy: \\\\'Privacy Policy\\\\',\\\\n      logout: \\\\'Logout\\\\',\\\\n      editProfile: \\\\'Edit Profile\\\\',\\\\n      updateProfile: \\\\'Update Profile\\\\',\\\\n      deleteAccount: \\\\'Delete Account\\\\',\\\\n      accountSettings: \\\\'Account Settings\\\\',\\\\n      securitySettings: \\\\'Security Settings\\\\',\\\\n      privacySettings: \\\\'Privacy Settings\\\\',\\\\n      notificationSettings: \\\\'Notification Settings\\\\'\\\\n    },\\\\n    dashboard: {\\\\n      dashboard: \\\\'Dashboard\\\\',\\\\n      overview: \\\\'Overview\\\\',\\\\n      stats: \\\\'Stats\\\\',\\\\n      today: \\\\'Today\\\\',\\\\n      thisWeek: \\\\'This Week\\\\',\\\\n      thisMonth: \\\\'This Month\\\\',\\\\n      thisYear: \\\\'This Year\\\\',\\\\n      totalOrders: \\\\'Total Orders\\\\',\\\\n      totalSales: \\\\'Total Sales\\\\',\\\\n      totalCustomers: \\\\'Total Customers\\\\',\\\\n      totalProducts: \\\\'Total Products\\\\',\\\\n      avgOrderValue: \\\\'Average Order Value\\\\',\\\\n      conversionRate: \\\\'Conversion Rate\\\\',\\\\n      bounceRate: \\\\'Bounce Rate\\\\',\\\\n      pageViews: \\\\'Page Views\\\\',\\\\n      uniqueVisitors: \\\\'Unique Visitors\\\\',\\\\n      onlineUsers: \\\\'Online Users\\\\',\\\\n      recentOrders: \\\\'Recent Orders\\\\',\\\\n      topProducts: \\\\'Top Products\\\\',\\\\n      topCategories: \\\\'Top Categories\\\\',\\\\n      topCustomers: \\\\'Top Customers\\\\',\\\\n      salesTrend: \\\\'Sales Trend\\\\',\\\\n      orderTrend: \\\\'Order Trend\\\\',\\\\n      customerTrend: \\\\'Customer Trend\\\\',\\\\n      trafficTrend: \\\\'Traffic Trend\\\\'\\\\n    },\\\\n    error: {\\\\n      400: \\\\'Bad Request\\\\',\\\\n      401: \\\\'Unauthorized\\\\',\\\\n      403: \\\\'Forbidden\\\\',\\\\n      404: \\\\'Not Found\\\\',\\\\n      405: \\\\'Method Not Allowed\\\\',\\\\n      406: \\\\'Not Acceptable\\\\',\\\\n      408: \\\\'Request Timeout\\\\',\\\\n      409: \\\\'Conflict\\\\',\\\\n      410: \\\\'Gone\\\\',\\\\n      411: \\\\'Length Required\\\\',\\\\n      412: \\\\'Precondition Failed\\\\',\\\\n      413: \\\\'Payload Too Large\\\\',\\\\n      414: \\\\'URI Too Long\\\\',\\\\n      415: \\\\'Unsupported Media Type\\\\',\\\\n      416: \\\\'Range Not Satisfiable\\\\',\\\\n      417: \\\\'Expectation Failed\\\\',\\\\n      422: \\\\'Unprocessable Entity\\\\',\\\\n      423: \\\\'Locked\\\\',\\\\n      424: \\\\'Failed Dependency\\\\',\\\\n      426: \\\\'Upgrade Required\\\\',\\\\n      428: \\\\'Precondition Required\\\\',\\\\n      429: \\\\'Too Many Requests\\\\',\\\\n      431: \\\\'Request Header Fields Too Large\\\\',\\\\n      451: \\\\'Unavailable For Legal Reasons\\\\',\\\\n      500: \\\\'Internal Server Error\\\\',\\\\n      501: \\\\'Not Implemented\\\\',\\\\n      502: \\\\'Bad Gateway\\\\',\\\\n      503: \\\\'Service Unavailable\\\\',\\\\n      504: \\\\'Gateway Timeout\\\\',\\\\n      505: \\\\'HTTP Version Not Supported\\\\',\\\\n      506: \\\\'Variant Also Negotiates\\\\',\\\\n      507: \\\\'Insufficient Storage\\\\',\\\\n      508: \\\\'Loop Detected\\\\',\\\\n      510: \\\\'Not Extended\\\\',\\\\n      511: \\\\'Network Authentication Required\\\\',\\\\n      general: \\\\'Error\\\\',\\\\n      unexpected: \\\\'Unexpected Error\\\\',\\\\n      tryAgain: \\\\'Please try again later\\\\',\\\\n      contactSupport: \\\\'Please contact support\\\\',\\\\n      pageNotFound: \\\\'Page Not Found\\\\',\\\\n      resourceNotFound: \\\\'Resource Not Found\\\\',\\\\n      notFound: \\\\'Not Found\\\\'\\\\n    }\\\\n  },\\\\n  \\\\'ja-JP\\\\': {\\\\n    common: {\\\\n      hello: \\\\'こんにちは\\\\',\\\\n      welcome: \\\\'ようこそ\\\\',\\\\n      yes: \\\\'はい\\\\',\\\\n      no: \\\\'いいえ\\\\',\\\\n      save: \\\\'保存\\\\',\\\\n      cancel: \\\\'キャンセル\\\\',\\\\n      delete: \\\\'削除\\\\',\\\\n      edit: \\\\'編集\\\\',\\\\n      create: \\\\'作成\\\\',\\\\n      update: \\\\'更新\\\\',\\\\n      search: \\\\'検索\\\\',\\\\n      filter: \\\\'フィルター\\\\',\\\\n      sort: \\\\'ソート\\\\',\\\\n      export: \\\\'エクスポート\\\\',\\\\n      import: \\\\'インポート\\\\',\\\\n      refresh: \\\\'更新\\\\',\\\\n      clear: \\\\'クリア\\\\',\\\\n      close: \\\\'閉じる\\\\',\\\\n      open: \\\\'開く\\\\',\\\\n      view: \\\\'表示\\\\',\\\\n      back: \\\\'戻る\\\\',\\\\n      next: \\\\'次へ\\\\',\\\\n      previous: \\\\'前へ\\\\',\\\\n      finish: \\\\'完了\\\\',\\\\n      loading: \\\\'読み込み中...\\\\',\\\\n      success: \\\\'成功\\\\',\\\\n      error: \\\\'エラー\\\\',\\\\n      warning: \\\\'警告\\\\',\\\\n      info: \\\\'情報\\\\',\\\\n      confirm: \\\\'確認\\\\',\\\\n      optional: \\\\'オプション\\\\',\\\\n      select: \\\\'選択\\\\',\\\\n      deselect: \\\\'選択解除\\\\',\\\\n      all: \\\\'すべて\\\\',\\\\n      none: \\\\'なし\\\\',\\\\n      more: \\\\'もっと\\\\',\\\\n      less: \\\\'少なく\\\\',\\\\n      add: \\\\'追加\\\\',\\\\n      remove: \\\\'削除\\\\',\\\\n      upload: \\\\'アップロード\\\\',\\\\n      download: \\\\'ダウンロード\\\\',\\\\n      print: \\\\'印刷\\\\',\\\\n      share: \\\\'共有\\\\',\\\\n      copy: \\\\'コピー\\\\',\\\\n      paste: \\\\'ペースト\\\\',\\\\n      cut: \\\\'カット\\\\',\\\\n      undo: \\\\'元に戻す\\\\',\\\\n      redo: \\\\'やり直し\\\\',\\\\n      searchPlaceholder: \\\\'検索...\\\\',\\\\n      filterPlaceholder: \\\\'フィルター...\\\\',\\\\n      selectPlaceholder: \\\\'選択...\\\\',\\\\n      enterText: \\\\'テキストを入力してください\\\\',\\\\n      enterNumber: \\\\'数字を入力してください\\\\',\\\\n      enterEmail: \\\\'メールアドレスを入力してください\\\\',\\\\n      enterPhone: \\\\'電話番号を入力してください\\\\',\\\\n      enterPassword: \\\\'パスワードを入力してください\\\\',\\\\n      enterConfirmPassword: \\\\'パスワードを確認してください\\\\',\\\\n      enterDate: \\\\'日付を入力してください\\\\',\\\\n      enterTime: \\\\'時間を入力してください\\\\',\\\\n      enterDateTime: \\\\'日付と時間を入力してください\\\\',\\\\n      enterUrl: \\\\'URLを入力してください\\\\',\\\\n      enterAddress: \\\\'住所を入力してください\\\\',\\\\n      enterName: \\\\'名前を入力してください\\\\',\\\\n      enterUsername: \\\\'ユーザー名を入力してください\\\\',\\\\n      enterTitle: \\\\'タイトルを入力してください\\\\',\\\\n      enterDescription: \\\\'説明を入力してください\\\\',\\\\n      enterNotes: \\\\'メモを入力してください\\\\',\\\\n      enterTags: \\\\'タグを入力してください\\\\',\\\\n      enterKeywords: \\\\'キーワードを入力してください\\\\',\\\\n      enterAmount: \\\\'金額を入力してください\\\\',\\\\n      enterQuantity: \\\\'数量を入力してください\\\\',\\\\n      enterPrice: \\\\'価格を入力してください\\\\',\\\\n      enterDiscount: \\\\'割引を入力してください\\\\',\\\\n      enterTax: \\\\'税金を入力してください\\\\',\\\\n      enterShipping: \\\\'配送料を入力してください\\\\',\\\\n      enterTotal: \\\\'合計を入力してください\\\\',\\\\n      enterCurrency: \\\\'通貨を入力してください\\\\',\\\\n      enterUnit: \\\\'単位を入力してください\\\\',\\\\n      enterRate: \\\\'レートを入力してください\\\\',\\\\n      enterPercentage: \\\\'パーセンテージを入力してください\\\\',\\\\n      enterRating: \\\\'評価を入力してください\\\\',\\\\n      enterFeedback: \\\\'フィードバックを入力してください\\\\',\\\\n      enterComment: \\\\'コメントを入力してください\\\\',\\\\n      enterReview: \\\\'レビューを入力してください\\\\',\\\\n      enterMessage: \\\\'メッセージを入力してください\\\\',\\\\n      enterSubject: \\\\'件名を入力してください\\\\',\\\\n      enterBody: \\\\'本文を入力してください\\\\'\\\\n    }\\\\n  }\\\\n};\\\\n\\\\n// 支持的语言配置\\\\nexport const supportedLanguages: LanguageConfig[] = [\\\\n  {\\\\n    code: \\\\'zh-CN\\\\',\\\\n    name: \\\\'Chinese (Simplified)\\\\',\\\\n    nativeName: \\\\'简体中文\\\\',\\\\n    flag: \\\\'🇨🇳\\\\'\\\\n  },\\\\n  {\\\\n    code: \\\\'en-US\\\\',\\\\n    name: \\\\'English (US)\\\\',\\\\n    nativeName: \\\\'English (US)\\\\',\\\\n    flag: \\\\'🇺🇸\\\\'\\\\n  },\\\\n  {\\\\n    code: \\\\'ja-JP\\\\',\\\\n    name: \\\\'Japanese\\\\',\\\\n    nativeName: \\\\'日本語\\\\',\\\\n    flag: \\\\'🇯🇵\\\\'\\\\n  }\\\\n];\\\\n\\\\n// 默认语言\\\\nexport const DEFAULT_LANGUAGE: LanguageCode = \\\\'zh-CN\\\\';\\\\n\\\\n// 国际化服务类\\\\nexport class I18nService {\\\\n  private static instance: I18nService;\\\\n  private currentLanguage: LanguageCode = DEFAULT_LANGUAGE;\\\\n  private resources: Record<LanguageCode, TranslationResource> = translationResources;\\\\n\\\\n  // 单例模式\\\\n  private constructor() {}\\\\n\\\\n  /**\\\\n   * 获取单例实例\\\\n   */\\\\n  public static getInstance(): I18nService {\\\\n    if (!I18nService.instance) {\\\\n      I18nService.instance = new I18nService();\\\\n    }\\\\n    return I18nService.instance;\\\\n  }\\\\n\\\\n  /**\\\\n   * 设置当前语言\\\\n   * @param languageCode 语言代码\\\\n   */\\\\n  public setLanguage(languageCode: LanguageCode): void {\\\\n    if (this.resources[languageCode]) {\\\\n      this.currentLanguage = languageCode;\\\\n      // 保存到localStorage或cookie\\\\n      if (typeof window !== \\\\'undefined\\\\') {\\\\n        localStorage.setItem(\\\\'language\\\\', languageCode);\\\\n      }\\\\n    } else {\\\\n      throw new Error(`不支持的语言: ${languageCode}`);\\\\n    }\\\\n  }\\\\n\\\\n  /**\\\\n   * 获取当前语言\\\\n   */\\\\n  public getLanguage(): LanguageCode {\\\\n    return this.currentLanguage;\\\\n  }\\\\n\\\\n  /**\\\\n   * 获取翻译\\\\n   * @param key 翻译键\\\\n   * @param options 选项\\\\n   */\\\\n  public t(key: string, options: { [key: string]: any } = {}): string {\\\\n    const keys = key.split(\\\\'.\\\\');\\\\n    let value: any = this.resources[this.currentLanguage];\\\\n\\\\n    for (const k of keys) {\\\\n      if (value && typeof value === \\\\'object\\\\' && k in value) {\\\\n        value = value[k];\\\\n      } else {\\\\n        // 如果找不到翻译，返回键本身\\\\n        return key;\\\\n      }\\\\n    }\\\\n\\\\n    // 如果是字符串，进行变量替换\\\\n    if (typeof value === \\\\'string\\\\') {\\\\n      return this.replacePlaceholders(value, options);\\\\n    }\\\\n\\\\n    // 如果不是字符串，返回键本身\\\\n    return key;\\\\n  }\\\\n\\\\n  /**\\\\n   * 替换占位符\\\\n   * @param text 文本\\\\n   * @param placeholders 占位符\\\\n   */\\\\n  private replacePlaceholders(text: string, placeholders: { [key: string]: any }): string {\\\\n    return text.replace(/\\\\\\\\{\\\\\\\\{([^}]+)\\\\\\\\}\\\\\\\\}/g, (match, key) => {\\\\n      return placeholders[key.trim()] !== undefined ? placeholders[key.trim()] : match;\\\\n    });\\\\n  }\\\\n\\\\n  /**\\\\n   * 获取支持的语言列表\\\\n   */\\\\n  public getSupportedLanguages(): LanguageConfig[] {\\\\n    return supportedLanguages;\\\\n  }\\\\n\\\\n  /**\\\\n   * 动态加载语言资源\\\\n   * @param languageCode 语言代码\\\\n   * @param resource 语言资源\\\\n   */\\\\n  public loadLanguage(languageCode: LanguageCode, resource: TranslationResource): void {\\\\n    this.resources[languageCode] = {\\\\n      ...this.resources[languageCode],\\\\n      ...resource\\\\n    };\\\\n  }\\\\n\\\\n  /**\\\\n   * 初始化语言\\\\n   */\\\\n  public init(): void {\\\\n    // 从localStorage或cookie获取语言设置\\\\n    if (typeof window !== \\\\'undefined\\\\') {\\\\n      const savedLanguage = localStorage.getItem(\\\\'language\\\\') as LanguageCode;\\\\n      if (savedLanguage && this.resources[savedLanguage]) {\\\\n        this.currentLanguage = savedLanguage;\\\\n      }\\\\n    }\\\\n  }\\\\n}\\\\n\\\\n// 导出单例实例\\\\nexport const i18n = I18nService.getInstance();\\\\n\",\"originAcceptText\":\"/**\\n * @file 国际化服务\\n * @description 提供多语言支持和翻译功能\\n * @module i18n\\n * @author YYC\\n * @version 1.0.0\\n * @created 2024-12-06\\n * @updated 2024-12-06\\n */\\n\\n// 支持的语言类型\\nexport type LanguageCode = 'zh-CN' | 'en-US' | 'ja-JP';\\n\\n// 翻译资源接口\\nexport interface TranslationResource {\\n  [key: string]: string | TranslationResource;\\n}\\n\\n// 语言配置接口\\nexport interface LanguageConfig {\\n  code: LanguageCode;\\n  name: string;\\n  nativeName: string;\\n  flag: string;\\n}\\n\\n// 翻译资源\\nexport const translationResources: Record<LanguageCode, TranslationResource> = {\\n  'zh-CN': {\\n    common: {\\n      hello: '你好',\\n      welcome: '欢迎',\\n      yes: '是',\\n      no: '否',\\n      save: '保存',\\n      cancel: '取消',\\n      delete: '删除',\\n      edit: '编辑',\\n      create: '创建',\\n      update: '更新',\\n      search: '搜索',\\n      filter: '筛选',\\n      sort: '排序',\\n      export: '导出',\\n      import: '导入',\\n      refresh: '刷新',\\n      clear: '清除',\\n      close: '关闭',\\n      open: '打开',\\