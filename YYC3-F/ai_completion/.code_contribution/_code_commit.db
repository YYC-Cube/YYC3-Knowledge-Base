  "range-cache-file:///Users/my/Downloads/%E6%99%BA%E6%9E%A2%E6%9C%8D%E5%8A%A1%E5%B9%B3%E5%8F%B0/services/laundry-orders-service/services/order.service.ts": "[{\"originRange\":{\"start\":{\"line\":3,\"character\":0},\"end\":{\"line\":3,\"character\":24}},\"modifyRange\":{\"start\":{\"line\":3,\"character\":0},\"end\":{\"line\":3,\"character\":24}},\"action\":\"None\",\"isLine\":false,\"originText\":\" * @module order-service\",\"originAcceptText\":\" * @module order-service\",\"originTextLength\":24,\"aiScene\":\"Completion\",\"behaviorType\":\"accept\",\"updateTime\":1766162510041},{\"originRange\":{\"start\":{\"line\":5,\"character\":0},\"end\":{\"line\":6,\"character\":22}},\"modifyRange\":{\"start\":{\"line\":5,\"character\":0},\"end\":{\"line\":6,\"character\":22}},\"action\":\"None\",\"isLine\":false,\"originText\":\" * @created 2024-01-01\\\\n * @updated 2024-12-06\",\"originAcceptText\":\" * @created 2024-01-01\\n * @updated 2024-12-06\",\"originTextLength\":45,\"aiScene\":\"Completion\",\"behaviorType\":\"accept\",\"updateTime\":1766162510042},{\"originRange\":{\"start\":{\"line\":12,\"character\":0},\"end\":{\"line\":12,\"character\":91}},\"modifyRange\":{\"start\":{\"line\":12,\"character\":0},\"end\":{\"line\":12,\"character\":91}},\"action\":\"None\",\"isLine\":false,\"originText\":\"import { OrderStatus, orderStatusService } from \\\\'../../../lib/orders/order.status.service\\\\';\",\"originAcceptText\":\"import { OrderStatus, orderStatusService } from '../../../lib/orders/order.status.service';\",\"originTextLength\":91,\"aiScene\":\"Completion\",\"behaviorType\":\"accept\",\"updateTime\":1766162510043},{\"originRange\":{\"start\":{\"line\":144,\"character\":0},\"end\":{\"line\":144,\"character\":57}},\"modifyRange\":{\"start\":{\"line\":144,\"character\":0},\"end\":{\"line\":144,\"character\":57}},\"action\":\"None\",\"isLine\":false,\"originText\":\"    if (!orderStatusService.isValidOrderStatus(status)) {\",\"originAcceptText\":\"    if (!orderStat