{
  "range-cache-file:///Users/my/Downloads/%E6%99%BA%E6%9E%A2%E6%9C%8D%E5%8A%A1%E5%B9%B3%E5%8F%B0/.eslintrc.js": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":43,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":43,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"/**\\\\n * ESLint配置文件\\\\n * @description YYC³团队ESLint规则配置\\\\n * @author YYC³\\\\n */\\\\nmodule.exports = {\\\\n  root: true,\\\\n  env: {\\\\n    node: true,\\\\n    browser: true,\\\\n    es2021: true,\\\\n    jest: true,\\\\n  },\\\\n  extends: [\\\\n    \\\\'eslint:recommended\\\\',\\\\n    \\\\'next/core-web-vitals\\\\',\\\\n    \\\\'plugin:@typescript-eslint/recommended\\\\',\\\\n    \\\\'plugin:prettier/recommended\\\\',\\\\n  ],\\\\n  parser: \\\\'@typescript-eslint/parser\\\\',\\\\n  parserOptions: {\\\\n    ecmaFeatures: {\\\\n      jsx: true,\\\\n    },\\\\n    ecmaVersion: \\\\'latest\\\\',\\\\n    sourceType: \\\\'module\\\\',\\\\n  },\\\\n  plugins: [\\\\'@typescript-eslint\\\\', \\\\'prettier\\\\'],\\\\n  rules: {\\\\n    \\\\'prettier/prettier\\\\': \\\\'error\\\\',\\\\n    \\\\'@typescript-eslint/no-unused-vars\\\\': \\\\'warn\\\\',\\\\n    \\\\'@typescript-eslint/no-explicit-any\\\\': \\\\'warn\\\\',\\\\n    \\\\'no-console\\\\': [\\\\'warn\\\\', { allow: [\\\\'info\\\\', \\\\'error\\\\'] }],\\\\n    \\\\'no-debugger\\\\': process.env.NODE_ENV === \\\\'production\\\\' ? \\\\'error\\\\' : \\\\'off\\\\',\\\\n    \\\\'react-hooks/rules-of-hooks\\\\': \\\\'error\\\\',\\\\n    \\\\'react-hooks/exhaustive-deps\\\\': \\\\'warn\\\\',\\\\n  },\\\\n  settings: {\\\\n    react: {\\\\n      version: \\\\'detect\\\\',\\\\n    },\\\\n  },\\\\n};\\\\n\",\"originAcceptText\":\"/**\\n * ESLint配置文件\\n * @description YYC³团队ESLint规则配置\\n * @author YYC³\\n */\\nmodule.exports = {\\n  root: true,\\n  env: {\\n    node: true,\\n    browser: true,\\n    es2021: true,\\n    jest: true,\\n  },\\n  extends: [\\n    'eslint:recommended',\\n    'next/core-web-vitals',\\n    'plugin:@typescript-eslint/recommended',\\n    'plugin:prettier/recommended',\\n  ],\\n  parser: '@typescript-eslint/parser',\\n  parserOptions: {\\n    ecmaFeatures: {\\n      jsx: true,\\n    },\\n    ecmaVersion: 'latest',\\n    sourceType: 'module',\\n  },\\n  plugins: ['@typescript-eslint', 'prettier'],\\n  rules: {\\n    'prettier/prettier': 'error',\\n    '@typescript-eslint/no-unused-vars': 'warn',\\n    '@typescript-eslint/no-explicit-any': 'warn',\\n    'no-console': ['warn', { allow: ['info', 'error'] }],\\n    'no-debugger': process.env.NODE_ENV === 'production' ? 'error' : 'off',\\n    'react-hooks/rules-of-hooks': 'error',\\n    'react-hooks/exhaustive-deps': 'warn',\\n  },\\n  settings: {\\n    react: {\\n      version: 'detect',\\n    },\\n  },\\n};\\n\",\"originTextLength\":982,\"aiScene\":\"Completion\",\"behaviorType\":\"accept\",\"updateTime\":1766162509968}]",
  "range-cache-file:///Users/my/Downloads/%E6%99%BA%E6%9E%A2%E6%9C%8D%E5%8A%A1%E5%B9%B3%E5%8F%B0/.gitignore": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":38,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":38,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"/**/node_modules\\\\n/.pnp\\\\n.pnp.js\\\\n\\\\n# Testing\\\\n/coverage\\\\n\\\\n# Production\\\\n/build\\\\n/dist\\\\n/.next/\\\\n/out/\\\\n\\\\n# Misc\\\\n.DS_Store\\\\n.env.local\\\\n.env.development.local\\\\n.env.test.local\\\\n.env.production.local\\\\n\\\\nnpm-debug.log*\\\\nyarn-debug.log*\\\\nyarn-error.log*\\\\n\\\\n# Editor directories and files\\\\n.idea\\\\n.vscode/*\\\\n!.vscode/extensions.json\\\\n*.suo\\\\n*.ntvs*\\\\n*.njsproj\\\\n*.sln\\\\n*.sw?\\\\n\\\\n# Docker\\\\n.dockerignore\\\\n\\\\n# Logs\\\\nlogs\\\\n*.log\\\\n\\\\n# Runtime data\\\\npids\\\\n*.pid\\\\n*.seed\\\\n*.pid.lock\\\\n\",\"originAcceptText\":\"/**/node_modules\\n/.pnp\\n.pnp.js\\n\\n# Testing\\n/coverage\\n\\n# Production\\n/build\\n/dist\\n/.next/\\n/out/\\n\\n# Misc\\n.DS_Store\\n.env.local\\n.env.development.local\\n.env.test.local\\n.env.production.local\\n\\nnpm-debug.log*\\nyarn-debug.log*\\nyarn-error.log*\\n\\n# Editor directories and files\\n.idea\\n.vscode/*\\n!.vscode/extensions.json\\n*.suo\\n*.ntvs*\\n*.njsproj\\n*.sln\\n*.sw?\\n\\n# Docker\\n.dockerignore\\n\\n# Logs\\nlogs\\n*.log\\n\\n# Runtime data\\npids\\n*.pid\\n*.seed\\n*.pid.lock\\n\",\"originTextLength\":428,\"aiScene\":\"Completion\",\"behaviorType\":\"accept\",\"updateTime\":1766162509971}]",
  "range-cache-file:///Users/my/Downloads/%E6%99%BA%E6%9E%A2%E6%9C%8D%E5%8A%A1%E5%B9%B3%E5%8F%B0/docker-compose.yml": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":88,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":88,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"version: \\\\'3.9\\\\'\\\\n\\\\nservices:\\\\n  # 主应用服务\\\\n  web:\\\\n    build:\\\\n      context: .\\\\n      dockerfile: Dockerfile.web\\\\n    ports:\\\\n      - \\\\\\\"3000:3000\\\\\\\"\\\\n    environment:\\\\n      - NODE_ENV=production\\\\n      - DATABASE_URL=postgresql://admin:password@postgres:5432/laundry_db\\\\n      - REDIS_URL=redis://redis:6379\\\\n      - KAFKA_BROKERS=kafka:9092\\\\n    depends_on:\\\\n      - postgres\\\\n      - redis\\\\n      - kafka\\\\n    restart: unless-stopped\\\\n\\\\n  # 洗衣订单服务\\\\n  laundry-orders-service:\\\\n    build:\\\\n      context: .\\\\n      dockerfile: services/laundry-orders-service/Dockerfile\\\\n    ports:\\\\n      - \\\\\\\"3100:3100\\\\\\\"\\\\n    environment:\\\\n      - NODE_ENV=production\\\\n      - DATABASE_URL=postgresql://admin:password@postgres:5432/laundry_db\\\\n      - REDIS_URL=redis://redis:6379\\\\n      - KAFKA_BROKERS=kafka:9092\\\\n    depends_on:\\\\n      - postgres\\\\n      - redis\\\\n      - kafka\\\\n    restart: unless-stopped\\\\n\\\\n  # PostgreSQL数据库\\\\n  postgres:\\\\n    image: postgres:16-alpine\\\\n    ports:\\\\n      - \\\\\\\"5432:5432\\\\\\\"\\\\n    environment:\\\\n      - POSTGRES_DB=laundry_db\\\\n      - POSTGRES_USER=admin\\\\n      - POSTGRES_PASSWORD=password\\\\n    volumes:\\\\n      - postgres_data:/var/lib/postgresql/data\\\\n    restart: unless-stopped\\\\n\\\\n  # Redis缓存\\\\n  redis:\\\\n    image: redis:7-alpine\\\\n    ports:\\\\n      - \\\\\\\"6379:6379\\\\\\\"\\\\n    volumes:\\\\n      - redis_data:/data\\\\n    restart: unless-stopped\\\\n\\\\n  # Kafka消息队列\\\\n  kafka:\\\\n    image: bitnami/kafka:3.7\\\\n    ports:\\\\n      - \\\\\\\"9092:9092\\\\\\\"\\\\n      - \\\\\\\"9093:9093\\\\\\\"\\\\n    environment:\\\\n      - KAFKA_CFG_NODE_ID=0\\\\n      - KAFKA_CFG_PROCESS_ROLES=controller,broker\\\\n      - KAFKA_CFG_LISTENERS=PLAINTEXT://:9092,CONTROLLER://:9093\\\\n      - KAFKA_CFG_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092\\\\n      - KAFKA_CFG_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT\\\\n      - KAFKA_CFG_CONTROLLER_QUORUM_VOTERS=0@kafka:9093\\\\n      - KAFKA_CFG_CONTROLLER_LISTENER_NAMES=CONTROLLER\\\\n    volumes:\\\\n      - kafka_data:/bitnami/kafka\\\\n    restart: unless-stopped\\\\n\\\\n  # Zookeeper (Kafka依赖)\\\\n  zookeeper:\\\\n    image: bitnami/zookeeper:3.9\\\\n    ports:\\\\n      - \\\\\\\"2181:2181\\\\\\\"\\\\n    environment:\\\\n      - ALLOW_ANONYMOUS_LOGIN=yes\\\\n    volumes:\\\\n      - zookeeper_data:/bitnami/zookeeper\\\\n    restart: unless-stopped\\\\n\\\\nvolumes:\\\\n  postgres_data:\\\\n  redis_data:\\\\n  kafka_data:\\\\n  zookeeper_data:\\\\n\",\"originAcceptText\":\"version: '3.9'\\n\\nservices:\\n  # 主应用服务\\n  web:\\n    build:\\n      context: .\\n      dockerfile: Dockerfile.web\\n    ports:\\n      - \\\"3000:3000\\\"\\n    environment:\\n      - NODE_ENV=production\\n      - DATABASE_URL=postgresql://admin:password@postgres:5432/laundry_db\\n      - REDIS_URL=redis://redis:6379\\n      - KAFKA_BROKERS=kafka:9092\\n    depends_on:\\n      - postgres\\n      - redis\\n      - kafka\\n    restart: unless-stopped\\n\\n  # 洗衣订单服务\\n  laundry-orders-service:\\n    build:\\n      context: .\\n      dockerfile: services/laundry-orders-service/Dockerfile\\n    ports:\\n      - \\\"3100:3100\\\"\\n    environment:\\n      - NODE_ENV=production\\n      - DATABASE_URL=postgresql://admin:password@postgres:5432/laundry_db\\n      - REDIS_URL=redis://redis:6379\\n      - KAFKA_BROKERS=kafka:9092\\n    depends_on:\\n      - postgres\\n      - redis\\n      - kafka\\n    restart: unless-stopped\\n\\n  # PostgreSQL数据库\\n  postgres:\\n    image: postgres:16-alpine\\n    ports:\\n      - \\\"5432:5432\\\"\\n    environment:\\n      - POSTGRES_DB=laundry_db\\n      - POSTGRES_USER=admin\\n      - POSTGRES_PASSWORD=password\\n    volumes:\\n      - postgres_data:/var/lib/postgresql/data\\n    restart: unless-stopped\\n\\n  # Redis缓存\\n  redis:\\n    image: redis:7-alpine\\n    ports:\\n      - \\\"6379:6379\\\"\\n    volumes:\\n      - redis_data:/data\\n    restart: unless-stopped\\n\\n  # Kafka消息队列\\n  kafka:\\n    image: bitnami/kafka:3.7\\n    ports:\\n      - \\\"9092:9092\\\"\\n      - \\\"9093:9093\\\"\\n    environment:\\n      - KAFKA_CFG_NODE_ID=0\\n      - KAFKA_CFG_PROCESS_ROLES=controller,broker\\n      - KAFKA_CFG_LISTENERS=PLAINTEXT://:9092,CONTROLLER://:9093\\n      - KAFKA_CFG_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092\\n      - KAFKA_CFG_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT\\n      - KAFKA_CFG_CONTROLLER_QUORUM_VOTERS=0@kafka:9093\\n      - KAFKA_CFG_CONTROLLER_LISTENER_NAMES=CONTROLLER\\n    volumes:\\n      - kafka_data:/bitnami/kafka\\n    restart: unless-stopped\\n\\n  # Zookeeper (Kafka依赖)\\n  zookeeper:\\n    image: bitnami/zookeeper:3.9\\n    ports:\\n      - \\\"2181:2181\\\"\\n    environment:\\n      - ALLOW_ANONYMOUS_LOGIN=yes\\n    volumes:\\n      - zookeeper_data:/bitnami/zookeeper\\n    restart: unless-stopped\\n\\nvolumes:\\n  postgres_data:\\n  redis_data:\\n  kafka_data:\\n  zookeeper_data:\\n\",\"originTextLength\":2196,\"aiScene\":\"Completion\",\"behaviorType\":\"accept\",\"updateTime\":1766162509975}]",
  "range-cache-file:///Users/my/Downloads/%E6%99%BA%E6%9E%A2%E6%9C%8D%E5%8A%A1%E5%B9%B3%E5%8F%B0/Dockerfile.web": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":29,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":29,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# 基于Node.js官方镜像构建\\\\nFROM node:20-alpine AS base\\\\n\\\\n# 设置工作目录\\\\nWORKDIR /app\\\\n\\\\n# 复制package.json和package-lock.json\\\\nCOPY package*.json ./\\\\n\\\\n# 安装依赖\\\\nRUN npm ci\\\\n\\\\n# 复制项目文件\\\\nCOPY . .\\\\n\\\\n# 构建应用\\\\nRUN npm run build\\\\n\\\\n# 创建运行时镜像\\\\nFROM node:20-alpine\\\\n\\\\nWORKDIR /app\\\\n\\\\n# 复制构建结果和必要文件\\\\nCOPY --from=base /app/package*.json ./\\\\nCOPY --from=base /app/.next ./.next\\\\nCOPY --from=base /app/public ./public\\\\nCOPY --from=base /app/env.js ./\\\\nCOPY --from=base /app/lib ./lib\\\\n\\\\n# 安装生产依赖\\\\nRUN npm ci --only=production\\\\n\\\\n# 暴露端口\\\\nEXPOSE 3000\\\\n\\\\n# 设置环境变量\\\\nENV NODE_ENV=production\\\\n\\\\n# 启动服务\\\\nCMD [\\\\\\\"npm\\\\\\\", \\\\\\\"run\\\\\\\", \\\\\\\"start\\\\\\\"]\\\\n\",\"originAcceptText\":\"# 基于Node.js官方镜像构建\\nFROM node:20-alpine AS base\\n\\n# 设置工作目录\\nWORKDIR /app\\n\\n# 复制package.json和package-lock.json\\nCOPY package*.json ./\\n\\n# 安装依赖\\nRUN npm ci\\n\\n# 复制项目文件\\nCOPY . .\\n\\n# 构建应用\\nRUN npm run build\\n\\n# 创建运行时镜像\\nFROM node:20-alpine\\n\\nWORKDIR /app\\n\\n# 复制构建结果和必要文件\\nCOPY --from=base /app/package*.json ./\\nCOPY --from=base /app/.next ./.next\\nCOPY --from=base /app/public ./public\\nCOPY --from=base /app/env.js ./\\nCOPY --from=base /app/lib ./lib\\n\\n# 安装生产依赖\\nRUN npm ci --only=production\\n\\n# 暴露端口\\nEXPOSE 3000\\n\\n# 设置环境变量\\nENV NODE_ENV=production\\n\\n# 启动服务\\nCMD [\\\"npm\\\", \\\"run\\\", \\\"start\\\"]\\n\",\"originTextLength\":557,\"aiScene\":\"Completion\",\"behaviorType\":\"accept\",\"updateTime\":1766162509979}]",
  "range-cache-file:///Users/my/Downloads/%E6%99%BA%E6%9E%A2%E6%9C%8D%E5%8A%A1%E5%B9%B3%E5%8F%B0/docs/API-DOCS.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":225,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":225,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# YYC³洗衣服务平台 - API文档\\\\n\\\\n> **YYC³（YanYu Cloud Cube）**\\\\n> **标语**：万象归元于云枢 | 深栈智启新纪元\\\\n> ***英文***：*All Realms Converge at Cloud Nexus, DeepStack Ignites a New Era*\\\\n\\\\n---\\\\n\\\\n**创建日期**：2024-12-06\\\\n**作者**：YYC³团队\\\\n**版本**：1.0.0\\\\n**更新日期**：2024-12-06\\\\n\\\\n## 1. 认证与授权\\\\n\\\\n### 1.1 认证方式\\\\n- **Bearer Token**：使用JWT令牌进行认证\\\\n- **API密钥**：用于服务器间通信\\\\n\\\\n### 1.2 认证流程\\\\n```http\\\\nPOST /api/auth/login\\\\nContent-Type: application/json\\\\n\\\\n{\\\\n  \\\\\\\"email\\\\\\\": \\\\\\\"user@example.com\\\\\\\",\\\\n  \\\\\\\"password\\\\\\\": \\\\\\\"password123\\\\\\\"\\\\n}\\\\n```\\\\n\\\\n### 1.3 授权头示例\\\\n```http\\\\nAuthorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\\\\n```\\\\n\\\\n## 2. 洗衣服务 API\\\\n\\\\n### 2.1 订单服务 API\\\\n\\\\n#### 2.1.1 获取洗衣订单列表\\\\n\\\\n```http\\\\nGET /api/laundry/orders\\\\nAuthorization: Bearer <token>\\\\n```\\\\n\\\\n**查询参数**：\\\\n- `status`: 订单状态过滤（可选）\\\\n- `customerId`: 客户ID过滤（可选）\\\\n\\\\n**响应示例**：\\\\n```json\\\\n[\\\\n  {\\\\n    \\\\\\\"id\\\\\\\": \\\\\\\"order-123\\\\\\\",\\\\n    \\\\\\\"customerId\\\\\\\": \\\\\\\"cust-456\\\\\\\",\\\\n    \\\\\\\"orderNumber\\\\\\\": \\\\\\\"LAUNDRY-20240101-001\\\\\\\",\\\\n    \\\\\\\"items\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"id\\\\\\\": \\\\\\\"item-1\\\\\\\",\\\\n        \\\\\\\"type\\\\\\\": \\\\\\\"衬衫\\\\\\\",\\\\n        \\\\\\\"quantity\\\\\\\": 2,\\\\n        \\\\\\\"price\\\\\\\": 50.00,\\\\n        \\\\\\\"status\\\\\\\": \\\\\\\"received\\\\\\\"\\\\n      }\\\\n    ],\\\\n    \\\\\\\"totalPrice\\\\\\\": 100.00,\\\\n    \\\\\\\"status\\\\\\\": \\\\\\\"pending\\\\\\\",\\\\n    \\\\\\\"pickupTime\\\\\\\": \\\\\\\"2024-01-02T10:00:00Z\\\\\\\",\\\\n    \\\\\\\"deliveryTime\\\\\\\": \\\\\\\"2024-01-03T16:00:00Z\\\\\\\",\\\\n    \\\\\\\"specialInstructions\\\\\\\": \\\\\\\"请使用温和洗涤剂\\\\\\\",\\\\n    \\\\\\\"createdAt\\\\\\\": \\\\\\\"2024-01-01T10:00:00Z\\\\\\\",\\\\n    \\\\\\\"updatedAt\\\\\\\": \\\\\\\"2024-01-01T10:00:00Z\\\\\\\"\\\\n  }\\\\n]\\\\n```\\\\n\\\\n#### 2.1.2 创建洗衣订单\\\\n\\\\n```http\\\\nPOST /api/laundry/orders\\\\nAuthorization: Bearer <token>\\\\nContent-Type: application/json\\\\n\\\\n{\\\\n  \\\\\\\"customerId\\\\\\\": \\\\\\\"cust-456\\\\\\\",\\\\n  \\\\\\\"items\\\\\\\": [\\\\n    {\\\\n      \\\\\\\"type\\\\\\\": \\\\\\\"衬衫\\\\\\\",\\\\n      \\\\\\\"quantity\\\\\\\": 2,\\\\n      \\\\\\\"price\\\\\\\": 50.00\\\\n    }\\\\n  ],\\\\n  \\\\\\\"pickupTime\\\\\\\": \\\\\\\"2024-01-02T10:00:00Z\\\\\\\",\\\\n  \\\\\\\"deliveryTime\\\\\\\": \\\\\\\"2024-01-03T16:00:00Z\\\\\\\",\\\\n  \\\\\\\"specialInstructions\\\\\\\": \\\\\\\"请使用温和洗涤剂\\\\\\\"\\\\n}\\\\n```\\\\n\\\\n**响应示例**：\\\\n```json\\\\n{\\\\n  \\\\\\\"id\\\\\\\": \\\\\\\"order-123\\\\\\\",\\\\n  \\\\\\\"customerId\\\\\\\": \\\\\\\"cust-456\\\\\\\",\\\\n  \\\\\\\"orderNumber\\\\\\\": \\\\\\\"LAUNDRY-20240101-001\\\\\\\",\\\\n  \\\\\\\"items\\\\\\\": [\\\\n    {\\\\n      \\\\\\\"id\\\\\\\": \\\\\\\"item-1\\\\\\\",\\\\n      \\\\\\\"type\\\\\\\": \\\\\\\"衬衫\\\\\\\",\\\\n      \\\\\\\"quantity\\\\\\\": 2,\\\\n      \\\\\\\"price\\\\\\\": 50.00,\\\\n      \\\\\\\"status\\\\\\\": \\\\\\\"received\\\\\\\"\\\\n    }\\\\n  ],\\\\n  \\\\\\\"totalPrice\\\\\\\": 100.00,\\\\n  \\\\\\\"status\\\\\\\": \\\\\\\"pending\\\\\\\",\\\\n  \\\\\\\"pickupTime\\\\\\\": \\\\\\\"2024-01-02T10:00:00Z\\\\\\\",\\\\n  \\\\\\\"deliveryTime\\\\\\\": \\\\\\\"2024-01-03T16:00:00Z\\\\\\\",\\\\n  \\\\\\\"specialInstructions\\\\\\\": \\\\\\\"请使用温和洗涤剂\\\\\\\",\\\\n  \\\\\\\"createdAt\\\\\\\": \\\\\\\"2024-01-01T10:00:00Z\\\\\\\",\\\\n  \\\\\\\"updatedAt\\\\\\\": \\\\\\\"2024-01-01T10:00:00Z\\\\\\\"\\\\n}\\\\n```\\\\n\\\\n### 2.2 洗衣设备 API\\\\n\\\\n#### 2.2.1 获取洗衣设备列表\\\\n\\\\n```http\\\\nGET /api/laundry/machines\\\\nAuthorization: Bearer <token>\\\\n```\\\\n\\\\n**响应示例**：\\\\n```json\\\\n[\\\\n  {\\\\n    \\\\\\\"id\\\\\\\": \\\\\\\"machine-123\\\\\\\",\\\\n    \\\\\\\"type\\\\\\\": \\\\\\\"washing-machine\\\\\\\",\\\\n    \\\\\\\"model\\\\\\\": \\\\\\\"WM-5000\\\\\\\",\\\\n    \\\\\\\"status\\\\\\\": \\\\\\\"available\\\\\\\",\\\\n    \\\\\\\"capacity\\\\\\\": 10,\\\\n    \\\\\\\"location\\\\\\\": \\\\\\\"A区\\\\\\\",\\\\n    \\\\\\\"lastMaintenance\\\\\\\": \\\\\\\"2024-01-01T10:00:00Z\\\\\\\",\\\\n    \\\\\\\"createdAt\\\\\\\": \\\\\\\"2024-01-01T10:00:00Z\\\\\\\",\\\\n    \\\\\\\"updatedAt\\\\\\\": \\\\\\\"2024-01-01T10:00:00Z\\\\\\\"\\\\n  }\\\\n]\\\\n```\\\\n\\\\n### 2.3 质量检查 API\\\\n\\\\n#### 2.3.1 获取质量检查记录\\\\n\\\\n```http\\\\nGET /api/laundry/quality\\\\nAuthorization: Bearer <token>\\\\n```\\\\n\\\\n**响应示例**：\\\\n```json\\\\n[\\\\n  {\\\\n    \\\\\\\"id\\\\\\\": \\\\\\\"quality-123\\\\\\\",\\\\n    \\\\\\\"orderId\\\\\\\": \\\\\\\"order-123\\\\\\\",\\\\n    \\\\\\\"inspectorId\\\\\\\": \\\\\\\"staff-456\\\\\\\",\\\\n    \\\\\\\"inspectionDate\\\\\\\": \\\\\\\"2024-01-03T10:00:00Z\\\\\\\",\\\\n    \\\\\\\"results\\\\\\\": [\\\\n      {\\\\n        \\\\\\\"itemId\\\\\\\": \\\\\\\"item-1\\\\\\\",\\\\n        \\\\\\\"qualityLevel\\\\\\\": \\\\\\\"excellent\\\\\\\",\\\\n        \\\\\\\"notes\\\\\\\": \\\\\\\"清洗干净，无异味\\\\\\\"\\\\n      }\\\\n    ],\\\\n    \\\\\\\"overallStatus\\\\\\\": \\\\\\\"passed\\\\\\\",\\\\n    \\\\\\\"createdAt\\\\\\\": \\\\\\\"2024-01-03T10:00:00Z\\\\\\\",\\\\n    \\\\\\\"updatedAt\\\\\\\": \\\\\\\"2024-01-03T10:00:00Z\\\\\\\"\\\\n  }\\\\n]\\\\n```\\\\n\\\\n### 2.4 员工管理 API\\\\n\\\\n#### 2.4.1 获取员工列表\\\\n\\\\n```http\\\\nGET /api/laundry/staff\\\\nAuthorization: Bearer <token>\\\\n```\\\\n\\\\n**响应示例**：\\\\n```json\\\\n[\\\\n  {\\\\n    \\\\\\\"id\\\\\\\": \\\\\\\"staff-123\\\\\\\",\\\\n    \\\\\\\"name\\\\\\\": \\\\\\\"张三\\\\\\\",\\\\n    \\\\\\\"position\\\\\\\": \\\\\\\"洗衣工\\\\\\\",\\\\n    \\\\\\\"department\\\\\\\": \\\\\\\"洗衣部\\\\\\\",\\\\n    \\\\\\\"status\\\\\\\": \\\\\\\"active\\\\\\\",\\\\n    \\\\\\\"hireDate\\\\\\\": \\\\\\\"2024-01-01T10:00:00Z\\\\\\\",\\\\n    \\\\\\\"createdAt\\\\\\\": \\\\\\\"2024-01-01T10:00:00Z\\\\\\\",\\\\n    \\\\\\\"updatedAt\\\\\\\": \\\\\\\"2024-01-01T10:00:00Z\\\\\\\"\\\\n  }\\\\n]\\\\n```\\\\n\\\\n### 2.5 健康检查 API\\\\n\\\\n#### 2.5.1 检查系统状态\\\\n\\\\n```http\\\\nGET /api/health\\\\n```\\\\n\\\\n**响应示例**：\\\\n```json\\\\n{\\\\n  \\\\\\\"status\\\\\\\": \\\\\\\"ok\\\\\\\",\\\\n  \\\\\\\"timestamp\\\\\\\": \\\\\\\"2024-01-01T10:00:00Z\\\\\\\",\\\\n  \\\\\\\"services\\\\\\\": {\\\\n    \\\\\\\"api\\\\\\\": \\\\\\\"running\\\\\\\",\\\\n    \\\\\\\"database\\\\\\\": \\\\\\\"connected\\\\\\\",\\\\n    \\\\\\\"cache\\\\\\\": \\\\\\\"available\\\\\\\"\\\\n  }\\\\n}\\\\n```\\\\n\\\\n## 3. 错误码说明\\\\n\\\\n| 错误码 | 描述 | HTTP状态码 |\\\\n|--------|------|------------|\\\\n| 40001 | 参数错误 | 400 |\\\\n| 40101 | 未授权 | 401 |\\\\n| 40301 | 禁止访问 | 403 |\\\\n| 40401 | 资源不存在 | 404 |\\\\n| 50001 | 服务器内部错误 | 500 |\\\\n| 50002 | 数据库错误 | 500 |\\\\n| 50003 | 第三方服务错误 | 500 |\\\\n\\\\n## 4. 限流策略\\\\n\\\\n- API请求默认限制为100次/分钟/IP\\\\n- 认证请求限制为10次/分钟/IP\\\\n- 可通过API密钥提升限制\\\\n\\\\n## 5. 数据格式\\\\n\\\\n### 5.1 时间格式\\\\n- 使用ISO 8601格式：`YYYY-MM-DDTHH:mm:ssZ`\\\\n- 例如：`2024-01-01T10:00:00Z`\\\\n\\\\n### 5.2 货币格式\\\\n- 使用数字类型，保留两位小数\\\\n- 例如：`100.00`\\\\n\\\\n## 6. API版本控制\\\\n\\\\n### 6.1 当前版本\\\\n- API v1\\\\n\\\\n### 6.2 版本管理\\\\n- 通过URL路径进行版本控制：`/api/v1/orders`\\\\n- 主版本变更将更新URL路径\\\\n- 次要版本和补丁版本通过请求头`Accept-Version`控制\\\\n\\\\n---\\\\n\\\\n## 📞 支持与反馈\\\\n\\\\n- **技术支持**：<admin@0379.email>\\\\n- **规范文档**：[YYC³团队标准化规范文档.md](./YYC³团队标准化规范文档.md)\\\\n- **问题反馈**：GitHub Issues\\\\n\",\"originAcceptText\":\"# YYC³洗衣服务平台 - API文档\\n\\n> **YYC³（YanYu Cloud Cube）**\\n> **标语**：万象归元于云枢 | 深栈智启新纪元\\n> ***英文***：*All Realms Converge at Cloud Nexus, DeepStack Ignites a New Era*\\n\\n---\\n\\n**创建日期**：2024-12-06\\n**作者**：YYC³团队\\n**版本**：1.0.0\\n**更新日期**：2024-12-06\\n\\n## 1. 认证与授权\\n\\n### 1.1 认证方式\\n- **Bearer Token**：使用JWT令牌进行认证\\n- **API密钥**：用于服务器间通信\\n\\n### 1.2 认证流程\\n```http\\nPOST /api/auth/login\\nContent-Type: application/json\\n\\n{\\n  \\\"email\\\": \\\"user@example.com\\\",\\n  \\\"password\\\": \\\"password123\\\"\\n}\\n```\\n\\n### 1.3 授权头示例\\n```http\\nAuthorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\\n```\\n\\n## 2. 洗衣服务 API\\n\\n### 2.1 订单服务 API\\n\\n#### 2.1.1 获取洗衣订单列表\\n\\n```http\\nGET /api/laundry/orders\\nAuthorization: Bearer <token>\\n```\\n\\n**查询参数**：\\n- `status`: 订单状态过滤（可选）\\n- `customerId`: 客户ID过滤（可选）\\n\\n**响应示例**：\\n```json\\n[\\n  {\\n    \\\"id\\\": \\\"order-123\\\",\\n    \\\"customerId\\\": \\\"cust-456\\\",\\n    \\\"orderNumber\\\": \\\"LAUNDRY-20240101-001\\\",\\n    \\\"items\\\": [\\n      {\\n        \\\"id\\\": \\\"item-1\\\",\\n        \\\"type\\\": \\\"衬衫\\\",\\n        \\\"quantity\\\": 2,\\n        \\\"price\\\": 50.00,\\n        \\\"status\\\": \\\"received\\\"\\n      }\\n    ],\\n    \\\"totalPrice\\\": 100.00,\\n    \\\"status\\\": \\\"pending\\\",\\n    \\\"pickupTime\\\": \\\"2024-01-02T10:00:00Z\\\",\\n    \\\"deliveryTime\\\": \\\"2024-01-03T16:00:00Z\\\",\\n    \\\"specialInstructions\\\": \\\"请使用温和洗涤剂\\\",\\n    \\\"createdAt\\\": \\\"2024-01-01T10:00:00Z\\\",\\n    \\\"updatedAt\\\": \\\"2024-01-01T10:00:00Z\\\"\\n  }\\n]\\n```\\n\\n#### 2.1.2 创建洗衣订单\\n\\n```http\\nPOST /api/laundry/orders\\nAuthorization: Bearer <token>\\nContent-Type: application/json\\n\\n{\\n  \\\"customerId\\\": \\\"cust-456\\\",\\n  \\\"items\\\": [\\n    {\\n      \\\"type\\\": \\\"衬衫\\\",\\n      \\\"quantity\\\": 2,\\n      \\\"price\\\": 50.00\\n    }\\n  ],\\n  \\\"pickupTime\\\": \\\"2024-01-02T10:00:00Z\\\",\\n  \\\"deliveryTime\\\": \\\"2024-01-03T16:00:00Z\\\",\\n  \\\"specialInstructions\\\": \\\"请使用温和洗涤剂\\\"\\n}\\n```\\n\\n**响应示例**：\\n```json\\n{\\n  \\\"id\\\": \\\"order-123\\\",\\n  \\\"customerId\\\": \\\"cust-456\\\",\\n  \\\"orderNumber\\\": \\\"LAUNDRY-20240101-001\\\",\\n  \\\"items\\\": [\\n    {\\n      \\\"id\\\": \\\"item-1\\\",\\n      \\\"type\\\": \\\"衬衫\\\",\\n      \\\"quantity\\\": 2,\\n      \\\"price\\\": 50.00,\\n      \\\"status\\\": \\\"received\\\"\\n    }\\n  ],\\n  \\\"totalPrice\\\": 100.00,\\n  \\\"status\\\": \\\"pending\\\",\\n  \\\"pickupTime\\\": \\\"2024-01-02T10:00:00Z\\\",\\n  \\\"deliveryTime\\\": \\\"2024-01-03T16:00:00Z\\\",\\n  \\\"specialInstructions\\\": \\\"请使用温和洗涤剂\\\",\\n  \\\"createdAt\\\": \\\"2024-01-01T10:00:00Z\\\",\\n  \\\"updatedAt\\\": \\\"2024-01-01T10:00:00Z\\\"\\n}\\n```\\n\\n### 2.2 洗衣设备 API\\n\\n#### 2.2.1 获取洗衣设备列表\\n\\n```http\\nGET /api/laundry/machines\\nAuthorization: Bearer <token>\\n```\\n\\n**响应示例**：\\n```json\\n[\\n  {\\n    \\\"id\\\": \\\"machine-123\\\",\\n    \\\"type\\\": \\\"washing-machine\\\",\\n    \\\"model\\\": \\\"WM-5000\\\",\\n    \\\"status\\\": \\\"available\\\",\\n    \\\"capacity\\\": 10,\\n    \\\"location\\\": \\\"A区\\\",\\n    \\\"lastMaintenance\\\": \\\"2024-01-01T10:00:00Z\\\",\\n    \\\"createdAt\\\": \\\"2024-01-01T10:00:00Z\\\",\\n    \\\"updatedAt\\\": \\\"2024-01-01T10:00:00Z\\\"\\n  }\\n]\\n```\\n\\n### 2.3 质量检查 API\\n\\n#### 2.3.1 获取质量检查记录\\n\\n```http\\nGET /api/laundry/quality\\nAuthorization: Bearer <token>\\n```\\n\\n**响应示例**：\\n```json\\n[\\n  {\\n    \\\"id\\\": \\\"quality-123\\\",\\n    \\\"orderId\\\": \\\"order-123\\\",\\n    \\\"inspectorId\\\": \\\"staff-456\\\",\\n    \\\"inspectionDate\\\": \\\"2024-01-03T10:00:00Z\\\",\\n    \\\"results\\\": [\\n      {\\n        \\\"itemId\\\": \\\"item-1\\\",\\n        \\\"qualityLevel\\\": \\\"excellent\\\",\\n        \\\"notes\\\": \\\"清洗干净，无异味\\\"\\n      }\\n    ],\\n    \\\"overallStatus\\\": \\\"passed\\\",\\n    \\\"createdAt\\\": \\\"2024-01-03T10:00:00Z\\\",\\n    \\\"updatedAt\\\": \\\"2024-01-03T10:00:00Z\\\"\\n  }\\n]\\n```\\n\\n### 2.4 员工管理 API\\n\\n#### 2.4.1 获取员工列表\\n\\n```http\\nGET /api/laundry/staff\\nAuthorization: Bearer <token>\\n```\\n\\n**响应示例**：\\n```json\\n[\\n  {\\n    \\\"id\\\": \\\"staff-123\\\",\\n    \\\"name\\\": \\\"张三\\\",\\n    \\\"position\\\": \\\"洗衣工\\\",\\n    \\\"department\\\": \\\"洗衣部\\\",\\n    \\\"status\\\": \\\"active\\\",\\n    \\\"hireDate\\\": \\\"2024-01-01T10:00:00Z\\\",\\n    \\\"createdAt\\\": \\\"2024-01-01T10:00:00Z\\\",\\n    \\\"updatedAt\\\": \\\"2024-01-01T10:00:00Z\\\"\\n  }\\n]\\n```\\n\\n### 2.5 健康检查 API\\n\\n#### 2.5.1 检查系统状态\\n\\n```http\\nGET /api/health\\n```\\n\\n**响应示例**：\\n```json\\n{\\n  \\\"status\\\": \\\"ok\\\",\\n  \\\"timestamp\\\": \\\"2024-01-01T10:00:00Z\\\",\\n  \\\"services\\\": {\\n    \\\"api\\\": \\\"running\\\",\\n    \\\"database\\\": \\\"connected\\\",\\n    \\\"cache\\\": \\\"available\\\"\\n  }\\n}\\n```\\n\\n## 3. 错误码说明\\n\\n| 错误码 | 描述 | HTTP状态码 |\\n|--------|------|------------|\\n| 40001 | 参数错误 | 400 |\\n| 40101 | 未授权 | 401 |\\n| 40301 | 禁止访问 | 403 |\\n| 40401 | 资源不存在 | 404 |\\n| 50001 | 服务器内部错误 | 500 |\\n| 50002 | 数据库错误 | 500 |\\n| 50003 | 第三方服务错误 | 500 |\\n\\n## 4. 限流策略\\n\\n- API请求默认限制为100次/分钟/IP\\n- 认证请求限制为10次/分钟/IP\\n- 可通过API密钥提升限制\\n\\n## 5. 数据格式\\n\\n### 5.1 时间格式\\n- 使用ISO 8601格式：`YYYY-MM-DDTHH:mm:ssZ`\\n- 例如：`2024-01-01T10:00:00Z`\\n\\n### 5.2 货币格式\\n- 使用数字类型，保留两位小数\\n- 例如：`100.00`\\n\\n## 6. API版本控制\\n\\n### 6.1 当前版本\\n- API v1\\n\\n### 6.2 版本管理\\n- 通过URL路径进行版本控制：`/api/v1/orders`\\n- 主版本变更将更新URL路径\\n- 次要版本和补丁版本通过请求头`Accept-Version`控制\\n\\n---\\n\\n## 📞 支持与反馈\\n\\n- **技术支持**：<admin@0379.email>\\n- **规范文档**：[YYC³团队标准化规范文档.md](./YYC³团队标准化规范文档.md)\\n- **问题反馈**：GitHub Issues\\n\",\"originTextLength\":4390,\"aiScene\":\"Completion\",\"behaviorType\":\"accept\",\"updateTime\":1766162509982}]",
  "range-cache-file:///Users/my/Downloads/%E6%99%BA%E6%9E%A2%E6%9C%8D%E5%8A%A1%E5%B9%B3%E5%8F%B0/eslint.config.js": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":17,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":17,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"import globals from \\\\\\\"globals\\\\\\\";\\\\nimport pluginJs from \\\\\\\"@eslint/js\\\\\\\";\\\\nimport tseslint from \\\\\\\"typescript-eslint\\\\\\\";\\\\n\\\\nexport default [\\\\n  { files: [\\\\\\\"**/*.{js,mjs,cjs,ts}\\\\\\\"] },\\\\n  { languageOptions: { globals: globals.browser } },\\\\n  pluginJs.configs.recommended,\\\\n  ...tseslint.configs.recommended,\\\\n  {\\\\n    rules: {\\\\n      \\\\\\\"no-unused-vars\\\\\\\": \\\\\\\"warn\\\\\\\",\\\\n      \\\\\\\"no-console\\\\\\\": \\\\\\\"off\\\\\\\",\\\\n      \\\\\\\"@typescript-eslint/no-explicit-any\\\\\\\": \\\\\\\"warn\\\\\\\",\\\\n      \\\\\\\"@typescript-eslint/no-unused-vars\\\\\\\": \\\\\\\"warn\\\\\\\"\\\\n    }\\\\n  }\\\\n];\\\\n\",\"originAcceptText\":\"import globals from \\\"globals\\\";\\nimport pluginJs from \\\"@eslint/js\\\";\\nimport tseslint from \\\"typescript-eslint\\\";\\n\\nexport default [\\n  { files: [\\\"**/*.{js,mjs,cjs,ts}\\\"] },\\n  { languageOptions: { globals: globals.browser } },\\n  pluginJs.configs.recommended,\\n  ...tseslint.configs.recommended,\\n  {\\n    rules: {\\n      \\\"no-unused-vars\\\": \\\"warn\\\",\\n      \\\"no-console\\\": \\\"off\\\",\\n      \\\"@typescript-eslint/no-explicit-any\\\": \\\"warn\\\",\\n      \\\"@typescript-eslint/no-unused-vars\\\": \\\"warn\\\"\\n    }\\n  }\\n];\\n\",\"originTextLength\":476,\"aiScene\":\"Completion\",\"behaviorType\":\"accept\",\"updateTime\":1766162509986}]",
  "range-cache-file:///Users/my/Downloads/%E6%99%BA%E6%9E%A2%E6%9C%8D%E5%8A%A1%E5%B9%B3%E5%8F%B0/lib/auth/auth.middleware.ts": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":106,\"character\":1}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":106,\"character\":1}},\"action\":\"None\",\"isLine\":false,\"originText\":\"/**\\\\n * @file 认证中间件\\\\n * @description 提供API路由的认证和授权功能\\\\n * @module auth\\\\n * @author YYC\\\\n * @version 1.0.0\\\\n * @created 2024-12-06\\\\n * @updated 2024-12-06\\\\n */\\\\n\\\\nimport { FastifyReply, FastifyRequest } from \\\\'fastify\\\\';\\\\nimport { jwtService, UserRole } from \\\\'./jwt.service\\\\';\\\\n\\\\nexport interface AuthMiddlewareOptions {\\\\n  requiredRoles?: UserRole[];\\\\n  optional?: boolean; // 是否可选认证（如果未提供令牌，请求仍会继续）\\\\n}\\\\n\\\\nexport class AuthMiddleware {\\\\n  /**\\\\n   * 认证中间件函数\\\\n   * @param options 中间件选项\\\\n   */\\\\n  static authenticate(options: AuthMiddlewareOptions = {}) {\\\\n    return async (request: FastifyRequest, reply: FastifyReply) => {\\\\n      try {\\\\n        // 获取Authorization头\\\\n        const authHeader = request.headers.authorization;\\\\n        \\\\n        // 如果认证是可选的且没有提供令牌，则继续处理请求\\\\n        if (options.optional && !authHeader) {\\\\n          return;\\\\n        }\\\\n\\\\n        // 验证Authorization头格式\\\\n        if (!authHeader) {\\\\n          return reply.status(401).send({\\\\n            error: \\\\'Unauthorized\\\\',\\\\n            message: \\\\'缺少Authorization头\\\\'\\\\n          });\\\\n        }\\\\n\\\\n        const [bearer, token] = authHeader.split(\\\\' \\\\');\\\\n        if (bearer !== \\\\'Bearer\\\\' || !token) {\\\\n          return reply.status(401).send({\\\\n            error: \\\\'Unauthorized\\\\',\\\\n            message: \\\\'无效的Authorization头格式\\\\'\\\\n          });\\\\n        }\\\\n\\\\n        // 验证令牌\\\\n        const verifyResult = jwtService.verifyToken(token);\\\\n        if (!verifyResult.success) {\\\\n          return reply.status(401).send({\\\\n            error: \\\\'Unauthorized\\\\',\\\\n            message: verifyResult.error || \\\\'无效的令牌\\\\'\\\\n          });\\\\n        }\\\\n\\\\n        // 验证角色权限（如果需要）\\\\n        if (options.requiredRoles && options.requiredRoles.length > 0) {\\\\n          const hasRole = jwtService.verifyRole(token, options.requiredRoles);\\\\n          if (!hasRole) {\\\\n            return reply.status(403).send({\\\\n              error: \\\\'Forbidden\\\\',\\\\n              message: \\\\'没有足够的权限访问该资源\\\\'\\\\n            });\\\\n          }\\\\n        }\\\\n\\\\n        // 将用户信息添加到请求对象中\\\\n        request.user = verifyResult.payload;\\\\n        request.authToken = token;\\\\n\\\\n        return;\\\\n      } catch (error) {\\\\n        console.error(\\\\'❌ 认证中间件错误:\\\\', error);\\\\n        return reply.status(500).send({\\\\n          error: \\\\'Internal Server Error\\\\',\\\\n          message: \\\\'认证过程中发生错误\\\\'\\\\n        });\\\\n      }\\\\n    };\\\\n  }\\\\n\\\\n  /**\\\\n   * 管理员认证中间件\\\\n   */\\\\n  static authenticateAdmin() {\\\\n    return this.authenticate({ requiredRoles: [UserRole.ADMIN] });\\\\n  }\\\\n\\\\n  /**\\\\n   * 客户认证中间件\\\\n   */\\\\n  static authenticateCustomer() {\\\\n    return this.authenticate({ requiredRoles: [UserRole.CUSTOMER] });\\\\n  }\\\\n\\\\n  /**\\\\n   * 员工认证中间件\\\\n   */\\\\n  static authenticateEmployee() {\\\\n    return this.authenticate({ requiredRoles: [UserRole.EMPLOYEE] });\\\\n  }\\\\n\\\\n  /**\\\\n   * 认证或访客中间件（可选认证）\\\\n   */\\\\n  static authenticateOrGuest() {\\\\n    return this.authenticate({ optional: true });\\\\n  }\\\\n}\\\\n\\\\n// 扩展FastifyRequest类型\\\\ndeclare module \\\\'fastify\\\\' {\\\\n  interface FastifyRequest {\\\\n    user?: import(\\\\'./jwt.service\\\\').JwtPayload;\\\\n    authToken?: string;\\\\n  }\\\\n}\",\"originAcceptText\":\"/**\\n * @file 认证中间件\\n * @description 提供API路由的认证和授权功能\\n * @module auth\\n * @author YYC\\n * @version 1.0.0\\n * @created 2024-12-06\\n * @updated 2024-12-06\\n */\\n\\nimport { FastifyReply, FastifyRequest } from 'fastify';\\nimport { jwtService, UserRole } from './jwt.service';\\n\\nexport interface AuthMiddlewareOptions {\\n  requiredRoles?: UserRole[];\\n  optional?: boolean; // 是否可选认证（如果未提供令牌，请求仍会继续）\\n}\\n\\nexport class AuthMiddleware {\\n  /**\\n   * 认证中间件函数\\n   * @param options 中间件选项\\n   */\\n  static authenticate(options: AuthMiddlewareOptions = {}) {\\n    return async (request: FastifyRequest, reply: FastifyReply) => {\\n      try {\\n        // 获取Authorization头\\n        const authHeader = request.headers.authorization;\\n        \\n        // 如果认证是可选的且没有提供令牌，则继续处理请求\\n        if (options.optional && !authHeader) {\\n          return;\\n        }\\n\\n        // 验证Authorization头格式\\n        if (!authHeader) {\\n          return reply.status(401).send({\\n            error: 'Unauthorized',\\n            message: '缺少Authorization头'\\n          });\\n        }\\n\\n        const [bearer, token] = authHeader.split(' ');\\n        if (bearer !== 'Bearer' || !token) {\\n          return reply.status(401).send({\\n            error: 'Unauthorized',\\n            message: '无效的Authorization头格式'\\n          });\\n        }\\n\\n        // 验证令牌\\n        const verifyResult = jwtService.verifyToken(token);\\n        if (!verifyResult.success) {\\n          return reply.status(401).send({\\n            error: 'Unauthorized',\\n            message: verifyResult.error || '无效的令牌'\\n          });\\n        }\\n\\n        // 验证角色权限（如果需要）\\n        if (options.requiredRoles && options.requiredRoles.length > 0) {\\n          const hasRole = jwtService.verifyRole(token, options.requiredRoles);\\n          if (!hasRole) {\\n            return reply.status(403).send({\\n              error: 'Forbidden',\\n              message: '没有足够的权限访问该资源'\\n            });\\n          }\\n        }\\n\\n        // 将用户信息添加到请求对象中\\n        request.user = verifyResult.payload;\\n        request.authToken = token;\\n\\n        return;\\n      } catch (error) {\\n        console.error('❌ 认证中间件错误:', error);\\n        return reply.status(500).send({\\n          error: 'Internal Server Error',\\n          message: '认证过程中发生错误'\\n        });\\n      }\\n    };\\n  }\\n\\n  /**\\n   * 管理员认证中间件\\n   */\\n  static authenticateAdmin() {\\n    return this.authenticate({ requiredRoles: [UserRole.ADMIN] });\\n  }\\n\\n  /**\\n   * 客户认证中间件\\n   */\\n  static authenticateCustomer() {\\n    return this.authenticate({ requiredRoles: [UserRole.CUSTOMER] });\\n  }\\n\\n  /**\\n   * 员工认证中间件\\n   */\\n  static authenticateEmployee() {\\n    return this.authenticate({ requiredRoles: [UserRole.EMPLOYEE] });\\n  }\\n\\n  /**\\n   * 认证或访客中间件（可选认证）\\n   */\\n  static authenticateOrGuest() {\\n    return this.authenticate({ optional: true });\\n  }\\n}\\n\\n// 扩展FastifyRequest类型\\ndeclare module 'fastify' {\\n  interface FastifyRequest {\\n    user?: import('./jwt.service').JwtPayload;\\n    authToken?: string;\\n  }\\n}\",\"originTextLength\":2888,\"aiScene\":\"Completion\",\"behaviorType\":\"accept\",\"updateTime\":1766162509989}]",
  "range-cache-file:///Users/my/Downloads/%E6%99%BA%E6%9E%A2%E6%9C%8D%E5%8A%A1%E5%B9%B3%E5%8F%B0/lib/auth/jwt.service.ts": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":155,\"character\":43}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":155,\"character\":43}},\"action\":\"None\",\"isLine\":false,\"originText\":\"/**\\\\n * @file JWT认证服务\\\\n * @description 提供JWT令牌的生成、验证和解析功能\\\\n * @module auth\\\\n * @author YYC\\\\n * @version 1.0.0\\\\n * @created 2024-12-06\\\\n * @updated 2024-12-06\\\\n */\\\\n\\\\nimport jwt from \\\\'jsonwebtoken\\\\';\\\\nimport { env } from \\\\'../../env\\\\';\\\\n\\\\n// 用户角色定义\\\\nexport enum UserRole {\\\\n  ADMIN = \\\\'admin\\\\',\\\\n  CUSTOMER = \\\\'customer\\\\',\\\\n  EMPLOYEE = \\\\'employee\\\\',\\\\n  GUEST = \\\\'guest\\\\'\\\\n}\\\\n\\\\n// JWT payload接口\\\\nexport interface JwtPayload {\\\\n  userId: string;\\\\n  email: string;\\\\n  role: UserRole;\\\\n  iat: number;\\\\n  exp: number;\\\\n}\\\\n\\\\n// 认证结果接口\\\\nexport interface AuthResult {\\\\n  success: boolean;\\\\n  token?: string;\\\\n  payload?: JwtPayload;\\\\n  error?: string;\\\\n}\\\\n\\\\nexport class JwtService {\\\\n  private readonly secretKey: string;\\\\n  private readonly tokenExpiry: number; // 过期时间（秒）\\\\n\\\\n  constructor() {\\\\n    this.secretKey = env.JWT_SECRET || \\\\'your-secret-key\\\\'; // 从环境变量获取密钥\\\\n    this.tokenExpiry = this.parseExpiry(env.JWT_EXPIRES_IN || \\\\'3600\\\\'); // 默认1小时\\\\n  }\\\\n\\\\n  /**\\\\n   * 解析过期时间字符串为秒数\\\\n   * @param expiryStr 过期时间字符串 (如: \\\\'24h\\\\', \\\\'1h\\\\', \\\\'30m\\\\')\\\\n   * @returns 过期时间秒数\\\\n   */\\\\n  private parseExpiry(expiryStr: string): number {\\\\n    const matches = expiryStr.match(/^(\\\\\\\\d+)([hmsd])?$/);\\\\n    if (!matches) return 3600;\\\\n\\\\n    const [, value, unit] = matches;\\\\n    const numValue = Number(value);\\\\n\\\\n    switch (unit) {\\\\n      case \\\\'d\\\\': // 天\\\\n        return numValue * 24 * 60 * 60;\\\\n      case \\\\'h\\\\': // 小时\\\\n        return numValue * 60 * 60;\\\\n      case \\\\'m\\\\': // 分钟\\\\n        return numValue * 60;\\\\n      case \\\\'s\\\\': // 秒\\\\n        return numValue;\\\\n      default: // 默认秒\\\\n        return numValue;\\\\n    }\\\\n  }\\\\n\\\\n  /**\\\\n   * 生成JWT令牌\\\\n   * @param userId 用户ID\\\\n   * @param email 用户邮箱\\\\n   * @param role 用户角色\\\\n   * @returns 生成的JWT令牌\\\\n   */\\\\n  generateToken(userId: string, email: string, role: UserRole): string {\\\\n    const payload: Omit<JwtPayload, \\\\'iat\\\\' | \\\\'exp\\\\'> = {\\\\n      userId,\\\\n      email,\\\\n      role\\\\n    };\\\\n\\\\n    return jwt.sign(payload, this.secretKey, {\\\\n      expiresIn: this.tokenExpiry,\\\\n      algorithm: \\\\'HS256\\\\'\\\\n    });\\\\n  }\\\\n\\\\n  /**\\\\n   * 验证JWT令牌\\\\n   * @param token JWT令牌\\\\n   * @returns 认证结果\\\\n   */\\\\n  verifyToken(token: string): AuthResult {\\\\n    try {\\\\n      const payload = jwt.verify(token, this.secretKey, {\\\\n        algorithms: [\\\\'HS256\\\\']\\\\n      }) as JwtPayload;\\\\n\\\\n      return {\\\\n        success: true,\\\\n        payload\\\\n      };\\\\n    } catch (error) {\\\\n      let errorMessage = \\\\'Invalid token\\\\';\\\\n      if (error instanceof jwt.TokenExpiredError) {\\\\n        errorMessage = \\\\'Token expired\\\\';\\\\n      } else if (error instanceof jwt.JsonWebTokenError) {\\\\n        errorMessage = \\\\'Invalid token format\\\\';\\\\n      }\\\\n\\\\n      return {\\\\n        success: false,\\\\n        error: errorMessage\\\\n      };\\\\n    }\\\\n  }\\\\n\\\\n  /**\\\\n   * 解析JWT令牌（不验证）\\\\n   * @param token JWT令牌\\\\n   * @returns 解析后的payload或null\\\\n   */\\\\n  decodeToken(token: string): JwtPayload | null {\\\\n    try {\\\\n      return jwt.decode(token) as JwtPayload;\\\\n    } catch (error) {\\\\n      return null;\\\\n    }\\\\n  }\\\\n\\\\n  /**\\\\n   * 刷新JWT令牌\\\\n   * @param token 旧的JWT令牌\\\\n   * @returns 新的JWT令牌或null\\\\n   */\\\\n  refreshToken(token: string): string | null {\\\\n    const result = this.verifyToken(token);\\\\n    if (!result.success || !result.payload) {\\\\n      return null;\\\\n    }\\\\n\\\\n    const { userId, email, role } = result.payload;\\\\n    return this.generateToken(userId, email, role);\\\\n  }\\\\n\\\\n  /**\\\\n   * 验证用户角色\\\\n   * @param token JWT令牌\\\\n   * @param requiredRoles 要求的角色列表\\\\n   * @returns 是否具有所需角色\\\\n   */\\\\n  verifyRole(token: string, requiredRoles: UserRole[]): boolean {\\\\n    const result = this.verifyToken(token);\\\\n    if (!result.success || !result.payload) {\\\\n      return false;\\\\n    }\\\\n\\\\n    return requiredRoles.includes(result.payload.role);\\\\n  }\\\\n\\\\n  /**\\\\n   * 获取令牌过期时间（毫秒）\\\\n   * @returns 过期时间（毫秒）\\\\n   */\\\\n  getTokenExpiryMs(): number {\\\\n    return this.tokenExpiry * 1000;\\\\n  }\\\\n}\\\\n\\\\n// 导出单例实例\\\\nexport const jwtService = new JwtService();\",\"originAcceptText\":\"/**\\n * @file JWT认证服务\\n * @description 提供JWT令牌的生成、验证和解析功能\\n * @module auth\\n * @author YYC\\n * @version 1.0.0\\n * @created 2024-12-06\\n * @updated 2024-12-06\\n */\\n\\nimport jwt from 'jsonwebtoken';\\nimport { env } from '../../env';\\n\\n// 用户角色定义\\nexport enum UserRole {\\n  ADMIN = 'admin',\\n  CUSTOMER = 'customer',\\n  EMPLOYEE = 'employee',\\n  GUEST = 'guest'\\n}\\n\\n// JWT payload接口\\nexport interface JwtPayload {\\n  userId: string;\\n  email: string;\\n  role: UserRole;\\n  iat: number;\\n  exp: number;\\n}\\n\\n// 认证结果接口\\nexport interface AuthResult {\\n  success: boolean;\\n  token?: string;\\n  payload?: JwtPayload;\\n  error?: string;\\n}\\n\\nexport class JwtService {\\n  private readonly secretKey: string;\\n  private readonly tokenExpiry: number; // 过期时间（秒）\\n\\n  constructor() {\\n    this.secretKey = env.JWT_SECRET || 'your-secret-key'; // 从环境变量获取密钥\\n    this.tokenExpiry = this.parseExpiry(env.JWT_EXPIRES_IN || '3600'); // 默认1小时\\n  }\\n\\n  /**\\n   * 解析过期时间字符串为秒数\\n   * @param expiryStr 过期时间字符串 (如: '24h', '1h', '30m')\\n   * @returns 过期时间秒数\\n   */\\n  private parseExpiry(expiryStr: string): number {\\n    const matches = expiryStr.match(/^(\\\\d+)([hmsd])?$/);\\n    if (!matches) return 3600;\\n\\n    const [, value, unit] = matches;\\n    const numValue = Number(value);\\n\\n    switch (unit) {\\n      case 'd': // 天\\n        return numValue * 24 * 60 * 60;\\n      case 'h': // 小时\\n        return numValue * 60 * 60;\\n      case 'm': // 分钟\\n        return numValue * 60;\\n      case 's': // 秒\\n        return numValue;\\n      default: // 默认秒\\n        return numValue;\\n    }\\n  }\\n\\n  /**\\n   * 生成JWT令牌\\n   * @param userId 用户ID\\n   * @param email 用户邮箱\\n   * @param role 用户角色\\n   * @returns 生成的JWT令牌\\n   */\\n  generateToken(userId: string, email: string, role: UserRole): string {\\n    const payload: Omit<JwtPayload, 'iat' | 'exp'> = {\\n      userId,\\n      email,\\n      role\\n    };\\n\\n    return jwt.sign(payload, this.secretKey, {\\n      expiresIn: this.tokenExpiry,\\n      algorithm: 'HS256'\\n    });\\n  }\\n\\n  /**\\n   * 验证JWT令牌\\n   * @param token JWT令牌\\n   * @returns 认证结果\\n   */\\n  verifyToken(token: string): AuthResult {\\n    try {\\n      const payload = jwt.verify(token, this.secretKey, {\\n        algorithms: ['HS256']\\n      }) as JwtPayload;\\n\\n      return {\\n        success: true,\\n        payload\\n      };\\n    } catch (error) {\\n      let errorMessage = 'Invalid token';\\n      if (error instanceof jwt.TokenExpiredError) {\\n        errorMessage = 'Token expired';\\n      } else if (error instanceof jwt.JsonWebTokenError) {\\n        errorMessage = 'Invalid token format';\\n      }\\n\\n      return {\\n        success: false,\\n        error: errorMessage\\n      };\\n    }\\n  }\\n\\n  /**\\n   * 解析JWT令牌（不验证）\\n   * @param token JWT令牌\\n   * @returns 解析后的payload或null\\n   */\\n  decodeToken(token: string): JwtPayload | null {\\n    try {\\n      return jwt.decode(token) as JwtPayload;\\n    } catch (error) {\\n      return null;\\n    }\\n  }\\n\\n  /**\\n   * 刷新JWT令牌\\n   * @param token 旧的JWT令牌\\n   * @returns 新的JWT令牌或null\\n   */\\n  refreshToken(token: string): string | null {\\n    const result = this.verifyToken(token);\\n    if (!result.success || !result.payload) {\\n      return null;\\n    }\\n\\n    const { userId, email, role } = result.payload;\\n    return this.generateToken(userId, email, role);\\n  }\\n\\n  /**\\n   * 验证用户角色\\n   * @param token JWT令牌\\n   * @param requiredRoles 要求的角色列表\\n   * @returns 是否具有所需角色\\n   */\\n  verifyRole(token: string, requiredRoles: UserRole[]): boolean {\\n    const result = this.verifyToken(token);\\n    if (!result.success || !result.payload) {\\n      return false;\\n    }\\n\\n    return requiredRoles.includes(result.payload.role);\\n  }\\n\\n  /**\\n   * 获取令牌过期时间（毫秒）\\n   * @returns 过期时间（毫秒）\\n   */\\n  getTokenExpiryMs(): number {\\n    return this.tokenExpiry * 1000;\\n  }\\n}\\n\\n// 导出单例实例\\nexport const jwtService = new JwtService();\",\"originTextLength\":3692,\"aiScene\":\"Completion\",\"behaviorType\":\"accept\",\"updateTime\":1766162509992}]",
