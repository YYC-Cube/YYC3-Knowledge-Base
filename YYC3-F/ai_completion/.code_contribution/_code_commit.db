nc provideRealTimeAssistance(callSession: CallSession): Promise<RealTimeAssistance> {\\n    // 流式处理音频\\n    const streamingTranscript = await this.streamingProcessor.processStream(\\n      callSession.audioStream,\\n      async (chunk) => {\\n        return await this.speechRecognizer.transcribeChunk(chunk);\\n      }\\n    );\",\"originTextLength\":1465,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1767732948140},{\"originRange\":{\"start\":{\"line\":183,\"character\":0},\"end\":{\"line\":188,\"character\":7}},\"modifyRange\":{\"start\":{\"line\":183,\"character\":0},\"end\":{\"line\":188,\"character\":7}},\"action\":\"None\",\"isLine\":false,\"originText\":\"    // 并行分析\\\\n    const [sentiment, intent, context] = await Promise.all([\\\\n      this.sentimentAnalyzer.analyzeRealtime(streamingTranscript),\\\\n      this.intentClassifier.classifyIntent(streamingTranscript),\\\\n      this.analyzeCallContext(streamingTranscript, callSession)\\\\n    ]);\",\"originAcceptText\":\"    // 并行分析\\n    const [sentiment, intent, context] = await Promise.all([\\n      this.sentimentAnalyzer.analyzeRealtime(streamingTranscript),\\n      this.intentClassifier.classifyIntent(streamingTranscript),\\n      this.analyzeCallContext(streamingTranscript, callSession)\\n    ]);\",\"originTextLength\":276,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1767732948148},{\"originRange\":{\"start\":{\"line\":187,\"character\":0},\"end\":{\"line\":193,\"character\":7}},\"modifyRange\":{\"start\":{\"line\":187,\"character\":0},\"end\":{\"line\":193,\"character\":7}},\"action\":\"None\",\"isLine\":false,\"originText\":\"    // 优先级建议生成\\\\n    const suggestions = await this.generatePrioritizedSuggestions({\\\\n      transcript: streamingTranscript,\\\\n      sentiment,\\\\n      intent,\\\\n      callContext: context\\\\n    });\",\"originAcceptText\":\"    // 优先级建议生成\\n    const suggestions = await this.generatePrioritizedSuggestions({\\n      transcript: