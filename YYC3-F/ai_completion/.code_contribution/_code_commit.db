"isLine\":false,\"originText\":\"- Skeleton - 骨架屏\",\"originAcceptText\":\"- Skeleton - 骨架屏\",\"originTextLength\":16,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768948420273},{\"originRange\":{\"start\":{\"line\":161,\"character\":0},\"end\":{\"line\":161,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":161,\"character\":0},\"end\":{\"line\":161,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"\",\"originAcceptText\":\"\",\"originTextLength\":0,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768948420303},{\"originRange\":{\"start\":{\"line\":163,\"character\":0},\"end\":{\"line\":164,\"character\":3}},\"modifyRange\":{\"start\":{\"line\":163,\"character\":0},\"end\":{\"line\":164,\"character\":3}},\"action\":\"None\",\"isLine\":false,\"originText\":\"\\\\n---\",\"originAcceptText\":\"\\n---\",\"originTextLength\":4,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768948420330},{\"originRange\":{\"start\":{\"line\":166,\"character\":0},\"end\":{\"line\":166,\"character\":10}},\"modifyRange\":{\"start\":{\"line\":166,\"character\":0},\"end\":{\"line\":166,\"character\":10}},\"action\":\"None\",\"isLine\":false,\"originText\":\"## 📝 后续建议\",\"originAcceptText\":\"## 📝 后续建议\",\"originTextLength\":10,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768948420357}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/components/UI/docs/components/Dropdown.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":213,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":213,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# Dropdown 下拉菜单\\\\n\\\\n向下弹出的列表。\\\\n\\\\n## 何时使用\\\\n\\\\n- 当页面上的操作命令过多时，用此组件可以收纳操作元素。点击或移入元素，出现一个下拉菜单。\\\\n\\\\n## 代码演示\\\\n\\\\n### 基础用法\\\\n\\\\n```tsx\\\\nimport { Dropdown, DropdownMenu, DropdownItem } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function DropdownBasic() {\\\\n  const items = [\\\\n    { label: \\\\'选项一\\\\', value: \\\\'option1\\\\' },\\\\n    { label: \\\\'选项二\\\\', value: \\\\'option2\\\\' },\\\\n    { label: \\\\'选项三\\\\', value: \\\\'option3\\\\' },\\\\n  ]\\\\n\\\\n  return (\\\\n    <Dropdown\\\\n      items={items}\\\\n      trigger={<Button>点击打开</Button>}\\\\n    />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 触发方式\\\\n\\\\n```tsx\\\\nimport { Dropdown } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function DropdownTrigger() {\\\\n  const items = [\\\\n    { label: \\\\'选项一\\\\', value: \\\\'option1\\\\' },\\\\n    { label: \\\\'选项二\\\\', value: \\\\'option2\\\\' },\\\\n  ]\\\\n\\\\n  return (\\\\n    <div class=\\\\\\\"space-x-2\\\\\\\">\\\\n      <Dropdown\\\\n        trigger=\\\\\\\"click\\\\\\\"\\\\n        items={items}\\\\n        triggerElement={<Button>点击触发</Button>}\\\\n      />\\\\n      <Dropdown\\\\n        trigger=\\\\\\\"hover\\\\\\\"\\\\n        items={items}\\\\n        triggerElement={<Button>悬停触发</Button>}\\\\n      />\\\\n      <Dropdown\\\\n        trigger=\\\\\\\"focus\\\\\\\"\\\\n        items={items}\\\\n        triggerElement={<Button>聚焦触发</Button>}\\\\n      />\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 菜单项操作\\\\n\\\\n```tsx\\\\nimport { Dropdown, DropdownMenu, DropdownItem, DropdownDivider } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function DropdownActions() {\\\\n  return (\\\\n    <Dropdown\\\\n      trigger={<Button>操作</Button>}\\\\n    >\\\\n      <DropdownMenu>\\\\n        <DropdownItem>编辑</DropdownItem>\\\\n        <DropdownItem>复制</DropdownItem>\\\\n        <DropdownDivider />\\\\n        <DropdownItem danger>删除</DropdownItem>\\\\n      </DropdownMenu>\\\\n    </Dropdown>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 带图标\\\\n\\\\n```tsx\\\\nimport { Dropdown, DropdownMenu, DropdownItem } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function DropdownWithIcon() {\\\\n  return (\\\\n    <Dropdown\\\\n      trigger={<Button>带图标</Button>}\\\\n    >\\\\n      <DropdownMenu>\\\\n        <DropdownItem icon=\\\\\\\"📝\\\\\\\">编辑</DropdownItem>\\\\n        <DropdownItem icon=\\\\\\\"📋\\\\\\\">复制</DropdownItem>\\\\n        <DropdownItem icon=\\\\\\\"🗑️\\\\\\\">删除</DropdownItem>\\\\n      </DropdownMenu>\\\\n    </Dropdown>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 禁用状态\\\\n\\\\n```tsx\\\\nimport { Dropdown, DropdownMenu, DropdownItem } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function DropdownDisabled() {\\\\n  return (\\\\n    <div class=\\\\\\\"space-x-2\\\\\\\">\\\\n      <Dropdown\\\\n        disabled\\\\n        items={[{ label: \\\\'选项一\\\\', value: \\\\'option1\\\\' }]}\\\\n        trigger={<Button>禁用</Button>}\\\\n      />\\\\n      <Dropdown\\\\n        trigger={<Button>部分禁用</Button>}\\\\n      >\\\\n        <DropdownMenu>\\\\n          <DropdownItem>可用</DropdownItem>\\\\n          <DropdownItem disabled>禁用</DropdownItem>\\\\n        </DropdownMenu>\\\\n      </Dropdown>\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n## API\\\\n\\\\n### Dropdown Props\\\\n\\\\n| 参数 | 说明 | 类型 | 可选值 | 默认值 |\\\\n|------|------|------|--------|--------|\\\\n| items | 选项数据 | `Option[]` | - | - |\\\\n| trigger | 触发方式 | `string` | `click` / `hover` / `focus` | `click` |\\\\n| triggerElement | 触发元素 | `VNode` | - | - |\\\\n| disabled | 是否禁用 | `boolean` | - | `false` |\\\\n| placement | 弹出位置 | `string` | `top` / `bottom` / `left` / `right` | `bottom` |\\\\n| onVisibleChange | 显示状态变化回调 | `Function` | - | - |\\\\n| className | 自定义类名 | `string` | - | - |\\\\n\\\\n### DropdownItem Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| label | 文本 | `string` | - |\\\\n| value | 值 | `string \\\\\\\\| number` | - |\\\\n| disabled | 是否禁用 | `boolean` | `false` |\\\\n| danger | 是否危险操作 | `boolean` | `false` |\\\\n| icon | 图标 | `VNode` | - |\\\\n| onClick | 点击回调 | `Function` | - |\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n### DropdownDivider Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n## 样式定制\\\\n\\\\n### CSS 变量\\\\n\\\\n```css\\\\n.dropdown {\\\\n  --dropdown-bg: #ffffff;\\\\n  --dropdown-border: #e5e7eb;\\\\n  --dropdown-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);\\\\n  --dropdown-item-hover: #f3f4f6;\\\\n  --dropdown-item-danger: #ef4444;\\\\n}\\\\n```\\\\n\\\\n### 自定义样式\\\\n\\\\n```tsx\\\\n<Dropdown className=\\\\\\\"custom-dropdown\\\\\\\">\\\\n  <DropdownMenu>\\\\n    <DropdownItem>自定义</DropdownItem>\\\\n  </DropdownMenu>\\\\n</Dropdown>\\\\n\\\\n<style>\\\\n.custom-dropdown .dropdown-menu {\\\\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\\\\n  color: white;\\\\n  border: none;\\\\n}\\\\n</style>\\\\n```\\\\n\\\\n## 最佳实践\\\\n\\\\n### 1. 操作菜单\\\\n\\\\n```tsx\\\\n<Dropdown\\\\n  trigger={<Button>更多操作</Button>}\\\\n>\\\\n  <DropdownMenu>\\\\n    <DropdownItem onClick={() => handleEdit()}>编辑</DropdownItem>\\\\n    <DropdownItem onClick={() => handleCopy()}>复制</DropdownItem>\\\\n    <DropdownDivider />\\\\n    <DropdownItem danger onClick={() => handleDelete()}>删除</DropdownItem>\\\\n  </DropdownMenu>\\\\n</Dropdown>\\\\n```\\\\n\\\\n### 2. 用户菜单\\\\n\\\\n```tsx\\\\n<Dropdown\\\\n  trigger={<Avatar src={user.avatar} />}\\\\n>\\\\n  <DropdownMenu>\\\\n    <DropdownItem>个人中心</DropdownItem>\\\\n    <DropdownItem>设置</DropdownItem>\\\\n    <DropdownDivider />\\\\n    <DropdownItem onClick={() => handleLogout()}>退出登录</DropdownItem>\\\\n  </DropdownMenu>\\\\n</Dropdown>\\\\n```\\\\n\\\\n### 3. 导航菜单\\\\n\\\\n```tsx\\\\n<Dropdown\\\\n  trigger={<Button>产品</Button>}\\\\n>\\\\n  <DropdownMenu>\\\\n    <DropdownItem>产品A</DropdownItem>\\\\n    <DropdownItem>产品B</DropdownItem>\\\\n    <DropdownItem>产品C</DropdownItem>\\\\n  </DropdownMenu>\\\\n</Dropdown>\\\\n```\\\\n\\\\n## 常见问题\\\\n\\\\n### Q: 如何自定义触发元素？\\\\n\\\\nA: 使用 `trigger` 属性传入自定义的 VNode。\\\\n\\\\n### Q: 如何实现多级菜单？\\\\n\\\\nA: 可以在 DropdownItem 中嵌套 Dropdown 组件。\\\\n\\\\n### Q: 如何处理菜单项点击？\\\\n\\\\nA: 使用 DropdownItem 的 `onClick` 回调函数。\\\\n\\\\n---\\\\n\\\\n🌹 Dropdown 组件文档完成！\\\\n\",\"originAcceptText\":\"# Dropdown 下拉菜单\\n\\n向下弹出的列表。\\n\\n## 何时使用\\n\\n- 当页面上的操作命令过多时，用此组件可以收纳操作元素。点击或移入元素，出现一个下拉菜单。\\n\\n## 代码演示\\n\\n### 基础用法\\n\\n```tsx\\nimport { Dropdown, DropdownMenu, DropdownItem } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\n\\nexport default function DropdownBasic() {\\n  const items = [\\n    { label: '选项一', value: 'option1' },\\n    { label: '选项二', value: 'option2' },\\n    { label: '选项三', value: 'option3' },\\n  ]\\n\\n  return (\\n    <Dropdown\\n      items={items}\\n      trigger={<Button>点击打开</Button>}\\n    />\\n  )\\n}\\n```\\n\\n### 触发方式\\n\\n```tsx\\nimport { Dropdown } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\n\\nexport default function DropdownTrigger() {\\n  const items = [\\n    { label: '选项一', value: 'option1' },\\n    { label: '选项二', value: 'option2' },\\n  ]\\n\\n  return (\\n    <div class=\\\"space-x-2\\\">\\n      <Dropdown\\n        trigger=\\\"click\\\"\\n        items={items}\\n        triggerElement={<Button>点击触发</Button>}\\n      />\\n      <Dropdown\\n        trigger=\\\"hover\\\"\\n        items={items}\\n        triggerElement={<Button>悬停触发</Button>}\\n      />\\n      <Dropdown\\n        trigger=\\\"focus\\\"\\n        items={items}\\n        triggerElement={<Button>聚焦触发</Button>}\\n      />\\n    </div>\\n  )\\n}\\n```\\n\\n### 菜单项操作\\n\\n```tsx\\nimport { Dropdown, DropdownMenu, DropdownItem, DropdownDivider } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\n\\nexport default function DropdownActions() {\\n  return (\\n    <Dropdown\\n      trigger={<Button>操作</Button>}\\n    >\\n      <DropdownMenu>\\n        <DropdownItem>编辑</DropdownItem>\\n        <DropdownItem>复制</DropdownItem>\\n        <DropdownDivider />\\n        <DropdownItem danger>删除</DropdownItem>\\n      </DropdownMenu>\\n    </Dropdown>\\n  )\\n}\\n```\\n\\n### 带图标\\n\\n```tsx\\nimport { Dropdown, DropdownMenu, DropdownItem } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\n\\nexport default function DropdownWithIcon() {\\n  return (\\n    <Dropdown\\n      trigger={<Button>带图标</Button>}\\n    >\\n      <DropdownMenu>\\n        <DropdownItem icon=\\\"📝\\\">编辑</DropdownItem>\\n        <DropdownItem icon=\\\"📋\\\">复制</DropdownItem>\\n        <DropdownItem icon=\\\"🗑️\\\">删除</DropdownItem>\\n      </DropdownMenu>\\n    </Dropdown>\\n  )\\n}\\n```\\n\\n### 禁用状态\\n\\n```tsx\\nimport { Dropdown, DropdownMenu, DropdownItem } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\n\\nexport default function DropdownDisabled() {\\n  return (\\n    <div class=\\\"space-x-2\\\">\\n      <Dropdown\\n        disabled\\n        items={[{ label: '选项一', value: 'option1' }]}\\n        trigger={<Button>禁用</Button>}\\n      />\\n      <Dropdown\\n        trigger={<Button>部分禁用</Button>}\\n      >\\n        <DropdownMenu>\\n          <DropdownItem>可用</DropdownItem>\\n          <DropdownItem disabled>禁用</DropdownItem>\\n        </DropdownMenu>\\n      </Dropdown>\\n    </div>\\n  )\\n}\\n```\\n\\n## API\\n\\n### Dropdown Props\\n\\n| 参数 | 说明 | 类型 | 可选值 | 默认值 |\\n|------|------|------|--------|--------|\\n| items | 选项数据 | `Option[]` | - | - |\\n| trigger | 触发方式 | `string` | `click` / `hover` / `focus` | `click` |\\n| triggerElement | 触发元素 | `VNode` | - | - |\\n| disabled | 是否禁用 | `boolean` | - | `false` |\\n| placement | 弹出位置 | `string` | `top` / `bottom` / `left` / `right` | `bottom` |\\n| onVisibleChange | 显示状态变化回调 | `Function` | - | - |\\n| className | 自定义类名 | `string` | - | - |\\n\\n### DropdownItem Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| label | 文本 | `string` | - |\\n| value | 值 | `string \\\\| number` | - |\\n| disabled | 是否禁用 | `boolean` | `false` |\\n| danger | 是否危险操作 | `boolean` | `false` |\\n| icon | 图标 | `VNode` | - |\\n| onClick | 点击回调 | `Function` | - |\\n| className | 自定义类名 | `string` | - |\\n\\n### DropdownDivider Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| className | 自定义类名 | `string` | - |\\n\\n## 样式定制\\n\\n### CSS 变量\\n\\n```css\\n.dropdown {\\n  --dropdown-bg: #ffffff;\\n  --dropdown-border: #e5e7eb;\\n  --dropdown-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);\\n  --dropdown-item-hover: #f3f4f6;\\n  --dropdown-item-danger: #ef4444;\\n}\\n```\\n\\n### 自定义样式\\n\\n```tsx\\n<Dropdown className=\\\"custom-dropdown\\\">\\n  <DropdownMenu>\\n    <DropdownItem>自定义</DropdownItem>\\n  </DropdownMenu>\\n</Dropdown>\\n\\n<style>\\n.custom-dropdown .dropdown-menu {\\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\\n  color: white;\\n  border: none;\\n}\\n</style>\\n```\\n\\n## 最佳实践\\n\\n### 1. 操作菜单\\n\\n```tsx\\n<Dropdown\\n  trigger={<Button>更多操作</Button>}\\n>\\n  <DropdownMenu>\\n    <DropdownItem onClick={() => handleEdit()}>编辑</DropdownItem>\\n    <DropdownItem onClick={() => handleCopy()}>复制</DropdownItem>\\n    <DropdownDivider />\\n    <DropdownItem danger onClick={() => handleDelete()}>删除</DropdownItem>\\n  </DropdownMenu>\\n</Dropdown>\\n```\\n\\n### 2. 用户菜单\\n\\n```tsx\\n<Dropdown\\n  trigger={<Avatar src={user.avatar} />}\\n>\\n  <DropdownMenu>\\n    <DropdownItem>个人中心</DropdownItem>\\n    <DropdownItem>设置</DropdownItem>\\n    <DropdownDivider />\\n    <DropdownItem onClick={() => handleLogout()}>退出登录</DropdownItem>\\n  </DropdownMenu>\\n</Dropdown>\\n```\\n\\n### 3. 导航菜单\\n\\n```tsx\\n<Dropdown\\n  trigger={<Button>产品</Button>}\\n>\\n  <DropdownMenu>\\n    <DropdownItem>产品A</DropdownItem>\\n    <DropdownItem>产品B</DropdownItem>\\n    <DropdownItem>产品C</DropdownItem>\\n  </DropdownMenu>\\n</Dropdown>\\n```\\n\\n## 常见问题\\n\\n### Q: 如何自定义触发元素？\\n\\nA: 使用 `trigger` 属性传入自定义的 VNode。\\n\\n### Q: 如何实现多级菜单？\\n\\nA: 可以在 DropdownItem 中嵌套 Dropdown 组件。\\n\\n### Q: 如何处理菜单项点击？\\n\\nA: 使用 DropdownItem 的 `onClick` 回调函数。\\n\\n---\\n\\n🌹 Dropdown 组件文档完成！\\n\",\"originTextLength\":5233,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768947916841}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/components/UI/docs/components/Breadcrumb.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":195,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":195,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# Breadcrumb 面包屑\\\\n\\\\n显示当前页面在系统层级结构中的位置，并能向上返回。\\\\n\\\\n## 何时使用\\\\n\\\\n- 当系统拥有超过两级层级时。\\\\n- 当需要告知用户『你在哪里』时。\\\\n- 当需要向上导航的功能时。\\\\n\\\\n## 代码演示\\\\n\\\\n### 基础用法\\\\n\\\\n```tsx\\\\nimport { Breadcrumb, BreadcrumbItem, BreadcrumbSeparator } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function BreadcrumbBasic() {\\\\n  return (\\\\n    <Breadcrumb>\\\\n      <BreadcrumbItem href=\\\\\\\"/\\\\\\\">首页</BreadcrumbItem>\\\\n      <BreadcrumbSeparator />\\\\n      <BreadcrumbItem href=\\\\\\\"/products\\\\\\\">产品</BreadcrumbItem>\\\\n      <BreadcrumbSeparator />\\\\n      <BreadcrumbItem>详情</BreadcrumbItem>\\\\n    </Breadcrumb>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 自定义分隔符\\\\n\\\\n```tsx\\\\nimport { Breadcrumb, BreadcrumbItem, BreadcrumbSeparator } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function BreadcrumbSeparator() {\\\\n  return (\\\\n    <div class=\\\\\\\"space-y-2\\\\\\\">\\\\n      <Breadcrumb separator=\\\\\\\"/\\\\\\\">\\\\n        <BreadcrumbItem href=\\\\\\\"/\\\\\\\">首页</BreadcrumbItem>\\\\n        <BreadcrumbItem href=\\\\\\\"/products\\\\\\\">产品</BreadcrumbItem>\\\\n        <BreadcrumbItem>详情</BreadcrumbItem>\\\\n      </Breadcrumb>\\\\n      <Breadcrumb separator=\\\\\\\">\\\\\\\">\\\\n        <BreadcrumbItem href=\\\\\\\"/\\\\\\\">首页</BreadcrumbItem>\\\\n        <BreadcrumbItem href=\\\\\\\"/products\\\\\\\">产品</BreadcrumbItem>\\\\n        <BreadcrumbItem>详情</BreadcrumbItem>\\\\n      </Breadcrumb>\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 带图标\\\\n\\\\n```tsx\\\\nimport { Breadcrumb, BreadcrumbItem, BreadcrumbSeparator } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function BreadcrumbWithIcon() {\\\\n  return (\\\\n    <Breadcrumb>\\\\n      <BreadcrumbItem href=\\\\\\\"/\\\\\\\">\\\\n        🏠 首页\\\\n      </BreadcrumbItem>\\\\n      <BreadcrumbSeparator />\\\\n      <BreadcrumbItem href=\\\\\\\"/products\\\\\\\">\\\\n        📦 产品\\\\n      </BreadcrumbItem>\\\\n      <BreadcrumbSeparator />\\\\n      <BreadcrumbItem>📄 详情</BreadcrumbItem>\\\\n    </Breadcrumb>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 可点击\\\\n\\\\n```tsx\\\\nimport { Breadcrumb, BreadcrumbItem, BreadcrumbSeparator } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function BreadcrumbClickable() {\\\\n  return (\\\\n    <Breadcrumb>\\\\n      <BreadcrumbItem href=\\\\\\\"/\\\\\\\" onClick={() => console.log(\\\\'首页\\\\')}>\\\\n        首页\\\\n      </BreadcrumbItem>\\\\n      <BreadcrumbSeparator />\\\\n      <BreadcrumbItem href=\\\\\\\"/products\\\\\\\" onClick={() => console.log(\\\\'产品\\\\')}>\\\\n        产品\\\\n      </BreadcrumbItem>\\\\n      <BreadcrumbSeparator />\\\\n      <BreadcrumbItem>详情</BreadcrumbItem>\\\\n    </Breadcrumb>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 禁用状态\\\\n\\\\n```tsx\\\\nimport { Breadcrumb, BreadcrumbItem, BreadcrumbSeparator } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function BreadcrumbDisabled() {\\\\n  return (\\\\n    <Breadcrumb>\\\\n      <BreadcrumbItem href=\\\\\\\"/\\\\\\\">首页</BreadcrumbItem>\\\\n      <BreadcrumbSeparator />\\\\n      <BreadcrumbItem href=\\\\\\\"/products\\\\\\\">产品</BreadcrumbItem>\\\\n      <BreadcrumbSeparator />\\\\n      <BreadcrumbItem disabled>详情</BreadcrumbItem>\\\\n    </Breadcrumb>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n## API\\\\n\\\\n### Breadcrumb Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| separator | 分隔符 | `string` | `/` |\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n### BreadcrumbItem Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| href | 链接地址 | `string` | - |\\\\n| disabled | 是否禁用 | `boolean` | `false` |\\\\n| onClick | 点击回调 | `Function` | - |\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n### BreadcrumbSeparator Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n## 样式定制\\\\n\\\\n### CSS 变量\\\\n\\\\n```css\\\\n.breadcrumb {\\\\n  --breadcrumb-item-color: #6b7280;\\\\n  --breadcrumb-item-hover: #3b82f6;\\\\n  --breadcrumb-separator-color: #9ca3af;\\\\n  --breadcrumb-font-size: 0.875rem;\\\\n}\\\\n```\\\\n\\\\n### 自定义样式\\\\n\\\\n```tsx\\\\n<Breadcrumb className=\\\\\\\"custom-breadcrumb\\\\\\\">\\\\n  <BreadcrumbItem href=\\\\\\\"/\\\\\\\">首页</BreadcrumbItem>\\\\n  <BreadcrumbSeparator />\\\\n  <BreadcrumbItem>详情</BreadcrumbItem>\\\\n</Breadcrumb>\\\\n\\\\n<style>\\\\n.custom-breadcrumb .breadcrumb-item {\\\\n  color: #667eea;\\\\n}\\\\n\\\\n.custom-breadcrumb .breadcrumb-item:hover {\\\\n  color: #764ba2;\\\\n}\\\\n</style>\\\\n```\\\\n\\\\n## 最佳实践\\\\n\\\\n### 1. 动态面包屑\\\\n\\\\n```tsx\\\\nconst routes = [\\\\n  { path: \\\\'/\\\\', name: \\\\'首页\\\\' },\\\\n  { path: \\\\'/products\\\\', name: \\\\'产品\\\\' },\\\\n  { path: \\\\'/products/detail\\\\', name: \\\\'详情\\\\' }\\\\n]\\\\n\\\\nconst breadcrumbItems = computed(() => {\\\\n  return routes.map((route, index) => (\\\\n    <Fragment key={route.path}>\\\\n      <BreadcrumbItem href={route.path}>\\\\n        {route.name}\\\\n      </BreadcrumbItem>\\\\n      {index < routes.length - 1 && <BreadcrumbSeparator />}\\\\n    </Fragment>\\\\n  ))\\\\n})\\\\n```\\\\n\\\\n### 2. 带路由的面包屑\\\\n\\\\n```tsx\\\\nimport { useRouter } from \\\\'vue-router\\\\'\\\\n\\\\nconst router = useRouter()\\\\n\\\\nconst handleClick = (path: string) => {\\\\n  router.push(path)\\\\n}\\\\n\\\\n<Breadcrumb>\\\\n  <BreadcrumbItem href=\\\\\\\"/\\\\\\\" onClick={() => handleClick(\\\\'/\\\\')}>\\\\n    首页\\\\n  </BreadcrumbItem>\\\\n  <BreadcrumbSeparator />\\\\n  <BreadcrumbItem href=\\\\\\\"/products\\\\\\\" onClick={() => handleClick(\\\\'/products\\\\')}>\\\\n    产品\\\\n  </BreadcrumbItem>\\\\n</Breadcrumb>\\\\n```\\\\n\\\\n### 3. 面包屑导航\\\\n\\\\n```tsx\\\\n<Breadcrumb>\\\\n  <BreadcrumbItem href=\\\\\\\"/\\\\\\\">首页</BreadcrumbItem>\\\\n  <BreadcrumbSeparator />\\\\n  <BreadcrumbItem href=\\\\\\\"/category\\\\\\\">分类</BreadcrumbItem>\\\\n  <BreadcrumbSeparator />\\\\n  <BreadcrumbItem href=\\\\\\\"/category/123\\\\\\\">子分类</BreadcrumbItem>\\\\n  <BreadcrumbSeparator />\\\\n  <BreadcrumbItem>商品详情</BreadcrumbItem>\\\\n</Breadcrumb>\\\\n```\\\\n\\\\n## 常见问题\\\\n\\\\n### Q: 如何自定义分隔符？\\\\n\\\\nA: 使用 `separator` 属性设置自定义分隔符。\\\\n\\\\n### Q: 如何实现点击导航？\\\\n\\\\nA: 使用 `href` 属性和 `onClick` 回调实现点击导航。\\\\n\\\\n### Q: 如何禁用某个面包屑项？\\\\n\\\\nA: 使用 `disabled` 属性禁用面包屑项。\\\\n\\\\n---\\\\n\\\\n🌹 Breadcrumb 组件文档完成！\\\\n\",\"originAcceptText\":\"# Breadcrumb 面包屑\\n\\n显示当前页面在系统层级结构中的位置，并能向上返回。\\n\\n## 何时使用\\n\\n- 当系统拥有超过两级层级时。\\n- 当需要告知用户『你在哪里』时。\\n- 当需要向上导航的功能时。\\n\\n## 代码演示\\n\\n### 基础用法\\n\\n```tsx\\nimport { Breadcrumb, BreadcrumbItem, BreadcrumbSeparator } from '@/components/UI'\\n\\nexport default function BreadcrumbBasic() {\\n  return (\\n    <Breadcrumb>\\n      <BreadcrumbItem href=\\\"/\\\">首页</BreadcrumbItem>\\n      <BreadcrumbSeparator />\\n      <BreadcrumbItem href=\\\"/products\\\">产品</BreadcrumbItem>\\n      <BreadcrumbSeparator />\\n      <BreadcrumbItem>详情</BreadcrumbItem>\\n    </Breadcrumb>\\n  )\\n}\\n```\\n\\n### 自定义分隔符\\n\\n```tsx\\nimport { Breadcrumb, BreadcrumbItem, BreadcrumbSeparator } from '@/components/UI'\\n\\nexport default function BreadcrumbSeparator() {\\n  return (\\n    <div class=\\\"space-y-2\\\">\\n      <Breadcrumb separator=\\\"/\\\">\\n        <BreadcrumbItem href=\\\"/\\\">首页</BreadcrumbItem>\\n        <BreadcrumbItem href=\\\"/products\\\">产品</BreadcrumbItem>\\n        <BreadcrumbItem>详情</BreadcrumbItem>\\n      </Breadcrumb>\\n      <Breadcrumb separator=\\\">\\\">\\n        <BreadcrumbItem href=\\\"/\\\">首页</BreadcrumbItem>\\n        <BreadcrumbItem href=\\\"/products\\\">产品</BreadcrumbItem>\\n        <BreadcrumbItem>详情</BreadcrumbItem>\\n      </Breadcrumb>\\n    </div>\\n  )\\n}\\n```\\n\\n### 带图标\\n\\n```tsx\\nimport { Breadcrumb, BreadcrumbItem, BreadcrumbSeparator } from '@/components/UI'\\n\\nexport default function BreadcrumbWithIcon() {\\n  return (\\n    <Breadcrumb>\\n      <BreadcrumbItem href=\\\"/\\\">\\n        🏠 首页\\n      </BreadcrumbItem>\\n      <BreadcrumbSeparator />\\n      <BreadcrumbItem href=\\\"/products\\\">\\n        📦 产品\\n      </BreadcrumbItem>\\n      <BreadcrumbSeparator />\\n      <BreadcrumbItem>📄 详情</BreadcrumbItem>\\n    </Breadcrumb>\\n  )\\n}\\n```\\n\\n### 可点击\\n\\n```tsx\\nimport { Breadcrumb, BreadcrumbItem, BreadcrumbSeparator } from '@/components/UI'\\n\\nexport default function BreadcrumbClickable() {\\n  return (\\n    <Breadcrumb>\\n      <BreadcrumbItem href=\\\"/\\\" onClick={() => console.log('首页')}>\\n        首页\\n      </BreadcrumbItem>\\n      <BreadcrumbSeparator />\\n      <BreadcrumbItem href=\\\"/products\\\" onClick={() => console.log('产品')}>\\n        产品\\n      </BreadcrumbItem>\\n      <BreadcrumbSeparator />\\n      <BreadcrumbItem>详情</BreadcrumbItem>\\n    </Breadcrumb>\\n  )\\n}\\n```\\n\\n### 禁用状态\\n\\n```tsx\\nimport { Breadcrumb, BreadcrumbItem, BreadcrumbSeparator } from '@/components/UI'\\n\\nexport default function BreadcrumbDisabled() {\\n  return (\\n    <Breadcrumb>\\n      <BreadcrumbItem href=\\\"/\\\">首页</BreadcrumbItem>\\n      <BreadcrumbSeparator />\\n      <BreadcrumbItem href=\\\"/products\\\">产品</BreadcrumbItem>\\n      <BreadcrumbSeparator />\\n      <BreadcrumbItem disabled>详情</BreadcrumbItem>\\n    </Breadcrumb>\\n  )\\n}\\n```\\n\\n## API\\n\\n### Breadcrumb Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| separator | 分隔符 | `string` | `/` |\\n| className | 自定义类名 | `string` | - |\\n\\n### BreadcrumbItem Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| href | 链接地址 | `string` | - |\\n| disabled | 是否禁用 | `boolean` | `false` |\\n| onClick | 点击回调 | `Function` | - |\\n| className | 自定义类名 | `string` | - |\\n\\n### BreadcrumbSeparator Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| className | 自定义类名 | `string` | - |\\n\\n## 样式定制\\n\\n### CSS 变量\\n\\n```css\\n.breadcrumb {\\n  --breadcrumb-item-color: #6b7280;\\n  --breadcrumb-item-hover: #3b82f6;\\n  --breadcrumb-separator-color: #9ca3af;\\n  --breadcrumb-font-size: 0.875rem;\\n}\\n```\\n\\n### 自定义样式\\n\\n```tsx\\n<Breadcrumb className=\\\"custom-breadcrumb\\\">\\n  <BreadcrumbItem href=\\\"/\\\">首页</BreadcrumbItem>\\n  <BreadcrumbSeparator />\\n  <BreadcrumbItem>详情</BreadcrumbItem>\\n</Breadcrumb>\\n\\n<style>\\n.custom-breadcrumb .breadcrumb-item {\\n  color: #667eea;\\n}\\n\\n.custom-breadcrumb .breadcrumb-item:hover {\\n  color: #764ba2;\\n}\\n</style>\\n```\\n\\n## 最佳实践\\n\\n### 1. 动态面包屑\\n\\n```tsx\\nconst routes = [\\n  { path: '/', name: '首页' },\\n  { path: '/products', name: '产品' },\\n  { path: '/products/detail', name: '详情' }\\n]\\n\\nconst breadcrumbItems = computed(() => {\\n  return routes.map((route, index) => (\\n    <Fragment key={route.path}>\\n      <BreadcrumbItem href={route.path}>\\n        {route.name}\\n      </BreadcrumbItem>\\n      {index < routes.length - 1 && <BreadcrumbSeparator />}\\n    </Fragment>\\n  ))\\n})\\n```\\n\\n### 2. 带路由的面包屑\\n\\n```tsx\\nimport { useRouter } from 'vue-router'\\n\\nconst router = useRouter()\\n\\nconst handleClick = (path: string) => {\\n  router.push(path)\\n}\\n\\n<Breadcrumb>\\n  <BreadcrumbItem href=\\\"/\\\" onClick={() => handleClick('/')}>\\n    首页\\n  </BreadcrumbItem>\\n  <BreadcrumbSeparator />\\n  <BreadcrumbItem href=\\\"/products\\\" onClick={() => handleClick('/products')}>\\n    产品\\n  </BreadcrumbItem>\\n</Breadcrumb>\\n```\\n\\n### 3. 面包屑导航\\n\\n```tsx\\n<Breadcrumb>\\n  <BreadcrumbItem href=\\\"/\\\">首页</BreadcrumbItem>\\n  <BreadcrumbSeparator />\\n  <BreadcrumbItem href=\\\"/category\\\">分类</BreadcrumbItem>\\n  <BreadcrumbSeparator />\\n  <BreadcrumbItem href=\\\"/category/123\\\">子分类</BreadcrumbItem>\\n  <BreadcrumbSeparator />\\n  <BreadcrumbItem>商品详情</BreadcrumbItem>\\n</Breadcrumb>\\n```\\n\\n## 常见问题\\n\\n### Q: 如何自定义分隔符？\\n\\nA: 使用 `separator` 属性设置自定义分隔符。\\n\\n### Q: 如何实现点击导航？\\n\\nA: 使用 `href` 属性和 `onClick` 回调实现点击导航。\\n\\n### Q: 如何禁用某个面包屑项？\\n\\nA: 使用 `disabled` 属性禁用面包屑项。\\n\\n---\\n\\n🌹 Breadcrumb 组件文档完成！\\n\",\"originTextLength\":4972,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768947940768}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/components/UI/docs/components/Pagination.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":212,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":212,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# Pagination 分页\\\\n\\\\n采用分页形式分隔长列表，每次只加载一个页面。\\\\n\\\\n## 何时使用\\\\n\\\\n- 当加载/渲染所有数据将花费很多时间时。\\\\n- 可切换页码改变数据展示。\\\\n\\\\n## 代码演示\\\\n\\\\n### 基础用法\\\\n\\\\n```tsx\\\\nimport { Pagination } from \\\\'@/components/UI\\\\'\\\\nimport { ref } from \\\\'vue\\\\'\\\\n\\\\nexport default function PaginationBasic() {\\\\n  const current = ref(1)\\\\n\\\\n  return (\\\\n    <Pagination\\\\n      v-model={current.value}\\\\n      total={100}\\\\n      pageSize={10}\\\\n    />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 更多功能\\\\n\\\\n```tsx\\\\nimport { Pagination } from \\\\'@/components/UI\\\\'\\\\nimport { ref } from \\\\'vue\\\\'\\\\n\\\\nexport default function PaginationMore() {\\\\n  const current = ref(1)\\\\n  const pageSize = ref(10)\\\\n\\\\n  return (\\\\n    <Pagination\\\\n      v-model={current.value}\\\\n      v-model:pageSize={pageSize.value}\\\\n      total={100}\\\\n      showTotal\\\\n      showSizeChanger\\\\n      showQuickJumper\\\\n    />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 迷你版\\\\n\\\\n```tsx\\\\nimport { Pagination } from \\\\'@/components/UI\\\\'\\\\nimport { ref } from \\\\'vue\\\\'\\\\n\\\\nexport default function PaginationMini() {\\\\n  const current = ref(1)\\\\n\\\\n  return (\\\\n    <Pagination\\\\n      v-model={current.value}\\\\n      total={100}\\\\n      pageSize={10}\\\\n      size=\\\\\\\"sm\\\\\\\"\\\\n      simple\\\\n    />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 改变每页数量\\\\n\\\\n```tsx\\\\nimport { Pagination } from \\\\'@/components/UI\\\\'\\\\nimport { ref } from \\\\'vue\\\\'\\\\n\\\\nexport default function PaginationSizeChanger() {\\\\n  const current = ref(1)\\\\n  const pageSize = ref(10)\\\\n\\\\n  const handlePageSizeChange = (size: number) => {\\\\n    console.log(\\\\'每页数量:\\\\', size)\\\\n  }\\\\n\\\\n  return (\\\\n    <Pagination\\\\n      v-model={current.value}\\\\n      v-model:pageSize={pageSize.value}\\\\n      total={100}\\\\n      showSizeChanger\\\\n      onPageSizeChange={handlePageSizeChange}\\\\n    />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 快速跳转\\\\n\\\\n```tsx\\\\nimport { Pagination } from \\\\'@/components/UI\\\\'\\\\nimport { ref } from \\\\'vue\\\\'\\\\n\\\\nexport default function PaginationQuickJumper() {\\\\n  const current = ref(1)\\\\n\\\\n  return (\\\\n    <Pagination\\\\n      v-model={current.value}\\\\n      total={100}\\\\n      pageSize={10}\\\\n      showQuickJumper\\\\n    />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 显示总数\\\\n\\\\n```tsx\\\\nimport { Pagination } from \\\\'@/components/UI\\\\'\\\\nimport { ref } from \\\\'vue\\\\'\\\\n\\\\nexport default function PaginationShowTotal() {\\\\n  const current = ref(1)\\\\n\\\\n  return (\\\\n    <Pagination\\\\n      v-model={current.value}\\\\n      total={100}\\\\n      pageSize={10}\\\\n      showTotal\\\\n    />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n## API\\\\n\\\\n### Pagination Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| modelValue | 当前页数 | `number` | `1` |\\\\n| total | 数据总数 | `number` | `0` |\\\\n| pageSize | 每页条数 | `number` | `10` |\\\\n| disabled | 是否禁用 | `boolean` | `false` |\\\\n| size | 尺寸 | `string` | `sm` / `md` / `lg` | `md` |\\\\n| simple | 是否简洁模式 | `boolean` | `false` |\\\\n| showTotal | 是否显示总数 | `boolean` | `false` |\\\\n| showSizeChanger | 是否显示每页条数选择器 | `boolean` | `false` |\\\\n| showQuickJumper | 是否显示快速跳转 | `boolean` | `false` |\\\\n| pageSizeOptions | 每页条数选项 | `number[]` | `[10, 20, 50, 100]` |\\\\n| onChange | 页码变化回调 | `Function` | - |\\\\n| onPageSizeChange | 每页条数变化回调 | `Function` | - |\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n## 样式定制\\\\n\\\\n### CSS 变量\\\\n\\\\n```css\\\\n.pagination {\\\\n  --pagination-bg: #ffffff;\\\\n  --pagination-border: #e5e7eb;\\\\n  --pagination-text: #374151;\\\\n  --pagination-hover-bg: #f3f4f6;\\\\n  --pagination-active-bg: #3b82f6;\\\\n  --pagination-active-text: #ffffff;\\\\n  --pagination-disabled-bg: #f9fafb;\\\\n  --pagination-disabled-text: #9ca3af;\\\\n}\\\\n```\\\\n\\\\n### 自定义样式\\\\n\\\\n```tsx\\\\n<Pagination className=\\\\\\\"custom-pagination\\\\\\\" total={100} />\\\\n\\\\n<style>\\\\n.custom-pagination .pagination-item {\\\\n  border-radius: 0.5rem;\\\\n}\\\\n\\\\n.custom-pagination .pagination-item.active {\\\\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\\\\n  border-color: #667eea;\\\\n}\\\\n</style>\\\\n```\\\\n\\\\n## 最佳实践\\\\n\\\\n### 1. 表格分页\\\\n\\\\n```tsx\\\\nconst current = ref(1)\\\\nconst pageSize = ref(10)\\\\nconst data = ref([])\\\\n\\\\nconst fetchData = async () => {\\\\n  const result = await api.getList({\\\\n    page: current.value,\\\\n    pageSize: pageSize.value\\\\n  })\\\\n  data.value = result.data\\\\n}\\\\n\\\\nwatch([current, pageSize], () => {\\\\n  fetchData()\\\\n})\\\\n\\\\n<Table data={data.value} />\\\\n<Pagination\\\\n  v-model={current.value}\\\\n  v-model:pageSize={pageSize.value}\\\\n  total={total}\\\\n  showTotal\\\\n  showSizeChanger\\\\n/>\\\\n```\\\\n\\\\n### 2. 列表分页\\\\n\\\\n```tsx\\\\nconst current = ref(1)\\\\nconst pageSize = ref(20)\\\\n\\\\n<List\\\\n  data={visibleData.value}\\\\n  renderItem={(item) => (\\\\n    <ListItem>{item.title}</ListItem>\\\\n  )}\\\\n/>\\\\n<Pagination\\\\n  v-model={current.value}\\\\n  total={total}\\\\n  pageSize={pageSize.value}\\\\n  simple\\\\n/>\\\\n```\\\\n\\\\n### 3. 自定义总数显示\\\\n\\\\n```tsx\\\\n<Pagination\\\\n  total={total}\\\\n  showTotal={(total, range) => `${range[0]}-${range[1]} 共 ${total} 条`}\\\\n/>\\\\n```\\\\n\\\\n## 常见问题\\\\n\\\\n### Q: 如何设置默认页码？\\\\n\\\\nA: 使用 `v-model` 绑定一个初始值。\\\\n\\\\n### Q: 如何自定义每页条数选项？\\\\n\\\\nA: 使用 `pageSizeOptions` 属性设置自定义选项。\\\\n\\\\n### Q: 如何实现服务端分页？\\\\n\\\\nA: 监听 `onChange` 和 `onPageSizeChange` 事件，从服务端获取数据。\\\\n\\\\n---\\\\n\\\\n🌹 Pagination 组件文档完成！\\\\n\",\"originAcceptText\":\"# Pagination 分页\\n\\n采用分页形式分隔长列表，每次只加载一个页面。\\n\\n## 何时使用\\n\\n- 当加载/渲染所有数据将花费很多时间时。\\n- 可切换页码改变数据展示。\\n\\n## 代码演示\\n\\n### 基础用法\\n\\n```tsx\\nimport { Pagination } from '@/components/UI'\\nimport { ref } from 'vue'\\n\\nexport default function PaginationBasic() {\\n  const current = ref(1)\\n\\n  return (\\n    <Pagination\\n      v-model={current.value}\\n      total={100}\\n      pageSize={10}\\n    />\\n  )\\n}\\n```\\n\\n### 更多功能\\n\\n```tsx\\nimport { Pagination } from '@/components/UI'\\nimport { ref } from 'vue'\\n\\nexport default function PaginationMore() {\\n  const current = ref(1)\\n  const pageSize = ref(10)\\n\\n  return (\\n    <Pagination\\n      v-model={current.value}\\n      v-model:pageSize={pageSize.value}\\n      total={100}\\n      showTotal\\n      showSizeChanger\\n      showQuickJumper\\n    />\\n  )\\n}\\n```\\n\\n### 迷你版\\n\\n```tsx\\nimport { Pagination } from '@/components/UI'\\nimport { ref } from 'vue'\\n\\nexport default function PaginationMini() {\\n  const current = ref(1)\\n\\n  return (\\n    <Pagination\\n      v-model={current.value}\\n      total={100}\\n      pageSize={10}\\n      size=\\\"sm\\\"\\n      simple\\n    />\\n  )\\n}\\n```\\n\\n### 改变每页数量\\n\\n```tsx\\nimport { Pagination } from '@/components/UI'\\nimport { ref } from 'vue'\\n\\nexport default function PaginationSizeChanger() {\\n  const current = ref(1)\\n  const pageSize = ref(10)\\n\\n  const handlePageSizeChange = (size: number) => {\\n    console.log('每页数量:', size)\\n  }\\n\\n  return (\\n    <Pagination\\n      v-model={current.value}\\n      v-model:pageSize={pageSize.value}\\n      total={100}\\n      showSizeChanger\\n      onPageSizeChange={handlePageSizeChange}\\n    />\\n  )\\n}\\n```\\n\\n### 快速跳转\\n\\n```tsx\\nimport { Pagination } from '@/components/UI'\\nimport { ref } from 'vue'\\n\\nexport default function PaginationQuickJumper() {\\n  const current = ref(1)\\n\\n  return (\\n    <Pagination\\n      v-model={current.value}\\n      total={100}\\n      pageSize={10}\\n      showQuickJumper\\n    />\\n  )\\n}\\n```\\n\\n### 显示总数\\n\\n```tsx\\nimport { Pagination } from '@/components/UI'\\nimport { ref } from 'vue'\\n\\nexport default function PaginationShowTotal() {\\n  const current = ref(1)\\n\\n  return (\\n    <Pagination\\n      v-model={current.value}\\n      total={100}\\n      pageSize={10}\\n      showTotal\\n    />\\n  )\\n}\\n```\\n\\n## API\\n\\n### Pagination Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| modelValue | 当前页数 | `number` | `1` |\\n| total | 数据总数 | `number` | `0` |\\n| pageSize | 每页条数 | `number` | `10` |\\n| disabled | 是否禁用 | `boolean` | `false` |\\n| size | 尺寸 | `string` | `sm` / `md` / `lg` | `md` |\\n| simple | 是否简洁模式 | `boolean` | `false` |\\n| showTotal | 是否显示总数 | `boolean` | `false` |\\n| showSizeChanger | 是否显示每页条数选择器 | `boolean` | `false` |\\n| showQuickJumper | 是否显示快速跳转 | `boolean` | `false` |\\n| pageSizeOptions | 每页条数选项 | `number[]` | `[10, 20, 50, 100]` |\\n| onChange | 页码变化回调 | `Function` | - |\\n| onPageSizeChange | 每页条数变化回调 | `Function` | - |\\n| className | 自定义类名 | `string` | - |\\n\\n## 样式定制\\n\\n### CSS 变量\\n\\n```css\\n.pagination {\\n  --pagination-bg: #ffffff;\\n  --pagination-border: #e5e7eb;\\n  --pagination-text: #374151;\\n  --pagination-hover-bg: #f3f4f6;\\n  --pagination-active-bg: #3b82f6;\\n  --pagination-active-text: #ffffff;\\n  --pagination-disabled-bg: #f9fafb;\\n  --pagination-disabled-text: #9ca3af;\\n}\\n```\\n\\n### 自定义样式\\n\\n```tsx\\n<Pagination className=\\\"custom-pagination\\\" total={100} />\\n\\n<style>\\n.custom-pagination .pagination-item {\\n  border-radius: 0.5rem;\\n}\\n\\n.custom-pagination .pagination-item.active {\\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\\n  border-color: #667eea;\\n}\\n</style>\\n```\\n\\n## 最佳实践\\n\\n### 1. 表格分页\\n\\n```tsx\\nconst current = ref(1)\\nconst pageSize = ref(10)\\nconst data = ref([])\\n\\nconst fetchData = async () => {\\n  const result = await api.getList({\\n    page: current.value,\\n    pageSize: pageSize.value\\n  })\\n  data.value = result.data\\n}\\n\\nwatch([current, pageSize], () => {\\n  fetchData()\\n})\\n\\n<Table data={data.value} />\\n<Pagination\\n  v-model={current.value}\\n  v-model:pageSize={pageSize.value}\\n  total={total}\\n  showTotal\\n  showSizeChanger\\n/>\\n```\\n\\n### 2. 列表分页\\n\\n```tsx\\nconst current = ref(1)\\nconst pageSize = ref(20)\\n\\n<List\\n  data={visibleData.value}\\n  renderItem={(item) => (\\n    <ListItem>{item.title}</ListItem>\\n  )}\\n/>\\n<Pagination\\n  v-model={current.value}\\n  total={total}\\n  pageSize={pageSize.value}\\n  simple\\n/>\\n```\\n\\n### 3. 自定义总数显示\\n\\n```tsx\\n<Pagination\\n  total={total}\\n  showTotal={(total, range) => `${range[0]}-${range[1]} 共 ${total} 条`}\\n/>\\n```\\n\\n## 常见问题\\n\\n### Q: 如何设置默认页码？\\n\\nA: 使用 `v-model` 绑定一个初始值。\\n\\n### Q: 如何自定义每页条数选项？\\n\\nA: 使用 `pageSizeOptions` 属性设置自定义选项。\\n\\n### Q: 如何实现服务端分页？\\n\\nA: 监听 `onChange` 和 `onPageSizeChange` 事件，从服务端获取数据。\\n\\n---\\n\\n🌹 Pagination 组件文档完成！\\n\",\"originTextLength\":4496,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768947957224}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/components/UI/docs/components/Table.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":332,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":332,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# Table 表格\\\\n\\\\n展示行列数据。\\\\n\\\\n## 何时使用\\\\n\\\\n- 当有大量结构化的数据需要展现时。\\\\n- 当需要对数据进行排序、搜索、分页、自定义操作等复杂行为时。\\\\n\\\\n## 代码演示\\\\n\\\\n### 基础用法\\\\n\\\\n```tsx\\\\nimport { Table } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function TableBasic() {\\\\n  const columns = [\\\\n    { key: \\\\'name\\\\', title: \\\\'姓名\\\\' },\\\\n    { key: \\\\'age\\\\', title: \\\\'年龄\\\\' },\\\\n    { key: \\\\'email\\\\', title: \\\\'邮箱\\\\' },\\\\n  ]\\\\n\\\\n  const data = [\\\\n    { name: \\\\'张三\\\\', age: 25, email: \\\\'zhangsan@example.com\\\\' },\\\\n    { name: \\\\'李四\\\\', age: 30, email: \\\\'lisi@example.com\\\\' },\\\\n    { name: \\\\'王五\\\\', age: 28, email: \\\\'wangwu@example.com\\\\' },\\\\n  ]\\\\n\\\\n  return (\\\\n    <Table\\\\n      columns={columns}\\\\n      data={data}\\\\n    />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 带边框\\\\n\\\\n```tsx\\\\nimport { Table } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function TableBordered() {\\\\n  const columns = [\\\\n    { key: \\\\'name\\\\', title: \\\\'姓名\\\\' },\\\\n    { key: \\\\'age\\\\', title: \\\\'年龄\\\\' },\\\\n  ]\\\\n\\\\n  const data = [\\\\n    { name: \\\\'张三\\\\', age: 25 },\\\\n    { name: \\\\'李四\\\\', age: 30 },\\\\n  ]\\\\n\\\\n  return (\\\\n    <Table\\\\n      columns={columns}\\\\n      data={data}\\\\n      bordered\\\\n    />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 斑马纹\\\\n\\\\n```tsx\\\\nimport { Table } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function TableStriped() {\\\\n  const columns = [\\\\n    { key: \\\\'name\\\\', title: \\\\'姓名\\\\' },\\\\n    { key: \\\\'age\\\\', title: \\\\'年龄\\\\' },\\\\n  ]\\\\n\\\\n  const data = [\\\\n    { name: \\\\'张三\\\\', age: 25 },\\\\n    { name: \\\\'李四\\\\', age: 30 },\\\\n  ]\\\\n\\\\n  return (\\\\n    <Table\\\\n      columns={columns}\\\\n      data={data}\\\\n      striped\\\\n    />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 悬停高亮\\\\n\\\\n```tsx\\\\nimport { Table } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function TableHoverable() {\\\\n  const columns = [\\\\n    { key: \\\\'name\\\\', title: \\\\'姓名\\\\' },\\\\n    { key: \\\\'age\\\\', title: \\\\'年龄\\\\' },\\\\n  ]\\\\n\\\\n  const data = [\\\\n    { name: \\\\'张三\\\\', age: 25 },\\\\n    { name: \\\\'李四\\\\', age: 30 },\\\\n  ]\\\\n\\\\n  return (\\\\n    <Table\\\\n      columns={columns}\\\\n      data={data}\\\\n      hoverable\\\\n    />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 紧凑模式\\\\n\\\\n```tsx\\\\nimport { Table } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function TableCompact() {\\\\n  const columns = [\\\\n    { key: \\\\'name\\\\', title: \\\\'姓名\\\\' },\\\\n    { key: \\\\'age\\\\', title: \\\\'年龄\\\\' },\\\\n  ]\\\\n\\\\n  const data = [\\\\n    { name: \\\\'张三\\\\', age: 25 },\\\\n    { name: \\\\'李四\\\\', age: 30 },\\\\n  ]\\\\n\\\\n  return (\\\\n    <Table\\\\n      columns={columns}\\\\n      data={data}\\\\n      compact\\\\n    />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 自定义列\\\\n\\\\n```tsx\\\\nimport { Table } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function TableCustomColumn() {\\\\n  const columns = [\\\\n    { \\\\n      key: \\\\'name\\\\', \\\\n      title: \\\\'姓名\\\\',\\\\n      render: (text: string, record: any) => (\\\\n        <span style={{ color: \\\\'blue\\\\' }}>{text}</span>\\\\n      )\\\\n    },\\\\n    { \\\\n      key: \\\\'age\\\\', \\\\n      title: \\\\'年龄\\\\',\\\\n      render: (text: number) => `${text}岁`\\\\n    },\\\\n  ]\\\\n\\\\n  const data = [\\\\n    { name: \\\\'张三\\\\', age: 25 },\\\\n    { name: \\\\'李四\\\\', age: 30 },\\\\n  ]\\\\n\\\\n  return (\\\\n    <Table\\\\n      columns={columns}\\\\n      data={data}\\\\n    />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 操作列\\\\n\\\\n```tsx\\\\nimport { Table } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function TableActions() {\\\\n  const columns = [\\\\n    { key: \\\\'name\\\\', title: \\\\'姓名\\\\' },\\\\n    { key: \\\\'age\\\\', title: \\\\'年龄\\\\' },\\\\n    {\\\\n      key: \\\\'actions\\\\',\\\\n      title: \\\\'操作\\\\',\\\\n      render: (_: any, record: any) => (\\\\n        <div class=\\\\\\\"space-x-2\\\\\\\">\\\\n          <Button size=\\\\\\\"sm\\\\\\\" onClick={() => handleEdit(record)}>\\\\n            编辑\\\\n          </Button>\\\\n          <Button size=\\\\\\\"sm\\\\\\\" type=\\\\\\\"danger\\\\\\\" onClick={() => handleDelete(record)}>\\\\n            删除\\\\n          </Button>\\\\n        </div>\\\\n      )\\\\n    },\\\\n  ]\\\\n\\\\n  const data = [\\\\n    { id: 1, name: \\\\'张三\\\\', age: 25 },\\\\n    { id: 2, name: \\\\'李四\\\\', age: 30 },\\\\n  ]\\\\n\\\\n  const handleEdit = (record: any) => {\\\\n    console.log(\\\\'编辑:\\\\', record)\\\\n  }\\\\n\\\\n  const handleDelete = (record: any) => {\\\\n    console.log(\\\\'删除:\\\\', record)\\\\n  }\\\\n\\\\n  return (\\\\n    <Table\\\\n      columns={columns}\\\\n      data={data}\\\\n    />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 加载状态\\\\n\\\\n```tsx\\\\nimport { Table } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function TableLoading() {\\\\n  const columns = [\\\\n    { key: \\\\'name\\\\', title: \\\\'姓名\\\\' },\\\\n    { key: \\\\'age\\\\', title: \\\\'年龄\\\\' },\\\\n  ]\\\\n\\\\n  return (\\\\n    <Table\\\\n      columns={columns}\\\\n      data={[]}\\\\n      loading\\\\n    />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 空状态\\\\n\\\\n```tsx\\\\nimport { Table } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function TableEmpty() {\\\\n  const columns = [\\\\n    { key: \\\\'name\\\\', title: \\\\'姓名\\\\' },\\\\n    { key: \\\\'age\\\\', title: \\\\'年龄\\\\' },\\\\n  ]\\\\n\\\\n  return (\\\\n    <Table\\\\n      columns={columns}\\\\n      data={[]}\\\\n    />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n## API\\\\n\\\\n### Table Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| columns | 列配置 | `Column[]` | - |\\\\n| data | 数据源 | `any[]` | - |\\\\n| bordered | 是否显示边框 | `boolean` | `false` |\\\\n| striped | 是否显示斑马纹 | `boolean` | `false` |\\\\n| hoverable | 是否悬停高亮 | `boolean` | `false` |\\\\n| compact | 是否紧凑模式 | `boolean` | `false` |\\\\n| loading | 是否加载中 | `boolean` | `false` |\\\\n| onSelect | 行选择回调 | `Function` | - |\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n### Column 类型定义\\\\n\\\\n```typescript\\\\ninterface Column {\\\\n  key: string\\\\n  title: string\\\\n  width?: number\\\\n  align?: \\\\'left\\\\' | \\\\'center\\\\' | \\\\'right\\\\'\\\\n  render?: (text: any, record: any, index: number) => VNode\\\\n}\\\\n```\\\\n\\\\n## 样式定制\\\\n\\\\n### CSS 变量\\\\n\\\\n```css\\\\n.table {\\\\n  --table-bg: #ffffff;\\\\n  --table-border: #e5e7eb;\\\\n  --table-header-bg: #f9fafb;\\\\n  --table-text: #374151;\\\\n  --table-hover-bg: #f3f4f6;\\\\n  --table-striped-bg: #f9fafb;\\\\n}\\\\n```\\\\n\\\\n### 自定义样式\\\\n\\\\n```tsx\\\\n<Table className=\\\\\\\"custom-table\\\\\\\" columns={columns} data={data} />\\\\n\\\\n<style>\\\\n.custom-table {\\\\n  border-radius: 0.5rem;\\\\n  overflow: hidden;\\\\n}\\\\n\\\\n.custom-table th {\\\\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\\\\n  color: white;\\\\n}\\\\n</style>\\\\n```\\\\n\\\\n## 最佳实践\\\\n\\\\n### 1. 分页表格\\\\n\\\\n```tsx\\\\nconst current = ref(1)\\\\nconst pageSize = ref(10)\\\\nconst data = ref([])\\\\n\\\\nconst fetchData = async () => {\\\\n  const result = await api.getList({\\\\n    page: current.value,\\\\n    pageSize: pageSize.value\\\\n  })\\\\n  data.value = result.data\\\\n}\\\\n\\\\n<Table\\\\n  columns={columns}\\\\n  data={data.value}\\\\n  loading={loading.value}\\\\n/>\\\\n<Pagination\\\\n  v-model={current.value}\\\\n  v-model:pageSize={pageSize.value}\\\\n  total={total}\\\\n  onChange={fetchData}\\\\n/>\\\\n```\\\\n\\\\n### 2. 可选表格\\\\n\\\\n```tsx\\\\nconst selectedRows = ref([])\\\\n\\\\nconst handleSelect = (record: any, selected: boolean) => {\\\\n  if (selected) {\\\\n    selectedRows.value.push(record)\\\\n  } else {\\\\n    selectedRows.value = selectedRows.value.filter(r => r.id !== record.id)\\\\n  }\\\\n}\\\\n\\\\n<Table\\\\n  columns={columns}\\\\n  data={data}\\\\n  onSelect={handleSelect}\\\\n/>\\\\n```\\\\n\\\\n### 3. 排序表格\\\\n\\\\n```tsx\\\\nconst sortField = ref(\\\\'\\\\')\\\\nconst sortOrder = ref(\\\\'asc\\\\')\\\\n\\\\nconst handleSort = (field: string) => {\\\\n  if (sortField.value === field) {\\\\n    sortOrder.value = sortOrder.value === \\\\'asc\\\\' ? \\\\'desc\\\\' : \\\\'asc\\\\'\\\\n  } else {\\\\n    sortField.value = field\\\\n    sortOrder.value = \\\\'asc\\\\'\\\\n  }\\\\n}\\\\n\\\\n<Table\\\\n  columns={columns}\\\\n  data={sortedData.value}\\\\n/>\\\\n```\\\\n\\\\n## 常见问题\\\\n\\\\n### Q: 如何自定义列的内容？\\\\n\\\\nA: 使用 `render` 函数自定义列的内容。\\\\n\\\\n### Q: 如何实现表格分页？\\\\n\\\\nA: 使用 Pagination 组件配合 Table 组件实现分页。\\\\n\\\\n### Q: 如何实现表格排序？\\\\n\\\\nA: 使用 `render` 函数和排序逻辑实现表格排序。\\\\n\\\\n---\\\\n\\\\n🌹 Table 组件文档完成！\\\\n\",\"originAcceptText\":\"# Table 表格\\n\\n展示行列数据。\\n\\n## 何时使用\\n\\n- 当有大量结构化的数据需要展现时。\\n- 当需要对数据进行排序、搜索、分页、自定义操作等复杂行为时。\\n\\n## 代码演示\\n\\n### 基础用法\\n\\n```tsx\\nimport { Table } from '@/components/UI'\\n\\nexport default function TableBasic() {\\n  const columns = [\\n    { key: 'name', title: '姓名' },\\n    { key: 'age', title: '年龄' },\\n    { key: 'email', title: '邮箱' },\\n  ]\\n\\n  const data = [\\n    { name: '张三', age: 25, email: 'zhangsan@example.com' },\\n    { name: '李四', age: 30, email: 'lisi@example.com' },\\n    { name: '王五', age: 28, email: 'wangwu@example.com' },\\n  ]\\n\\n  return (\\n    <Table\\n      columns={columns}\\n      data={data}\\n    />\\n  )\\n}\\n```\\n\\n### 带边框\\n\\n```tsx\\nimport { Table } from '@/components/UI'\\n\\nexport default function TableBordered() {\\n  const columns = [\\n    { key: 'name', title: '姓名' },\\n    { key: 'age', title: '年龄' },\\n  ]\\n\\n  const data = [\\n    { name: '张三', age: 25 },\\n    { name: '李四', age: 30 },\\n  ]\\n\\n  return (\\n    <Table\\n      columns={columns}\\n      data={data}\\n      bordered\\n    />\\n  )\\n}\\n```\\n\\n### 斑马纹\\n\\n```tsx\\nimport { Table } from '@/components/UI'\\n\\nexport default function TableStriped() {\\n  const columns = [\\n    { key: 'name', title: '姓名' },\\n    { key: 'age', title: '年龄' },\\n  ]\\n\\n  const data = [\\n    { name: '张三', age: 25 },\\n    { name: '李四', age: 30 },\\n  ]\\n\\n  return (\\n    <Table\\n      columns={columns}\\n      data={data}\\n      striped\\n    />\\n  )\\n}\\n```\\n\\n### 悬停高亮\\n\\n```tsx\\nimport { Table } from '@/components/UI'\\n\\nexport default function TableHoverable() {\\n  const columns = [\\n    { key: 'name', title: '姓名' },\\n    { key: 'age', title: '年龄' },\\n  ]\\n\\n  const data = [\\n    { name: '张三', age: 25 },\\n    { name: '李四', age: 30 },\\n  ]\\n\\n  return (\\n    <Table\\n      columns={columns}\\n      data={data}\\n      hoverable\\n    />\\n  )\\n}\\n```\\n\\n### 紧凑模式\\n\\n```tsx\\nimport { Table } from '@/components/UI'\\n\\nexport default function TableCompact() {\\n  const columns = [\\n    { key: 'name', title: '姓名' },\\n    { key: 'age', title: '年龄' },\\n  ]\\n\\n  const data = [\\n    { name: '张三', age: 25 },\\n    { name: '李四', age: 30 },\\n  ]\\n\\n  return (\\n    <Table\\n      columns={columns}\\n      data={data}\\n      compact\\n    />\\n  )\\n}\\n```\\n\\n### 自定义列\\n\\n```tsx\\nimport { Table } from '@/components/UI'\\n\\nexport default function TableCustomColumn() {\\n  const columns = [\\n    { \\n      key: 'name', \\n      title: '姓名',\\n      render: (text: string, record: any) => (\\n        <span style={{ color: 'blue' }}>{text}</span>\\n      )\\n    },\\n    { \\n      key: 'age', \\n      title: '年龄',\\n      render: (text: number) => `${text}岁`\\n    },\\n  ]\\n\\n  const data = [\\n    { name: '张三', age: 25 },\\n    { name: '李四', age: 30 },\\n  ]\\n\\n  return (\\n    <Table\\n      columns={columns}\\n      data={data}\\n    />\\n  )\\n}\\n```\\n\\n### 操作列\\n\\n```tsx\\nimport { Table } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\n\\nexport default function TableActions() {\\n  const columns = [\\n    { key: 'name', title: '姓名' },\\n    { key: 'age', title: '年龄' },\\n    {\\n      key: 'actions',\\n      title: '操作',\\n      render: (_: any, record: any) => (\\n        <div class=\\\"space-x-2\\\">\\n          <Button size=\\\"sm\\\" onClick={() => handleEdit(record)}>\\n            编辑\\n          </Button>\\n          <Button size=\\\"sm\\\" type=\\\"danger\\\" onClick={() => handleDelete(record)}>\\n            删除\\n          </Button>\\n        </div>\\n      )\\n    },\\n  ]\\n\\n  const data = [\\n    { id: 1, name: '张三', age: 25 },\\n    { id: 2, name: '李四', age: 30 },\\n  ]\\n\\n  const handleEdit = (record: any) => {\\n    console.log('编辑:', record)\\n  }\\n\\n  const handleDelete = (record: any) => {\\n    console.log('删除:', record)\\n  }\\n\\n  return (\\n    <Table\\n      columns={columns}\\n      data={data}\\n    />\\n  )\\n}\\n```\\n\\n### 加载状态\\n\\n```tsx\\nimport { Table } from '@/components/UI'\\n\\nexport default function TableLoading() {\\n  const columns = [\\n    { key: 'name', title: '姓名' },\\n    { key: 'age', title: '年龄' },\\n  ]\\n\\n  return (\\n    <Table\\n      columns={columns}\\n      data={[]}\\n      loading\\n    />\\n  )\\n}\\n```\\n\\n### 空状态\\n\\n```tsx\\nimport { Table } from '@/components/UI'\\n\\nexport default function TableEmpty() {\\n  const columns = [\\n    { key: 'name', title: '姓名' },\\n    { key: 'age', title: '年龄' },\\n  ]\\n\\n  return (\\n    <Table\\n      columns={columns}\\n      data={[]}\\n    />\\n  )\\n}\\n```\\n\\n## API\\n\\n### Table Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| columns | 列配置 | `Column[]` | - |\\n| data | 数据源 | `any[]` | - |\\n| bordered | 是否显示边框 | `boolean` | `false` |\\n| striped | 是否显示斑马纹 | `boolean` | `false` |\\n| hoverable | 是否悬停高亮 | `boolean` | `false` |\\n| compact | 是否紧凑模式 | `boolean` | `false` |\\n| loading | 是否加载中 | `boolean` | `false` |\\n| onSelect | 行选择回调 | `Function` | - |\\n| className | 自定义类名 | `string` | - |\\n\\n### Column 类型定义\\n\\n```typescript\\ninterface Column {\\n  key: string\\n  title: string\\n  width?: number\\n  align?: 'left' | 'center' | 'right'\\n  render?: (text: any, record: any, index: number) => VNode\\n}\\n```\\n\\n## 样式定制\\n\\n### CSS 变量\\n\\n```css\\n.table {\\n  --table-bg: #ffffff;\\n  --table-border: #e5e7eb;\\n  --table-header-bg: #f9fafb;\\n  --table-text: #374151;\\n  --table-hover-bg: #f3f4f6;\\n  --table-striped-bg: #f9fafb;\\n}\\n```\\n\\n### 自定义样式\\n\\n```tsx\\n<Table className=\\\"custom-table\\\" columns={columns} data={data} />\\n\\n<style>\\n.custom-table {\\n  border-radius: 0.5rem;\\n  overflow: hidden;\\n}\\n\\n.custom-table th {\\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\\n  color: white;\\n}\\n</style>\\n```\\n\\n## 最佳实践\\n\\n### 1. 分页表格\\n\\n```tsx\\nconst current = ref(1)\\nconst pageSize = ref(10)\\nconst data = ref([])\\n\\nconst fetchData = async () => {\\n  const result = await api.getList({\\n    page: current.value,\\n    pageSize: pageSize.value\\n  })\\n  data.value = result.data\\n}\\n\\n<Table\\n  columns={columns}\\n  data={data.value}\\n  loading={loading.value}\\n/>\\n<Pagination\\n  v-model={current.value}\\n  v-model:pageSize={pageSize.value}\\n  total={total}\\n  onChange={fetchData}\\n/>\\n```\\n\\n### 2. 可选表格\\n\\n```tsx\\nconst selectedRows = ref([])\\n\\nconst handleSelect = (record: any, selected: boolean) => {\\n  if (selected) {\\n    selectedRows.value.push(record)\\n  } else {\\n    selectedRows.value = selectedRows.value.filter(r => r.id !== record.id)\\n  }\\n}\\n\\n<Table\\n  columns={columns}\\n  data={data}\\n  onSelect={handleSelect}\\n/>\\n```\\n\\n### 3. 排序表格\\n\\n```tsx\\nconst sortField = ref('')\\nconst sortOrder = ref('asc')\\n\\nconst handleSort = (field: string) => {\\n  if (sortField.value === field) {\\n    sortOrder.value = sortOrder.value === 'asc' ? 'desc' : 'asc'\\n  } else {\\n    sortField.value = field\\n    sortOrder.value = 'asc'\\n  }\\n}\\n\\n<Table\\n  columns={columns}\\n  data={sortedData.value}\\n/>\\n```\\n\\n## 常见问题\\n\\n### Q: 如何自定义列的内容？\\n\\nA: 使用 `render` 函数自定义列的内容。\\n\\n### Q: 如何实现表格分页？\\n\\nA: 使用 Pagination 组件配合 Table 组件实现分页。\\n\\n### Q: 如何实现表格排序？\\n\\nA: 使用 `render` 函数和排序逻辑实现表格排序。\\n\\n---\\n\\n🌹 Table 组件文档完成！\\n\",\"originTextLength\":6530,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768947981541}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/components/UI/docs/components/List.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":331,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":331,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# List 列表\\\\n\\\\n最基础的列表展示，可承载文字、列表、图片、段落，常用于后台数据展示页面。\\\\n\\\\n## 何时使用\\\\n\\\\n- 最基础的列表展示，可承载文字、列表、图片、段落，常用于后台数据展示页面。\\\\n\\\\n## 代码演示\\\\n\\\\n### 基础用法\\\\n\\\\n```tsx\\\\nimport { List, ListItem, ListItemMeta } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function ListBasic() {\\\\n  const data = [\\\\n    { title: \\\\'项目一\\\\', description: \\\\'项目一的描述\\\\' },\\\\n    { title: \\\\'项目二\\\\', description: \\\\'项目二的描述\\\\' },\\\\n    { title: \\\\'项目三\\\\', description: \\\\'项目三的描述\\\\' },\\\\n  ]\\\\n\\\\n  return (\\\\n    <List\\\\n      data={data}\\\\n      renderItem={(item: any) => (\\\\n        <ListItem>\\\\n          <ListItemMeta title={item.title} description={item.description} />\\\\n        </ListItem>\\\\n      )}\\\\n    />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 带边框\\\\n\\\\n```tsx\\\\nimport { List, ListItem, ListItemMeta } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function ListBordered() {\\\\n  const data = [\\\\n    { title: \\\\'项目一\\\\', description: \\\\'项目一的描述\\\\' },\\\\n    { title: \\\\'项目二\\\\', description: \\\\'项目二的描述\\\\' },\\\\n  ]\\\\n\\\\n  return (\\\\n    <List\\\\n      bordered\\\\n      data={data}\\\\n      renderItem={(item: any) => (\\\\n        <ListItem>\\\\n          <ListItemMeta title={item.title} description={item.description} />\\\\n        </ListItem>\\\\n      )}\\\\n    />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 分割线\\\\n\\\\n```tsx\\\\nimport { List, ListItem, ListItemMeta } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function ListSplit() {\\\\n  const data = [\\\\n    { title: \\\\'项目一\\\\', description: \\\\'项目一的描述\\\\' },\\\\n    { title: \\\\'项目二\\\\', description: \\\\'项目二的描述\\\\' },\\\\n  ]\\\\n\\\\n  return (\\\\n    <List\\\\n      split\\\\n      data={data}\\\\n      renderItem={(item: any) => (\\\\n        <ListItem>\\\\n          <ListItemMeta title={item.title} description={item.description} />\\\\n        </ListItem>\\\\n      )}\\\\n    />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 带头像\\\\n\\\\n```tsx\\\\nimport { List, ListItem, ListItemMeta } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function ListWithAvatar() {\\\\n  const data = [\\\\n    { \\\\n      title: \\\\'张三\\\\', \\\\n      description: \\\\'前端开发工程师\\\\',\\\\n      avatar: \\\\'https://i.pravatar.cc/150?img=1\\\\'\\\\n    },\\\\n    { \\\\n      title: \\\\'李四\\\\', \\\\n      description: \\\\'后端开发工程师\\\\',\\\\n      avatar: \\\\'https://i.pravatar.cc/150?img=2\\\\'\\\\n    },\\\\n  ]\\\\n\\\\n  return (\\\\n    <List\\\\n      data={data}\\\\n      renderItem={(item: any) => (\\\\n        <ListItem>\\\\n          <ListItemMeta \\\\n            title={item.title} \\\\n            description={item.description}\\\\n            avatar={item.avatar}\\\\n          />\\\\n        </ListItem>\\\\n      )}\\\\n    />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 操作按钮\\\\n\\\\n```tsx\\\\nimport { List, ListItem, ListItemMeta } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function ListWithActions() {\\\\n  const data = [\\\\n    { title: \\\\'项目一\\\\', description: \\\\'项目一的描述\\\\' },\\\\n    { title: \\\\'项目二\\\\', description: \\\\'项目二的描述\\\\' },\\\\n  ]\\\\n\\\\n  return (\\\\n    <List\\\\n      data={data}\\\\n      renderItem={(item: any) => (\\\\n        <ListItem actions={[\\\\'编辑\\\\', \\\\'删除\\\\']}>\\\\n          <ListItemMeta title={item.title} description={item.description} />\\\\n        </ListItem>\\\\n      )}\\\\n    />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 分页列表\\\\n\\\\n```tsx\\\\nimport { List, ListItem, ListItemMeta } from \\\\'@/components/UI\\\\'\\\\nimport { Pagination } from \\\\'@/components/UI\\\\'\\\\nimport { ref } from \\\\'vue\\\\'\\\\n\\\\nexport default function ListWithPagination() {\\\\n  const current = ref(1)\\\\n  const data = Array.from({ length: 50 }, (_, i) => ({\\\\n    title: `项目 ${i + 1}`,\\\\n    description: `项目 ${i + 1} 的描述`\\\\n  }))\\\\n\\\\n  const pageSize = 10\\\\n  const startIndex = (current.value - 1) * pageSize\\\\n  const endIndex = startIndex + pageSize\\\\n  const visibleData = data.slice(startIndex, endIndex)\\\\n\\\\n  return (\\\\n    <div>\\\\n      <List\\\\n        data={visibleData}\\\\n        renderItem={(item: any) => (\\\\n          <ListItem>\\\\n            <ListItemMeta title={item.title} description={item.description} />\\\\n          </ListItem>\\\\n        )}\\\\n      />\\\\n      <Pagination\\\\n        v-model={current.value}\\\\n        total={data.length}\\\\n        pageSize={pageSize}\\\\n      />\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 加载状态\\\\n\\\\n```tsx\\\\nimport { List, ListItem, ListItemMeta } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function ListLoading() {\\\\n  return (\\\\n    <List\\\\n      loading\\\\n      data={[]}\\\\n      renderItem={() => (\\\\n        <ListItem>\\\\n          <ListItemMeta title=\\\\\\\"加载中...\\\\\\\" />\\\\n        </ListItem>\\\\n      )}\\\\n    />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 空状态\\\\n\\\\n```tsx\\\\nimport { List, ListItem, ListItemMeta } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function ListEmpty() {\\\\n  return (\\\\n    <List\\\\n      data={[]}\\\\n      renderItem={() => (\\\\n        <ListItem>\\\\n          <ListItemMeta title=\\\\\\\"暂无数据\\\\\\\" />\\\\n        </ListItem>\\\\n      )}\\\\n    />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n## API\\\\n\\\\n### List Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| data | 数据源 | `any[]` | - |\\\\n| renderItem | 自定义渲染项 | `Function` | - |\\\\n| bordered | 是否显示边框 | `boolean` | `false` |\\\\n| split | 是否显示分割线 | `boolean` | `false` |\\\\n| loading | 是否加载中 | `boolean` | `false` |\\\\n| pagination | 分页配置 | `PaginationProps` | - |\\\\n| onSelect | 选择回调 | `Function` | - |\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n### ListItem Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| actions | 操作按钮 | `string[]` | - |\\\\n| disabled | 是否禁用 | `boolean` | `false` |\\\\n| selected | 是否选中 | `boolean` | `false` |\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n### ListItemMeta Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| title | 标题 | `string` | - |\\\\n| description | 描述 | `string` | - |\\\\n| avatar | 头像 | `string` | - |\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n## 样式定制\\\\n\\\\n### CSS 变量\\\\n\\\\n```css\\\\n.list {\\\\n  --list-bg: #ffffff;\\\\n  --list-border: #e5e7eb;\\\\n  --list-hover-bg: #f3f4f6;\\\\n  --list-text: #374151;\\\\n  --list-meta-title: #111827;\\\\n  --list-meta-description: #6b7280;\\\\n}\\\\n```\\\\n\\\\n### 自定义样式\\\\n\\\\n```tsx\\\\n<List className=\\\\\\\"custom-list\\\\\\\" data={data} renderItem={renderItem} />\\\\n\\\\n<style>\\\\n.custom-list .list-item {\\\\n  border-radius: 0.5rem;\\\\n  margin-bottom: 0.5rem;\\\\n}\\\\n\\\\n.custom-list .list-item:hover {\\\\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\\\\n  color: white;\\\\n}\\\\n</style>\\\\n```\\\\n\\\\n## 最佳实践\\\\n\\\\n### 1. 用户列表\\\\n\\\\n```tsx\\\\nconst users = [\\\\n  { \\\\n    id: 1,\\\\n    name: \\\\'张三\\\\', \\\\n    description: \\\\'前端开发工程师\\\\',\\\\n    avatar: \\\\'https://i.pravatar.cc/150?img=1\\\\'\\\\n  },\\\\n  { \\\\n    id: 2,\\\\n    name: \\\\'李四\\\\', \\\\n    description: \\\\'后端开发工程师\\\\',\\\\n    avatar: \\\\'https://i.pravatar.cc/150?img=2\\\\'\\\\n  },\\\\n]\\\\n\\\\n<List\\\\n  data={users}\\\\n  renderItem={(user) => (\\\\n    <ListItem>\\\\n      <ListItemMeta \\\\n        title={user.name} \\\\n        description={user.description}\\\\n        avatar={user.avatar}\\\\n      />\\\\n    </ListItem>\\\\n  )}\\\\n/>\\\\n```\\\\n\\\\n### 2. 文章列表\\\\n\\\\n```tsx\\\\nconst articles = [\\\\n  { \\\\n    id: 1,\\\\n    title: \\\\'Vue 3 新特性介绍\\\\', \\\\n    description: \\\\'Vue 3 带来了许多新特性...\\\\',\\\\n    date: \\\\'2024-01-01\\\\'\\\\n  },\\\\n  { \\\\n    id: 2,\\\\n    title: \\\\'TypeScript 最佳实践\\\\', \\\\n    description: \\\\'TypeScript 是 JavaScript 的超集...\\\\',\\\\n    date: \\\\'2024-01-02\\\\'\\\\n  },\\\\n]\\\\n\\\\n<List\\\\n  data={articles}\\\\n  renderItem={(article) => (\\\\n    <ListItem>\\\\n      <div class=\\\\\\\"flex-1\\\\\\\">\\\\n        <h3 class=\\\\\\\"font-bold\\\\\\\">{article.title}</h3>\\\\n        <p class=\\\\\\\"text-neutral-600\\\\\\\">{article.description}</p>\\\\n        <span class=\\\\\\\"text-sm text-neutral-400\\\\\\\">{article.date}</span>\\\\n      </div>\\\\n    </ListItem>\\\\n  )}\\\\n/>\\\\n```\\\\n\\\\n### 3. 任务列表\\\\n\\\\n```tsx\\\\nconst tasks = [\\\\n  { id: 1, title: \\\\'完成文档\\\\', status: \\\\'pending\\\\' },\\\\n  { id: 2, title: \\\\'修复bug\\\\', status: \\\\'completed\\\\' },\\\\n  { id: 3, title: \\\\'代码审查\\\\', status: \\\\'in-progress\\\\' },\\\\n]\\\\n\\\\n<List\\\\n  data={tasks}\\\\n  renderItem={(task) => (\\\\n    <ListItem>\\\\n      <div class=\\\\\\\"flex items-center space-x-2\\\\\\\">\\\\n        <span class={`w-2 h-2 rounded-full ${\\\\n          task.status === \\\\'completed\\\\' ? \\\\'bg-success-500\\\\' :\\\\n          task.status === \\\\'in-progress\\\\' ? \\\\'bg-warning-500\\\\' :\\\\n          \\\\'bg-neutral-400\\\\'\\\\n        }`} />\\\\n        <span>{task.title}</span>\\\\n      </div>\\\\n    </ListItem>\\\\n  )}\\\\n/>\\\\n```\\\\n\\\\n## 常见问题\\\\n\\\\n### Q: 如何自定义列表项的内容？\\\\n\\\\nA: 使用 `renderItem` 函数自定义列表项的内容。\\\\n\\\\n### Q: 如何实现列表分页？\\\\n\\\\nA: 使用 `pagination` 属性或配合 Pagination 组件实现分页。\\\\n\\\\n### Q: 如何实现列表项的选择？\\\\n\\\\nA: 使用 `onSelect` 回调函数实现列表项的选择。\\\\n\\\\n---\\\\n\\\\n🌹 List 组件文档完成！\\\\n\",\"originAcceptText\":\"# List 列表\\n\\n最基础的列表展示，可承载文字、列表、图片、段落，常用于后台数据展示页面。\\n\\n## 何时使用\\n\\n- 最基础的列表展示，可承载文字、列表、图片、段落，常用于后台数据展示页面。\\n\\n## 代码演示\\n\\n### 基础用法\\n\\n```tsx\\nimport { List, ListItem, ListItemMeta } from '@/components/UI'\\n\\nexport default function ListBasic() {\\n  const data = [\\n    { title: '项目一', description: '项目一的描述' },\\n    { title: '项目二', description: '项目二的描述' },\\n    { title: '项目三', description: '项目三的描述' },\\n  ]\\n\\n  return (\\n    <List\\n      data={data}\\n      renderItem={(item: any) => (\\n        <ListItem>\\n          <ListItemMeta title={item.title} description={item.description} />\\n        </ListItem>\\n      )}\\n    />\\n  )\\n}\\n```\\n\\n### 带边框\\n\\n```tsx\\nimport { List, ListItem, ListItemMeta } from '@/components/UI'\\n\\nexport default function ListBordered() {\\n  const data = [\\n    { title: '项目一', description: '项目一的描述' },\\n    { title: '项目二', description: '项目二的描述' },\\n  ]\\n\\n  return (\\n    <List\\n      bordered\\n      data={data}\\n      renderItem={(item: any) => (\\n        <ListItem>\\n          <ListItemMeta title={item.title} description={item.description} />\\n        </ListItem>\\n      )}\\n    />\\n  )\\n}\\n```\\n\\n### 分割线\\n\\n```tsx\\nimport { List, ListItem, ListItemMeta } from '@/components/UI'\\n\\nexport default function ListSplit() {\\n  const data = [\\n    { title: '项目一', description: '项目一的描述' },\\n    { title: '项目二', description: '项目二的描述' },\\n  ]\\n\\n  return (\\n    <List\\n      split\\n      data={data}\\n      renderItem={(item: any) => (\\n        <ListItem>\\n          <ListItemMeta title={item.title} description={item.description} />\\n        </ListItem>\\n      )}\\n    />\\n  )\\n}\\n```\\n\\n### 带头像\\n\\n```tsx\\nimport { List, ListItem, ListItemMeta } from '@/components/UI'\\n\\nexport default function ListWithAvatar() {\\n  const data = [\\n    { \\n      title: '张三', \\n      description: '前端开发工程师',\\n      avatar: 'https://i.pravatar.cc/150?img=1'\\n    },\\n    { \\n      title: '李四', \\n      description: '后端开发工程师',\\n      avatar: 'https://i.pravatar.cc/150?img=2'\\n    },\\n  ]\\n\\n  return (\\n    <List\\n      data={data}\\n      renderItem={(item: any) => (\\n        <ListItem>\\n          <ListItemMeta \\n            title={item.title} \\n            description={item.description}\\n            avatar={item.avatar}\\n          />\\n        </ListItem>\\n      )}\\n    />\\n  )\\n}\\n```\\n\\n### 操作按钮\\n\\n```tsx\\nimport { List, ListItem, ListItemMeta } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\n\\nexport default function ListWithActions() {\\n  const data = [\\n    { title: '项目一', description: '项目一的描述' },\\n    { title: '项目二', description: '项目二的描述' },\\n  ]\\n\\n  return (\\n    <List\\n      data={data}\\n      renderItem={(item: any) => (\\n        <ListItem actions={['编辑', '删除']}>\\n          <ListItemMeta title={item.title} description={item.description} />\\n        </ListItem>\\n      )}\\n    />\\n  )\\n}\\n```\\n\\n### 分页列表\\n\\n```tsx\\nimport { List, ListItem, ListItemMeta } from '@/components/UI'\\nimport { Pagination } from '@/components/UI'\\nimport { ref } from 'vue'\\n\\nexport default function ListWithPagination() {\\n  const current = ref(1)\\n  const data = Array.from({ length: 50 }, (_, i) => ({\\n    title: `项目 ${i + 1}`,\\n    description: `项目 ${i + 1} 的描述`\\n  }))\\n\\n  const pageSize = 10\\n  const startIndex = (current.value - 1) * pageSize\\n  const endIndex = startIndex + pageSize\\n  const visibleData = data.slice(startIndex, endIndex)\\n\\n  return (\\n    <div>\\n      <List\\n        data={visibleData}\\n        renderItem={(item: any) => (\\n          <ListItem>\\n            <ListItemMeta title={item.title} description={item.description} />\\n          </ListItem>\\n        )}\\n      />\\n      <Pagination\\n        v-model={current.value}\\n        total={data.length}\\n        pageSize={pageSize}\\n      />\\n    </div>\\n  )\\n}\\n```\\n\\n### 加载状态\\n\\n```tsx\\nimport { List, ListItem, ListItemMeta } from '@/components/UI'\\n\\nexport default function ListLoading() {\\n  return (\\n    <List\\n      loading\\n      data={[]}\\n      renderItem={() => (\\n        <ListItem>\\n          <ListItemMeta title=\\\"加载中...\\\" />\\n        </ListItem>\\n      )}\\n    />\\n  )\\n}\\n```\\n\\n### 空状态\\n\\n```tsx\\nimport { List, ListItem, ListItemMeta } from '@/components/UI'\\n\\nexport default function ListEmpty() {\\n  return (\\n    <List\\n      data={[]}\\n      renderItem={() => (\\n        <ListItem>\\n          <ListItemMeta title=\\\"暂无数据\\\" />\\n        </ListItem>\\n      )}\\n    />\\n  )\\n}\\n```\\n\\n## API\\n\\n### List Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| data | 数据源 | `any[]` | - |\\n| renderItem | 自定义渲染项 | `Function` | - |\\n| bordered | 是否显示边框 | `boolean` | `false` |\\n| split | 是否显示分割线 | `boolean` | `false` |\\n| loading | 是否加载中 | `boolean` | `false` |\\n| pagination | 分页配置 | `PaginationProps` | - |\\n| onSelect | 选择回调 | `Function` | - |\\n| className | 自定义类名 | `string` | - |\\n\\n### ListItem Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| actions | 操作按钮 | `string[]` | - |\\n| disabled | 是否禁用 | `boolean` | `false` |\\n| selected | 是否选中 | `boolean` | `false` |\\n| className | 自定义类名 | `string` | - |\\n\\n### ListItemMeta Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| title | 标题 | `string` | - |\\n| description | 描述 | `string` | - |\\n| avatar | 头像 | `string` | - |\\n| className | 自定义类名 | `string` | - |\\n\\n## 样式定制\\n\\n### CSS 变量\\n\\n```css\\n.list {\\n  --list-bg: #ffffff;\\n  --list-border: #e5e7eb;\\n  --list-hover-bg: #f3f4f6;\\n  --list-text: #374151;\\n  --list-meta-title: #111827;\\n  --list-meta-description: #6b7280;\\n}\\n```\\n\\n### 自定义样式\\n\\n```tsx\\n<List className=\\\"custom-list\\\" data={data} renderItem={renderItem} />\\n\\n<style>\\n.custom-list .list-item {\\n  border-radius: 0.5rem;\\n  margin-bottom: 0.5rem;\\n}\\n\\n.custom-list .list-item:hover {\\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\\n  color: white;\\n}\\n</style>\\n```\\n\\n## 最佳实践\\n\\n### 1. 用户列表\\n\\n```tsx\\nconst users = [\\n  { \\n    id: 1,\\n    name: '张三', \\n    description: '前端开发工程师',\\n    avatar: 'https://i.pravatar.cc/150?img=1'\\n  },\\n  { \\n    id: 2,\\n    name: '李四', \\n    description: '后端开发工程师',\\n    avatar: 'https://i.pravatar.cc/150?img=2'\\n  },\\n]\\n\\n<List\\n  data={users}\\n  renderItem={(user) => (\\n    <ListItem>\\n      <ListItemMeta \\n        title={user.name} \\n        description={user.description}\\n        avatar={user.avatar}\\n      />\\n    </ListItem>\\n  )}\\n/>\\n```\\n\\n### 2. 文章列表\\n\\n```tsx\\nconst articles = [\\n  { \\n    id: 1,\\n    title: 'Vue 3 新特性介绍', \\n    description: 'Vue 3 带来了许多新特性...',\\n    date: '2024-01-01'\\n  },\\n  { \\n    id: 2,\\n    title: 'TypeScript 最佳实践', \\n    description: 'TypeScript 是 JavaScript 的超集...',\\n    date: '2024-01-02'\\n  },\\n]\\n\\n<List\\n  data={articles}\\n  renderItem={(article) => (\\n    <ListItem>\\n      <div class=\\\"flex-1\\\">\\n        <h3 class=\\\"font-bold\\\">{article.title}</h3>\\n        <p class=\\\"text-neutral-600\\\">{article.description}</p>\\n        <span class=\\\"text-sm text-neutral-400\\\">{article.date}</span>\\n      </div>\\n    </ListItem>\\n  )}\\n/>\\n```\\n\\n### 3. 任务列表\\n\\n```tsx\\nconst tasks = [\\n  { id: 1, title: '完成文档', status: 'pending' },\\n  { id: 2, title: '修复bug', status: 'completed' },\\n  { id: 3, title: '代码审查', status: 'in-progress' },\\n]\\n\\n<List\\n  data={tasks}\\n  renderItem={(task) => (\\n    <ListItem>\\n      <div class=\\\"flex items-center space-x-2\\\">\\n        <span class={`w-2 h-2 rounded-full ${\\n          task.status === 'completed' ? 'bg-success-500' :\\n          task.status === 'in-progress' ? 'bg-warning-500' :\\n          'bg-neutral-400'\\n        }`} />\\n        <span>{task.title}</span>\\n      </div>\\n    </ListItem>\\n  )}\\n/>\\n```\\n\\n## 常见问题\\n\\n### Q: 如何自定义列表项的内容？\\n\\nA: 使用 `renderItem` 函数自定义列表项的内容。\\n\\n### Q: 如何实现列表分页？\\n\\nA: 使用 `pagination` 属性或配合 Pagination 组件实现分页。\\n\\n### Q: 如何实现列表项的选择？\\n\\nA: 使用 `onSelect` 回调函数实现列表项的选择。\\n\\n---\\n\\n🌹 List 组件文档完成！\\n\",\"originTextLength\":7406,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768948008158}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/components/UI/docs/components/Tree.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":394,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":394,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# Tree 树形控件\\\\n\\\\n树形控件。\\\\n\\\\n## 何时使用\\\\n\\\\n- 文件夹、组织架构、生物分类、国家地区等等，世间万物的大多数结构都是树形结构。使用 `Tree` 控件可以完整展现其中的层级关系，并具有展开收起选择等交互功能。\\\\n\\\\n## 代码演示\\\\n\\\\n### 基础用法\\\\n\\\\n```tsx\\\\nimport { Tree, TreeNode } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function TreeBasic() {\\\\n  const treeData = [\\\\n    {\\\\n      key: \\\\'1\\\\',\\\\n      title: \\\\'节点一\\\\',\\\\n      children: [\\\\n        { key: \\\\'1-1\\\\', title: \\\\'子节点一\\\\' },\\\\n        { key: \\\\'1-2\\\\', title: \\\\'子节点二\\\\' },\\\\n      ]\\\\n    },\\\\n    {\\\\n      key: \\\\'2\\\\',\\\\n      title: \\\\'节点二\\\\',\\\\n      children: [\\\\n        { key: \\\\'2-1\\\\', title: \\\\'子节点三\\\\' },\\\\n        { key: \\\\'2-2\\\\', title: \\\\'子节点四\\\\' },\\\\n      ]\\\\n    },\\\\n  ]\\\\n\\\\n  return (\\\\n    <Tree data={treeData} />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 可选择\\\\n\\\\n```tsx\\\\nimport { Tree } from \\\\'@/components/UI\\\\'\\\\nimport { ref } from \\\\'vue\\\\'\\\\n\\\\nexport default function TreeSelectable() {\\\\n  const selectedKeys = ref([\\\\'1-1\\\\'])\\\\n  \\\\n  const treeData = [\\\\n    {\\\\n      key: \\\\'1\\\\',\\\\n      title: \\\\'节点一\\\\',\\\\n      children: [\\\\n        { key: \\\\'1-1\\\\', title: \\\\'子节点一\\\\' },\\\\n        { key: \\\\'1-2\\\\', title: \\\\'子节点二\\\\' },\\\\n      ]\\\\n    },\\\\n    {\\\\n      key: \\\\'2\\\\',\\\\n      title: \\\\'节点二\\\\',\\\\n      children: [\\\\n        { key: \\\\'2-1\\\\', title: \\\\'子节点三\\\\' },\\\\n        { key: \\\\'2-2\\\\', title: \\\\'子节点四\\\\' },\\\\n      ]\\\\n    },\\\\n  ]\\\\n\\\\n  const handleSelect = (keys: string[]) => {\\\\n    selectedKeys.value = keys\\\\n  }\\\\n\\\\n  return (\\\\n    <Tree\\\\n      data={treeData}\\\\n      selectedKeys={selectedKeys.value}\\\\n      onSelect={handleSelect}\\\\n    />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 可勾选\\\\n\\\\n```tsx\\\\nimport { Tree } from \\\\'@/components/UI\\\\'\\\\nimport { ref } from \\\\'vue\\\\'\\\\n\\\\nexport default function TreeCheckable() {\\\\n  const checkedKeys = ref([\\\\'1-1\\\\'])\\\\n  \\\\n  const treeData = [\\\\n    {\\\\n      key: \\\\'1\\\\',\\\\n      title: \\\\'节点一\\\\',\\\\n      children: [\\\\n        { key: \\\\'1-1\\\\', title: \\\\'子节点一\\\\' },\\\\n        { key: \\\\'1-2\\\\', title: \\\\'子节点二\\\\' },\\\\n      ]\\\\n    },\\\\n    {\\\\n      key: \\\\'2\\\\',\\\\n      title: \\\\'节点二\\\\',\\\\n      children: [\\\\n        { key: \\\\'2-1\\\\', title: \\\\'子节点三\\\\' },\\\\n        { key: \\\\'2-2\\\\', title: \\\\'子节点四\\\\' },\\\\n      ]\\\\n    },\\\\n  ]\\\\n\\\\n  const handleCheck = (keys: string[]) => {\\\\n    checkedKeys.value = keys\\\\n  }\\\\n\\\\n  return (\\\\n    <Tree\\\\n      data={treeData}\\\\n      checkable\\\\n      checkedKeys={checkedKeys.value}\\\\n      onCheck={handleCheck}\\\\n    />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 可展开\\\\n\\\\n```tsx\\\\nimport { Tree } from \\\\'@/components/UI\\\\'\\\\nimport { ref } from \\\\'vue\\\\'\\\\n\\\\nexport default function TreeExpandable() {\\\\n  const expandedKeys = ref([\\\\'1\\\\'])\\\\n  \\\\n  const treeData = [\\\\n    {\\\\n      key: \\\\'1\\\\',\\\\n      title: \\\\'节点一\\\\',\\\\n      children: [\\\\n        { key: \\\\'1-1\\\\', title: \\\\'子节点一\\\\' },\\\\n        { key: \\\\'1-2\\\\', title: \\\\'子节点二\\\\' },\\\\n      ]\\\\n    },\\\\n    {\\\\n      key: \\\\'2\\\\',\\\\n      title: \\\\'节点二\\\\',\\\\n      children: [\\\\n        { key: \\\\'2-1\\\\', title: \\\\'子节点三\\\\' },\\\\n        { key: \\\\'2-2\\\\', title: \\\\'子节点四\\\\' },\\\\n      ]\\\\n    },\\\\n  ]\\\\n\\\\n  const handleExpand = (keys: string[]) => {\\\\n    expandedKeys.value = keys\\\\n  }\\\\n\\\\n  return (\\\\n    <Tree\\\\n      data={treeData}\\\\n      expandedKeys={expandedKeys.value}\\\\n      onExpand={handleExpand}\\\\n    />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 禁用节点\\\\n\\\\n```tsx\\\\nimport { Tree } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function TreeDisabled() {\\\\n  const treeData = [\\\\n    {\\\\n      key: \\\\'1\\\\',\\\\n      title: \\\\'节点一\\\\',\\\\n      children: [\\\\n        { key: \\\\'1-1\\\\', title: \\\\'子节点一\\\\', disabled: true },\\\\n        { key: \\\\'1-2\\\\', title: \\\\'子节点二\\\\' },\\\\n      ]\\\\n    },\\\\n    {\\\\n      key: \\\\'2\\\\',\\\\n      title: \\\\'节点二\\\\',\\\\n      disabled: true,\\\\n      children: [\\\\n        { key: \\\\'2-1\\\\', title: \\\\'子节点三\\\\' },\\\\n        { key: \\\\'2-2\\\\', title: \\\\'子节点四\\\\' },\\\\n      ]\\\\n    },\\\\n  ]\\\\n\\\\n  return (\\\\n    <Tree data={treeData} />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 带图标\\\\n\\\\n```tsx\\\\nimport { Tree } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function TreeWithIcon() {\\\\n  const treeData = [\\\\n    {\\\\n      key: \\\\'1\\\\',\\\\n      title: \\\\'📁 文件夹一\\\\',\\\\n      children: [\\\\n        { key: \\\\'1-1\\\\', title: \\\\'📄 文件一\\\\' },\\\\n        { key: \\\\'1-2\\\\', title: \\\\'📄 文件二\\\\' },\\\\n      ]\\\\n    },\\\\n    {\\\\n      key: \\\\'2\\\\',\\\\n      title: \\\\'📁 文件夹二\\\\',\\\\n      children: [\\\\n        { key: \\\\'2-1\\\\', title: \\\\'📄 文件三\\\\' },\\\\n        { key: \\\\'2-2\\\\', title: \\\\'📄 文件四\\\\' },\\\\n      ]\\\\n    },\\\\n  ]\\\\n\\\\n  return (\\\\n    <Tree\\\\n      data={treeData}\\\\n      showIcon\\\\n    />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 可拖拽\\\\n\\\\n```tsx\\\\nimport { Tree } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function TreeDraggable() {\\\\n  const treeData = [\\\\n    {\\\\n      key: \\\\'1\\\\',\\\\n      title: \\\\'节点一\\\\',\\\\n      children: [\\\\n        { key: \\\\'1-1\\\\', title: \\\\'子节点一\\\\' },\\\\n        { key: \\\\'1-2\\\\', title: \\\\'子节点二\\\\' },\\\\n      ]\\\\n    },\\\\n    {\\\\n      key: \\\\'2\\\\',\\\\n      title: \\\\'节点二\\\\',\\\\n      children: [\\\\n        { key: \\\\'2-1\\\\', title: \\\\'子节点三\\\\' },\\\\n        { key: \\\\'2-2\\\\', title: \\\\'子节点四\\\\' },\\\\n      ]\\\\n    },\\\\n  ]\\\\n\\\\n  return (\\\\n    <Tree\\\\n      data={treeData}\\\\n      draggable\\\\n    />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n## API\\\\n\\\\n### Tree Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| data | 树形数据 | `TreeNode[]` | - |\\\\n| selectedKeys | 选中的节点 | `string[]` | - |\\\\n| checkedKeys | 勾选的节点 | `string[]` | - |\\\\n| expandedKeys | 展开的节点 | `string[]` | - |\\\\n| checkable | 是否可勾选 | `boolean` | `false` |\\\\n| draggable | 是否可拖拽 | `boolean` | `false` |\\\\n| disabled | 是否禁用 | `boolean` | `false` |\\\\n| showIcon | 是否显示图标 | `boolean` | `false` |\\\\n| showLine | 是否显示连线 | `boolean` | `false` |\\\\n| onSelect | 选择回调 | `Function` | - |\\\\n| onCheck | 勾选回调 | `Function` | - |\\\\n| onExpand | 展开回调 | `Function` | - |\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n### TreeNode 类型定义\\\\n\\\\n```typescript\\\\ninterface TreeNode {\\\\n  key: string\\\\n  title: string | VNode\\\\n  children?: TreeNode[]\\\\n  disabled?: boolean\\\\n  selectable?: boolean\\\\n  checkable?: boolean\\\\n}\\\\n```\\\\n\\\\n## 样式定制\\\\n\\\\n### CSS 变量\\\\n\\\\n```css\\\\n.tree {\\\\n  --tree-bg: #ffffff;\\\\n  --tree-text: #374151;\\\\n  --tree-hover-bg: #f3f4f6;\\\\n  --tree-selected-bg: #eff6ff;\\\\n  --tree-selected-text: #3b82f6;\\\\n  --tree-disabled-text: #9ca3af;\\\\n}\\\\n```\\\\n\\\\n### 自定义样式\\\\n\\\\n```tsx\\\\n<Tree className=\\\\\\\"custom-tree\\\\\\\" data={treeData} />\\\\n\\\\n<style>\\\\n.custom-tree .tree-node {\\\\n  padding: 0.5rem 1rem;\\\\n  border-radius: 0.25rem;\\\\n}\\\\n\\\\n.custom-tree .tree-node:hover {\\\\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\\\\n  color: white;\\\\n}\\\\n</style>\\\\n```\\\\n\\\\n## 最佳实践\\\\n\\\\n### 1. 文件树\\\\n\\\\n```tsx\\\\nconst fileTree = [\\\\n  {\\\\n    key: \\\\'src\\\\',\\\\n    title: \\\\'📁 src\\\\',\\\\n    children: [\\\\n      {\\\\n        key: \\\\'components\\\\',\\\\n        title: \\\\'📁 components\\\\',\\\\n        children: [\\\\n          { key: \\\\'Button.tsx\\\\', title: \\\\'📄 Button.tsx\\\\' },\\\\n          { key: \\\\'Input.tsx\\\\', title: \\\\'📄 Input.tsx\\\\' },\\\\n        ]\\\\n      },\\\\n      {\\\\n        key: \\\\'pages\\\\',\\\\n        title: \\\\'📁 pages\\\\',\\\\n        children: [\\\\n          { key: \\\\'Home.tsx\\\\', title: \\\\'📄 Home.tsx\\\\' },\\\\n          { key: \\\\'About.tsx\\\\', title: \\\\'📄 About.tsx\\\\' },\\\\n        ]\\\\n      },\\\\n    ]\\\\n  }\\\\n]\\\\n\\\\n<Tree\\\\n  data={fileTree}\\\\n  showIcon\\\\n  showLine\\\\n/>\\\\n```\\\\n\\\\n### 2. 组织架构\\\\n\\\\n```tsx\\\\nconst organization = [\\\\n  {\\\\n    key: \\\\'company\\\\',\\\\n    title: \\\\'公司\\\\',\\\\n    children: [\\\\n      {\\\\n        key: \\\\'tech\\\\',\\\\n        title: \\\\'技术部\\\\',\\\\n        children: [\\\\n          { key: \\\\'frontend\\\\', title: \\\\'前端组\\\\' },\\\\n          { key: \\\\'backend\\\\', title: \\\\'后端组\\\\' },\\\\n        ]\\\\n      },\\\\n      {\\\\n        key: \\\\'product\\\\',\\\\n        title: \\\\'产品部\\\\',\\\\n        children: [\\\\n          { key: \\\\'design\\\\', title: \\\\'设计组\\\\' },\\\\n          { key: \\\\'pm\\\\', title: \\\\'产品组\\\\' },\\\\n        ]\\\\n      },\\\\n    ]\\\\n  }\\\\n]\\\\n\\\\n<Tree\\\\n  data={organization}\\\\n  checkable\\\\n  showLine\\\\n/>\\\\n```\\\\n\\\\n### 3. 权限管理\\\\n\\\\n```tsx\\\\nconst permissions = [\\\\n  {\\\\n    key: \\\\'system\\\\',\\\\n    title: \\\\'系统管理\\\\',\\\\n    children: [\\\\n      {\\\\n        key: \\\\'user\\\\',\\\\n        title: \\\\'用户管理\\\\',\\\\n        children: [\\\\n          { key: \\\\'user-view\\\\', title: \\\\'查看用户\\\\' },\\\\n          { key: \\\\'user-add\\\\', title: \\\\'添加用户\\\\' },\\\\n          { key: \\\\'user-edit\\\\', title: \\\\'编辑用户\\\\' },\\\\n          { key: \\\\'user-delete\\\\', title: \\\\'删除用户\\\\' },\\\\n        ]\\\\n      },\\\\n      {\\\\n        key: \\\\'role\\\\',\\\\n        title: \\\\'角色管理\\\\',\\\\n        children: [\\\\n          { key: \\\\'role-view\\\\', title: \\\\'查看角色\\\\' },\\\\n          { key: \\\\'role-add\\\\', title: \\\\'添加角色\\\\' },\\\\n        ]\\\\n      },\\\\n    ]\\\\n  }\\\\n]\\\\n\\\\n<Tree\\\\n  data={permissions}\\\\n  checkable\\\\n  defaultCheckedKeys={[\\\\'user-view\\\\', \\\\'role-view\\\\']}\\\\n/>\\\\n```\\\\n\\\\n## 常见问题\\\\n\\\\n### Q: 如何实现节点选择？\\\\n\\\\nA: 使用 `selectedKeys` 和 `onSelect` 实现节点选择。\\\\n\\\\n### Q: 如何实现节点勾选？\\\\n\\\\nA: 使用 `checkable`、`checkedKeys` 和 `onCheck` 实现节点勾选。\\\\n\\\\n### Q: 如何实现节点展开？\\\\n\\\\nA: 使用 `expandedKeys` 和 `onExpand` 实现节点展开。\\\\n\\\\n---\\\\n\\\\n🌹 Tree 组件文档完成！\\\\n\",\"originAcceptText\":\"# Tree 树形控件\\n\\n树形控件。\\n\\n## 何时使用\\n\\n- 文件夹、组织架构、生物分类、国家地区等等，世间万物的大多数结构都是树形结构。使用 `Tree` 控件可以完整展现其中的层级关系，并具有展开收起选择等交互功能。\\n\\n## 代码演示\\n\\n### 基础用法\\n\\n```tsx\\nimport { Tree, TreeNode } from '@/components/UI'\\n\\nexport default function TreeBasic() {\\n  const treeData = [\\n    {\\n      key: '1',\\n      title: '节点一',\\n      children: [\\n        { key: '1-1', title: '子节点一' },\\n        { key: '1-2', title: '子节点二' },\\n      ]\\n    },\\n    {\\n      key: '2',\\n      title: '节点二',\\n      children: [\\n        { key: '2-1', title: '子节点三' },\\n        { key: '2-2', title: '子节点四' },\\n      ]\\n    },\\n  ]\\n\\n  return (\\n    <Tree data={treeData} />\\n  )\\n}\\n```\\n\\n### 可选择\\n\\n```tsx\\nimport { Tree } from '@/components/UI'\\nimport { ref } from 'vue'\\n\\nexport default function TreeSelectable() {\\n  const selectedKeys = ref(['1-1'])\\n  \\n  const treeData = [\\n    {\\n      key: '1',\\n      title: '节点一',\\n      children: [\\n        { key: '1-1', title: '子节点一' },\\n        { key: '1-2', title: '子节点二' },\\n      ]\\n    },\\n    {\\n      key: '2',\\n      title: '节点二',\\n      children: [\\n        { key: '2-1', title: '子节点三' },\\n        { key: '2-2', title: '子节点四' },\\n      ]\\n    },\\n  ]\\n\\n  const handleSelect = (keys: string[]) => {\\n    selectedKeys.value = keys\\n  }\\n\\n  return (\\n    <Tree\\n      data={treeData}\\n      selectedKeys={selectedKeys.value}\\n      onSelect={handleSelect}\\n    />\\n  )\\n}\\n```\\n\\n### 可勾选\\n\\n```tsx\\nimport { Tree } from '@/components/UI'\\nimport { ref } from 'vue'\\n\\nexport default function TreeCheckable() {\\n  const checkedKeys = ref(['1-1'])\\n  \\n  const treeData = [\\n    {\\n      key: '1',\\n      title: '节点一',\\n      children: [\\n        { key: '1-1', title: '子节点一' },\\n        { key: '1-2', title: '子节点二' },\\n      ]\\n    },\\n    {\\n      key: '2',\\n      title: '节点二',\\n      children: [\\n        { key: '2-1', title: '子节点三' },\\n        { key: '2-2', title: '子节点四' },\\n      ]\\n    },\\n  ]\\n\\n  const handleCheck = (keys: string[]) => {\\n    checkedKeys.value = keys\\n  }\\n\\n  return (\\n    <Tree\\n      data={treeData}\\n      checkable\\n      checkedKeys={checkedKeys.value}\\n      onCheck={handleCheck}\\n    />\\n  )\\n}\\n```\\n\\n### 可展开\\n\\n```tsx\\nimport { Tree } from '@/components/UI'\\nimport { ref } from 'vue'\\n\\nexport default function TreeExpandable() {\\n  const expandedKeys = ref(['1'])\\n  \\n  const treeData = [\\n    {\\n      key: '1',\\n      title: '节点一',\\n      children: [\\n        { key: '1-1', title: '子节点一' },\\n        { key: '1-2', title: '子节点二' },\\n      ]\\n    },\\n    {\\n      key: '2',\\n      title: '节点二',\\n      children: [\\n        { key: '2-1', title: '子节点三' },\\n        { key: '2-2', title: '子节点四' },\\n      ]\\n    },\\n  ]\\n\\n  const handleExpand = (keys: string[]) => {\\n    expandedKeys.value = keys\\n  }\\n\\n  return (\\n    <Tree\\n      data={treeData}\\n      expandedKeys={expandedKeys.value}\\n      onExpand={handleExpand}\\n    />\\n  )\\n}\\n```\\n\\n### 禁用节点\\n\\n```tsx\\nimport { Tree } from '@/components/UI'\\n\\nexport default function TreeDisabled() {\\n  const treeData = [\\n    {\\n      key: '1',\\n      title: '节点一',\\n      children: [\\n        { key: '1-1', title: '子节点一', disabled: true },\\n        { key: '1-2', title: '子节点二' },\\n      ]\\n    },\\n    {\\n      key: '2',\\n      title: '节点二',\\n      disabled: true,\\n      children: [\\n        { key: '2-1', title: '子节点三' },\\n        { key: '2-2', title: '子节点四' },\\n      ]\\n    },\\n  ]\\n\\n  return (\\n    <Tree data={treeData} />\\n  )\\n}\\n```\\n\\n### 带图标\\n\\n```tsx\\nimport { Tree } from '@/components/UI'\\n\\nexport default function TreeWithIcon() {\\n  const treeData = [\\n    {\\n      key: '1',\\n      title: '📁 文件夹一',\\n      children: [\\n        { key: '1-1', title: '📄 文件一' },\\n        { key: '1-2', title: '📄 文件二' },\\n      ]\\n    },\\n    {\\n      key: '2',\\n      title: '📁 文件夹二',\\n      children: [\\n        { key: '2-1', title: '📄 文件三' },\\n        { key: '2-2', title: '📄 文件四' },\\n      ]\\n    },\\n  ]\\n\\n  return (\\n    <Tree\\n      data={treeData}\\n      showIcon\\n    />\\n  )\\n}\\n```\\n\\n### 可拖拽\\n\\n```tsx\\nimport { Tree } from '@/components/UI'\\n\\nexport default function TreeDraggable() {\\n  const treeData = [\\n    {\\n      key: '1',\\n      title: '节点一',\\n      children: [\\n        { key: '1-1', title: '子节点一' },\\n        { key: '1-2', title: '子节点二' },\\n      ]\\n    },\\n    {\\n      key: '2',\\n      title: '节点二',\\n      children: [\\n        { key: '2-1', title: '子节点三' },\\n        { key: '2-2', title: '子节点四' },\\n      ]\\n    },\\n  ]\\n\\n  return (\\n    <Tree\\n      data={treeData}\\n      draggable\\n    />\\n  )\\n}\\n```\\n\\n## API\\n\\n### Tree Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| data | 树形数据 | `TreeNode[]` | - |\\n| selectedKeys | 选中的节点 | `string[]` | - |\\n| checkedKeys | 勾选的节点 | `string[]` | - |\\n| expandedKeys | 展开的节点 | `string[]` | - |\\n| checkable | 是否可勾选 | `boolean` | `false` |\\n| draggable | 是否可拖拽 | `boolean` | `false` |\\n| disabled | 是否禁用 | `boolean` | `false` |\\n| showIcon | 是否显示图标 | `boolean` | `false` |\\n| showLine | 是否显示连线 | `boolean` | `false` |\\n| onSelect | 选择回调 | `Function` | - |\\n| onCheck | 勾选回调 | `Function` | - |\\n| onExpand | 展开回调 | `Function` | - |\\n| className | 自定义类名 | `string` | - |\\n\\n### TreeNode 类型定义\\n\\n```typescript\\ninterface TreeNode {\\n  key: string\\n  title: string | VNode\\n  children?: TreeNode[]\\n  disabled?: boolean\\n  selectable?: boolean\\n  checkable?: boolean\\n}\\n```\\n\\n## 样式定制\\n\\n### CSS 变量\\n\\n```css\\n.tree {\\n  --tree-bg: #ffffff;\\n  --tree-text: #374151;\\n  --tree-hover-bg: #f3f4f6;\\n  --tree-selected-bg: #eff6ff;\\n  --tree-selected-text: #3b82f6;\\n  --tree-disabled-text: #9ca3af;\\n}\\n```\\n\\n### 自定义样式\\n\\n```tsx\\n<Tree className=\\\"custom-tree\\\" data={treeData} />\\n\\n<style>\\n.custom-tree .tree-node {\\n  padding: 0.5rem 1rem;\\n  border-radius: 0.25rem;\\n}\\n\\n.custom-tree .tree-node:hover {\\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\\n  color: white;\\n}\\n</style>\\n```\\n\\n## 最佳实践\\n\\n### 1. 文件树\\n\\n```tsx\\nconst fileTree = [\\n  {\\n    key: 'src',\\n    title: '📁 src',\\n    children: [\\n      {\\n        key: 'components',\\n        title: '📁 components',\\n        children: [\\n          { key: 'Button.tsx', title: '📄 Button.tsx' },\\n          { key: 'Input.tsx', title: '📄 Input.tsx' },\\n        ]\\n      },\\n      {\\n        key: 'pages',\\n        title: '📁 pages',\\n        children: [\\n          { key: 'Home.tsx', title: '📄 Home.tsx' },\\n          { key: 'About.tsx', title: '📄 About.tsx' },\\n        ]\\n      },\\n    ]\\n  }\\n]\\n\\n<Tree\\n  data={fileTree}\\n  showIcon\\n  showLine\\n/>\\n```\\n\\n### 2. 组织架构\\n\\n```tsx\\nconst organization = [\\n  {\\n    key: 'company',\\n    title: '公司',\\n    children: [\\n      {\\n        key: 'tech',\\n        title: '技术部',\\n        children: [\\n          { key: 'frontend', title: '前端组' },\\n          { key: 'backend', title: '后端组' },\\n        ]\\n      },\\n      {\\n        key: 'product',\\n        title: '产品部',\\n        children: [\\n          { key: 'design', title: '设计组' },\\n          { key: 'pm', title: '产品组' },\\n        ]\\n      },\\n    ]\\n  }\\n]\\n\\n<Tree\\n  data={organization}\\n  checkable\\n  showLine\\n/>\\n```\\n\\n### 3. 权限管理\\n\\n```tsx\\nconst permissions = [\\n  {\\n    key: 'system',\\n    title: '系统管理',\\n    children: [\\n      {\\n        key: 'user',\\n        title: '用户管理',\\n        children: [\\n          { key: 'user-view', title: '查看用户' },\\n          { key: 'user-add', title: '添加用户' },\\n          { key: 'user-edit', title: '编辑用户' },\\n          { key: 'user-delete', title: '删除用户' },\\n        ]\\n      },\\n      {\\n        key: 'role',\\n        title: '角色管理',\\n        children: [\\n          { key: 'role-view', title: '查看角色' },\\n          { key: 'role-add', title: '添加角色' },\\n        ]\\n      },\\n    ]\\n  }\\n]\\n\\n<Tree\\n  data={permissions}\\n  checkable\\n  defaultCheckedKeys={['user-view', 'role-view']}\\n/>\\n```\\n\\n## 常见问题\\n\\n### Q: 如何实现节点选择？\\n\\nA: 使用 `selectedKeys` 和 `onSelect` 实现节点选择。\\n\\n### Q: 如何实现节点勾选？\\n\\nA: 使用 `checkable`、`checkedKeys` 和 `onCheck` 实现节点勾选。\\n\\n### Q: 如何实现节点展开？\\n\\nA: 使用 `expandedKeys` 和 `onExpand` 实现节点展开。\\n\\n---\\n\\n🌹 Tree 组件文档完成！\\n\",\"originTextLength\":7591,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768948051877}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/components/UI/docs/components/Timeline.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":323,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":323,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# Timeline 时间轴\\\\n\\\\n垂直展示的时间流信息。\\\\n\\\\n## 何时使用\\\\n\\\\n- 当有一系列信息需按时间排列时，可正序和倒序。\\\\n- 需要有一条时间轴进行视觉上的串联时。\\\\n\\\\n## 代码演示\\\\n\\\\n### 基础用法\\\\n\\\\n```tsx\\\\nimport { Timeline, TimelineItem } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function TimelineBasic() {\\\\n  return (\\\\n    <Timeline>\\\\n      <TimelineItem>创建服务</TimelineItem>\\\\n      <TimelineItem>完成初步设计</TimelineItem>\\\\n      <TimelineItem>技术评审</TimelineItem>\\\\n      <TimelineItem>开发完成</TimelineItem>\\\\n      <TimelineItem>测试通过</TimelineItem>\\\\n    </Timeline>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 带时间\\\\n\\\\n```tsx\\\\nimport { Timeline, TimelineItem } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function TimelineWithTime() {\\\\n  return (\\\\n    <Timeline>\\\\n      <TimelineItem time=\\\\\\\"2024-01-01\\\\\\\">创建服务</TimelineItem>\\\\n      <TimelineItem time=\\\\\\\"2024-01-15\\\\\\\">完成初步设计</TimelineItem>\\\\n      <TimelineItem time=\\\\\\\"2024-02-01\\\\\\\">技术评审</TimelineItem>\\\\n      <TimelineItem time=\\\\\\\"2024-03-01\\\\\\\">开发完成</TimelineItem>\\\\n      <TimelineItem time=\\\\\\\"2024-03-15\\\\\\\">测试通过</TimelineItem>\\\\n    </Timeline>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 颜色标记\\\\n\\\\n```tsx\\\\nimport { Timeline, TimelineItem } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function TimelineColor() {\\\\n  return (\\\\n    <Timeline>\\\\n      <TimelineItem color=\\\\\\\"primary\\\\\\\">创建服务</TimelineItem>\\\\n      <TimelineItem color=\\\\\\\"success\\\\\\\">完成初步设计</TimelineItem>\\\\n      <TimelineItem color=\\\\\\\"warning\\\\\\\">技术评审</TimelineItem>\\\\n      <TimelineItem color=\\\\\\\"danger\\\\\\\">开发完成</TimelineItem>\\\\n      <TimelineItem color=\\\\\\\"success\\\\\\\">测试通过</TimelineItem>\\\\n    </Timeline>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 带图标\\\\n\\\\n```tsx\\\\nimport { Timeline, TimelineItem } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function TimelineWithIcon() {\\\\n  return (\\\\n    <Timeline>\\\\n      <TimelineItem dot=\\\\\\\"📝\\\\\\\">创建服务</TimelineItem>\\\\n      <TimelineItem dot=\\\\\\\"✏️\\\\\\\">完成初步设计</TimelineItem>\\\\n      <TimelineItem dot=\\\\\\\"🔍\\\\\\\">技术评审</TimelineItem>\\\\n      <TimelineItem dot=\\\\\\\"💻\\\\\\\">开发完成</TimelineItem>\\\\n      <TimelineItem dot=\\\\\\\"✅\\\\\\\">测试通过</TimelineItem>\\\\n    </Timeline>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 禁用状态\\\\n\\\\n```tsx\\\\nimport { Timeline, TimelineItem } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function TimelineDisabled() {\\\\n  return (\\\\n    <Timeline>\\\\n      <TimelineItem>创建服务</TimelineItem>\\\\n      <TimelineItem>完成初步设计</TimelineItem>\\\\n      <TimelineItem disabled>技术评审</TimelineItem>\\\\n      <TimelineItem disabled>开发完成</TimelineItem>\\\\n      <TimelineItem disabled>测试通过</TimelineItem>\\\\n    </Timeline>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 交替排列\\\\n\\\\n```tsx\\\\nimport { Timeline, TimelineItem } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function TimelineAlternate() {\\\\n  return (\\\\n    <Timeline position=\\\\\\\"alternate\\\\\\\">\\\\n      <TimelineItem>创建服务</TimelineItem>\\\\n      <TimelineItem>完成初步设计</TimelineItem>\\\\n      <TimelineItem>技术评审</TimelineItem>\\\\n      <TimelineItem>开发完成</TimelineItem>\\\\n      <TimelineItem>测试通过</TimelineItem>\\\\n    </Timeline>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 右侧排列\\\\n\\\\n```tsx\\\\nimport { Timeline, TimelineItem } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function TimelineRight() {\\\\n  return (\\\\n    <Timeline position=\\\\\\\"right\\\\\\\">\\\\n      <TimelineItem>创建服务</TimelineItem>\\\\n      <TimelineItem>完成初步设计</TimelineItem>\\\\n      <TimelineItem>技术评审</TimelineItem>\\\\n      <TimelineItem>开发完成</TimelineItem>\\\\n      <TimelineItem>测试通过</TimelineItem>\\\\n    </Timeline>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 反向时间轴\\\\n\\\\n```tsx\\\\nimport { Timeline, TimelineItem } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function TimelineReverse() {\\\\n  return (\\\\n    <Timeline reverse>\\\\n      <TimelineItem>测试通过</TimelineItem>\\\\n      <TimelineItem>开发完成</TimelineItem>\\\\n      <TimelineItem>技术评审</TimelineItem>\\\\n      <TimelineItem>完成初步设计</TimelineItem>\\\\n      <TimelineItem>创建服务</TimelineItem>\\\\n    </Timeline>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 自定义颜色\\\\n\\\\n```tsx\\\\nimport { Timeline, TimelineItem } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function TimelineCustomColor() {\\\\n  return (\\\\n    <Timeline>\\\\n      <TimelineItem color=\\\\\\\"#ff0000\\\\\\\">创建服务</TimelineItem>\\\\n      <TimelineItem color=\\\\\\\"#00ff00\\\\\\\">完成初步设计</TimelineItem>\\\\n      <TimelineItem color=\\\\\\\"#0000ff\\\\\\\">技术评审</TimelineItem>\\\\n      <TimelineItem color=\\\\\\\"#ffff00\\\\\\\">开发完成</TimelineItem>\\\\n      <TimelineItem color=\\\\\\\"#ff00ff\\\\\\\">测试通过</TimelineItem>\\\\n    </Timeline>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n## API\\\\n\\\\n### Timeline Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| position | 时间轴位置 | `string` | `left` / `right` / `alternate` | `left` |\\\\n| reverse | 是否反向 | `boolean` | `false` |\\\\n| bordered | 是否带边框 | `boolean` | `false` |\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n### TimelineItem Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| time | 时间 | `string` | - |\\\\n| color | 颜色 | `string` | `primary` / `success` / `warning` / `danger` |\\\\n| dot | 自定义节点 | `VNode` | - |\\\\n| disabled | 是否禁用 | `boolean` | `false` |\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n## 样式定制\\\\n\\\\n### CSS 变量\\\\n\\\\n```css\\\\n.timeline {\\\\n  --timeline-bg: #ffffff;\\\\n  --timeline-border: #e5e7eb;\\\\n  --timeline-text: #374151;\\\\n  --timeline-time: #6b7280;\\\\n  --timeline-line: #d1d5db;\\\\n}\\\\n```\\\\n\\\\n### 自定义样式\\\\n\\\\n```tsx\\\\n<Timeline className=\\\\\\\"custom-timeline\\\\\\\">\\\\n  <TimelineItem>创建服务</TimelineItem>\\\\n</Timeline>\\\\n\\\\n<style>\\\\n.custom-timeline .timeline-item {\\\\n  padding: 1rem;\\\\n  background: #f9fafb;\\\\n  border-radius: 0.5rem;\\\\n}\\\\n\\\\n.custom-timeline .timeline-item-dot {\\\\n  width: 1.5rem;\\\\n  height: 1.5rem;\\\\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\\\\n  border-radius: 50%;\\\\n}\\\\n</style>\\\\n```\\\\n\\\\n## 最佳实践\\\\n\\\\n### 1. 项目进度\\\\n\\\\n```tsx\\\\nconst projectProgress = [\\\\n  { \\\\n    time: \\\\'2024-01-01\\\\',\\\\n    title: \\\\'项目启动\\\\',\\\\n    description: \\\\'项目正式启动，组建团队\\\\'\\\\n  },\\\\n  { \\\\n    time: \\\\'2024-02-01\\\\',\\\\n    title: \\\\'需求分析\\\\',\\\\n    description: \\\\'完成需求调研和分析\\\\'\\\\n  },\\\\n  { \\\\n    time: \\\\'2024-03-01\\\\',\\\\n    title: \\\\'设计阶段\\\\',\\\\n    description: \\\\'完成UI/UX设计\\\\'\\\\n  },\\\\n  { \\\\n    time: \\\\'2024-04-01\\\\',\\\\n    title: \\\\'开发阶段\\\\',\\\\n    description: \\\\'进行功能开发\\\\'\\\\n  },\\\\n  { \\\\n    time: \\\\'2024-05-01\\\\',\\\\n    title: \\\\'测试阶段\\\\',\\\\n    description: \\\\'进行系统测试\\\\'\\\\n  },\\\\n]\\\\n\\\\n<Timeline>\\\\n  {projectProgress.map(item => (\\\\n    <TimelineItem key={item.time} time={item.time}>\\\\n      <div>\\\\n        <h3 class=\\\\\\\"font-bold\\\\\\\">{item.title}</h3>\\\\n        <p class=\\\\\\\"text-neutral-600\\\\\\\">{item.description}</p>\\\\n      </div>\\\\n    </TimelineItem>\\\\n  ))}\\\\n</Timeline>\\\\n```\\\\n\\\\n### 2. 订单流程\\\\n\\\\n```tsx\\\\nconst orderFlow = [\\\\n  { \\\\n    time: \\\\'2024-01-01 10:00\\\\',\\\\n    title: \\\\'订单创建\\\\',\\\\n    color: \\\\'primary\\\\'\\\\n  },\\\\n  { \\\\n    time: \\\\'2024-01-01 10:30\\\\',\\\\n    title: \\\\'支付成功\\\\',\\\\n    color: \\\\'success\\\\'\\\\n  },\\\\n  { \\\\n    time: \\\\'2024-01-01 11:00\\\\',\\\\n    title: \\\\'商家接单\\\\',\\\\n    color: \\\\'primary\\\\'\\\\n  },\\\\n  { \\\\n    time: \\\\'2024-01-01 12:00\\\\',\\\\n    title: \\\\'配送中\\\\',\\\\n    color: \\\\'warning\\\\'\\\\n  },\\\\n  { \\\\n    time: \\\\'2024-01-01 12:30\\\\',\\\\n    title: \\\\'已送达\\\\',\\\\n    color: \\\\'success\\\\'\\\\n  },\\\\n]\\\\n\\\\n<Timeline>\\\\n  {orderFlow.map(item => (\\\\n    <TimelineItem \\\\n      key={item.time} \\\\n      time={item.time}\\\\n      color={item.color}\\\\n    >\\\\n      <div>\\\\n        <h3 class=\\\\\\\"font-bold\\\\\\\">{item.title}</h3>\\\\n      </div>\\\\n    </TimelineItem>\\\\n  ))}\\\\n</Timeline>\\\\n```\\\\n\\\\n### 3. 用户操作记录\\\\n\\\\n```tsx\\\\nconst userActions = [\\\\n  { \\\\n    time: \\\\'2024-01-01 09:00\\\\',\\\\n    title: \\\\'登录系统\\\\',\\\\n    icon: \\\\'🔐\\\\'\\\\n  },\\\\n  { \\\\n    time: \\\\'2024-01-01 09:30\\\\',\\\\n    title: \\\\'查看订单\\\\',\\\\n    icon: \\\\'📋\\\\'\\\\n  },\\\\n  { \\\\n    time: \\\\'2024-01-01 10:00\\\\',\\\\n    title: \\\\'提交订单\\\\',\\\\n    icon: \\\\'🛒\\\\'\\\\n  },\\\\n  { \\\\n    time: \\\\'2024-01-01 10:30\\\\',\\\\n    title: \\\\'支付订单\\\\',\\\\n    icon: \\\\'💳\\\\'\\\\n  },\\\\n  { \\\\n    time: \\\\'2024-01-01 11:00\\\\',\\\\n    title: \\\\'退出登录\\\\',\\\\n    icon: \\\\'🚪\\\\'\\\\n  },\\\\n]\\\\n\\\\n<Timeline>\\\\n  {userActions.map(item => (\\\\n    <TimelineItem \\\\n      key={item.time} \\\\n      time={item.time}\\\\n      dot={item.icon}\\\\n    >\\\\n      <div>\\\\n        <h3 class=\\\\\\\"font-bold\\\\\\\">{item.title}</h3>\\\\n      </div>\\\\n    </TimelineItem>\\\\n  ))}\\\\n</Timeline>\\\\n```\\\\n\\\\n## 常见问题\\\\n\\\\n### Q: 如何自定义时间轴的位置？\\\\n\\\\nA: 使用 `position` 属性设置时间轴的位置。\\\\n\\\\n### Q: 如何自定义节点的样式？\\\\n\\\\nA: 使用 `dot` 属性自定义节点的内容。\\\\n\\\\n### Q: 如何实现反向时间轴？\\\\n\\\\nA: 使用 `reverse` 属性实现反向时间轴。\\\\n\\\\n---\\\\n\\\\n🌹 Timeline 组件文档完成！\\\\n\",\"originAcceptText\":\"# Timeline 时间轴\\n\\n垂直展示的时间流信息。\\n\\n## 何时使用\\n\\n- 当有一系列信息需按时间排列时，可正序和倒序。\\n- 需要有一条时间轴进行视觉上的串联时。\\n\\n## 代码演示\\n\\n### 基础用法\\n\\n```tsx\\nimport { Timeline, TimelineItem } from '@/components/UI'\\n\\nexport default function TimelineBasic() {\\n  return (\\n    <Timeline>\\n      <TimelineItem>创建服务</TimelineItem>\\n      <TimelineItem>完成初步设计</TimelineItem>\\n      <TimelineItem>技术评审</TimelineItem>\\n      <TimelineItem>开发完成</TimelineItem>\\n      <TimelineItem>测试通过</TimelineItem>\\n    </Timeline>\\n  )\\n}\\n```\\n\\n### 带时间\\n\\n```tsx\\nimport { Timeline, TimelineItem } from '@/components/UI'\\n\\nexport default function TimelineWithTime() {\\n  return (\\n    <Timeline>\\n      <TimelineItem time=\\\"2024-01-01\\\">创建服务</TimelineItem>\\n      <TimelineItem time=\\\"2024-01-15\\\">完成初步设计</TimelineItem>\\n      <TimelineItem time=\\\"2024-02-01\\\">技术评审</TimelineItem>\\n      <TimelineItem time=\\\"2024-03-01\\\">开发完成</TimelineItem>\\n      <TimelineItem time=\\\"2024-03-15\\\">测试通过</TimelineItem>\\n    </Timeline>\\n  )\\n}\\n```\\n\\n### 颜色标记\\n\\n```tsx\\nimport { Timeline, TimelineItem } from '@/components/UI'\\n\\nexport default function TimelineColor() {\\n  return (\\n    <Timeline>\\n      <TimelineItem color=\\\"primary\\\">创建服务</TimelineItem>\\n      <TimelineItem color=\\\"success\\\">完成初步设计</TimelineItem>\\n      <TimelineItem color=\\\"warning\\\">技术评审</TimelineItem>\\n      <TimelineItem color=\\\"danger\\\">开发完成</TimelineItem>\\n      <TimelineItem color=\\\"success\\\">测试通过</TimelineItem>\\n    </Timeline>\\n  )\\n}\\n```\\n\\n### 带图标\\n\\n```tsx\\nimport { Timeline, TimelineItem } from '@/components/UI'\\n\\nexport default function TimelineWithIcon() {\\n  return (\\n    <Timeline>\\n      <TimelineItem dot=\\\"📝\\\">创建服务</TimelineItem>\\n      <TimelineItem dot=\\\"✏️\\\">完成初步设计</TimelineItem>\\n      <TimelineItem dot=\\\"🔍\\\">技术评审</TimelineItem>\\n      <TimelineItem dot=\\\"💻\\\">开发完成</TimelineItem>\\n      <TimelineItem dot=\\\"✅\\\">测试通过</TimelineItem>\\n    </Timeline>\\n  )\\n}\\n```\\n\\n### 禁用状态\\n\\n```tsx\\nimport { Timeline, TimelineItem } from '@/components/UI'\\n\\nexport default function TimelineDisabled() {\\n  return (\\n    <Timeline>\\n      <TimelineItem>创建服务</TimelineItem>\\n      <TimelineItem>完成初步设计</TimelineItem>\\n      <TimelineItem disabled>技术评审</TimelineItem>\\n      <TimelineItem disabled>开发完成</TimelineItem>\\n      <TimelineItem disabled>测试通过</TimelineItem>\\n    </Timeline>\\n  )\\n}\\n```\\n\\n### 交替排列\\n\\n```tsx\\nimport { Timeline, TimelineItem } from '@/components/UI'\\n\\nexport default function TimelineAlternate() {\\n  return (\\n    <Timeline position=\\\"alternate\\\">\\n      <TimelineItem>创建服务</TimelineItem>\\n      <TimelineItem>完成初步设计</TimelineItem>\\n      <TimelineItem>技术评审</TimelineItem>\\n      <TimelineItem>开发完成</TimelineItem>\\n      <TimelineItem>测试通过</TimelineItem>\\n    </Timeline>\\n  )\\n}\\n```\\n\\n### 右侧排列\\n\\n```tsx\\nimport { Timeline, TimelineItem } from '@/components/UI'\\n\\nexport default function TimelineRight() {\\n  return (\\n    <Timeline position=\\\"right\\\">\\n      <TimelineItem>创建服务</TimelineItem>\\n      <TimelineItem>完成初步设计</TimelineItem>\\n      <TimelineItem>技术评审</TimelineItem>\\n      <TimelineItem>开发完成</TimelineItem>\\n      <TimelineItem>测试通过</TimelineItem>\\n    </Timeline>\\n  )\\n}\\n```\\n\\n### 反向时间轴\\n\\n```tsx\\nimport { Timeline, TimelineItem } from '@/components/UI'\\n\\nexport default function TimelineReverse() {\\n  return (\\n    <Timeline reverse>\\n      <TimelineItem>测试通过</TimelineItem>\\n      <TimelineItem>开发完成</TimelineItem>\\n      <TimelineItem>技术评审</TimelineItem>\\n      <TimelineItem>完成初步设计</TimelineItem>\\n      <TimelineItem>创建服务</TimelineItem>\\n    </Timeline>\\n  )\\n}\\n```\\n\\n### 自定义颜色\\n\\n```tsx\\nimport { Timeline, TimelineItem } from '@/components/UI'\\n\\nexport default function TimelineCustomColor() {\\n  return (\\n    <Timeline>\\n      <TimelineItem color=\\\"#ff0000\\\">创建服务</TimelineItem>\\n      <TimelineItem color=\\\"#00ff00\\\">完成初步设计</TimelineItem>\\n      <TimelineItem color=\\\"#0000ff\\\">技术评审</TimelineItem>\\n      <TimelineItem color=\\\"#ffff00\\\">开发完成</TimelineItem>\\n      <TimelineItem color=\\\"#ff00ff\\\">测试通过</TimelineItem>\\n    </Timeline>\\n  )\\n}\\n```\\n\\n## API\\n\\n### Timeline Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| position | 时间轴位置 | `string` | `left` / `right` / `alternate` | `left` |\\n| reverse | 是否反向 | `boolean` | `false` |\\n| bordered | 是否带边框 | `boolean` | `false` |\\n| className | 自定义类名 | `string` | - |\\n\\n### TimelineItem Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| time | 时间 | `string` | - |\\n| color | 颜色 | `string` | `primary` / `success` / `warning` / `danger` |\\n| dot | 自定义节点 | `VNode` | - |\\n| disabled | 是否禁用 | `boolean` | `false` |\\n| className | 自定义类名 | `string` | - |\\n\\n## 样式定制\\n\\n### CSS 变量\\n\\n```css\\n.timeline {\\n  --timeline-bg: #ffffff;\\n  --timeline-border: #e5e7eb;\\n  --timeline-text: #374151;\\n  --timeline-time: #6b7280;\\n  --timeline-line: #d1d5db;\\n}\\n```\\n\\n### 自定义样式\\n\\n```tsx\\n<Timeline className=\\\"custom-timeline\\\">\\n  <TimelineItem>创建服务</TimelineItem>\\n</Timeline>\\n\\n<style>\\n.custom-timeline .timeline-item {\\n  padding: 1rem;\\n  background: #f9fafb;\\n  border-radius: 0.5rem;\\n}\\n\\n.custom-timeline .timeline-item-dot {\\n  width: 1.5rem;\\n  height: 1.5rem;\\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\\n  border-radius: 50%;\\n}\\n</style>\\n```\\n\\n## 最佳实践\\n\\n### 1. 项目进度\\n\\n```tsx\\nconst projectProgress = [\\n  { \\n    time: '2024-01-01',\\n    title: '项目启动',\\n    description: '项目正式启动，组建团队'\\n  },\\n  { \\n    time: '2024-02-01',\\n    title: '需求分析',\\n    description: '完成需求调研和分析'\\n  },\\n  { \\n    time: '2024-03-01',\\n    title: '设计阶段',\\n    description: '完成UI/UX设计'\\n  },\\n  { \\n    time: '2024-04-01',\\n    title: '开发阶段',\\n    description: '进行功能开发'\\n  },\\n  { \\n    time: '2024-05-01',\\n    title: '测试阶段',\\n    description: '进行系统测试'\\n  },\\n]\\n\\n<Timeline>\\n  {projectProgress.map(item => (\\n    <TimelineItem key={item.time} time={item.time}>\\n      <div>\\n        <h3 class=\\\"font-bold\\\">{item.title}</h3>\\n        <p class=\\\"text-neutral-600\\\">{item.description}</p>\\n      </div>\\n    </TimelineItem>\\n  ))}\\n</Timeline>\\n```\\n\\n### 2. 订单流程\\n\\n```tsx\\nconst orderFlow = [\\n  { \\n    time: '2024-01-01 10:00',\\n    title: '订单创建',\\n    color: 'primary'\\n  },\\n  { \\n    time: '2024-01-01 10:30',\\n    title: '支付成功',\\n    color: 'success'\\n  },\\n  { \\n    time: '2024-01-01 11:00',\\n    title: '商家接单',\\n    color: 'primary'\\n  },\\n  { \\n    time: '2024-01-01 12:00',\\n    title: '配送中',\\n    color: 'warning'\\n  },\\n  { \\n    time: '2024-01-01 12:30',\\n    title: '已送达',\\n    color: 'success'\\n  },\\n]\\n\\n<Timeline>\\n  {orderFlow.map(item => (\\n    <TimelineItem \\n      key={item.time} \\n      time={item.time}\\n      color={item.color}\\n    >\\n      <div>\\n        <h3 class=\\\"font-bold\\\">{item.title}</h3>\\n      </div>\\n    </TimelineItem>\\n  ))}\\n</Timeline>\\n```\\n\\n### 3. 用户操作记录\\n\\n```tsx\\nconst userActions = [\\n  { \\n    time: '2024-01-01 09:00',\\n    title: '登录系统',\\n    icon: '🔐'\\n  },\\n  { \\n    time: '2024-01-01 09:30',\\n    title: '查看订单',\\n    icon: '📋'\\n  },\\n  { \\n    time: '2024-01-01 10:00',\\n    title: '提交订单',\\n    icon: '🛒'\\n  },\\n  { \\n    time: '2024-01-01 10:30',\\n    title: '支付订单',\\n    icon: '💳'\\n  },\\n  { \\n    time: '2024-01-01 11:00',\\n    title: '退出登录',\\n    icon: '🚪'\\n  },\\n]\\n\\n<Timeline>\\n  {userActions.map(item => (\\n    <TimelineItem \\n      key={item.time} \\n      time={item.time}\\n      dot={item.icon}\\n    >\\n      <div>\\n        <h3 class=\\\"font-bold\\\">{item.title}</h3>\\n      </div>\\n    </TimelineItem>\\n  ))}\\n</Timeline>\\n```\\n\\n## 常见问题\\n\\n### Q: 如何自定义时间轴的位置？\\n\\nA: 使用 `position` 属性设置时间轴的位置。\\n\\n### Q: 如何自定义节点的样式？\\n\\nA: 使用 `dot` 属性自定义节点的内容。\\n\\n### Q: 如何实现反向时间轴？\\n\\nA: 使用 `reverse` 属性实现反向时间轴。\\n\\n---\\n\\n🌹 Timeline 组件文档完成！\\n\",\"originTextLength\":7247,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768948081752}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/components/UI/docs/components/Drawer.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":292,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":292,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# Drawer 抽屉\\\\n\\\\n屏幕边缘滑出的浮层面板。\\\\n\\\\n## 何时使用\\\\n\\\\n- 抽屉从父窗体边缘滑入，覆盖住部分父窗体内容。用户在抽屉内操作时不必离开当前任务，操作完成后，可以平滑地关闭到父窗体。\\\\n\\\\n## 代码演示\\\\n\\\\n### 基础用法\\\\n\\\\n```tsx\\\\nimport { Drawer, DrawerHeader, DrawerBody, DrawerFooter } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\nimport { ref } from \\\\'vue\\\\'\\\\n\\\\nexport default function DrawerBasic() {\\\\n  const visible = ref(false)\\\\n\\\\n  return (\\\\n    <div>\\\\n      <Button onClick={() => visible.value = true}>打开抽屉</Button>\\\\n      <Drawer\\\\n        visible={visible.value}\\\\n        title=\\\\\\\"抽屉标题\\\\\\\"\\\\n        onClose={() => visible.value = false}\\\\n      >\\\\n        <DrawerBody>\\\\n          <p>抽屉内容</p>\\\\n        </DrawerBody>\\\\n        <DrawerFooter>\\\\n          <Button onClick={() => visible.value = false}>关闭</Button>\\\\n        </DrawerFooter>\\\\n      </Drawer>\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 位置\\\\n\\\\n```tsx\\\\nimport { Drawer } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\nimport { ref } from \\\\'vue\\\\'\\\\n\\\\nexport default function DrawerPlacement() {\\\\n  const visible = ref(false)\\\\n  const placement = ref(\\\\'right\\\\')\\\\n\\\\n  return (\\\\n    <div class=\\\\\\\"space-x-2\\\\\\\">\\\\n      <Button onClick={() => { visible.value = true; placement.value = \\\\'left\\\\' }}>\\\\n        左侧\\\\n      </Button>\\\\n      <Button onClick={() => { visible.value = true; placement.value = \\\\'right\\\\' }}>\\\\n        右侧\\\\n      </Button>\\\\n      <Button onClick={() => { visible.value = true; placement.value = \\\\'top\\\\' }}>\\\\n        顶部\\\\n      </Button>\\\\n      <Button onClick={() => { visible.value = true; placement.value = \\\\'bottom\\\\' }}>\\\\n        底部\\\\n      </Button>\\\\n      <Drawer\\\\n        visible={visible.value}\\\\n        placement={placement.value}\\\\n        onClose={() => visible.value = false}\\\\n      >\\\\n        <p>抽屉内容</p>\\\\n      </Drawer>\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 尺寸\\\\n\\\\n```tsx\\\\nimport { Drawer } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\nimport { ref } from \\\\'vue\\\\'\\\\n\\\\nexport default function DrawerSize() {\\\\n  const visible = ref(false)\\\\n  const size = ref(\\\\'md\\\\')\\\\n\\\\n  return (\\\\n    <div class=\\\\\\\"space-x-2\\\\\\\">\\\\n      <Button onClick={() => { visible.value = true; size.value = \\\\'sm\\\\' }}>\\\\n        小型\\\\n      </Button>\\\\n      <Button onClick={() => { visible.value = true; size.value = \\\\'md\\\\' }}>\\\\n        中型\\\\n      </Button>\\\\n      <Button onClick={() => { visible.value = true; size.value = \\\\'lg\\\\' }}>\\\\n        大型\\\\n      </Button>\\\\n      <Drawer\\\\n        visible={visible.value}\\\\n        size={size.value}\\\\n        onClose={() => visible.value = false}\\\\n      >\\\\n        <p>抽屉内容</p>\\\\n      </Drawer>\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 可关闭\\\\n\\\\n```tsx\\\\nimport { Drawer } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\nimport { ref } from \\\\'vue\\\\'\\\\n\\\\nexport default function DrawerClosable() {\\\\n  const visible = ref(false)\\\\n\\\\n  return (\\\\n    <div>\\\\n      <Button onClick={() => visible.value = true}>打开抽屉</Button>\\\\n      <Drawer\\\\n        visible={visible.value}\\\\n        closable\\\\n        onClose={() => visible.value = false}\\\\n      >\\\\n        <p>抽屉内容</p>\\\\n      </Drawer>\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 无遮罩\\\\n\\\\n```tsx\\\\nimport { Drawer } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\nimport { ref } from \\\\'vue\\\\'\\\\n\\\\nexport default function DrawerNoMask() {\\\\n  const visible = ref(false)\\\\n\\\\n  return (\\\\n    <div>\\\\n      <Button onClick={() => visible.value = true}>打开抽屉</Button>\\\\n      <Drawer\\\\n        visible={visible.value}\\\\n        mask={false}\\\\n        onClose={() => visible.value = false}\\\\n      >\\\\n        <p>抽屉内容</p>\\\\n      </Drawer>\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n## API\\\\n\\\\n### Drawer Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| visible | 是否显示 | `boolean` | `false` |\\\\n| title | 标题 | `string` | - |\\\\n| placement | 位置 | `string` | `left` / `right` / `top` / `bottom` | `right` |\\\\n| size | 尺寸 | `string` | `sm` / `md` / `lg` | `md` |\\\\n| closable | 是否显示关闭按钮 | `boolean` | `true` |\\\\n| mask | 是否显示遮罩 | `boolean` | `true` |\\\\n| maskClosable | 点击遮罩是否关闭 | `boolean` | `true` |\\\\n| onClose | 关闭回调 | `Function` | - |\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n### DrawerHeader Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n### DrawerBody Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n### DrawerFooter Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n## 样式定制\\\\n\\\\n### CSS 变量\\\\n\\\\n```css\\\\n.drawer {\\\\n  --drawer-bg: #ffffff;\\\\n  --drawer-mask-bg: rgba(0, 0, 0, 0.5);\\\\n  --drawer-header-bg: #f9fafb;\\\\n  --drawer-border: #e5e7eb;\\\\n  --drawer-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);\\\\n}\\\\n```\\\\n\\\\n### 自定义样式\\\\n\\\\n```tsx\\\\n<Drawer className=\\\\\\\"custom-drawer\\\\\\\" visible={visible}>\\\\n\\\\n<style>\\\\n.custom-drawer .drawer-content {\\\\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\\\\n  color: white;\\\\n}\\\\n</style>\\\\n```\\\\n\\\\n## 最佳实践\\\\n\\\\n### 1. 表单抽屉\\\\n\\\\n```tsx\\\\nconst visible = ref(false)\\\\nconst formData = ref({})\\\\n\\\\nconst handleSubmit = () => {\\\\n  api.submit(formData.value)\\\\n  visible.value = false\\\\n}\\\\n\\\\n<Drawer\\\\n  visible={visible.value}\\\\n  title=\\\\\\\"编辑用户\\\\\\\"\\\\n  onClose={() => visible.value = false}\\\\n>\\\\n  <DrawerBody>\\\\n    <Form>\\\\n      <FormField name=\\\\\\\"username\\\\\\\" label=\\\\\\\"用户名\\\\\\\">\\\\n        <Input v-model={formData.value.username} />\\\\n      </FormField>\\\\n      <FormField name=\\\\\\\"email\\\\\\\" label=\\\\\\\"邮箱\\\\\\\">\\\\n        <Input v-model={formData.value.email} />\\\\n      </FormField>\\\\n    </Form>\\\\n  </DrawerBody>\\\\n  <DrawerFooter>\\\\n    <Button onClick={() => visible.value = false}>取消</Button>\\\\n    <Button type=\\\\\\\"primary\\\\\\\" onClick={handleSubmit}>确定</Button>\\\\n  </DrawerFooter>\\\\n</Drawer>\\\\n```\\\\n\\\\n### 2. 详情抽屉\\\\n\\\\n```tsx\\\\nconst visible = ref(false)\\\\nconst detail = ref({})\\\\n\\\\nconst showDetail = async (id: string) => {\\\\n  const result = await api.getDetail(id)\\\\n  detail.value = result.data\\\\n  visible.value = true\\\\n}\\\\n\\\\n<Drawer\\\\n  visible={visible.value}\\\\n  title=\\\\\\\"详情\\\\\\\"\\\\n  onClose={() => visible.value = false}\\\\n>\\\\n  <DrawerBody>\\\\n    <div>\\\\n      <p>用户名: {detail.value.username}</p>\\\\n      <p>邮箱: {detail.value.email}</p>\\\\n      <p>创建时间: {detail.value.createdAt}</p>\\\\n    </div>\\\\n  </DrawerBody>\\\\n</Drawer>\\\\n```\\\\n\\\\n### 3. 设置抽屉\\\\n\\\\n```tsx\\\\nconst visible = ref(false)\\\\nconst settings = ref({\\\\n  theme: \\\\'light\\\\',\\\\n  language: \\\\'zh-CN\\\\',\\\\n  notifications: true\\\\n})\\\\n\\\\nconst handleSave = () => {\\\\n  api.saveSettings(settings.value)\\\\n  visible.value = false\\\\n}\\\\n\\\\n<Drawer\\\\n  visible={visible.value}\\\\n  title=\\\\\\\"设置\\\\\\\"\\\\n  onClose={() => visible.value = false}\\\\n>\\\\n  <DrawerBody>\\\\n    <Form>\\\\n      <FormField name=\\\\\\\"theme\\\\\\\" label=\\\\\\\"主题\\\\\\\">\\\\n        <Select\\\\n          v-model={settings.value.theme}\\\\n          options={[\\\\n            { label: \\\\'浅色\\\\', value: \\\\'light\\\\' },\\\\n            { label: \\\\'深色\\\\', value: \\\\'dark\\\\' }\\\\n          ]}\\\\n        />\\\\n      </FormField>\\\\n      <FormField name=\\\\\\\"language\\\\\\\" label=\\\\\\\"语言\\\\\\\">\\\\n        <Select\\\\n          v-model={settings.value.language}\\\\n          options={[\\\\n            { label: \\\\'中文\\\\', value: \\\\'zh-CN\\\\' },\\\\n            { label: \\\\'English\\\\', value: \\\\'en-US\\\\' }\\\\n          ]}\\\\n        />\\\\n      </FormField>\\\\n      <FormField name=\\\\\\\"notifications\\\\\\\" label=\\\\\\\"通知\\\\\\\">\\\\n        <Switch v-model={settings.value.notifications} />\\\\n      </FormField>\\\\n    </Form>\\\\n  </DrawerBody>\\\\n  <DrawerFooter>\\\\n    <Button onClick={() => visible.value = false}>取消</Button>\\\\n    <Button type=\\\\\\\"primary\\\\\\\" onClick={handleSave}>保存</Button>\\\\n  </DrawerFooter>\\\\n</Drawer>\\\\n```\\\\n\\\\n## 常见问题\\\\n\\\\n### Q: 如何自定义抽屉的位置？\\\\n\\\\nA: 使用 `placement` 属性设置抽屉的位置。\\\\n\\\\n### Q: 如何禁用点击遮罩关闭？\\\\n\\\\nA: 使用 `maskClosable` 属性设置为 `false`。\\\\n\\\\n### Q: 如何自定义抽屉的尺寸？\\\\n\\\\nA: 使用 `size` 属性设置抽屉的尺寸。\\\\n\\\\n---\\\\n\\\\n🌹 Drawer 组件文档完成！\\\\n\",\"originAcceptText\":\"# Drawer 抽屉\\n\\n屏幕边缘滑出的浮层面板。\\n\\n## 何时使用\\n\\n- 抽屉从父窗体边缘滑入，覆盖住部分父窗体内容。用户在抽屉内操作时不必离开当前任务，操作完成后，可以平滑地关闭到父窗体。\\n\\n## 代码演示\\n\\n### 基础用法\\n\\n```tsx\\nimport { Drawer, DrawerHeader, DrawerBody, DrawerFooter } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\nimport { ref } from 'vue'\\n\\nexport default function DrawerBasic() {\\n  const visible = ref(false)\\n\\n  return (\\n    <div>\\n      <Button onClick={() => visible.value = true}>打开抽屉</Button>\\n      <Drawer\\n        visible={visible.value}\\n        title=\\\"抽屉标题\\\"\\n        onClose={() => visible.value = false}\\n      >\\n        <DrawerBody>\\n          <p>抽屉内容</p>\\n        </DrawerBody>\\n        <DrawerFooter>\\n          <Button onClick={() => visible.value = false}>关闭</Button>\\n        </DrawerFooter>\\n      </Drawer>\\n    </div>\\n  )\\n}\\n```\\n\\n### 位置\\n\\n```tsx\\nimport { Drawer } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\nimport { ref } from 'vue'\\n\\nexport default function DrawerPlacement() {\\n  const visible = ref(false)\\n  const placement = ref('right')\\n\\n  return (\\n    <div class=\\\"space-x-2\\\">\\n      <Button onClick={() => { visible.value = true; placement.value = 'left' }}>\\n        左侧\\n      </Button>\\n      <Button onClick={() => { visible.value = true; placement.value = 'right' }}>\\n        右侧\\n      </Button>\\n      <Button onClick={() => { visible.value = true; placement.value = 'top' }}>\\n        顶部\\n      </Button>\\n      <Button onClick={() => { visible.value = true; placement.value = 'bottom' }}>\\n        底部\\n      </Button>\\n      <Drawer\\n        visible={visible.value}\\n        placement={placement.value}\\n        onClose={() => visible.value = false}\\n      >\\n        <p>抽屉内容</p>\\n      </Drawer>\\n    </div>\\n  )\\n}\\n```\\n\\n### 尺寸\\n\\n```tsx\\nimport { Drawer } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\nimport { ref } from 'vue'\\n\\nexport default function DrawerSize() {\\n  const visible = ref(false)\\n  const size = ref('md')\\n\\n  return (\\n    <div class=\\\"space-x-2\\\">\\n      <Button onClick={() => { visible.value = true; size.value = 'sm' }}>\\n        小型\\n      </Button>\\n      <Button onClick={() => { visible.value = true; size.value = 'md' }}>\\n        中型\\n      </Button>\\n      <Button onClick={() => { visible.value = true; size.value = 'lg' }}>\\n        大型\\n      </Button>\\n      <Drawer\\n        visible={visible.value}\\n        size={size.value}\\n        onClose={() => visible.value = false}\\n      >\\n        <p>抽屉内容</p>\\n      </Drawer>\\n    </div>\\n  )\\n}\\n```\\n\\n### 可关闭\\n\\n```tsx\\nimport { Drawer } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\nimport { ref } from 'vue'\\n\\nexport default function DrawerClosable() {\\n  const visible = ref(false)\\n\\n  return (\\n    <div>\\n      <Button onClick={() => visible.value = true}>打开抽屉</Button>\\n      <Drawer\\n        visible={visible.value}\\n        closable\\n        onClose={() => visible.value = false}\\n      >\\n        <p>抽屉内容</p>\\n      </Drawer>\\n    </div>\\n  )\\n}\\n```\\n\\n### 无遮罩\\n\\n```tsx\\nimport { Drawer } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\nimport { ref } from 'vue'\\n\\nexport default function DrawerNoMask() {\\n  const visible = ref(false)\\n\\n  return (\\n    <div>\\n      <Button onClick={() => visible.value = true}>打开抽屉</Button>\\n      <Drawer\\n        visible={visible.value}\\n        mask={false}\\n        onClose={() => visible.value = false}\\n      >\\n        <p>抽屉内容</p>\\n      </Drawer>\\n    </div>\\n  )\\n}\\n```\\n\\n## API\\n\\n### Drawer Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| visible | 是否显示 | `boolean` | `false` |\\n| title | 标题 | `string` | - |\\n| placement | 位置 | `string` | `left` / `right` / `top` / `bottom` | `right` |\\n| size | 尺寸 | `string` | `sm` / `md` / `lg` | `md` |\\n| closable | 是否显示关闭按钮 | `boolean` | `true` |\\n| mask | 是否显示遮罩 | `boolean` | `true` |\\n| maskClosable | 点击遮罩是否关闭 | `boolean` | `true` |\\n| onClose | 关闭回调 | `Function` | - |\\n| className | 自定义类名 | `string` | - |\\n\\n### DrawerHeader Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| className | 自定义类名 | `string` | - |\\n\\n### DrawerBody Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| className | 自定义类名 | `string` | - |\\n\\n### DrawerFooter Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| className | 自定义类名 | `string` | - |\\n\\n## 样式定制\\n\\n### CSS 变量\\n\\n```css\\n.drawer {\\n  --drawer-bg: #ffffff;\\n  --drawer-mask-bg: rgba(0, 0, 0, 0.5);\\n  --drawer-header-bg: #f9fafb;\\n  --drawer-border: #e5e7eb;\\n  --drawer-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);\\n}\\n```\\n\\n### 自定义样式\\n\\n```tsx\\n<Drawer className=\\\"custom-drawer\\\" visible={visible}>\\n\\n<style>\\n.custom-drawer .drawer-content {\\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\\n  color: white;\\n}\\n</style>\\n```\\n\\n## 最佳实践\\n\\n### 1. 表单抽屉\\n\\n```tsx\\nconst visible = ref(false)\\nconst formData = ref({})\\n\\nconst handleSubmit = () => {\\n  api.submit(formData.value)\\n  visible.value = false\\n}\\n\\n<Drawer\\n  visible={visible.value}\\n  title=\\\"编辑用户\\\"\\n  onClose={() => visible.value = false}\\n>\\n  <DrawerBody>\\n    <Form>\\n      <FormField name=\\\"username\\\" label=\\\"用户名\\\">\\n        <Input v-model={formData.value.username} />\\n      </FormField>\\n      <FormField name=\\\"email\\\" label=\\\"邮箱\\\">\\n        <Input v-model={formData.value.email} />\\n      </FormField>\\n    </Form>\\n  </DrawerBody>\\n  <DrawerFooter>\\n    <Button onClick={() => visible.value = false}>取消</Button>\\n    <Button type=\\\"primary\\\" onClick={handleSubmit}>确定</Button>\\n  </DrawerFooter>\\n</Drawer>\\n```\\n\\n### 2. 详情抽屉\\n\\n```tsx\\nconst visible = ref(false)\\nconst detail = ref({})\\n\\nconst showDetail = async (id: string) => {\\n  const result = await api.getDetail(id)\\n  detail.value = result.data\\n  visible.value = true\\n}\\n\\n<Drawer\\n  visible={visible.value}\\n  title=\\\"详情\\\"\\n  onClose={() => visible.value = false}\\n>\\n  <DrawerBody>\\n    <div>\\n      <p>用户名: {detail.value.username}</p>\\n      <p>邮箱: {detail.value.email}</p>\\n      <p>创建时间: {detail.value.createdAt}</p>\\n    </div>\\n  </DrawerBody>\\n</Drawer>\\n```\\n\\n### 3. 设置抽屉\\n\\n```tsx\\nconst visible = ref(false)\\nconst settings = ref({\\n  theme: 'light',\\n  language: 'zh-CN',\\n  notifications: true\\n})\\n\\nconst handleSave = () => {\\n  api.saveSettings(settings.value)\\n  visible.value = false\\n}\\n\\n<Drawer\\n  visible={visible.value}\\n  title=\\\"设置\\\"\\n  onClose={() => visible.value = false}\\n>\\n  <DrawerBody>\\n    <Form>\\n      <FormField name=\\\"theme\\\" label=\\\"主题\\\">\\n        <Select\\n          v-model={settings.value.theme}\\n          options={[\\n            { label: '浅色', value: 'light' },\\n            { label: '深色', value: 'dark' }\\n          ]}\\n        />\\n      </FormField>\\n      <FormField name=\\\"language\\\" label=\\\"语言\\\">\\n        <Select\\n          v-model={settings.value.language}\\n          options={[\\n            { label: '中文', value: 'zh-CN' },\\n            { label: 'English', value: 'en-US' }\\n          ]}\\n        />\\n      </FormField>\\n      <FormField name=\\\"notifications\\\" label=\\\"通知\\\">\\n        <Switch v-model={settings.value.notifications} />\\n      </FormField>\\n    </Form>\\n  </DrawerBody>\\n  <DrawerFooter>\\n    <Button onClick={() => visible.value = false}>取消</Button>\\n    <Button type=\\\"primary\\\" onClick={handleSave}>保存</Button>\\n  </DrawerFooter>\\n</Drawer>\\n```\\n\\n## 常见问题\\n\\n### Q: 如何自定义抽屉的位置？\\n\\nA: 使用 `placement` 属性设置抽屉的位置。\\n\\n### Q: 如何禁用点击遮罩关闭？\\n\\nA: 使用 `maskClosable` 属性设置为 `false`。\\n\\n### Q: 如何自定义抽屉的尺寸？\\n\\nA: 使用 `size` 属性设置抽屉的尺寸。\\n\\n---\\n\\n🌹 Drawer 组件文档完成！\\n\",\"originTextLength\":7175,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768948159831}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/components/UI/docs/components/Dialog.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":324,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":324,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# Dialog 对话框\\\\n\\\\n模态对话框，在保留当前页面状态的情况下，提示用户进行相关操作。\\\\n\\\\n## 何时使用\\\\n\\\\n- 需要用户处理事务，又不希望跳转页面以致打断工作流程时，可以使用 `Modal` 在当前页面正中打开一个浮层，承载相应的操作。\\\\n\\\\n## 代码演示\\\\n\\\\n### 基础用法\\\\n\\\\n```tsx\\\\nimport { Dialog, DialogHeader, DialogBody, DialogFooter } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\nimport { ref } from \\\\'vue\\\\'\\\\n\\\\nexport default function DialogBasic() {\\\\n  const visible = ref(false)\\\\n\\\\n  return (\\\\n    <div>\\\\n      <Button onClick={() => visible.value = true}>打开对话框</Button>\\\\n      <Dialog\\\\n        visible={visible.value}\\\\n        title=\\\\\\\"对话框标题\\\\\\\"\\\\n        onClose={() => visible.value = false}\\\\n      >\\\\n        <DialogBody>\\\\n          <p>对话框内容</p>\\\\n        </DialogBody>\\\\n        <DialogFooter>\\\\n          <Button onClick={() => visible.value = false}>关闭</Button>\\\\n        </DialogFooter>\\\\n      </Dialog>\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 尺寸\\\\n\\\\n```tsx\\\\nimport { Dialog } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\nimport { ref } from \\\\'vue\\\\'\\\\n\\\\nexport default function DialogSize() {\\\\n  const visible = ref(false)\\\\n  const size = ref(\\\\'md\\\\')\\\\n\\\\n  return (\\\\n    <div class=\\\\\\\"space-x-2\\\\\\\">\\\\n      <Button onClick={() => { visible.value = true; size.value = \\\\'sm\\\\' }}>\\\\n        小型\\\\n      </Button>\\\\n      <Button onClick={() => { visible.value = true; size.value = \\\\'md\\\\' }}>\\\\n        中型\\\\n      </Button>\\\\n      <Button onClick={() => { visible.value = true; size.value = \\\\'lg\\\\' }}>\\\\n        大型\\\\n      </Button>\\\\n      <Dialog\\\\n        visible={visible.value}\\\\n        size={size.value}\\\\n        onClose={() => visible.value = false}\\\\n      >\\\\n        <DialogBody>\\\\n          <p>对话框内容</p>\\\\n        </DialogBody>\\\\n      </Dialog>\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 全屏\\\\n\\\\n```tsx\\\\nimport { Dialog } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\nimport { ref } from \\\\'vue\\\\'\\\\n\\\\nexport default function DialogFullscreen() {\\\\n  const visible = ref(false)\\\\n\\\\n  return (\\\\n    <div>\\\\n      <Button onClick={() => visible.value = true}>全屏对话框</Button>\\\\n      <Dialog\\\\n        visible={visible.value}\\\\n        fullscreen\\\\n        onClose={() => visible.value = false}\\\\n      >\\\\n        <DialogBody>\\\\n          <p>全屏对话框内容</p>\\\\n        </DialogBody>\\\\n      </Dialog>\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 居中\\\\n\\\\n```tsx\\\\nimport { Dialog } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\nimport { ref } from \\\\'vue\\\\'\\\\n\\\\nexport default function DialogCentered() {\\\\n  const visible = ref(false)\\\\n\\\\n  return (\\\\n    <div>\\\\n      <Button onClick={() => visible.value = true}>居中对话框</Button>\\\\n      <Dialog\\\\n        visible={visible.value}\\\\n        centered\\\\n        onClose={() => visible.value = false}\\\\n      >\\\\n        <DialogBody>\\\\n          <p>居中对话框内容</p>\\\\n        </DialogBody>\\\\n      </Dialog>\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 可关闭\\\\n\\\\n```tsx\\\\nimport { Dialog } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\nimport { ref } from \\\\'vue\\\\'\\\\n\\\\nexport default function DialogClosable() {\\\\n  const visible = ref(false)\\\\n\\\\n  return (\\\\n    <div>\\\\n      <Button onClick={() => visible.value = true}>可关闭对话框</Button>\\\\n      <Dialog\\\\n        visible={visible.value}\\\\n        closable\\\\n        onClose={() => visible.value = false}\\\\n      >\\\\n        <DialogBody>\\\\n          <p>可关闭对话框内容</p>\\\\n        </DialogBody>\\\\n      </Dialog>\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 无遮罩\\\\n\\\\n```tsx\\\\nimport { Dialog } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\nimport { ref } from \\\\'vue\\\\'\\\\n\\\\nexport default function DialogNoMask() {\\\\n  const visible = ref(false)\\\\n\\\\n  return (\\\\n    <div>\\\\n      <Button onClick={() => visible.value = true}>无遮罩对话框</Button>\\\\n      <Dialog\\\\n        visible={visible.value}\\\\n        mask={false}\\\\n        onClose={() => visible.value = false}\\\\n      >\\\\n        <DialogBody>\\\\n          <p>无遮罩对话框内容</p>\\\\n        </DialogBody>\\\\n      </Dialog>\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 确认对话框\\\\n\\\\n```tsx\\\\nimport { Dialog } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\nimport { ref } from \\\\'vue\\\\'\\\\n\\\\nexport default function DialogConfirm() {\\\\n  const visible = ref(false)\\\\n\\\\n  const handleConfirm = () => {\\\\n    console.log(\\\\'确认\\\\')\\\\n    visible.value = false\\\\n  }\\\\n\\\\n  return (\\\\n    <div>\\\\n      <Button onClick={() => visible.value = true}>确认对话框</Button>\\\\n      <Dialog\\\\n        visible={visible.value}\\\\n        title=\\\\\\\"确认删除\\\\\\\"\\\\n        showConfirmButton\\\\n        showCancelButton\\\\n        onConfirm={handleConfirm}\\\\n        onCancel={() => visible.value = false}\\\\n      >\\\\n        <DialogBody>\\\\n          <p>确定要删除吗？</p>\\\\n        </DialogBody>\\\\n      </Dialog>\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n## API\\\\n\\\\n### Dialog Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| visible | 是否显示 | `boolean` | `false` |\\\\n| title | 标题 | `string` | - |\\\\n| size | 尺寸 | `string` | `sm` / `md` / `lg` | `md` |\\\\n| fullscreen | 是否全屏 | `boolean` | `false` |\\\\n| centered | 是否居中 | `boolean` | `false` |\\\\n| closable | 是否显示关闭按钮 | `boolean` | `true` |\\\\n| mask | 是否显示遮罩 | `boolean` | `true` |\\\\n| maskClosable | 点击遮罩是否关闭 | `boolean` | `true` |\\\\n| showConfirmButton | 是否显示确认按钮 | `boolean` | `false` |\\\\n| showCancelButton | 是否显示取消按钮 | `boolean` | `false` |\\\\n| onClose | 关闭回调 | `Function` | - |\\\\n| onConfirm | 确认回调 | `Function` | - |\\\\n| onCancel | 取消回调 | `Function` | - |\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n### DialogHeader Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n### DialogBody Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n### DialogFooter Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n## 样式定制\\\\n\\\\n### CSS 变量\\\\n\\\\n```css\\\\n.dialog {\\\\n  --dialog-bg: #ffffff;\\\\n  --dialog-mask-bg: rgba(0, 0, 0, 0.5);\\\\n  --dialog-header-bg: #f9fafb;\\\\n  --dialog-border: #e5e7eb;\\\\n  --dialog-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);\\\\n}\\\\n```\\\\n\\\\n### 自定义样式\\\\n\\\\n```tsx\\\\n<Dialog className=\\\\\\\"custom-dialog\\\\\\\" visible={visible}>\\\\n\\\\n<style>\\\\n.custom-dialog .dialog-content {\\\\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\\\\n  color: white;\\\\n  border: none;\\\\n}\\\\n</style>\\\\n```\\\\n\\\\n## 最佳实践\\\\n\\\\n### 1. 表单对话框\\\\n\\\\n```tsx\\\\nconst visible = ref(false)\\\\nconst formData = ref({})\\\\n\\\\nconst handleSubmit = () => {\\\\n  api.submit(formData.value)\\\\n  visible.value = false\\\\n}\\\\n\\\\n<Dialog\\\\n  visible={visible.value}\\\\n  title=\\\\\\\"编辑用户\\\\\\\"\\\\n  onClose={() => visible.value = false}\\\\n>\\\\n  <DialogBody>\\\\n    <Form>\\\\n      <FormField name=\\\\\\\"username\\\\\\\" label=\\\\\\\"用户名\\\\\\\">\\\\n        <Input v-model={formData.value.username} />\\\\n      </FormField>\\\\n      <FormField name=\\\\\\\"email\\\\\\\" label=\\\\\\\"邮箱\\\\\\\">\\\\n        <Input v-model={formData.value.email} />\\\\n      </FormField>\\\\n    </Form>\\\\n  </DialogBody>\\\\n  <DialogFooter>\\\\n    <Button onClick={() => visible.value = false}>取消</Button>\\\\n    <Button type=\\\\\\\"primary\\\\\\\" onClick={handleSubmit}>确定</Button>\\\\n  </DialogFooter>\\\\n</Dialog>\\\\n```\\\\n\\\\n### 2. 确认对话框\\\\n\\\\n```tsx\\\\nconst visible = ref(false)\\\\n\\\\nconst handleDelete = async () => {\\\\n  try {\\\\n    await api.delete(id)\\\\n    message.success(\\\\'删除成功\\\\')\\\\n    visible.value = false\\\\n  } catch (error) {\\\\n    message.error(\\\\'删除失败\\\\')\\\\n  }\\\\n}\\\\n\\\\n<Dialog\\\\n  visible={visible.value}\\\\n  title=\\\\\\\"确认删除\\\\\\\"\\\\n  showConfirmButton\\\\n  showCancelButton\\\\n  onConfirm={handleDelete}\\\\n  onCancel={() => visible.value = false}\\\\n>\\\\n  <DialogBody>\\\\n    <p>确定要删除吗？此操作不可恢复。</p>\\\\n  </DialogBody>\\\\n</Dialog>\\\\n```\\\\n\\\\n### 3. 详情对话框\\\\n\\\\n```tsx\\\\nconst visible = ref(false)\\\\nconst detail = ref({})\\\\n\\\\nconst showDetail = async (id: string) => {\\\\n  const result = await api.getDetail(id)\\\\n  detail.value = result.data\\\\n  visible.value = true\\\\n}\\\\n\\\\n<Dialog\\\\n  visible={visible.value}\\\\n  title=\\\\\\\"详情\\\\\\\"\\\\n  onClose={() => visible.value = false}\\\\n>\\\\n  <DialogBody>\\\\n    <div>\\\\n      <p>用户名: {detail.value.username}</p>\\\\n      <p>邮箱: {detail.value.email}</p>\\\\n      <p>创建时间: {detail.value.createdAt}</p>\\\\n    </div>\\\\n  </DialogBody>\\\\n</Dialog>\\\\n```\\\\n\\\\n## 常见问题\\\\n\\\\n### Q: 如何自定义对话框的尺寸？\\\\n\\\\nA: 使用 `size` 属性设置对话框的尺寸。\\\\n\\\\n### Q: 如何禁用点击遮罩关闭？\\\\n\\\\nA: 使用 `maskClosable` 属性设置为 `false`。\\\\n\\\\n### Q: 如何实现确认对话框？\\\\n\\\\nA: 使用 `showConfirmButton` 和 `showCancelButton` 属性显示确认和取消按钮。\\\\n\\\\n---\\\\n\\\\n🌹 Dialog 组件文档完成！\\\\n\",\"originAcceptText\":\"# Dialog 对话框\\n\\n模态对话框，在保留当前页面状态的情况下，提示用户进行相关操作。\\n\\n## 何时使用\\n\\n- 需要用户处理事务，又不希望跳转页面以致打断工作流程时，可以使用 `Modal` 在当前页面正中打开一个浮层，承载相应的操作。\\n\\n## 代码演示\\n\\n### 基础用法\\n\\n```tsx\\nimport { Dialog, DialogHeader, DialogBody, DialogFooter } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\nimport { ref } from 'vue'\\n\\nexport default function DialogBasic() {\\n  const visible = ref(false)\\n\\n  return (\\n    <div>\\n      <Button onClick={() => visible.value = true}>打开对话框</Button>\\n      <Dialog\\n        visible={visible.value}\\n        title=\\\"对话框标题\\\"\\n        onClose={() => visible.value = false}\\n      >\\n        <DialogBody>\\n          <p>对话框内容</p>\\n        </DialogBody>\\n        <DialogFooter>\\n          <Button onClick={() => visible.value = false}>关闭</Button>\\n        </DialogFooter>\\n      </Dialog>\\n    </div>\\n  )\\n}\\n```\\n\\n### 尺寸\\n\\n```tsx\\nimport { Dialog } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\nimport { ref } from 'vue'\\n\\nexport default function DialogSize() {\\n  const visible = ref(false)\\n  const size = ref('md')\\n\\n  return (\\n    <div class=\\\"space-x-2\\\">\\n      <Button onClick={() => { visible.value = true; size.value = 'sm' }}>\\n        小型\\n      </Button>\\n      <Button onClick={() => { visible.value = true; size.value = 'md' }}>\\n        中型\\n      </Button>\\n      <Button onClick={() => { visible.value = true; size.value = 'lg' }}>\\n        大型\\n      </Button>\\n      <Dialog\\n        visible={visible.value}\\n        size={size.value}\\n        onClose={() => visible.value = false}\\n      >\\n        <DialogBody>\\n          <p>对话框内容</p>\\n        </DialogBody>\\n      </Dialog>\\n    </div>\\n  )\\n}\\n```\\n\\n### 全屏\\n\\n```tsx\\nimport { Dialog } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\nimport { ref } from 'vue'\\n\\nexport default function DialogFullscreen() {\\n  const visible = ref(false)\\n\\n  return (\\n    <div>\\n      <Button onClick={() => visible.value = true}>全屏对话框</Button>\\n      <Dialog\\n        visible={visible.value}\\n        fullscreen\\n        onClose={() => visible.value = false}\\n      >\\n        <DialogBody>\\n          <p>全屏对话框内容</p>\\n        </DialogBody>\\n      </Dialog>\\n    </div>\\n  )\\n}\\n```\\n\\n### 居中\\n\\n```tsx\\nimport { Dialog } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\nimport { ref } from 'vue'\\n\\nexport default function DialogCentered() {\\n  const visible = ref(false)\\n\\n  return (\\n    <div>\\n      <Button onClick={() => visible.value = true}>居中对话框</Button>\\n      <Dialog\\n        visible={visible.value}\\n        centered\\n        onClose={() => visible.value = false}\\n      >\\n        <DialogBody>\\n          <p>居中对话框内容</p>\\n        </DialogBody>\\n      </Dialog>\\n    </div>\\n  )\\n}\\n```\\n\\n### 可关闭\\n\\n```tsx\\nimport { Dialog } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\nimport { ref } from 'vue'\\n\\nexport default function DialogClosable() {\\n  const visible = ref(false)\\n\\n  return (\\n    <div>\\n      <Button onClick={() => visible.value = true}>可关闭对话框</Button>\\n      <Dialog\\n        visible={visible.value}\\n        closable\\n        onClose={() => visible.value = false}\\n      >\\n        <DialogBody>\\n          <p>可关闭对话框内容</p>\\n        </DialogBody>\\n      </Dialog>\\n    </div>\\n  )\\n}\\n```\\n\\n### 无遮罩\\n\\n```tsx\\nimport { Dialog } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\nimport { ref } from 'vue'\\n\\nexport default function DialogNoMask() {\\n  const visible = ref(false)\\n\\n  return (\\n    <div>\\n      <Button onClick={() => visible.value = true}>无遮罩对话框</Button>\\n      <Dialog\\n        visible={visible.value}\\n        mask={false}\\n        onClose={() => visible.value = false}\\n      >\\n        <DialogBody>\\n          <p>无遮罩对话框内容</p>\\n        </DialogBody>\\n      </Dialog>\\n    </div>\\n  )\\n}\\n```\\n\\n### 确认对话框\\n\\n```tsx\\nimport { Dialog } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\nimport { ref } from 'vue'\\n\\nexport default function DialogConfirm() {\\n  const visible = ref(false)\\n\\n  const handleConfirm = () => {\\n    console.log('确认')\\n    visible.value = false\\n  }\\n\\n  return (\\n    <div>\\n      <Button onClick={() => visible.value = true}>确认对话框</Button>\\n      <Dialog\\n        visible={visible.value}\\n        title=\\\"确认删除\\\"\\n        showConfirmButton\\n        showCancelButton\\n        onConfirm={handleConfirm}\\n        onCancel={() => visible.value = false}\\n      >\\n        <DialogBody>\\n          <p>确定要删除吗？</p>\\n        </DialogBody>\\n      </Dialog>\\n    </div>\\n  )\\n}\\n```\\n\\n## API\\n\\n### Dialog Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| visible | 是否显示 | `boolean` | `false` |\\n| title | 标题 | `string` | - |\\n| size | 尺寸 | `string` | `sm` / `md` / `lg` | `md` |\\n| fullscreen | 是否全屏 | `boolean` | `false` |\\n| centered | 是否居中 | `boolean` | `false` |\\n| closable | 是否显示关闭按钮 | `boolean` | `true` |\\n| mask | 是否显示遮罩 | `boolean` | `true` |\\n| maskClosable | 点击遮罩是否关闭 | `boolean` | `true` |\\n| showConfirmButton | 是否显示确认按钮 | `boolean` | `false` |\\n| showCancelButton | 是否显示取消按钮 | `boolean` | `false` |\\n| onClose | 关闭回调 | `Function` | - |\\n| onConfirm | 确认回调 | `Function` | - |\\n| onCancel | 取消回调 | `Function` | - |\\n| className | 自定义类名 | `string` | - |\\n\\n### DialogHeader Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| className | 自定义类名 | `string` | - |\\n\\n### DialogBody Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| className | 自定义类名 | `string` | - |\\n\\n### DialogFooter Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| className | 自定义类名 | `string` | - |\\n\\n## 样式定制\\n\\n### CSS 变量\\n\\n```css\\n.dialog {\\n  --dialog-bg: #ffffff;\\n  --dialog-mask-bg: rgba(0, 0, 0, 0.5);\\n  --dialog-header-bg: #f9fafb;\\n  --dialog-border: #e5e7eb;\\n  --dialog-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);\\n}\\n```\\n\\n### 自定义样式\\n\\n```tsx\\n<Dialog className=\\\"custom-dialog\\\" visible={visible}>\\n\\n<style>\\n.custom-dialog .dialog-content {\\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\\n  color: white;\\n  border: none;\\n}\\n</style>\\n```\\n\\n## 最佳实践\\n\\n### 1. 表单对话框\\n\\n```tsx\\nconst visible = ref(false)\\nconst formData = ref({})\\n\\nconst handleSubmit = () => {\\n  api.submit(formData.value)\\n  visible.value = false\\n}\\n\\n<Dialog\\n  visible={visible.value}\\n  title=\\\"编辑用户\\\"\\n  onClose={() => visible.value = false}\\n>\\n  <DialogBody>\\n    <Form>\\n      <FormField name=\\\"username\\\" label=\\\"用户名\\\">\\n        <Input v-model={formData.value.username} />\\n      </FormField>\\n      <FormField name=\\\"email\\\" label=\\\"邮箱\\\">\\n        <Input v-model={formData.value.email} />\\n      </FormField>\\n    </Form>\\n  </DialogBody>\\n  <DialogFooter>\\n    <Button onClick={() => visible.value = false}>取消</Button>\\n    <Button type=\\\"primary\\\" onClick={handleSubmit}>确定</Button>\\n  </DialogFooter>\\n</Dialog>\\n```\\n\\n### 2. 确认对话框\\n\\n```tsx\\nconst visible = ref(false)\\n\\nconst handleDelete = async () => {\\n  try {\\n    await api.delete(id)\\n    message.success('删除成功')\\n    visible.value = false\\n  } catch (error) {\\n    message.error('删除失败')\\n  }\\n}\\n\\n<Dialog\\n  visible={visible.value}\\n  title=\\\"确认删除\\\"\\n  showConfirmButton\\n  showCancelButton\\n  onConfirm={handleDelete}\\n  onCancel={() => visible.value = false}\\n>\\n  <DialogBody>\\n    <p>确定要删除吗？此操作不可恢复。</p>\\n  </DialogBody>\\n</Dialog>\\n```\\n\\n### 3. 详情对话框\\n\\n```tsx\\nconst visible = ref(false)\\nconst detail = ref({})\\n\\nconst showDetail = async (id: string) => {\\n  const result = await api.getDetail(id)\\n  detail.value = result.data\\n  visible.value = true\\n}\\n\\n<Dialog\\n  visible={visible.value}\\n  title=\\\"详情\\\"\\n  onClose={() => visible.value = false}\\n>\\n  <DialogBody>\\n    <div>\\n      <p>用户名: {detail.value.username}</p>\\n      <p>邮箱: {detail.value.email}</p>\\n      <p>创建时间: {detail.value.createdAt}</p>\\n    </div>\\n  </DialogBody>\\n</Dialog>\\n```\\n\\n## 常见问题\\n\\n### Q: 如何自定义对话框的尺寸？\\n\\nA: 使用 `size` 属性设置对话框的尺寸。\\n\\n### Q: 如何禁用点击遮罩关闭？\\n\\nA: 使用 `maskClosable` 属性设置为 `false`。\\n\\n### Q: 如何实现确认对话框？\\n\\nA: 使用 `showConfirmButton` 和 `showCancelButton` 属性显示确认和取消按钮。\\n\\n---\\n\\n🌹 Dialog 组件文档完成！\\n\",\"originTextLength\":7667,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768948186185}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/components/UI/docs/components/Tooltip.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":282,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":282,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# Tooltip 文字提示\\\\n\\\\n简单的文字提示气泡框。\\\\n\\\\n## 何时使用\\\\n\\\\n- 鼠标移入则显示提示，移出消失，气泡浮层不承载复杂文本和操作。\\\\n- 可以对文字进行简单提示。\\\\n\\\\n## 代码演示\\\\n\\\\n### 基础用法\\\\n\\\\n```tsx\\\\nimport { Tooltip } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function TooltipBasic() {\\\\n  return (\\\\n    <Tooltip title=\\\\\\\"提示内容\\\\\\\">\\\\n      <Button>悬停显示</Button>\\\\n    </Tooltip>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 位置\\\\n\\\\n```tsx\\\\nimport { Tooltip } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function TooltipPlacement() {\\\\n  return (\\\\n    <div class=\\\\\\\"space-x-2\\\\\\\">\\\\n      <Tooltip title=\\\\\\\"顶部提示\\\\\\\" placement=\\\\\\\"top\\\\\\\">\\\\n        <Button>顶部</Button>\\\\n      </Tooltip>\\\\n      <Tooltip title=\\\\\\\"底部提示\\\\\\\" placement=\\\\\\\"bottom\\\\\\\">\\\\n        <Button>底部</Button>\\\\n      </Tooltip>\\\\n      <Tooltip title=\\\\\\\"左侧提示\\\\\\\" placement=\\\\\\\"left\\\\\\\">\\\\n        <Button>左侧</Button>\\\\n      </Tooltip>\\\\n      <Tooltip title=\\\\\\\"右侧提示\\\\\\\" placement=\\\\\\\"right\\\\\\\">\\\\n        <Button>右侧</Button>\\\\n      </Tooltip>\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 触发方式\\\\n\\\\n```tsx\\\\nimport { Tooltip } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function TooltipTrigger() {\\\\n  return (\\\\n    <div class=\\\\\\\"space-x-2\\\\\\\">\\\\n      <Tooltip\\\\n        title=\\\\\\\"悬停提示\\\\\\\"\\\\n        trigger=\\\\\\\"hover\\\\\\\"\\\\n        triggerElement={<Button>悬停</Button>}\\\\n      />\\\\n      <Tooltip\\\\n        title=\\\\\\\"点击提示\\\\\\\"\\\\n        trigger=\\\\\\\"click\\\\\\\"\\\\n        triggerElement={<Button>点击</Button>}\\\\n      />\\\\n      <Tooltip\\\\n        title=\\\\\\\"聚焦提示\\\\\\\"\\\\n        trigger=\\\\\\\"focus\\\\\\\"\\\\n        triggerElement={<Button>聚焦</Button>}\\\\n      />\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 禁用\\\\n\\\\n```tsx\\\\nimport { Tooltip } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function TooltipDisabled() {\\\\n  return (\\\\n    <div class=\\\\\\\"space-x-2\\\\\\\">\\\\n      <Tooltip title=\\\\\\\"禁用提示\\\\\\\" disabled>\\\\n        <Button>禁用</Button>\\\\n      </Tooltip>\\\\n      <Tooltip title=\\\\\\\"可用提示\\\\\\\">\\\\n        <Button>可用</Button>\\\\n      </Tooltip>\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 带箭头\\\\n\\\\n```tsx\\\\nimport { Tooltip } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function TooltipArrow() {\\\\n  return (\\\\n    <Tooltip\\\\n      title=\\\\\\\"带箭头提示\\\\\\\"\\\\n      arrow\\\\n      triggerElement={<Button>带箭头</Button>}\\\\n    />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 延迟显示\\\\n\\\\n```tsx\\\\nimport { Tooltip } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function TooltipDelay() {\\\\n  return (\\\\n    <Tooltip\\\\n      title=\\\\\\\"延迟提示\\\\\\\"\\\\n      delay={500}\\\\n      triggerElement={<Button>延迟500ms</Button>}\\\\n    />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 富文本\\\\n\\\\n```tsx\\\\nimport { Tooltip } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function TooltipRichText() {\\\\n  return (\\\\n    <Tooltip\\\\n      title={\\\\n        <div>\\\\n          <p><strong>加粗文本</strong></p>\\\\n          <p><em>斜体文本</em></p>\\\\n        </div>\\\\n      }\\\\n      triggerElement={<Button>富文本</Button>}\\\\n    />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 自定义颜色\\\\n\\\\n```tsx\\\\nimport { Tooltip } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function TooltipColor() {\\\\n  return (\\\\n    <div class=\\\\\\\"space-x-2\\\\\\\">\\\\n      <Tooltip\\\\n        title=\\\\\\\"主要提示\\\\\\\"\\\\n        color=\\\\\\\"primary\\\\\\\"\\\\n        triggerElement={<Button>主要</Button>}\\\\n      />\\\\n      <Tooltip\\\\n        title=\\\\\\\"成功提示\\\\\\\"\\\\n        color=\\\\\\\"success\\\\\\\"\\\\n        triggerElement={<Button>成功</Button>}\\\\n      />\\\\n      <Tooltip\\\\n        title=\\\\\\\"警告提示\\\\\\\"\\\\n        color=\\\\\\\"warning\\\\\\\"\\\\n        triggerElement={<Button>警告</Button>}\\\\n      />\\\\n      <Tooltip\\\\n        title=\\\\\\\"危险提示\\\\\\\"\\\\n        color=\\\\\\\"danger\\\\\\\"\\\\n        triggerElement={<Button>危险</Button>}\\\\n      />\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n## API\\\\n\\\\n### Tooltip Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| title | 提示内容 | `string \\\\\\\\| VNode` | - |\\\\n| trigger | 触发方式 | `string` | `hover` / `click` / `focus` | `hover` |\\\\n| triggerElement | 触发元素 | `VNode` | - |\\\\n| placement | 位置 | `string` | `top` / `bottom` / `left` / `right` | `top` |\\\\n| disabled | 是否禁用 | `boolean` | `false` |\\\\n| arrow | 是否显示箭头 | `boolean` | `false` |\\\\n| delay | 延迟显示（毫秒） | `number` | - |\\\\n| onVisibleChange | 显示状态变化回调 | `Function` | - |\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n## 样式定制\\\\n\\\\n### CSS 变量\\\\n\\\\n```css\\\\n.tooltip {\\\\n  --tooltip-bg: #1f2937;\\\\n  --tooltip-text: #ffffff;\\\\n  --tooltip-arrow-color: #1f2937;\\\\n  --tooltip-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);\\\\n  --tooltip-padding: 0.5rem 0.75rem;\\\\n  --tooltip-font-size: 0.875rem;\\\\n}\\\\n```\\\\n\\\\n### 自定义样式\\\\n\\\\n```tsx\\\\n<Tooltip\\\\n  className=\\\\\\\"custom-tooltip\\\\\\\"\\\\n  title=\\\\\\\"自定义提示\\\\\\\"\\\\n  triggerElement={<Button>自定义</Button>}\\\\n/>\\\\n\\\\n<style>\\\\n.custom-tooltip .tooltip-content {\\\\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\\\\n  color: white;\\\\n  padding: 1rem;\\\\n  border-radius: 0.5rem;\\\\n}\\\\n</style>\\\\n```\\\\n\\\\n## 最佳实践\\\\n\\\\n### 1. 表单提示\\\\n\\\\n```tsx\\\\n<FormField name=\\\\\\\"username\\\\\\\" label=\\\\\\\"用户名\\\\\\\" required>\\\\n  <div class=\\\\\\\"relative\\\\\\\">\\\\n    <Input type=\\\\\\\"text\\\\\\\" placeholder=\\\\\\\"请输入用户名\\\\\\\" />\\\\n    <Tooltip\\\\n      title=\\\\\\\"用户名长度为4-20个字符\\\\\\\"\\\\n      placement=\\\\\\\"right\\\\\\\"\\\\n      triggerElement={\\\\n        <span class=\\\\\\\"absolute right-2 top-1/2 -translate-y-1/2\\\\\\\">\\\\n          ❓\\\\n        </span>\\\\n      }\\\\n    />\\\\n  </div>\\\\n</FormField>\\\\n```\\\\n\\\\n### 2. 操作提示\\\\n\\\\n```tsx\\\\n<Tooltip\\\\n  title=\\\\\\\"点击删除此项目\\\\\\\"\\\\n  trigger=\\\\\\\"hover\\\\\\\"\\\\n  triggerElement={\\\\n    <Button type=\\\\\\\"danger\\\\\\\" size=\\\\\\\"sm\\\\\\\">\\\\n      删除\\\\n    </Button>\\\\n  }\\\\n/>\\\\n```\\\\n\\\\n### 3. 状态提示\\\\n\\\\n```tsx\\\\n<div class=\\\\\\\"flex items-center space-x-2\\\\\\\">\\\\n  <span>状态:</span>\\\\n  <span class=\\\\\\\"inline-flex items-center\\\\\\\">\\\\n    <span class=\\\\\\\"w-2 h-2 rounded-full bg-success-500 mr-1\\\\\\\"></span>\\\\n    在线\\\\n    <Tooltip\\\\n      title=\\\\\\\"最后活跃时间: 2024-01-01 10:00\\\\\\\"\\\\n      placement=\\\\\\\"right\\\\\\\"\\\\n      triggerElement={\\\\n        <span class=\\\\\\\"text-neutral-400 cursor-help\\\\\\\">ℹ️</span>\\\\n      }\\\\n    />\\\\n  </span>\\\\n</div>\\\\n```\\\\n\\\\n### 4. 帮助提示\\\\n\\\\n```tsx\\\\n<div class=\\\\\\\"flex items-center space-x-2\\\\\\\">\\\\n  <span>高级设置</span>\\\\n  <Tooltip\\\\n    title={\\\\n      <div>\\\\n        <p>启用高级设置后，您可以：</p>\\\\n        <ul class=\\\\\\\"list-disc list-inside\\\\\\\">\\\\n          <li>自定义主题</li>\\\\n          <li>配置插件</li>\\\\n          <li>设置权限</li>\\\\n        </ul>\\\\n      </div>\\\\n    }\\\\n    placement=\\\\\\\"right\\\\\\\"\\\\n    triggerElement={\\\\n      <span class=\\\\\\\"text-primary-500 cursor-help\\\\\\\">❓</span>\\\\n    }\\\\n  />\\\\n</div>\\\\n```\\\\n\\\\n## 常见问题\\\\n\\\\n### Q: 如何自定义提示的位置？\\\\n\\\\nA: 使用 `placement` 属性设置提示的位置。\\\\n\\\\n### Q: 如何自定义提示的触发方式？\\\\n\\\\nA: 使用 `trigger` 属性设置提示的触发方式。\\\\n\\\\n### Q: 如何禁用提示？\\\\n\\\\nA: 使用 `disabled` 属性禁用提示。\\\\n\\\\n### Q: 如何实现富文本提示？\\\\n\\\\nA: 使用 `title` 属性传入 VNode 实现富文本提示。\\\\n\\\\n---\\\\n\\\\n🌹 Tooltip 组件文档完成！\\\\n\",\"originAcceptText\":\"# Tooltip 文字提示\\n\\n简单的文字提示气泡框。\\n\\n## 何时使用\\n\\n- 鼠标移入则显示提示，移出消失，气泡浮层不承载复杂文本和操作。\\n- 可以对文字进行简单提示。\\n\\n## 代码演示\\n\\n### 基础用法\\n\\n```tsx\\nimport { Tooltip } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\n\\nexport default function TooltipBasic() {\\n  return (\\n    <Tooltip title=\\\"提示内容\\\">\\n      <Button>悬停显示</Button>\\n    </Tooltip>\\n  )\\n}\\n```\\n\\n### 位置\\n\\n```tsx\\nimport { Tooltip } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\n\\nexport default function TooltipPlacement() {\\n  return (\\n    <div class=\\\"space-x-2\\\">\\n      <Tooltip title=\\\"顶部提示\\\" placement=\\\"top\\\">\\n        <Button>顶部</Button>\\n      </Tooltip>\\n      <Tooltip title=\\\"底部提示\\\" placement=\\\"bottom\\\">\\n        <Button>底部</Button>\\n      </Tooltip>\\n      <Tooltip title=\\\"左侧提示\\\" placement=\\\"left\\\">\\n        <Button>左侧</Button>\\n      </Tooltip>\\n      <Tooltip title=\\\"右侧提示\\\" placement=\\\"right\\\">\\n        <Button>右侧</Button>\\n      </Tooltip>\\n    </div>\\n  )\\n}\\n```\\n\\n### 触发方式\\n\\n```tsx\\nimport { Tooltip } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\n\\nexport default function TooltipTrigger() {\\n  return (\\n    <div class=\\\"space-x-2\\\">\\n      <Tooltip\\n        title=\\\"悬停提示\\\"\\n        trigger=\\\"hover\\\"\\n        triggerElement={<Button>悬停</Button>}\\n      />\\n      <Tooltip\\n        title=\\\"点击提示\\\"\\n        trigger=\\\"click\\\"\\n        triggerElement={<Button>点击</Button>}\\n      />\\n      <Tooltip\\n        title=\\\"聚焦提示\\\"\\n        trigger=\\\"focus\\\"\\n        triggerElement={<Button>聚焦</Button>}\\n      />\\n    </div>\\n  )\\n}\\n```\\n\\n### 禁用\\n\\n```tsx\\nimport { Tooltip } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\n\\nexport default function TooltipDisabled() {\\n  return (\\n    <div class=\\\"space-x-2\\\">\\n      <Tooltip title=\\\"禁用提示\\\" disabled>\\n        <Button>禁用</Button>\\n      </Tooltip>\\n      <Tooltip title=\\\"可用提示\\\">\\n        <Button>可用</Button>\\n      </Tooltip>\\n    </div>\\n  )\\n}\\n```\\n\\n### 带箭头\\n\\n```tsx\\nimport { Tooltip } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\n\\nexport default function TooltipArrow() {\\n  return (\\n    <Tooltip\\n      title=\\\"带箭头提示\\\"\\n      arrow\\n      triggerElement={<Button>带箭头</Button>}\\n    />\\n  )\\n}\\n```\\n\\n### 延迟显示\\n\\n```tsx\\nimport { Tooltip } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\n\\nexport default function TooltipDelay() {\\n  return (\\n    <Tooltip\\n      title=\\\"延迟提示\\\"\\n      delay={500}\\n      triggerElement={<Button>延迟500ms</Button>}\\n    />\\n  )\\n}\\n```\\n\\n### 富文本\\n\\n```tsx\\nimport { Tooltip } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\n\\nexport default function TooltipRichText() {\\n  return (\\n    <Tooltip\\n      title={\\n        <div>\\n          <p><strong>加粗文本</strong></p>\\n          <p><em>斜体文本</em></p>\\n        </div>\\n      }\\n      triggerElement={<Button>富文本</Button>}\\n    />\\n  )\\n}\\n```\\n\\n### 自定义颜色\\n\\n```tsx\\nimport { Tooltip } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\n\\nexport default function TooltipColor() {\\n  return (\\n    <div class=\\\"space-x-2\\\">\\n      <Tooltip\\n        title=\\\"主要提示\\\"\\n        color=\\\"primary\\\"\\n        triggerElement={<Button>主要</Button>}\\n      />\\n      <Tooltip\\n        title=\\\"成功提示\\\"\\n        color=\\\"success\\\"\\n        triggerElement={<Button>成功</Button>}\\n      />\\n      <Tooltip\\n        title=\\\"警告提示\\\"\\n        color=\\\"warning\\\"\\n        triggerElement={<Button>警告</Button>}\\n      />\\n      <Tooltip\\n        title=\\\"危险提示\\\"\\n        color=\\\"danger\\\"\\n        triggerElement={<Button>危险</Button>}\\n      />\\n    </div>\\n  )\\n}\\n```\\n\\n## API\\n\\n### Tooltip Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| title | 提示内容 | `string \\\\| VNode` | - |\\n| trigger | 触发方式 | `string` | `hover` / `click` / `focus` | `hover` |\\n| triggerElement | 触发元素 | `VNode` | - |\\n| placement | 位置 | `string` | `top` / `bottom` / `left` / `right` | `top` |\\n| disabled | 是否禁用 | `boolean` | `false` |\\n| arrow | 是否显示箭头 | `boolean` | `false` |\\n| delay | 延迟显示（毫秒） | `number` | - |\\n| onVisibleChange | 显示状态变化回调 | `Function` | - |\\n| className | 自定义类名 | `string` | - |\\n\\n## 样式定制\\n\\n### CSS 变量\\n\\n```css\\n.tooltip {\\n  --tooltip-bg: #1f2937;\\n  --tooltip-text: #ffffff;\\n  --tooltip-arrow-color: #1f2937;\\n  --tooltip-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);\\n  --tooltip-padding: 0.5rem 0.75rem;\\n  --tooltip-font-size: 0.875rem;\\n}\\n```\\n\\n### 自定义样式\\n\\n```tsx\\n<Tooltip\\n  className=\\\"custom-tooltip\\\"\\n  title=\\\"自定义提示\\\"\\n  triggerElement={<Button>自定义</Button>}\\n/>\\n\\n<style>\\n.custom-tooltip .tooltip-content {\\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\\n  color: white;\\n  padding: 1rem;\\n  border-radius: 0.5rem;\\n}\\n</style>\\n```\\n\\n## 最佳实践\\n\\n### 1. 表单提示\\n\\n```tsx\\n<FormField name=\\\"username\\\" label=\\\"用户名\\\" required>\\n  <div class=\\\"relative\\\">\\n    <Input type=\\\"text\\\" placeholder=\\\"请输入用户名\\\" />\\n    <Tooltip\\n      title=\\\"用户名长度为4-20个字符\\\"\\n      placement=\\\"right\\\"\\n      triggerElement={\\n        <span class=\\\"absolute right-2 top-1/2 -translate-y-1/2\\\">\\n          ❓\\n        </span>\\n      }\\n    />\\n  </div>\\n</FormField>\\n```\\n\\n### 2. 操作提示\\n\\n```tsx\\n<Tooltip\\n  title=\\\"点击删除此项目\\\"\\n  trigger=\\\"hover\\\"\\n  triggerElement={\\n    <Button type=\\\"danger\\\" size=\\\"sm\\\">\\n      删除\\n    </Button>\\n  }\\n/>\\n```\\n\\n### 3. 状态提示\\n\\n```tsx\\n<div class=\\\"flex items-center space-x-2\\\">\\n  <span>状态:</span>\\n  <span class=\\\"inline-flex items-center\\\">\\n    <span class=\\\"w-2 h-2 rounded-full bg-success-500 mr-1\\\"></span>\\n    在线\\n    <Tooltip\\n      title=\\\"最后活跃时间: 2024-01-01 10:00\\\"\\n      placement=\\\"right\\\"\\n      triggerElement={\\n        <span class=\\\"text-neutral-400 cursor-help\\\">ℹ️</span>\\n      }\\n    />\\n  </span>\\n</div>\\n```\\n\\n### 4. 帮助提示\\n\\n```tsx\\n<div class=\\\"flex items-center space-x-2\\\">\\n  <span>高级设置</span>\\n  <Tooltip\\n    title={\\n      <div>\\n        <p>启用高级设置后，您可以：</p>\\n        <ul class=\\\"list-disc list-inside\\\">\\n          <li>自定义主题</li>\\n          <li>配置插件</li>\\n          <li>设置权限</li>\\n        </ul>\\n      </div>\\n    }\\n    placement=\\\"right\\\"\\n    triggerElement={\\n      <span class=\\\"text-primary-500 cursor-help\\\">❓</span>\\n    }\\n  />\\n</div>\\n```\\n\\n## 常见问题\\n\\n### Q: 如何自定义提示的位置？\\n\\nA: 使用 `placement` 属性设置提示的位置。\\n\\n### Q: 如何自定义提示的触发方式？\\n\\nA: 使用 `trigger` 属性设置提示的触发方式。\\n\\n### Q: 如何禁用提示？\\n\\nA: 使用 `disabled` 属性禁用提示。\\n\\n### Q: 如何实现富文本提示？\\n\\nA: 使用 `title` 属性传入 VNode 实现富文本提示。\\n\\n---\\n\\n🌹 Tooltip 组件文档完成！\\n\",\"originTextLength\":5984,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768948206691}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/components/UI/docs/components/Layout.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":216,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":216,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# Layout 布局\\\\n\\\\n协助进行页面级整体布局。\\\\n\\\\n## 何时使用\\\\n\\\\n- 页面整体布局\\\\n- 结构化的页面布局\\\\n\\\\n## 代码演示\\\\n\\\\n### 基础用法\\\\n\\\\n```tsx\\\\nimport { Layout, LayoutHeader, LayoutContent, LayoutSider, LayoutFooter } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function LayoutBasic() {\\\\n  return (\\\\n    <Layout>\\\\n      <LayoutHeader>头部</LayoutHeader>\\\\n      <LayoutContent>内容</LayoutContent>\\\\n      <LayoutFooter>底部</LayoutFooter>\\\\n    </Layout>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 带侧边栏\\\\n\\\\n```tsx\\\\nimport { Layout, LayoutHeader, LayoutContent, LayoutSider, LayoutFooter } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function LayoutWithSider() {\\\\n  return (\\\\n    <Layout>\\\\n      <LayoutHeader>头部</LayoutHeader>\\\\n      <Layout>\\\\n        <LayoutSider>侧边栏</LayoutSider>\\\\n        <LayoutContent>内容</LayoutContent>\\\\n      </Layout>\\\\n      <LayoutFooter>底部</LayoutFooter>\\\\n    </Layout>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 固定头部\\\\n\\\\n```tsx\\\\nimport { Layout, LayoutHeader, LayoutContent } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function LayoutFixedHeader() {\\\\n  return (\\\\n    <Layout>\\\\n      <LayoutHeader fixed>固定头部</LayoutHeader>\\\\n      <LayoutContent>内容</LayoutContent>\\\\n    </Layout>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 固定侧边栏\\\\n\\\\n```tsx\\\\nimport { Layout, LayoutContent, LayoutSider } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function LayoutFixedSider() {\\\\n  return (\\\\n    <Layout>\\\\n      <LayoutSider fixed>固定侧边栏</LayoutSider>\\\\n      <LayoutContent>内容</LayoutContent>\\\\n    </Layout>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 可折叠侧边栏\\\\n\\\\n```tsx\\\\nimport { Layout, LayoutContent, LayoutSider } from \\\\'@/components/UI\\\\'\\\\nimport { ref } from \\\\'vue\\\\'\\\\n\\\\nexport default function LayoutCollapsibleSider() {\\\\n  const collapsed = ref(false)\\\\n\\\\n  return (\\\\n    <Layout>\\\\n      <LayoutSider collapsible collapsed={collapsed.value}>\\\\n        <button onClick={() => collapsed.value = !collapsed.value}>\\\\n          {collapsed.value ? \\\\'展开\\\\' : \\\\'收起\\\\'}\\\\n        </button>\\\\n      </LayoutSider>\\\\n      <LayoutContent>内容</LayoutContent>\\\\n    </Layout>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n## API\\\\n\\\\n### Layout Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| fixed | 是否固定 | `boolean` | `false` |\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n### LayoutHeader Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| fixed | 是否固定 | `boolean` | `false` |\\\\n| height | 高度 | `number` | `64` |\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n### LayoutContent Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n### LayoutSider Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| placement | 位置 | `string` | `left` / `right` | `left` |\\\\n| width | 宽度 | `number` | `200` |\\\\n| collapsible | 是否可折叠 | `boolean` | `false` |\\\\n| collapsed | 是否折叠 | `boolean` | `false` |\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n### LayoutFooter Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| fixed | 是否固定 | `boolean` | `false` |\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n## 样式定制\\\\n\\\\n### CSS 变量\\\\n\\\\n```css\\\\n.layout {\\\\n  --layout-bg: #ffffff;\\\\n  --layout-header-bg: #1f2937;\\\\n  --layout-header-text: #ffffff;\\\\n  --layout-sider-bg: #f9fafb;\\\\n  --layout-footer-bg: #f9fafb;\\\\n  --layout-footer-text: #6b7280;\\\\n}\\\\n```\\\\n\\\\n### 自定义样式\\\\n\\\\n```tsx\\\\n<Layout className=\\\\\\\"custom-layout\\\\\\\">\\\\n  <LayoutHeader>头部</LayoutHeader>\\\\n  <LayoutContent>内容</LayoutContent>\\\\n</Layout>\\\\n\\\\n<style>\\\\n.custom-layout .layout-header {\\\\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\\\\n}\\\\n\\\\n.custom-layout .layout-sider {\\\\n  background: #f3f4f6;\\\\n}\\\\n</style>\\\\n```\\\\n\\\\n## 最佳实践\\\\n\\\\n### 1. 管理后台布局\\\\n\\\\n```tsx\\\\n<Layout>\\\\n  <LayoutHeader fixed>\\\\n    <div class=\\\\\\\"flex items-center justify-between\\\\\\\">\\\\n      <h1>YYC³ 管理后台</h1>\\\\n      <div class=\\\\\\\"flex items-center space-x-4\\\\\\\">\\\\n        <span>管理员</span>\\\\n        <Button onClick={handleLogout}>退出</Button>\\\\n      </div>\\\\n    </div>\\\\n  </LayoutHeader>\\\\n  <Layout>\\\\n    <LayoutSider width={240}>\\\\n      <Menu>\\\\n        <MenuItem>首页</MenuItem>\\\\n        <MenuItem>用户管理</MenuItem>\\\\n        <MenuItem>订单管理</MenuItem>\\\\n      </Menu>\\\\n    </LayoutSider>\\\\n    <LayoutContent>\\\\n      <RouterView />\\\\n    </LayoutContent>\\\\n  </Layout>\\\\n</Layout>\\\\n```\\\\n\\\\n### 2. 电商前台布局\\\\n\\\\n```tsx\\\\n<Layout>\\\\n  <LayoutHeader>\\\\n    <div class=\\\\\\\"flex items-center justify-between\\\\\\\">\\\\n      <h1>YYC³ 商城</h1>\\\\n      <div class=\\\\\\\"flex items-center space-x-4\\\\\\\">\\\\n        <Button>登录</Button>\\\\n        <Button type=\\\\\\\"primary\\\\\\\">注册</Button>\\\\n      </div>\\\\n    </div>\\\\n  </LayoutHeader>\\\\n  <LayoutContent>\\\\n    <RouterView />\\\\n  </LayoutContent>\\\\n  <LayoutFooter>\\\\n    <div class=\\\\\\\"text-center\\\\\\\">\\\\n      <p>© 2024 YYC³. All rights reserved.</p>\\\\n    </div>\\\\n  </LayoutFooter>\\\\n</Layout>\\\\n```\\\\n\\\\n### 3. 博客布局\\\\n\\\\n```tsx\\\\n<Layout>\\\\n  <LayoutHeader>\\\\n    <div class=\\\\\\\"flex items-center justify-between\\\\\\\">\\\\n      <h1>YYC³ 博客</h1>\\\\n      <div class=\\\\\\\"flex items-center space-x-4\\\\\\\">\\\\n        <a href=\\\\\\\"/\\\\\\\">首页</a>\\\\n        <a href=\\\\\\\"/about\\\\\\\">关于</a>\\\\n        <a href=\\\\\\\"/contact\\\\\\\">联系</a>\\\\n      </div>\\\\n    </div>\\\\n  </LayoutHeader>\\\\n  <LayoutContent>\\\\n    <div class=\\\\\\\"max-w-4xl mx-auto\\\\\\\">\\\\n      <RouterView />\\\\n    </div>\\\\n  </LayoutContent>\\\\n  <LayoutFooter>\\\\n    <div class=\\\\\\\"text-center\\\\\\\">\\\\n      <p>© 2024 YYC³. All rights reserved.</p>\\\\n    </div>\\\\n  </LayoutFooter>\\\\n</Layout>\\\\n```\\\\n\\\\n## 常见问题\\\\n\\\\n### Q: 如何固定头部？\\\\n\\\\nA: 使用 `LayoutHeader` 的 `fixed` 属性固定头部。\\\\n\\\\n### Q: 如何实现可折叠侧边栏？\\\\n\\\\nA: 使用 `LayoutSider` 的 `collapsible` 和 `collapsed` 属性实现可折叠侧边栏。\\\\n\\\\n### Q: 如何自定义布局的样式？\\\\n\\\\nA: 使用 `className` 属性添加自定义类名，然后使用 CSS 自定义样式。\\\\n\\\\n---\\\\n\\\\n🌹 Layout 组件文档完成！\\\\n\",\"originAcceptText\":\"# Layout 布局\\n\\n协助进行页面级整体布局。\\n\\n## 何时使用\\n\\n- 页面整体布局\\n- 结构化的页面布局\\n\\n## 代码演示\\n\\n### 基础用法\\n\\n```tsx\\nimport { Layout, LayoutHeader, LayoutContent, LayoutSider, LayoutFooter } from '@/components/UI'\\n\\nexport default function LayoutBasic() {\\n  return (\\n    <Layout>\\n      <LayoutHeader>头部</LayoutHeader>\\n      <LayoutContent>内容</LayoutContent>\\n      <LayoutFooter>底部</LayoutFooter>\\n    </Layout>\\n  )\\n}\\n```\\n\\n### 带侧边栏\\n\\n```tsx\\nimport { Layout, LayoutHeader, LayoutContent, LayoutSider, LayoutFooter } from '@/components/UI'\\n\\nexport default function LayoutWithSider() {\\n  return (\\n    <Layout>\\n      <LayoutHeader>头部</LayoutHeader>\\n      <Layout>\\n        <LayoutSider>侧边栏</LayoutSider>\\n        <LayoutContent>内容</LayoutContent>\\n      </Layout>\\n      <LayoutFooter>底部</LayoutFooter>\\n    </Layout>\\n  )\\n}\\n```\\n\\n### 固定头部\\n\\n```tsx\\nimport { Layout, LayoutHeader, LayoutContent } from '@/components/UI'\\n\\nexport default function LayoutFixedHeader() {\\n  return (\\n    <Layout>\\n      <LayoutHeader fixed>固定头部</LayoutHeader>\\n      <LayoutContent>内容</LayoutContent>\\n    </Layout>\\n  )\\n}\\n```\\n\\n### 固定侧边栏\\n\\n```tsx\\nimport { Layout, LayoutContent, LayoutSider } from '@/components/UI'\\n\\nexport default function LayoutFixedSider() {\\n  return (\\n    <Layout>\\n      <LayoutSider fixed>固定侧边栏</LayoutSider>\\n      <LayoutContent>内容</LayoutContent>\\n    </Layout>\\n  )\\n}\\n```\\n\\n### 可折叠侧边栏\\n\\n```tsx\\nimport { Layout, LayoutContent, LayoutSider } from '@/components/UI'\\nimport { ref } from 'vue'\\n\\nexport default function LayoutCollapsibleSider() {\\n  const collapsed = ref(false)\\n\\n  return (\\n    <Layout>\\n      <LayoutSider collapsible collapsed={collapsed.value}>\\n        <button onClick={() => collapsed.value = !collapsed.value}>\\n          {collapsed.value ? '展开' : '收起'}\\n        </button>\\n      </LayoutSider>\\n      <LayoutContent>内容</LayoutContent>\\n    </Layout>\\n  )\\n}\\n```\\n\\n## API\\n\\n### Layout Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| fixed | 是否固定 | `boolean` | `false` |\\n| className | 自定义类名 | `string` | - |\\n\\n### LayoutHeader Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| fixed | 是否固定 | `boolean` | `false` |\\n| height | 高度 | `number` | `64` |\\n| className | 自定义类名 | `string` | - |\\n\\n### LayoutContent Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| className | 自定义类名 | `string` | - |\\n\\n### LayoutSider Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| placement | 位置 | `string` | `left` / `right` | `left` |\\n| width | 宽度 | `number` | `200` |\\n| collapsible | 是否可折叠 | `boolean` | `false` |\\n| collapsed | 是否折叠 | `boolean` | `false` |\\n| className | 自定义类名 | `string` | - |\\n\\n### LayoutFooter Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| fixed | 是否固定 | `boolean` | `false` |\\n| className | 自定义类名 | `string` | - |\\n\\n## 样式定制\\n\\n### CSS 变量\\n\\n```css\\n.layout {\\n  --layout-bg: #ffffff;\\n  --layout-header-bg: #1f2937;\\n  --layout-header-text: #ffffff;\\n  --layout-sider-bg: #f9fafb;\\n  --layout-footer-bg: #f9fafb;\\n  --layout-footer-text: #6b7280;\\n}\\n```\\n\\n### 自定义样式\\n\\n```tsx\\n<Layout className=\\\"custom-layout\\\">\\n  <LayoutHeader>头部</LayoutHeader>\\n  <LayoutContent>内容</LayoutContent>\\n</Layout>\\n\\n<style>\\n.custom-layout .layout-header {\\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\\n}\\n\\n.custom-layout .layout-sider {\\n  background: #f3f4f6;\\n}\\n</style>\\n```\\n\\n## 最佳实践\\n\\n### 1. 管理后台布局\\n\\n```tsx\\n<Layout>\\n  <LayoutHeader fixed>\\n    <div class=\\\"flex items-center justify-between\\\">\\n      <h1>YYC³ 管理后台</h1>\\n      <div class=\\\"flex items-center space-x-4\\\">\\n        <span>管理员</span>\\n        <Button onClick={handleLogout}>退出</Button>\\n      </div>\\n    </div>\\n  </LayoutHeader>\\n  <Layout>\\n    <LayoutSider width={240}>\\n      <Menu>\\n        <MenuItem>首页</MenuItem>\\n        <MenuItem>用户管理</MenuItem>\\n        <MenuItem>订单管理</MenuItem>\\n      </Menu>\\n    </LayoutSider>\\n    <LayoutContent>\\n      <RouterView />\\n    </LayoutContent>\\n  </Layout>\\n</Layout>\\n```\\n\\n### 2. 电商前台布局\\n\\n```tsx\\n<Layout>\\n  <LayoutHeader>\\n    <div class=\\\"flex items-center justify-between\\\">\\n      <h1>YYC³ 商城</h1>\\n      <div class=\\\"flex items-center space-x-4\\\">\\n        <Button>登录</Button>\\n        <Button type=\\\"primary\\\">注册</Button>\\n      </div>\\n    </div>\\n  </LayoutHeader>\\n  <LayoutContent>\\n    <RouterView />\\n  </LayoutContent>\\n  <LayoutFooter>\\n    <div class=\\\"text-center\\\">\\n      <p>© 2024 YYC³. All rights reserved.</p>\\n    </div>\\n  </LayoutFooter>\\n</Layout>\\n```\\n\\n### 3. 博客布局\\n\\n```tsx\\n<Layout>\\n  <LayoutHeader>\\n    <div class=\\\"flex items-center justify-between\\\">\\n      <h1>YYC³ 博客</h1>\\n      <div class=\\\"flex items-center space-x-4\\\">\\n        <a href=\\\"/\\\">首页</a>\\n        <a href=\\\"/about\\\">关于</a>\\n        <a href=\\\"/contact\\\">联系</a>\\n      </div>\\n    </div>\\n  </LayoutHeader>\\n  <LayoutContent>\\n    <div class=\\\"max-w-4xl mx-auto\\\">\\n      <RouterView />\\n    </div>\\n  </LayoutContent>\\n  <LayoutFooter>\\n    <div class=\\\"text-center\\\">\\n      <p>© 2024 YYC³. All rights reserved.</p>\\n    </div>\\n  </LayoutFooter>\\n</Layout>\\n```\\n\\n## 常见问题\\n\\n### Q: 如何固定头部？\\n\\nA: 使用 `LayoutHeader` 的 `fixed` 属性固定头部。\\n\\n### Q: 如何实现可折叠侧边栏？\\n\\nA: 使用 `LayoutSider` 的 `collapsible` 和 `collapsed` 属性实现可折叠侧边栏。\\n\\n### Q: 如何自定义布局的样式？\\n\\nA: 使用 `className` 属性添加自定义类名，然后使用 CSS 自定义样式。\\n\\n---\\n\\n🌹 Layout 组件文档完成！\\n\",\"originTextLength\":5115,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768948232638}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/components/UI/docs/components/Grid.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":223,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":223,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# Grid 栅格\\\\n\\\\n24 栅格系统。\\\\n\\\\n## 何时使用\\\\n\\\\n- 在多数业务情况下，Ant Design 需要在设计区域内解决大量信息收纳的问题，因此，在设计层面采用栅格系统来解决布局问题。将页面宽度划分为 24 等分，通过 `col` 组件在需要的位置引入。\\\\n\\\\n## 代码演示\\\\n\\\\n### 基础用法\\\\n\\\\n```tsx\\\\nimport { Grid, GridRow, GridCol } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function GridBasic() {\\\\n  return (\\\\n    <Grid>\\\\n      <GridRow>\\\\n        <GridCol span={8}>col-8</GridCol>\\\\n        <GridCol span={8}>col-8</GridCol>\\\\n        <GridCol span={8}>col-8</GridCol>\\\\n      </GridRow>\\\\n    </Grid>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 间距\\\\n\\\\n```tsx\\\\nimport { Grid, GridRow, GridCol } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function GridGutter() {\\\\n  return (\\\\n    <Grid>\\\\n      <GridRow gutter={16}>\\\\n        <GridCol span={8}>col-8</GridCol>\\\\n        <GridCol span={8}>col-8</GridCol>\\\\n        <GridCol span={8}>col-8</GridCol>\\\\n      </GridRow>\\\\n    </Grid>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 对齐\\\\n\\\\n```tsx\\\\nimport { Grid, GridRow, GridCol } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function GridAlign() {\\\\n  return (\\\\n    <Grid>\\\\n      <GridRow align=\\\\\\\"center\\\\\\\">\\\\n        <GridCol span={8}>居中对齐</GridCol>\\\\n        <GridCol span={8}>居中对齐</GridCol>\\\\n        <GridCol span={8}>居中对齐</GridCol>\\\\n      </GridRow>\\\\n    </Grid>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 偏移\\\\n\\\\n```tsx\\\\nimport { Grid, GridRow, GridCol } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function GridOffset() {\\\\n  return (\\\\n    <Grid>\\\\n      <GridRow>\\\\n        <GridCol span={6}>col-6</GridCol>\\\\n        <GridCol span={6} offset={6}>col-6 offset-6</GridCol>\\\\n        <GridCol span={6} offset={6}>col-6 offset-6</GridCol>\\\\n      </GridRow>\\\\n    </Grid>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 推拉\\\\n\\\\n```tsx\\\\nimport { Grid, GridRow, GridCol } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function GridPushPull() {\\\\n  return (\\\\n    <Grid>\\\\n      <GridRow>\\\\n        <GridCol span={18} push={6}>col-18 push-6</GridCol>\\\\n        <GridCol span={6} pull={18}>col-6 pull-18</GridCol>\\\\n      </GridRow>\\\\n    </Grid>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 响应式\\\\n\\\\n```tsx\\\\nimport { Grid, GridRow, GridCol } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function GridResponsive() {\\\\n  return (\\\\n    <Grid>\\\\n      <GridRow>\\\\n        <GridCol xs={24} sm={12} md={8} lg={6} xl={4}>\\\\n          xs-24 sm-12 md-8 lg-6 xl-4\\\\n        </GridCol>\\\\n        <GridCol xs={24} sm={12} md={8} lg={6} xl={4}>\\\\n          xs-24 sm-12 md-8 lg-6 xl-4\\\\n        </GridCol>\\\\n        <GridCol xs={24} sm={12} md={8} lg={6} xl={4}>\\\\n          xs-24 sm-12 md-8 lg-6 xl-4\\\\n        </GridCol>\\\\n        <GridCol xs={24} sm={12} md={8} lg={6} xl={4}>\\\\n          xs-24 sm-12 md-8 lg-6 xl-4\\\\n        </GridCol>\\\\n        <GridCol xs={24} sm={12} md={8} lg={6} xl={4}>\\\\n          xs-24 sm-12 md-8 lg-6 xl-4\\\\n        </GridCol>\\\\n        <GridCol xs={24} sm={12} md={8} lg={6} xl={4}>\\\\n          xs-24 sm-12 md-8 lg-6 xl-4\\\\n        </GridCol>\\\\n      </GridRow>\\\\n    </Grid>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n## API\\\\n\\\\n### Grid Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n### GridRow Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| gutter | 栅格间距 | `number` | `0` |\\\\n| align | 垂直对齐 | `string` | `top` / `middle` / `bottom` | `top` |\\\\n| justify | 水平排列 | `string` | `start` / `center` / `end` / `space-between` / `space-around` | `start` |\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n### GridCol Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| span | 栅格占位格数 | `number` | `24` |\\\\n| offset | 栅格左侧的间隔格数 | `number` | `0` |\\\\n| push | 栅格向右移动格数 | `number` | `0` |\\\\n| pull | 栅格向左移动格数 | `number` | `0` |\\\\n| xs | `<576px` 响应式栅格 | `number` | - |\\\\n| sm | `≥576px` 响应式栅格 | `number` | - |\\\\n| md | `≥768px` 响应式栅格 | `number` | - |\\\\n| lg | `≥992px` 响应式栅格 | `number` | - |\\\\n| xl | `≥1200px` 响应式栅格 | `number` | - |\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n## 样式定制\\\\n\\\\n### CSS 变量\\\\n\\\\n```css\\\\n.grid {\\\\n  --grid-gap: 0;\\\\n  --grid-bg: #ffffff;\\\\n  --grid-border: #e5e7eb;\\\\n}\\\\n```\\\\n\\\\n### 自定义样式\\\\n\\\\n```tsx\\\\n<Grid className=\\\\\\\"custom-grid\\\\\\\">\\\\n  <GridRow>\\\\n    <GridCol span={8}>自定义</GridCol>\\\\n  </GridRow>\\\\n</Grid>\\\\n\\\\n<style>\\\\n.custom-grid .grid-col {\\\\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\\\\n  color: white;\\\\n  padding: 1rem;\\\\n  border-radius: 0.5rem;\\\\n}\\\\n</style>\\\\n```\\\\n\\\\n## 最佳实践\\\\n\\\\n### 1. 基础布局\\\\n\\\\n```tsx\\\\n<Grid>\\\\n  <GridRow gutter={16}>\\\\n    <GridCol span={8}>\\\\n      <Card>左侧</Card>\\\\n    </GridCol>\\\\n    <GridCol span={16}>\\\\n      <Card>右侧</Card>\\\\n    </GridCol>\\\\n  </GridRow>\\\\n</Grid>\\\\n```\\\\n\\\\n### 2. 响应式布局\\\\n\\\\n```tsx\\\\n<Grid>\\\\n  <GridRow gutter={16}>\\\\n    <GridCol xs={24} sm={12} md={8} lg={6}>\\\\n      <Card>卡片1</Card>\\\\n    </GridCol>\\\\n    <GridCol xs={24} sm={12} md={8} lg={6}>\\\\n      <Card>卡片2</Card>\\\\n    </GridCol>\\\\n    <GridCol xs={24} sm={12} md={8} lg={6}>\\\\n      <Card>卡片3</Card>\\\\n    </GridCol>\\\\n    <GridCol xs={24} sm={12} md={8} lg={6}>\\\\n      <Card>卡片4</Card>\\\\n    </GridCol>\\\\n  </GridRow>\\\\n</Grid>\\\\n```\\\\n\\\\n### 3. 表单布局\\\\n\\\\n```tsx\\\\n<Grid>\\\\n  <GridRow gutter={16}>\\\\n    <GridCol xs={24} sm={12}>\\\\n      <FormField name=\\\\\\\"username\\\\\\\" label=\\\\\\\"用户名\\\\\\\">\\\\n        <Input type=\\\\\\\"text\\\\\\\" />\\\\n      </FormField>\\\\n    </GridCol>\\\\n    <GridCol xs={24} sm={12}>\\\\n      <FormField name=\\\\\\\"email\\\\\\\" label=\\\\\\\"邮箱\\\\\\\">\\\\n        <Input type=\\\\\\\"email\\\\\\\" />\\\\n      </FormField>\\\\n    </GridCol>\\\\n    <GridCol xs={24}>\\\\n      <FormField name=\\\\\\\"address\\\\\\\" label=\\\\\\\"地址\\\\\\\">\\\\n        <Input type=\\\\\\\"text\\\\\\\" />\\\\n      </FormField>\\\\n    </GridCol>\\\\n  </GridRow>\\\\n</Grid>\\\\n```\\\\n\\\\n## 常见问题\\\\n\\\\n### Q: 如何设置栅格间距？\\\\n\\\\nA: 使用 `GridRow` 的 `gutter` 属性设置栅格间距。\\\\n\\\\n### Q: 如何实现响应式布局？\\\\n\\\\nA: 使用 `xs`、`sm`、`md`、`lg`、`xl` 属性设置响应式栅格。\\\\n\\\\n### Q: 如何实现栅格的偏移？\\\\n\\\\nA: 使用 `offset`、`push`、`pull` 属性实现栅格的偏移。\\\\n\\\\n---\\\\n\\\\n🌹 Grid 组件文档完成！\\\\n\",\"originAcceptText\":\"# Grid 栅格\\n\\n24 栅格系统。\\n\\n## 何时使用\\n\\n- 在多数业务情况下，Ant Design 需要在设计区域内解决大量信息收纳的问题，因此，在设计层面采用栅格系统来解决布局问题。将页面宽度划分为 24 等分，通过 `col` 组件在需要的位置引入。\\n\\n## 代码演示\\n\\n### 基础用法\\n\\n```tsx\\nimport { Grid, GridRow, GridCol } from '@/components/UI'\\n\\nexport default function GridBasic() {\\n  return (\\n    <Grid>\\n      <GridRow>\\n        <GridCol span={8}>col-8</GridCol>\\n        <GridCol span={8}>col-8</GridCol>\\n        <GridCol span={8}>col-8</GridCol>\\n      </GridRow>\\n    </Grid>\\n  )\\n}\\n```\\n\\n### 间距\\n\\n```tsx\\nimport { Grid, GridRow, GridCol } from '@/components/UI'\\n\\nexport default function GridGutter() {\\n  return (\\n    <Grid>\\n      <GridRow gutter={16}>\\n        <GridCol span={8}>col-8</GridCol>\\n        <GridCol span={8}>col-8</GridCol>\\n        <GridCol span={8}>col-8</GridCol>\\n      </GridRow>\\n    </Grid>\\n  )\\n}\\n```\\n\\n### 对齐\\n\\n```tsx\\nimport { Grid, GridRow, GridCol } from '@/components/UI'\\n\\nexport default function GridAlign() {\\n  return (\\n    <Grid>\\n      <GridRow align=\\\"center\\\">\\n        <GridCol span={8}>居中对齐</GridCol>\\n        <GridCol span={8}>居中对齐</GridCol>\\n        <GridCol span={8}>居中对齐</GridCol>\\n      </GridRow>\\n    </Grid>\\n  )\\n}\\n```\\n\\n### 偏移\\n\\n```tsx\\nimport { Grid, GridRow, GridCol } from '@/components/UI'\\n\\nexport default function GridOffset() {\\n  return (\\n    <Grid>\\n      <GridRow>\\n        <GridCol span={6}>col-6</GridCol>\\n        <GridCol span={6} offset={6}>col-6 offset-6</GridCol>\\n        <GridCol span={6} offset={6}>col-6 offset-6</GridCol>\\n      </GridRow>\\n    </Grid>\\n  )\\n}\\n```\\n\\n### 推拉\\n\\n```tsx\\nimport { Grid, GridRow, GridCol } from '@/components/UI'\\n\\nexport default function GridPushPull() {\\n  return (\\n    <Grid>\\n      <GridRow>\\n        <GridCol span={18} push={6}>col-18 push-6</GridCol>\\n        <GridCol span={6} pull={18}>col-6 pull-18</GridCol>\\n      </GridRow>\\n    </Grid>\\n  )\\n}\\n```\\n\\n### 响应式\\n\\n```tsx\\nimport { Grid, GridRow, GridCol } from '@/components/UI'\\n\\nexport default function GridResponsive() {\\n  return (\\n    <Grid>\\n      <GridRow>\\n        <GridCol xs={24} sm={12} md={8} lg={6} xl={4}>\\n          xs-24 sm-12 md-8 lg-6 xl-4\\n        </GridCol>\\n        <GridCol xs={24} sm={12} md={8} lg={6} xl={4}>\\n          xs-24 sm-12 md-8 lg-6 xl-4\\n        </GridCol>\\n        <GridCol xs={24} sm={12} md={8} lg={6} xl={4}>\\n          xs-24 sm-12 md-8 lg-6 xl-4\\n        </GridCol>\\n        <GridCol xs={24} sm={12} md={8} lg={6} xl={4}>\\n          xs-24 sm-12 md-8 lg-6 xl-4\\n        </GridCol>\\n        <GridCol xs={24} sm={12} md={8} lg={6} xl={4}>\\n          xs-24 sm-12 md-8 lg-6 xl-4\\n        </GridCol>\\n        <GridCol xs={24} sm={12} md={8} lg={6} xl={4}>\\n          xs-24 sm-12 md-8 lg-6 xl-4\\n        </GridCol>\\n      </GridRow>\\n    </Grid>\\n  )\\n}\\n```\\n\\n## API\\n\\n### Grid Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| className | 自定义类名 | `string` | - |\\n\\n### GridRow Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| gutter | 栅格间距 | `number` | `0` |\\n| align | 垂直对齐 | `string` | `top` / `middle` / `bottom` | `top` |\\n| justify | 水平排列 | `string` | `start` / `center` / `end` / `space-between` / `space-around` | `start` |\\n| className | 自定义类名 | `string` | - |\\n\\n### GridCol Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| span | 栅格占位格数 | `number` | `24` |\\n| offset | 栅格左侧的间隔格数 | `number` | `0` |\\n| push | 栅格向右移动格数 | `number` | `0` |\\n| pull | 栅格向左移动格数 | `number` | `0` |\\n| xs | `<576px` 响应式栅格 | `number` | - |\\n| sm | `≥576px` 响应式栅格 | `number` | - |\\n| md | `≥768px` 响应式栅格 | `number` | - |\\n| lg | `≥992px` 响应式栅格 | `number` | - |\\n| xl | `≥1200px` 响应式栅格 | `number` | - |\\n| className | 自定义类名 | `string` | - |\\n\\n## 样式定制\\n\\n### CSS 变量\\n\\n```css\\n.grid {\\n  --grid-gap: 0;\\n  --grid-bg: #ffffff;\\n  --grid-border: #e5e7eb;\\n}\\n```\\n\\n### 自定义样式\\n\\n```tsx\\n<Grid className=\\\"custom-grid\\\">\\n  <GridRow>\\n    <GridCol span={8}>自定义</GridCol>\\n  </GridRow>\\n</Grid>\\n\\n<style>\\n.custom-grid .grid-col {\\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\\n  color: white;\\n  padding: 1rem;\\n  border-radius: 0.5rem;\\n}\\n</style>\\n```\\n\\n## 最佳实践\\n\\n### 1. 基础布局\\n\\n```tsx\\n<Grid>\\n  <GridRow gutter={16}>\\n    <GridCol span={8}>\\n      <Card>左侧</Card>\\n    </GridCol>\\n    <GridCol span={16}>\\n      <Card>右侧</Card>\\n    </GridCol>\\n  </GridRow>\\n</Grid>\\n```\\n\\n### 2. 响应式布局\\n\\n```tsx\\n<Grid>\\n  <GridRow gutter={16}>\\n    <GridCol xs={24} sm={12} md={8} lg={6}>\\n      <Card>卡片1</Card>\\n    </GridCol>\\n    <GridCol xs={24} sm={12} md={8} lg={6}>\\n      <Card>卡片2</Card>\\n    </GridCol>\\n    <GridCol xs={24} sm={12} md={8} lg={6}>\\n      <Card>卡片3</Card>\\n    </GridCol>\\n    <GridCol xs={24} sm={12} md={8} lg={6}>\\n      <Card>卡片4</Card>\\n    </GridCol>\\n  </GridRow>\\n</Grid>\\n```\\n\\n### 3. 表单布局\\n\\n```tsx\\n<Grid>\\n  <GridRow gutter={16}>\\n    <GridCol xs={24} sm={12}>\\n      <FormField name=\\\"username\\\" label=\\\"用户名\\\">\\n        <Input type=\\\"text\\\" />\\n      </FormField>\\n    </GridCol>\\n    <GridCol xs={24} sm={12}>\\n      <FormField name=\\\"email\\\" label=\\\"邮箱\\\">\\n        <Input type=\\\"email\\\" />\\n      </FormField>\\n    </GridCol>\\n    <GridCol xs={24}>\\n      <FormField name=\\\"address\\\" label=\\\"地址\\\">\\n        <Input type=\\\"text\\\" />\\n      </FormField>\\n    </GridCol>\\n  </GridRow>\\n</Grid>\\n```\\n\\n## 常见问题\\n\\n### Q: 如何设置栅格间距？\\n\\nA: 使用 `GridRow` 的 `gutter` 属性设置栅格间距。\\n\\n### Q: 如何实现响应式布局？\\n\\nA: 使用 `xs`、`sm`、`md`、`lg`、`xl` 属性设置响应式栅格。\\n\\n### Q: 如何实现栅格的偏移？\\n\\nA: 使用 `offset`、`push`、`pull` 属性实现栅格的偏移。\\n\\n---\\n\\n🌹 Grid 组件文档完成！\\n\",\"originTextLength\":5237,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768948253097}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/components/UI/docs/components/Space.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":204,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":204,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# Space 间距\\\\n\\\\n设置组件之间的间距。\\\\n\\\\n## 何时使用\\\\n\\\\n- 避免组件紧贴在一起，设置统一的空间。\\\\n- 适用于行、列中多种对齐方式的布局。\\\\n\\\\n## 代码演示\\\\n\\\\n### 基础用法\\\\n\\\\n```tsx\\\\nimport { Space } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function SpaceBasic() {\\\\n  return (\\\\n    <Space>\\\\n      <Button>按钮1</Button>\\\\n      <Button>按钮2</Button>\\\\n      <Button>按钮3</Button>\\\\n    </Space>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 方向\\\\n\\\\n```tsx\\\\nimport { Space } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function SpaceDirection() {\\\\n  return (\\\\n    <div class=\\\\\\\"space-y-4\\\\\\\">\\\\n      <Space direction=\\\\\\\"horizontal\\\\\\\">\\\\n        <Button>水平1</Button>\\\\n        <Button>水平2</Button>\\\\n        <Button>水平3</Button>\\\\n      </Space>\\\\n      <Space direction=\\\\\\\"vertical\\\\\\\">\\\\n        <Button>垂直1</Button>\\\\n        <Button>垂直2</Button>\\\\n        <Button>垂直3</Button>\\\\n      </Space>\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 尺寸\\\\n\\\\n```tsx\\\\nimport { Space } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function SpaceSize() {\\\\n  return (\\\\n    <div class=\\\\\\\"space-y-4\\\\\\\">\\\\n      <Space size=\\\\\\\"sm\\\\\\\">\\\\n        <Button>小间距</Button>\\\\n        <Button>小间距</Button>\\\\n      </Space>\\\\n      <Space size=\\\\\\\"md\\\\\\\">\\\\n        <Button>中等间距</Button>\\\\n        <Button>中等间距</Button>\\\\n      </Space>\\\\n      <Space size=\\\\\\\"lg\\\\\\\">\\\\n        <Button>大间距</Button>\\\\n        <Button>大间距</Button>\\\\n      </Space>\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 自定义间距\\\\n\\\\n```tsx\\\\nimport { Space } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function SpaceCustomSize() {\\\\n  return (\\\\n    <Space size={24}>\\\\n      <Button>自定义间距</Button>\\\\n      <Button>自定义间距</Button>\\\\n    </Space>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 对齐\\\\n\\\\n```tsx\\\\nimport { Space } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function SpaceAlign() {\\\\n  return (\\\\n    <div class=\\\\\\\"space-y-4\\\\\\\">\\\\n      <Space align=\\\\\\\"start\\\\\\\">\\\\n        <Button>开始对齐</Button>\\\\n        <Button>开始对齐</Button>\\\\n      </Space>\\\\n      <Space align=\\\\\\\"center\\\\\\\">\\\\n        <Button>居中对齐</Button>\\\\n        <Button>居中对齐</Button>\\\\n      </Space>\\\\n      <Space align=\\\\\\\"end\\\\\\\">\\\\n        <Button>结束对齐</Button>\\\\n        <Button>结束对齐</Button>\\\\n      </Space>\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 换行\\\\n\\\\n```tsx\\\\nimport { Space } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function SpaceWrap() {\\\\n  return (\\\\n    <Space wrap>\\\\n      <Button>按钮1</Button>\\\\n      <Button>按钮2</Button>\\\\n      <Button>按钮3</Button>\\\\n      <Button>按钮4</Button>\\\\n      <Button>按钮5</Button>\\\\n    </Space>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 填充\\\\n\\\\n```tsx\\\\nimport { Space } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function SpaceFill() {\\\\n  return (\\\\n    <Space fill>\\\\n      <Button>按钮1</Button>\\\\n      <Button>按钮2</Button>\\\\n      <Button>按钮3</Button>\\\\n    </Space>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n## API\\\\n\\\\n### Space Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| direction | 方向 | `string` | `horizontal` / `vertical` | `horizontal` |\\\\n| size | 间距大小 | `string \\\\\\\\| number` | `sm` / `md` / `lg` | `md` |\\\\n| align | 对齐方式 | `string` | `start` / `center` / `end` | `start` |\\\\n| wrap | 是否换行 | `boolean` | `false` |\\\\n| fill | 是否填充 | `boolean` | `false` |\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n## 样式定制\\\\n\\\\n### CSS 变量\\\\n\\\\n```css\\\\n.space {\\\\n  --space-gap-sm: 0.5rem;\\\\n  --space-gap-md: 1rem;\\\\n  --space-gap-lg: 1.5rem;\\\\n}\\\\n```\\\\n\\\\n### 自定义样式\\\\n\\\\n```tsx\\\\n<Space className=\\\\\\\"custom-space\\\\\\\">\\\\n  <Button>自定义</Button>\\\\n  <Button>自定义</Button>\\\\n</Space>\\\\n\\\\n<style>\\\\n.custom-space {\\\\n  gap: 2rem;\\\\n}\\\\n</style>\\\\n```\\\\n\\\\n## 最佳实践\\\\n\\\\n### 1. 按钮组\\\\n\\\\n```tsx\\\\n<Space>\\\\n  <Button>取消</Button>\\\\n  <Button type=\\\\\\\"primary\\\\\\\">确定</Button>\\\\n</Space>\\\\n```\\\\n\\\\n### 2. 表单操作\\\\n\\\\n```tsx\\\\n<Space>\\\\n  <Button onClick={handleReset}>重置</Button>\\\\n  <Button onClick={handleCancel}>取消</Button>\\\\n  <Button type=\\\\\\\"primary\\\\\\\" onClick={handleSubmit}>提交</Button>\\\\n</Space>\\\\n```\\\\n\\\\n### 3. 操作栏\\\\n\\\\n```tsx\\\\n<Space>\\\\n  <Button onClick={handleEdit}>编辑</Button>\\\\n  <Button onClick={handleCopy}>复制</Button>\\\\n  <Button type=\\\\\\\"danger\\\\\\\" onClick={handleDelete}>删除</Button>\\\\n</Space>\\\\n```\\\\n\\\\n### 4. 响应式按钮组\\\\n\\\\n```tsx\\\\n<Space wrap>\\\\n  <Button>按钮1</Button>\\\\n  <Button>按钮2</Button>\\\\n  <Button>按钮3</Button>\\\\n  <Button>按钮4</Button>\\\\n  <Button>按钮5</Button>\\\\n</Space>\\\\n```\\\\n\\\\n## 常见问题\\\\n\\\\n### Q: 如何设置间距的大小？\\\\n\\\\nA: 使用 `size` 属性设置间距的大小。\\\\n\\\\n### Q: 如何实现垂直排列？\\\\n\\\\nA: 使用 `direction` 属性设置为 `vertical`。\\\\n\\\\n### Q: 如何实现换行？\\\\n\\\\nA: 使用 `wrap` 属性实现换行。\\\\n\\\\n---\\\\n\\\\n🌹 Space 组件文档完成！\\\\n\",\"originAcceptText\":\"# Space 间距\\n\\n设置组件之间的间距。\\n\\n## 何时使用\\n\\n- 避免组件紧贴在一起，设置统一的空间。\\n- 适用于行、列中多种对齐方式的布局。\\n\\n## 代码演示\\n\\n### 基础用法\\n\\n```tsx\\nimport { Space } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\n\\nexport default function SpaceBasic() {\\n  return (\\n    <Space>\\n      <Button>按钮1</Button>\\n      <Button>按钮2</Button>\\n      <Button>按钮3</Button>\\n    </Space>\\n  )\\n}\\n```\\n\\n### 方向\\n\\n```tsx\\nimport { Space } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\n\\nexport default function SpaceDirection() {\\n  return (\\n    <div class=\\\"space-y-4\\\">\\n      <Space direction=\\\"horizontal\\\">\\n        <Button>水平1</Button>\\n        <Button>水平2</Button>\\n        <Button>水平3</Button>\\n      </Space>\\n      <Space direction=\\\"vertical\\\">\\n        <Button>垂直1</Button>\\n        <Button>垂直2</Button>\\n        <Button>垂直3</Button>\\n      </Space>\\n    </div>\\n  )\\n}\\n```\\n\\n### 尺寸\\n\\n```tsx\\nimport { Space } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\n\\nexport default function SpaceSize() {\\n  return (\\n    <div class=\\\"space-y-4\\\">\\n      <Space size=\\\"sm\\\">\\n        <Button>小间距</Button>\\n        <Button>小间距</Button>\\n      </Space>\\n      <Space size=\\\"md\\\">\\n        <Button>中等间距</Button>\\n        <Button>中等间距</Button>\\n      </Space>\\n      <Space size=\\\"lg\\\">\\n        <Button>大间距</Button>\\n        <Button>大间距</Button>\\n      </Space>\\n    </div>\\n  )\\n}\\n```\\n\\n### 自定义间距\\n\\n```tsx\\nimport { Space } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\n\\nexport default function SpaceCustomSize() {\\n  return (\\n    <Space size={24}>\\n      <Button>自定义间距</Button>\\n      <Button>自定义间距</Button>\\n    </Space>\\n  )\\n}\\n```\\n\\n### 对齐\\n\\n```tsx\\nimport { Space } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\n\\nexport default function SpaceAlign() {\\n  return (\\n    <div class=\\\"space-y-4\\\">\\n      <Space align=\\\"start\\\">\\n        <Button>开始对齐</Button>\\n        <Button>开始对齐</Button>\\n      </Space>\\n      <Space align=\\\"center\\\">\\n        <Button>居中对齐</Button>\\n        <Button>居中对齐</Button>\\n      </Space>\\n      <Space align=\\\"end\\\">\\n        <Button>结束对齐</Button>\\n        <Button>结束对齐</Button>\\n      </Space>\\n    </div>\\n  )\\n}\\n```\\n\\n### 换行\\n\\n```tsx\\nimport { Space } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\n\\nexport default function SpaceWrap() {\\n  return (\\n    <Space wrap>\\n      <Button>按钮1</Button>\\n      <Button>按钮2</Button>\\n      <Button>按钮3</Button>\\n      <Button>按钮4</Button>\\n      <Button>按钮5</Button>\\n    </Space>\\n  )\\n}\\n```\\n\\n### 填充\\n\\n```tsx\\nimport { Space } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\n\\nexport default function SpaceFill() {\\n  return (\\n    <Space fill>\\n      <Button>按钮1</Button>\\n      <Button>按钮2</Button>\\n      <Button>按钮3</Button>\\n    </Space>\\n  )\\n}\\n```\\n\\n## API\\n\\n### Space Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| direction | 方向 | `string` | `horizontal` / `vertical` | `horizontal` |\\n| size | 间距大小 | `string \\\\| number` | `sm` / `md` / `lg` | `md` |\\n| align | 对齐方式 | `string` | `start` / `center` / `end` | `start` |\\n| wrap | 是否换行 | `boolean` | `false` |\\n| fill | 是否填充 | `boolean` | `false` |\\n| className | 自定义类名 | `string` | - |\\n\\n## 样式定制\\n\\n### CSS 变量\\n\\n```css\\n.space {\\n  --space-gap-sm: 0.5rem;\\n  --space-gap-md: 1rem;\\n  --space-gap-lg: 1.5rem;\\n}\\n```\\n\\n### 自定义样式\\n\\n```tsx\\n<Space className=\\\"custom-space\\\">\\n  <Button>自定义</Button>\\n  <Button>自定义</Button>\\n</Space>\\n\\n<style>\\n.custom-space {\\n  gap: 2rem;\\n}\\n</style>\\n```\\n\\n## 最佳实践\\n\\n### 1. 按钮组\\n\\n```tsx\\n<Space>\\n  <Button>取消</Button>\\n  <Button type=\\\"primary\\\">确定</Button>\\n</Space>\\n```\\n\\n### 2. 表单操作\\n\\n```tsx\\n<Space>\\n  <Button onClick={handleReset}>重置</Button>\\n  <Button onClick={handleCancel}>取消</Button>\\n  <Button type=\\\"primary\\\" onClick={handleSubmit}>提交</Button>\\n</Space>\\n```\\n\\n### 3. 操作栏\\n\\n```tsx\\n<Space>\\n  <Button onClick={handleEdit}>编辑</Button>\\n  <Button onClick={handleCopy}>复制</Button>\\n  <Button type=\\\"danger\\\" onClick={handleDelete}>删除</Button>\\n</Space>\\n```\\n\\n### 4. 响应式按钮组\\n\\n```tsx\\n<Space wrap>\\n  <Button>按钮1</Button>\\n  <Button>按钮2</Button>\\n  <Button>按钮3</Button>\\n  <Button>按钮4</Button>\\n  <Button>按钮5</Button>\\n</Space>\\n```\\n\\n## 常见问题\\n\\n### Q: 如何设置间距的大小？\\n\\nA: 使用 `size` 属性设置间距的大小。\\n\\n### Q: 如何实现垂直排列？\\n\\nA: 使用 `direction` 属性设置为 `vertical`。\\n\\n### Q: 如何实现换行？\\n\\nA: 使用 `wrap` 属性实现换行。\\n\\n---\\n\\n🌹 Space 组件文档完成！\\n\",\"originTextLength\":4167,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768948268786}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/components/UI/docs/components/Flex.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":230,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":230,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# Flex 弹性布局\\\\n\\\\n弹性布局。\\\\n\\\\n## 何时使用\\\\n\\\\n- 布局\\\\n- 简单的对齐\\\\n- 均分列宽\\\\n- 居中布局\\\\n- 左右两栏布局\\\\n- 自动换行\\\\n- 多行对齐\\\\n\\\\n## 代码演示\\\\n\\\\n### 基础用法\\\\n\\\\n```tsx\\\\nimport { Flex, FlexItem } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function FlexBasic() {\\\\n  return (\\\\n    <Flex>\\\\n      <FlexItem>项目1</FlexItem>\\\\n      <FlexItem>项目2</FlexItem>\\\\n      <FlexItem>项目3</FlexItem>\\\\n    </Flex>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 方向\\\\n\\\\n```tsx\\\\nimport { Flex, FlexItem } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function FlexDirection() {\\\\n  return (\\\\n    <div class=\\\\\\\"space-y-4\\\\\\\">\\\\n      <Flex direction=\\\\\\\"row\\\\\\\">\\\\n        <FlexItem>水平</FlexItem>\\\\n        <FlexItem>水平</FlexItem>\\\\n      </Flex>\\\\n      <Flex direction=\\\\\\\"column\\\\\\\">\\\\n        <FlexItem>垂直</FlexItem>\\\\n        <FlexItem>垂直</FlexItem>\\\\n      </Flex>\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 换行\\\\n\\\\n```tsx\\\\nimport { Flex, FlexItem } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function FlexWrap() {\\\\n  return (\\\\n    <div class=\\\\\\\"space-y-4\\\\\\\">\\\\n      <Flex wrap=\\\\\\\"nowrap\\\\\\\">\\\\n        <FlexItem>不换行</FlexItem>\\\\n        <FlexItem>不换行</FlexItem>\\\\n        <FlexItem>不换行</FlexItem>\\\\n      </Flex>\\\\n      <Flex wrap=\\\\\\\"wrap\\\\\\\">\\\\n        <FlexItem>换行</FlexItem>\\\\n        <FlexItem>换行</FlexItem>\\\\n        <FlexItem>换行</FlexItem>\\\\n      </Flex>\\\\n      <Flex wrap=\\\\\\\"wrap-reverse\\\\\\\">\\\\n        <FlexItem>反向换行</FlexItem>\\\\n        <FlexItem>反向换行</FlexItem>\\\\n        <FlexItem>反向换行</FlexItem>\\\\n      </Flex>\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 对齐\\\\n\\\\n```tsx\\\\nimport { Flex, FlexItem } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function FlexAlign() {\\\\n  return (\\\\n    <div class=\\\\\\\"space-y-4\\\\\\\">\\\\n      <Flex justify=\\\\\\\"start\\\\\\\">\\\\n        <FlexItem>开始</FlexItem>\\\\n        <FlexItem>开始</FlexItem>\\\\n      </Flex>\\\\n      <Flex justify=\\\\\\\"center\\\\\\\">\\\\n        <FlexItem>居中</FlexItem>\\\\n        <FlexItem>居中</FlexItem>\\\\n      </Flex>\\\\n      <Flex justify=\\\\\\\"end\\\\\\\">\\\\n        <FlexItem>结束</FlexItem>\\\\n        <FlexItem>结束</FlexItem>\\\\n      </Flex>\\\\n      <Flex justify=\\\\\\\"space-between\\\\\\\">\\\\n        <FlexItem>两端对齐</FlexItem>\\\\n        <FlexItem>两端对齐</FlexItem>\\\\n      </Flex>\\\\n      <Flex justify=\\\\\\\"space-around\\\\\\\">\\\\n        <FlexItem>环绕对齐</FlexItem>\\\\n        <FlexItem>环绕对齐</FlexItem>\\\\n      </Flex>\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 间距\\\\n\\\\n```tsx\\\\nimport { Flex, FlexItem } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function FlexGap() {\\\\n  return (\\\\n    <Flex gap={16}>\\\\n      <FlexItem>项目1</FlexItem>\\\\n      <FlexItem>项目2</FlexItem>\\\\n      <FlexItem>项目3</FlexItem>\\\\n    </Flex>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### Flex值\\\\n\\\\n```tsx\\\\nimport { Flex, FlexItem } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function FlexFlex() {\\\\n  return (\\\\n    <Flex>\\\\n      <FlexItem flex={1}>flex:1</FlexItem>\\\\n      <FlexItem flex={2}>flex:2</FlexItem>\\\\n      <FlexItem flex={1}>flex:1</FlexItem>\\\\n    </Flex>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### Grow\\\\n\\\\n```tsx\\\\nimport { Flex, FlexItem } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function FlexGrow() {\\\\n  return (\\\\n    <Flex>\\\\n      <FlexItem grow={0}>固定</FlexItem>\\\\n      <FlexItem grow={1}>自动</FlexItem>\\\\n      <FlexItem grow={0}>固定</FlexItem>\\\\n    </Flex>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### Shrink\\\\n\\\\n```tsx\\\\nimport { Flex, FlexItem } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function FlexShrink() {\\\\n  return (\\\\n    <Flex>\\\\n      <FlexItem shrink={0}>不收缩</FlexItem>\\\\n      <FlexItem shrink={1}>收缩</FlexItem>\\\\n      <FlexItem shrink={0}>不收缩</FlexItem>\\\\n    </Flex>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n## API\\\\n\\\\n### Flex Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| direction | 方向 | `string` | `row` / `column` / `row-reverse` / `column-reverse` | `row` |\\\\n| wrap | 换行 | `string` | `nowrap` / `wrap` / `wrap-reverse` | `nowrap` |\\\\n| justify | 水平对齐 | `string` | `start` / `center` / `end` / `space-between` / `space-around` | `start` |\\\\n| align | 垂直对齐 | `string` | `start` / `center` / `end` | `start` |\\\\n| gap | 间距 | `number` | `0` |\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n### FlexItem Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| flex | flex值 | `number` | - |\\\\n| grow | flex-grow | `number` | - |\\\\n| shrink | flex-shrink | `number` | - |\\\\n| basis | flex-basis | `string` | - |\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n## 样式定制\\\\n\\\\n### CSS 变量\\\\n\\\\n```css\\\\n.flex {\\\\n  --flex-gap: 0;\\\\n  --flex-bg: #ffffff;\\\\n}\\\\n```\\\\n\\\\n### 自定义样式\\\\n\\\\n```tsx\\\\n<Flex className=\\\\\\\"custom-flex\\\\\\\">\\\\n  <FlexItem>自定义</FlexItem>\\\\n  <FlexItem>自定义</FlexItem>\\\\n</Flex>\\\\n\\\\n<style>\\\\n.custom-flex .flex-item {\\\\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\\\\n  color: white;\\\\n  padding: 1rem;\\\\n  border-radius: 0.5rem;\\\\n}\\\\n</style>\\\\n```\\\\n\\\\n## 最佳实践\\\\n\\\\n### 1. 居中布局\\\\n\\\\n```tsx\\\\n<Flex justify=\\\\\\\"center\\\\\\\" align=\\\\\\\"center\\\\\\\">\\\\n  <FlexItem>居中内容</FlexItem>\\\\n</Flex>\\\\n```\\\\n\\\\n### 2. 两栏布局\\\\n\\\\n```tsx\\\\n<Flex>\\\\n  <FlexItem flex={1}>左侧</FlexItem>\\\\n  <FlexItem flex={2}>右侧</FlexItem>\\\\n</Flex>\\\\n```\\\\n\\\\n### 3. 均分布局\\\\n\\\\n```tsx\\\\n<Flex>\\\\n  <FlexItem flex={1}>1/3</FlexItem>\\\\n  <FlexItem flex={1}>1/3</FlexItem>\\\\n  <FlexItem flex={1}>1/3</FlexItem>\\\\n</Flex>\\\\n```\\\\n\\\\n### 4. 响应式布局\\\\n\\\\n```tsx\\\\n<Flex wrap>\\\\n  <FlexItem flex=\\\\\\\"1 1 300px\\\\\\\">项目1</FlexItem>\\\\n  <FlexItem flex=\\\\\\\"1 1 300px\\\\\\\">项目2</FlexItem>\\\\n  <FlexItem flex=\\\\\\\"1 1 300px\\\\\\\">项目3</FlexItem>\\\\n</Flex>\\\\n```\\\\n\\\\n## 常见问题\\\\n\\\\n### Q: 如何设置Flex的方向？\\\\n\\\\nA: 使用 `direction` 属性设置Flex的方向。\\\\n\\\\n### Q: 如何实现Flex的换行？\\\\n\\\\nA: 使用 `wrap` 属性实现Flex的换行。\\\\n\\\\n### Q: 如何设置Flex的间距？\\\\n\\\\nA: 使用 `gap` 属性设置Flex的间距。\\\\n\\\\n---\\\\n\\\\n🌹 Flex 组件文档完成！\\\\n\",\"originAcceptText\":\"# Flex 弹性布局\\n\\n弹性布局。\\n\\n## 何时使用\\n\\n- 布局\\n- 简单的对齐\\n- 均分列宽\\n- 居中布局\\n- 左右两栏布局\\n- 自动换行\\n- 多行对齐\\n\\n## 代码演示\\n\\n### 基础用法\\n\\n```tsx\\nimport { Flex, FlexItem } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\n\\nexport default function FlexBasic() {\\n  return (\\n    <Flex>\\n      <FlexItem>项目1</FlexItem>\\n      <FlexItem>项目2</FlexItem>\\n      <FlexItem>项目3</FlexItem>\\n    </Flex>\\n  )\\n}\\n```\\n\\n### 方向\\n\\n```tsx\\nimport { Flex, FlexItem } from '@/components/UI'\\n\\nexport default function FlexDirection() {\\n  return (\\n    <div class=\\\"space-y-4\\\">\\n      <Flex direction=\\\"row\\\">\\n        <FlexItem>水平</FlexItem>\\n        <FlexItem>水平</FlexItem>\\n      </Flex>\\n      <Flex direction=\\\"column\\\">\\n        <FlexItem>垂直</FlexItem>\\n        <FlexItem>垂直</FlexItem>\\n      </Flex>\\n    </div>\\n  )\\n}\\n```\\n\\n### 换行\\n\\n```tsx\\nimport { Flex, FlexItem } from '@/components/UI'\\n\\nexport default function FlexWrap() {\\n  return (\\n    <div class=\\\"space-y-4\\\">\\n      <Flex wrap=\\\"nowrap\\\">\\n        <FlexItem>不换行</FlexItem>\\n        <FlexItem>不换行</FlexItem>\\n        <FlexItem>不换行</FlexItem>\\n      </Flex>\\n      <Flex wrap=\\\"wrap\\\">\\n        <FlexItem>换行</FlexItem>\\n        <FlexItem>换行</FlexItem>\\n        <FlexItem>换行</FlexItem>\\n      </Flex>\\n      <Flex wrap=\\\"wrap-reverse\\\">\\n        <FlexItem>反向换行</FlexItem>\\n        <FlexItem>反向换行</FlexItem>\\n        <FlexItem>反向换行</FlexItem>\\n      </Flex>\\n    </div>\\n  )\\n}\\n```\\n\\n### 对齐\\n\\n```tsx\\nimport { Flex, FlexItem } from '@/components/UI'\\n\\nexport default function FlexAlign() {\\n  return (\\n    <div class=\\\"space-y-4\\\">\\n      <Flex justify=\\\"start\\\">\\n        <FlexItem>开始</FlexItem>\\n        <FlexItem>开始</FlexItem>\\n      </Flex>\\n      <Flex justify=\\\"center\\\">\\n        <FlexItem>居中</FlexItem>\\n        <FlexItem>居中</FlexItem>\\n      </Flex>\\n      <Flex justify=\\\"end\\\">\\n        <FlexItem>结束</FlexItem>\\n        <FlexItem>结束</FlexItem>\\n      </Flex>\\n      <Flex justify=\\\"space-between\\\">\\n        <FlexItem>两端对齐</FlexItem>\\n        <FlexItem>两端对齐</FlexItem>\\n      </Flex>\\n      <Flex justify=\\\"space-around\\\">\\n        <FlexItem>环绕对齐</FlexItem>\\n        <FlexItem>环绕对齐</FlexItem>\\n      </Flex>\\n    </div>\\n  )\\n}\\n```\\n\\n### 间距\\n\\n```tsx\\nimport { Flex, FlexItem } from '@/components/UI'\\n\\nexport default function FlexGap() {\\n  return (\\n    <Flex gap={16}>\\n      <FlexItem>项目1</FlexItem>\\n      <FlexItem>项目2</FlexItem>\\n      <FlexItem>项目3</FlexItem>\\n    </Flex>\\n  )\\n}\\n```\\n\\n### Flex值\\n\\n```tsx\\nimport { Flex, FlexItem } from '@/components/UI'\\n\\nexport default function FlexFlex() {\\n  return (\\n    <Flex>\\n      <FlexItem flex={1}>flex:1</FlexItem>\\n      <FlexItem flex={2}>flex:2</FlexItem>\\n      <FlexItem flex={1}>flex:1</FlexItem>\\n    </Flex>\\n  )\\n}\\n```\\n\\n### Grow\\n\\n```tsx\\nimport { Flex, FlexItem } from '@/components/UI'\\n\\nexport default function FlexGrow() {\\n  return (\\n    <Flex>\\n      <FlexItem grow={0}>固定</FlexItem>\\n      <FlexItem grow={1}>自动</FlexItem>\\n      <FlexItem grow={0}>固定</FlexItem>\\n    </Flex>\\n  )\\n}\\n```\\n\\n### Shrink\\n\\n```tsx\\nimport { Flex, FlexItem } from '@/components/UI'\\n\\nexport default function FlexShrink() {\\n  return (\\n    <Flex>\\n      <FlexItem shrink={0}>不收缩</FlexItem>\\n      <FlexItem shrink={1}>收缩</FlexItem>\\n      <FlexItem shrink={0}>不收缩</FlexItem>\\n    </Flex>\\n  )\\n}\\n```\\n\\n## API\\n\\n### Flex Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| direction | 方向 | `string` | `row` / `column` / `row-reverse` / `column-reverse` | `row` |\\n| wrap | 换行 | `string` | `nowrap` / `wrap` / `wrap-reverse` | `nowrap` |\\n| justify | 水平对齐 | `string` | `start` / `center` / `end` / `space-between` / `space-around` | `start` |\\n| align | 垂直对齐 | `string` | `start` / `center` / `end` | `start` |\\n| gap | 间距 | `number` | `0` |\\n| className | 自定义类名 | `string` | - |\\n\\n### FlexItem Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| flex | flex值 | `number` | - |\\n| grow | flex-grow | `number` | - |\\n| shrink | flex-shrink | `number` | - |\\n| basis | flex-basis | `string` | - |\\n| className | 自定义类名 | `string` | - |\\n\\n## 样式定制\\n\\n### CSS 变量\\n\\n```css\\n.flex {\\n  --flex-gap: 0;\\n  --flex-bg: #ffffff;\\n}\\n```\\n\\n### 自定义样式\\n\\n```tsx\\n<Flex className=\\\"custom-flex\\\">\\n  <FlexItem>自定义</FlexItem>\\n  <FlexItem>自定义</FlexItem>\\n</Flex>\\n\\n<style>\\n.custom-flex .flex-item {\\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\\n  color: white;\\n  padding: 1rem;\\n  border-radius: 0.5rem;\\n}\\n</style>\\n```\\n\\n## 最佳实践\\n\\n### 1. 居中布局\\n\\n```tsx\\n<Flex justify=\\\"center\\\" align=\\\"center\\\">\\n  <FlexItem>居中内容</FlexItem>\\n</Flex>\\n```\\n\\n### 2. 两栏布局\\n\\n```tsx\\n<Flex>\\n  <FlexItem flex={1}>左侧</FlexItem>\\n  <FlexItem flex={2}>右侧</FlexItem>\\n</Flex>\\n```\\n\\n### 3. 均分布局\\n\\n```tsx\\n<Flex>\\n  <FlexItem flex={1}>1/3</FlexItem>\\n  <FlexItem flex={1}>1/3</FlexItem>\\n  <FlexItem flex={1}>1/3</FlexItem>\\n</Flex>\\n```\\n\\n### 4. 响应式布局\\n\\n```tsx\\n<Flex wrap>\\n  <FlexItem flex=\\\"1 1 300px\\\">项目1</FlexItem>\\n  <FlexItem flex=\\\"1 1 300px\\\">项目2</FlexItem>\\n  <FlexItem flex=\\\"1 1 300px\\\">项目3</FlexItem>\\n</Flex>\\n```\\n\\n## 常见问题\\n\\n### Q: 如何设置Flex的方向？\\n\\nA: 使用 `direction` 属性设置Flex的方向。\\n\\n### Q: 如何实现Flex的换行？\\n\\nA: 使用 `wrap` 属性实现Flex的换行。\\n\\n### Q: 如何设置Flex的间距？\\n\\nA: 使用 `gap` 属性设置Flex的间距。\\n\\n---\\n\\n🌹 Flex 组件文档完成！\\n\",\"originTextLength\":4969,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768948289789}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/components/UI/docs/components/Avatar.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":161,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":161,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# Avatar 头像\\\\n\\\\n用来代表用户或事物，支持图片、图标或字符展示。\\\\n\\\\n## 何时使用\\\\n\\\\n- 用户、事物或形状的展示。\\\\n- 推荐使用形状来表示事物或人物，展示更加直观。\\\\n\\\\n## 代码演示\\\\n\\\\n### 基础用法\\\\n\\\\n```tsx\\\\nimport { Avatar } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function AvatarBasic() {\\\\n  return (\\\\n    <div class=\\\\\\\"space-x-2\\\\\\\">\\\\n      <Avatar src=\\\\\\\"https://i.pravatar.cc/150?img=1\\\\\\\" />\\\\n      <Avatar src=\\\\\\\"https://i.pravatar.cc/150?img=2\\\\\\\" />\\\\n      <Avatar src=\\\\\\\"https://i.pravatar.cc/150?img=3\\\\\\\" />\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 类型\\\\n\\\\n```tsx\\\\nimport { Avatar } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function AvatarType() {\\\\n  return (\\\\n    <div class=\\\\\\\"space-x-2\\\\\\\">\\\\n      <Avatar src=\\\\\\\"https://i.pravatar.cc/150?img=1\\\\\\\" />\\\\n      <Avatar>U</Avatar>\\\\n      <Avatar icon=\\\\\\\"👤\\\\\\\" />\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 尺寸\\\\n\\\\n```tsx\\\\nimport { Avatar } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function AvatarSize() {\\\\n  return (\\\\n    <div class=\\\\\\\"space-x-2\\\\\\\">\\\\n      <Avatar size=\\\\\\\"sm\\\\\\\" src=\\\\\\\"https://i.pravatar.cc/150?img=1\\\\\\\" />\\\\n      <Avatar size=\\\\\\\"md\\\\\\\" src=\\\\\\\"https://i.pravatar.cc/150?img=2\\\\\\\" />\\\\n      <Avatar size=\\\\\\\"lg\\\\\\\" src=\\\\\\\"https://i.pravatar.cc/150?img=3\\\\\\\" />\\\\n      <Avatar size={80} src=\\\\\\\"https://i.pravatar.cc/150?img=4\\\\\\\" />\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 形状\\\\n\\\\n```tsx\\\\nimport { Avatar } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function AvatarShape() {\\\\n  return (\\\\n    <div class=\\\\\\\"space-x-2\\\\\\\">\\\\n      <Avatar shape=\\\\\\\"circle\\\\\\\" src=\\\\\\\"https://i.pravatar.cc/150?img=1\\\\\\\" />\\\\n      <Avatar shape=\\\\\\\"square\\\\\\\" src=\\\\\\\"https://i.pravatar.cc/150?img=2\\\\\\\" />\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 带徽标\\\\n\\\\n```tsx\\\\nimport { Avatar, Badge } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function AvatarWithBadge() {\\\\n  return (\\\\n    <div class=\\\\\\\"space-x-2\\\\\\\">\\\\n      <Badge count={5}>\\\\n        <Avatar src=\\\\\\\"https://i.pravatar.cc/150?img=1\\\\\\\" />\\\\n      </Badge>\\\\n      <Badge dot>\\\\n        <Avatar src=\\\\\\\"https://i.pravatar.cc/150?img=2\\\\\\\" />\\\\n      </Badge>\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 组合\\\\n\\\\n```tsx\\\\nimport { Avatar } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function AvatarGroup() {\\\\n  return (\\\\n    <div class=\\\\\\\"space-x-2\\\\\\\">\\\\n      <Avatar src=\\\\\\\"https://i.pravatar.cc/150?img=1\\\\\\\" />\\\\n      <Avatar src=\\\\\\\"https://i.pravatar.cc/150?img=2\\\\\\\" />\\\\n      <Avatar src=\\\\\\\"https://i.pravatar.cc/150?img=3\\\\\\\" />\\\\n      <Avatar>+5</Avatar>\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n## API\\\\n\\\\n### Avatar Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| src | 图片地址 | `string` | - |\\\\n| alt | 文本描述 | `string` | - |\\\\n| icon | 图标 | `VNode` | - |\\\\n| size | 尺寸 | `string \\\\\\\\| number` | `sm` / `md` / `lg` | `md` |\\\\n| shape | 形状 | `string` | `circle` / `square` | `circle` |\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n## 样式定制\\\\n\\\\n### CSS 变量\\\\n\\\\n```css\\\\n.avatar {\\\\n  --avatar-bg: #e5e7eb;\\\\n  --avatar-text: #6b7280;\\\\n  --avatar-border: #d1d5db;\\\\n}\\\\n```\\\\n\\\\n### 自定义样式\\\\n\\\\n```tsx\\\\n<Avatar className=\\\\\\\"custom-avatar\\\\\\\" src=\\\\\\\"https://i.pravatar.cc/150?img=1\\\\\\\" />\\\\n\\\\n<style>\\\\n.custom-avatar {\\\\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\\\\n  color: white;\\\\n  border: 2px solid white;\\\\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);\\\\n}\\\\n</style>\\\\n```\\\\n\\\\n## 最佳实践\\\\n\\\\n### 1. 用户头像\\\\n\\\\n```tsx\\\\n<Avatar\\\\n  src={user.avatar}\\\\n  alt={user.name}\\\\n  size=\\\\\\\"md\\\\\\\"\\\\n/>\\\\n```\\\\n\\\\n### 2. 头像组\\\\n\\\\n```tsx\\\\n<div class=\\\\\\\"flex -space-x-2\\\\\\\">\\\\n  {users.slice(0, 3).map(user => (\\\\n    <Avatar\\\\n      key={user.id}\\\\n      src={user.avatar}\\\\n      size=\\\\\\\"sm\\\\\\\"\\\\n    />\\\\n  ))}\\\\n  {users.length > 3 && (\\\\n    <Avatar size=\\\\\\\"sm\\\\\\\">+{users.length - 3}</Avatar>\\\\n  )}\\\\n</div>\\\\n```\\\\n\\\\n### 3. 状态头像\\\\n\\\\n```tsx\\\\n<div class=\\\\\\\"relative\\\\\\\">\\\\n  <Avatar src={user.avatar} size=\\\\\\\"lg\\\\\\\" />\\\\n  <span class={`absolute bottom-0 right-0 w-3 h-3 rounded-full border-2 border-white ${\\\\n    user.online ? \\\\'bg-success-500\\\\' : \\\\'bg-neutral-400\\\\'\\\\n  }`} />\\\\n</div>\\\\n```\\\\n\\\\n## 常见问题\\\\n\\\\n### Q: 如何自定义头像的尺寸？\\\\n\\\\nA: 使用 `size` 属性设置头像的尺寸。\\\\n\\\\n### Q: 如何实现头像组？\\\\n\\\\nA: 使用多个 Avatar 组件组合实现头像组。\\\\n\\\\n### Q: 如何实现带状态的头像？\\\\n\\\\nA: 使用绝对定位的元素实现带状态的头像。\\\\n\\\\n---\\\\n\\\\n🌹 Avatar 组件文档完成！\\\\n\",\"originAcceptText\":\"# Avatar 头像\\n\\n用来代表用户或事物，支持图片、图标或字符展示。\\n\\n## 何时使用\\n\\n- 用户、事物或形状的展示。\\n- 推荐使用形状来表示事物或人物，展示更加直观。\\n\\n## 代码演示\\n\\n### 基础用法\\n\\n```tsx\\nimport { Avatar } from '@/components/UI'\\n\\nexport default function AvatarBasic() {\\n  return (\\n    <div class=\\\"space-x-2\\\">\\n      <Avatar src=\\\"https://i.pravatar.cc/150?img=1\\\" />\\n      <Avatar src=\\\"https://i.pravatar.cc/150?img=2\\\" />\\n      <Avatar src=\\\"https://i.pravatar.cc/150?img=3\\\" />\\n    </div>\\n  )\\n}\\n```\\n\\n### 类型\\n\\n```tsx\\nimport { Avatar } from '@/components/UI'\\n\\nexport default function AvatarType() {\\n  return (\\n    <div class=\\\"space-x-2\\\">\\n      <Avatar src=\\\"https://i.pravatar.cc/150?img=1\\\" />\\n      <Avatar>U</Avatar>\\n      <Avatar icon=\\\"👤\\\" />\\n    </div>\\n  )\\n}\\n```\\n\\n### 尺寸\\n\\n```tsx\\nimport { Avatar } from '@/components/UI'\\n\\nexport default function AvatarSize() {\\n  return (\\n    <div class=\\\"space-x-2\\\">\\n      <Avatar size=\\\"sm\\\" src=\\\"https://i.pravatar.cc/150?img=1\\\" />\\n      <Avatar size=\\\"md\\\" src=\\\"https://i.pravatar.cc/150?img=2\\\" />\\n      <Avatar size=\\\"lg\\\" src=\\\"https://i.pravatar.cc/150?img=3\\\" />\\n      <Avatar size={80} src=\\\"https://i.pravatar.cc/150?img=4\\\" />\\n    </div>\\n  )\\n}\\n```\\n\\n### 形状\\n\\n```tsx\\nimport { Avatar } from '@/components/UI'\\n\\nexport default function AvatarShape() {\\n  return (\\n    <div class=\\\"space-x-2\\\">\\n      <Avatar shape=\\\"circle\\\" src=\\\"https://i.pravatar.cc/150?img=1\\\" />\\n      <Avatar shape=\\\"square\\\" src=\\\"https://i.pravatar.cc/150?img=2\\\" />\\n    </div>\\n  )\\n}\\n```\\n\\n### 带徽标\\n\\n```tsx\\nimport { Avatar, Badge } from '@/components/UI'\\n\\nexport default function AvatarWithBadge() {\\n  return (\\n    <div class=\\\"space-x-2\\\">\\n      <Badge count={5}>\\n        <Avatar src=\\\"https://i.pravatar.cc/150?img=1\\\" />\\n      </Badge>\\n      <Badge dot>\\n        <Avatar src=\\\"https://i.pravatar.cc/150?img=2\\\" />\\n      </Badge>\\n    </div>\\n  )\\n}\\n```\\n\\n### 组合\\n\\n```tsx\\nimport { Avatar } from '@/components/UI'\\n\\nexport default function AvatarGroup() {\\n  return (\\n    <div class=\\\"space-x-2\\\">\\n      <Avatar src=\\\"https://i.pravatar.cc/150?img=1\\\" />\\n      <Avatar src=\\\"https://i.pravatar.cc/150?img=2\\\" />\\n      <Avatar src=\\\"https://i.pravatar.cc/150?img=3\\\" />\\n      <Avatar>+5</Avatar>\\n    </div>\\n  )\\n}\\n```\\n\\n## API\\n\\n### Avatar Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| src | 图片地址 | `string` | - |\\n| alt | 文本描述 | `string` | - |\\n| icon | 图标 | `VNode` | - |\\n| size | 尺寸 | `string \\\\| number` | `sm` / `md` / `lg` | `md` |\\n| shape | 形状 | `string` | `circle` / `square` | `circle` |\\n| className | 自定义类名 | `string` | - |\\n\\n## 样式定制\\n\\n### CSS 变量\\n\\n```css\\n.avatar {\\n  --avatar-bg: #e5e7eb;\\n  --avatar-text: #6b7280;\\n  --avatar-border: #d1d5db;\\n}\\n```\\n\\n### 自定义样式\\n\\n```tsx\\n<Avatar className=\\\"custom-avatar\\\" src=\\\"https://i.pravatar.cc/150?img=1\\\" />\\n\\n<style>\\n.custom-avatar {\\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\\n  color: white;\\n  border: 2px solid white;\\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);\\n}\\n</style>\\n```\\n\\n## 最佳实践\\n\\n### 1. 用户头像\\n\\n```tsx\\n<Avatar\\n  src={user.avatar}\\n  alt={user.name}\\n  size=\\\"md\\\"\\n/>\\n```\\n\\n### 2. 头像组\\n\\n```tsx\\n<div class=\\\"flex -space-x-2\\\">\\n  {users.slice(0, 3).map(user => (\\n    <Avatar\\n      key={user.id}\\n      src={user.avatar}\\n      size=\\\"sm\\\"\\n    />\\n  ))}\\n  {users.length > 3 && (\\n    <Avatar size=\\\"sm\\\">+{users.length - 3}</Avatar>\\n  )}\\n</div>\\n```\\n\\n### 3. 状态头像\\n\\n```tsx\\n<div class=\\\"relative\\\">\\n  <Avatar src={user.avatar} size=\\\"lg\\\" />\\n  <span class={`absolute bottom-0 right-0 w-3 h-3 rounded-full border-2 border-white ${\\n    user.online ? 'bg-success-500' : 'bg-neutral-400'\\n  }`} />\\n</div>\\n```\\n\\n## 常见问题\\n\\n### Q: 如何自定义头像的尺寸？\\n\\nA: 使用 `size` 属性设置头像的尺寸。\\n\\n### Q: 如何实现头像组？\\n\\nA: 使用多个 Avatar 组件组合实现头像组。\\n\\n### Q: 如何实现带状态的头像？\\n\\nA: 使用绝对定位的元素实现带状态的头像。\\n\\n---\\n\\n🌹 Avatar 组件文档完成！\\n\",\"originTextLength\":3614,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768948315681}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/components/UI/docs/components/Divider.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":159,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":159,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# Divider 分割线\\\\n\\\\n区隔内容的分割线。\\\\n\\\\n## 何时使用\\\\n\\\\n- 对不同章节的文本段落进行分割。\\\\n- 对行内文字/链接进行分割，例如表格的操作列。\\\\n\\\\n## 代码演示\\\\n\\\\n### 基础用法\\\\n\\\\n```tsx\\\\nimport { Divider } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function DividerBasic() {\\\\n  return (\\\\n    <div>\\\\n      <p>文本1</p>\\\\n      <Divider />\\\\n      <p>文本2</p>\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 带文字\\\\n\\\\n```tsx\\\\nimport { Divider } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function DividerWithText() {\\\\n  return (\\\\n    <div>\\\\n      <p>文本1</p>\\\\n      <Divider>文字</Divider>\\\\n      <p>文本2</p>\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 位置\\\\n\\\\n```tsx\\\\nimport { Divider } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function DividerPosition() {\\\\n  return (\\\\n    <div>\\\\n      <p>文本1</p>\\\\n      <Divider orientation=\\\\\\\"left\\\\\\\">左侧文字</Divider>\\\\n      <p>文本2</p>\\\\n      <Divider orientation=\\\\\\\"center\\\\\\\">居中文字</Divider>\\\\n      <p>文本3</p>\\\\n      <Divider orientation=\\\\\\\"right\\\\\\\">右侧文字</Divider>\\\\n      <p>文本4</p>\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 垂直分割线\\\\n\\\\n```tsx\\\\nimport { Divider } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function DividerVertical() {\\\\n  return (\\\\n    <div>\\\\n      <span>文本1</span>\\\\n      <Divider vertical />\\\\n      <span>文本2</span>\\\\n      <Divider vertical />\\\\n      <span>文本3</span>\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 虚线\\\\n\\\\n```tsx\\\\nimport { Divider } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function DividerDashed() {\\\\n  return (\\\\n    <div>\\\\n      <p>文本1</p>\\\\n      <Divider dashed />\\\\n      <p>文本2</p>\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 自定义样式\\\\n\\\\n```tsx\\\\nimport { Divider } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function DividerCustom() {\\\\n  return (\\\\n    <div>\\\\n      <p>文本1</p>\\\\n      <Divider style={{ borderColor: \\\\'#667eea\\\\', borderWidth: \\\\'2px\\\\' }} />\\\\n      <p>文本2</p>\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n## API\\\\n\\\\n### Divider Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| orientation | 文本位置 | `string` | `left` / `center` / `right` | `center` |\\\\n| dashed | 是否虚线 | `boolean` | `false` |\\\\n| vertical | 是否垂直 | `boolean` | `false` |\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n## 样式定制\\\\n\\\\n### CSS 变量\\\\n\\\\n```css\\\\n.divider {\\\\n  --divider-border: #e5e7eb;\\\\n  --divider-text: #6b7280;\\\\n  --divider-font-size: 0.875rem;\\\\n}\\\\n```\\\\n\\\\n### 自定义样式\\\\n\\\\n```tsx\\\\n<Divider className=\\\\\\\"custom-divider\\\\\\\" />\\\\n\\\\n<style>\\\\n.custom-divider {\\\\n  border-color: #667eea;\\\\n  border-width: 2px;\\\\n}\\\\n\\\\n.custom-divider::after {\\\\n  color: #667eea;\\\\n  font-weight: bold;\\\\n}\\\\n</style>\\\\n```\\\\n\\\\n## 最佳实践\\\\n\\\\n### 1. 文章分割\\\\n\\\\n```tsx\\\\n<div>\\\\n  <h1>文章标题</h1>\\\\n  <p>文章内容...</p>\\\\n  <Divider />\\\\n  <h2>相关推荐</h2>\\\\n  <p>推荐内容...</p>\\\\n</div>\\\\n```\\\\n\\\\n### 2. 表格操作\\\\n\\\\n```tsx\\\\n<div class=\\\\\\\"flex items-center space-x-2\\\\\\\">\\\\n  <Button size=\\\\\\\"sm\\\\\\\">编辑</Button>\\\\n  <Divider vertical />\\\\n  <Button size=\\\\\\\"sm\\\\\\\">删除</Button>\\\\n</div>\\\\n```\\\\n\\\\n### 3. 分组标题\\\\n\\\\n```tsx\\\\n<div>\\\\n  <h2>基本信息</h2>\\\\n  <Divider />\\\\n  <div>基本信息内容...</div>\\\\n  <Divider>联系方式</Divider>\\\\n  <div>联系方式内容...</div>\\\\n</div>\\\\n```\\\\n\\\\n## 常见问题\\\\n\\\\n### Q: 如何设置分割线的文字位置？\\\\n\\\\nA: 使用 `orientation` 属性设置分割线的文字位置。\\\\n\\\\n### Q: 如何实现垂直分割线？\\\\n\\\\nA: 使用 `vertical` 属性实现垂直分割线。\\\\n\\\\n### Q: 如何实现虚线分割线？\\\\n\\\\nA: 使用 `dashed` 属性实现虚线分割线。\\\\n\\\\n---\\\\n\\\\n🌹 Divider 组件文档完成！\\\\n\",\"originAcceptText\":\"# Divider 分割线\\n\\n区隔内容的分割线。\\n\\n## 何时使用\\n\\n- 对不同章节的文本段落进行分割。\\n- 对行内文字/链接进行分割，例如表格的操作列。\\n\\n## 代码演示\\n\\n### 基础用法\\n\\n```tsx\\nimport { Divider } from '@/components/UI'\\n\\nexport default function DividerBasic() {\\n  return (\\n    <div>\\n      <p>文本1</p>\\n      <Divider />\\n      <p>文本2</p>\\n    </div>\\n  )\\n}\\n```\\n\\n### 带文字\\n\\n```tsx\\nimport { Divider } from '@/components/UI'\\n\\nexport default function DividerWithText() {\\n  return (\\n    <div>\\n      <p>文本1</p>\\n      <Divider>文字</Divider>\\n      <p>文本2</p>\\n    </div>\\n  )\\n}\\n```\\n\\n### 位置\\n\\n```tsx\\nimport { Divider } from '@/components/UI'\\n\\nexport default function DividerPosition() {\\n  return (\\n    <div>\\n      <p>文本1</p>\\n      <Divider orientation=\\\"left\\\">左侧文字</Divider>\\n      <p>文本2</p>\\n      <Divider orientation=\\\"center\\\">居中文字</Divider>\\n      <p>文本3</p>\\n      <Divider orientation=\\\"right\\\">右侧文字</Divider>\\n      <p>文本4</p>\\n    </div>\\n  )\\n}\\n```\\n\\n### 垂直分割线\\n\\n```tsx\\nimport { Divider } from '@/components/UI'\\n\\nexport default function DividerVertical() {\\n  return (\\n    <div>\\n      <span>文本1</span>\\n      <Divider vertical />\\n      <span>文本2</span>\\n      <Divider vertical />\\n      <span>文本3</span>\\n    </div>\\n  )\\n}\\n```\\n\\n### 虚线\\n\\n```tsx\\nimport { Divider } from '@/components/UI'\\n\\nexport default function DividerDashed() {\\n  return (\\n    <div>\\n      <p>文本1</p>\\n      <Divider dashed />\\n      <p>文本2</p>\\n    </div>\\n  )\\n}\\n```\\n\\n### 自定义样式\\n\\n```tsx\\nimport { Divider } from '@/components/UI'\\n\\nexport default function DividerCustom() {\\n  return (\\n    <div>\\n      <p>文本1</p>\\n      <Divider style={{ borderColor: '#667eea', borderWidth: '2px' }} />\\n      <p>文本2</p>\\n    </div>\\n  )\\n}\\n```\\n\\n## API\\n\\n### Divider Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| orientation | 文本位置 | `string` | `left` / `center` / `right` | `center` |\\n| dashed | 是否虚线 | `boolean` | `false` |\\n| vertical | 是否垂直 | `boolean` | `false` |\\n| className | 自定义类名 | `string` | - |\\n\\n## 样式定制\\n\\n### CSS 变量\\n\\n```css\\n.divider {\\n  --divider-border: #e5e7eb;\\n  --divider-text: #6b7280;\\n  --divider-font-size: 0.875rem;\\n}\\n```\\n\\n### 自定义样式\\n\\n```tsx\\n<Divider className=\\\"custom-divider\\\" />\\n\\n<style>\\n.custom-divider {\\n  border-color: #667eea;\\n  border-width: 2px;\\n}\\n\\n.custom-divider::after {\\n  color: #667eea;\\n  font-weight: bold;\\n}\\n</style>\\n```\\n\\n## 最佳实践\\n\\n### 1. 文章分割\\n\\n```tsx\\n<div>\\n  <h1>文章标题</h1>\\n  <p>文章内容...</p>\\n  <Divider />\\n  <h2>相关推荐</h2>\\n  <p>推荐内容...</p>\\n</div>\\n```\\n\\n### 2. 表格操作\\n\\n```tsx\\n<div class=\\\"flex items-center space-x-2\\\">\\n  <Button size=\\\"sm\\\">编辑</Button>\\n  <Divider vertical />\\n  <Button size=\\\"sm\\\">删除</Button>\\n</div>\\n```\\n\\n### 3. 分组标题\\n\\n```tsx\\n<div>\\n  <h2>基本信息</h2>\\n  <Divider />\\n  <div>基本信息内容...</div>\\n  <Divider>联系方式</Divider>\\n  <div>联系方式内容...</div>\\n</div>\\n```\\n\\n## 常见问题\\n\\n### Q: 如何设置分割线的文字位置？\\n\\nA: 使用 `orientation` 属性设置分割线的文字位置。\\n\\n### Q: 如何实现垂直分割线？\\n\\nA: 使用 `vertical` 属性实现垂直分割线。\\n\\n### Q: 如何实现虚线分割线？\\n\\nA: 使用 `dashed` 属性实现虚线分割线。\\n\\n---\\n\\n🌹 Divider 组件文档完成！\\n\",\"originTextLength\":2818,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768948346969}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/components/UI/docs/components/Skeleton.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":211,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":211,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# Skeleton 骨架屏\\\\n\\\\n在需要等待加载内容的位置提供一个占位图形组合。\\\\n\\\\n## 何时使用\\\\n\\\\n- 网络较慢，需要长时间等待加载处理的情况下。\\\\n- 图文信息内容较多的列表/卡片中。\\\\n- 只在第一次加载数据的时候使用。\\\\n- 可以被 Spin 完全代替，但是在可用的场景下可以比 Spin 提供更好的视觉效果和用户体验。\\\\n\\\\n## 代码演示\\\\n\\\\n### 基础用法\\\\n\\\\n```tsx\\\\nimport { Skeleton } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function SkeletonBasic() {\\\\n  return (\\\\n    <div class=\\\\\\\"space-y-4\\\\\\\">\\\\n      <Skeleton />\\\\n      <Skeleton />\\\\n      <Skeleton />\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 复杂组合\\\\n\\\\n```tsx\\\\nimport { Skeleton } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function SkeletonComplex() {\\\\n  return (\\\\n    <div class=\\\\\\\"space-y-4\\\\\\\">\\\\n      <Skeleton active>\\\\n        <Skeleton.Avatar />\\\\n        <Skeleton.Title />\\\\n        <Skeleton.Paragraph />\\\\n      </Skeleton>\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 头像\\\\n\\\\n```tsx\\\\nimport { Skeleton } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function SkeletonAvatar() {\\\\n  return (\\\\n    <div class=\\\\\\\"space-x-4\\\\\\\">\\\\n      <Skeleton.Avatar />\\\\n      <Skeleton.Avatar />\\\\n      <Skeleton.Avatar />\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 标题\\\\n\\\\n```tsx\\\\nimport { Skeleton } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function SkeletonTitle() {\\\\n  return (\\\\n    <div class=\\\\\\\"space-y-4\\\\\\\">\\\\n      <Skeleton.Title />\\\\n      <Skeleton.Title />\\\\n      <Skeleton.Title />\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 段落\\\\n\\\\n```tsx\\\\nimport { Skeleton } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function SkeletonParagraph() {\\\\n  return (\\\\n    <div class=\\\\\\\"space-y-4\\\\\\\">\\\\n      <Skeleton.Paragraph />\\\\n      <Skeleton.Paragraph />\\\\n      <Skeleton.Paragraph />\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 激活动画\\\\n\\\\n```tsx\\\\nimport { Skeleton } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function SkeletonActive() {\\\\n  return (\\\\n    <div class=\\\\\\\"space-y-4\\\\\\\">\\\\n      <Skeleton active />\\\\n      <Skeleton active />\\\\n      <Skeleton active />\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 加载状态\\\\n\\\\n```tsx\\\\nimport { Skeleton } from \\\\'@/components/UI\\\\'\\\\nimport { ref } from \\\\'vue\\\\'\\\\n\\\\nexport default function SkeletonLoading() {\\\\n  const loading = ref(true)\\\\n\\\\n  return (\\\\n    <div>\\\\n      {loading.value ? (\\\\n        <Skeleton active />\\\\n      ) : (\\\\n        <div>实际内容</div>\\\\n      )}\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n## API\\\\n\\\\n### Skeleton Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| loading | 是否显示骨架屏 | `boolean` | `true` |\\\\n| active | 是否显示动画效果 | `boolean` | `false` |\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n### Skeleton.Avatar Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| size | 尺寸 | `string \\\\\\\\| number` | `sm` / `md` / `lg` | `md` |\\\\n| shape | 形状 | `string` | `circle` / `square` | `circle` |\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n### Skeleton.Title Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| width | 宽度 | `string \\\\\\\\| number` | `100%` |\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n### Skeleton.Paragraph Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| rows | 行数 | `number` | `3` |\\\\n| width | 宽度 | `string \\\\\\\\| number \\\\\\\\| (string \\\\\\\\| number)[]` | - |\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n## 样式定制\\\\n\\\\n### CSS 变量\\\\n\\\\n```css\\\\n.skeleton {\\\\n  --skeleton-bg: #e5e7eb;\\\\n  --skeleton-highlight: #f3f4f6;\\\\n}\\\\n```\\\\n\\\\n### 自定义样式\\\\n\\\\n```tsx\\\\n<Skeleton className=\\\\\\\"custom-skeleton\\\\\\\" />\\\\n\\\\n<style>\\\\n.custom-skeleton {\\\\n  --skeleton-bg: linear-gradient(90deg, #667eea 0%, #764ba2 100%);\\\\n}\\\\n</style>\\\\n```\\\\n\\\\n## 最佳实践\\\\n\\\\n### 1. 列表骨架屏\\\\n\\\\n```tsx\\\\n{loading.value ? (\\\\n  <div class=\\\\\\\"space-y-4\\\\\\\">\\\\n    {Array.from({ length: 5 }).map((_, i) => (\\\\n      <Skeleton key={i} active>\\\\n        <Skeleton.Avatar />\\\\n        <Skeleton.Title />\\\\n        <Skeleton.Paragraph />\\\\n      </Skeleton>\\\\n    ))}\\\\n  </div>\\\\n) : (\\\\n  <List data={data} renderItem={renderItem} />\\\\n)}\\\\n```\\\\n\\\\n### 2. 卡片骨架屏\\\\n\\\\n```tsx\\\\n{loading.value ? (\\\\n  <div class=\\\\\\\"grid grid-cols-3 gap-4\\\\\\\">\\\\n    {Array.from({ length: 6 }).map((_, i) => (\\\\n      <Card key={i}>\\\\n        <Skeleton active>\\\\n          <Skeleton.Avatar />\\\\n          <Skeleton.Title />\\\\n          <Skeleton.Paragraph />\\\\n        </Skeleton>\\\\n      </Card>\\\\n    ))}\\\\n  </div>\\\\n) : (\\\\n  <div class=\\\\\\\"grid grid-cols-3 gap-4\\\\\\\">\\\\n    {data.map(item => (\\\\n      <Card key={item.id}>{item.content}</Card>\\\\n    ))}\\\\n  </div>\\\\n)}\\\\n```\\\\n\\\\n### 3. 表格骨架屏\\\\n\\\\n```tsx\\\\n{loading.value ? (\\\\n  <div class=\\\\\\\"space-y-2\\\\\\\">\\\\n    {Array.from({ length: 10 }).map((_, i) => (\\\\n      <div key={i} class=\\\\\\\"flex space-x-2\\\\\\\">\\\\n        <Skeleton.Paragraph rows={1} width=\\\\\\\"20%\\\\\\\" />\\\\n        <Skeleton.Paragraph rows={1} width=\\\\\\\"30%\\\\\\\" />\\\\n        <Skeleton.Paragraph rows={1} width=\\\\\\\"30%\\\\\\\" />\\\\n        <Skeleton.Paragraph rows={1} width=\\\\\\\"20%\\\\\\\" />\\\\n      </div>\\\\n    ))}\\\\n  </div>\\\\n) : (\\\\n  <Table columns={columns} data={data} />\\\\n)}\\\\n```\\\\n\\\\n## 常见问题\\\\n\\\\n### Q: 如何实现骨架屏的动画效果？\\\\n\\\\nA: 使用 `active` 属性实现骨架屏的动画效果。\\\\n\\\\n### Q: 如何自定义骨架屏的样式？\\\\n\\\\nA: 使用 `className` 属性添加自定义类名，然后使用 CSS 自定义样式。\\\\n\\\\n### Q: 如何实现加载状态切换？\\\\n\\\\nA: 使用 `loading` 属性控制骨架屏的显示和隐藏。\\\\n\\\\n---\\\\n\\\\n🌹 Skeleton 组件文档完成！\\\\n\",\"originAcceptText\":\"# Skeleton 骨架屏\\n\\n在需要等待加载内容的位置提供一个占位图形组合。\\n\\n## 何时使用\\n\\n- 网络较慢，需要长时间等待加载处理的情况下。\\n- 图文信息内容较多的列表/卡片中。\\n- 只在第一次加载数据的时候使用。\\n- 可以被 Spin 完全代替，但是在可用的场景下可以比 Spin 提供更好的视觉效果和用户体验。\\n\\n## 代码演示\\n\\n### 基础用法\\n\\n```tsx\\nimport { Skeleton } from '@/components/UI'\\n\\nexport default function SkeletonBasic() {\\n  return (\\n    <div class=\\\"space-y-4\\\">\\n      <Skeleton />\\n      <Skeleton />\\n      <Skeleton />\\n    </div>\\n  )\\n}\\n```\\n\\n### 复杂组合\\n\\n```tsx\\nimport { Skeleton } from '@/components/UI'\\n\\nexport default function SkeletonComplex() {\\n  return (\\n    <div class=\\\"space-y-4\\\">\\n      <Skeleton active>\\n        <Skeleton.Avatar />\\n        <Skeleton.Title />\\n        <Skeleton.Paragraph />\\n      </Skeleton>\\n    </div>\\n  )\\n}\\n```\\n\\n### 头像\\n\\n```tsx\\nimport { Skeleton } from '@/components/UI'\\n\\nexport default function SkeletonAvatar() {\\n  return (\\n    <div class=\\\"space-x-4\\\">\\n      <Skeleton.Avatar />\\n      <Skeleton.Avatar />\\n      <Skeleton.Avatar />\\n    </div>\\n  )\\n}\\n```\\n\\n### 标题\\n\\n```tsx\\nimport { Skeleton } from '@/components/UI'\\n\\nexport default function SkeletonTitle() {\\n  return (\\n    <div class=\\\"space-y-4\\\">\\n      <Skeleton.Title />\\n      <Skeleton.Title />\\n      <Skeleton.Title />\\n    </div>\\n  )\\n}\\n```\\n\\n### 段落\\n\\n```tsx\\nimport { Skeleton } from '@/components/UI'\\n\\nexport default function SkeletonParagraph() {\\n  return (\\n    <div class=\\\"space-y-4\\\">\\n      <Skeleton.Paragraph />\\n      <Skeleton.Paragraph />\\n      <Skeleton.Paragraph />\\n    </div>\\n  )\\n}\\n```\\n\\n### 激活动画\\n\\n```tsx\\nimport { Skeleton } from '@/components/UI'\\n\\nexport default function SkeletonActive() {\\n  return (\\n    <div class=\\\"space-y-4\\\">\\n      <Skeleton active />\\n      <Skeleton active />\\n      <Skeleton active />\\n    </div>\\n  )\\n}\\n```\\n\\n### 加载状态\\n\\n```tsx\\nimport { Skeleton } from '@/components/UI'\\nimport { ref } from 'vue'\\n\\nexport default function SkeletonLoading() {\\n  const loading = ref(true)\\n\\n  return (\\n    <div>\\n      {loading.value ? (\\n        <Skeleton active />\\n      ) : (\\n        <div>实际内容</div>\\n      )}\\n    </div>\\n  )\\n}\\n```\\n\\n## API\\n\\n### Skeleton Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| loading | 是否显示骨架屏 | `boolean` | `true` |\\n| active | 是否显示动画效果 | `boolean` | `false` |\\n| className | 自定义类名 | `string` | - |\\n\\n### Skeleton.Avatar Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| size | 尺寸 | `string \\\\| number` | `sm` / `md` / `lg` | `md` |\\n| shape | 形状 | `string` | `circle` / `square` | `circle` |\\n| className | 自定义类名 | `string` | - |\\n\\n### Skeleton.Title Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| width | 宽度 | `string \\\\| number` | `100%` |\\n| className | 自定义类名 | `string` | - |\\n\\n### Skeleton.Paragraph Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| rows | 行数 | `number` | `3` |\\n| width | 宽度 | `string \\\\| number \\\\| (string \\\\| number)[]` | - |\\n| className | 自定义类名 | `string` | - |\\n\\n## 样式定制\\n\\n### CSS 变量\\n\\n```css\\n.skeleton {\\n  --skeleton-bg: #e5e7eb;\\n  --skeleton-highlight: #f3f4f6;\\n}\\n```\\n\\n### 自定义样式\\n\\n```tsx\\n<Skeleton className=\\\"custom-skeleton\\\" />\\n\\n<style>\\n.custom-skeleton {\\n  --skeleton-bg: linear-gradient(90deg, #667eea 0%, #764ba2 100%);\\n}\\n</style>\\n```\\n\\n## 最佳实践\\n\\n### 1. 列表骨架屏\\n\\n```tsx\\n{loading.value ? (\\n  <div class=\\\"space-y-4\\\">\\n    {Array.from({ length: 5 }).map((_, i) => (\\n      <Skeleton key={i} active>\\n        <Skeleton.Avatar />\\n        <Skeleton.Title />\\n        <Skeleton.Paragraph />\\n      </Skeleton>\\n    ))}\\n  </div>\\n) : (\\n  <List data={data} renderItem={renderItem} />\\n)}\\n```\\n\\n### 2. 卡片骨架屏\\n\\n```tsx\\n{loading.value ? (\\n  <div class=\\\"grid grid-cols-3 gap-4\\\">\\n    {Array.from({ length: 6 }).map((_, i) => (\\n      <Card key={i}>\\n        <Skeleton active>\\n          <Skeleton.Avatar />\\n          <Skeleton.Title />\\n          <Skeleton.Paragraph />\\n        </Skeleton>\\n      </Card>\\n    ))}\\n  </div>\\n) : (\\n  <div class=\\\"grid grid-cols-3 gap-4\\\">\\n    {data.map(item => (\\n      <Card key={item.id}>{item.content}</Card>\\n    ))}\\n  </div>\\n)}\\n```\\n\\n### 3. 表格骨架屏\\n\\n```tsx\\n{loading.value ? (\\n  <div class=\\\"space-y-2\\\">\\n    {Array.from({ length: 10 }).map((_, i) => (\\n      <div key={i} class=\\\"flex space-x-2\\\">\\n        <Skeleton.Paragraph rows={1} width=\\\"20%\\\" />\\n        <Skeleton.Paragraph rows={1} width=\\\"30%\\\" />\\n        <Skeleton.Paragraph rows={1} width=\\\"30%\\\" />\\n        <Skeleton.Paragraph rows={1} width=\\\"20%\\\" />\\n      </div>\\n    ))}\\n  </div>\\n) : (\\n  <Table columns={columns} data={data} />\\n)}\\n```\\n\\n## 常见问题\\n\\n### Q: 如何实现骨架屏的动画效果？\\n\\nA: 使用 `active` 属性实现骨架屏的动画效果。\\n\\n### Q: 如何自定义骨架屏的样式？\\n\\nA: 使用 `className` 属性添加自定义类名，然后使用 CSS 自定义样式。\\n\\n### Q: 如何实现加载状态切换？\\n\\nA: 使用 `loading` 属性控制骨架屏的显示和隐藏。\\n\\n---\\n\\n🌹 Skeleton 组件文档完成！\\n\",\"originTextLength\":4518,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768948363136}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/components/UI/docs/components/Empty.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":169,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":169,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# Empty 空状态\\\\n\\\\n空状态时的展示占位图。\\\\n\\\\n## 何时使用\\\\n\\\\n- 当目前没有数据时，用于显式的用户提示。\\\\n\\\\n## 代码演示\\\\n\\\\n### 基础用法\\\\n\\\\n```tsx\\\\nimport { Empty } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function EmptyBasic() {\\\\n  return (\\\\n    <Empty />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 自定义描述\\\\n\\\\n```tsx\\\\nimport { Empty } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function EmptyDescription() {\\\\n  return (\\\\n    <Empty description=\\\\\\\"暂无数据\\\\\\\" />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 自定义图片\\\\n\\\\n```tsx\\\\nimport { Empty } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function EmptyImage() {\\\\n  return (\\\\n    <Empty\\\\n      image=\\\\\\\"https://gw.alipayobjects.com/zos/antfincdn/ZHrcdLPrvN/empty.svg\\\\\\\"\\\\n      description=\\\\\\\"暂无数据\\\\\\\"\\\\n    />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 自定义内容\\\\n\\\\n```tsx\\\\nimport { Empty } from \\\\'@/components/UI\\\\'\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function EmptyContent() {\\\\n  return (\\\\n    <Empty\\\\n      description=\\\\\\\"暂无数据\\\\\\\"\\\\n    >\\\\n      <Button type=\\\\\\\"primary\\\\\\\">创建</Button>\\\\n    </Empty>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 无图片\\\\n\\\\n```tsx\\\\nimport { Empty } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function EmptyNoImage() {\\\\n  return (\\\\n    <Empty\\\\n      image={Empty.PRESENTED_IMAGE_SIMPLE}\\\\n      description=\\\\\\\"暂无数据\\\\\\\"\\\\n    />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 简单模式\\\\n\\\\n```tsx\\\\nimport { Empty } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function EmptySimple() {\\\\n  return (\\\\n    <Empty\\\\n      image={Empty.PRESENTED_IMAGE_SIMPLE}\\\\n      description=\\\\\\\"暂无数据\\\\\\\"\\\\n    />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n## API\\\\n\\\\n### Empty Props\\\\n\\\\n| 参数 | 说明 | 类型 | 默认值 |\\\\n|------|------|------|--------|\\\\n| image | 图片地址 | `string` | - |\\\\n| description | 描述文本 | `string` | - |\\\\n| className | 自定义类名 | `string` | - |\\\\n\\\\n### Empty 静态属性\\\\n\\\\n| 属性 | 说明 | 类型 |\\\\n|------|------|------|\\\\n| PRESENTED_IMAGE_SIMPLE | 简单模式图片 | `string` |\\\\n| PRESENTED_IMAGE_DEFAULT | 默认图片 | `string` |\\\\n\\\\n## 样式定制\\\\n\\\\n### CSS 变量\\\\n\\\\n```css\\\\n.empty {\\\\n  --empty-text: #6b7280;\\\\n  --empty-description: #9ca3af;\\\\n}\\\\n```\\\\n\\\\n### 自定义样式\\\\n\\\\n```tsx\\\\n<Empty className=\\\\\\\"custom-empty\\\\\\\" />\\\\n\\\\n<style>\\\\n.custom-empty {\\\\n  padding: 4rem;\\\\n}\\\\n\\\\n.custom-empty .empty-description {\\\\n  color: #667eea;\\\\n  font-size: 1.125rem;\\\\n}\\\\n</style>\\\\n```\\\\n\\\\n## 最佳实践\\\\n\\\\n### 1. 列表空状态\\\\n\\\\n```tsx\\\\n{data.length === 0 ? (\\\\n  <Empty description=\\\\\\\"暂无数据\\\\\\\" />\\\\n) : (\\\\n  <List data={data} renderItem={renderItem} />\\\\n)}\\\\n```\\\\n\\\\n### 2. 表格空状态\\\\n\\\\n```tsx\\\\n{data.length === 0 ? (\\\\n  <Empty description=\\\\\\\"暂无数据\\\\\\\" />\\\\n) : (\\\\n  <Table columns={columns} data={data} />\\\\n)}\\\\n```\\\\n\\\\n### 3. 搜索空状态\\\\n\\\\n```tsx\\\\n{searchResults.length === 0 ? (\\\\n  <Empty\\\\n    description=\\\\\\\"未找到相关结果\\\\\\\"\\\\n  >\\\\n    <Button onClick={handleReset}>重置</Button>\\\\n  </Empty>\\\\n) : (\\\\n  <List data={searchResults} renderItem={renderItem} />\\\\n)}\\\\n```\\\\n\\\\n### 4. 权限空状态\\\\n\\\\n```tsx\\\\n{hasPermission ? (\\\\n  <List data={data} renderItem={renderItem} />\\\\n) : (\\\\n  <Empty\\\\n    description=\\\\\\\"您没有权限查看此内容\\\\\\\"\\\\n  >\\\\n    <Button onClick={handleApplyPermission}>申请权限</Button>\\\\n  </Empty>\\\\n)}\\\\n```\\\\n\\\\n### 5. 错误空状态\\\\n\\\\n```tsx\\\\n{error ? (\\\\n  <Empty\\\\n    image=\\\\\\\"https://gw.alipayobjects.com/zos/antfincdn/ZHrcdLPrvN/empty.svg\\\\\\\"\\\\n    description=\\\\\\\"加载失败\\\\\\\"\\\\n  >\\\\n    <Button onClick={handleRetry}>重试</Button>\\\\n  </Empty>\\\\n) : (\\\\n  <List data={data} renderItem={renderItem} />\\\\n)}\\\\n```\\\\n\\\\n## 常见问题\\\\n\\\\n### Q: 如何自定义空状态的描述？\\\\n\\\\nA: 使用 `description` 属性自定义空状态的描述。\\\\n\\\\n### Q: 如何自定义空状态的图片？\\\\n\\\\nA: 使用 `image` 属性自定义空状态的图片。\\\\n\\\\n### Q: 如何添加操作按钮？\\\\n\\\\nA: 使用默认插槽添加操作按钮。\\\\n\\\\n---\\\\n\\\\n🌹 Empty 组件文档完成！\\\\n\",\"originAcceptText\":\"# Empty 空状态\\n\\n空状态时的展示占位图。\\n\\n## 何时使用\\n\\n- 当目前没有数据时，用于显式的用户提示。\\n\\n## 代码演示\\n\\n### 基础用法\\n\\n```tsx\\nimport { Empty } from '@/components/UI'\\n\\nexport default function EmptyBasic() {\\n  return (\\n    <Empty />\\n  )\\n}\\n```\\n\\n### 自定义描述\\n\\n```tsx\\nimport { Empty } from '@/components/UI'\\n\\nexport default function EmptyDescription() {\\n  return (\\n    <Empty description=\\\"暂无数据\\\" />\\n  )\\n}\\n```\\n\\n### 自定义图片\\n\\n```tsx\\nimport { Empty } from '@/components/UI'\\n\\nexport default function EmptyImage() {\\n  return (\\n    <Empty\\n      image=\\\"https://gw.alipayobjects.com/zos/antfincdn/ZHrcdLPrvN/empty.svg\\\"\\n      description=\\\"暂无数据\\\"\\n    />\\n  )\\n}\\n```\\n\\n### 自定义内容\\n\\n```tsx\\nimport { Empty } from '@/components/UI'\\nimport { Button } from '@/components/UI'\\n\\nexport default function EmptyContent() {\\n  return (\\n    <Empty\\n      description=\\\"暂无数据\\\"\\n    >\\n      <Button type=\\\"primary\\\">创建</Button>\\n    </Empty>\\n  )\\n}\\n```\\n\\n### 无图片\\n\\n```tsx\\nimport { Empty } from '@/components/UI'\\n\\nexport default function EmptyNoImage() {\\n  return (\\n    <Empty\\n      image={Empty.PRESENTED_IMAGE_SIMPLE}\\n      description=\\\"暂无数据\\\"\\n    />\\n  )\\n}\\n```\\n\\n### 简单模式\\n\\n```tsx\\nimport { Empty } from '@/components/UI'\\n\\nexport default function EmptySimple() {\\n  return (\\n    <Empty\\n      image={Empty.PRESENTED_IMAGE_SIMPLE}\\n      description=\\\"暂无数据\\\"\\n    />\\n  )\\n}\\n```\\n\\n## API\\n\\n### Empty Props\\n\\n| 参数 | 说明 | 类型 | 默认值 |\\n|------|------|------|--------|\\n| image | 图片地址 | `string` | - |\\n| description | 描述文本 | `string` | - |\\n| className | 自定义类名 | `string` | - |\\n\\n### Empty 静态属性\\n\\n| 属性 | 说明 | 类型 |\\n|------|------|------|\\n| PRESENTED_IMAGE_SIMPLE | 简单模式图片 | `string` |\\n| PRESENTED_IMAGE_DEFAULT | 默认图片 | `string` |\\n\\n## 样式定制\\n\\n### CSS 变量\\n\\n```css\\n.empty {\\n  --empty-text: #6b7280;\\n  --empty-description: #9ca3af;\\n}\\n```\\n\\n### 自定义样式\\n\\n```tsx\\n<Empty className=\\\"custom-empty\\\" />\\n\\n<style>\\n.custom-empty {\\n  padding: 4rem;\\n}\\n\\n.custom-empty .empty-description {\\n  color: #667eea;\\n  font-size: 1.125rem;\\n}\\n</style>\\n```\\n\\n## 最佳实践\\n\\n### 1. 列表空状态\\n\\n```tsx\\n{data.length === 0 ? (\\n  <Empty description=\\\"暂无数据\\\" />\\n) : (\\n  <List data={data} renderItem={renderItem} />\\n)}\\n```\\n\\n### 2. 表格空状态\\n\\n```tsx\\n{data.length === 0 ? (\\n  <Empty description=\\\"暂无数据\\\" />\\n) : (\\n  <Table columns={columns} data={data} />\\n)}\\n```\\n\\n### 3. 搜索空状态\\n\\n```tsx\\n{searchResults.length === 0 ? (\\n  <Empty\\n    description=\\\"未找到相关结果\\\"\\n  >\\n    <Button onClick={handleReset}>重置</Button>\\n  </Empty>\\n) : (\\n  <List data={searchResults} renderItem={renderItem} />\\n)}\\n```\\n\\n### 4. 权限空状态\\n\\n```tsx\\n{hasPermission ? (\\n  <List data={data} renderItem={renderItem} />\\n) : (\\n  <Empty\\n    description=\\\"您没有权限查看此内容\\\"\\n  >\\n    <Button onClick={handleApplyPermission}>申请权限</Button>\\n  </Empty>\\n)}\\n```\\n\\n### 5. 错误空状态\\n\\n```tsx\\n{error ? (\\n  <Empty\\n    image=\\\"https://gw.alipayobjects.com/zos/antfincdn/ZHrcdLPrvN/empty.svg\\\"\\n    description=\\\"加载失败\\\"\\n  >\\n    <Button onClick={handleRetry}>重试</Button>\\n  </Empty>\\n) : (\\n  <List data={data} renderItem={renderItem} />\\n)}\\n```\\n\\n## 常见问题\\n\\n### Q: 如何自定义空状态的描述？\\n\\nA: 使用 `description` 属性自定义空状态的描述。\\n\\n### Q: 如何自定义空状态的图片？\\n\\nA: 使用 `image` 属性自定义空状态的图片。\\n\\n### Q: 如何添加操作按钮？\\n\\nA: 使用默认插槽添加操作按钮。\\n\\n---\\n\\n🌹 Empty 组件文档完成！\\n\",\"originTextLength\":3040,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768948376976}]",
