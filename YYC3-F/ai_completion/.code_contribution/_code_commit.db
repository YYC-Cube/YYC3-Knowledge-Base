    classes.push(props.inline ? \\\\'inline-flex\\\\' : \\\\'flex\\\\')\\\\n\\\\n      const directionClasses = {\\\\n        row: \\\\'flex-row\\\\',\\\\n        \\\\'row-reverse\\\\': \\\\'flex-row-reverse\\\\',\\\\n        column: \\\\'flex-col\\\\',\\\\n        \\\\'column-reverse\\\\': \\\\'flex-col-reverse\\\\',\\\\n      }\\\\n      classes.push(directionClasses[props.direction])\\\\n\\\\n      const wrapClasses = {\\\\n        nowrap: \\\\'flex-nowrap\\\\',\\\\n        wrap: \\\\'flex-wrap\\\\',\\\\n        \\\\'wrap-reverse\\\\': \\\\'flex-wrap-reverse\\\\',\\\\n      }\\\\n      classes.push(wrapClasses[props.wrap])\\\\n\\\\n      const justifyClasses = {\\\\n        start: \\\\'justify-start\\\\',\\\\n        center: \\\\'justify-center\\\\',\\\\n        end: \\\\'justify-end\\\\',\\\\n        \\\\'space-between\\\\': \\\\'justify-between\\\\',\\\\n        \\\\'space-around\\\\': \\\\'justify-around\\\\',\\\\n        \\\\'space-evenly\\\\': \\\\'justify-evenly\\\\',\\\\n      }\\\\n      classes.push(justifyClasses[props.justify])\\\\n\\\\n      const alignClasses = {\\\\n        start: \\\\'items-start\\\\',\\\\n        center: \\\\'items-center\\\\',\\\\n        end: \\\\'items-end\\\\',\\\\n        stretch: \\\\'items-stretch\\\\',\\\\n        baseline: \\\\'items-baseline\\\\',\\\\n      }\\\\n      classes.push(alignClasses[props.align])\\\\n\\\\n      return classes.join(\\\\' \\\\')\\\\n    })\\\\n\\\\n    const gapStyle = computed(() => {\\\\n      const gapValue = typeof props.gap === \\\\'number\\\\' ? `${props.gap}px` : props.gap\\\\n      return { gap: gapValue }\\\\n    })\\\\n\\\\n    return () => (\\\\n      <div\\\\n        class={cn(flexClasses.value, props.className)}\\\\n        style={gapStyle.value}\\\\n      >\\\\n        {slots.default?.()}\\\\n      </div>\\\\n    )\\\\n  },\\\\n})\\\\n\\\\nexport const FlexItem = defineComponent({\\\\n  name: \\\\'FlexItem\\\\',\\\\n  props: {\\\\n    className: {\\\\n      type: String,\\\\n      default: \\\\'\\\\',\\\\n    },\\\\n    flex: {\\\\n      type: [Number, String] as PropType<number | string>,\\\\n      default: undefined,\\\\n    },\\\\n    grow: {\\\\n      type: Number,\\\\n      default: undefined,\\\\n    },\\\\n    shrink: {\\\\n      type: Number,\\\\n      default: undefined,\\\\n    },\\\\n    basis: {\\\\n      type: [Number, String] as PropType<number | string>,\\\\n      default: undefined,\\\\n    },\\\\n    alignSelf: {\\\\n      type: String as PropType<\\\\'start\\\\' | \\\\'center\\\\' | \\\\'end\\\\' | \\\\'stretch\\\\' | \\\\'baseline\\\\'>,\\\\n      default: undefined,\\\\n    },\\\\n    order: {\\\\n      type: Number,\\\\n      default: undefined,\\\\n    },\\\\n  },\\\\n  setup(props, { attrs, slots }) {\\\\n    const itemStyle = computed(() => {\\\\n      const style: Record<string, string> = {}\\\\n\\\\n      if (props.flex !== undefined) {\\\\n        style.flex = typeof props.flex === \\\\'number\\\\' ? `${props.flex}` : props.flex\\\\n      }\\\\n\\\\n      if (props.grow !== undefined) {\\\\n        style.flexGrow = `${props.grow}`\\\\n      }\\\\n\\\\n      if (props.shrink !== undefined) {\\\\n        style.flexShrink = `${props.shrink}`\\\\n      }\\\\n\\\\n      if (props.basis !== undefined) {\\\\n        style.flexBasis = typeof props.basis === \\\\'number\\\\' ? `${props.basis}px` : props.basis\\\\n      }\\\\n\\\\n      if (props.alignSelf !== undefined) {\\\\n        const alignSelfClasses = {\\\\n          start: \\\\'flex-start\\\\',\\\\n          center: \\\\'center\\\\',\\\\n          end: \\\\'flex-end\\\\',\\\\n          stretch: \\\\'stretch\\\\',\\\\n          baseline: \\\\'baseline\\\\',\\\\n        }\\\\n        style.alignSelf = alignSelfClasses[props.alignSelf]\\\\n      }\\\\n\\\\n      if (props.order !== undefined) {\\\\n        style.order = `${props.order}`\\\\n      }\\\\n\\\\n      return style\\\\n    })\\\\n\\\\n    return () => (\\\\n      <div\\\\n        class={cn(props.className)}\\\\n        style={itemStyle.value}\\\\n      >\\\\n        {slots.default?.()}\\\\n      </div>\\\\n    )\\\\n  },\\\\n})\\\\n\",\"originAcceptText\":\"/**\\n * @fileoverview YYC³餐饮行业智能化平台 - 弹性布局组件\\n * @description 弹性盒子布局组件，提供灵活的布局方式\\n * @author YYC³\\n * @version 1.0.0\\n * @created 2026-01-21\\n * @copyright Copyright (c) 2026 YYC³\\n * @license MIT\\n */\\n\\nimport { defineComponent, computed, type PropType } from 'vue'\\nimport { cn } from '@/utils/cn'\\n\\nexport const Flex = defineComponent({\\n  name: 'Flex',\\n  props: {\\n    className: {\\n      type: String,\\n      default: '',\\n    },\\n    direction: {\\n      type: String as PropType<'row' | 'row-reverse' | 'column' | 'column-reverse'>,\\n      default: 'row',\\n    },\\n    wrap: {\\n      type: String as PropType<'nowrap' | 'wrap' | 'wrap-reverse'>,\\n      default: 'nowrap',\\n    },\\n    justify: {\\n      type: String as PropType<'start' | 'center' | 'end' | 'space-between' | 'space-around' | 'space-evenly'>,\\n      default: 'start',\\n    },\\n    align: {\\n      type: String as PropType<'start' | 'center' | 'end' | 'stretch' | 'baseline'>,\\n      default: 'start',\\n    },\\n    gap: {\\n      type: [Number, String] as PropType<number | string>,\\n      default: 0,\\n    },\\n    inline: {\\n      type: Boolean,\\n      default: false,\\n    },\\n  },\\n  setup(props, { attrs, slots }) {\\n    const flexClasses = computed(() => {\\n      const classes = []\\n\\n      classes.push(props.inline ? 'inline-flex' : 'flex')\\n\\n      const directionClasses = {\\n        row: 'flex-row',\\n        'row-reverse': 'flex-row-reverse',\\n        column: 'flex-col',\\n        'column-reverse': 'flex-col-reverse',\\n      }\\n      classes.push(directionClasses[props.direction])\\n\\n      const wrapClasses = {\\n        nowrap: 'flex-nowrap',\\n        wrap: 'flex-wrap',\\n        'wrap-reverse': 'flex-wrap-reverse',\\n      }\\n      classes.push(wrapClasses[props.wrap])\\n\\n      const justifyClasses = {\\n        start: 'justify-start',\\n        center: 'justify-center',\\n        end: 'justify-end',\\n        'space-between': 'justify-between',\\n        'space-around': 'justify-around',\\n        'space-evenly': 'justify-evenly',\\n      }\\n      classes.push(justifyClasses[props.justify])\\n\\n      const alignClasses = {\\n        start: 'items-start',\\n        center: 'items-center',\\n        end: 'items-end',\\n        stretch: 'items-stretch',\\n        baseline: 'items-baseline',\\n      }\\n      classes.push(alignClasses[props.align])\\n\\n      return classes.join(' ')\\n    })\\n\\n    const gapStyle = computed(() => {\\n      const gapValue = typeof props.gap === 'number' ? `${props.gap}px` : props.gap\\n      return { gap: gapValue }\\n    })\\n\\n    return () => (\\n      <div\\n        class={cn(flexClasses.value, props.className)}\\n        style={gapStyle.value}\\n      >\\n        {slots.default?.()}\\n      </div>\\n    )\\n  },\\n})\\n\\nexport const FlexItem = defineComponent({\\n  name: 'FlexItem',\\n  props: {\\n    className: {\\n      type: String,\\n      default: '',\\n    },\\n    flex: {\\n      type: [Number, String] as PropType<number | string>,\\n      default: undefined,\\n    },\\n    grow: {\\n      type: Number,\\n      default: undefined,\\n    },\\n    shrink: {\\n      type: Number,\\n      default: undefined,\\n    },\\n    basis: {\\n      type: [Number, String] as PropType<number | string>,\\n      default: undefined,\\n    },\\n    alignSelf: {\\n      type: String as PropType<'start' | 'center' | 'end' | 'stretch' | 'baseline'>,\\n      default: undefined,\\n    },\\n    order: {\\n      type: Number,\\n      default: undefined,\\n    },\\n  },\\n  setup(props, { attrs, slots }) {\\n    const itemStyle = computed(() => {\\n      const style: Record<string, string> = {}\\n\\n      if (props.flex !== undefined) {\\n        style.flex = typeof props.flex === 'number' ? `${props.flex}` : props.flex\\n      }\\n\\n      if (props.grow !== undefined) {\\n        style.flexGrow = `${props.grow}`\\n      }\\n\\n      if (props.shrink !== undefined) {\\n        style.flexShrink = `${props.shrink}`\\n      }\\n\\n      if (props.basis !== undefined) {\\n        style.flexBasis = typeof props.basis === 'number' ? `${props.basis}px` : props.basis\\n      }\\n\\n      if (props.alignSelf !== undefined) {\\n        const alignSelfClasses = {\\n          start: 'flex-start',\\n          center: 'center',\\n          end: 'flex-end',\\n          stretch: 'stretch',\\n          baseline: 'baseline',\\n        }\\n        style.alignSelf = alignSelfClasses[props.alignSelf]\\n      }\\n\\n      if (props.order !== undefined) {\\n        style.order = `${props.order}`\\n      }\\n\\n      return style\\n    })\\n\\n    return () => (\\n      <div\\n        class={cn(props.className)}\\n        style={itemStyle.value}\\n      >\\n        {slots.default?.()}\\n      </div>\\n    )\\n  },\\n})\\n\",\"originTextLength\":4468,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768932163998}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/components/UI/docs/README.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":139,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":139,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# YYC³ UI 组件库文档\\\\n\\\\n## 📚 组件库概述\\\\n\\\\nYYC³ UI 组件库是基于 Vue 3 + TypeScript + Tailwind CSS 构建的现代化 UI 组件库，专为餐饮行业智能化平台设计。\\\\n\\\\n### 🎯 设计原则\\\\n\\\\n- **一致性**: 统一的视觉风格和交互模式\\\\n- **可访问性**: 遵循 WCAG 2.1 标准\\\\n- **响应式**: 适配各种屏幕尺寸\\\\n- **主题化**: 支持明暗主题切换\\\\n- **类型安全**: 完整的 TypeScript 类型定义\\\\n- **性能优化**: 轻量级、高性能\\\\n\\\\n### 📦 组件分类\\\\n\\\\n#### 基础组件\\\\n- [Input](./components/Input.md) - 输入框\\\\n- [Card](./components/Card.md) - 卡片\\\\n- [Badge](./components/Badge.md) - 徽章\\\\n- [Alert](./components/Alert.md) - 警告提示\\\\n\\\\n#### 表单组件\\\\n- [Form](./components/Form.md) - 表单\\\\n- [Select](./components/Select.md) - 选择器\\\\n- [Checkbox](./components/Checkbox.md) - 复选框\\\\n- [Radio](./components/Radio.md) - 单选框\\\\n- [Switch](./components/Switch.md) - 开关\\\\n\\\\n#### 导航组件\\\\n- [Dropdown](./components/Dropdown.md) - 下拉菜单\\\\n- [Breadcrumb](./components/Breadcrumb.md) - 面包屑\\\\n- [Pagination](./components/Pagination.md) - 分页\\\\n\\\\n#### 数据展示组件\\\\n- [Table](./components/Table.md) - 表格\\\\n- [List](./components/List.md) - 列表\\\\n- [Tree](./components/Tree.md) - 树形控件\\\\n- [Timeline](./components/Timeline.md) - 时间轴\\\\n\\\\n#### 反馈组件\\\\n- [Modal](./components/Modal.md) - 模态框\\\\n- [Drawer](./components/Drawer.md) - 抽屉\\\\n- [Dialog](./components/Dialog.md) - 对话框\\\\n- [Tooltip](./components/Tooltip.md) - 提示框\\\\n\\\\n#### 布局组件\\\\n- [Layout](./components/Layout.md) - 布局\\\\n- [Grid](./components/Grid.md) - 网格\\\\n- [Space](./components/Space.md) - 间距\\\\n- [Flex](./components/Flex.md) - 弹性布局\\\\n\\\\n#### 其他组件\\\\n- [Avatar](./components/Avatar.md) - 头像\\\\n- [Divider](./components/Divider.md) - 分割线\\\\n- [Skeleton](./components/Skeleton.md) - 骨架屏\\\\n- [Empty](./components/Empty.md) - 空状态\\\\n\\\\n### 🚀 快速开始\\\\n\\\\n#### 安装\\\\n\\\\n```bash\\\\npnpm install\\\\n```\\\\n\\\\n#### 使用\\\\n\\\\n```tsx\\\\nimport { Button, Input, Card } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function App() {\\\\n  return (\\\\n    <Card>\\\\n      <Input placeholder=\\\\\\\"请输入内容\\\\\\\" />\\\\n      <Button type=\\\\\\\"primary\\\\\\\">提交</Button>\\\\n    </Card>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 🎨 主题配置\\\\n\\\\n#### 主题变量\\\\n\\\\n```typescript\\\\n// src/config/theme.ts\\\\nexport const theme = {\\\\n  colors: {\\\\n    primary: {\\\\n      50: \\\\'#eff6ff\\\\',\\\\n      100: \\\\'#dbeafe\\\\',\\\\n      200: \\\\'#bfdbfe\\\\',\\\\n      300: \\\\'#93c5fd\\\\',\\\\n      400: \\\\'#60a5fa\\\\',\\\\n      500: \\\\'#3b82f6\\\\',\\\\n      600: \\\\'#2563eb\\\\',\\\\n      700: \\\\'#1d4ed8\\\\',\\\\n      800: \\\\'#1e40af\\\\',\\\\n      900: \\\\'#1e3a8a\\\\',\\\\n    },\\\\n    // ... 其他颜色\\\\n  },\\\\n}\\\\n```\\\\n\\\\n#### 使用主题\\\\n\\\\n```tsx\\\\nimport { ThemeProvider } from \\\\'@/components/UI/ThemeProvider\\\\'\\\\n\\\\nexport default function App() {\\\\n  return (\\\\n    <ThemeProvider>\\\\n      <YourApp />\\\\n    </ThemeProvider>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 📖 开发指南\\\\n\\\\n#### 组件开发规范\\\\n\\\\n1. **命名规范**: 使用 PascalCase 命名组件\\\\n2. **类型定义**: 所有 props 必须有类型定义\\\\n3. **样式规范**: 使用 Tailwind CSS 类名\\\\n4. **文档注释**: 每个组件必须有完整的 JSDoc 注释\\\\n5. **测试覆盖**: 每个组件必须有单元测试\\\\n\\\\n#### 组件模板\\\\n\\\\n```tsx\\\\n/**\\\\n * @fileoverview 组件描述\\\\n * @description 详细说明\\\\n * @author YYC³\\\\n * @version 1.0.0\\\\n * @created 2026-01-21\\\\n * @copyright Copyright (c) 2026 YYC³\\\\n * @license MIT\\\\n */\\\\n\\\\nimport { defineComponent, type PropType } from \\\\'vue\\\\'\\\\nimport { cn } from \\\\'@/utils/cn\\\\'\\\\n\\\\nexport const ComponentName = defineComponent({\\\\n  name: \\\\'ComponentName\\\\',\\\\n  props: {\\\\n    // props 定义\\\\n  },\\\\n  emits: [\\\\'event-name\\\\'],\\\\n  setup(props, { emit, slots }) {\\\\n    // 逻辑实现\\\\n    return () => (\\\\n      // JSX 渲染\\\\n    )\\\\n  },\\\\n})\\\\n```\\\\n\\\\n### 🤝 贡献指南\\\\n\\\\n欢迎贡献代码！请遵循以下步骤：\\\\n\\\\n1. Fork 本仓库\\\\n2. 创建特性分支 (`git checkout -b feature/AmazingFeature`)\\\\n3. 提交更改 (`git commit -m \\\\'feat: Add some AmazingFeature\\\\'`)\\\\n4. 推送到分支 (`git push origin feature/AmazingFeature`)\\\\n5. 创建 Pull Request\\\\n\\\\n### 📄 许可证\\\\n\\\\nMIT License\\\\n\",\"originAcceptText\":\"# YYC³ UI 组件库文档\\n\\n## 📚 组件库概述\\n\\nYYC³ UI 组件库是基于 Vue 3 + TypeScript + Tailwind CSS 构建的现代化 UI 组件库，专为餐饮行业智能化平台设计。\\n\\n### 🎯 设计原则\\n\\n- **一致性**: 统一的视觉风格和交互模式\\n- **可访问性**: 遵循 WCAG 2.1 标准\\n- **响应式**: 适配各种屏幕尺寸\\n- **主题化**: 支持明暗主题切换\\n- **类型安全**: 完整的 TypeScript 类型定义\\n- **性能优化**: 轻量级、高性能\\n\\n### 📦 组件分类\\n\\n#### 基础组件\\n- [Input](./components/Input.md) - 输入框\\n- [Card](./components/Card.md) - 卡片\\n- [Badge](./components/Badge.md) - 徽章\\n- [Alert](./components/Alert.md) - 警告提示\\n\\n#### 表单组件\\n- [Form](./components/Form.md) - 表单\\n- [Select](./components/Select.md) - 选择器\\n- [Checkbox](./components/Checkbox.md) - 复选框\\n- [Radio](./components/Radio.md) - 单选框\\n- [Switch](./components/Switch.md) - 开关\\n\\n#### 导航组件\\n- [Dropdown](./components/Dropdown.md) - 下拉菜单\\n- [Breadcrumb](./components/Breadcrumb.md) - 面包屑\\n- [Pagination](./components/Pagination.md) - 分页\\n\\n#### 数据展示组件\\n- [Table](./components/Table.md) - 表格\\n- [List](./components/List.md) - 列表\\n- [Tree](./components/Tree.md) - 树形控件\\n- [Timeline](./components/Timeline.md) - 时间轴\\n\\n#### 反馈组件\\n- [Modal](./components/Modal.md) - 模态框\\n- [Drawer](./components/Drawer.md) - 抽屉\\n- [Dialog](./components/Dialog.md) - 对话框\\n- [Tooltip](./components/Tooltip.md) - 提示框\\n\\n#### 布局组件\\n- [Layout](./components/Layout.md) - 布局\\n- [Grid](./components/Grid.md) - 网格\\n- [Space](./components/Space.md) - 间距\\n- [Flex](./components/Flex.md) - 弹性布局\\n\\n#### 其他组件\\n- [Avatar](./components/Avatar.md) - 头像\\n- [Divider](./components/Divider.md) - 分割线\\n- [Skeleton](./components/Skeleton.md) - 骨架屏\\n- [Empty](./components/Empty.md) - 空状态\\n\\n### 🚀 快速开始\\n\\n#### 安装\\n\\n```bash\\npnpm install\\n```\\n\\n#### 使用\\n\\n```tsx\\nimport { Button, Input, Card } from '@/components/UI'\\n\\nexport default function App() {\\n  return (\\n    <Card>\\n      <Input placeholder=\\\"请输入内容\\\" />\\n      <Button type=\\\"primary\\\">提交</Button>\\n    </Card>\\n  )\\n}\\n```\\n\\n### 🎨 主题配置\\n\\n#### 主题变量\\n\\n```typescript\\n// src/config/theme.ts\\nexport const theme = {\\n  colors: {\\n    primary: {\\n      50: '#eff6ff',\\n      100: '#dbeafe',\\n      200: '#bfdbfe',\\n      300: '#93c5fd',\\n      400: '#60a5fa',\\n      500: '#3b82f6',\\n      600: '#2563eb',\\n      700: '#1d4ed8',\\n      800: '#1e40af',\\n      900: '#1e3a8a',\\n    },\\n    // ... 其他颜色\\n  },\\n}\\n```\\n\\n#### 使用主题\\n\\n```tsx\\nimport { ThemeProvider } from '@/components/UI/ThemeProvider'\\n\\nexport default function App() {\\n  return (\\n    <ThemeProvider>\\n      <YourApp />\\n    </ThemeProvider>\\n  )\\n}\\n```\\n\\n### 📖 开发指南\\n\\n#### 组件开发规范\\n\\n1. **命名规范**: 使用 PascalCase 命名组件\\n2. **类型定义**: 所有 props 必须有类型定义\\n3. **样式规范**: 使用 Tailwind CSS 类名\\n4. **文档注释**: 每个组件必须有完整的 JSDoc 注释\\n5. **测试覆盖**: 每个组件必须有单元测试\\n\\n#### 组件模板\\n\\n```tsx\\n/**\\n * @fileoverview 组件描述\\n * @description 详细说明\\n * @author YYC³\\n * @version 1.0.0\\n * @created 2026-01-21\\n * @copyright Copyright (c) 2026 YYC³\\n * @license MIT\\n */\\n\\nimport { defineComponent, type PropType } from 'vue'\\nimport { cn } from '@/utils/cn'\\n\\nexport const ComponentName = defineComponent({\\n  name: 'ComponentName',\\n  props: {\\n    // props 定义\\n  },\\n  emits: ['event-name'],\\n  setup(props, { emit, slots }) {\\n    // 逻辑实现\\n    return () => (\\n      // JSX 渲染\\n    )\\n  },\\n})\\n```\\n\\n### 🤝 贡献指南\\n\\n欢迎贡献代码！请遵循以下步骤：\\n\\n1. Fork 本仓库\\n2. 创建特性分支 (`git checkout -b feature/AmazingFeature`)\\n3. 提交更改 (`git commit -m 'feat: Add some AmazingFeature'`)\\n4. 推送到分支 (`git push origin feature/AmazingFeature`)\\n5. 创建 Pull Request\\n\\n### 📄 许可证\\n\\nMIT License\\n\",\"originTextLength\":3250,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768932744365}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/components/UI/docs/components/Button.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":121,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":121,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# Button 按钮\\\\n\\\\n按钮用于开始一个即时操作。\\\\n\\\\n## 何时使用\\\\n\\\\n标记了一个（或封装一组）操作命令，响应用户点击行为，触发相应的业务逻辑。\\\\n\\\\n## 代码演示\\\\n\\\\n### 基础用法\\\\n\\\\n使用 `type`、`plain`、`round` 和 `circle` 属性来定义按钮的样式。\\\\n\\\\n```tsx\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function ButtonBasic() {\\\\n  return (\\\\n    <div class=\\\\\\\"space-x-2\\\\\\\">\\\\n      <Button type=\\\\\\\"primary\\\\\\\">主要按钮</Button>\\\\n      <Button>默认按钮</Button>\\\\n      <Button type=\\\\\\\"success\\\\\\\">成功按钮</Button>\\\\n      <Button type=\\\\\\\"warning\\\\\\\">警告按钮</Button>\\\\n      <Button type=\\\\\\\"danger\\\\\\\">危险按钮</Button>\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 禁用状态\\\\n\\\\n按钮不可用状态。\\\\n\\\\n```tsx\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function ButtonDisabled() {\\\\n  return (\\\\n    <div class=\\\\\\\"space-x-2\\\\\\\">\\\\n      <Button type=\\\\\\\"primary\\\\\\\" disabled>主要按钮</Button>\\\\n      <Button disabled>默认按钮</Button>\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 不同尺寸\\\\n\\\\nButton 组件提供除了默认值以外的三种尺寸。\\\\n\\\\n```tsx\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function ButtonSize() {\\\\n  return (\\\\n    <div class=\\\\\\\"space-x-2\\\\\\\">\\\\n      <Button size=\\\\\\\"sm\\\\\\\">小型按钮</Button>\\\\n      <Button>默认按钮</Button>\\\\n      <Button size=\\\\\\\"lg\\\\\\\">大型按钮</Button>\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 加载中状态\\\\n\\\\n点击按钮后进行数据加载操作，在按钮上显示加载状态。\\\\n\\\\n```tsx\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\nimport { ref } from \\\\'vue\\\\'\\\\n\\\\nexport default function ButtonLoading() {\\\\n  const loading = ref(false)\\\\n\\\\n  const handleClick = () => {\\\\n    loading.value = true\\\\n    setTimeout(() => {\\\\n      loading.value = false\\\\n    }, 2000)\\\\n  }\\\\n\\\\n  return (\\\\n    <Button type=\\\\\\\"primary\\\\\\\" loading={loading.value} onClick={handleClick}>\\\\n      加载中\\\\n    </Button>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 图标按钮\\\\n\\\\n带图标的按钮可增强辨识度（有文字）或节省空间（无文字）。\\\\n\\\\n```tsx\\\\nimport { Button } from \\\\'@/components/UI\\\\'\\\\nimport { Search, Download } from \\\\'lucide-vue-next\\\\'\\\\n\\\\nexport default function ButtonIcon() {\\\\n  return (\\\\n    <div class=\\\\\\\"space-x-2\\\\\\\">\\\\n      <Button type=\\\\\\\"primary\\\\\\\" icon={<Search size={16} />}>\\\\n        搜索\\\\n      </Button>\\\\n      <Button type=\\\\\\\"primary\\\\\\\" icon={<Download size={16} />} />\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n## API\\\\n\\\\n### Button Props\\\\n\\\\n| 参数 | 说明 | 类型 | 可选值 | 默认值 |\\\\n|------|------|------|--------|--------|\\\\n| type | 类型 | `string` | `primary` / `success` / `warning` / `danger` / `default` | `default` |\\\\n| size | 尺寸 | `string` | `sm` / `md` / `lg` | `md` |\\\\n| plain | 是否朴素按钮 | `boolean` | - | `false` |\\\\n| round | 是否圆角按钮 | `boolean` | - | `false` |\\\\n| circle | 是否圆形按钮 | `boolean` | - | `false` |\\\\n| loading | 是否加载中状态 | `boolean` | - | `false` |\\\\n| disabled | 是否禁用状态 | `boolean` | - | `false` |\\\\n| icon | 图标组件 | `Component` | - | - |\\\\n| block | 是否块级按钮 | `boolean` | - | `false` |\\\\n| danger | 是否危险按钮 | `boolean` | - | `false` |\\\\n| ghost | 是否幽灵按钮 | `boolean` | - | `false` |\\\\n| link | 是否链接按钮 | `boolean` | - | `false` |\\\\n\\\\n### Button Events\\\\n\\\\n| 事件名 | 说明 | 回调参数 |\\\\n|--------|------|----------|\\\\n| click | 点击按钮时触发 | `(event: MouseEvent) => void` |\\\\n\\\\n## 样式定制\\\\n\\\\n### 使用 className\\\\n\\\\n```tsx\\\\n<Button className=\\\\\\\"custom-button\\\\\\\">自定义按钮</Button>\\\\n```\\\\n\\\\n### 使用 Tailwind CSS\\\\n\\\\n```tsx\\\\n<Button className=\\\\\\\"bg-gradient-to-r from-purple-500 to-pink-500\\\\\\\">\\\\n  渐变按钮\\\\n</Button>\\\\n```\\\\n\\\\n## 最佳实践\\\\n\\\\n1. **主要操作**: 使用 `type=\\\\\\\"primary\\\\\\\"` 突出显示主要操作\\\\n2. **次要操作**: 使用默认样式\\\\n3. **危险操作**: 使用 `type=\\\\\\\"danger\\\\\\\"` 警示用户\\\\n4. **加载状态**: 在异步操作时显示加载状态\\\\n5. **禁用状态**: 在不可操作时禁用按钮\\\\n\",\"originAcceptText\":\"# Button 按钮\\n\\n按钮用于开始一个即时操作。\\n\\n## 何时使用\\n\\n标记了一个（或封装一组）操作命令，响应用户点击行为，触发相应的业务逻辑。\\n\\n## 代码演示\\n\\n### 基础用法\\n\\n使用 `type`、`plain`、`round` 和 `circle` 属性来定义按钮的样式。\\n\\n```tsx\\nimport { Button } from '@/components/UI'\\n\\nexport default function ButtonBasic() {\\n  return (\\n    <div class=\\\"space-x-2\\\">\\n      <Button type=\\\"primary\\\">主要按钮</Button>\\n      <Button>默认按钮</Button>\\n      <Button type=\\\"success\\\">成功按钮</Button>\\n      <Button type=\\\"warning\\\">警告按钮</Button>\\n      <Button type=\\\"danger\\\">危险按钮</Button>\\n    </div>\\n  )\\n}\\n```\\n\\n### 禁用状态\\n\\n按钮不可用状态。\\n\\n```tsx\\nimport { Button } from '@/components/UI'\\n\\nexport default function ButtonDisabled() {\\n  return (\\n    <div class=\\\"space-x-2\\\">\\n      <Button type=\\\"primary\\\" disabled>主要按钮</Button>\\n      <Button disabled>默认按钮</Button>\\n    </div>\\n  )\\n}\\n```\\n\\n### 不同尺寸\\n\\nButton 组件提供除了默认值以外的三种尺寸。\\n\\n```tsx\\nimport { Button } from '@/components/UI'\\n\\nexport default function ButtonSize() {\\n  return (\\n    <div class=\\\"space-x-2\\\">\\n      <Button size=\\\"sm\\\">小型按钮</Button>\\n      <Button>默认按钮</Button>\\n      <Button size=\\\"lg\\\">大型按钮</Button>\\n    </div>\\n  )\\n}\\n```\\n\\n### 加载中状态\\n\\n点击按钮后进行数据加载操作，在按钮上显示加载状态。\\n\\n```tsx\\nimport { Button } from '@/components/UI'\\nimport { ref } from 'vue'\\n\\nexport default function ButtonLoading() {\\n  const loading = ref(false)\\n\\n  const handleClick = () => {\\n    loading.value = true\\n    setTimeout(() => {\\n      loading.value = false\\n    }, 2000)\\n  }\\n\\n  return (\\n    <Button type=\\\"primary\\\" loading={loading.value} onClick={handleClick}>\\n      加载中\\n    </Button>\\n  )\\n}\\n```\\n\\n### 图标按钮\\n\\n带图标的按钮可增强辨识度（有文字）或节省空间（无文字）。\\n\\n```tsx\\nimport { Button } from '@/components/UI'\\nimport { Search, Download } from 'lucide-vue-next'\\n\\nexport default function ButtonIcon() {\\n  return (\\n    <div class=\\\"space-x-2\\\">\\n      <Button type=\\\"primary\\\" icon={<Search size={16} />}>\\n        搜索\\n      </Button>\\n      <Button type=\\\"primary\\\" icon={<Download size={16} />} />\\n    </div>\\n  )\\n}\\n```\\n\\n## API\\n\\n### Button Props\\n\\n| 参数 | 说明 | 类型 | 可选值 | 默认值 |\\n|------|------|------|--------|--------|\\n| type | 类型 | `string` | `primary` / `success` / `warning` / `danger` / `default` | `default` |\\n| size | 尺寸 | `string` | `sm` / `md` / `lg` | `md` |\\n| plain | 是否朴素按钮 | `boolean` | - | `false` |\\n| round | 是否圆角按钮 | `boolean` | - | `false` |\\n| circle | 是否圆形按钮 | `boolean` | - | `false` |\\n| loading | 是否加载中状态 | `boolean` | - | `false` |\\n| disabled | 是否禁用状态 | `boolean` | - | `false` |\\n| icon | 图标组件 | `Component` | - | - |\\n| block | 是否块级按钮 | `boolean` | - | `false` |\\n| danger | 是否危险按钮 | `boolean` | - | `false` |\\n| ghost | 是否幽灵按钮 | `boolean` | - | `false` |\\n| link | 是否链接按钮 | `boolean` | - | `false` |\\n\\n### Button Events\\n\\n| 事件名 | 说明 | 回调参数 |\\n|--------|------|----------|\\n| click | 点击按钮时触发 | `(event: MouseEvent) => void` |\\n\\n## 样式定制\\n\\n### 使用 className\\n\\n```tsx\\n<Button className=\\\"custom-button\\\">自定义按钮</Button>\\n```\\n\\n### 使用 Tailwind CSS\\n\\n```tsx\\n<Button className=\\\"bg-gradient-to-r from-purple-500 to-pink-500\\\">\\n  渐变按钮\\n</Button>\\n```\\n\\n## 最佳实践\\n\\n1. **主要操作**: 使用 `type=\\\"primary\\\"` 突出显示主要操作\\n2. **次要操作**: 使用默认样式\\n3. **危险操作**: 使用 `type=\\\"danger\\\"` 警示用户\\n4. **加载状态**: 在异步操作时显示加载状态\\n5. **禁用状态**: 在不可操作时禁用按钮\\n\",\"originTextLength\":3039,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768932762857}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/components/UI/docs/components/Input.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":132,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":132,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# Input 输入框\\\\n\\\\n通过鼠标或键盘输入内容，是最基础的表单域的包装。\\\\n\\\\n## 何时使用\\\\n\\\\n- 需要用户输入表单域内容时。\\\\n- 提供组合型输入框，带搜索的输入框，还可以进行大小选择。\\\\n\\\\n## 代码演示\\\\n\\\\n### 基础用法\\\\n\\\\n基本的输入框用法。\\\\n\\\\n```tsx\\\\nimport { Input } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function InputBasic() {\\\\n  return (\\\\n    <div class=\\\\\\\"space-y-4\\\\\\\">\\\\n      <Input placeholder=\\\\\\\"请输入内容\\\\\\\" />\\\\n      <Input placeholder=\\\\\\\"请输入密码\\\\\\\" type=\\\\\\\"password\\\\\\\" />\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 禁用状态\\\\n\\\\n通过 `disabled` 属性指定是否禁用。\\\\n\\\\n```tsx\\\\nimport { Input } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function InputDisabled() {\\\\n  return (\\\\n    <Input placeholder=\\\\\\\"禁用状态\\\\\\\" disabled />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 可清空\\\\n\\\\n使用 `clearable` 属性即可得到一个可清空的输入框。\\\\n\\\\n```tsx\\\\nimport { Input } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function InputClearable() {\\\\n  return (\\\\n    <Input placeholder=\\\\\\\"可清空\\\\\\\" clearable />\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 带图标\\\\n\\\\n通过 `prefix` 和 `suffix` 插槽可以在输入框前后添加图标。\\\\n\\\\n```tsx\\\\nimport { Input } from \\\\'@/components/UI\\\\'\\\\nimport { Search, User } from \\\\'lucide-vue-next\\\\'\\\\n\\\\nexport default function InputIcon() {\\\\n  return (\\\\n    <div class=\\\\\\\"space-y-4\\\\\\\">\\\\n      <Input placeholder=\\\\\\\"请输入用户名\\\\\\\" prefix={<User size={16} />} />\\\\n      <Input placeholder=\\\\\\\"请输入搜索内容\\\\\\\" suffix={<Search size={16} />} />\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 不同尺寸\\\\n\\\\n通过 `size` 属性指定输入框的尺寸。\\\\n\\\\n```tsx\\\\nimport { Input } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function InputSize() {\\\\n  return (\\\\n    <div class=\\\\\\\"space-y-4\\\\\\\">\\\\n      <Input size=\\\\\\\"sm\\\\\\\" placeholder=\\\\\\\"小型输入框\\\\\\\" />\\\\n      <Input placeholder=\\\\\\\"默认输入框\\\\\\\" />\\\\n      <Input size=\\\\\\\"lg\\\\\\\" placeholder=\\\\\\\"大型输入框\\\\\\\" />\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 复合型输入框\\\\n\\\\n通过前置和后置的插槽可以对输入框进行组合。\\\\n\\\\n```tsx\\\\nimport { Input } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function InputGroup() {\\\\n  return (\\\\n    <div class=\\\\\\\"space-y-4\\\\\\\">\\\\n      <Input\\\\n        placeholder=\\\\\\\"https://example.com\\\\\\\"\\\\n        prefix=\\\\\\\"https://\\\\\\\"\\\\n      />\\\\n      <Input\\\\n        placeholder=\\\\\\\"请选择\\\\\\\"\\\\n        suffix=\\\\\\\".com\\\\\\\"\\\\n      />\\\\n    </div>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n## API\\\\n\\\\n### Input Props\\\\n\\\\n| 参数 | 说明 | 类型 | 可选值 | 默认值 |\\\\n|------|------|------|--------|--------|\\\\n| modelValue | 绑定值 | `string \\\\\\\\| number` | - | `\\\\'\\\\'` |\\\\n| type | 类型 | `string` | `text` / `password` / `email` / `number` / `tel` / `url` / `search` | `text` |\\\\n| placeholder | 占位文本 | `string` | - | `\\\\'\\\\'` |\\\\n| disabled | 是否禁用 | `boolean` | - | `false` |\\\\n| readonly | 是否只读 | `boolean` | - | `false` |\\\\n| required | 是否必填 | `boolean` | - | `false` |\\\\n| size | 尺寸 | `string` | `sm` / `md` / `lg` | `md` |\\\\n| error | 是否错误状态 | `boolean` | - | `false` |\\\\n| errorMessage | 错误提示信息 | `string` | - | `\\\\'\\\\'` |\\\\n| prefix | 前置图标或文本 | `string \\\\\\\\| Component` | - | - |\\\\n| suffix | 后置图标或文本 | `string \\\\\\\\| Component` | - | - |\\\\n| clearable | 是否可清空 | `boolean` | - | `false` |\\\\n| maxLength | 最大输入长度 | `number` | - | - |\\\\n| showWordLimit | 是否显示字数统计 | `boolean` | - | `false` |\\\\n| autocomplete | 自动完成 | `string` | - | - |\\\\n\\\\n### Input Events\\\\n\\\\n| 事件名 | 说明 | 回调参数 |\\\\n|--------|------|----------|\\\\n| update:modelValue | 值改变时触发 | `(value: string \\\\\\\\| number) => void` |\\\\n| focus | 获得焦点时触发 | `(event: FocusEvent) => void` |\\\\n| blur | 失去焦点时触发 | `(event: FocusEvent) => void` |\\\\n| change | 值改变且失焦后触发 | `(value: string \\\\\\\\| number) => void` |\\\\n| keydown | 按下键盘时触发 | `(event: KeyboardEvent) => void` |\\\\n| keyup | 松开键盘时触发 | `(event: KeyboardEvent) => void` |\\\\n| keypress | 按下字符键时触发 | `(event: KeyboardEvent) => void` |\\\\n| enter | 按下回车键时触发 | `(event: KeyboardEvent) => void` |\\\\n| clear | 点击清空按钮时触发 | `() => void` |\\\\n\\\\n## 样式定制\\\\n\\\\n### 错误状态\\\\n\\\\n```tsx\\\\n<Input error errorMessage=\\\\\\\"请输入有效的内容\\\\\\\" />\\\\n```\\\\n\\\\n### 自定义样式\\\\n\\\\n```tsx\\\\n<Input className=\\\\\\\"border-2 border-primary-500 rounded-lg\\\\\\\" />\\\\n```\\\\n\\\\n## 最佳实践\\\\n\\\\n1. **标签**: 始终为输入框提供清晰的标签\\\\n2. **占位符**: 使用占位符提供格式提示\\\\n3. **验证**: 实时验证用户输入并提供反馈\\\\n4. **错误提示**: 显示具体的错误信息帮助用户修正\\\\n5. **自动完成**: 为常用输入类型启用自动完成\\\\n\",\"originAcceptText\":\"# Input 输入框\\n\\n通过鼠标或键盘输入内容，是最基础的表单域的包装。\\n\\n## 何时使用\\n\\n- 需要用户输入表单域内容时。\\n- 提供组合型输入框，带搜索的输入框，还可以进行大小选择。\\n\\n## 代码演示\\n\\n### 基础用法\\n\\n基本的输入框用法。\\n\\n```tsx\\nimport { Input } from '@/components/UI'\\n\\nexport default function InputBasic() {\\n  return (\\n    <div class=\\\"space-y-4\\\">\\n      <Input placeholder=\\\"请输入内容\\\" />\\n      <Input placeholder=\\\"请输入密码\\\" type=\\\"password\\\" />\\n    </div>\\n  )\\n}\\n```\\n\\n### 禁用状态\\n\\n通过 `disabled` 属性指定是否禁用。\\n\\n```tsx\\nimport { Input } from '@/components/UI'\\n\\nexport default function InputDisabled() {\\n  return (\\n    <Input placeholder=\\\"禁用状态\\\" disabled />\\n  )\\n}\\n```\\n\\n### 可清空\\n\\n使用 `clearable` 属性即可得到一个可清空的输入框。\\n\\n```tsx\\nimport { Input } from '@/components/UI'\\n\\nexport default function InputClearable() {\\n  return (\\n    <Input placeholder=\\\"可清空\\\" clearable />\\n  )\\n}\\n```\\n\\n### 带图标\\n\\n通过 `prefix` 和 `suffix` 插槽可以在输入框前后添加图标。\\n\\n```tsx\\nimport { Input } from '@/components/UI'\\nimport { Search, User } from 'lucide-vue-next'\\n\\nexport default function InputIcon() {\\n  return (\\n    <div class=\\\"space-y-4\\\">\\n      <Input placeholder=\\\"请输入用户名\\\" prefix={<User size={16} />} />\\n      <Input placeholder=\\\"请输入搜索内容\\\" suffix={<Search size={16} />} />\\n    </div>\\n  )\\n}\\n```\\n\\n### 不同尺寸\\n\\n通过 `size` 属性指定输入框的尺寸。\\n\\n```tsx\\nimport { Input } from '@/components/UI'\\n\\nexport default function InputSize() {\\n  return (\\n    <div class=\\\"space-y-4\\\">\\n      <Input size=\\\"sm\\\" placeholder=\\\"小型输入框\\\" />\\n      <Input placeholder=\\\"默认输入框\\\" />\\n      <Input size=\\\"lg\\\" placeholder=\\\"大型输入框\\\" />\\n    </div>\\n  )\\n}\\n```\\n\\n### 复合型输入框\\n\\n通过前置和后置的插槽可以对输入框进行组合。\\n\\n```tsx\\nimport { Input } from '@/components/UI'\\n\\nexport default function InputGroup() {\\n  return (\\n    <div class=\\\"space-y-4\\\">\\n      <Input\\n        placeholder=\\\"https://example.com\\\"\\n        prefix=\\\"https://\\\"\\n      />\\n      <Input\\n        placeholder=\\\"请选择\\\"\\n        suffix=\\\".com\\\"\\n      />\\n    </div>\\n  )\\n}\\n```\\n\\n## API\\n\\n### Input Props\\n\\n| 参数 | 说明 | 类型 | 可选值 | 默认值 |\\n|------|------|------|--------|--------|\\n| modelValue | 绑定值 | `string \\\\| number` | - | `''` |\\n| type | 类型 | `string` | `text` / `password` / `email` / `number` / `tel` / `url` / `search` | `text` |\\n| placeholder | 占位文本 | `string` | - | `''` |\\n| disabled | 是否禁用 | `boolean` | - | `false` |\\n| readonly | 是否只读 | `boolean` | - | `false` |\\n| required | 是否必填 | `boolean` | - | `false` |\\n| size | 尺寸 | `string` | `sm` / `md` / `lg` | `md` |\\n| error | 是否错误状态 | `boolean` | - | `false` |\\n| errorMessage | 错误提示信息 | `string` | - | `''` |\\n| prefix | 前置图标或文本 | `string \\\\| Component` | - | - |\\n| suffix | 后置图标或文本 | `string \\\\| Component` | - | - |\\n| clearable | 是否可清空 | `boolean` | - | `false` |\\n| maxLength | 最大输入长度 | `number` | - | - |\\n| showWordLimit | 是否显示字数统计 | `boolean` | - | `false` |\\n| autocomplete | 自动完成 | `string` | - | - |\\n\\n### Input Events\\n\\n| 事件名 | 说明 | 回调参数 |\\n|--------|------|----------|\\n| update:modelValue | 值改变时触发 | `(value: string \\\\| number) => void` |\\n| focus | 获得焦点时触发 | `(event: FocusEvent) => void` |\\n| blur | 失去焦点时触发 | `(event: FocusEvent) => void` |\\n| change | 值改变且失焦后触发 | `(value: string \\\\| number) => void` |\\n| keydown | 按下键盘时触发 | `(event: KeyboardEvent) => void` |\\n| keyup | 松开键盘时触发 | `(event: KeyboardEvent) => void` |\\n| keypress | 按下字符键时触发 | `(event: KeyboardEvent) => void` |\\n| enter | 按下回车键时触发 | `(event: KeyboardEvent) => void` |\\n| clear | 点击清空按钮时触发 | `() => void` |\\n\\n## 样式定制\\n\\n### 错误状态\\n\\n```tsx\\n<Input error errorMessage=\\\"请输入有效的内容\\\" />\\n```\\n\\n### 自定义样式\\n\\n```tsx\\n<Input className=\\\"border-2 border-primary-500 rounded-lg\\\" />\\n```\\n\\n## 最佳实践\\n\\n1. **标签**: 始终为输入框提供清晰的标签\\n2. **占位符**: 使用占位符提供格式提示\\n3. **验证**: 实时验证用户输入并提供反馈\\n4. **错误提示**: 显示具体的错误信息帮助用户修正\\n5. **自动完成**: 为常用输入类型启用自动完成\\n\",\"originTextLength\":3509,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768932784795}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/components/UI/docs/components/Card.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":132,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":132,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# Card 卡片\\\\n\\\\n将信息聚合在卡片容器中展示。\\\\n\\\\n## 何时使用\\\\n\\\\n- 需要突出显示某个内容时\\\\n- 需要将相关内容分组展示时\\\\n- 需要展示图片、文本、操作按钮等内容时\\\\n\\\\n## 代码演示\\\\n\\\\n### 基础用法\\\\n\\\\n包含标题、内容和操作。\\\\n\\\\n```tsx\\\\nimport { Card, CardHeader, CardTitle, CardContent, CardFooter } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function CardBasic() {\\\\n  return (\\\\n    <Card>\\\\n      <CardHeader>\\\\n        <CardTitle>卡片标题</CardTitle>\\\\n      </CardHeader>\\\\n      <CardContent>\\\\n        <p>这是卡片的内容区域</p>\\\\n      </CardContent>\\\\n      <CardFooter>\\\\n        <button class=\\\\\\\"px-4 py-2 bg-primary-600 text-white rounded-lg\\\\\\\">\\\\n          确认\\\\n        </button>\\\\n      </CardFooter>\\\\n    </Card>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 简单卡片\\\\n\\\\n只有内容区域的简单卡片。\\\\n\\\\n```tsx\\\\nimport { Card } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function CardSimple() {\\\\n  return (\\\\n    <Card>\\\\n      <p>这是一个简单的卡片</p>\\\\n    </Card>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 带图片\\\\n\\\\n卡片可以包含图片。\\\\n\\\\n```tsx\\\\nimport { Card, CardHeader, CardTitle, CardContent } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function CardImage() {\\\\n  return (\\\\n    <Card className=\\\\\\\"max-w-sm\\\\\\\">\\\\n      <img\\\\n        src=\\\\\\\"/placeholder-image.jpg\\\\\\\"\\\\n        alt=\\\\\\\"示例图片\\\\\\\"\\\\n        class=\\\\\\\"w-full h-48 object-cover rounded-t-lg\\\\\\\"\\\\n      />\\\\n      <CardHeader>\\\\n        <CardTitle>带图片的卡片</CardTitle>\\\\n      </CardHeader>\\\\n      <CardContent>\\\\n        <p>这是卡片的内容描述</p>\\\\n      </CardContent>\\\\n    </Card>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 可悬停\\\\n\\\\n鼠标悬停时显示阴影效果。\\\\n\\\\n```tsx\\\\nimport { Card, CardHeader, CardTitle, CardContent } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function CardHover() {\\\\n  return (\\\\n    <Card hoverable>\\\\n      <CardHeader>\\\\n        <CardTitle>可悬停卡片</CardTitle>\\\\n      </CardHeader>\\\\n      <CardContent>\\\\n        <p>鼠标悬停查看效果</p>\\\\n      </CardContent>\\\\n    </Card>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 加载状态\\\\n\\\\n卡片加载时的占位状态。\\\\n\\\\n```tsx\\\\nimport { Card } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function CardLoading() {\\\\n  return (\\\\n    <Card loading>\\\\n      <p>加载中...</p>\\\\n    </Card>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n## API\\\\n\\\\n### Card Props\\\\n\\\\n| 参数 | 说明 | 类型 | 可选值 | 默认值 |\\\\n|------|------|------|--------|--------|\\\\n| hoverable | 是否可悬停 | `boolean` | - | `false` |\\\\n| bordered | 是否有边框 | `boolean` | - | `true` |\\\\n| shadow | 阴影等级 | `string` | `none` / `sm` / `md` / `lg` / `xl` | `md` |\\\\n| padding | 内边距 | `string` | `none` / `sm` / `md` / `lg` | `md` |\\\\n| loading | 是否加载中 | `boolean` | - | `false` |\\\\n\\\\n### CardHeader Props\\\\n\\\\n| 参数 | 说明 | 类型 | 可选值 | 默认值 |\\\\n|------|------|------|--------|--------|\\\\n| divider | 是否显示分隔线 | `boolean` | - | `false` |\\\\n\\\\n### CardTitle Props\\\\n\\\\n| 参数 | 说明 | 类型 | 可选值 | 默认值 |\\\\n|------|------|------|--------|--------|\\\\n| level | 标题级别 | `number` | `1` / `2` / `3` / `4` / `5` / `6` | `3` |\\\\n\\\\n### CardContent Props\\\\n\\\\n无特定属性\\\\n\\\\n### CardFooter Props\\\\n\\\\n无特定属性\\\\n\\\\n## 样式定制\\\\n\\\\n### 自定义阴影\\\\n\\\\n```tsx\\\\n<Card shadow=\\\\\\\"xl\\\\\\\">超大阴影</Card>\\\\n```\\\\n\\\\n### 无边框\\\\n\\\\n```tsx\\\\n<Card bordered={false}>无边框卡片</Card>\\\\n```\\\\n\\\\n### 自定义内边距\\\\n\\\\n```tsx\\\\n<Card padding=\\\\\\\"lg\\\\\\\">大内边距</Card>\\\\n```\\\\n\\\\n## 最佳实践\\\\n\\\\n1. **内容分组**: 使用卡片将相关内容分组\\\\n2. **视觉层次**: 使用阴影和边框区分卡片\\\\n3. **交互反馈**: 为可操作的卡片添加悬停效果\\\\n4. **加载状态**: 在数据加载时显示加载状态\\\\n5. **响应式**: 确保卡片在不同屏幕尺寸下正常显示\\\\n\",\"originAcceptText\":\"# Card 卡片\\n\\n将信息聚合在卡片容器中展示。\\n\\n## 何时使用\\n\\n- 需要突出显示某个内容时\\n- 需要将相关内容分组展示时\\n- 需要展示图片、文本、操作按钮等内容时\\n\\n## 代码演示\\n\\n### 基础用法\\n\\n包含标题、内容和操作。\\n\\n```tsx\\nimport { Card, CardHeader, CardTitle, CardContent, CardFooter } from '@/components/UI'\\n\\nexport default function CardBasic() {\\n  return (\\n    <Card>\\n      <CardHeader>\\n        <CardTitle>卡片标题</CardTitle>\\n      </CardHeader>\\n      <CardContent>\\n        <p>这是卡片的内容区域</p>\\n      </CardContent>\\n      <CardFooter>\\n        <button class=\\\"px-4 py-2 bg-primary-600 text-white rounded-lg\\\">\\n          确认\\n        </button>\\n      </CardFooter>\\n    </Card>\\n  )\\n}\\n```\\n\\n### 简单卡片\\n\\n只有内容区域的简单卡片。\\n\\n```tsx\\nimport { Card } from '@/components/UI'\\n\\nexport default function CardSimple() {\\n  return (\\n    <Card>\\n      <p>这是一个简单的卡片</p>\\n    </Card>\\n  )\\n}\\n```\\n\\n### 带图片\\n\\n卡片可以包含图片。\\n\\n```tsx\\nimport { Card, CardHeader, CardTitle, CardContent } from '@/components/UI'\\n\\nexport default function CardImage() {\\n  return (\\n    <Card className=\\\"max-w-sm\\\">\\n      <img\\n        src=\\\"/placeholder-image.jpg\\\"\\n        alt=\\\"示例图片\\\"\\n        class=\\\"w-full h-48 object-cover rounded-t-lg\\\"\\n      />\\n      <CardHeader>\\n        <CardTitle>带图片的卡片</CardTitle>\\n      </CardHeader>\\n      <CardContent>\\n        <p>这是卡片的内容描述</p>\\n      </CardContent>\\n    </Card>\\n  )\\n}\\n```\\n\\n### 可悬停\\n\\n鼠标悬停时显示阴影效果。\\n\\n```tsx\\nimport { Card, CardHeader, CardTitle, CardContent } from '@/components/UI'\\n\\nexport default function CardHover() {\\n  return (\\n    <Card hoverable>\\n      <CardHeader>\\n        <CardTitle>可悬停卡片</CardTitle>\\n      </CardHeader>\\n      <CardContent>\\n        <p>鼠标悬停查看效果</p>\\n      </CardContent>\\n    </Card>\\n  )\\n}\\n```\\n\\n### 加载状态\\n\\n卡片加载时的占位状态。\\n\\n```tsx\\nimport { Card } from '@/components/UI'\\n\\nexport default function CardLoading() {\\n  return (\\n    <Card loading>\\n      <p>加载中...</p>\\n    </Card>\\n  )\\n}\\n```\\n\\n## API\\n\\n### Card Props\\n\\n| 参数 | 说明 | 类型 | 可选值 | 默认值 |\\n|------|------|------|--------|--------|\\n| hoverable | 是否可悬停 | `boolean` | - | `false` |\\n| bordered | 是否有边框 | `boolean` | - | `true` |\\n| shadow | 阴影等级 | `string` | `none` / `sm` / `md` / `lg` / `xl` | `md` |\\n| padding | 内边距 | `string` | `none` / `sm` / `md` / `lg` | `md` |\\n| loading | 是否加载中 | `boolean` | - | `false` |\\n\\n### CardHeader Props\\n\\n| 参数 | 说明 | 类型 | 可选值 | 默认值 |\\n|------|------|------|--------|--------|\\n| divider | 是否显示分隔线 | `boolean` | - | `false` |\\n\\n### CardTitle Props\\n\\n| 参数 | 说明 | 类型 | 可选值 | 默认值 |\\n|------|------|------|--------|--------|\\n| level | 标题级别 | `number` | `1` / `2` / `3` / `4` / `5` / `6` | `3` |\\n\\n### CardContent Props\\n\\n无特定属性\\n\\n### CardFooter Props\\n\\n无特定属性\\n\\n## 样式定制\\n\\n### 自定义阴影\\n\\n```tsx\\n<Card shadow=\\\"xl\\\">超大阴影</Card>\\n```\\n\\n### 无边框\\n\\n```tsx\\n<Card bordered={false}>无边框卡片</Card>\\n```\\n\\n### 自定义内边距\\n\\n```tsx\\n<Card padding=\\\"lg\\\">大内边距</Card>\\n```\\n\\n## 最佳实践\\n\\n1. **内容分组**: 使用卡片将相关内容分组\\n2. **视觉层次**: 使用阴影和边框区分卡片\\n3. **交互反馈**: 为可操作的卡片添加悬停效果\\n4. **加载状态**: 在数据加载时显示加载状态\\n5. **响应式**: 确保卡片在不同屏幕尺寸下正常显示\\n\",\"originTextLength\":2812,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768932802183}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/components/UI/docs/components/Modal.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":190,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":190,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# Modal 模态框\\\\n\\\\n模态框对话框，在保留当前页面状态的情况下，提示用户进行相关操作。\\\\n\\\\n## 何时使用\\\\n\\\\n- 需要用户处理事务，又不希望跳转页面以致打断工作流程时，可以使用 `Modal` 在当前页面正中打开一个浮层，承载相应的操作。\\\\n\\\\n## 代码演示\\\\n\\\\n### 基础用法\\\\n\\\\n模态框需要通过 `visible` 属性来控制显示状态。\\\\n\\\\n```tsx\\\\nimport { Modal, Button } from \\\\'@/components/UI\\\\'\\\\nimport { ref } from \\\\'vue\\\\'\\\\n\\\\nexport default function ModalBasic() {\\\\n  const visible = ref(false)\\\\n\\\\n  return (\\\\n    <>\\\\n      <Button type=\\\\\\\"primary\\\\\\\" onClick={() => visible.value = true}>\\\\n        打开模态框\\\\n      </Button>\\\\n      <Modal\\\\n        visible={visible.value}\\\\n        title=\\\\\\\"基础模态框\\\\\\\"\\\\n        onUpdate:visible={(v) => visible.value = v}\\\\n      >\\\\n        <p>这是一段内容</p>\\\\n      </Modal>\\\\n    </>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 自定义页脚\\\\n\\\\n自定义底部按钮。\\\\n\\\\n```tsx\\\\nimport { Modal, Button } from \\\\'@/components/UI\\\\'\\\\nimport { ref } from \\\\'vue\\\\'\\\\n\\\\nexport default function ModalFooter() {\\\\n  const visible = ref(false)\\\\n\\\\n  return (\\\\n    <>\\\\n      <Button type=\\\\\\\"primary\\\\\\\" onClick={() => visible.value = true}>\\\\n        自定义页脚\\\\n      </Button>\\\\n      <Modal\\\\n        visible={visible.value}\\\\n        title=\\\\\\\"自定义页脚\\\\\\\"\\\\n        onUpdate:visible={(v) => visible.value = v}\\\\n        footer={\\\\n          <div class=\\\\\\\"flex justify-end gap-2\\\\\\\">\\\\n            <Button onClick={() => visible.value = false}>取消</Button>\\\\n            <Button type=\\\\\\\"primary\\\\\\\" onClick={() => visible.value = false}>\\\\n              确认\\\\n            </Button>\\\\n          </div>\\\\n        }\\\\n      >\\\\n        <p>自定义页脚内容</p>\\\\n      </Modal>\\\\n    </>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 不同尺寸\\\\n\\\\n通过 `width` 属性设置模态框宽度。\\\\n\\\\n```tsx\\\\nimport { Modal, Button } from \\\\'@/components/UI\\\\'\\\\nimport { ref } from \\\\'vue\\\\'\\\\n\\\\nexport default function ModalSize() {\\\\n  const visible = ref(false)\\\\n  const size = ref<\\\\'sm\\\\' | \\\\'md\\\\' | \\\\'lg\\\\' | \\\\'xl\\\\' | \\\\'full\\\\'>(\\\\'md\\\\')\\\\n\\\\n  return (\\\\n    <>\\\\n      <div class=\\\\\\\"space-x-2\\\\\\\">\\\\n        <Button onClick={() => { size.value = \\\\'sm\\\\'; visible.value = true }}>\\\\n          小型\\\\n        </Button>\\\\n        <Button onClick={() => { size.value = \\\\'md\\\\'; visible.value = true }}>\\\\n          中型\\\\n        </Button>\\\\n        <Button onClick={() => { size.value = \\\\'lg\\\\'; visible.value = true }}>\\\\n          大型\\\\n        </Button>\\\\n      </div>\\\\n      <Modal\\\\n        visible={visible.value}\\\\n        title=\\\\\\\"不同尺寸\\\\\\\"\\\\n        size={size.value}\\\\n        onUpdate:visible={(v) => visible.value = v}\\\\n      >\\\\n        <p>尺寸: {size.value}</p>\\\\n      </Modal>\\\\n    </>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 禁用遮罩关闭\\\\n\\\\n点击遮罩层不关闭模态框。\\\\n\\\\n```tsx\\\\nimport { Modal, Button } from \\\\'@/components/UI\\\\'\\\\nimport { ref } from \\\\'vue\\\\'\\\\n\\\\nexport default function ModalMaskClosable() {\\\\n  const visible = ref(false)\\\\n\\\\n  return (\\\\n    <>\\\\n      <Button type=\\\\\\\"primary\\\\\\\" onClick={() => visible.value = true}>\\\\n        禁用遮罩关闭\\\\n      </Button>\\\\n      <Modal\\\\n        visible={visible.value}\\\\n        title=\\\\\\\"禁用遮罩关闭\\\\\\\"\\\\n        maskClosable={false}\\\\n        onUpdate:visible={(v) => visible.value = v}\\\\n      >\\\\n        <p>点击遮罩层不会关闭</p>\\\\n      </Modal>\\\\n    </>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n### 确认对话框\\\\n\\\\n使用 `confirm` 方法快速创建确认对话框。\\\\n\\\\n```tsx\\\\nimport { Modal, Button } from \\\\'@/components/UI\\\\'\\\\n\\\\nexport default function ModalConfirm() {\\\\n  const handleConfirm = () => {\\\\n    Modal.confirm({\\\\n      title: \\\\'确认删除\\\\',\\\\n      content: \\\\'确定要删除这条数据吗？\\\\',\\\\n      onOk: () => {\\\\n        console.log(\\\\'确认删除\\\\')\\\\n      },\\\\n      onCancel: () => {\\\\n        console.log(\\\\'取消删除\\\\')\\\\n      },\\\\n    })\\\\n  }\\\\n\\\\n  return (\\\\n    <Button type=\\\\\\\"danger\\\\\\\" onClick={handleConfirm}>\\\\n      删除\\\\n    </Button>\\\\n  )\\\\n}\\\\n```\\\\n\\\\n## API\\\\n\\\\n### Modal Props\\\\n\\\\n| 参数 | 说明 | 类型 | 可选值 | 默认值 |\\\\n|------|------|------|--------|--------|\\\\n| visible | 是否可见 | `boolean` | - | `false` |\\\\n| title | 标题 | `string` | - | - |\\\\n| width | 宽度 | `string \\\\\\\\| number` | - | `520` |\\\\n| size | 尺寸 | `string` | `sm` / `md` / `lg` / `xl` / `full` | `md` |\\\\n| centered | 是否垂直居中 | `boolean` | - | `false` |\\\\n| closable | 是否显示关闭按钮 | `boolean` | - | `true` |\\\\n| mask | 是否显示遮罩 | `boolean` | - | `true` |\\\\n| maskClosable | 点击遮罩是否关闭 | `boolean` | - | `true` |\\\\n| keyboard | 按 ESC 键是否关闭 | `boolean` | - | `true` |\\\\n| footer | 自定义页脚 | `VNode` | - | - |\\\\n| okText | 确认按钮文字 | `string` | - | `确定` |\\\\n| cancelText | 取消按钮文字 | `string` | - | `取消` |\\\\n| okButtonProps | 确认按钮属性 | `object` | - | - |\\\\n| cancelButtonProps | 取消按钮属性 | `object` | - | - |\\\\n| destroyOnClose | 关闭时销毁内容 | `boolean` | - | `false` |\\\\n| zIndex | 设置 Modal 的 `z-index` | `number` | - | `1000` |\\\\n\\\\n### Modal Events\\\\n\\\\n| 事件名 | 说明 | 回调参数 |\\\\n|--------|------|----------|\\\\n| update:visible | 显示状态改变时触发 | `(visible: boolean) => void` |\\\\n| ok | 点击确认按钮时触发 | `() => void` |\\\\n| cancel | 点击取消按钮时触发 | `() => void` |\\\\n| afterClose | 关闭动画结束后触发 | `() => void` |\\\\n\\\\n### Modal Methods\\\\n\\\\n| 方法名 | 说明 | 参数 |\\\\n|--------|------|------|\\\\n| confirm | 确认对话框 | `(config: ModalConfig) => void` |\\\\n| info | 信息对话框 | `(config: ModalConfig) => void` |\\\\n| success | 成功对话框 | `(config: ModalConfig) => void` |\\\\n| warning | 警告对话框 | `(config: ModalConfig) => void` |\\\\n| error | 错误对话框 | `(config: ModalConfig) => void` |\\\\n\\\\n## 样式定制\\\\n\\\\n### 自定义宽度\\\\n\\\\n```tsx\\\\n<Modal width={800}>自定义宽度</Modal>\\\\n```\\\\n\\\\n### 垂直居中\\\\n\\\\n```tsx\\\\n<Modal centered>垂直居中</Modal>\\\\n```\\\\n\\\\n## 最佳实践\\\\n\\\\n1. **标题**: 使用简洁明确的标题\\\\n2. **操作**: 主要操作放在右侧，次要操作放在左侧\\\\n3. **关闭**: 提供多种关闭方式（按钮、遮罩、ESC键）\\\\n4. **确认**: 危险操作需要二次确认\\\\n5. **焦点**: 打开时自动聚焦到主要操作按钮\\\\n\",\"originAcceptText\":\"# Modal 模态框\\n\\n模态框对话框，在保留当前页面状态的情况下，提示用户进行相关操作。\\n\\n## 何时使用\\n\\n- 需要用户处理事务，又不希望跳转页面以致打断工作流程时，可以使用 `Modal` 在当前页面正中打开一个浮层，承载相应的操作。\\n\\n## 代码演示\\n\\n### 基础用法\\n\\n模态框需要通过 `visible` 属性来控制显示状态。\\n\\n```tsx\\nimport { Modal, Button } from '@/components/UI'\\nimport { ref } from 'vue'\\n\\nexport default function ModalBasic() {\\n  const visible = ref(false)\\n\\n  return (\\n    <>\\n      <Button type=\\\"primary\\\" onClick={() => visible.value = true}>\\n        打开模态框\\n      </Button>\\n      <Modal\\n        visible={visible.value}\\n        title=\\\"基础模态框\\\"\\n        onUpdate:visible={(v) => visible.value = v}\\n      >\\n        <p>这是一段内容</p>\\n      </Modal>\\n    </>\\n  )\\n}\\n```\\n\\n### 自定义页脚\\n\\n自定义底部按钮。\\n\\n```tsx\\nimport { Modal, Button } from '@/components/UI'\\nimport { ref } from 'vue'\\n\\nexport default function ModalFooter() {\\n  const visible = ref(false)\\n\\n  return (\\n    <>\\n      <Button type=\\\"primary\\\" onClick={() => visible.value = true}>\\n        自定义页脚\\n      </Button>\\n      <Modal\\n        visible={visible.value}\\n        title=\\\"自定义页脚\\\"\\n        onUpdate:visible={(v) => visible.value = v}\\n        footer={\\n          <div class=\\\"flex justify-end gap-2\\\">\\n            <Button onClick={() => visible.value = false}>取消</Button>\\n            <Button type=\\\"primary\\\" onClick={() => visible.value = false}>\\n              确认\\n            </Button>\\n          </div>\\n        }\\n      >\\n        <p>自定义页脚内容</p>\\n      </Modal>\\n    </>\\n  )\\n}\\n```\\n\\n### 不同尺寸\\n\\n通过 `width` 属性设置模态框宽度。\\n\\n```tsx\\nimport { Modal, Button } from '@/components/UI'\\nimport { ref } from 'vue'\\n\\nexport default function ModalSize() {\\n  const visible = ref(false)\\n  const size = ref<'sm' | 'md' | 'lg' | 'xl' | 'full'>('md')\\n\\n  return (\\n    <>\\n      <div class=\\\"space-x-2\\\">\\n        <Button onClick={() => { size.value = 'sm'; visible.value = true }}>\\n          小型\\n        </Button>\\n        <Button onClick={() => { size.value = 'md'; visible.value = true }}>\\n          中型\\n        </Button>\\n        <Button onClick={() => { size.value = 'lg'; visible.value = true }}>\\n          大型\\n        </Button>\\n      </div>\\n      <Modal\\n        visible={visible.value}\\n        title=\\\"不同尺寸\\\"\\n        size={size.value}\\n        onUpdate:visible={(v) => visible.value = v}\\n      >\\n        <p>尺寸: {size.value}</p>\\n      </Modal>\\n    </>\\n  )\\n}\\n```\\n\\n### 禁用遮罩关闭\\n\\n点击遮罩层不关闭模态框。\\n\\n```tsx\\nimport { Modal, Button } from '@/components/UI'\\nimport { ref } from 'vue'\\n\\nexport default function ModalMaskClosable() {\\n  const visible = ref(false)\\n\\n  return (\\n    <>\\n      <Button type=\\\"primary\\\" onClick={() => visible.value = true}>\\n        禁用遮罩关闭\\n      </Button>\\n      <Modal\\n        visible={visible.value}\\n        title=\\\"禁用遮罩关闭\\\"\\n        maskClosable={false}\\n        onUpdate:visible={(v) => visible.value = v}\\n      >\\n        <p>点击遮罩层不会关闭</p>\\n      </Modal>\\n    </>\\n  )\\n}\\n```\\n\\n### 确认对话框\\n\\n使用 `confirm` 方法快速创建确认对话框。\\n\\n```tsx\\nimport { Modal, Button } from '@/components/UI'\\n\\nexport default function ModalConfirm() {\\n  const handleConfirm = () => {\\n    Modal.confirm({\\n      title: '确认删除',\\n      content: '确定要删除这条数据吗？',\\n      onOk: () => {\\n        console.log('确认删除')\\n      },\\n      onCancel: () => {\\n        console.log('取消删除')\\n      },\\n    })\\n  }\\n\\n  return (\\n    <Button type=\\\"danger\\\" onClick={handleConfirm}>\\n      删除\\n    </Button>\\n  )\\n}\\n```\\n\\n## API\\n\\n### Modal Props\\n\\n| 参数 | 说明 | 类型 | 可选值 | 默认值 |\\n|------|------|------|--------|--------|\\n| visible | 是否可见 | `boolean` | - | `false` |\\n| title | 标题 | `string` | - | - |\\n| width | 宽度 | `string \\\\| number` | - | `520` |\\n| size | 尺寸 | `string` | `sm` / `md` / `lg` / `xl` / `full` | `md` |\\n| centered | 是否垂直居中 | `boolean` | - | `false` |\\n| closable | 是否显示关闭按钮 | `boolean` | - | `true` |\\n| mask | 是否显示遮罩 | `boolean` | - | `true` |\\n| maskClosable | 点击遮罩是否关闭 | `boolean` | - | `true` |\\n| keyboard | 按 ESC 键是否关闭 | `boolean` | - | `true` |\\n| footer | 自定义页脚 | `VNode` | - | - |\\n| okText | 确认按钮文字 | `string` | - | `确定` |\\n| cancelText | 取消按钮文字 | `string` | - | `取消` |\\n| okButtonProps | 确认按钮属性 | `object` | - | - |\\n| cancelButtonProps | 取消按钮属性 | `object` | - | - |\\n| destroyOnClose | 关闭时销毁内容 | `boolean` | - | `false` |\\n| zIndex | 设置 Modal 的 `z-index` | `number` | - | `1000` |\\n\\n### Modal Events\\n\\n| 事件名 | 说明 | 回调参数 |\\n|--------|------|----------|\\n| update:visible | 显示状态改变时触发 | `(visible: boolean) => void` |\\n| ok | 点击确认按钮时触发 | `() => void` |\\n| cancel | 点击取消按钮时触发 | `() => void` |\\n| afterClose | 关闭动画结束后触发 | `() => void` |\\n\\n### Modal Methods\\n\\n| 方法名 | 说明 | 参数 |\\n|--------|------|------|\\n| confirm | 确认对话框 | `(config: ModalConfig) => void` |\\n| info | 信息对话框 | `(config: ModalConfig) => void` |\\n| success | 成功对话框 | `(config: ModalConfig) => void` |\\n| warning | 警告对话框 | `(config: ModalConfig) => void` |\\n| error | 错误对话框 | `(config: ModalConfig) => void` |\\n\\n## 样式定制\\n\\n### 自定义宽度\\n\\n```tsx\\n<Modal width={800}>自定义宽度</Modal>\\n```\\n\\n### 垂直居中\\n\\n```tsx\\n<Modal centered>垂直居中</Modal>\\n```\\n\\n## 最佳实践\\n\\n1. **标题**: 使用简洁明确的标题\\n2. **操作**: 主要操作放在右侧，次要操作放在左侧\\n3. **关闭**: 提供多种关闭方式（按钮、遮罩、ESC键）\\n4. **确认**: 危险操作需要二次确认\\n5. **焦点**: 打开时自动聚焦到主要操作按钮\\n\",\"originTextLength\":4891,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768932833292}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/components/UI/docs/ROADMAP.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":321,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":321,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# YYC³ UI 组件库 - 后续工作计划\\\\n\\\\n## 📋 任务清单\\\\n\\\\n### 1. 完善测试 - 为剩余24个组件编写单元测试\\\\n\\\\n**优先级**: 高\\\\n**预计时间**: 2-3天\\\\n\\\\n#### 子任务清单\\\\n- [ ] Badge组件测试（10个测试用例）\\\\n- [ ] Alert组件测试（12个测试用例）\\\\n- [ ] Form组件测试（15个测试用例）\\\\n- [ ] Select组件测试（20个测试用例）\\\\n- [ ] Checkbox组件测试（12个测试用例）\\\\n- [ ] Radio组件测试（12个测试用例）\\\\n- [ ] Switch组件测试（10个测试用例）\\\\n- [ ] Dropdown组件测试（15个测试用例）\\\\n- [ ] Breadcrumb组件测试（10个测试用例）\\\\n- [ ] Pagination组件测试（18个测试用例）\\\\n- [ ] Table组件测试（25个测试用例）\\\\n- [ ] List组件测试（15个测试用例）\\\\n- [ ] Tree组件测试（20个测试用例）\\\\n- [ ] Timeline组件测试（12个测试用例）\\\\n- [ ] Drawer组件测试（15个测试用例）\\\\n- [ ] Dialog组件测试（12个测试用例）\\\\n- [ ] Tooltip组件测试（10个测试用例）\\\\n- [ ] Layout组件测试（15个测试用例）\\\\n- [ ] Grid组件测试（12个测试用例）\\\\n- [ ] Space组件测试（8个测试用例）\\\\n- [ ] Flex组件测试（10个测试用例）\\\\n- [ ] Avatar组件测试（12个测试用例）\\\\n- [ ] Divider组件测试（8个测试用例）\\\\n- [ ] Skeleton组件测试（15个测试用例）\\\\n- [ ] Empty组件测试（10个测试用例）\\\\n\\\\n#### 测试覆盖目标\\\\n- 组件渲染测试\\\\n- Props属性测试\\\\n- 事件触发测试\\\\n- 状态变化测试\\\\n- 样式类名测试\\\\n- 组合使用测试\\\\n- 边界情况测试\\\\n\\\\n---\\\\n\\\\n### 2. 扩展组件库 - 根据业务需求添加更多组件\\\\n\\\\n**优先级**: 中\\\\n**预计时间**: 3-5天\\\\n\\\\n#### 待添加组件清单\\\\n- [ ] Tabs - 标签页\\\\n- [ ] Collapse - 折叠面板\\\\n- [ ] Carousel - 轮播图\\\\n- [ ] Progress - 进度条\\\\n- [ ] Slider - 滑块\\\\n- [ ] Rate - 评分\\\\n- [ ] Transfer - 穿梭框\\\\n- [ ] Calendar - 日历\\\\n- [ ] DatePicker - 日期选择器\\\\n- [ ] TimePicker - 时间选择器\\\\n- [ ] Upload - 上传\\\\n- [ ] Steps - 步骤条\\\\n- [ ] Tag - 标签\\\\n- [ ] Popover - 气泡卡片\\\\n- [ ] Popconfirm - 气泡确认框\\\\n- [ ] Message - 全局提示\\\\n- [ ] Notification - 通知提醒框\\\\n- [ ] BackTop - 返回顶部\\\\n- [ ] Anchor - 锚点\\\\n\\\\n---\\\\n\\\\n### 3. 性能优化 - 优化组件渲染性能\\\\n\\\\n**优先级**: 高\\\\n**预计时间**: 2-3天\\\\n\\\\n#### 优化目标\\\\n- [ ] 减少不必要的重渲染\\\\n- [ ] 优化大列表渲染性能\\\\n- [ ] 实现虚拟滚动\\\\n- [ ] 优化事件处理\\\\n- [ ] 减少内存占用\\\\n- [ ] 优化样式计算\\\\n- [ ] 实现组件懒加载\\\\n- [ ] 优化动画性能\\\\n\\\\n#### 具体优化措施\\\\n1. **使用 `v-memo` 缓存组件**\\\\n2. **使用 `computed` 优化计算属性**\\\\n3. **使用 `watchEffect` 替代 `watch`**\\\\n4. **使用 `shallowRef` 和 `shallowReactive`**\\\\n5. **使用 `v-once` 静态内容**\\\\n6. **使用 `key` 优化列表渲染**\\\\n7. **使用 `requestAnimationFrame` 优化动画**\\\\n8. **使用 `IntersectionObserver` 实现懒加载**\\\\n\\\\n---\\\\n\\\\n### 4. 无障碍支持 - 增强无障碍访问支持\\\\n\\\\n**优先级**: 中\\\\n**预计时间**: 2-3天\\\\n\\\\n#### 无障碍标准\\\\n- [ ] WCAG 2.1 AA 级别合规\\\\n- [ ] 键盘导航支持\\\\n- [ ] 屏幕阅读器支持\\\\n- [ ] 焦点管理\\\\n- [ ] ARIA 属性完善\\\\n- [ ] 颜色对比度检查\\\\n- [ ] 语义化 HTML\\\\n- [ ] 错误提示增强\\\\n\\\\n#### 具体实施\\\\n1. **添加 ARIA 属性**\\\\n   - `aria-label`\\\\n   - `aria-labelledby`\\\\n   - `aria-describedby`\\\\n   - `aria-expanded`\\\\n   - `aria-hidden`\\\\n   - `role` 属性\\\\n\\\\n2. **键盘导航**\\\\n   - Tab 键导航\\\\n   - 方向键导航\\\\n   - Enter/Space 激活\\\\n   - Escape 关闭\\\\n\\\\n3. **焦点管理**\\\\n   - 自动聚焦\\\\n   - 焦点陷阱\\\\n   - 焦点恢复\\\\n\\\\n4. **屏幕阅读器**\\\\n   - 语义化标签\\\\n   - 状态通知\\\\n   - 错误提示\\\\n\\\\n---\\\\n\\\\n### 5. 国际化 - 添加多语言支持\\\\n\\\\n**优先级**: 中\\\\n**预计时间**: 2-3天\\\\n\\\\n#### 支持语言\\\\n- [ ] 中文（简体）\\\\n- [ ] 中文（繁体）\\\\n- [ ] 英语\\\\n- [ ] 日语\\\\n- [ ] 韩语\\\\n\\\\n#### 实施方案\\\\n1. **使用 vue-i18n**\\\\n   ```typescript\\\\n   import { createI18n } from \\\\'vue-i18n\\\\'\\\\n\\\\n   const i18n = createI18n({\\\\n     locale: \\\\'zh-CN\\\\',\\\\n     fallbackLocale: \\\\'en\\\\',\\\\n     messages: {\\\\n       \\\\'zh-CN\\\\': zhCN,\\\\n       \\\\'en\\\\': en,\\\\n     }\\\\n   })\\\\n   ```\\\\n\\\\n2. **语言包结构**\\\\n   ```typescript\\\\n   // locales/zh-CN.ts\\\\n   export default {\\\\n     button: {\\\\n       confirm: \\\\'确定\\\\',\\\\n       cancel: \\\\'取消\\\\',\\\\n       submit: \\\\'提交\\\\'\\\\n     },\\\\n     modal: {\\\\n       title: \\\\'标题\\\\',\\\\n       close: \\\\'关闭\\\\'\\\\n     }\\\\n   }\\\\n   ```\\\\n\\\\n3. **组件内使用**\\\\n   ```tsx\\\\n   import { useI18n } from \\\\'vue-i18n\\\\'\\\\n\\\\n   const { t } = useI18n()\\\\n   <Button>{t(\\\\'button.confirm\\\\')}</Button>\\\\n   ```\\\\n\\\\n---\\\\n\\\\n### 6. 主题系统 - 完善主题定制功能\\\\n\\\\n**优先级**: 中\\\\n**预计时间**: 2-3天\\\\n\\\\n#### 主题功能\\\\n- [ ] 明暗主题切换\\\\n- [ ] 自定义主题颜色\\\\n- [ ] 主题预设\\\\n- [ ] 主题持久化\\\\n- [ ] 主题预览\\\\n- [ ] 主题导出/导入\\\\n\\\\n#### 实施方案\\\\n1. **主题配置**\\\\n   ```typescript\\\\n   // config/theme.ts\\\\n   export interface ThemeConfig {\\\\n     mode: \\\\'light\\\\' | \\\\'dark\\\\'\\\\n     primary: string\\\\n     colors: {\\\\n       primary: string[]\\\\n       secondary: string[]\\\\n       success: string[]\\\\n       warning: string[]\\\\n       danger: string[]\\\\n     }\\\\n     typography: {\\\\n       fontFamily: string\\\\n       fontSize: Record<string, string>\\\\n     }\\\\n   }\\\\n   ```\\\\n\\\\n2. **主题切换**\\\\n   ```tsx\\\\n   import { useTheme } from \\\\'@/hooks/useTheme\\\\'\\\\n\\\\n   const { theme, setTheme } = useTheme()\\\\n\\\\n   <Button onClick={() => setTheme(\\\\'dark\\\\')}>\\\\n     切换主题\\\\n   </Button>\\\\n   ```\\\\n\\\\n3. **CSS 变量**\\\\n   ```css\\\\n   :root {\\\\n     --primary-50: #eff6ff;\\\\n     --primary-100: #dbeafe;\\\\n     /* ... */\\\\n   }\\\\n\\\\n   [data-theme=\\\\\\\"dark\\\\\\\"] {\\\\n     --primary-50: #0f172a;\\\\n     --primary-100: #1e293b;\\\\n     /* ... */\\\\n   }\\\\n   ```\\\\n\\\\n---\\\\n\\\\n### 7. 文档完善 - 补充所有组件的详细文档\\\\n\\\\n**优先级**: 中\\\\n**预计时间**: 3-4天\\\\n\\\\n#### 待完善文档\\\\n- [ ] Badge组件文档\\\\n- [ ] Alert组件文档\\\\n- [ ] Form组件文档\\\\n- [ ] Select组件文档\\\\n- [ ] Checkbox组件文档\\\\n- [ ] Radio组件文档\\\\n- [ ] Switch组件文档\\\\n- [ ] Dropdown组件文档\\\\n- [ ] Breadcrumb组件文档\\\\n- [ ] Pagination组件文档\\\\n- [ ] Table组件文档\\\\n- [ ] List组件文档\\\\n- [ ] Tree组件文档\\\\n- [ ] Timeline组件文档\\\\n- [ ] Drawer组件文档\\\\n- [ ] Dialog组件文档\\\\n- [ ] Tooltip组件文档\\\\n- [ ] Layout组件文档\\\\n- [ ] Grid组件文档\\\\n- [ ] Space组件文档\\\\n- [ ] Flex组件文档\\\\n- [ ] Avatar组件文档\\\\n- [ ] Divider组件文档\\\\n- [ ] Skeleton组件文档\\\\n- [ ] Empty组件文档\\\\n\\\\n#### 文档结构\\\\n1. **组件概述**\\\\n2. **何时使用**\\\\n3. **代码演示**\\\\n   - 基础用法\\\\n   - 高级用法\\\\n   - 最佳实践\\\\n4. **API 文档**\\\\n   - Props\\\\n   - Events\\\\n   - Methods\\\\n   - Slots\\\\n5. **样式定制**\\\\n6. **常见问题**\\\\n\\\\n---\\\\n\\\\n### 8. 示例扩展 - 添加更多使用场景的示例\\\\n\\\\n**优先级**: 低\\\\n**预计时间**: 2-3天\\\\n\\\\n#### 示例场景\\\\n- [ ] 表单验证示例\\\\n- [ ] 数据表格示例\\\\n- [ ] 布局示例\\\\n- [ ] 导航示例\\\\n- [ ] 反馈组件示例\\\\n- [ ] 组合使用示例\\\\n- [ ] 最佳实践示例\\\\n- [ ] 常见问题示例\\\\n\\\\n#### 示例页面\\\\n1. **表单示例**\\\\n   - 登录表单\\\\n   - 注册表单\\\\n   - 搜索表单\\\\n   - 复杂表单\\\\n\\\\n2. **数据展示示例**\\\\n   - 用户列表\\\\n   - 订单列表\\\\n   - 数据统计\\\\n   - 图表展示\\\\n\\\\n3. **布局示例**\\\\n   - 后台管理布局\\\\n   - 移动端布局\\\\n   - 响应式布局\\\\n\\\\n4. **交互示例**\\\\n   - 模态框使用\\\\n   - 抽屉使用\\\\n   - 确认对话框\\\\n   - 提示框使用\\\\n\\\\n---\\\\n\\\\n## 📊 整体进度\\\\n\\\\n| 任务 | 优先级 | 预计时间 | 状态 |\\\\n|------|--------|----------|------|\\\\n| 完善测试 | 高 | 2-3天 | 待开始 |\\\\n| 扩展组件库 | 中 | 3-5天 | 待开始 |\\\\n| 性能优化 | 高 | 2-3天 | 待开始 |\\\\n| 无障碍支持 | 中 | 2-3天 | 待开始 |\\\\n| 国际化 | 中 | 2-3天 | 待开始 |\\\\n| 主题系统 | 中 | 2-3天 | 待开始 |\\\\n| 文档完善 | 中 | 3-4天 | 待开始 |\\\\n| 示例扩展 | 低 | 2-3天 | 待开始 |\\\\n\\\\n**总计**: 8个任务，预计18-27天\\\\n\\\\n---\\\\n\\\\n## 🎯 实施建议\\\\n\\\\n1. **优先级排序**: 先完成高优先级任务（完善测试、性能优化）\\\\n2. **并行开发**: 中低优先级任务可以并行开发\\\\n3. **迭代交付**: 每完成一个任务就提交一次\\\\n4. **持续集成**: 每次提交后运行测试\\\\n5. **代码审查**: 重要功能需要代码审查\\\\n6. **文档同步**: 代码更新后同步更新文档\\\\n\\\\n---\\\\n\\\\n## 📝 备注\\\\n\\\\n- 所有任务都需要遵循项目开发规范\\\\n- 所有代码都需要有完整的类型定义\\\\n- 所有组件都需要有单元测试\\\\n- 所有文档都需要有清晰的示例\\\\n- 所有提交都需要有清晰的提交信息\\\\n\\\\n🌹 任务计划已制定完成！请告诉我您想要从哪个任务开始？\\\\n\",\"originAcceptText\":\"# YYC³ UI 组件库 - 后续工作计划\\n\\n## 📋 任务清单\\n\\n### 1. 完善测试 - 为剩余24个组件编写单元测试\\n\\n**优先级**: 高\\n**预计时间**: 2-3天\\n\\n#### 子任务清单\\n- [ ] Badge组件测试（10个测试用例）\\n- [ ] Alert组件测试（12个测试用例）\\n- [ ] Form组件测试（15个测试用例）\\n- [ ] Select组件测试（20个测试用例）\\n- [ ] Checkbox组件测试（12个测试用例）\\n- [ ] Radio组件测试（12个测试用例）\\n- [ ] Switch组件测试（10个测试用例）\\n- [ ] Dropdown组件测试（15个测试用例）\\n- [ ] Breadcrumb组件测试（10个测试用例）\\n- [ ] Pagination组件测试（18个测试用例）\\n- [ ] Table组件测试（25个测试用例）\\n- [ ] List组件测试（15个测试用例）\\n- [ ] Tree组件测试（20个测试用例）\\n- [ ] Timeline组件测试（12个测试用例）\\n- [ ] Drawer组件测试（15个测试用例）\\n- [ ] Dialog组件测试（12个测试用例）\\n- [ ] Tooltip组件测试（10个测试用例）\\n- [ ] Layout组件测试（15个测试用例）\\n- [ ] Grid组件测试（12个测试用例）\\n- [ ] Space组件测试（8个测试用例）\\n- [ ] Flex组件测试（10个测试用例）\\n- [ ] Avatar组件测试（12个测试用例）\\n- [ ] Divider组件测试（8个测试用例）\\n- [ ] Skeleton组件测试（15个测试用例）\\n- [ ] Empty组件测试（10个测试用例）\\n\\n#### 测试覆盖目标\\n- 组件渲染测试\\n- Props属性测试\\n- 事件触发测试\\n- 状态变化测试\\n- 样式类名测试\\n- 组合使用测试\\n- 边界情况测试\\n\\n---\\n\\n### 2. 扩展组件库 - 根据业务需求添加更多组件\\n\\n**优先级**: 中\\n**预计时间**: 3-5天\\n\\n#### 待添加组件清单\\n- [ ] Tabs - 标签页\\n- [ ] Collapse - 折叠面板\\n- [ ] Carousel - 轮播图\\n- [ ] Progress - 进度条\\n- [ ] Slider - 滑块\\n- [ ] Rate - 评分\\n- [ ] Transfer - 穿梭框\\n- [ ] Calendar - 日历\\n- [ ] DatePicker - 日期选择器\\n- [ ] TimePicker - 时间选择器\\n- [ ] Upload - 上传\\n- [ ] Steps - 步骤条\\n- [ ] Tag - 标签\\n- [ ] Popover - 气泡卡片\\n- [ ] Popconfirm - 气泡确认框\\n- [ ] Message - 全局提示\\n- [ ] Notification - 通知提醒框\\n- [ ] BackTop - 返回顶部\\n- [ ] Anchor - 锚点\\n\\n---\\n\\n### 3. 性能优化 - 优化组件渲染性能\\n\\n**优先级**: 高\\n**预计时间**: 2-3天\\n\\n#### 优化目标\\n- [ ] 减少不必要的重渲染\\n- [ ] 优化大列表渲染性能\\n- [ ] 实现虚拟滚动\\n- [ ] 优化事件处理\\n- [ ] 减少内存占用\\n- [ ] 优化样式计算\\n- [ ] 实现组件懒加载\\n- [ ] 优化动画性能\\n\\n#### 具体优化措施\\n1. **使用 `v-memo` 缓存组件**\\n2. **使用 `computed` 优化计算属性**\\n3. **使用 `watchEffect` 替代 `watch`**\\n4. **使用 `shallowRef` 和 `shallowReactive`**\\n5. **使用 `v-once` 静态内容**\\n6. **使用 `key` 优化列表渲染**\\n7. **使用 `requestAnimationFrame` 优化动画**\\n8. **使用 `IntersectionObserver` 实现懒加载**\\n\\n---\\n\\n### 4. 无障碍支持 - 增强无障碍访问支持\\n\\n**优先级**: 中\\n**预计时间**: 2-3天\\n\\n#### 无障碍标准\\n- [ ] WCAG 2.1 AA 级别合规\\n- [ ] 键盘导航支持\\n- [ ] 屏幕阅读器支持\\n- [ ] 焦点管理\\n- [ ] ARIA 属性完善\\n- [ ] 颜色对比度检查\\n- [ ] 语义化 HTML\\n- [ ] 错误提示增强\\n\\n#### 具体实施\\n1. **添加 ARIA 属性**\\n   - `aria-label`\\n   - `aria-labelledby`\\n   - `aria-describedby`\\n   - `aria-expanded`\\n   - `aria-hidden`\\n   - `role` 属性\\n\\n2. **键盘导航**\\n   - Tab 键导航\\n   - 方向键导航\\n   - Enter/Space 激活\\n   - Escape 关闭\\n\\n3. **焦点管理**\\n   - 自动聚焦\\n   - 焦点陷阱\\n   - 焦点恢复\\n\\n4. **屏幕阅读器**\\n   - 语义化标签\\n   - 状态通知\\n   - 错误提示\\n\\n---\\n\\n### 5. 国际化 - 添加多语言支持\\n\\n**优先级**: 中\\n**预计时间**: 2-3天\\n\\n#### 支持语言\\n- [ ] 中文（简体）\\n- [ ] 中文（繁体）\\n- [ ] 英语\\n- [ ] 日语\\n- [ ] 韩语\\n\\n#### 实施方案\\n1. **使用 vue-i18n**\\n   ```typescript\\n   import { createI18n } from 'vue-i18n'\\n\\n   const i18n = createI18n({\\n     locale: 'zh-CN',\\n     fallbackLocale: 'en',\\n     messages: {\\n       'zh-CN': zhCN,\\n       'en': en,\\n     }\\n   })\\n   ```\\n\\n2. **语言包结构**\\n   ```typescript\\n   // locales/zh-CN.ts\\n   export default {\\n     button: {\\n       confirm: '确定',\\n       cancel: '取消',\\n       submit: '提交'\\n     },\\n     modal: {\\n       title: '标题',\\n       close: '关闭'\\n     }\\n   }\\n   ```\\n\\n3. **组件内使用**\\n   ```tsx\\n   import { useI18n } from 'vue-i18n'\\n\\n   const { t } = useI18n()\\n   <Button>{t('button.confirm')}</Button>\\n   ```\\n\\n---\\n\\n### 6. 主题系统 - 完善主题定制功能\\n\\n**优先级**: 中\\n**预计时间**: 2-3天\\n\\n#### 主题功能\\n- [ ] 明暗主题切换\\n- [ ] 自定义主题颜色\\n- [ ] 主题预设\\n- [ ] 主题持久化\\n- [ ] 主题预览\\n- [ ] 主题导出/导入\\n\\n#### 实施方案\\n1. **主题配置**\\n   ```typescript\\n   // config/theme.ts\\n   export interface ThemeConfig {\\n     mode: 'light' | 'dark'\\n     primary: string\\n     colors: {\\n       primary: string[]\\n       secondary: string[]\\n       success: string[]\\n       warning: string[]\\n       danger: string[]\\n     }\\n     typography: {\\n       fontFamily: string\\n       fontSize: Record<string, string>\\n     }\\n   }\\n   ```\\n\\n2. **主题切换**\\n   ```tsx\\n   import { useTheme } from '@/hooks/useTheme'\\n\\n   const { theme, setTheme } = useTheme()\\n\\n   <Button onClick={() => setTheme('dark')}>\\n     切换主题\\n   </Button>\\n   ```\\n\\n3. **CSS 变量**\\n   ```css\\n   :root {\\n     --primary-50: #eff6ff;\\n     --primary-100: #dbeafe;\\n     /* ... */\\n   }\\n\\n   [data-theme=\\\"dark\\\"] {\\n     --primary-50: #0f172a;\\n     --primary-100: #1e293b;\\n     /* ... */\\n   }\\n   ```\\n\\n---\\n\\n### 7. 文档完善 - 补充所有组件的详细文档\\n\\n**优先级**: 中\\n**预计时间**: 3-4天\\n\\n#### 待完善文档\\n- [ ] Badge组件文档\\n- [ ] Alert组件文档\\n- [ ] Form组件文档\\n- [ ] Select组件文档\\n- [ ] Checkbox组件文档\\n- [ ] Radio组件文档\\n- [ ] Switch组件文档\\n- [ ] Dropdown组件文档\\n- [ ] Breadcrumb组件文档\\n- [ ] Pagination组件文档\\n- [ ] Table组件文档\\n- [ ] List组件文档\\n- [ ] Tree组件文档\\n- [ ] Timeline组件文档\\n- [ ] Drawer组件文档\\n- [ ] Dialog组件文档\\n- [ ] Tooltip组件文档\\n- [ ] Layout组件文档\\n- [ ] Grid组件文档\\n- [ ] Space组件文档\\n- [ ] Flex组件文档\\n- [ ] Avatar组件文档\\n- [ ] Divider组件文档\\n- [ ] Skeleton组件文档\\n- [ ] Empty组件文档\\n\\n#### 文档结构\\n1. **组件概述**\\n2. **何时使用**\\n3. **代码演示**\\n   - 基础用法\\n   - 高级用法\\n   - 最佳实践\\n4. **API 文档**\\n   - Props\\n   - Events\\n   - Methods\\n   - Slots\\n5. **样式定制**\\n6. **常见问题**\\n\\n---\\n\\n### 8. 示例扩展 - 添加更多使用场景的示例\\n\\n**优先级**: 低\\n**预计时间**: 2-3天\\n\\n#### 示例场景\\n- [ ] 表单验证示例\\n- [ ] 数据表格示例\\n- [ ] 布局示例\\n- [ ] 导航示例\\n- [ ] 反馈组件示例\\n- [ ] 组合使用示例\\n- [ ] 最佳实践示例\\n- [ ] 常见问题示例\\n\\n#### 示例页面\\n1. **表单示例**\\n   - 登录表单\\n   - 注册表单\\n   - 搜索表单\\n   - 复杂表单\\n\\n2. **数据展示示例**\\n   - 用户列表\\n   - 订单列表\\n   - 数据统计\\n   - 图表展示\\n\\n3. **布局示例**\\n   - 后台管理布局\\n   - 移动端布局\\n   - 响应式布局\\n\\n4. **交互示例**\\n   - 模态框使用\\n   - 抽屉使用\\n   - 确认对话框\\n   - 提示框使用\\n\\n---\\n\\n## 📊 整体进度\\n\\n| 任务 | 优先级 | 预计时间 | 状态 |\\n|------|--------|----------|------|\\n| 完善测试 | 高 | 2-3天 | 待开始 |\\n| 扩展组件库 | 中 | 3-5天 | 待开始 |\\n| 性能优化 | 高 | 2-3天 | 待开始 |\\n| 无障碍支持 | 中 | 2-3天 | 待开始 |\\n| 国际化 | 中 | 2-3天 | 待开始 |\\n| 主题系统 | 中 | 2-3天 | 待开始 |\\n| 文档完善 | 中 | 3-4天 | 待开始 |\\n| 示例扩展 | 低 | 2-3天 | 待开始 |\\n\\n**总计**: 8个任务，预计18-27天\\n\\n---\\n\\n## 🎯 实施建议\\n\\n1. **优先级排序**: 先完成高优先级任务（完善测试、性能优化）\\n2. **并行开发**: 中低优先级任务可以并行开发\\n3. **迭代交付**: 每完成一个任务就提交一次\\n4. **持续集成**: 每次提交后运行测试\\n5. **代码审查**: 重要功能需要代码审查\\n6. **文档同步**: 代码更新后同步更新文档\\n\\n---\\n\\n## 📝 备注\\n\\n- 所有任务都需要遵循项目开发规范\\n- 所有代码都需要有完整的类型定义\\n- 所有组件都需要有单元测试\\n- 所有文档都需要有清晰的示例\\n- 所有提交都需要有清晰的提交信息\\n\\n🌹 任务计划已制定完成！请告诉我您想要从哪个任务开始？\\n\",\"originTextLength\":5596,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768933759083},{\"originRange\":{\"start\":{\"line\":8,\"character\":0},\"end\":{\"line\":8,\"character\":13}},\"modifyRange\":{\"start\":{\"line\":8,\"character\":0},\"end\":{\"line\":8,\"character\":13}},\"action\":\"None\",\"isLine\":false,\"originText\":\"**状态**: ✅ 已完成\",\"originAcceptText\":\"**状态**: ✅ 已完成\",\"originTextLength\":13,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768950115954},{\"originRange\":{\"start\":{\"line\":10,\"character\":0},\"end\":{\"line\":34,\"character\":24}},\"modifyRange\":{\"start\":{\"line\":10,\"character\":0},\"end\":{\"line\":34,\"character\":24}},\"action\":\"None\",\"isLine\":false,\"originText\":\"- [x] Badge组件测试（10个测试用例）\\\\n- [x] Alert组件测试（12个测试用例）\\\\n- [x] Form组件测试（15个测试用例）\\\\n- [x] Select组件测试（20个测试用例）\\\\n- [x] Checkbox组件测试（12个测试用例）\\\\n- [x] Radio组件测试（12个测试用例）\\\\n- [x] Switch组件测试（10个测试用例）\\\\n- [x] Dropdown组件测试（15个测试用例）\\\\n- [x] Breadcrumb组件测试（10个测试用例）\\\\n- [x] Pagination组件测试（18个测试用例）\\\\n- [x] Table组件测试（25个测试用例）\\\\n- [x] List组件测试（15个测试用例）\\\\n- [x] Tree组件测试（20个测试用例）\\\\n- [x] Timeline组件测试（12个测试用例）\\\\n- [x] Drawer组件测试（15个测试用例）\\\\n- [x] Dialog组件测试（12个测试用例）\\\\n- [x] Tooltip组件测试（10个测试用例）\\\\n- [x] Layout组件测试（15个测试用例）\\\\n- [x] Grid组件测试（12个测试用例）\\\\n- [x] Space组件测试（8个测试用例）\\\\n- [x] Flex组件测试（10个测试用例）\\\\n- [x] Avatar组件测试（12个测试用例）\\\\n- [x] Divider组件测试（8个测试用例）\\\\n- [x] Skeleton组件测试（15个测试用例）\\\\n- [x] Empty组件测试（10个测试用例）\",\"originAcceptText\":\"- [x] Badge组件测试（10个测试用例）\\n- [x] Alert组件测试（12个测试用例）\\n- [x] Form组件测试（15个测试用例）\\n- [x] Select组件测试（20个测试用例）\\n- [x] Checkbox组件测试（12个测试用例）\\n- [x] Radio组件测试（12个测试用例）\\n- [x] Switch组件测试（10个测试用例）\\n- [x] Dropdown组件测试（15个测试用例）\\n- [x] Breadcrumb组件测试（10个测试用例）\\n- [x] Pagination组件测试（18个测试用例）\\n- [x] Table组件测试（25个测试用例）\\n- [x] List组件测试（15个测试用例）\\n- [x] Tree组件测试（20个测试用例）\\n- [x] Timeline组件测试（12个测试用例）\\n- [x] Drawer组件测