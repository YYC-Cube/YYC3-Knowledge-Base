\\\\n\\\\n        <el-row :gutter=\\\\\\\"20\\\\\\\" style=\\\\\\\"margin-top: 20px;\\\\\\\">\\\\n          <el-col :span=\\\\\\\"12\\\\\\\">\\\\n            <el-card title=\\\\\\\"明星菜品\\\\\\\">\\\\n              <el-table :data=\\\\\\\"starDishes\\\\\\\" style=\\\\\\\"width: 100%\\\\\\\">\\\\n                <el-table-column type=\\\\\\\"index\\\\\\\" label=\\\\\\\"排名\\\\\\\" width=\\\\\\\"60\\\\\\\" />\\\\n                <el-table-column prop=\\\\\\\"dishName\\\\\\\" label=\\\\\\\"菜品名称\\\\\\\" />\\\\n                <el-table-column prop=\\\\\\\"marketShare\\\\\\\" label=\\\\\\\"市场份额\\\\\\\" width=\\\\\\\"100\\\\\\\" sortable>\\\\n                  <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                    {{ row.marketShare }}%\\\\n                  </template>\\\\n                </el-table-column>\\\\n                <el-table-column prop=\\\\\\\"growthRate\\\\\\\" label=\\\\\\\"增长率\\\\\\\" width=\\\\\\\"100\\\\\\\" sortable>\\\\n                  <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                    <span class=\\\\\\\"positive\\\\\\\">+{{ row.growthRate }}%</span>\\\\n                  </template>\\\\n                </el-table-column>\\\\n              </el-table>\\\\n            </el-card>\\\\n          </el-col>\\\\n          <el-col :span=\\\\\\\"12\\\\\\\">\\\\n            <el-card title=\\\\\\\"问题菜品\\\\\\\">\\\\n              <el-table :data=\\\\\\\"problemDishes\\\\\\\" style=\\\\\\\"width: 100%\\\\\\\">\\\\n                <el-table-column type=\\\\\\\"index\\\\\\\" label=\\\\\\\"排名\\\\\\\" width=\\\\\\\"60\\\\\\\" />\\\\n                <el-table-column prop=\\\\\\\"dishName\\\\\\\" label=\\\\\\\"菜品名称\\\\\\\" />\\\\n                <el-table-column prop=\\\\\\\"marketShare\\\\\\\" label=\\\\\\\"市场份额\\\\\\\" width=\\\\\\\"100\\\\\\\" sortable>\\\\n                  <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                    {{ row.marketShare }}%\\\\n                  </template>\\\\n                </el-table-column>\\\\n                <el-table-column prop=\\\\\\\"growthRate\\\\\\\" label=\\\\\\\"增长率\\\\\\\" width=\\\\\\\"100\\\\\\\" sortable>\\\\n                  <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n                    <span class=\\\\\\\"negative\\\\\\\">{{ row.growthRate }}%</span>\\\\n                  </template>\\\\n                </el-table-column>\\\\n              </el-table>\\\\n            </el-card>\\\\n          </el-col>\\\\n        </el-row>\\\\n      </div>\\\\n    </div>\\\\n\\\\n    <el-dialog v-model=\\\\\\\"showOptimizationDialog\\\\\\\" title=\\\\\\\"菜单优化建议\\\\\\\" width=\\\\\\\"70%\\\\\\\">\\\\n      <el-alert\\\\n        title=\\\\\\\"基于销售数据和客户反馈的智能建议\\\\\\\"\\\\n        type=\\\\\\\"info\\\\\\\"\\\\n        :closable=\\\\\\\"false\\\\\\\"\\\\n        style=\\\\\\\"margin-bottom: 20px;\\\\\\\"\\\\n      />\\\\n\\\\n      <el-table :data=\\\\\\\"optimizationRecommendations\\\\\\\" style=\\\\\\\"width: 100%\\\\\\\">\\\\n        <el-table-column prop=\\\\\\\"type\\\\\\\" label=\\\\\\\"建议类型\\\\\\\" width=\\\\\\\"120\\\\\\\">\\\\n          <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n            <el-tag :type=\\\\\\\"getRecommendationTypeColor(row.type)\\\\\\\" size=\\\\\\\"small\\\\\\\">\\\\n              {{ getRecommendationTypeText(row.type) }}\\\\n            </el-tag>\\\\n          </template>\\\\n        </el-table-column>\\\\n        <el-table-column prop=\\\\\\\"dishName\\\\\\\" label=\\\\\\\"菜品名称\\\\\\\" />\\\\n        <el-table-column prop=\\\\\\\"reason\\\\\\\" label=\\\\\\\"建议原因\\\\\\\" min-width=\\\\\\\"200\\\\\\\" />\\\\n        <el-table-column prop=\\\\\\\"potentialImpact\\\\\\\" label=\\\\\\\"预期影响\\\\\\\" width=\\\\\\\"120\\\\\\\">\\\\n          <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n            <span :class=\\\\\\\"row.potentialImpact > 0 ? \\\\'positive\\\\' : \\\\'negative\\\\'\\\\\\\">\\\\n              {{ row.potentialImpact > 0 ? \\\\'+\\\\' : \\\\'\\\\' }}{{ row.potentialImpact }}%\\\\n            </span>\\\\n          </template>\\\\n        </el-table-column>\\\\n        <el-table-column prop=\\\\\\\"confidence\\\\\\\" label=\\\\\\\"置信度\\\\\\\" width=\\\\\\\"120\\\\\\\">\\\\n          <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n            <el-progress :percentage=\\\\\\\"row.confidence\\\\\\\" :stroke-width=\\\\\\\"6\\\\\\\" />\\\\n          </template>\\\\n        </el-table-column>\\\\n        <el-table-column label=\\\\\\\"操作\\\\\\\" width=\\\\\\\"150\\\\\\\">\\\\n          <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n            <el-button size=\\\\\\\"small\\\\\\\" type=\\\\\\\"primary\\\\\\\" @click=\\\\\\\"handleApplyRecommendation(row)\\\\\\\">\\\\n              应用\\\\n            </el-button>\\\\n            <el-button size=\\\\\\\"small\\\\\\\" @click=\\\\\\\"handleIgnoreRecommendation(row)\\\\\\\">\\\\n              忽略\\\\n            </el-button>\\\\n          </template>\\\\n        </el-table-column>\\\\n      </el-table>\\\\n\\\\n      <template #footer>\\\\n        <span class=\\\\\\\"dialog-footer\\\\\\\">\\\\n          <el-button @click=\\\\\\\"showOptimizationDialog = false\\\\\\\">关闭</el-button>\\\\n          <el-button type=\\\\\\\"primary\\\\\\\" @click=\\\\\\\"handleApplyAllRecommendations\\\\\\\">\\\\n            应用全部\\\\n          </el-button>\\\\n        </span>\\\\n      </template>\\\\n    </el-dialog>\\\\n  </div>\\\\n</template>\\\\n\\\\n<script setup lang=\\\\\\\"ts\\\\\\\">\\\\nimport { ref, reactive, onMounted, nextTick, watch } from \\\\'vue\\\\'\\\\nimport { ElMessage, ElMessageBox } from \\\\'element-plus\\\\'\\\\nimport * as echarts from \\\\'echarts\\\\'\\\\nimport { MagicStick, Money, TrendCharts, PieChart } from \\\\'@element-plus/icons-vue\\\\'\\\\n\\\\ninterface TopDish {\\\\n  rank: number\\\\n  dishName: string\\\\n  categoryName: string\\\\n  sales: number\\\\n  revenue: number\\\\n  rating: number\\\\n}\\\\n\\\\ninterface ProfitMetric {\\\\n  key: string\\\\n  label: string\\\\n  value: string | number\\\\n  change: number\\\\n  icon: string\\\\n  color: string\\\\n}\\\\n\\\\ninterface HighMarginDish {\\\\n  dishName: string\\\\n  margin: number\\\\n  profit: number\\\\n}\\\\n\\\\ninterface SlowMovingDish {\\\\n  dishName: string\\\\n  sales: number\\\\n  daysSinceLastSale: number\\\\n  inventory: number\\\\n}\\\\n\\\\ninterface NewDish {\\\\n  dishName: string\\\\n  launchDate: string\\\\n  sales: number\\\\n  rating: number\\\\n  status: \\\\'hot\\\\' | \\\\'normal\\\\' | \\\\'cold\\\\'\\\\n}\\\\n\\\\ninterface MenuOptimizationSuggestion {\\\\n  title: string\\\\n  type: \\\\'success\\\\' | \\\\'warning\\\\' | \\\\'info\\\\'\\\\n  description: string\\\\n  impact: number\\\\n}\\\\n\\\\ninterface OptimizationRecommendation {\\\\n  type: string\\\\n  dishName: string\\\\n  reason: string\\\\n  potentialImpact: number\\\\n  confidence: number\\\\n}\\\\n\\\\ninterface StarDish {\\\\n  dishName: string\\\\n  marketShare: number\\\\n  growthRate: number\\\\n}\\\\n\\\\nconst loading = ref(false)\\\\nconst viewMode = ref(\\\\'performance\\\\')\\\\nconst showOptimizationDialog = ref(false)\\\\n\\\\nconst categorySalesChart = ref()\\\\nconst ratingChart = ref()\\\\nconst repurchaseChart = ref()\\\\nconst categoryMarginChart = ref()\\\\nconst costStructureChart = ref()\\\\nconst priceElasticityChart = ref()\\\\nconst bcgMatrixChart = ref()\\\\n\\\\nconst topDishes = ref<TopDish[]>([\\\\n  { rank: 1, dishName: \\\\'红烧肉\\\\', categoryName: \\\\'热菜\\\\', sales: 580, revenue: 29000, rating: 4.8 },\\\\n  { rank: 2, dishName: \\\\'宫保鸡丁\\\\', categoryName: \\\\'热菜\\\\', sales: 520, revenue: 26000, rating: 4.7 },\\\\n  { rank: 3, dishName: \\\\'麻婆豆腐\\\\', categoryName: \\\\'热菜\\\\', sales: 480, revenue: 14400, rating: 4.6 },\\\\n  { rank: 4, dishName: \\\\'清蒸鱼\\\\', categoryName: \\\\'热菜\\\\', sales: 420, revenue: 25200, rating: 4.9 },\\\\n  { rank: 5, dishName: \\\\'糖醋排骨\\\\', categoryName: \\\\'热菜\\\\', sales: 380, revenue: 22800, rating: 4.5 }\\\\n])\\\\n\\\\nconst profitMetrics = ref<ProfitMetric[]>([\\\\n  {\\\\n    key: \\\\'overallMargin\\\\',\\\\n    label: \\\\'整体毛利率\\\\',\\\\n    value: \\\\'52.3%\\\\',\\\\n    change: 2.1,\\\\n    icon: \\\\'Money\\\\',\\\\n    color: \\\\'#67C23A\\\\'\\\\n  },\\\\n  {\\\\n    key: \\\\'avgDishMargin\\\\',\\\\n    label: \\\\'平均菜品毛利率\\\\',\\\\n    value: \\\\'48.5%\\\\',\\\\n    change: 1.8,\\\\n    icon: \\\\'TrendCharts\\\\',\\\\n    color: \\\\'#409EFF\\\\'\\\\n  },\\\\n  {\\\\n    key: \\\\'costRatio\\\\',\\\\n    label: \\\\'成本占比\\\\',\\\\n    value: \\\\'47.7%\\\\',\\\\n    change: -1.5,\\\\n    icon: \\\\'PieChart\\\\',\\\\n    color: \\\\'#E6A23C\\\\'\\\\n  },\\\\n  {\\\\n    key: \\\\'profitGrowth\\\\',\\\\n    label: \\\\'利润增长率\\\\',\\\\n    value: \\\\'15.2%\\\\',\\\\n    change: 8.5,\\\\n    icon: \\\\'Money\\\\',\\\\n    color: \\\\'#F56C6C\\\\'\\\\n  }\\\\n])\\\\n\\\\nconst highMarginDishes = ref<HighMarginDish[]>([\\\\n  { dishName: \\\\'清蒸鱼\\\\', margin: 72, profit: 18144 },\\\\n  { dishName: \\\\'红烧肉\\\\', margin: 68, profit: 19720 },\\\\n  { dishName: \\\\'宫保鸡丁\\\\', margin: 65, profit: 16900 },\\\\n  { dishName: \\\\'糖醋排骨\\\\', margin: 62, profit: 14136 },\\\\n  { dishName: \\\\'麻婆豆腐\\\\', margin: 58, profit: 8352 }\\\\n])\\\\n\\\\nconst slowMovingDishes = ref<SlowMovingDish[]>([\\\\n  { dishName: \\\\'凉拌黄瓜\\\\', sales: 15, daysSinceLastSale: 30, inventory: 50 },\\\\n  { dishName: \\\\'素炒豆芽\\\\', sales: 12, daysSinceLastSale: 25, inventory: 40 },\\\\n  { dishName: \\\\'清炒时蔬\\\\', sales: 10, daysSinceLastSale: 20, inventory: 35 },\\\\n  { dishName: \\\\'凉拌木耳\\\\', sales: 8, daysSinceLastSale: 18, inventory: 30 },\\\\n  { dishName: \\\\'素炒土豆丝\\\\', sales: 6, daysSinceLastSale: 15, inventory: 25 }\\\\n])\\\\n\\\\nconst newDishes = ref<NewDish[]>([\\\\n  { dishName: \\\\'香辣蟹\\\\', launchDate: \\\\'2024-12-01\\\\', sales: 180, rating: 4.7, status: \\\\'hot\\\\' },\\\\n  { dishName: \\\\'水煮鱼\\\\', launchDate: \\\\'2024-12-05\\\\', sales: 150, rating: 4.6, status: \\\\'hot\\\\' },\\\\n  { dishName: \\\\'干锅花菜\\\\', launchDate: \\\\'2024-12-10\\\\', sales: 95, rating: 4.4, status: \\\\'normal\\\\' },\\\\n  { dishName: \\\\'蒜蓉粉丝蒸扇贝\\\\', launchDate: \\\\'2024-12-15\\\\', sales: 45, rating: 4.5, status: \\\\'normal\\\\' },\\\\n  { dishName: \\\\'椒盐虾\\\\', launchDate: \\\\'2024-12-20\\\\', sales: 25, rating: 4.3, status: \\\\'cold\\\\' }\\\\n])\\\\n\\\\nconst menuOptimizationSuggestions = ref<MenuOptimizationSuggestion[]>([\\\\n  {\\\\n    title: \\\\'下架滞销菜品\\\\',\\\\n    type: \\\\'warning\\\\',\\\\n    description: \\\\'建议下架凉拌黄瓜、素炒豆芽等5款滞销菜品，可减少库存积压约¥2,500\\\\',\\\\n    impact: 3.2\\\\n  },\\\\n  {\\\\n    title: \\\\'推出春季特色菜品\\\\',\\\\n    type: \\\\'success\\\\',\\\\n    description: \\\\'根据季节性需求，建议推出春笋炒肉、香椿炒蛋等春季特色菜品\\\\',\\\\n    impact: 8.5\\\\n  },\\\\n  {\\\\n    title: \\\\'调整热销菜品价格\\\\',\\\\n    type: \\\\'info\\\\',\\\\n    description: \\\\'红烧肉、宫保鸡丁等热销菜品可适当提价3-5%，预计增加收入¥3,800\\\\',\\\\n    impact: 5.2\\\\n  },\\\\n  {\\\\n    title: \\\\'优化菜单结构\\\\',\\\\n    type: \\\\'success\\\\',\\\\n    description: \\\\'增加凉菜和饮品品类，丰富菜单选择，提升客单价\\\\',\\\\n    impact: 6.8\\\\n  }\\\\n])\\\\n\\\\nconst optimizationRecommendations = ref<OptimizationRecommendation[]>([\\\\n  {\\\\n    type: \\\\'remove\\\\',\\\\n    dishName: \\\\'凉拌黄瓜\\\\',\\\\n    reason: \\\\'近30天仅售15份，库存积压严重\\\\',\\\\n    potentialImpact: 2.5,\\\\n    confidence: 85\\\\n  },\\\\n  {\\\\n    type: \\\\'price_up\\\\',\\\\n    dishName: \\\\'红烧肉\\\\',\\\\n    reason: \\\\'热销菜品，价格弹性低，可适当提价\\\\',\\\\n    potentialImpact: 3.2,\\\\n    confidence: 78\\\\n  },\\\\n  {\\\\n    type: \\\\'promote\\\\',\\\\n    dishName: \\\\'香辣蟹\\\\',\\\\n    reason: \\\\'新菜品表现优秀，建议加大推广\\\\',\\\\n    potentialImpact: 5.8,\\\\n    confidence: 82\\\\n  },\\\\n  {\\\\n    type: \\\\'bundle\\\\',\\\\n    dishName: \\\\'宫保鸡丁+米饭\\\\',\\\\n    reason: \\\\'组合套餐可提升客单价\\\\',\\\\n    potentialImpact: 4.5,\\\\n    confidence: 75\\\\n  },\\\\n  {\\\\n    type: \\\\'new\\\\',\\\\n    dishName: \\\\'春笋炒肉\\\\',\\\\n    reason: \\\\'春季特色菜品，符合季节需求\\\\',\\\\n    potentialImpact: 6.2,\\\\n    confidence: 80\\\\n  }\\\\n])\\\\n\\\\nconst starDishes = ref<StarDish[]>([\\\\n  { dishName: \\\\'红烧肉\\\\', marketShare: 12.5, growthRate: 8.5 },\\\\n  { dishName: \\\\'宫保鸡丁\\\\', marketShare: 10.8, growthRate: 7.2 },\\\\n  { dishName: \\\\'清蒸鱼\\\\', marketShare: 9.5, growthRate: 9.8 },\\\\n  { dishName: \\\\'香辣蟹\\\\', marketShare: 5.2, growthRate: 15.6 }\\\\n])\\\\n\\\\nconst problemDishes = ref<StarDish[]>([\\\\n  { dishName: \\\\'凉拌黄瓜\\\\', marketShare: 0.8, growthRate: -15.2 },\\\\n  { dishName: \\\\'素炒豆芽\\\\', marketShare: 0.6, growthRate: -12.8 },\\\\n  { dishName: \\\\'清炒时蔬\\\\', marketShare: 0.5, growthRate: -10.5 },\\\\n  { dishName: \\\\'椒盐虾\\\\', marketShare: 0.3, growthRate: -8.2 }\\\\n])\\\\n\\\\nconst initCategorySalesChart = () => {\\\\n  if (!categorySalesChart.value) return\\\\n  \\\\n  const chart = echarts.init(categorySalesChart.value)\\\\n  const option = {\\\\n    tooltip: {\\\\n      trigger: \\\\'axis\\\\',\\\\n      axisPointer: {\\\\n        type: \\\\'shadow\\\\'\\\\n      }\\\\n    },\\\\n    grid: {\\\\n      left: \\\\'3%\\\\',\\\\n      right: \\\\'4%\\\\',\\\\n      bottom: \\\\'3%\\\\',\\\\n      containLabel: true\\\\n    },\\\\n    xAxis: {\\\\n      type: \\\\'value\\\\'\\\\n    },\\\\n    yAxis: {\\\\n      type: \\\\'category\\\\',\\\\n      data: [\\\\'甜点\\\\', \\\\'饮品\\\\', \\\\'汤品\\\\', \\\\'凉菜\\\\', \\\\'主食\\\\', \\\\'热菜\\\\']\\\\n    },\\\\n    series: [\\\\n      {\\\\n        name: \\\\'销量\\\\',\\\\n        type: \\\\'bar\\\\',\\\\n        data: [520, 680, 920, 850, 1250, 1580],\\\\n        itemStyle: {\\\\n          color: new echarts.graphic.LinearGradient(1, 0, 0, 0, [\\\\n            { offset: 0, color: \\\\'#83bff6\\\\' },\\\\n            { offset: 0.5, color: \\\\'#188df0\\\\' },\\\\n            { offset: 1, color: \\\\'#188df0\\\\' }\\\\n          ])\\\\n        }\\\\n      }\\\\n    ]\\\\n  }\\\\n  chart.setOption(option)\\\\n}\\\\n\\\\nconst initRatingChart = () => {\\\\n  if (!ratingChart.value) return\\\\n  \\\\n  const chart = echarts.init(ratingChart.value)\\\\n  const option = {\\\\n    tooltip: {\\\\n      trigger: \\\\'item\\\\',\\\\n      formatter: \\\\'{b}: {c}个\\\\'\\\\n    },\\\\n    series: [\\\\n      {\\\\n        name: \\\\'评分分布\\\\',\\\\n        type: \\\\'pie\\\\',\\\\n        radius: [\\\\'40%\\\\', \\\\'70%\\\\'],\\\\n        data: [\\\\n          { value: 320, name: \\\\'5星\\\\', itemStyle: { color: \\\\'#67C23A\\\\' } },\\\\n          { value: 480, name: \\\\'4星\\\\', itemStyle: { color: \\\\'#409EFF\\\\' } },\\\\n          { value: 150, name: \\\\'3星\\\\', itemStyle: { color: \\\\'#E6A23C\\\\' } },\\\\n          { value: 35, name: \\\\'2星\\\\', itemStyle: { color: \\\\'#F56C6C\\\\' } },\\\\n          { value: 15, name: \\\\'1星\\\\', itemStyle: { color: \\\\'#909399\\\\' } }\\\\n        ],\\\\n        emphasis: {\\\\n          itemStyle: {\\\\n            shadowBlur: 10,\\\\n            shadowOffsetX: 0,\\\\n            shadowColor: \\\\'rgba(0, 0, 0, 0.5)\\\\'\\\\n          }\\\\n        }\\\\n      }\\\\n    ]\\\\n  }\\\\n  chart.setOption(option)\\\\n}\\\\n\\\\nconst initRepurchaseChart = () => {\\\\n  if (!repurchaseChart.value) return\\\\n  \\\\n  const chart = echarts.init(repurchaseChart.value)\\\\n  const option = {\\\\n    tooltip: {\\\\n      trigger: \\\\'axis\\\\'\\\\n    },\\\\n    grid: {\\\\n      left: \\\\'3%\\\\',\\\\n      right: \\\\'4%\\\\',\\\\n      bottom: \\\\'3%\\\\',\\\\n      containLabel: true\\\\n    },\\\\n    xAxis: {\\\\n      type: \\\\'category\\\\',\\\\n      data: [\\\\'红烧肉\\\\', \\\\'宫保鸡丁\\\\', \\\\'麻婆豆腐\\\\', \\\\'清蒸鱼\\\\', \\\\'糖醋排骨\\\\']\\\\n    },\\\\n    yAxis: {\\\\n      type: \\\\'value\\\\',\\\\n      max: 100,\\\\n      axisLabel: {\\\\n        formatter: \\\\'{value}%\\\\'\\\\n      }\\\\n    },\\\\n    series: [\\\\n      {\\\\n        name: \\\\'复购率\\\\',\\\\n        type: \\\\'bar\\\\',\\\\n        data: [65, 58, 52, 48, 45],\\\\n        itemStyle: {\\\\n          color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [\\\\n            { offset: 0, color: \\\\'#67C23A\\\\' },\\\\n            { offset: 0.5, color: \\\\'#95d475\\\\' },\\\\n            { offset: 1, color: \\\\'#b3e19d\\\\' }\\\\n          ])\\\\n        }\\\\n      }\\\\n    ]\\\\n  }\\\\n  chart.setOption(option)\\\\n}\\\\n\\\\nconst initCategoryMarginChart = () => {\\\\n  if (!categoryMarginChart.value) return\\\\n  \\\\n  const chart = echarts.init(categoryMarginChart.value)\\\\n  const option = {\\\\n    tooltip: {\\\\n      trigger: \\\\'axis\\\\',\\\\n      axisPointer: {\\\\n        type: \\\\'shadow\\\\'\\\\n      }\\\\n    },\\\\n    grid: {\\\\n      left: \\\\'3%\\\\',\\\\n      right: \\\\'4%\\\\',\\\\n      bottom: \\\\'3%\\\\',\\\\n      containLabel: true\\\\n    },\\\\n    xAxis: {\\\\n      type: \\\\'category\\\\',\\\\n      data: [\\\\'凉菜\\\\', \\\\'汤品\\\\', \\\\'主食\\\\', \\\\'热菜\\\\', \\\\'饮品\\\\', \\\\'甜点\\\\']\\\\n    },\\\\n    yAxis: {\\\\n      type: \\\\'value\\\\',\\\\n      max: 100,\\\\n      axisLabel: {\\\\n        formatter: \\\\'{value}%\\\\'\\\\n      }\\\\n    },\\\\n    series: [\\\\n      {\\\\n        name: \\\\'毛利率\\\\',\\\\n        type: \\\\'bar\\\\',\\\\n        data: [72, 68, 58, 52, 65, 75],\\\\n        itemStyle: {\\\\n          color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [\\\\n            { offset: 0, color: \\\\'#E6A23C\\\\' },\\\\n            { offset: 0.5, color: \\\\'#f0c78a\\\\' },\\\\n            { offset: 1, color: \\\\'#f3d19e\\\\' }\\\\n          ])\\\\n        }\\\\n      }\\\\n    ]\\\\n  }\\\\n  chart.setOption(option)\\\\n}\\\\n\\\\nconst initCostStructureChart = () => {\\\\n  if (!costStructureChart.value) return\\\\n  \\\\n  const chart = echarts.init(costStructureChart.value)\\\\n  const option = {\\\\n    tooltip: {\\\\n      trigger: \\\\'item\\\\',\\\\n      formatter: \\\\'{b}: ¥{c} ({d}%)\\\\'\\\\n    },\\\\n    legend: {\\\\n      orient: \\\\'vertical\\\\',\\\\n      left: \\\\'left\\\\'\\\\n    },\\\\n    series: [\\\\n      {\\\\n        name: \\\\'成本结构\\\\',\\\\n        type: \\\\'pie\\\\',\\\\n        radius: [\\\\'40%\\\\', \\\\'70%\\\\'],\\\\n        data: [\\\\n          { value: 45000, name: \\\\'食材成本\\\\', itemStyle: { color: \\\\'#F56C6C\\\\' } },\\\\n          { value: 18000, name: \\\\'人工成本\\\\', itemStyle: { color: \\\\'#409EFF\\\\' } },\\\\n          { value: 12000, name: \\\\'租金成本\\\\', itemStyle: { color: \\\\'#67C23A\\\\' } },\\\\n          { value: 8000, name: \\\\'水电成本\\\\', itemStyle: { color: \\\\'#E6A23C\\\\' } },\\\\n          { value: 5000, name: \\\\'其他成本\\\\', itemStyle: { color: \\\\'#909399\\\\' } }\\\\n        ],\\\\n        emphasis: {\\\\n          itemStyle: {\\\\n            shadowBlur: 10,\\\\n            shadowOffsetX: 0,\\\\n            shadowColor: \\\\'rgba(0, 0, 0, 0.5)\\\\'\\\\n          }\\\\n        }\\\\n      }\\\\n    ]\\\\n  }\\\\n  chart.setOption(option)\\\\n}\\\\n\\\\nconst initPriceElasticityChart = () => {\\\\n  if (!priceElasticityChart.value) return\\\\n  \\\\n  const chart = echarts.init(priceElasticityChart.value)\\\\n  const option = {\\\\n    tooltip: {\\\\n      trigger: \\\\'axis\\\\'\\\\n    },\\\\n    legend: {\\\\n      data: [\\\\'价格\\\\', \\\\'销量\\\\']\\\\n    },\\\\n    grid: {\\\\n      left: \\\\'3%\\\\',\\\\n      right: \\\\'4%\\\\',\\\\n      bottom: \\\\'3%\\\\',\\\\n      containLabel: true\\\\n    },\\\\n    xAxis: {\\\\n      type: \\\\'category\\\\',\\\\n      data: [\\\\'1月\\\\', \\\\'2月\\\\', \\\\'3月\\\\', \\\\'4月\\\\', \\\\'5月\\\\', \\\\'6月\\\\']\\\\n    },\\\\n    yAxis: [\\\\n      {\\\\n        type: \\\\'value\\\\',\\\\n        name: \\\\'价格\\\\',\\\\n        position: \\\\'left\\\\',\\\\n        axisLabel: {\\\\n          formatter: \\\\'¥{value}\\\\'\\\\n        }\\\\n      },\\\\n      {\\\\n        type: \\\\'value\\\\',\\\\n        name: \\\\'销量\\\\',\\\\n        position: \\\\'right\\\\'\\\\n      }\\\\n    ],\\\\n    series: [\\\\n      {\\\\n        name: \\\\'价格\\\\',\\\\n        type: \\\\'line\\\\',\\\\n        smooth: true,\\\\n        data: [50, 50, 52, 51, 53, 52],\\\\n        itemStyle: { color: \\\\'#F56C6C\\\\' }\\\\n      },\\\\n      {\\\\n        name: \\\\'销量\\\\',\\\\n        type: \\\\'line\\\\',\\\\n        smooth: true,\\\\n        yAxisIndex: 1,\\\\n        data: [480, 495, 470, 485, 460, 475],\\\\n        itemStyle: { color: \\\\'#409EFF\\\\' }\\\\n      }\\\\n    ]\\\\n  }\\\\n  chart.setOption(option)\\\\n}\\\\n\\\\nconst initBcgMatrixChart = () => {\\\\n  if (!bcgMatrixChart.value) return\\\\n  \\\\n  const chart = echarts.init(bcgMatrixChart.value)\\\\n  const data = [\\\\n    [12.5, 8.5, \\\\'红烧肉\\\\'],\\\\n    [10.8, 7.2, \\\\'宫保鸡丁\\\\'],\\\\n    [9.5, 9.8, \\\\'清蒸鱼\\\\'],\\\\n    [5.2, 15.6, \\\\'香辣蟹\\\\'],\\\\n    [0.8, -15.2, \\\\'凉拌黄瓜\\\\'],\\\\n    [0.6, -12.8, \\\\'素炒豆芽\\\\'],\\\\n    [8.5, 3.2, \\\\'糖醋排骨\\\\'],\\\\n    [6.8, 2.5, \\\\'麻婆豆腐\\\\']\\\\n  ]\\\\n  \\\\n  const option = {\\\\n    tooltip: {\\\\n      trigger: \\\\'item\\\\',\\\\n      formatter: (params: any) => {\\\\n        return `${params.data[2]}<br/>市场份额: ${params.data[0]}%<br/>增长率: ${params.data[1]}%`\\\\n      }\\\\n    },\\\\n    grid: {\\\\n      left: \\\\'3%\\\\',\\\\n      right: \\\\'7%\\\\',\\\\n      bottom: \\\\'3%\\\\',\\\\n      containLabel: true\\\\n    },\\\\n    xAxis: {\\\\n      name: \\\\'市场份额\\\\',\\\\n      nameLocation: \\\\'middle\\\\',\\\\n      nameGap: 30,\\\\n      type: \\\\'value\\\\',\\\\n      splitLine: {\\\\n        show: false\\\\n      }\\\\n    },\\\\n    yAxis: {\\\\n      name: \\\\'增长率\\\\',\\\\n      nameLocation: \\\\'middle\\\\',\\\\n      nameGap: 40,\\\\n      type: \\\\'value\\\\',\\\\n      splitLine: {\\\\n        show: false\\\\n      }\\\\n    },\\\\n    series: [\\\\n      {\\\\n        name: \\\\'BCG矩阵\\\\',\\\\n        type: \\\\'scatter\\\\',\\\\n        data: data,\\\\n        symbolSize: (data: number[]) => {\\\\n          return Math.sqrt(data[0] * 10) * 8\\\\n        },\\\\n        itemStyle: (params: any) => {\\\\n          const growth = params.data[1]\\\\n          if (growth > 10) return { color: \\\\'#67C23A\\\\' }\\\\n          if (growth > 0) return { color: \\\\'#409EFF\\\\' }\\\\n          return { color: \\\\'#F56C6C\\\\' }\\\\n        },\\\\n        label: {\\\\n          show: true,\\\\n          position: \\\\'top\\\\',\\\\n          formatter: (params: any) => params.data[2]\\\\n        }\\\\n      }\\\\n    ]\\\\n  }\\\\n  chart.setOption(option)\\\\n}\\\\n\\\\nconst getRecommendationTypeText = (type: string) => {\\\\n  const typeMap: Record<string, string> = {\\\\n    remove: \\\\'下架\\\\',\\\\n    price_up: \\\\'提价\\\\',\\\\n    promote: \\\\'推广\\\\',\\\\n    bundle: \\\\'套餐\\\\',\\\\n    new: \\\\'上新\\\\'\\\\n  }\\\\n  return typeMap[type] || type\\\\n}\\\\n\\\\nconst getRecommendationTypeColor = (type: string) => {\\\\n  const typeMap: Record<string, any> = {\\\\n    remove: \\\\'danger\\\\',\\\\n    price_up: \\\\'warning\\\\',\\\\n    promote: \\\\'success\\\\',\\\\n    bundle: \\\\'primary\\\\',\\\\n    new: \\\\'info\\\\'\\\\n  }\\\\n  return typeMap[type] || \\\\'\\\\'\\\\n}\\\\n\\\\nconst handleRemoveDish = async (row: SlowMovingDish) => {\\\\n  try {\\\\n    await ElMessageBox.confirm(\\\\n      `确定要下架菜品\\\\\\\"${row.dishName}\\\\\\\"吗？`,\\\\n      \\\\'确认下架\\\\',\\\\n      {\\\\n        confirmButtonText: \\\\'确定\\\\',\\\\n        cancelButtonText: \\\\'取消\\\\',\\\\n        type: \\\\'warning\\\\'\\\\n      }\\\\n    )\\\\n    ElMessage.success(\\\\'菜品已下架\\\\')\\\\n  } catch (error) {\\\\n    if (error !== \\\\'cancel\\\\') {\\\\n      ElMessage.error(\\\\'操作失败\\\\')\\\\n    }\\\\n  }\\\\n}\\\\n\\\\nconst handlePromoteDish = async (row: SlowMovingDish) => {\\\\n  ElMessage.success(`已将\\\\\\\"${row.dishName}\\\\\\\"加入促销计划`)\\\\n}\\\\n\\\\nconst handleApplyRecommendation = async (row: OptimizationRecommendation) => {\\\\n  ElMessage.success(`已应用建议：${row.dishName}`)\\\\n}\\\\n\\\\nconst handleIgnoreRecommendation = async (row: OptimizationRecommendation) => {\\\\n  ElMessage.info(`已忽略建议：${row.dishName}`)\\\\n}\\\\n\\\\nconst handleApplyAllRecommendations = async () => {\\\\n  try {\\\\n    await ElMessageBox.confirm(\\\\n      \\\\'确定要应用全部建议吗？\\\\',\\\\n      \\\\'确认操作\\\\',\\\\n      {\\\\n        confirmButtonText: \\\\'确定\\\\',\\\\n        cancelButtonText: \\\\'取消\\\\',\\\\n        type: \\\\'warning\\\\'\\\\n      }\\\\n    )\\\\n    ElMessage.success(\\\\'已应用全部建议\\\\')\\\\n    showOptimizationDialog.value = false\\\\n  } catch (error) {\\\\n    if (error !== \\\\'cancel\\\\') {\\\\n      ElMessage.error(\\\\'操作失败\\\\')\\\\n    }\\\\n  }\\\\n}\\\\n\\\\nwatch(viewMode, async (newMode) => {\\\\n  await nextTick()\\\\n  \\\\n  if (newMode === \\\\'performance\\\\') {\\\\n    initCategorySalesChart()\\\\n    initRatingChart()\\\\n    initRepurchaseChart()\\\\n  } else if (newMode === \\\\'profitability\\\\') {\\\\n    initCategoryMarginChart()\\\\n    initCostStructureChart()\\\\n  } else if (newMode === \\\\'optimization\\\\') {\\\\n    initPriceElasticityChart()\\\\n  } else if (newMode === \\\\'matrix\\\\') {\\\\n    initBcgMatrixChart()\\\\n  }\\\\n})\\\\n\\\\nonMounted(async () => {\\\\n  await nextTick()\\\\n  initCategorySalesChart()\\\\n  initRatingChart()\\\\n  initRepurchaseChart()\\\\n})\\\\n</script>\\\\n\\\\n<style scoped lang=\\\\\\\"scss\\\\\\\">\\\\n.menu-analytics {\\\\n  .analytics-header {\\\\n    display: flex;\\\\n    justify-content: space-between;\\\\n    align-items: center;\\\\n    margin-bottom: 20px;\\\\n    \\\\n    .header-title {\\\\n      h3 {\\\\n        margin: 0 0 5px 0;\\\\n        font-size: 20px;\\\\n        color: #303133;\\\\n      }\\\\n      \\\\n      p {\\\\n        margin: 0;\\\\n        font-size: 14px;\\\\n        color: #909399;\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  .analytics-content {\\\\n    .chart-container {\\\\n      width: 100%;\\\\n      height: 350px;\\\\n    }\\\\n\\\\n    .large-chart-container {\\\\n      width: 100%;\\\\n      height: 500px;\\\\n    }\\\\n\\\\n    .profit-metric-card {\\\\n      .metric-content {\\\\n        display: flex;\\\\n        align-items: center;\\\\n\\\\n        .metric-icon {\\\\n          width: 50px;\\\\n          height: 50px;\\\\n          border-radius: 8px;\\\\n          display: flex;\\\\n          align-items: center;\\\\n          justify-content: center;\\\\n          color: white;\\\\n          margin-right: 15px;\\\\n        }\\\\n\\\\n        .metric-info {\\\\n          flex: 1;\\\\n\\\\n          .metric-value {\\\\n            font-size: 24px;\\\\n            font-weight: bold;\\\\n            color: #303133;\\\\n            margin-bottom: 5px;\\\\n          }\\\\n\\\\n          .metric-label {\\\\n            font-size: 14px;\\\\n            color: #606266;\\\\n            margin-bottom: 5px;\\\\n          }\\\\n\\\\n          .metric-change {\\\\n            font-size: 12px;\\\\n\\\\n            &.positive {\\\\n              color: #67c23a;\\\\n            }\\\\n\\\\n            &.negative {\\\\n              color: #f56c6c;\\\\n            }\\\\n          }\\\\n        }\\\\n      }\\\\n    }\\\\n\\\\n    .optimization-suggestions {\\\\n      .suggestion-content {\\\\n        .suggestion-title {\\\\n          font-size: 16px;\\\\n          font-weight: bold;\\\\n          color: #303133;\\\\n          margin-bottom: 8px;\\\\n        }\\\\n\\\\n        .suggestion-description {\\\\n          font-size: 14px;\\\\n          color: #606266;\\\\n          margin-bottom: 8px;\\\\n        }\\\\n\\\\n        .suggestion-impact {\\\\n          font-size: 14px;\\\\n\\\\n          .impact-label {\\\\n            color: #909399;\\\\n            margin-right: 8px;\\\\n          }\\\\n\\\\n          .positive {\\\\n            color: #67c23a;\\\\n            font-weight: bold;\\\\n          }\\\\n\\\\n          .negative {\\\\n            color: #f56c6c;\\\\n            font-weight: bold;\\\\n          }\\\\n        }\\\\n      }\\\\n    }\\\\n\\\\n    .positive {\\\\n      color: #67c23a;\\\\n    }\\\\n\\\\n    .negative {\\\\n      color: #f56c6c;\\\\n    }\\\\n  }\\\\n}\\\\n</style>\\\\n\",\"originAcceptText\":\"<template>\\n  <div class=\\\"menu-analytics\\\">\\n    <div class=\\\"analytics-header\\\">\\n      <div class=\\\"header-title\\\">\\n        <h3>菜单分析</h3>\\n        <p>优化菜单结构和定价策略</p>\\n      </div>\\n      <div class=\\\"header-actions\\\">\\n        <el-button-group>\\n          <el-button :type=\\\"viewMode === 'performance' ? 'primary' : 'default'\\\" @click=\\\"viewMode = 'performance'\\\">\\n            表现\\n          </el-button>\\n          <el-button :type=\\\"viewMode === 'profitability' ? 'primary' : 'default'\\\" @click=\\\"viewMode = 'profitability'\\\">\\n            盈利\\n          </el-button>\\n          <el-button :type=\\\"viewMode === 'optimization' ? 'primary' : 'default'\\\" @click=\\\"viewMode = 'optimization'\\\">\\n            优化\\n          </el-button>\\n          <el-button :type=\\\"viewMode === 'matrix' ? 'primary' : 'default'\\\" @click=\\\"viewMode = 'matrix'\\\">\\n            矩阵\\n          </el-button>\\n        </el-button-group>\\n        <el-button type=\\\"primary\\\" @click=\\\"showOptimizationDialog = true\\\">\\n          <el-icon><MagicStick /></el-icon>\\n          优化建议\\n        </el-button>\\n      </div>\\n    </div>\\n\\n    <div class=\\\"analytics-content\\\">\\n      <div v-if=\\\"viewMode === 'performance'\\\" class=\\\"performance-view\\\">\\n        <el-row :gutter=\\\"20\\\">\\n          <el-col :span=\\\"12\\\">\\n            <el-card title=\\\"菜品销量排行\\\">\\n              <el-table :data=\\\"topDishes\\\" style=\\\"width: 100%\\\" v-loading=\\\"loading\\\">\\n                <el-table-column type=\\\"index\\\" label=\\\"排名\\\" width=\\\"80\\\" />\\n                <el-table-column prop=\\\"dishName\\\" label=\\\"菜品名称\\\" />\\n                <el-table-column prop=\\\"categoryName\\\" label=\\\"类别\\\" width=\\\"100\\\" />\\n                <el-table-column prop=\\\"sales\\\" label=\\\"销量\\\" width=\\\"100\\\" sortable />\\n                <el-table-column prop=\\\"revenue\\\" label=\\\"收入\\\" width=\\\"120\\\" sortable>\\n                  <template #default=\\\"{ row }\\\">\\n                    ¥{{ row.revenue.toLocaleString() }}\\n                  </template>\\n                </el-table-column>\\n                <el-table-column prop=\\\"rating\\\" label=\\\"评分\\\" width=\\\"100\\\" sortable>\\n                  <template #default=\\\"{ row }\\\">\\n                    <el-rate v-model=\\\"row.rating\\\" disabled show-score />\\n                  </template>\\n                </el-table-column>\\n              </el-table>\\n            </el-card>\\n          </el-col>\\n          <el-col :span=\\\"12\\\">\\n            <el-card title=\\\"类别销售对比\\\">\\n              <div ref=\\\"categorySalesChart\\\" class=\\\"chart-container\\\"></div>\\n            </el-card>\\n          </el-col>\\n        </el-row>\\n\\n        <el-row :gutter=\\\"20\\\" style=\\\"margin-top: 20px;\\\">\\n          <el-col :span=\\\"12\\\">\\n            <el-card title=\\\"菜品评价分析\\\">\\n              <div ref=\\\"ratingChart\\\" class=\\\"chart-container\\\"></div>\\n            </el-card>\\n          </el-col>\\n          <el-col :span=\\\"12\\\">\\n            <el-card title=\\\"菜品复购率\\\">\\n              <div ref=\\\"repurchaseChart\\\" class=\\\"chart-container\\\"></div>\\n            </el-card>\\n          </el-col>\\n        </el-row>\\n      </div>\\n\\n      <div v-else-if=\\\"viewMode === 'profitability'\\\" class=\\\"profitability-view\\\">\\n        <el-row :gutter=\\\"20\\\">\\n          <el-col :span=\\\"6\\\" v-for=\\\"metric in profitMetrics\\\" :key=\\\"metric.key\\\">\\n            <el-card class=\\\"profit-metric-card\\\">\\n              <div class=\\\"metric-content\\\">\\n                <div class=\\\"metric-icon\\\" :style=\\\"{ backgroundColor: metric.color }\\\">\\n                  <el-icon :size=\\\"24\\\">\\n                    <component :is=\\\"metric.icon\\\" />\\n                  </el-icon>\\n                </div>\\n                <div class=\\\"metric-info\\\">\\n                  <div class=\\\"metric-value\\\">{{ metric.value }}</div>\\n                  <div class=\\\"metric-label\\\">{{ metric.label }}</div>\\n                  <div class=\\\"metric-change\\\" :class=\\\"metric.change >= 0 ? 'positive' : 'negative'\\\">\\n                    {{ metric.change >= 0 ? '+' : '' }}{{ metric.change }}%\\n                  </div>\\n                </div>\\n              </div>\\n            </el-card>\\n          </el-col>\\n        </el-row>\\n\\n        <el-row :gutter=\\\"20\\\" style=\\\"margin-top: 20px;\\\">\\n          <el-col :span=\\\"12\\\">\\n            <el-card title=\\\"类别毛利率分析\\\">\\n              <div ref=\\\"categoryMarginChart\\\" class=\\\"chart-container\\\"></div>\\n            </el-card>\\n          </el-col>\\n          <el-col :span=\\\"12\\\">\\n            <el-card title=\\\"菜品毛利率排行\\\">\\n              <el-table :data=\\\"highMarginDishes\\\" style=\\\"width: 100%\\\" max-height=\\\"350\\\">\\n                <el-table-column type=\\\"index\\\" label=\\\"排名\\\" width=\\\"60\\\" />\\n                <el-table-column prop=\\\"dishName\\\" label=\\\"菜品名称\\\" />\\n                <el-table-column prop=\\\"margin\\\" label=\\\"毛利率\\\" width=\\\"100\\\" sortable>\\n                  <template #default=\\\"{ row }\\\">\\n                    <el-tag :type=\\\"row.margin >= 60 ? 'success' : row.margin >= 40 ? 'warning' : 'danger'\\\" size=\\\"small\\\">\\n                      {{ row.margin }}%\\n                    </el-tag>\\n                  </template>\\n                </el-table-column>\\n                <el-table-column prop=\\\"profit\\\" label=\\\"利润\\\" width=\\\"100\\\" sortable>\\n                  <template #default=\\\"{ row }\\\">\\n                    ¥{{ row.profit.toLocaleString() }}\\n                  </template>\\n                </el-table-column>\\n              </el-table>\\n            </el-card>\\n          </el-col>\\n        </el-row>\\n\\n        <el-row :gutter=\\\"20\\\" style=\\\"margin-top: 20px;\\\">\\n          <el-col :span=\\\"24\\\">\\n            <el-card title=\\\"成本结构分析\\\">\\n              <div ref=\\\"costStructureChart\\\" class=\\\"large-chart-container\\\"></div>\\n            </el-card>\\n          </el-col>\\n        </el-row>\\n      </div>\\n\\n      <div v-else-if=\\\"viewMode === 'optimization'\\\" class=\\\"optimization-view\\\">\\n        <el-row :gutter=\\\"20\\\">\\n          <el-col :span=\\\"12\\\">\\n            <el-card title=\\\"滞销菜品识别\\\">\\n              <el-table :data=\\\"slowMovingDishes\\\" style=\\\"width: 100%\\\">\\n                <el-table-column type=\\\"index\\\" label=\\\"排名\\\" width=\\\"60\\\" />\\n                <el-table-column prop=\\\"dishName\\\" label=\\\"菜品名称\\\" />\\n                <el-table-column prop=\\\"sales\\\" label=\\\"销量\\\" width=\\\"80\\\" sortable />\\n                <el-table-column prop=\\\"daysSinceLastSale\\\" label=\\\"未售天数\\\" width=\\\"100\\\" sortable />\\n                <el-table-column prop=\\\"inventory\\\" label=\\\"库存\\\" width=\\\"80\\\" />\\n                <el-table-column label=\\\"建议操作\\\" width=\\\"150\\\">\\n                  <template #default=\\\"{ row }\\\">\\n                    <el-button size=\\\"small\\\" type=\\\"danger\\\" @click=\\\"handleRemoveDish(row)\\\">\\n                      下架\\n                    </el-button>\\n                    <el-button size=\\\"small\\\" type=\\\"warning\\\" @click=\\\"handlePromoteDish(row)\\\">\\n                      促销\\n                    </el-button>\\n                  </template>\\n                </el-table-column>\\n              </el-table>\\n            </el-card>\\n          </el-col>\\n          <el-col :span=\\\"12\\\">\\n            <el-card title=\\\"新菜品表现\\\">\\n              <el-table :data=\\\"newDishes\\\" style=\\\"width: 100%\\\">\\n                <el-table-column type=\\\"index\\\" label=\\\"排名\\\" width=\\\"60\\\" />\\n                <el-table-column prop=\\\"dishName\\\" label=\\\"菜品名称\\\" />\\n                <el-table-column prop=\\\"launchDate\\\" label=\\\"上线日期\\\" width=\\\"120\\\" />\\n                <el-table-column prop=\\\"sales\\\" label=\\\"销量\\\" width=\\\"80\\\" sortable />\\n                <el-table-column prop=\\\"rating\\\" label=\\\"评分\\\" width=\\\"100\\\">\\n                  <template #default=\\\"{ row }\\\">\\n                    <el-rate v-model=\\\"row.rating\\\" disabled show-score />\\n                  </template>\\n                </el-table-column>\\n                <el-table-column label=\\\"状态\\\" width=\\\"100\\\">\\n                  <template #default=\\\"{ row }\\\">\\n                    <el-tag :type=\\\"row.status === 'hot' ? 'success' : row.status === 'normal' ? 'warning' : 'danger'\\\" size=\\\"small\\\">\\n                      {{ row.status === 'hot' ? '热门' : row.status === 'normal' ? '正常' : '冷门' }}\\n                    </el-tag>\\n                  </template>\\n                </el-table-column>\\n              </el-table>\\n            </el-card>\\n          </el-col>\\n        </el-row>\\n\\n        <el-row :gutter=\\\"20\\\" style=\\\"margin-top: 20px;\\\">\\n          <el-col :span=\\\"24\\\">\\n            <el-card title=\\\"价格弹性分析\\\">\\n              <div ref=\\\"priceElasticityChart\\\" class=\\\"large-chart-container\\\"></div>\\n            </el-card>\\n          </el-col>\\n        </el-row>\\n\\n        <el-row :gutter=\\\"20\\\" style=\\\"margin-top: 20px;\\\">\\n          <el-col :span=\\\"24\\\">\\n            <el-card title=\\\"菜单结构优化建议\\\">\\n              <div class=\\\"optimization-suggestions\\\">\\n                <el-alert\\n                  v-for=\\\"(suggestion, index) in menuOptimizationSuggestions\\\"\\n                  :key=\\\"index\\\"\\n                  :title=\\\"suggestion.title\\\"\\n                  :type=\\\"suggestion.type\\\"\\n                  :description=\\\"suggestion.description\\\"\\n                  :closable=\\\"false\\\"\\n                  style=\\\"margin-bottom: 15px;\\\"\\n                >\\n                  <template #default>\\n                    <div class=\\\"suggestion-content\\\">\\n                      <div class=\\\"suggestion-title\\\">{{ suggestion.title }}</div>\\n                      <div class=\\\"suggestion-description\\\">{{ suggestion.description }}</div>\\n                      <div class=\\\"suggestion-impact\\\">\\n                        <span class=\\\"impact-label\\\">预期影响:</span>\\n                        <span :class=\\\"suggestion.impact > 0 ? 'positive' : 'negative'\\\">\\n                          {{ suggestion.impact > 0 ? '+' : '' }}{{ suggestion.impact }}%\\n                        </span>\\n                      </div>\\n                    </div>\\n                  </template>\\n                </el-alert>\\n              </div>\\n            </el-card>\\n          </el-col>\\n        </el-row>\\n      </div>\\n\\n      <div v-else-if=\\\"viewMode === 'matrix'\\\" class=\\\"matrix-view\\\">\\n        <el-row :gutter=\\\"20\\\">\\n          <el-col :span=\\\"24\\\">\\n            <el-card title=\\\"BCG矩阵分析\\\">\\n              <div ref=\\\"bcgMatrixChart\\\" class=\\\"large-chart-container\\\"></div>\\n            </el-card>\\n          </el-col>\\n        </el-row>\\n\\n        <el-row :gutter=\\\"20\\\" style=\\\"margin-top: 20px;\\\">\\n          <el-col :span=\\\"12\\\">\\n            <el-card title=\\\"明星菜品\\\">\\n              <el-table :data=\\\"starDishes\\\" style=\\\"width: 100%\\\">\\n                <el-table-column type=\\\"index\\\" label=\\\"排名\\\" width=\\\"60\\\" />\\n                <el-table-column prop=\\\"dishName\\\" label=\\\"菜品名称\\\" />\\n                <el-table-column prop=\\\"marketShare\\\" label=\\\"市场份额\\\" width=\\\"100\\\" sortable>\\n                  <template #default=\\\"{ row }\\\">\\n                    {{ row.marketShare }}%\\n                  </template>\\n                </el-table-column>\\n                <el-table-column prop=\\\"growthRate\\\" label=\\\"增长率\\\" width=\\\"100\\\" sortable>\\n                  <template #default=\\\"{ row }\\\">\\n                    <span class=\\\"positive\\\">+{{ row.growthRate }}%</span>\\n                  </template>\\n                </el-table-column>\\n              </el-table>\\n            </el-card>\\n          </el-col>\\n          <el-col :span=\\\"12\\\">\\n            <el-card title=\\\"问题菜品\\\">\\n              <el-table :data=\\\"problemDishes\\\" style=\\\"width: 100%\\\">\\n                <el-table-column type=\\\"index\\\" label=\\\"排名\\\" width=\\\"60\\\" />\\n                <el-table-column prop=\\\"dishName\\\" label=\\\"菜品名称\\\" />\\n                <el-table-column prop=\\\"marketShare\\\" label=\\\"市场份额\\\" width=\\\"100\\\" sortable>\\n                  <template #default=\\\"{ row }\\\">\\n                    {{ row.marketShare }}%\\n                  </template>\\n                </el-table-column>\\n                <el-table-column prop=\\\"growthRate\\\" label=\\\"增长率\\\" width=\\\"100\\\" sortable>\\n                  <template #default=\\\"{ row }\\\">\\n                    <span class=\\\"negative\\\">{{ row.growthRate }}%</span>\\n                  </template>\\n                </el-table-column>\\n              </el-table>\\n            </el-card>\\n          </el-col>\\n        </el-row>\\n      </div>\\n    </div>\\n\\n    <el-dialog v-model=\\\"showOptimizationDialog\\\" title=\\\"菜单优化建议\\\" width=\\\"70%\\\">\\n      <el-alert\\n        title=\\\"基于销售数据和客户反馈的智能建议\\\"\\n        type=\\\"info\\\"\\n        :closable=\\\"false\\\"\\n        style=\\\"margin-bottom: 20px;\\\"\\n      />\\n\\n      <el-table :data=\\\"optimizationRecommendations\\\" style=\\\"width: 100%\\\">\\n        <el-table-column prop=\\\"type\\\" label=\\\"建议类型\\\" width=\\\"120\\\">\\n          <template #default=\\\"{ row }\\\">\\n            <el-tag :type=\\\"getRecommendationTypeColor(row.type)\\\" size=\\\"small\\\">\\n              {{ getRecommendationTypeText(row.type) }}\\n            </el-tag>\\n          </template>\\n        </el-table-column>\\n        <el-table-column prop=\\\"dishName\\\" label=\\\"菜品名称\\\" />\\n        <el-table-column prop=\\\"reason\\\" label=\\\"建议原因\\\" min-width=\\\"200\\\" />\\n        <el-table-column prop=\\\"potentialImpact\\\" label=\\\"预期影响\\\" width=\\\"120\\\">\\n          <template #default=\\\"{ row }\\\">\\n            <span :class=\\\"row.potentialImpact > 0 ? 'positive' : 'negative'\\\">\\n              {{ row.potentialImpact > 0 ? '+' : '' }}{{ row.potentialImpact }}%\\n            </span>\\n          </template>\\n        </el-table-column>\\n        <el-table-column prop=\\\"confidence\\\" label=\\\"置信度\\\" width=\\\"120\\\">\\n          <template #default=\\\"{ row }\\\">\\n            <el-progress :percentage=\\\"row.confidence\\\" :stroke-width=\\\"6\\\" />\\n          </template>\\n        </el-table-column>\\n        <el-table-column label=\\\"操作\\\" width=\\\"150\\\">\\n          <template #default=\\\"{ row }\\\">\\n            <el-button size=\\\"small\\\" type=\\\"primary\\\" @click=\\\"handleApplyRecommendation(row)\\\">\\n              应用\\n            </el-button>\\n            <el-button size=\\\"small\\\" @click=\\\"handleIgnoreRecommendation(row)\\\">\\n              忽略\\n            </el-button>\\n          </template>\\n        </el-table-column>\\n      </el-table>\\n\\n      <template #footer>\\n        <span class=\\\"dialog-footer\\\">\\n          <el-button @click=\\\"showOptimizationDialog = false\\\">关闭</el-button>\\n          <el-button type=\\\"primary\\\" @click=\\\"handleApplyAllRecommendations\\\">\\n            应用全部\\n          </el-button>\\n        </span>\\n      </template>\\n    </el-dialog>\\n  </div>\\n</template>\\n\\n<script setup lang=\\\"ts\\\">\\nimport { ref, reactive, onMounted, nextTick, watch } from 'vue'\\nimport { ElMessage, ElMessageBox } from 'element-plus'\\nimport * as echarts from 'echarts'\\nimport { MagicStick, Money, TrendCharts, PieChart } from '@element-plus/icons-vue'\\n\\ninterface TopDish {\\n  rank: number\\n  dishName: string\\n  categoryName: string\\n  sales: number\\n  revenue: number\\n  rating: number\\n}\\n\\ninterface ProfitMetric {\\n  key: string\\n  label: string\\n  value: string | number\\n  change: number\\n  icon: string\\n  color: string\\n}\\n\\ninterface HighMarginDish {\\n  dishName: string\\n  margin: number\\n  profit: number\\n}\\n\\ninterface SlowMovingDish {\\n  dishName: string\\n  sales: number\\n  daysSinceLastSale: number\\n  inventory: number\\n}\\n\\ninterface NewDish {\\n  dishName: string\\n  launchDate: string\\n  sales: number\\n  rating: number\\n  status: 'hot' | 'normal' | 'cold'\\n}\\n\\ninterface MenuOptimizationSuggestion {\\n  title: string\\n  type: 'success' | 'warning' | 'info'\\n  description: string\\n  impact: number\\n}\\n\\ninterface OptimizationRecommendation {\\n  type: string\\n  dishName: string\\n  reason: string\\n  potentialImpact: number\\n  confidence: number\\n}\\n\\ninterface StarDish {\\n  dishName: string\\n  marketShare: number\\n  growthRate: number\\n}\\n\\nconst loading = ref(false)\\nconst viewMode = ref('performance')\\nconst showOptimizationDialog = ref(false)\\n\\nconst categorySalesChart = ref()\\nconst ratingChart = ref()\\nconst repurchaseChart = ref()\\nconst categoryMarginChart = ref()\\nconst costStructureChart = ref()\\nconst priceElasticityChart = ref()\\nconst bcgMatrixChart = ref()\\n\\nconst topDishes = ref<TopDish[]>([\\n  { rank: 1, dishName: '红烧肉', categoryName: '热菜', sales: 580, revenue: 29000, rating: 4.8 },\\n  { rank: 2, dishName: '宫保鸡丁', categoryName: '热菜', sales: 520, revenue: 26000, rating: 4.7 },\\n  { rank: 3, dishName: '麻婆豆腐', categoryName: '热菜', sales: 480, revenue: 14400, rating: 4.6 },\\n  { rank: 4, dishName: '清蒸鱼', categoryName: '热菜', sales: 420, revenue: 25200, rating: 4.9 },\\n  { rank: 5, dishName: '糖醋排骨', categoryName: '热菜', sales: 380, revenue: 22800, rating: 4.5 }\\n])\\n\\nconst profitMetrics = ref<ProfitMetric[]>([\\n  {\\n    key: 'overallMargin',\\n    label: '整体毛利率',\\n    value: '52.3%',\\n    change: 2.1,\\n    icon: 'Money',\\n    color: '#67C23A'\\n  },\\n  {\\n    key: 'avgDishMargin',\\n    label: '平均菜品毛利率',\\n    value: '48.5%',\\n    change: 1.8,\\n    icon: 'TrendCharts',\\n    color: '#409EFF'\\n  },\\n  {\\n    key: 'costRatio',\\n    label: '成本占比',\\n    value: '47.7%',\\n    change: -1.5,\\n    icon: 'PieChart',\\n    color: '#E6A23C'\\n  },\\n  {\\n    key: 'profitGrowth',\\n    label: '利润增长率',\\n    value: '15.2%',\\n    change: 8.5,\\n    icon: 'Money',\\n    color: '#F56C6C'\\n  }\\n])\\n\\nconst highMarginDishes = ref<HighMarginDish[]>([\\n  { dishName: '清蒸鱼', margin: 72, profit: 18144 },\\n  { dishName: '红烧肉', margin: 68, profit: 19720 },\\n  { dishName: '宫保鸡丁', margin: 65, profit: 16900 },\\n  { dishName: '糖醋排骨', margin: 62, profit: 14136 },\\n  { dishName: '麻婆豆腐', margin: 58, profit: 8352 }\\n])\\n\\nconst slowMovingDishes = ref<SlowMovingDish[]>([\\n  { dishName: '凉拌黄瓜', sales: 15, daysSinceLastSale: 30, inventory: 50 },\\n  { dishName: '素炒豆芽', sales: 12, daysSinceLastSale: 25, inventory: 40 },\\n  { dishName: '清炒时蔬', sales: 10, daysSinceLastSale: 20, inventory: 35 },\\n  { dishName: '凉拌木耳', sales: 8, daysSinceLastSale: 18, inventory: 30 },\\n  { dishName: '素炒土豆丝', sales: 6, daysSinceLastSale: 15, inventory: 25 }\\n])\\n\\nconst newDishes = ref<NewDish[]>([\\n  { dishName: '香辣蟹', launchDate: '2024-12-01', sales: 180, rating: 4.7, status: 'hot' },\\n  { dishName: '水煮鱼', launchDate: '2024-12-05', sales: 150, rating: 4.6, status: 'hot' },\\n  { dishName: '干锅花菜', launchDate: '2024-12-10', sales: 95, rating: 4.4, status: 'normal' },\\n  { dishName: '蒜蓉粉丝蒸扇贝', launchDate: '2024-12-15', sales: 45, rating: 4.5, status: 'normal' },\\n  { dishName: '椒盐虾', launchDate: '2024-12-20', sales: 25, rating: 4.3, status: 'cold' }\\n])\\n\\nconst menuOptimizationSuggestions = ref<MenuOptimizationSuggestion[]>([\\n  {\\n    title: '下架滞销菜品',\\n    type: 'warning',\\n    description: '建议下架凉拌黄瓜、素炒豆芽等5款滞销菜品，可减少库存积压约¥2,500',\\n    impact: 3.2\\n  },\\n  {\\n    title: '推出春季特色菜品',\\n    type: 'success',\\n    description: '根据季节性需求，建议推出春笋炒肉、香椿炒蛋等春季特色菜品',\\n    impact: 8.5\\n  },\\n  {\\n    title: '调整热销菜品价格',\\n    type: 'info',\\n    description: '红烧肉、宫保鸡丁等热销菜品可适当提价3-5%，预计增加收入¥3,800',\\n    impact: 5.2\\n  },\\n  {\\n    title: '优化菜单结构',\\n    type: 'success',\\n    description: '增加凉菜和饮品品类，丰富菜单选择，提升客单价',\\n    impact: 6.8\\n  }\\n])\\n\\nconst optimizationRecommendations = ref<OptimizationRecommendation[]>([\\n  {\\n    type: 'remove',\\n    dishName: '凉拌黄瓜',\\n    reason: '近30天仅售15份，库存积压严重',\\n    potentialImpact: 2.5,\\n    confidence: 85\\n  },\\n  {\\n    type: 'price_up',\\n    dishName: '红烧肉',\\n    reason: '热销菜品，价格弹性低，可适当提价',\\n    potentialImpact: 3.2,\\n    confidence: 78\\n  },\\n  {\\n    type: 'promote',\\n    dishName: '香辣蟹',\\n    reason: '新菜品表现优秀，建议加大推广',\\n    potentialImpact: 5.8,\\n    confidence: 82\\n  },\\n  {\\n    type: 'bundle',\\n    dishName: '宫保鸡丁+米饭',\\n    reason: '组合套餐可提升客单价',\\n    potentialImpact: 4.5,\\n    confidence: 75\\n  },\\n  {\\n    type: 'new',\\n    dishName: '春笋炒肉',\\n    reason: '春季特色菜品，符合季节需求',\\n    potentialImpact: 6.2,\\n    confidence: 80\\n  }\\n])\\n\\nconst starDishes = ref<StarDish[]>([\\n  { dishName: '红烧肉', marketShare: 12.5, growthRate: 8.5 },\\n  { dishName: '宫保鸡丁', marketShare: 10.8, growthRate: 7.2 },\\n  { dishName: '清蒸鱼', marketShare: 9.5, growthRate: 9.8 },\\n  { dishName: '香辣蟹', marketShare: 5.2, growthRate: 15.6 }\\n])\\n\\nconst problemDishes = ref<StarDish[]>([\\n  { dishName: '凉拌黄瓜', marketShare: 0.8, growthRate: -15.2 },\\n  { dishName: '素炒豆芽', marketShare: 0.6, growthRate: -12.8 },\\n  { dishName: '清炒时蔬', marketShare: 0.5, growthRate: -10.5 },\\n  { dishName: '椒盐虾', marketShare: 0.3, growthRate: -8.2 }\\n])\\n\\nconst initCategorySalesChart = () => {\\n  if (!categorySalesChart.value) return\\n  \\n  const chart = echarts.init(categorySalesChart.value)\\n  const option = {\\n    tooltip: {\\n      trigger: 'axis',\\n      axisPointer: {\\n        type: 'shadow'\\n      }\\n    },\\n    grid: {\\n      left: '3%',\\n      right: '4%',\\n      bottom: '3%',\\n      containLabel: true\\n    },\\n    xAxis: {\\n      type: 'value'\\n    },\\n    yAxis: {\\n      type: 'category',\\n      data: ['甜点', '饮品', '汤品', '凉菜', '主食', '热菜']\\n    },\\n    series: [\\n      {\\n        name: '销量',\\n        type: 'bar',\\n        data: [520, 680, 920, 850, 1250, 1580],\\n        itemStyle: {\\n          color: new echarts.graphic.LinearGradient(1, 0, 0, 0, [\\n            { offset: 0, color: '#83bff6' },\\n            { offset: 0.5, color: '#188df0' },\\n            { offset: 1, color: '#188df0' }\\n          ])\\n        }\\n      }\\n    ]\\n  }\\n  chart.setOption(option)\\n}\\n\\nconst initRatingChart = () => {\\n  if (!ratingChart.value) return\\n  \\n  const chart = echarts.init(ratingChart.value)\\n  const option = {\\n    tooltip: {\\n      trigger: 'item',\\n      formatter: '{b}: {c}个'\\n    },\\n    series: [\\n      {\\n        name: '评分分布',\\n        type: 'pie',\\n        radius: ['40%', '70%'],\\n        data: [\\n          { value: 320, name: '5星', itemStyle: { color: '#67C23A' } },\\n          { value: 480, name: '4星', itemStyle: { color: '#409EFF' } },\\n          { value: 150, name: '3星', itemStyle: { color: '#E6A23C' } },\\n          { value: 35, name: '2星', itemStyle: { color: '#F56C6C' } },\\n          { value: 15, name: '1星', itemStyle: { color: '#909399' } }\\n        ],\\n        emphasis: {\\n          itemStyle: {\\n            shadowBlur: 10,\\n            shadowOffsetX: 0,\\n            shadowColor: 'rgba(0, 0, 0, 0.5)'\\n          }\\n        }\\n      }\\n    ]\\n  }\\n  chart.setOption(option)\\n}\\n\\nconst initRepurchaseChart = () => {\\n  if (!repurchaseChart.value) return\\n  \\n  const chart = echarts.init(repurchaseChart.value)\\n  const option = {\\n    tooltip: {\\n      trigger: 'axis'\\n    },\\n    grid: {\\n      left: '3%',\\n      right: '4%',\\n      bottom: '3%',\\n      containLabel: true\\n    },\\n    xAxis: {\\n      type: 'category',\\n      data: ['红烧肉', '宫保鸡丁', '麻婆豆腐', '清蒸鱼', '糖醋排骨']\\n    },\\n    yAxis: {\\n      type: 'value',\\n      max: 100,\\n      axisLabel: {\\n        formatter: '{value}%'\\n      }\\n    },\\n    series: [\\n      {\\n        name: '复购率',\\n        type: 'bar',\\n        data: [65, 58, 52, 48, 45],\\n        itemStyle: {\\n          color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [\\n            { offset: 0, color: '#67C23A' },\\n            { offset: 0.5, color: '#95d475' },\\n            { offset: 1, color: '#b3e19d' }\\n          ])\\n        }\\n      }\\n    ]\\n  }\\n  chart.setOption(option)\\n}\\n\\nconst initCategoryMarginChart = () => {\\n  if (!categoryMarginChart.value) return\\n  \\n  const chart = echarts.init(categoryMarginChart.value)\\n  const option = {\\n    tooltip: {\\n      trigger: 'axis',\\n      axisPointer: {\\n        type: 'shadow'\\n      }\\n    },\\n    grid: {\\n      left: '3%',\\n      right: '4%',\\n      bottom: '3%',\\n      containLabel: true\\n    },\\n    xAxis: {\\n      type: 'category',\\n      data: ['凉菜', '汤品', '主食', '热菜', '饮品', '甜点']\\n    },\\n    yAxis: {\\n      type: 'value',\\n      max: 100,\\n      axisLabel: {\\n        formatter: '{value}%'\\n      }\\n    },\\n    series: [\\n      {\\n        name: '毛利率',\\n        type: 'bar',\\n        data: [72, 68, 58, 52, 65, 75],\\n        itemStyle: {\\n          color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [\\n            { offset: 0, color: '#E6A23C' },\\n            { offset: 0.5, color: '#f0c78a' },\\n            { offset: 1, color: '#f3d19e' }\\n          ])\\n        }\\n      }\\n    ]\\n  }\\n  chart.setOption(option)\\n}\\n\\nconst initCostStructureChart = () => {\\n  if (!costStructureChart.value) return\\n  \\n  const chart = echarts.init(costStructureChart.value)\\n  const option = {\\n    tooltip: {\\n      trigger: 'item',\\n      formatter: '{b}: ¥{c} ({d}%)'\\n    },\\n    legend: {\\n      orient: 'vertical',\\n      left: 'left'\\n    },\\n    series: [\\n      {\\n        name: '成本结构',\\n        type: 'pie',\\n        radius: ['40%', '70%'],\\n        data: [\\n          { value: 45000, name: '食材成本', itemStyle: { color: '#F56C6C' } },\\n          { value: 18000, name: '人工成本', itemStyle: { color: '#409EFF' } },\\n          { value: 12000, name: '租金成本', itemStyle: { color: '#67C23A' } },\\n          { value: 8000, name: '水电成本', itemStyle: { color: '#E6A23C' } },\\n          { value: 5000, name: '其他成本', itemStyle: { color: '#909399' } }\\n        ],\\n        emphasis: {\\n          itemStyle: {\\n            shadowBlur: 10,\\n            shadowOffsetX: 0,\\n            shadowColor: 'rgba(0, 0, 0, 0.5)'\\n          }\\n        }\\n      }\\n    ]\\n  }\\n  chart.setOption(option)\\n}\\n\\nconst initPriceElasticityChart = () => {\\n  if (!priceElasticityChart.value) return\\n  \\n  const chart = echarts.init(priceElasticityChart.value)\\n  const option = {\\n    tooltip: {\\n      trigger: 'axis'\\n    },\\n    legend: {\\n      data: ['价格', '销量']\\n    },\\n    grid: {\\n      left: '3%',\\n      right: '4%',\\n      bottom: '3%',\\n      containLabel: true\\n    },\\n    xAxis: {\\n      type: 'category',\\n      data: ['1月', '2月', '3月', '4月', '5月', '6月']\\n    },\\n    yAxis: [\\n      {\\n        type: 'value',\\n        name: '价格',\\n        position: 'left',\\n        axisLabel: {\\n          formatter: '¥{value}'\\n        }\\n      },\\n      {\\n        type: 'value',\\n        name: '销量',\\n        position: 'right'\\n      }\\n    ],\\n    series: [\\n      {\\n        name: '价格',\\n        type: 'line',\\n        smooth: true,\\n        data: [50, 50, 52, 51, 53, 52],\\n        itemStyle: { color: '#F56C6C' }\\n      },\\n      {\\n        name: '销量',\\n        type: 'line',\\n        smooth: true,\\n        yAxisIndex: 1,\\n        data: [480, 495, 470, 485, 460, 475],\\n        itemStyle: { color: '#409EFF' }\\n      }\\n    ]\\n  }\\n  chart.setOption(option)\\n}\\n\\nconst initBcgMatrixChart = () => {\\n  if (!bcgMatrixChart.value) return\\n  \\n  const chart = echarts.init(bcgMatrixChart.value)\\n  const data = [\\n    [12.5, 8.5, '红烧肉'],\\n    [10.8, 7.2, '宫保鸡丁'],\\n    [9.5, 9.8, '清蒸鱼'],\\n    [5.2, 15.6, '香辣蟹'],\\n    [0.8, -15.2, '凉拌黄瓜'],\\n    [0.6, -12.8, '素炒豆芽'],\\n    [8.5, 3.2, '糖醋排骨'],\\n    [6.8, 2.5, '麻婆豆腐']\\n  ]\\n  \\n  const option = {\\n    tooltip: {\\n      trigger: 'item',\\n      formatter: (params: any) => {\\n        return `${params.data[2]}<br/>市场份额: ${params.data[0]}%<br/>增长率: ${params.data[1]}%`\\n      }\\n    },\\n    grid: {\\n      left: '3%',\\n      right: '7%',\\n      bottom: '3%',\\n      containLabel: true\\n    },\\n    xAxis: {\\n      name: '市场份额',\\n      nameLocation: 'middle',\\n      nameGap: 30,\\n      type: 'value',\\n      splitLine: {\\n        show: false\\n      }\\n    },\\n    yAxis: {\\n      name: '增长率',\\n      nameLocation: 'middle',\\n      nameGap: 40,\\n      type: 'value',\\n      splitLine: {\\n        show: false\\n      }\\n    },\\n    series: [\\n      {\\n        name: 'BCG矩阵',\\n        type: 'scatter',\\n        data: data,\\n        symbolSize: (data: number[]) => {\\n          return Math.sqrt(data[0] * 10) * 8\\n        },\\n        itemStyle: (params: any) => {\\n          const growth = params.data[1]\\n          if (growth > 10) return { color: '#67C23A' }\\n          if (growth > 0) return { color: '#409EFF' }\\n          return { color: '#F56C6C' }\\n        },\\n        label: {\\n          show: true,\\n          position: 'top',\\n          formatter: (params: any) => params.data[2]\\n        }\\n      }\\n    ]\\n  }\\n  chart.setOption(option)\\n}\\n\\nconst getRecommendationTypeText = (type: string) => {\\n  const typeMap: Record<string, string> = {\\n    remove: '下架',\\n    price_up: '提价',\\n    promote: '推广',\\n    bundle: '套餐',\\n    new: '上新'\\n  }\\n  return typeMap[type] || type\\n}\\n\\nconst getRecommendationTypeColor = (type: string) => {\\n  const typeMap: Record<string, any> = {\\n    remove: 'danger',\\n    price_up: 'warning',\\n    promote: 'success',\\n    bundle: 'primary',\\n    new: 'info'\\n  }\\n  return typeMap[type] || ''\\n}\\n\\nconst handleRemoveDish = async (row: SlowMovingDish) => {\\n  try {\\n    await ElMessageBox.confirm(\\n      `确定要下架菜品\\\"${row.dishName}\\\"吗？`,\\n      '确认下架',\\n      {\\n        confirmButtonText: '确定',\\n        cancelButtonText: '取消',\\n        type: 'warning'\\n      }\\n    )\\n    ElMessage.success('菜品已下架')\\n  } catch (error) {\\n    if (error !== 'cancel') {\\n      ElMessage.error('操作失败')\\n    }\\n  }\\n}\\n\\nconst handlePromoteDish = async (row: SlowMovingDish) => {\\n  ElMessage.success(`已将\\\"${row.dishName}\\\"加入促销计划`)\\n}\\n\\nconst handleApplyRecommendation = async (row: OptimizationRecommendation) => {\\n  ElMessage.success(`已应用建议：${row.dishName}`)\\n}\\n\\nconst handleIgnoreRecommendation = async (row: OptimizationRecommendation) => {\\n  ElMessage.info(`已忽略建议：${row.dishName}`)\\n}\\n\\nconst handleApplyAllRecommendations = async () => {\\n  try {\\n    await ElMessageBox.confirm(\\n      '确定要应用全部建议吗？',\\n      '确认操作',\\n      {\\n        confirmButtonText: '确定',\\n        cancelButtonText: '取消',\\n        type: 'warning'\\n      }\\n    )\\n    ElMessage.success('已应用全部建议')\\n    showOptimizationDialog.value = false\\n  } catch (error) {\\n    if (error !== 'cancel') {\\n      ElMessage.error('操作失败')\\n    }\\n  }\\n}\\n\\nwatch(viewMode, async (newMode) => {\\n  await nextTick()\\n  \\n  if (newMode === 'performance') {\\n    initCategorySalesChart()\\n    initRatingChart()\\n    initRepurchaseChart()\\n  } else if (newMode === 'profitability') {\\n    initCategoryMarginChart()\\n    initCostStructureChart()\\n  } else if (newMode === 'optimization') {\\n    initPriceElasticityChart()\\n  } else if (newMode === 'matrix') {\\n    initBcgMatrixChart()\\n  }\\n})\\n\\nonMounted(async () => {\\n  await nextTick()\\n  initCategorySalesChart()\\n  initRatingChart()\\n  initRepurchaseChart()\\n})\\n</script>\\n\\n<style scoped lang=\\\"scss\\\">\\n.menu-analytics {\\n  .analytics-header {\\n    display: flex;\\n    justify-content: space-between;\\n    align-items: center;\\n    margin-bottom: 20px;\\n    \\n    .header-title {\\n      h3 {\\n        margin: 0 0 5px 0;\\n        font-size: 20px;\\n        color: #303133;\\n      }\\n      \\n      p {\\n        margin: 0;\\n        font-size: 14px;\\n        color: #909399;\\n      }\\n    }\\n  }\\n\\n  .analytics-content {\\n    .chart-container {\\n      width: 100%;\\n      height: 350px;\\n    }\\n\\n    .large-chart-container {\\n      width: 100%;\\n      height: 500px;\\n    }\\n\\n    .profit-metric-card {\\n      .metric-content {\\n        display: flex;\\n        align-items: center;\\n\\n        .metric-icon {\\n          width: 50px;\\n          height: 50px;\\n          border-radius: 8px;\\n          display: flex;\\n          align-items: center;\\n          justify-content: center;\\n          color: white;\\n          margin-right: 15px;\\n        }\\n\\n        .metric-info {\\n          flex: 1;\\n\\n          .metric-value {\\n            font-size: 24px;\\n            font-weight: bold;\\n            color: #303133;\\n            margin-bottom: 5px;\\n          }\\n\\n          .metric-label {\\n            font-size: 14px;\\n            color: #606266;\\n            margin-bottom: 5px;\\n          }\\n\\n          .metric-change {\\n            font-size: 12px;\\n\\n            &.positive {\\n              color: #67c23a;\\n            }\\n\\n            &.negative {\\n              color: #f56c6c;\\n            }\\n          }\\n        }\\n      }\\n    }\\n\\n    .optimization-suggestions {\\n      .suggestion-content {\\n        .suggestion-title {\\n          font-size: 16px;\\n          font-weight: bold;\\n          color: #303133;\\n          margin-bottom: 8px;\\n        }\\n\\n        .suggestion-description {\\n          font-size: 14px;\\n          color: #606266;\\n          margin-bottom: 8px;\\n        }\\n\\n        .suggestion-impact {\\n          font-size: 14px;\\n\\n          .impact-label {\\n            color: #909399;\\n            margin-right: 8px;\\n          }\\n\\n          .positive {\\n            color: #67c23a;\\n            font-weight: bold;\\n          }\\n\\n          .negative {\\n            color: #f56c6c;\\n            font-weight: bold;\\n          }\\n        }\\n      }\\n    }\\n\\n    .positive {\\n      color: #67c23a;\\n    }\\n\\n    .negative {\\n      color: #f56c6c;\\n    }\\n  }\\n}\\n</style>\\n\",\"originTextLength\":30967,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768858989330}]",
