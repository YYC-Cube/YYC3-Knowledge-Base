<el-option label=\\\\\\\"成功\\\\\\\" value=\\\\\\\"success\\\\\\\" />\\\\n              <el-option label=\\\\\\\"失败\\\\\\\" value=\\\\\\\"failure\\\\\\\" />\\\\n            </el-select>\\\\n            \\\\n            <el-date-picker\\\\n              v-model=\\\\\\\"dateRange\\\\\\\"\\\\n              type=\\\\\\\"datetimerange\\\\\\\"\\\\n              range-separator=\\\\\\\"至\\\\\\\"\\\\n              start-placeholder=\\\\\\\"开始时间\\\\\\\"\\\\n              end-placeholder=\\\\\\\"结束时间\\\\\\\"\\\\n              style=\\\\\\\"margin-left: 10px;\\\\\\\"\\\\n              @change=\\\\\\\"handleDateRangeChange\\\\\\\"\\\\n            />\\\\n          </div>\\\\n          \\\\n          <div class=\\\\\\\"toolbar-right\\\\\\\">\\\\n            <el-button @click=\\\\\\\"handleReset\\\\\\\">\\\\n              <el-icon><Refresh /></el-icon>\\\\n              重置\\\\n            </el-button>\\\\n          </div>\\\\n        </div>\\\\n        \\\\n        <el-table :data=\\\\\\\"auditLogs\\\\\\\" :loading=\\\\\\\"loading\\\\\\\" border>\\\\n          <el-table-column prop=\\\\\\\"username\\\\\\\" label=\\\\\\\"用户名\\\\\\\" />\\\\n          <el-table-column prop=\\\\\\\"action\\\\\\\" label=\\\\\\\"操作\\\\\\\" />\\\\n          <el-table-column prop=\\\\\\\"module\\\\\\\" label=\\\\\\\"模块\\\\\\\" />\\\\n          <el-table-column prop=\\\\\\\"resource\\\\\\\" label=\\\\\\\"资源\\\\\\\" />\\\\n          <el-table-column prop=\\\\\\\"status\\\\\\\" label=\\\\\\\"状态\\\\\\\">\\\\n            <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n              <el-tag :type=\\\\\\\"getAuditLogStatusType(row.status)\\\\\\\" size=\\\\\\\"small\\\\\\\">\\\\n                {{ getAuditLogStatusLabel(row.status) }}\\\\n              </el-tag>\\\\n            </template>\\\\n          </el-table-column>\\\\n          <el-table-column prop=\\\\\\\"ip\\\\\\\" label=\\\\\\\"IP地址\\\\\\\" />\\\\n          <el-table-column prop=\\\\\\\"createdAt\\\\\\\" label=\\\\\\\"操作时间\\\\\\\">\\\\n            <template #default=\\\\\\\"{ row }\\\\\\\">\\\\n              {{ formatDate(row.createdAt) }}\\\\n            </template>\\\\n          </el-table-column>\\\\n        </el-table>\\\\n        \\\\n        <div class=\\\\\\\"pagination\\\\\\\">\\\\n          <el-pagination\\\\n            v-model:current-page=\\\\\\\"pagination.page\\\\\\\"\\\\n            v-model:page-size=\\\\\\\"pagination.pageSize\\\\\\\"\\\\n            :total=\\\\\\\"pagination.total\\\\\\\"\\\\n            :page-sizes=\\\\\\\"[10, 20, 50, 100]\\\\\\\"\\\\n            layout=\\\\\\\"total, sizes, prev, pager, next, jumper\\\\\\\"\\\\n            @size-change=\\\\\\\"handlePageSizeChange\\\\\\\"\\\\n            @current-change=\\\\\\\"handlePageChange\\\\\\\"\\\\n          />\\\\n        </div>\\\\n      </el-card>\\\\n    </div>\\\\n\\\\n    <!-- 用户对话框 -->\\\\n    <el-dialog\\\\n      v-model=\\\\\\\"showUserDialog\\\\\\\"\\\\n      :title=\\\\\\\"userDialogType === \\\\'create\\\\' ? \\\\'新增用户\\\\' : \\\\'编辑用户\\\\'\\\\\\\"\\\\n      width=\\\\\\\"600px\\\\\\\"\\\\n    >\\\\n      <el-form :model=\\\\\\\"userForm\\\\\\\" label-width=\\\\\\\"100px\\\\\\\">\\\\n        <el-form-item label=\\\\\\\"用户名\\\\\\\" required>\\\\n          <el-input v-model=\\\\\\\"userForm.username\\\\\\\" placeholder=\\\\\\\"请输入用户名\\\\\\\" />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"真实姓名\\\\\\\" required>\\\\n          <el-input v-model=\\\\\\\"userForm.realName\\\\\\\" placeholder=\\\\\\\"请输入真实姓名\\\\\\\" />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"邮箱\\\\\\\" required>\\\\n          <el-input v-model=\\\\\\\"userForm.email\\\\\\\" placeholder=\\\\\\\"请输入邮箱\\\\\\\" />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"手机号\\\\\\\" required>\\\\n          <el-input v-model=\\\\\\\"userForm.phone\\\\\\\" placeholder=\\\\\\\"请输入手机号\\\\\\\" />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"密码\\\\\\\" :required=\\\\\\\"userDialogType === \\\\'create\\\\'\\\\\\\">\\\\n          <el-input v-model=\\\\\\\"userForm.password\\\\\\\" type=\\\\\\\"password\\\\\\\" placeholder=\\\\\\\"请输入密码\\\\\\\" />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"部门\\\\\\\">\\\\n          <el-select v-model=\\\\\\\"userForm.departmentId\\\\\\\" placeholder=\\\\\\\"请选择部门\\\\\\\">\\\\n            <el-option \\\\n              v-for=\\\\\\\"department in departments\\\\\\\" \\\\n              :key=\\\\\\\"department.id\\\\\\\" \\\\n              :label=\\\\\\\"department.name\\\\\\\" \\\\n              :value=\\\\\\\"department.id\\\\\\\" \\\\n            />\\\\n          </el-select>\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"角色\\\\\\\" required>\\\\n          <el-select v-model=\\\\\\\"userForm.roleIds\\\\\\\" multiple placeholder=\\\\\\\"请选择角色\\\\\\\">\\\\n            <el-option \\\\n              v-for=\\\\\\\"role in roles\\\\\\\" \\\\n              :key=\\\\\\\"role.id\\\\\\\" \\\\n              :label=\\\\\\\"role.name\\\\\\\" \\\\n              :value=\\\\\\\"role.id\\\\\\\" \\\\n            />\\\\n          </el-select>\\\\n        </el-form-item>\\\\n      </el-form>\\\\n      <template #footer>\\\\n        <el-button @click=\\\\\\\"showUserDialog = false\\\\\\\">取消</el-button>\\\\n        <el-button type=\\\\\\\"primary\\\\\\\" @click=\\\\\\\"confirmUser\\\\\\\">确认</el-button>\\\\n      </template>\\\\n    </el-dialog>\\\\n\\\\n    <!-- 角色对话框 -->\\\\n    <el-dialog\\\\n      v-model=\\\\\\\"showRoleDialog\\\\\\\"\\\\n      :title=\\\\\\\"roleDialogType === \\\\'create\\\\' ? \\\\'新增角色\\\\' : \\\\'编辑角色\\\\'\\\\\\\"\\\\n      width=\\\\\\\"600px\\\\\\\"\\\\n    >\\\\n      <el-form :model=\\\\\\\"roleForm\\\\\\\" label-width=\\\\\\\"100px\\\\\\\">\\\\n        <el-form-item label=\\\\\\\"角色名称\\\\\\\" required>\\\\n          <el-input v-model=\\\\\\\"roleForm.name\\\\\\\" placeholder=\\\\\\\"请输入角色名称\\\\\\\" />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"角色编码\\\\\\\" required>\\\\n          <el-input v-model=\\\\\\\"roleForm.code\\\\\\\" placeholder=\\\\\\\"请输入角色编码\\\\\\\" />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"描述\\\\\\\">\\\\n          <el-input v-model=\\\\\\\"roleForm.description\\\\\\\" type=\\\\\\\"textarea\\\\\\\" :rows=\\\\\\\"3\\\\\\\" placeholder=\\\\\\\"请输入描述\\\\\\\" />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"权限\\\\\\\">\\\\n          <el-tree\\\\n            :data=\\\\\\\"permissionTree\\\\\\\"\\\\n            :props=\\\\\\\"{ children: \\\\'children\\\\', label: \\\\'name\\\\' }\\\\\\\"\\\\n            show-checkbox\\\\n            node-key=\\\\\\\"id\\\\\\\"\\\\n            v-model=\\\\\\\"roleForm.permissions\\\\\\\"\\\\n          />\\\\n        </el-form-item>\\\\n      </el-form>\\\\n      <template #footer>\\\\n        <el-button @click=\\\\\\\"showRoleDialog = false\\\\\\\">取消</el-button>\\\\n        <el-button type=\\\\\\\"primary\\\\\\\" @click=\\\\\\\"confirmRole\\\\\\\">确认</el-button>\\\\n      </template>\\\\n    </el-dialog>\\\\n\\\\n    <!-- 部门对话框 -->\\\\n    <el-dialog\\\\n      v-model=\\\\\\\"showDepartmentDialog\\\\\\\"\\\\n      :title=\\\\\\\"departmentDialogType === \\\\'create\\\\' ? \\\\'新增部门\\\\' : \\\\'编辑部门\\\\'\\\\\\\"\\\\n      width=\\\\\\\"600px\\\\\\\"\\\\n    >\\\\n      <el-form :model=\\\\\\\"departmentForm\\\\\\\" label-width=\\\\\\\"100px\\\\\\\">\\\\n        <el-form-item label=\\\\\\\"部门名称\\\\\\\" required>\\\\n          <el-input v-model=\\\\\\\"departmentForm.name\\\\\\\" placeholder=\\\\\\\"请输入部门名称\\\\\\\" />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"部门编码\\\\\\\" required>\\\\n          <el-input v-model=\\\\\\\"departmentForm.code\\\\\\\" placeholder=\\\\\\\"请输入部门编码\\\\\\\" />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"上级部门\\\\\\\">\\\\n          <el-select v-model=\\\\\\\"departmentForm.parentId\\\\\\\" placeholder=\\\\\\\"请选择上级部门\\\\\\\">\\\\n            <el-option \\\\n              v-for=\\\\\\\"department in departments\\\\\\\" \\\\n              :key=\\\\\\\"department.id\\\\\\\" \\\\n              :label=\\\\\\\"department.name\\\\\\\" \\\\n              :value=\\\\\\\"department.id\\\\\\\" \\\\n            />\\\\n          </el-select>\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"部门负责人\\\\\\\">\\\\n          <el-select v-model=\\\\\\\"departmentForm.leaderId\\\\\\\" placeholder=\\\\\\\"请选择部门负责人\\\\\\\">\\\\n            <el-option \\\\n              v-for=\\\\\\\"user in users\\\\\\\" \\\\n              :key=\\\\\\\"user.id\\\\\\\" \\\\n              :label=\\\\\\\"user.realName\\\\\\\" \\\\n              :value=\\\\\\\"user.id\\\\\\\" \\\\n            />\\\\n          </el-select>\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"描述\\\\\\\">\\\\n          <el-input v-model=\\\\\\\"departmentForm.description\\\\\\\" type=\\\\\\\"textarea\\\\\\\" :rows=\\\\\\\"3\\\\\\\" placeholder=\\\\\\\"请输入描述\\\\\\\" />\\\\n        </el-form-item>\\\\n        <el-form-item label=\\\\\\\"排序\\\\\\\">\\\\n          <el-input-number v-model=\\\\\\\"departmentForm.sort\\\\\\\" :min=\\\\\\\"0\\\\\\\" />\\\\n        </el-form-item>\\\\n      </el-form>\\\\n      <template #footer>\\\\n        <el-button @click=\\\\\\\"showDepartmentDialog = false\\\\\\\">取消</el-button>\\\\n        <el-button type=\\\\\\\"primary\\\\\\\" @click=\\\\\\\"confirmDepartment\\\\\\\">确认</el-button>\\\\n      </template>\\\\n    </el-dialog>\\\\n  </div>\\\\n</template>\\\\n\\\\n<script setup lang=\\\\\\\"ts\\\\\\\">\\\\nimport { ref, computed, onMounted } from \\\\'vue\\\\'\\\\nimport { \\\\n  User, \\\\n  UserFilled, \\\\n  OfficeBuilding, \\\\n  Tools, \\\\n  Document, \\\\n  Plus, \\\\n  Search, \\\\n  Refresh, \\\\n  Download \\\\n} from \\\\'@element-plus/icons-vue\\\\'\\\\nimport { useSystemManagement } from \\\\'@/composables/useSystemManagement\\\\'\\\\nimport { systemManagementApi } from \\\\'@/api/system-management\\\\'\\\\n\\\\nconst {\\\\n  loading,\\\\n  activeTab,\\\\n  users,\\\\n  roles,\\\\n  departments,\\\\n  settings,\\\\n  auditLogs,\\\\n  showUserDialog,\\\\n  showRoleDialog,\\\\n  showDepartmentDialog,\\\\n  userDialogType,\\\\n  roleDialogType,\\\\n  departmentDialogType,\\\\n  userForm,\\\\n  roleForm,\\\\n  departmentForm,\\\\n  pagination,\\\\n  filters,\\\\n  statistics,\\\\n  loadUsers,\\\\n  loadRoles,\\\\n  loadDepartments,\\\\n  loadSettings,\\\\n  loadAuditLogs,\\\\n  loadStatistics,\\\\n  handleAddUser,\\\\n  handleEditUser,\\\\n  handleDeleteUser,\\\\n  handleResetPassword,\\\\n  handleLockUser,\\\\n  handleUnlockUser,\\\\n  confirmUser,\\\\n  handleAddRole,\\\\n  handleEditRole,\\\\n  handleDeleteRole,\\\\n  confirmRole,\\\\n  handleAddDepartment,\\\\n  handleEditDepartment,\\\\n  handleDeleteDepartment,\\\\n  confirmDepartment,\\\\n  handleUpdateSetting,\\\\n  exportAuditLogs,\\\\n  handlePageChange,\\\\n  handlePageSizeChange,\\\\n  handleSearch,\\\\n  handleReset,\\\\n  formatDate,\\\\n  getUserStatusType,\\\\n  getRoleStatusType,\\\\n  getDepartmentStatusType,\\\\n  getAuditLogStatusType\\\\n} = useSystemManagement()\\\\n\\\\nconst dateRange = ref<[Date, Date] | null>(null)\\\\nconst permissionTree = ref<any[]>([])\\\\n\\\\nconst getDepartmentName = (departmentId?: string): string => {\\\\n  if (!departmentId) return \\\\'-\\\\'\\\\n  const department = departments.value.find(d => d.id === departmentId)\\\\n  return department ? department.name : \\\\'-\\\\'\\\\n}\\\\n\\\\nconst getRoleName = (roleId: string): string => {\\\\n  const role = roles.value.find(r => r.id === roleId)\\\\n  return role ? role.name : \\\\'-\\\\'\\\\n}\\\\n\\\\nconst getUserName = (userId?: string): string => {\\\\n  if (!userId) return \\\\'-\\\\'\\\\n  const user = users.value.find(u => u.id === userId)\\\\n  return user ? user.realName : \\\\'-\\\\'\\\\n}\\\\n\\\\nconst getUserStatusLabel = (status: string): string => {\\\\n  const labels: Record<string, string> = {\\\\n    active: \\\\'活跃\\\\',\\\\n    inactive: \\\\'未激活\\\\',\\\\n    locked: \\\\'锁定\\\\'\\\\n  }\\\\n  return labels[status] || status\\\\n}\\\\n\\\\nconst getRoleStatusLabel = (status: string): string => {\\\\n  const labels: Record<string, string> = {\\\\n    active: \\\\'活跃\\\\',\\\\n    inactive: \\\\'未激活\\\\'\\\\n  }\\\\n  return labels[status] || status\\\\n}\\\\n\\\\nconst getDepartmentStatusLabel = (status: string): string => {\\\\n  const labels: Record<string, string> = {\\\\n    active: \\\\'活跃\\\\',\\\\n    inactive: \\\\'未激活\\\\'\\\\n  }\\\\n  return labels[status] || status\\\\n}\\\\n\\\\nconst getAuditLogStatusLabel = (status: string): string => {\\\\n  const labels: Record<string, string> = {\\\\n    success: \\\\'成功\\\\',\\\\n    failure: \\\\'失败\\\\'\\\\n  }\\\\n  return labels[status] || status\\\\n}\\\\n\\\\nconst handleDateRangeChange = () => {\\\\n  if (dateRange.value) {\\\\n    filters.startTime = dateRange.value[0].toISOString()\\\\n    filters.endTime = dateRange.value[1].toISOString()\\\\n  } else {\\\\n    filters.startTime = \\\\'\\\\'\\\\n    filters.endTime = \\\\'\\\\'\\\\n  }\\\\n  handleSearch()\\\\n}\\\\n\\\\nconst loadPermissionTree = async () => {\\\\n  try {\\\\n    const response = await systemManagementApi.getPermissionTree()\\\\n    permissionTree.value = response.data\\\\n  } catch (error) {\\\\n    console.error(\\\\'加载权限树失败:\\\\', error)\\\\n  }\\\\n}\\\\n\\\\nonMounted(() => {\\\\n  loadUsers()\\\\n  loadRoles()\\\\n  loadDepartments()\\\\n  loadSettings()\\\\n  loadAuditLogs()\\\\n  loadStatistics()\\\\n  loadPermissionTree()\\\\n})\\\\n</script>\\\\n\\\\n<style scoped lang=\\\\\\\"scss\\\\\\\">\\\\n.system-management {\\\\n  padding: 20px;\\\\n  background: #f5f7fa;\\\\n  min-height: 100vh;\\\\n}\\\\n\\\\n.management-header {\\\\n  display: flex;\\\\n  justify-content: space-between;\\\\n  align-items: center;\\\\n  margin-bottom: 20px;\\\\n  padding: 20px;\\\\n  background: white;\\\\n  border-radius: 8px;\\\\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);\\\\n\\\\n  .header-left {\\\\n    display: flex;\\\\n    align-items: center;\\\\n    gap: 20px;\\\\n\\\\n    .management-title {\\\\n      margin: 0;\\\\n      font-size: 24px;\\\\n      font-weight: 600;\\\\n      color: #303133;\\\\n    }\\\\n\\\\n    .management-info {\\\\n      display: flex;\\\\n      gap: 10px;\\\\n    }\\\\n  }\\\\n\\\\n  .header-right {\\\\n    display: flex;\\\\n    gap: 10px;\\\\n  }\\\\n}\\\\n\\\\n.users-view,\\\\n.roles-view,\\\\n.departments-view,\\\\n.settings-view,\\\\n.audit-logs-view {\\\\n  margin-top: 20px;\\\\n}\\\\n\\\\n.card-header {\\\\n  display: flex;\\\\n  justify-content: space-between;\\\\n  align-items: center;\\\\n}\\\\n\\\\n.toolbar {\\\\n  display: flex;\\\\n  justify-content: space-between;\\\\n  align-items: center;\\\\n  margin-bottom: 20px;\\\\n  padding: 10px 0;\\\\n\\\\n  .toolbar-left {\\\\n    display: flex;\\\\n    align-items: center;\\\\n    gap: 10px;\\\\n  }\\\\n\\\\n  .toolbar-right {\\\\n    display: flex;\\\\n    gap: 10px;\\\\n  }\\\\n}\\\\n\\\\n.pagination {\\\\n  margin-top: 20px;\\\\n  text-align: right;\\\\n}\\\\n\\\\n@media (max-width: 768px) {\\\\n  .management-header {\\\\n    flex-direction: column;\\\\n    align-items: flex-start;\\\\n\\\\n    .header-left,\\\\n    .header-right {\\\\n      width: 100%;\\\\n      justify-content: center;\\\\n    }\\\\n\\\\n    .management-info {\\\\n      flex-wrap: wrap;\\\\n    }\\\\n  }\\\\n\\\\n  .toolbar {\\\\n    flex-direction: column;\\\\n    align-items: flex-start;\\\\n    gap: 10px;\\\\n\\\\n    .toolbar-left,\\\\n    .toolbar-right {\\\\n      width: 100%;\\\\n      justify-content: center;\\\\n    }\\\\n  }\\\\n}\\\\n</style>\\\\n\",\"originAcceptText\":\"<!--\\n YYC³餐饮管理系统 - 系统管理组件\\n 依托: YYC³系统色设计令牌\\n-->\\n<template>\\n  <div class=\\\"system-management\\\">\\n    <div class=\\\"management-header\\\">\\n      <div class=\\\"header-left\\\">\\n        <h2 class=\\\"management-title\\\">系统管理</h2>\\n        <div class=\\\"management-info\\\">\\n          <el-tag type=\\\"success\\\" size=\\\"small\\\">\\n            <el-icon><User /></el-icon>\\n            用户: {{ statistics?.users.total || 0 }}\\n          </el-tag>\\n          <el-tag type=\\\"primary\\\" size=\\\"small\\\">\\n            <el-icon><UserFilled /></el-icon>\\n            角色: {{ statistics?.roles.total || 0 }}\\n          </el-tag>\\n          <el-tag type=\\\"warning\\\" size=\\\"small\\\">\\n            <el-icon><OfficeBuilding /></el-icon>\\n            部门: {{ statistics?.departments.total || 0 }}\\n          </el-tag>\\n        </div>\\n      </div>\\n      <div class=\\\"header-right\\\">\\n        <el-button-group>\\n          <el-button \\n            :type=\\\"activeTab === 'users' ? 'primary' : 'default'\\\" \\n            @click=\\\"activeTab = 'users'\\\"\\n          >\\n            <el-icon><User /></el-icon>\\n            用户管理\\n          </el-button>\\n          <el-button \\n            :type=\\\"activeTab === 'roles' ? 'primary' : 'default'\\\" \\n            @click=\\\"activeTab = 'roles'\\\"\\n          >\\n            <el-icon><UserFilled /></el-icon>\\n            角色管理\\n          </el-button>\\n          <el-button \\n            :type=\\\"activeTab === 'departments' ? 'primary' : 'default'\\\" \\n            @click=\\\"activeTab = 'departments'\\\"\\n          >\\n            <el-icon><OfficeBuilding /></el-icon>\\n            部门管理\\n          </el-button>\\n          <el-button \\n            :type=\\\"activeTab === 'settings' ? 'primary' : 'default'\\\" \\n            @click=\\\"activeTab = 'settings'\\\"\\n          >\\n            <el-icon><Tools /></el-icon>\\n            系统设置\\n          </el-button>\\n          <el-button \\n            :type=\\\"activeTab === 'audit-logs' ? 'primary' : 'default'\\\" \\n            @click=\\\"activeTab = 'audit-logs'\\\"\\n          >\\n            <el-icon><Document /></el-icon>\\n            审计日志\\n          </el-button>\\n        </el-button-group>\\n      </div>\\n    </div>\\n\\n    <div v-if=\\\"activeTab === 'users'\\\" class=\\\"users-view\\\">\\n      <el-card>\\n        <template #header>\\n          <div class=\\\"card-header\\\">\\n            <span>用户管理</span>\\n            <el-button type=\\\"primary\\\" @click=\\\"handleAddUser\\\">\\n              <el-icon><Plus /></el-icon>\\n              新增用户\\n            </el-button>\\n          </div>\\n        </template>\\n        \\n        <div class=\\\"toolbar\\\">\\n          <div class=\\\"toolbar-left\\\">\\n            <el-input\\n              v-model=\\\"filters.keyword\\\"\\n              placeholder=\\\"搜索用户名/姓名/邮箱...\\\"\\n              clearable\\n              style=\\\"width: 300px;\\\"\\n              @input=\\\"handleSearch\\\"\\n            >\\n              <template #prefix>\\n                <el-icon><Search /></el-icon>\\n              </template>\\n            </el-input>\\n            \\n            <el-select\\n              v-model=\\\"filters.status\\\"\\n              placeholder=\\\"用户状态\\\"\\n              clearable\\n              style=\\\"width: 150px; margin-left: 10px;\\\"\\n              @change=\\\"handleSearch\\\"\\n            >\\n              <el-option label=\\\"活跃\\\" value=\\\"active\\\" />\\n              <el-option label=\\\"未激活\\\" value=\\\"inactive\\\" />\\n              <el-option label=\\\"锁定\\\" value=\\\"locked\\\" />\\n            </el-select>\\n            \\n            <el-select\\n              v-model=\\\"filters.roleId\\\"\\n              placeholder=\\\"角色\\\"\\n              clearable\\n              style=\\\"width: 150px; margin-left: 10px;\\\"\\n              @change=\\\"handleSearch\\\"\\n            >\\n              <el-option \\n                v-for=\\\"role in roles\\\" \\n                :key=\\\"role.id\\\" \\n                :label=\\\"role.name\\\" \\n                :value=\\\"role.id\\\" \\n              />\\n            </el-select>\\n            \\n            <el-select\\n              v-model=\\\"filters.departmentId\\\"\\n              placeholder=\\\"部门\\\"\\n              clearable\\n              style=\\\"width: 150px; margin-left: 10px;\\\"\\n              @change=\\\"handleSearch\\\"\\n            >\\n              <el-option \\n                v-for=\\\"department in departments\\\" \\n                :key=\\\"department.id\\\" \\n                :label=\\\"department.name\\\" \\n                :value=\\\"department.id\\\" \\n              />\\n            </el-select>\\n          </div>\\n          \\n          <div class=\\\"toolbar-right\\\">\\n            <el-button @click=\\\"handleReset\\\">\\n              <el-icon><Refresh /></el-icon>\\n              重置\\n            </el-button>\\n          </div>\\n        </div>\\n        \\n        <el-table :data=\\\"users\\\" :loading=\\\"loading\\\" border>\\n          <el-table-column prop=\\\"username\\\" label=\\\"用户名\\\" />\\n          <el-table-column prop=\\\"realName\\\" label=\\\"真实姓名\\\" />\\n          <el-table-column prop=\\\"email\\\" label=\\\"邮箱\\\" />\\n          <el-table-column prop=\\\"phone\\\" label=\\\"手机号\\\" />\\n          <el-table-column prop=\\\"departmentId\\\" label=\\\"部门\\\">\\n            <template #default=\\\"{ row }\\\">\\n              {{ getDepartmentName(row.departmentId) }}\\n            </template>\\n          </el-table-column>\\n          <el-table-column prop=\\\"roleIds\\\" label=\\\"角色\\\">\\n            <template #default=\\\"{ row }\\\">\\n              <el-tag \\n                v-for=\\\"roleId in row.roleIds\\\" \\n                :key=\\\"roleId\\\" \\n                size=\\\"small\\\" \\n                style=\\\"margin-right: 5px;\\\"\\n              >\\n                {{ getRoleName(roleId) }}\\n              </el-tag>\\n            </template>\\n          </el-table-column>\\n          <el-table-column prop=\\\"status\\\" label=\\\"状态\\\">\\n            <template #default=\\\"{ row }\\\">\\n              <el-tag :type=\\\"getUserStatusType(row.status)\\\" size=\\\"small\\\">\\n                {{ getUserStatusLabel(row.status) }}\\n              </el-tag>\\n            </template>\\n          </el-table-column>\\n          <el-table-column prop=\\\"lastLoginAt\\\" label=\\\"最后登录\\\">\\n            <template #default=\\\"{ row }\\\">\\n              {{ formatDate(row.lastLoginAt) }}\\n            </template>\\n          </el-table-column>\\n          <el-table-column label=\\\"操作\\\" width=\\\"250\\\">\\n            <template #default=\\\"{ row }\\\">\\n              <el-button type=\\\"primary\\\" size=\\\"small\\\" @click=\\\"handleEditUser(row)\\\">\\n                编辑\\n              </el-button>\\n              <el-button \\n                v-if=\\\"row.status !== 'locked'\\\" \\n                type=\\\"warning\\\" \\n                size=\\\"small\\\" \\n                @click=\\\"handleLockUser(row)\\\"\\n              >\\n                锁定\\n              </el-button>\\n              <el-button \\n                v-if=\\\"row.status === 'locked'\\\" \\n                type=\\\"success\\\" \\n                size=\\\"small\\\" \\n                @click=\\\"handleUnlockUser(row)\\\"\\n              >\\n                解锁\\n              </el-button>\\n              <el-button type=\\\"info\\\" size=\\\"small\\\" @click=\\\"handleResetPassword(row)\\\">\\n                重置密码\\n              </el-button>\\n              <el-button type=\\\"danger\\\" size=\\\"small\\\" @click=\\\"handleDeleteUser(row)\\\">\\n                删除\\n              </el-button>\\n            </template>\\n          </el-table-column>\\n        </el-table>\\n        \\n        <div class=\\\"pagination\\\">\\n          <el-pagination\\n            v-model:current-page=\\\"pagination.page\\\"\\n            v-model:page-size=\\\"pagination.pageSize\\\"\\n            :total=\\\"pagination.total\\\"\\n            :page-sizes=\\\"[10, 20, 50, 100]\\\"\\n            layout=\\\"total, sizes, prev, pager, next, jumper\\\"\\n            @size-change=\\\"handlePageSizeChange\\\"\\n            @current-change=\\\"handlePageChange\\\"\\n          />\\n        </div>\\n      </el-card>\\n    </div>\\n\\n    <div v-if=\\\"activeTab === 'roles'\\\" class=\\\"roles-view\\\">\\n      <el-card>\\n        <template #header>\\n          <div class=\\\"card-header\\\">\\n            <span>角色管理</span>\\n            <el-button type=\\\"primary\\\" @click=\\\"handleAddRole\\\">\\n              <el-icon><Plus /></el-icon>\\n              新增角色\\n            </el-button>\\n          </div>\\n        </template>\\n        \\n        <div class=\\\"toolbar\\\">\\n          <div class=\\\"toolbar-left\\\">\\n            <el-input\\n              v-model=\\\"filters.keyword\\\"\\n              placeholder=\\\"搜索角色名/编码...\\\"\\n              clearable\\n              style=\\\"width: 300px;\\\"\\n              @input=\\\"handleSearch\\\"\\n            >\\n              <template #prefix>\\n                <el-icon><Search /></el-icon>\\n              </template>\\n            </el-input>\\n            \\n            <el-select\\n              v-model=\\\"filters.status\\\"\\n              placeholder=\\\"角色状态\\\"\\n              clearable\\n              style=\\\"width: 150px; margin-left: 10px;\\\"\\n              @change=\\\"handleSearch\\\"\\n            >\\n              <el-option label=\\\"活跃\\\" value=\\\"active\\\" />\\n              <el-option label=\\\"未激活\\\" value=\\\"inactive\\\" />\\n            </el-select>\\n          </div>\\n          \\n          <div class=\\\"toolbar-right\\\">\\n            <el-button @click=\\\"handleReset\\\">\\n              <el-icon><Refresh /></el-icon>\\n              重置\\n            </el-button>\\n          </div>\\n        </div>\\n        \\n        <el-table :data=\\\"roles\\\" :loading=\\\"loading\\\" border>\\n          <el-table-column prop=\\\"name\\\" label=\\\"角色名称\\\" />\\n          <el-table-column prop=\\\"code\\\" label=\\\"角色编码\\\" />\\n          <el-table-column prop=\\\"description\\\" label=\\\"描述\\\" />\\n          <el-table-column prop=\\\"status\\\" label=\\\"状态\\\">\\n            <template #default=\\\"{ row }\\\">\\n              <el-tag :type=\\\"getRoleStatusType(row.status)\\\" size=\\\"small\\\">\\n                {{ getRoleStatusLabel(row.status) }}\\n              </el-tag>\\n            </template>\\n          </el-table-column>\\n          <el-table-column prop=\\\"createdAt\\\" label=\\\"创建时间\\\">\\n            <template #default=\\\"{ row }\\\">\\n              {{ formatDate(row.createdAt) }}\\n            </template>\\n          </el-table-column>\\n          <el-table-column label=\\\"操作\\\" width=\\\"200\\\">\\n            <template #default=\\\"{ row }\\\">\\n              <el-button type=\\\"primary\\\" size=\\\"small\\\" @click=\\\"handleEditRole(row)\\\">\\n                编辑\\n              </el-button>\\n              <el-button type=\\\"danger\\\" size=\\\"small\\\" @click=\\\"handleDeleteRole(row)\\\">\\n                删除\\n              </el-button>\\n            </template>\\n          </el-table-column>\\n        </el-table>\\n        \\n        <div class=\\\"pagination\\\">\\n          <el-pagination\\n            v-model:current-page=\\\"pagination.page\\\"\\n            v-model:page-size=\\\"pagination.pageSize\\\"\\n            :total=\\\"pagination.total\\\"\\n            :page-sizes=\\\"[10, 20, 50, 100]\\\"\\n            layout=\\\"total, sizes, prev, pager, next, jumper\\\"\\n            @size-change=\\\"handlePageSizeChange\\\"\\n            @current-change=\\\"handlePageChange\\\"\\n          />\\n        </div>\\n      </el-card>\\n    </div>\\n\\n    <div v-if=\\\"activeTab === 'departments'\\\" class=\\\"departments-view\\\">\\n      <el-card>\\n        <template #header>\\n          <div class=\\\"card-header\\\">\\n            <span>部门管理</span>\\n            <el-button type=\\\"primary\\\" @click=\\\"handleAddDepartment\\\">\\n              <el-icon><Plus /></el-icon>\\n              新增部门\\n            </el-button>\\n          </div>\\n        </template>\\n        \\n        <div class=\\\"toolbar\\\">\\n          <div class=\\\"toolbar-left\\\">\\n            <el-input\\n              v-model=\\\"filters.keyword\\\"\\n              placeholder=\\\"搜索部门名/编码...\\\"\\n              clearable\\n              style=\\\"width: 300px;\\\"\\n              @input=\\\"handleSearch\\\"\\n            >\\n              <template #prefix>\\n                <el-icon><Search /></el-icon>\\n              </template>\\n            </el-input>\\n            \\n            <el-select\\n              v-model=\\\"filters.status\\\"\\n              placeholder=\\\"部门状态\\\"\\n              clearable\\n              style=\\\"width: 150px; margin-left: 10px;\\\"\\n              @change=\\\"handleSearch\\\"\\n            >\\n              <el-option label=\\\"活跃\\\" value=\\\"active\\\" />\\n              <el-option label=\\\"未激活\\\" value=\\\"inactive\\\" />\\n            </el-select>\\n          </div>\\n          \\n          <div class=\\\"toolbar-right\\\">\\n            <el-button @click=\\\"handleReset\\\">\\n              <el-icon><Refresh /></el-icon>\\n              重置\\n            </el-button>\\n          </div>\\n        </div>\\n        \\n        <el-table :data=\\\"departments\\\" :loading=\\\"loading\\\" border>\\n          <el-table-column prop=\\\"name\\\" label=\\\"部门名称\\\" />\\n          <el-table-column prop=\\\"code\\\" label=\\\"部门编码\\\" />\\n          <el-table-column prop=\\\"parentId\\\" label=\\\"上级部门\\\">\\n            <template #default=\\\"{ row }\\\">\\n              {{ getDepartmentName(row.parentId) }}\\n            </template>\\n          </el-table-column>\\n          <el-table-column prop=\\\"leaderId\\\" label=\\\"部门负责人\\\">\\n            <template #default=\\\"{ row }\\\">\\n              {{ getUserName(row.leaderId) }}\\n            </template>\\n          </el-table-column>\\n          <el-table-column prop=\\\"description\\\" label=\\\"描述\\\" />\\n          <el-table-column prop=\\\"status\\\" label=\\\"状态\\\">\\n            <template #default=\\\"{ row }\\\">\\n              <el-tag :type=\\\"getDepartmentStatusType(row.status)\\\" size=\\\"small\\\">\\n                {{ getDepartmentStatusLabel(row.status) }}\\n              </el-tag>\\n            </template>\\n          </el-table-column>\\n          <el-table-column label=\\\"操作\\\" width=\\\"200\\\">\\n            <template #default=\\\"{ row }\\\">\\n              <el-button type=\\\"primary\\\" size=\\\"small\\\" @click=\\\"handleEditDepartment(row)\\\">\\n                编辑\\n              </el-button>\\n              <el-button type=\\\"danger\\\" size=\\\"small\\\" @click=\\\"handleDeleteDepartment(row)\\\">\\n                删除\\n              </el-button>\\n            </template>\\n          </el-table-column>\\n        </el-table>\\n      </el-card>\\n    </div>\\n\\n    <div v-if=\\\"activeTab === 'settings'\\\" class=\\\"settings-view\\\">\\n      <el-card>\\n        <template #header>\\n          <span>系统设置</span>\\n        </template>\\n        \\n        <el-table :data=\\\"settings\\\" :loading=\\\"loading\\\" border>\\n          <el-table-column prop=\\\"key\\\" label=\\\"设置项\\\" />\\n          <el-table-column prop=\\\"description\\\" label=\\\"描述\\\" />\\n          <el-table-column prop=\\\"value\\\" label=\\\"值\\\">\\n            <template #default=\\\"{ row }\\\">\\n              <el-input\\n                v-if=\\\"row.type === 'string'\\\"\\n                v-model=\\\"row.value\\\"\\n                @change=\\\"handleUpdateSetting(row, row.value)\\\"\\n              />\\n              <el-input-number\\n                v-else-if=\\\"row.type === 'number'\\\"\\n                v-model=\\\"row.value\\\"\\n                @change=\\\"handleUpdateSetting(row, row.value.toString())\\\"\\n              />\\n              <el-switch\\n                v-else-if=\\\"row.type === 'boolean'\\\"\\n                v-model=\\\"row.value\\\"\\n                @change=\\\"handleUpdateSetting(row, row.value.toString())\\\"\\n              />\\n              <el-input\\n                v-else-if=\\\"row.type === 'json'\\\"\\n                v-model=\\\"row.value\\\"\\n                type=\\\"textarea\\\"\\n                :rows=\\\"3\\\"\\n                @change=\\\"handleUpdateSetting(row, row.value)\\\"\\n              />\\n            </template>\\n          </el-table-column>\\n          <el-table-column prop=\\\"category\\\" label=\\\"分类\\\" />\\n          <el-table-column prop=\\\"updatedAt\\\" label=\\\"更新时间\\\">\\n            <template #default=\\\"{ row }\\\">\\n              {{ formatDate(row.updatedAt) }}\\n            </template>\\n          </el-table-column>\\n        </el-table>\\n      </el-card>\\n    </div>\\n\\n    <div v-if=\\\"activeTab === 'audit-logs'\\\" class=\\\"audit-logs-view\\\">\\n      <el-card>\\n        <template #header>\\n          <div class=\\\"card-header\\\">\\n            <span>审计日志</span>\\n            <el-button type=\\\"primary\\\" @click=\\\"exportAuditLogs\\\">\\n              <el-icon><Download /></el-icon>\\n              导出日志\\n            </el-button>\\n          </div>\\n        </template>\\n        \\n        <div class=\\\"toolbar\\\">\\n          <div class=\\\"toolbar-left\\\">\\n            <el-input\\n              v-model=\\\"filters.keyword\\\"\\n              placeholder=\\\"搜索用户名...\\\"\\n              clearable\\n              style=\\\"width: 300px;\\\"\\n              @input=\\\"handleSearch\\\"\\n            >\\n              <template #prefix>\\n                <el-icon><Search /></el-icon>\\n              </template>\\n            </el-input>\\n            \\n            <el-select\\n              v-model=\\\"filters.status\\\"\\n              placeholder=\\\"操作状态\\\"\\n              clearable\\n              style=\\\"width: 150px; margin-left: 10px;\\\"\\n              @change=\\\"handleSearch\\\"\\n            >\\n              <el-option label=\\\"成功\\\" value=\\\"success\\\" />\\n              <el-option label=\\\"失败\\\" value=\\\"failure\\\" />\\n            </el-select>\\n            \\n            <el-date-picker\\n              v-model=\\\"dateRange\\\"\\n              type=\\\"datetimerange\\\"\\n              range-separator=\\\"至\\\"\\n              start-placeholder=\\\"开始时间\\\"\\n              end-placeholder=\\\"结束时间\\\"\\n              style=\\\"margin-left: 10px;\\\"\\n              @change=\\\"handleDateRangeChange\\\"\\n            />\\n          </div>\\n          \\n          <div class=\\\"toolbar-right\\\">\\n            <el-button @click=\\\"handleReset\\\">\\n              <el-icon><Refresh /></el-icon>\\n              重置\\n            </el-button>\\n          </div>\\n        </div>\\n        \\n        <el-table :data=\\\"auditLogs\\\" :loading=\\\"loading\\\" border>\\n          <el-table-column prop=\\\"username\\\" label=\\\"用户名\\\" />\\n          <el-table-column prop=\\\"action\\\" label=\\\"操作\\\" />\\n          <el-table-column prop=\\\"module\\\" label=\\\"模块\\\" />\\n          <el-table-column prop=\\\"resource\\\" label=\\\"资源\\\" />\\n          <el-table-column prop=\\\"status\\\" label=\\\"状态\\\">\\n            <template #default=\\\"{ row }\\\">\\n              <el-tag :type=\\\"getAuditLogStatusType(row.status)\\\" size=\\\"small\\\">\\n                {{ getAuditLogStatusLabel(row.status) }}\\n              </el-tag>\\n            </template>\\n          </el-table-column>\\n          <el-table-column prop=\\\"ip\\\" label=\\\"IP地址\\\" />\\n          <el-table-column prop=\\\"createdAt\\\" label=\\\"操作时间\\\">\\n            <template #default=\\\"{ row }\\\">\\n              {{ formatDate(row.createdAt) }}\\n            </template>\\n          </el-table-column>\\n        </el-table>\\n        \\n        <div class=\\\"pagination\\\">\\n          <el-pagination\\n            v-model:current-page=\\\"pagination.page\\\"\\n            v-model:page-size=\\\"pagination.pageSize\\\"\\n            :total=\\\"pagination.total\\\"\\n            :page-sizes=\\\"[10, 20, 50, 100]\\\"\\n            layout=\\\"total, sizes, prev, pager, next, jumper\\\"\\n            @size-change=\\\"handlePageSizeChange\\\"\\n            @current-change=\\\"handlePageChange\\\"\\n          />\\n        </div>\\n      </el-card>\\n    </div>\\n\\n    <!-- 用户对话框 -->\\n    <el-dialog\\n      v-model=\\\"showUserDialog\\\"\\n      :title=\\\"userDialogType === 'create' ? '新增用户' : '编辑用户'\\\"\\n      width=\\\"600px\\\"\\n    >\\n      <el-form :model=\\\"userForm\\\" label-width=\\\"100px\\\">\\n        <el-form-item label=\\\"用户名\\\" required>\\n          <el-input v-model=\\\"userForm.username\\\" placeholder=\\\"请输入用户名\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"真实姓名\\\" required>\\n          <el-input v-model=\\\"userForm.realName\\\" placeholder=\\\"请输入真实姓名\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"邮箱\\\" required>\\n          <el-input v-model=\\\"userForm.email\\\" placeholder=\\\"请输入邮箱\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"手机号\\\" required>\\n          <el-input v-model=\\\"userForm.phone\\\" placeholder=\\\"请输入手机号\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"密码\\\" :required=\\\"userDialogType === 'create'\\\">\\n          <el-input v-model=\\\"userForm.password\\\" type=\\\"password\\\" placeholder=\\\"请输入密码\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"部门\\\">\\n          <el-select v-model=\\\"userForm.departmentId\\\" placeholder=\\\"请选择部门\\\">\\n            <el-option \\n              v-for=\\\"department in departments\\\" \\n              :key=\\\"department.id\\\" \\n              :label=\\\"department.name\\\" \\n              :value=\\\"department.id\\\" \\n            />\\n          </el-select>\\n        </el-form-item>\\n        <el-form-item label=\\\"角色\\\" required>\\n          <el-select v-model=\\\"userForm.roleIds\\\" multiple placeholder=\\\"请选择角色\\\">\\n            <el-option \\n              v-for=\\\"role in roles\\\" \\n              :key=\\\"role.id\\\" \\n              :label=\\\"role.name\\\" \\n              :value=\\\"role.id\\\" \\n            />\\n          </el-select>\\n        </el-form-item>\\n      </el-form>\\n      <template #footer>\\n        <el-button @click=\\\"showUserDialog = false\\\">取消</el-button>\\n        <el-button type=\\\"primary\\\" @click=\\\"confirmUser\\\">确认</el-button>\\n      </template>\\n    </el-dialog>\\n\\n    <!-- 角色对话框 -->\\n    <el-dialog\\n      v-model=\\\"showRoleDialog\\\"\\n      :title=\\\"roleDialogType === 'create' ? '新增角色' : '编辑角色'\\\"\\n      width=\\\"600px\\\"\\n    >\\n      <el-form :model=\\\"roleForm\\\" label-width=\\\"100px\\\">\\n        <el-form-item label=\\\"角色名称\\\" required>\\n          <el-input v-model=\\\"roleForm.name\\\" placeholder=\\\"请输入角色名称\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"角色编码\\\" required>\\n          <el-input v-model=\\\"roleForm.code\\\" placeholder=\\\"请输入角色编码\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"描述\\\">\\n          <el-input v-model=\\\"roleForm.description\\\" type=\\\"textarea\\\" :rows=\\\"3\\\" placeholder=\\\"请输入描述\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"权限\\\">\\n          <el-tree\\n            :data=\\\"permissionTree\\\"\\n            :props=\\\"{ children: 'children', label: 'name' }\\\"\\n            show-checkbox\\n            node-key=\\\"id\\\"\\n            v-model=\\\"roleForm.permissions\\\"\\n          />\\n        </el-form-item>\\n      </el-form>\\n      <template #footer>\\n        <el-button @click=\\\"showRoleDialog = false\\\">取消</el-button>\\n        <el-button type=\\\"primary\\\" @click=\\\"confirmRole\\\">确认</el-button>\\n      </template>\\n    </el-dialog>\\n\\n    <!-- 部门对话框 -->\\n    <el-dialog\\n      v-model=\\\"showDepartmentDialog\\\"\\n      :title=\\\"departmentDialogType === 'create' ? '新增部门' : '编辑部门'\\\"\\n      width=\\\"600px\\\"\\n    >\\n      <el-form :model=\\\"departmentForm\\\" label-width=\\\"100px\\\">\\n        <el-form-item label=\\\"部门名称\\\" required>\\n          <el-input v-model=\\\"departmentForm.name\\\" placeholder=\\\"请输入部门名称\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"部门编码\\\" required>\\n          <el-input v-model=\\\"departmentForm.code\\\" placeholder=\\\"请输入部门编码\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"上级部门\\\">\\n          <el-select v-model=\\\"departmentForm.parentId\\\" placeholder=\\\"请选择上级部门\\\">\\n            <el-option \\n              v-for=\\\"department in departments\\\" \\n              :key=\\\"department.id\\\" \\n              :label=\\\"department.name\\\" \\n              :value=\\\"department.id\\\" \\n            />\\n          </el-select>\\n        </el-form-item>\\n        <el-form-item label=\\\"部门负责人\\\">\\n          <el-select v-model=\\\"departmentForm.leaderId\\\" placeholder=\\\"请选择部门负责人\\\">\\n            <el-option \\n              v-for=\\\"user in users\\\" \\n              :key=\\\"user.id\\\" \\n              :label=\\\"user.realName\\\" \\n              :value=\\\"user.id\\\" \\n            />\\n          </el-select>\\n        </el-form-item>\\n        <el-form-item label=\\\"描述\\\">\\n          <el-input v-model=\\\"departmentForm.description\\\" type=\\\"textarea\\\" :rows=\\\"3\\\" placeholder=\\\"请输入描述\\\" />\\n        </el-form-item>\\n        <el-form-item label=\\\"排序\\\">\\n          <el-input-number v-model=\\\"departmentForm.sort\\\" :min=\\\"0\\\" />\\n        </el-form-item>\\n      </el-form>\\n      <template #footer>\\n        <el-button @click=\\\"showDepartmentDialog = false\\\">取消</el-button>\\n        <el-button type=\\\"primary\\\" @click=\\\"confirmDepartment\\\">确认</el-button>\\n      </template>\\n    </el-dialog>\\n  </div>\\n</template>\\n\\n<script setup lang=\\\"ts\\\">\\nimport { ref, computed, onMounted } from 'vue'\\nimport { \\n  User, \\n  UserFilled, \\n  OfficeBuilding, \\n  Tools, \\n  Document, \\n  Plus, \\n  Search, \\n  Refresh, \\n  Download \\n} from '@element-plus/icons-vue'\\nimport { useSystemManagement } from '@/composables/useSystemManagement'\\nimport { systemManagementApi } from '@/api/system-management'\\n\\nconst {\\n  loading,\\n  activeTab,\\n  users,\\n  roles,\\n  departments,\\n  settings,\\n  auditLogs,\\n  showUserDialog,\\n  showRoleDialog,\\n  showDepartmentDialog,\\n  userDialogType,\\n  roleDialogType,\\n  departmentDialogType,\\n  userForm,\\n  roleForm,\\n  departmentForm,\\n  pagination,\\n  filters,\\n  statistics,\\n  loadUsers,\\n  loadRoles,\\n  loadDepartments,\\n  loadSettings,\\n  loadAuditLogs,\\n  loadStatistics,\\n  handleAddUser,\\n  handleEditUser,\\n  handleDeleteUser,\\n  handleResetPassword,\\n  handleLockUser,\\n  handleUnlockUser,\\n  confirmUser,\\n  handleAddRole,\\n  handleEditRole,\\n  handleDeleteRole,\\n  confirmRole,\\n  handleAddDepartment,\\n  handleEditDepartment,\\n  handleDeleteDepartment,\\n  confirmDepartment,\\n  handleUpdateSetting,\\n  exportAuditLogs,\\n  handlePageChange,\\n  handlePageSizeChange,\\n  handleSearch,\\n  handleReset,\\n  formatDate,\\n  getUserStatusType,\\n  getRoleStatusType,\\n  getDepartmentStatusType,\\n  getAuditLogStatusType\\n} = useSystemManagement()\\n\\nconst dateRange = ref<[Date, Date] | null>(null)\\nconst permissionTree = ref<any[]>([])\\n\\nconst getDepartmentName = (departmentId?: string): string => {\\n  if (!departmentId) return '-'\\n  const department = departments.value.find(d => d.id === departmentId)\\n  return department ? department.name : '-'\\n}\\n\\nconst getRoleName = (roleId: string): string => {\\n  const role = roles.value.find(r => r.id === roleId)\\n  return role ? role.name : '-'\\n}\\n\\nconst getUserName = (userId?: string): string => {\\n  if (!userId) return '-'\\n  const user = users.value.find(u => u.id === userId)\\n  return user ? user.realName : '-'\\n}\\n\\nconst getUserStatusLabel = (status: string): string => {\\n  const labels: Record<string, string> = {\\n    active: '活跃',\\n    inactive: '未激活',\\n    locked: '锁定'\\n  }\\n  return labels[status] || status\\n}\\n\\nconst getRoleStatusLabel = (status: string): string => {\\n  const labels: Record<string, string> = {\\n    active: '活跃',\\n    inactive: '未激活'\\n  }\\n  return labels[status] || status\\n}\\n\\nconst getDepartmentStatusLabel = (status: string): string => {\\n  const labels: Record<string, string> = {\\n    active: '活跃',\\n    inactive: '未激活'\\n  }\\n  return labels[status] || status\\n}\\n\\nconst getAuditLogStatusLabel = (status: string): string => {\\n  const labels: Record<string, string> = {\\n    success: '成功',\\n    failure: '失败'\\n  }\\n  return labels[status] || status\\n}\\n\\nconst handleDateRangeChange = () => {\\n  if (dateRange.value) {\\n    filters.startTime = dateRange.value[0].toISOString()\\n    filters.endTime = dateRange.value[1].toISOString()\\n  } else {\\n    filters.startTime = ''\\n    filters.endTime = ''\\n  }\\n  handleSearch()\\n}\\n\\nconst loadPermissionTree = async () => {\\n  try {\\n    const response = await systemManagementApi.getPermissionTree()\\n    permissionTree.value = response.data\\n  } catch (error) {\\n    console.error('加载权限树失败:', error)\\n  }\\n}\\n\\nonMounted(() => {\\n  loadUsers()\\n  loadRoles()\\n  loadDepartments()\\n  loadSettings()\\n  loadAuditLogs()\\n  loadStatistics()\\n  loadPermissionTree()\\n})\\n</script>\\n\\n<style scoped lang=\\\"scss\\\">\\n.system-management {\\n  padding: 20px;\\n  background: #f5f7fa;\\n  min-height: 100vh;\\n}\\n\\n.management-header {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n  margin-bottom: 20px;\\n  padding: 20px;\\n  background: white;\\n  border-radius: 8px;\\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);\\n\\n  .header-left {\\n    display: flex;\\n    align-items: center;\\n    gap: 20px;\\n\\n    .management-title {\\n      margin: 0;\\n      font-size: 24px;\\n      font-weight: 600;\\n      color: #303133;\\n    }\\n\\n    .management-info {\\n      display: flex;\\n      gap: 10px;\\n    }\\n  }\\n\\n  .header-right {\\n    display: flex;\\n    gap: 10px;\\n  }\\n}\\n\\n.users-view,\\n.roles-view,\\n.departments-view,\\n.settings-view,\\n.audit-logs-view {\\n  margin-top: 20px;\\n}\\n\\n.card-header {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n}\\n\\n.toolbar {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n  margin-bottom: 20px;\\n  padding: 10px 0;\\n\\n  .toolbar-left {\\n    display: flex;\\n    align-items: center;\\n    gap: 10px;\\n  }\\n\\n  .toolbar-right {\\n    display: flex;\\n    gap: 10px;\\n  }\\n}\\n\\n.pagination {\\n  margin-top: 20px;\\n  text-align: right;\\n}\\n\\n@media (max-width: 768px) {\\n  .management-header {\\n    flex-direction: column;\\n    align-items: flex-start;\\n\\n    .header-left,\\n    .header-right {\\n      width: 100%;\\n      justify-content: center;\\n    }\\n\\n    .management-info {\\n      flex-wrap: wrap;\\n    }\\n  }\\n\\n  .toolbar {\\n    flex-direction: column;\\n    align-items: flex-start;\\n    gap: 10px;\\n\\n    .toolbar-left,\\n    .toolbar-right {\\n      width: 100%;\\n      justify-content: center;\\n    }\\n  }\\n}\\n</style>\\n\",\"originTextLength\":27478,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768879176898}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/docs/YYC3-Cater-Platform-%E6%96%87%E6%A1%A3%E9%97%AD%E7%8E%AF/YYC3-Cater-%E9%9C%80%E6%B1%82%E8%AE%BE%E8%AE%A1%E6%96%87%E6%A1%A3/%E7%B3%BB%E7%BB%9F%E7%AE%A1%E7%90%86%E5%8A%9F%E8%83%BD%E6%A8%A1%E5%9D%97%E9%9C%80%E6%B1%82%E5%88%86%E6%9E%90%E4%B8%8E%E8%AE%BE%E8%AE%A1%E6%96%87%E6%A1%A3.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":556,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":556,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# YYC³餐饮管理系统 - 系统管理功能模块需求分析与设计文档\\\\n\\\\n## 文档信息\\\\n\\\\n| 项目 | 内容 |\\\\n|------|------|\\\\n| 文档名称 | 系统管理功能模块需求分析与设计文档 |\\\\n| 文档版本 | V1.0.0 |\\\\n| 创建日期 | 2025-01-20 |\\\\n| 作者 | YYC³团队 |\\\\n| 文档状态 | 正式发布 |\\\\n\\\\n## 1. 概述\\\\n\\\\n### 1.1 模块简介\\\\n\\\\n系统管理模块是YYC³餐饮管理系统的核心管理模块，负责管理系统的用户、角色、权限、部门、系统设置和审计日志等功能。该模块为系统管理员提供完整的系统管理能力，确保系统的安全性、可维护性和可扩展性。\\\\n\\\\n### 1.2 模块目标\\\\n\\\\n- 提供完整的用户生命周期管理\\\\n- 实现灵活的角色和权限管理\\\\n- 支持组织架构的部门管理\\\\n- 提供系统配置和参数管理\\\\n- 记录和审计所有系统操作\\\\n- 确保系统安全和数据完整性\\\\n\\\\n### 1.3 适用范围\\\\n\\\\n本模块适用于YYC³餐饮管理系统的所有版本，包括单店版和连锁版。\\\\n\\\\n## 2. 功能需求\\\\n\\\\n### 2.1 用户管理\\\\n\\\\n#### 2.1.1 用户列表\\\\n\\\\n**功能描述**：展示系统中所有用户的基本信息，支持搜索、筛选和分页。\\\\n\\\\n**输入参数**：\\\\n- 关键词：用户名、真实姓名、邮箱、手机号\\\\n- 用户状态：活跃、未激活、锁定\\\\n- 角色：按角色筛选\\\\n- 部门：按部门筛选\\\\n- 页码：当前页码\\\\n- 每页数量：每页显示数量\\\\n\\\\n**输出结果**：\\\\n- 用户列表：包含用户基本信息\\\\n- 总数：符合条件的用户总数\\\\n\\\\n**字段说明**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | string | 是 | 用户ID |\\\\n| username | string | 是 | 用户名 |\\\\n| email | string | 是 | 邮箱 |\\\\n| phone | string | 是 | 手机号 |\\\\n| realName | string | 是 | 真实姓名 |\\\\n| avatar | string | 否 | 头像URL |\\\\n| status | string | 是 | 用户状态：active/inactive/locked |\\\\n| roleIds | array | 是 | 角色ID列表 |\\\\n| departmentId | string | 否 | 部门ID |\\\\n| lastLoginAt | string | 否 | 最后登录时间 |\\\\n| createdAt | string | 是 | 创建时间 |\\\\n| updatedAt | string | 是 | 更新时间 |\\\\n\\\\n#### 2.1.2 新增用户\\\\n\\\\n**功能描述**：创建新的系统用户。\\\\n\\\\n**输入参数**：\\\\n- 用户名：唯一标识\\\\n- 邮箱：唯一标识\\\\n- 手机号：唯一标识\\\\n- 密码：初始密码\\\\n- 真实姓名：用户真实姓名\\\\n- 角色列表：用户拥有的角色\\\\n- 部门：用户所属部门\\\\n\\\\n**验证规则**：\\\\n- 用户名：4-20位字母数字下划线\\\\n- 邮箱：标准邮箱格式\\\\n- 手机号：11位数字\\\\n- 密码：6-20位，包含字母和数字\\\\n- 真实姓名：2-20位中文字符\\\\n- 角色列表：至少选择一个角色\\\\n\\\\n**业务规则**：\\\\n- 用户名、邮箱、手机号必须唯一\\\\n- 新用户默认状态为活跃\\\\n- 自动记录创建时间和创建人\\\\n- 发送欢迎邮件通知用户\\\\n\\\\n#### 2.1.3 编辑用户\\\\n\\\\n**功能描述**：修改用户的基本信息。\\\\n\\\\n**输入参数**：\\\\n- 用户ID：要编辑的用户ID\\\\n- 用户名：可修改\\\\n- 邮箱：可修改\\\\n- 手机号：可修改\\\\n- 密码：可选，不修改则留空\\\\n- 真实姓名：可修改\\\\n- 角色列表：可修改\\\\n- 部门：可修改\\\\n- 用户状态：可修改\\\\n\\\\n**验证规则**：\\\\n- 用户名、邮箱、手机号修改后必须唯一\\\\n- 密码修改需符合密码规则\\\\n- 角色列表至少选择一个角色\\\\n\\\\n**业务规则**：\\\\n- 记录修改时间和修改人\\\\n- 状态修改需要确认\\\\n- 密码修改后强制下次登录时修改密码\\\\n\\\\n#### 2.1.4 删除用户\\\\n\\\\n**功能描述**：删除指定的用户。\\\\n\\\\n**输入参数**：\\\\n- 用户ID：要删除的用户ID\\\\n\\\\n**业务规则**：\\\\n- 删除前需要二次确认\\\\n- 不能删除当前登录用户\\\\n- 不能删除系统管理员用户\\\\n- 删除后用户数据保留30天\\\\n- 记录删除操作到审计日志\\\\n\\\\n#### 2.1.5 重置密码\\\\n\\\\n**功能描述**：重置用户密码。\\\\n\\\\n**输入参数**：\\\\n- 用户ID：要重置密码的用户ID\\\\n- 新密码：6-20位\\\\n\\\\n**业务规则**：\\\\n- 需要管理员权限\\\\n- 重置后发送密码重置邮件\\\\n- 强制用户下次登录时修改密码\\\\n- 记录密码重置操作\\\\n\\\\n#### 2.1.6 锁定/解锁用户\\\\n\\\\n**功能描述**：锁定或解锁用户账号。\\\\n\\\\n**输入参数**：\\\\n- 用户ID：要操作的用户ID\\\\n\\\\n**业务规则**：\\\\n- 锁定后用户无法登录\\\\n- 解锁后用户可以正常登录\\\\n- 记录锁定/解锁操作\\\\n- 锁定原因需要记录到审计日志\\\\n\\\\n### 2.2 角色管理\\\\n\\\\n#### 2.2.1 角色列表\\\\n\\\\n**功能描述**：展示系统中所有角色的基本信息，支持搜索、筛选和分页。\\\\n\\\\n**输入参数**：\\\\n- 关键词：角色名、角色编码\\\\n- 角色状态：活跃、未激活\\\\n- 页码：当前页码\\\\n- 每页数量：每页显示数量\\\\n\\\\n**输出结果**：\\\\n- 角色列表：包含角色基本信息\\\\n- 总数：符合条件的角色总数\\\\n\\\\n**字段说明**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | string | 是 | 角色ID |\\\\n| name | string | 是 | 角色名称 |\\\\n| code | string | 是 | 角色编码 |\\\\n| description | string | 否 | 角色描述 |\\\\n| permissions | array | 是 | 权限ID列表 |\\\\n| status | string | 是 | 角色状态：active/inactive |\\\\n| createdAt | string | 是 | 创建时间 |\\\\n| updatedAt | string | 是 | 更新时间 |\\\\n\\\\n#### 2.2.2 新增角色\\\\n\\\\n**功能描述**：创建新的系统角色。\\\\n\\\\n**输入参数**：\\\\n- 角色名称：角色显示名称\\\\n- 角色编码：唯一标识\\\\n- 角色描述：角色说明\\\\n- 权限列表：角色拥有的权限\\\\n\\\\n**验证规则**：\\\\n- 角色名称：2-20位中文字符\\\\n- 角色编码：2-20位字母数字下划线\\\\n- 权限列表：至少选择一个权限\\\\n\\\\n**业务规则**：\\\\n- 角色编码必须唯一\\\\n- 新角色默认状态为活跃\\\\n- 自动记录创建时间和创建人\\\\n\\\\n#### 2.2.3 编辑角色\\\\n\\\\n**功能描述**：修改角色的基本信息。\\\\n\\\\n**输入参数**：\\\\n- 角色ID：要编辑的角色ID\\\\n- 角色名称：可修改\\\\n- 角色编码：可修改\\\\n- 角色描述：可修改\\\\n- 权限列表：可修改\\\\n- 角色状态：可修改\\\\n\\\\n**验证规则**：\\\\n- 角色编码修改后必须唯一\\\\n- 权限列表至少选择一个权限\\\\n\\\\n**业务规则**：\\\\n- 记录修改时间和修改人\\\\n- 权限修改后立即生效\\\\n\\\\n#### 2.2.4 删除角色\\\\n\\\\n**功能描述**：删除指定的角色。\\\\n\\\\n**输入参数**：\\\\n- 角色ID：要删除的角色ID\\\\n\\\\n**业务规则**：\\\\n- 删除前需要二次确认\\\\n- 不能删除系统默认角色\\\\n- 不能删除仍有用户使用的角色\\\\n- 记录删除操作到审计日志\\\\n\\\\n### 2.3 部门管理\\\\n\\\\n#### 2.3.1 部门列表\\\\n\\\\n**功能描述**：展示系统中所有部门的基本信息，支持搜索和筛选。\\\\n\\\\n**输入参数**：\\\\n- 关键词：部门名、部门编码\\\\n- 部门状态：活跃、未激活\\\\n\\\\n**输出结果**：\\\\n- 部门列表：包含部门基本信息\\\\n\\\\n**字段说明**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | string | 是 | 部门ID |\\\\n| name | string | 是 | 部门名称 |\\\\n| code | string | 是 | 部门编码 |\\\\n| parentId | string | 否 | 上级部门ID |\\\\n| leaderId | string | 否 | 部门负责人ID |\\\\n| description | string | 否 | 部门描述 |\\\\n| sort | number | 是 | 排序号 |\\\\n| status | string | 是 | 部门状态：active/inactive |\\\\n| createdAt | string | 是 | 创建时间 |\\\\n| updatedAt | string | 是 | 更新时间 |\\\\n\\\\n#### 2.3.2 新增部门\\\\n\\\\n**功能描述**：创建新的系统部门。\\\\n\\\\n**输入参数**：\\\\n- 部门名称：部门显示名称\\\\n- 部门编码：唯一标识\\\\n- 上级部门：可选\\\\n- 部门负责人：可选\\\\n- 部门描述：部门说明\\\\n- 排序号：显示顺序\\\\n\\\\n**验证规则**：\\\\n- 部门名称：2-20位中文字符\\\\n- 部门编码：2-20位字母数字下划线\\\\n- 排序号：非负整数\\\\n\\\\n**业务规则**：\\\\n- 部门编码必须唯一\\\\n- 不能形成循环依赖\\\\n- 新部门默认状态为活跃\\\\n\\\\n#### 2.3.3 编辑部门\\\\n\\\\n**功能描述**：修改部门的基本信息。\\\\n\\\\n**输入参数**：\\\\n- 部门ID：要编辑的部门ID\\\\n- 部门名称：可修改\\\\n- 部门编码：可修改\\\\n- 上级部门：可修改\\\\n- 部门负责人：可修改\\\\n- 部门描述：可修改\\\\n- 排序号：可修改\\\\n- 部门状态：可修改\\\\n\\\\n**验证规则**：\\\\n- 部门编码修改后必须唯一\\\\n- 不能形成循环依赖\\\\n\\\\n**业务规则**：\\\\n- 记录修改时间和修改人\\\\n\\\\n#### 2.3.4 删除部门\\\\n\\\\n**功能描述**：删除指定的部门。\\\\n\\\\n**输入参数**：\\\\n- 部门ID：要删除的部门ID\\\\n\\\\n**业务规则**：\\\\n- 删除前需要二次确认\\\\n- 不能删除仍有子部门的部门\\\\n- 不能删除仍有用户的部门\\\\n- 记录删除操作到审计日志\\\\n\\\\n### 2.4 系统设置\\\\n\\\\n#### 2.4.1 设置列表\\\\n\\\\n**功能描述**：展示系统中所有可配置的设置项。\\\\n\\\\n**字段说明**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | string | 是 | 设置ID |\\\\n| key | string | 是 | 设置键 |\\\\n| value | string | 是 | 设置值 |\\\\n| type | string | 是 | 值类型：string/number/boolean/json |\\\\n| category | string | 是 | 设置分类 |\\\\n| description | string | 否 | 设置描述 |\\\\n| isPublic | boolean | 是 | 是否公开 |\\\\n| updatedAt | string | 是 | 更新时间 |\\\\n\\\\n#### 2.4.2 更新设置\\\\n\\\\n**功能描述**：修改系统设置项的值。\\\\n\\\\n**输入参数**：\\\\n- 设置键：要修改的设置键\\\\n- 设置值：新的设置值\\\\n\\\\n**业务规则**：\\\\n- 记录修改时间和修改人\\\\n- 关键设置修改需要管理员权限\\\\n- 记录修改操作到审计日志\\\\n\\\\n### 2.5 审计日志\\\\n\\\\n#### 2.5.1 日志列表\\\\n\\\\n**功能描述**：展示系统中所有操作日志，支持搜索、筛选和分页。\\\\n\\\\n**输入参数**：\\\\n- 用户ID：按用户筛选\\\\n- 操作类型：按操作筛选\\\\n- 模块：按模块筛选\\\\n- 操作状态：成功、失败\\\\n- 开始时间：操作开始时间\\\\n- 结束时间：操作结束时间\\\\n- 页码：当前页码\\\\n- 每页数量：每页显示数量\\\\n\\\\n**输出结果**：\\\\n- 日志列表：包含日志详细信息\\\\n- 总数：符合条件的日志总数\\\\n\\\\n**字段说明**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | string | 是 | 日志ID |\\\\n| userId | string | 是 | 用户ID |\\\\n| username | string | 是 | 用户名 |\\\\n| action | string | 是 | 操作类型 |\\\\n| module | string | 是 | 操作模块 |\\\\n| resource | string | 是 | 操作资源 |\\\\n| resourceId | string | 否 | 资源ID |\\\\n| ip | string | 是 | IP地址 |\\\\n| userAgent | string | 是 | 用户代理 |\\\\n| status | string | 是 | 操作状态：success/failure |\\\\n| errorMessage | string | 否 | 错误信息 |\\\\n| createdAt | string | 是 | 操作时间 |\\\\n\\\\n#### 2.5.2 导出日志\\\\n\\\\n**功能描述**：导出审计日志到Excel文件。\\\\n\\\\n**输入参数**：\\\\n- 开始时间：导出开始时间\\\\n- 结束时间：导出结束时间\\\\n- 用户ID：按用户筛选\\\\n- 操作类型：按操作筛选\\\\n- 模块：按模块筛选\\\\n\\\\n**业务规则**：\\\\n- 导出需要管理员权限\\\\n- 导出文件命名包含时间戳\\\\n- 记录导出操作到审计日志\\\\n\\\\n## 3. 非功能需求\\\\n\\\\n### 3.1 性能需求\\\\n\\\\n- 用户列表加载时间 < 1秒\\\\n- 角色列表加载时间 < 1秒\\\\n- 部门列表加载时间 < 1秒\\\\n- 审计日志列表加载时间 < 2秒\\\\n- 支持至少10,000个用户\\\\n- 支持至少1,000个角色\\\\n- 支持至少500个部门\\\\n- 审计日志保留至少1年\\\\n\\\\n### 3.2 安全需求\\\\n\\\\n- 所有操作需要身份认证\\\\n- 敏感操作需要二次确认\\\\n- 密码加密存储\\\\n- 审计日志不可篡改\\\\n- 支持操作权限控制\\\\n- 支持数据访问权限控制\\\\n- 定期备份关键数据\\\\n\\\\n### 3.3 可用性需求\\\\n\\\\n- 系统可用性 ≥ 99.9%\\\\n- 支持多浏览器访问\\\\n- 支持移动端访问\\\\n- 提供友好的错误提示\\\\n- 提供操作帮助文档\\\\n\\\\n### 3.4 可维护性需求\\\\n\\\\n- 代码结构清晰\\\\n- 模块化设计\\\\n- 完善的日志记录\\\\n- 完善的错误处理\\\\n- 支持热更新\\\\n- 支持配置管理\\\\n\\\\n## 4. 技术设计\\\\n\\\\n### 4.1 技术栈\\\\n\\\\n- 前端框架：Vue 3 + TypeScript\\\\n- UI组件库：Element Plus\\\\n- 状态管理：Pinia\\\\n- 路由管理：Vue Router\\\\n- HTTP客户端：Axios\\\\n- 表单验证：Zod\\\\n- 图表库：ECharts\\\\n- 构建工具：Vite\\\\n\\\\n### 4.2 数据库设计\\\\n\\\\n#### 用户表（users）\\\\n\\\\n| 字段名 | 类型 | 约束 | 说明 |\\\\n|--------|------|--------|------|\\\\n| id | varchar(36) | PRIMARY KEY | 用户ID |\\\\n| username | varchar(50) | UNIQUE | 用户名 |\\\\n| email | varchar(100) | UNIQUE | 邮箱 |\\\\n| phone | varchar(20) | UNIQUE | 手机号 |\\\\n| password | varchar(255) | NOT NULL | 密码哈希 |\\\\n| real_name | varchar(50) | NOT NULL | 真实姓名 |\\\\n| avatar | varchar(255) | NULL | 头像URL |\\\\n| status | varchar(20) | NOT NULL | 用户状态 |\\\\n| department_id | varchar(36) | FOREIGN KEY | 部门ID |\\\\n| created_at | timestamp | NOT NULL | 创建时间 |\\\\n| updated_at | timestamp | NOT NULL | 更新时间 |\\\\n\\\\n#### 角色表（roles）\\\\n\\\\n| 字段名 | 类型 | 约束 | 说明 |\\\\n|--------|------|--------|------|\\\\n| id | varchar(36) | PRIMARY KEY | 角色ID |\\\\n| name | varchar(50) | NOT NULL | 角色名称 |\\\\n| code | varchar(50) | UNIQUE | 角色编码 |\\\\n| description | text | NULL | 角色描述 |\\\\n| status | varchar(20) | NOT NULL | 角色状态 |\\\\n| created_at | timestamp | NOT NULL | 创建时间 |\\\\n| updated_at | timestamp | NOT NULL | 更新时间 |\\\\n\\\\n#### 部门表（departments）\\\\n\\\\n| 字段名 | 类型 | 约束 | 说明 |\\\\n|--------|------|--------|------|\\\\n| id | varchar(36) | PRIMARY KEY | 部门ID |\\\\n| name | varchar(50) | NOT NULL | 部门名称 |\\\\n| code | varchar(50) | UNIQUE | 部门编码 |\\\\n| parent_id | varchar(36) | FOREIGN KEY | 上级部门ID |\\\\n| leader_id | varchar(36) | FOREIGN KEY | 部门负责人ID |\\\\n| description | text | NULL | 部门描述 |\\\\n| sort | int | NOT NULL | 排序号 |\\\\n| status | varchar(20) | NOT NULL | 部门状态 |\\\\n| created_at | timestamp | NOT NULL | 创建时间 |\\\\n| updated_at | timestamp | NOT NULL | 更新时间 |\\\\n\\\\n#### 审计日志表（audit_logs）\\\\n\\\\n| 字段名 | 类型 | 约束 | 说明 |\\\\n|--------|------|--------|------|\\\\n| id | varchar(36) | PRIMARY KEY | 日志ID |\\\\n| user_id | varchar(36) | FOREIGN KEY | 用户ID |\\\\n| action | varchar(50) | NOT NULL | 操作类型 |\\\\n| module | varchar(50) | NOT NULL | 操作模块 |\\\\n| resource | varchar(100) | NOT NULL | 操作资源 |\\\\n| resource_id | varchar(36) | NULL | 资源ID |\\\\n| ip | varchar(50) | NOT NULL | IP地址 |\\\\n| user_agent | varchar(500) | NOT NULL | 用户代理 |\\\\n| status | varchar(20) | NOT NULL | 操作状态 |\\\\n| error_message | text | NULL | 错误信息 |\\\\n| created_at | timestamp | NOT NULL | 操作时间 |\\\\n\\\\n### 4.3 API设计\\\\n\\\\n#### 用户管理API\\\\n\\\\n```\\\\nGET    /api/system/users          # 获取用户列表\\\\nGET    /api/system/users/:id      # 获取用户详情\\\\nPOST   /api/system/users          # 创建用户\\\\nPUT    /api/system/users/:id      # 更新用户\\\\nDELETE /api/system/users/:id      # 删除用户\\\\nPOST   /api/system/users/:id/reset-password  # 重置密码\\\\nPOST   /api/system/users/:id/lock          # 锁定用户\\\\nPOST   /api/system/users/:id/unlock        # 解锁用户\\\\n```\\\\n\\\\n#### 角色管理API\\\\n\\\\n```\\\\nGET    /api/system/roles          # 获取角色列表\\\\nGET    /api/system/roles/:id      # 获取角色详情\\\\nPOST   /api/system/roles          # 创建角色\\\\nPUT    /api/system/roles/:id      # 更新角色\\\\nDELETE /api/system/roles/:id      # 删除角色\\\\n```\\\\n\\\\n#### 部门管理API\\\\n\\\\n```\\\\nGET    /api/system/departments          # 获取部门列表\\\\nGET    /api/system/departments/tree     # 获取部门树\\\\nGET    /api/system/departments/:id      # 获取部门详情\\\\nPOST   /api/system/departments          # 创建部门\\\\nPUT    /api/system/departments/:id      # 更新部门\\\\nDELETE /api/system/departments/:id      # 删除部门\\\\n```\\\\n\\\\n#### 系统设置API\\\\n\\\\n```\\\\nGET    /api/system/settings          # 获取设置列表\\\\nGET    /api/system/settings/:key    # 获取设置详情\\\\nPUT    /api/system/settings/:key    # 更新设置\\\\nPUT    /api/system/settings/batch  # 批量更新设置\\\\n```\\\\n\\\\n#### 审计日志API\\\\n\\\\n```\\\\nGET    /api/system/audit-logs          # 获取审计日志列表\\\\nGET    /api/system/audit-logs/:id      # 获取审计日志详情\\\\nGET    /api/system/audit-logs/export   # 导出审计日志\\\\n```\\\\n\\\\n### 4.4 权限设计\\\\n\\\\n#### 权限列表\\\\n\\\\n| 权限编码 | 权限名称 | 模块 | 类型 |\\\\n|---------|---------|------|------|\\\\n| system:user:read | 查看用户 | system | menu |\\\\n| system:user:create | 创建用户 | system | button |\\\\n| system:user:update | 编辑用户 | system | button |\\\\n| system:user:delete | 删除用户 | system | button |\\\\n| system:user:reset-password | 重置密码 | system | button |\\\\n| system:user:lock | 锁定用户 | system | button |\\\\n| system:role:read | 查看角色 | system | menu |\\\\n| system:role:create | 创建角色 | system | button |\\\\n| system:role:update | 编辑角色 | system | button |\\\\n| system:role:delete | 删除角色 | system | button |\\\\n| system:department:read | 查看部门 | system | menu |\\\\n| system:department:create | 创建部门 | system | button |\\\\n| system:department:update | 编辑部门 | system | button |\\\\n| system:department:delete | 删除部门 | system | button |\\\\n| system:setting:read | 查看设置 | system | menu |\\\\n| system:setting:update | 修改设置 | system | button |\\\\n| system:audit:read | 查看审计日志 | system | menu |\\\\n| system:audit:export | 导出审计日志 | system | button |\\\\n\\\\n## 5. 界面设计\\\\n\\\\n### 5.1 用户管理界面\\\\n\\\\n- 用户列表表格\\\\n- 搜索和筛选工具栏\\\\n- 新增用户按钮\\\\n- 操作按钮（编辑、删除、重置密码、锁定/解锁）\\\\n- 用户详情对话框\\\\n- 分页组件\\\\n\\\\n### 5.2 角色管理界面\\\\n\\\\n- 角色列表表格\\\\n- 搜索和筛选工具栏\\\\n- 新增角色按钮\\\\n- 操作按钮（编辑、删除）\\\\n- 角色详情对话框\\\\n- 权限选择树\\\\n- 分页组件\\\\n\\\\n### 5.3 部门管理界面\\\\n\\\\n- 部门列表表格\\\\n- 搜索和筛选工具栏\\\\n- 新增部门按钮\\\\n- 操作按钮（编辑、删除）\\\\n- 部门详情对话框\\\\n- 分页组件\\\\n\\\\n### 5.4 系统设置界面\\\\n\\\\n- 设置列表表格\\\\n- 设置编辑组件（根据类型显示不同的编辑器）\\\\n- 分类筛选\\\\n\\\\n### 5.5 审计日志界面\\\\n\\\\n- 日志列表表格\\\\n- 搜索和筛选工具栏\\\\n- 导出日志按钮\\\\n- 日志详情对话框\\\\n- 分页组件\\\\n\\\\n## 6. 测试计划\\\\n\\\\n### 6.1 单元测试\\\\n\\\\n- 用户管理功能测试\\\\n- 角色管理功能测试\\\\n- 部门管理功能测试\\\\n- 系统设置功能测试\\\\n- 审计日志功能测试\\\\n\\\\n### 6.2 集成测试\\\\n\\\\n- 用户CRUD操作测试\\\\n- 角色权限分配测试\\\\n- 部门层级关系测试\\\\n- 系统设置更新测试\\\\n- 审计日志记录测试\\\\n\\\\n### 6.3 性能测试\\\\n\\\\n- 大数据量加载测试\\\\n- 并发操作测试\\\\n- 响应时间测试\\\\n\\\\n### 6.4 安全测试\\\\n\\\\n- 权限控制测试\\\\n- SQL注入测试\\\\n- XSS攻击测试\\\\n- CSRF攻击测试\\\\n\\\\n## 7. 部署计划\\\\n\\\\n### 7.1 开发环境\\\\n\\\\n- 部署时间：2025-01-20\\\\n- 部署方式：本地开发环境\\\\n- 测试范围：功能测试\\\\n\\\\n### 7.2 测试环境\\\\n\\\\n- 部署时间：2025-01-25\\\\n- 部署方式：CI/CD自动部署\\\\n- 测试范围：集成测试、性能测试、安全测试\\\\n\\\\n### 7.3 生产环境\\\\n\\\\n- 部署时间：2025-02-01\\\\n- 部署方式：蓝绿部署\\\\n- 测试范围：冒烟测试\\\\n\\\\n## 8. 附录\\\\n\\\\n### 8.1 术语表\\\\n\\\\n| 术语 | 说明 |\\\\n|------|------|\\\\n| 用户 | 系统的使用者 |\\\\n| 角色 | 权限的集合，分配给用户 |\\\\n| 权限 | 对系统资源的操作权限 |\\\\n| 部门 | 组织架构的基本单位 |\\\\n| 审计日志 | 记录系统操作历史的日志 |\\\\n| 系统设置 | 系统的可配置参数 |\\\\n\\\\n### 8.2 参考文档\\\\n\\\\n- YYC³餐饮管理系统总体设计文档\\\\n- YYC³餐饮管理系统数据库设计文档\\\\n- YYC³餐饮管理系统API文档\\\\n- YYC³餐饮管理系统安全规范\\\\n\\\\n### 8.3 变更记录\\\\n\\\\n| 版本 | 日期 | 变更内容 | 变更人 |\\\\n|------|------|---------|--------|\\\\n| V1.0.0 | 2025-01-20 | 初始版本 | YYC³团队 |\\\\n\\\\n---\\\\n\\\\n**文档结束**\\\\n\",\"originAcceptText\":\"# YYC³餐饮管理系统 - 系统管理功能模块需求分析与设计文档\\n\\n## 文档信息\\n\\n| 项目 | 内容 |\\n|------|------|\\n| 文档名称 | 系统管理功能模块需求分析与设计文档 |\\n| 文档版本 | V1.0.0 |\\n| 创建日期 | 2025-01-20 |\\n| 作者 | YYC³团队 |\\n| 文档状态 | 正式发布 |\\n\\n## 1. 概述\\n\\n### 1.1 模块简介\\n\\n系统管理模块是YYC³餐饮管理系统的核心管理模块，负责管理系统的用户、角色、权限、部门、系统设置和审计日志等功能。该模块为系统管理员提供完整的系统管理能力，确保系统的安全性、可维护性和可扩展性。\\n\\n### 1.2 模块目标\\n\\n- 提供完整的用户生命周期管理\\n- 实现灵活的角色和权限管理\\n- 支持组织架构的部门管理\\n- 提供系统配置和参数管理\\n- 记录和审计所有系统操作\\n- 确保系统安全和数据完整性\\n\\n### 1.3 适用范围\\n\\n本模块适用于YYC³餐饮管理系统的所有版本，包括单店版和连锁版。\\n\\n## 2. 功能需求\\n\\n### 2.1 用户管理\\n\\n#### 2.1.1 用户列表\\n\\n**功能描述**：展示系统中所有用户的基本信息，支持搜索、筛选和分页。\\n\\n**输入参数**：\\n- 关键词：用户名、真实姓名、邮箱、手机号\\n- 用户状态：活跃、未激活、锁定\\n- 角色：按角色筛选\\n- 部门：按部门筛选\\n- 页码：当前页码\\n- 每页数量：每页显示数量\\n\\n**输出结果**：\\n- 用户列表：包含用户基本信息\\n- 总数：符合条件的用户总数\\n\\n**字段说明**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | string | 是 | 用户ID |\\n| username | string | 是 | 用户名 |\\n| email | string | 是 | 邮箱 |\\n| phone | string | 是 | 手机号 |\\n| realName | string | 是 | 真实姓名 |\\n| avatar | string | 否 | 头像URL |\\n| status | string | 是 | 用户状态：active/inactive/locked |\\n| roleIds | array | 是 | 角色ID列表 |\\n| departmentId | string | 否 | 部门ID |\\n| lastLoginAt | string | 否 | 最后登录时间 |\\n| createdAt | string | 是 | 创建时间 |\\n| updatedAt | string | 是 | 更新时间 |\\n\\n#### 2.1.2 新增用户\\n\\n**功能描述**：创建新的系统用户。\\n\\n**输入参数**：\\n- 用户名：唯一标识\\n- 邮箱：唯一标识\\n- 手机号：唯一标识\\n- 密码：初始密码\\n- 真实姓名：用户真实姓名\\n- 角色列表：用户拥有的角色\\n- 部门：用户所属部门\\n\\n**验证规则**：\\n- 用户名：4-20位字母数字下划线\\n- 邮箱：标准邮箱格式\\n- 手机号：11位数字\\n- 密码：6-20位，包含字母和数字\\n- 真实姓名：2-20位中文字符\\n- 角色列表：至少选择一个角色\\n\\n**业务规则**：\\n- 用户名、邮箱、手机号必须唯一\\n- 新用户默认状态为活跃\\n- 自动记录创建时间和创建人\\n- 发送欢迎邮件通知用户\\n\\n#### 2.1.3 编辑用户\\n\\n**功能描述**：修改用户的基本信息。\\n\\n**输入参数**：\\n- 用户ID：要编辑的用户ID\\n- 用户名：可修改\\n- 邮箱：可修改\\n- 手机号：可修改\\n- 密码：可选，不修改则留空\\n- 真实姓名：可修改\\n- 角色列表：可修改\\n- 部门：可修改\\n- 用户状态：可修改\\n\\n**验证规则**：\\n- 用户名、邮箱、手机号修改后必须唯一\\n- 密码修改需符合密码规则\\n- 角色列表至少选择一个角色\\n\\n**业务规则**：\\n- 记录修改时间和修改人\\n- 状态修改需要确认\\n- 密码修改后强制下次登录时修改密码\\n\\n#### 2.1.4 删除用户\\n\\n**功能描述**：删除指定的用户。\\n\\n**输入参数**：\\n- 用户ID：要删除的用户ID\\n\\n**业务规则**：\\n- 删除前需要二次确认\\n- 不能删除当前登录用户\\n- 不能删除系统管理员用户\\n- 删除后用户数据保留30天\\n- 记录删除操作到审计日志\\n\\n#### 2.1.5 重置密码\\n\\n**功能描述**：重置用户密码。\\n\\n**输入参数**：\\n- 用户ID：要重置密码的用户ID\\n- 新密码：6-20位\\n\\n**业务规则**：\\n- 需要管理员权限\\n- 重置后发送密码重置邮件\\n- 强制用户下次登录时修改密码\\n- 记录密码重置操作\\n\\n#### 2.1.6 锁定/解锁用户\\n\\n**功能描述**：锁定或解锁用户账号。\\n\\n**输入参数**：\\n- 用户ID：要操作的用户ID\\n\\n**业务规则**：\\n- 锁定后用户无法登录\\n- 解锁后用户可以正常登录\\n- 记录锁定/解锁操作\\n- 锁定原因需要记录到审计日志\\n\\n### 2.2 角色管理\\n\\n#### 2.2.1 角色列表\\n\\n**功能描述**：展示系统中所有角色的基本信息，支持搜索、筛选和分页。\\n\\n**输入参数**：\\n- 关键词：角色名、角色编码\\n- 角色状态：活跃、未激活\\n- 页码：当前页码\\n- 每页数量：每页显示数量\\n\\n**输出结果**：\\n- 角色列表：包含角色基本信息\\n- 总数：符合条件的角色总数\\n\\n**字段说明**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | string | 是 | 角色ID |\\n| name | string | 是 | 角色名称 |\\n| code | string | 是 | 角色编码 |\\n| description | string | 否 | 角色描述 |\\n| permissions | array | 是 | 权限ID列表 |\\n| status | string | 是 | 角色状态：active/inactive |\\n| createdAt | string | 是 | 创建时间 |\\n| updatedAt | string | 是 | 更新时间 |\\n\\n#### 2.2.2 新增角色\\n\\n**功能描述**：创建新的系统角色。\\n\\n**输入参数**：\\n- 角色名称：角色显示名称\\n- 角色编码：唯一标识\\n- 角色描述：角色说明\\n- 权限列表：角色拥有的权限\\n\\n**验证规则**：\\n- 角色名称：2-20位中文字符\\n- 角色编码：2-20位字母数字下划线\\n- 权限列表：至少选择一个权限\\n\\n**业务规则**：\\n- 角色编码必须唯一\\n- 新角色默认状态为活跃\\n- 自动记录创建时间和创建人\\n\\n#### 2.2.3 编辑角色\\n\\n**功能描述**：修改角色的基本信息。\\n\\n**输入参数**：\\n- 角色ID：要编辑的角色ID\\n- 角色名称：可修改\\n- 角色编码：可修改\\n- 角色描述：可修改\\n- 权限列表：可修改\\n- 角色状态：可修改\\n\\n**验证规则**：\\n- 角色编码修改后必须唯一\\n- 权限列表至少选择一个权限\\n\\n**业务规则**：\\n- 记录修改时间和修改人\\n- 权限修改后立即生效\\n\\n#### 2.2.4 删除角色\\n\\n**功能描述**：删除指定的角色。\\n\\n**输入参数**：\\n- 角色ID：要删除的角色ID\\n\\n**业务规则**：\\n- 删除前需要二次确认\\n- 不能删除系统默认角色\\n- 不能删除仍有用户使用的角色\\n- 记录删除操作到审计日志\\n\\n### 2.3 部门管理\\n\\n#### 2.3.1 部门列表\\n\\n**功能描述**：展示系统中所有部门的基本信息，支持搜索和筛选。\\n\\n**输入参数**：\\n- 关键词：部门名、部门编码\\n- 部门状态：活跃、未激活\\n\\n**输出结果**：\\n- 部门列表：包含部门基本信息\\n\\n**字段说明**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | string | 是 | 部门ID |\\n| name | string | 是 | 部门名称 |\\n| code | string | 是 | 部门编码 |\\n| parentId | string | 否 | 上级部门ID |\\n| leaderId | string | 否 | 部门负责人ID |\\n| description | string | 否 | 部门描述 |\\n| sort | number | 是 | 排序号 |\\n| status | string | 是 | 部门状态：active/inactive |\\n| createdAt | string | 是 | 创建时间 |\\n| updatedAt | string | 是 | 更新时间 |\\n\\n#### 2.3.2 新增部门\\n\\n**功能描述**：创建新的系统部门。\\n\\n**输入参数**：\\n- 部门名称：部门显示名称\\n- 部门编码：唯一标识\\n- 上级部门：可选\\n- 部门负责人：可选\\n- 部门描述：部门说明\\n- 排序号：显示顺序\\n\\n**验证规则**：\\n- 部门名称：2-20位中文字符\\n- 部门编码：2-20位字母数字下划线\\n- 排序号：非负整数\\n\\n**业务规则**：\\n- 部门编码必须唯一\\n- 不能形成循环依赖\\n- 新部门默认状态为活跃\\n\\n#### 2.3.3 编辑部门\\n\\n**功能描述**：修改部门的基本信息。\\n\\n**输入参数**：\\n- 部门ID：要编辑的部门ID\\n- 部门名称：可修改\\n- 部门编码：可修改\\n- 上级部门：可修改\\n- 部门负责人：可修改\\n- 部门描述：可修改\\n- 排序号：可修改\\n- 部门状态：可修改\\n\\n**验证规则**：\\n- 部门编码修改后必须唯一\\n- 不能形成循环依赖\\n\\n**业务规则**：\\n- 记录修改时间和修改人\\n\\n#### 2.3.4 删除部门\\n\\n**功能描述**：删除指定的部门。\\n\\n**输入参数**：\\n- 部门ID：要删除的部门ID\\n\\n**业务规则**：\\n- 删除前需要二次确认\\n- 不能删除仍有子部门的部门\\n- 不能删除仍有用户的部门\\n- 记录删除操作到审计日志\\n\\n### 2.4 系统设置\\n\\n#### 2.4.1 设置列表\\n\\n**功能描述**：展示系统中所有可配置的设置项。\\n\\n**字段说明**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | string | 是 | 设置ID |\\n| key | string | 是 | 设置键 |\\n| value | string | 是 | 设置值 |\\n| type | string | 是 | 值类型：string/number/boolean/json |\\n| category | string | 是 | 设置分类 |\\n| description | string | 否 | 设置描述 |\\n| isPublic | boolean | 是 | 是否公开 |\\n| updatedAt | string | 是 | 更新时间 |\\n\\n#### 2.4.2 更新设置\\n\\n**功能描述**：修改系统设置项的值。\\n\\n**输入参数**：\\n- 设置键：要修改的设置键\\n- 设置值：新的设置值\\n\\n**业务规则**：\\n- 记录修改时间和修改人\\n- 关键设置修改需要管理员权限\\n- 记录修改操作到审计日志\\n\\n### 2.5 审计日志\\n\\n#### 2.5.1 日志列表\\n\\n**功能描述**：展示系统中所有操作日志，支持搜索、筛选和分页。\\n\\n**输入参数**：\\n- 用户ID：按用户筛选\\n- 操作类型：按操作筛选\\n- 模块：按模块筛选\\n- 操作状态：成功、失败\\n- 开始时间：操作开始时间\\n- 结束时间：操作结束时间\\n- 页码：当前页码\\n- 每页数量：每页显示数量\\n\\n**输出结果**：\\n- 日志列表：包含日志详细信息\\n- 总数：符合条件的日志总数\\n\\n**字段说明**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | string | 是 | 日志ID |\\n| userId | string | 是 | 用户ID |\\n| username | string | 是 | 用户名 |\\n| action | string | 是 | 操作类型 |\\n| module | string | 是 | 操作模块 |\\n| resource | string | 是 | 操作资源 |\\n| resourceId | string | 否 | 资源ID |\\n| ip | string | 是 | IP地址 |\\n| userAgent | string | 是 | 用户代理 |\\n| status | string | 是 | 操作状态：success/failure |\\n| errorMessage | string | 否 | 错误信息 |\\n| createdAt | string | 是 | 操作时间 |\\n\\n#### 2.5.2 导出日志\\n\\n**功能描述**：导出审计日志到Excel文件。\\n\\n**输入参数**：\\n- 开始时间：导出开始时间\\n- 结束时间：导出结束时间\\n- 用户ID：按用户筛选\\n- 操作类型：按操作筛选\\n- 模块：按模块筛选\\n\\n**业务规则**：\\n- 导出需要管理员权限\\n- 导出文件命名包含时间戳\\n- 记录导出操作到审计日志\\n\\n## 3. 非功能需求\\n\\n### 3.1 性能需求\\n\\n- 用户列表加载时间 < 1秒\\n- 角色列表加载时间 < 1秒\\n- 部门列表加载时间 < 1秒\\n- 审计日志列表加载时间 < 2秒\\n- 支持至少10,000个用户\\n- 支持至少1,000个角色\\n- 支持至少500个部门\\n- 审计日志保留至少1年\\n\\n### 3.2 安全需求\\n\\n- 所有操作需要身份认证\\n- 敏感操作需要二次确认\\n- 密码加密存储\\n- 审计日志不可篡改\\n- 支持操作权限控制\\n- 支持数据访问权限控制\\n- 定期备份关键数据\\n\\n### 3.3 可用性需求\\n\\n- 系统可用性 ≥ 99.9%\\n- 支持多浏览器访问\\n- 支持移动端访问\\n- 提供友好的错误提示\\n- 提供操作帮助文档\\n\\n### 3.4 可维护性需求\\n\\n- 代码结构清晰\\n- 模块化设计\\n- 完善的日志记录\\n- 完善的错误处理\\n- 支持热更新\\n- 支持配置管理\\n\\n## 4. 技术设计\\n\\n### 4.1 技术栈\\n\\n- 前端框架：Vue 3 + TypeScript\\n- UI组件库：Element Plus\\n- 状态管理：Pinia\\n- 路由管理：Vue Router\\n- HTTP客户端：Axios\\n- 表单验证：Zod\\n- 图表库：ECharts\\n- 构建工具：Vite\\n\\n### 4.2 数据库设计\\n\\n#### 用户表（users）\\n\\n| 字段名 | 类型 | 约束 | 说明 |\\n|--------|------|--------|------|\\n| id | varchar(36) | PRIMARY KEY | 用户ID |\\n| username | varchar(50) | UNIQUE | 用户名 |\\n| email | varchar(100) | UNIQUE | 邮箱 |\\n| phone | varchar(20) | UNIQUE | 手机号 |\\n| password | varchar(255) | NOT NULL | 密码哈希 |\\n| real_name | varchar(50) | NOT NULL | 真实姓名 |\\n| avatar | varchar(255) | NULL | 头像URL |\\n| status | varchar(20) | NOT NULL | 用户状态 |\\n| department_id | varchar(36) | FOREIGN KEY | 部门ID |\\n| created_at | timestamp | NOT NULL | 创建时间 |\\n| updated_at | timestamp | NOT NULL | 更新时间 |\\n\\n#### 角色表（roles）\\n\\n| 字段名 | 类型 | 约束 | 说明 |\\n|--------|------|--------|------|\\n| id | varchar(36) | PRIMARY KEY | 角色ID |\\n| name | varchar(50) | NOT NULL | 角色名称 |\\n| code | varchar(50) | UNIQUE | 角色编码 |\\n| description | text | NULL | 角色描述 |\\n| status | varchar(20) | NOT NULL | 角色状态 |\\n| created_at | timestamp | NOT NULL | 创建时间 |\\n| updated_at | timestamp | NOT NULL | 更新时间 |\\n\\n#### 部门表（departments）\\n\\n| 字段名 | 类型 | 约束 | 说明 |\\n|--------|------|--------|------|\\n| id | varchar(36) | PRIMARY KEY | 部门ID |\\n| name | varchar(50) | NOT NULL | 部门名称 |\\n| code | varchar(50) | UNIQUE | 部门编码 |\\n| parent_id | varchar(36) | FOREIGN KEY | 上级部门ID |\\n| leader_id | varchar(36) | FOREIGN KEY | 部门负责人ID |\\n| description | text | NULL | 部门描述 |\\n| sort | int | NOT NULL | 排序号 |\\n| status | varchar(20) | NOT NULL | 部门状态 |\\n| created_at | timestamp | NOT NULL | 创建时间 |\\n| updated_at | timestamp | NOT NULL | 更新时间 |\\n\\n#### 审计日志表（audit_logs）\\n\\n| 字段名 | 类型 | 约束 | 说明 |\\n|--------|------|--------|------|\\n| id | varchar(36) | PRIMARY KEY | 日志ID |\\n| user_id | varchar(36) | FOREIGN KEY | 用户ID |\\n| action | varchar(50) | NOT NULL | 操作类型 |\\n| module | varchar(50) | NOT NULL | 操作模块 |\\n| resource | varchar(100) | NOT NULL | 操作资源 |\\n| resource_id | varchar(36) | NULL | 资源ID |\\n| ip | varchar(50) | NOT NULL | IP地址 |\\n| user_agent | varchar(500) | NOT NULL | 用户代理 |\\n| status | varchar(20) | NOT NULL | 操作状态 |\\n| error_message | text | NULL | 错误信息 |\\n| created_at | timestamp | NOT NULL | 操作时间 |\\n\\n### 4.3 API设计\\n\\n#### 用户管理API\\n\\n```\\nGET    /api/system/users          # 获取用户列表\\nGET    /api/system/users/:id      # 获取用户详情\\nPOST   /api/system/users          # 创建用户\\nPUT    /api/system/users/:id      # 更新用户\\nDELETE /api/system/users/:id      # 删除用户\\nPOST   /api/system/users/:id/reset-password  # 重置密码\\nPOST   /api/system/users/:id/lock          # 锁定用户\\nPOST   /api/system/users/:id/unlock        # 解锁用户\\n```\\n\\n#### 角色管理API\\n\\n```\\nGET    /api/system/roles          # 获取角色列表\\nGET    /api/system/roles/:id      # 获取角色详情\\nPOST   /api/system/roles          # 创建角色\\nPUT    /api/system/roles/:id      # 更新角色\\nDELETE /api/system/roles/:id      # 删除角色\\n```\\n\\n#### 部门管理API\\n\\n```\\nGET    /api/system/departments          # 获取部门列表\\nGET    /api/system/departments/tree     # 获取部门树\\nGET    /api/system/departments/:id      # 获取部门详情\\nPOST   /api/system/departments          # 创建部门\\nPUT    /api/system/departments/:id      # 更新部门\\nDELETE /api/system/departments/:id      # 删除部门\\n```\\n\\n#### 系统设置API\\n\\n```\\nGET    /api/system/settings          # 获取设置列表\\nGET    /api/system/settings/:key    # 获取设置详情\\nPUT    /api/system/settings/:key    # 更新设置\\nPUT    /api/system/settings/batch  # 批量更新设置\\n```\\n\\n#### 审计日志API\\n\\n```\\nGET    /api/system/audit-logs          # 获取审计日志列表\\nGET    /api/system/audit-logs/:id      # 获取审计日志详情\\nGET    /api/system/audit-logs/export   # 导出审计日志\\n```\\n\\n### 4.4 权限设计\\n\\n#### 权限列表\\n\\n| 权限编码 | 权限名称 | 模块 | 类型 |\\n|---------|---------|------|------|\\n| system:user:read | 查看用户 | system | menu |\\n| system:user:create | 创建用户 | system | button |\\n| system:user:update | 编辑用户 | system | button |\\n| system:user:delete | 删除用户 | system | button |\\n| system:user:reset-password | 重置密码 | system | button |\\n| system:user:lock | 锁定用户 | system | button |\\n| system:role:read | 查看角色 | system | menu |\\n| system:role:create | 创建角色 | system | button |\\n| system:role:update | 编辑角色 | system | button |\\n| system:role:delete | 删除角色 | system | button |\\n| system:department:read | 查看部门 | system | menu |\\n| system:department:create | 创建部门 | system | button |\\n| system:department:update | 编辑部门 | system | button |\\n| system:department:delete | 删除部门 | system | button |\\n| system:setting:read | 查看设置 | system | menu |\\n| system:setting:update | 修改设置 | system | button |\\n| system:audit:read | 查看审计日志 | system | menu |\\n| system:audit:export | 导出审计日志 | system | button |\\n\\n## 5. 界面设计\\n\\n### 5.1 用户管理界面\\n\\n- 用户列表表格\\n- 搜索和筛选工具栏\\n- 新增用户按钮\\n- 操作按钮（编辑、删除、重置密码、锁定/解锁）\\n- 用户详情对话框\\n- 分页组件\\n\\n### 5.2 角色管理界面\\n\\n- 角色列表表格\\n- 搜索和筛选工具栏\\n- 新增角色按钮\\n- 操作按钮（编辑、删除）\\n- 角色详情对话框\\n- 权限选择树\\n- 分页组件\\n\\n### 5.3 部门管理界面\\n\\n- 部门列表表格\\n- 搜索和筛选工具栏\\n- 新增部门按钮\\n- 操作按钮（编辑、删除）\\n- 部门详情对话框\\n- 分页组件\\n\\n### 5.4 系统设置界面\\n\\n- 设置列表表格\\n- 设置编辑组件（根据类型显示不同的编辑器）\\n- 分类筛选\\n\\n### 5.5 审计日志界面\\n\\n- 日志列表表格\\n- 搜索和筛选工具栏\\n- 导出日志按钮\\n- 日志详情对话框\\n- 分页组件\\n\\n## 6. 测试计划\\n\\n### 6.1 单元测试\\n\\n- 用户管理功能测试\\n- 角色管理功能测试\\n- 部门管理功能测试\\n- 系统设置功能测试\\n- 审计日志功能测试\\n\\n### 6.2 集成测试\\n\\n- 用户CRUD操作测试\\n- 角色权限分配测试\\n- 部门层级关系测试\\n- 系统设置更新测试\\n- 审计日志记录测试\\n\\n### 6.3 性能测试\\n\\n- 大数据量加载测试\\n- 并发操作测试\\n- 响应时间测试\\n\\n### 6.4 安全测试\\n\\n- 权限控制测试\\n- SQL注入测试\\n- XSS攻击测试\\n- CSRF攻击测试\\n\\n## 7. 部署计划\\n\\n### 7.1 开发环境\\n\\n- 部署时间：2025-01-20\\n- 部署方式：本地开发环境\\n- 测试范围：功能测试\\n\\n### 7.2 测试环境\\n\\n- 部署时间：2025-01-25\\n- 部署方式：CI/CD自动部署\\n- 测试范围：集成测试、性能测试、安全测试\\n\\n### 7.3 生产环境\\n\\n- 部署时间：2025-02-01\\n- 部署方式：蓝绿部署\\n- 测试范围：冒烟测试\\n\\n## 8. 附录\\n\\n### 8.1 术语表\\n\\n| 术语 | 说明 |\\n|------|------|\\n| 用户 | 系统的使用者 |\\n| 角色 | 权限的集合，分配给用户 |\\n| 权限 | 对系统资源的操作权限 |\\n| 部门 | 组织架构的基本单位 |\\n| 审计日志 | 记录系统操作历史的日志 |\\n| 系统设置 | 系统的可配置参数 |\\n\\n### 8.2 参考文档\\n\\n- YYC³餐饮管理系统总体设计文档\\n- YYC³餐饮管理系统数据库设计文档\\n- YYC³餐饮管理系统API文档\\n- YYC³餐饮管理系统安全规范\\n\\n### 8.3 变更记录\\n\\n| 版本 | 日期 | 变更内容 | 变更人 |\\n|------|------|---------|--------|\\n| V1.0.0 | 2025-01-20 | 初始版本 | YYC³团队 |\\n\\n---\\n\\n**文档结束**\\n\",\"originTextLength\":11716,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768879390123}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/composables/usePayment.ts": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":567,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":567,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"/**\\\\n * @fileoverview 支付管理Composable\\\\n * @description 管理支付管理功能的状态和逻辑\\\\n * @module usePayment\\\\n * @author YYC³\\\\n * @version 1.0.0\\\\n * @created 2025-01-20\\\\n */\\\\n\\\\nimport { ref, reactive, computed } from \\\\'vue\\\\'\\\\nimport { ElMessage, ElMessageBox } from \\\\'element-plus\\\\'\\\\nimport dayjs from \\\\'dayjs\\\\'\\\\nimport { \\\\n  PaymentAPI, \\\\n  PaymentMethod, \\\\n  PaymentStatus, \\\\n  RefundStatus,\\\\n  type PaymentConfig, \\\\n  type PaymentTransaction, \\\\n  type RefundRecord, \\\\n  type PaymentStats,\\\\n  type CreatePaymentConfigRequest,\\\\n  type UpdatePaymentConfigRequest,\\\\n  type CreateRefundRequest,\\\\n  type PaymentQueryParams\\\\n} from \\\\'@/api/payment\\\\'\\\\n\\\\nconst paymentAPI = new PaymentAPI()\\\\n\\\\nexport function usePayment() {\\\\n  const loading = ref(false)\\\\n  const activeTab = ref<\\\\'configs\\\\' | \\\\'transactions\\\\' | \\\\'refunds\\\\'>(\\\\'configs\\\\')\\\\n\\\\n  const paymentConfigs = ref<PaymentConfig[]>([])\\\\n  const transactions = ref<PaymentTransaction[]>([])\\\\n  const refunds = ref<RefundRecord[]>([])\\\\n  const paymentStats = ref<PaymentStats | null>(null)\\\\n\\\\n  const selectedConfig = ref<PaymentConfig | null>(null)\\\\n  const selectedTransaction = ref<PaymentTransaction | null>(null)\\\\n  const selectedRefund = ref<RefundRecord | null>(null)\\\\n\\\\n  const showConfigDialog = ref(false)\\\\n  const showTransactionDialog = ref(false)\\\\n  const showRefundDialog = ref(false)\\\\n\\\\n  const configDialogType = ref<\\\\'create\\\\' | \\\\'edit\\\\'>(\\\\'create\\\\')\\\\n\\\\n  const configForm = reactive({\\\\n    id: 0,\\\\n    method: PaymentMethod.ALIPAY,\\\\n    name: \\\\'\\\\',\\\\n    displayName: \\\\'\\\\',\\\\n    description: \\\\'\\\\',\\\\n    enabled: true,\\\\n    config: {\\\\n      appId: \\\\'\\\\',\\\\n      merchantId: \\\\'\\\\',\\\\n      apiKey: \\\\'\\\\',\\\\n      apiSecret: \\\\'\\\\',\\\\n      publicKey: \\\\'\\\\',\\\\n      privateKey: \\\\'\\\\',\\\\n      notifyUrl: \\\\'\\\\',\\\\n      returnUrl: \\\\'\\\\',\\\\n      supportedCurrencies: [\\\\'CNY\\\\'],\\\\n      minAmount: 0,\\\\n      maxAmount: 100000,\\\\n      feeRate: 0,\\\\n      fixedFee: 0\\\\n    }\\\\n  })\\\\n\\\\n  const refundForm = reactive({\\\\n    transactionId: \\\\'\\\\',\\\\n    amount: 0,\\\\n    reason: \\\\'\\\\'\\\\n  })\\\\n\\\\n  const transactionPagination = reactive({\\\\n    page: 1,\\\\n    limit: 20,\\\\n    total: 0\\\\n  })\\\\n\\\\n  const refundPagination = reactive({\\\\n    page: 1,\\\\n    limit: 20,\\\\n    total: 0\\\\n  })\\\\n\\\\n  const transactionFilter = reactive({\\\\n    search: \\\\'\\\\',\\\\n    paymentMethod: \\\\'\\\\' as PaymentMethod | \\\\'\\\\',\\\\n    status: \\\\'\\\\' as PaymentStatus | \\\\'\\\\',\\\\n    dateRange: [] as string[],\\\\n    minAmount: 0,\\\\n    maxAmount: 0\\\\n  })\\\\n\\\\n  const refundFilter = reactive({\\\\n    search: \\\\'\\\\',\\\\n    status: \\\\'\\\\' as RefundStatus | \\\\'\\\\',\\\\n    dateRange: [] as string[]\\\\n  })\\\\n\\\\n  const configsLoading = computed(() => loading.value && activeTab.value === \\\\'configs\\\\')\\\\n  const transactionsLoading = computed(() => loading.value && activeTab.value === \\\\'transactions\\\\')\\\\n  const refundsLoading = computed(() => loading.value && activeTab.value === \\\\'refunds\\\\')\\\\n\\\\n  const loadPaymentConfigs = async () => {\\\\n    try {\\\\n      loading.value = true\\\\n      const response = await paymentAPI.getPaymentConfigs()\\\\n      if (response.success && response.data) {\\\\n        paymentConfigs.value = response.data\\\\n      } else {\\\\n        ElMessage.error(response.message || \\\\'加载支付配置失败\\\\')\\\\n      }\\\\n    } catch (error) {\\\\n      ElMessage.error(\\\\'加载支付配置失败\\\\')\\\\n      console.error(\\\\'加载支付配置失败:\\\\', error)\\\\n    } finally {\\\\n      loading.value = false\\\\n    }\\\\n  }\\\\n\\\\n  const loadTransactions = async () => {\\\\n    try {\\\\n      loading.value = true\\\\n      const params: PaymentQueryParams = {\\\\n        page: transactionPagination.page,\\\\n        limit: transactionPagination.limit,\\\\n        search: transactionFilter.search || undefined,\\\\n        paymentMethod: transactionFilter.paymentMethod || undefined,\\\\n        status: transactionFilter.status || undefined,\\\\n        startDate: transactionFilter.dateRange[0] || undefined,\\\\n        endDate: transactionFilter.dateRange[1] || undefined,\\\\n        minAmount: transactionFilter.minAmount || undefined,\\\\n        maxAmount: transactionFilter.maxAmount || undefined,\\\\n        sortBy: \\\\'createdAt\\\\',\\\\n        sortOrder: \\\\'desc\\\\'\\\\n      }\\\\n      \\\\n      const response = await paymentAPI.getPaymentTransactions(params)\\\\n      if (response.success && response.data) {\\\\n        transactions.value = response.data.items\\\\n        transactionPagination.total = response.data.pagination.total\\\\n      } else {\\\\n        ElMessage.error(response.message || \\\\'加载交易记录失败\\\\')\\\\n      }\\\\n    } catch (error) {\\\\n      ElMessage.error(\\\\'加载交易记录失败\\\\')\\\\n      console.error(\\\\'加载交易记录失败:\\\\', error)\\\\n    } finally {\\\\n      loading.value = false\\\\n    }\\\\n  }\\\\n\\\\n  const loadRefunds = async () => {\\\\n    try {\\\\n      loading.value = true\\\\n      const params: PaymentQueryParams = {\\\\n        page: refundPagination.page,\\\\n        limit: refundPagination.limit,\\\\n        search: refundFilter.search || undefined,\\\\n        startDate: refundFilter.dateRange[0] || undefined,\\\\n        endDate: refundFilter.dateRange[1] || undefined\\\\n      }\\\\n      \\\\n      const response = await paymentAPI.getRefundRecords(params)\\\\n      if (response.success && response.data) {\\\\n        refunds.value = response.data.items\\\\n        refundPagination.total = response.data.pagination.total\\\\n      } else {\\\\n        ElMessage.error(response.message || \\\\'加载退款记录失败\\\\')\\\\n      }\\\\n    } catch (error) {\\\\n      ElMessage.error(\\\\'加载退款记录失败\\\\')\\\\n      console.error(\\\\'加载退款记录失败:\\\\', error)\\\\n    } finally {\\\\n      loading.value = false\\\\n    }\\\\n  }\\\\n\\\\n  const loadPaymentStats = async () => {\\\\n    try {\\\\n      const response = await paymentAPI.getPaymentStats()\\\\n      if (response.success && response.data) {\\\\n        paymentStats.value = response.data\\\\n      } else {\\\\n        ElMessage.error(response.message || \\\\'加载支付统计失败\\\\')\\\\n      }\\\\n    } catch (error) {\\\\n      ElMessage.error(\\\\'加载支付统计失败\\\\')\\\\n      console.error(\\\\'加载支付统计失败:\\\\', error)\\\\n    }\\\\n  }\\\\n\\\\n  const handleAddConfig = () => {\\\\n    configDialogType.value = \\\\'create\\\\'\\\\n    Object.assign(configForm, {\\\\n      id: 0,\\\\n      method: PaymentMethod.ALIPAY,\\\\n      name: \\\\'\\\\',\\\\n      displayName: \\\\'\\\\',\\\\n      description: \\\\'\\\\',\\\\n      enabled: true,\\\\n      config: {\\\\n        appId: \\\\'\\\\',\\\\n        merchantId: \\\\'\\\\',\\\\n        apiKey: \\\\'\\\\',\\\\n        apiSecret: \\\\'\\\\',\\\\n        publicKey: \\\\'\\\\',\\\\n        privateKey: \\\\'\\\\',\\\\n        notifyUrl: \\\\'\\\\',\\\\n        returnUrl: \\\\'\\\\',\\\\n        supportedCurrencies: [\\\\'CNY\\\\'],\\\\n        minAmount: 0,\\\\n        maxAmount: 100000,\\\\n        feeRate: 0,\\\\n        fixedFee: 0\\\\n      }\\\\n    })\\\\n    showConfigDialog.value = true\\\\n  }\\\\n\\\\n  const handleEditConfig = (config: PaymentConfig) => {\\\\n    configDialogType.value = \\\\'edit\\\\'\\\\n    Object.assign(configForm, {\\\\n      id: config.id,\\\\n      method: config.method,\\\\n      name: config.name,\\\\n      displayName: config.displayName,\\\\n      description: config.description || \\\\'\\\\',\\\\n      enabled: config.enabled,\\\\n      config: { ...config.config }\\\\n    })\\\\n    selectedConfig.value = config\\\\n    showConfigDialog.value = true\\\\n  }\\\\n\\\\n  const handleDeleteConfig = async (config: PaymentConfig) => {\\\\n    try {\\\\n      await ElMessageBox.confirm(`确定要删除支付配置 \\\\\\\"${config.displayName}\\\\\\\" 吗？`, \\\\'提示\\\\', {\\\\n        confirmButtonText: \\\\'确定\\\\',\\\\n        cancelButtonText: \\\\'取消\\\\',\\\\n        type: \\\\'warning\\\\'\\\\n      })\\\\n      \\\\n      const response = await paymentAPI.deletePaymentConfig(config.id)\\\\n      if (response.success) {\\\\n        ElMessage.success(\\\\'删除成功\\\\')\\\\n        await loadPaymentConfigs()\\\\n      } else {\\\\n        ElMessage.error(response.message || \\\\'删除失败\\\\')\\\\n      }\\\\n    } catch (error) {\\\\n      if (error !== \\\\'cancel\\\\') {\\\\n        ElMessage.error(\\\\'删除失败\\\\')\\\\n        console.error(\\\\'删除失败:\\\\', error)\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  const handleToggleConfig = async (config: PaymentConfig) => {\\\\n    try {\\\\n      const response = await paymentAPI.togglePaymentConfig(config.id, !config.enabled)\\\\n      if (response.success) {\\\\n        config.enabled = !config.enabled\\\\n        ElMessage.success(config.enabled ? \\\\'启用成功\\\\' : \\\\'禁用成功\\\\')\\\\n      } else {\\\\n        ElMessage.error(response.message || \\\\'操作失败\\\\')\\\\n      }\\\\n    } catch (error) {\\\\n      ElMessage.error(\\\\'操作失败\\\\')\\\\n      console.error(\\\\'操作失败:\\\\', error)\\\\n    }\\\\n  }\\\\n\\\\n  const testPaymentConfig = async (config: PaymentConfig) => {\\\\n    try {\\\\n      const response = await paymentAPI.testPaymentConfig(config.id)\\\\n      if (response.success) {\\\\n        ElMessage.success(\\\\'测试连接成功\\\\')\\\\n      } else {\\\\n        ElMessage.error(response.message || \\\\'测试连接失败\\\\')\\\\n      }\\\\n    } catch (error) {\\\\n      ElMessage.error(\\\\'测试连接失败\\\\')\\\\n      console.error(\\\\'测试连接失败:\\\\', error)\\\\n    }\\\\n  }\\\\n\\\\n  const confirmConfig = async () => {\\\\n    try {\\\\n      if (configDialogType.value === \\\\'create\\\\') {\\\\n        const request: CreatePaymentConfigRequest = {\\\\n          method: configForm.method,\\\\n          name: configForm.name,\\\\n          displayName: configForm.displayName,\\\\n          description: configForm.description,\\\\n          enabled: configForm.enabled,\\\\n          config: configForm.config\\\\n        }\\\\n        \\\\n        const response = await paymentAPI.createPaymentConfig(request)\\\\n        if (response.success) {\\\\n          ElMessage.success(\\\\'创建成功\\\\')\\\\n          showConfigDialog.value = false\\\\n          await loadPaymentConfigs()\\\\n        } else {\\\\n          ElMessage.error(response.message || \\\\'创建失败\\\\')\\\\n        }\\\\n      } else {\\\\n        const request: UpdatePaymentConfigRequest = {\\\\n          name: configForm.name,\\\\n          displayName: configForm.displayName,\\\\n          description: configForm.description,\\\\n          enabled: configForm.enabled,\\\\n          config: configForm.config\\\\n        }\\\\n        \\\\n        const response = await paymentAPI.updatePaymentConfig(configForm.id, request)\\\\n        if (response.success) {\\\\n          ElMessage.success(\\\\'更新成功\\\\')\\\\n          showConfigDialog.value = false\\\\n          await loadPaymentConfigs()\\\\n        } else {\\\\n          ElMessage.error(response.message || \\\\'更新失败\\\\')\\\\n        }\\\\n      }\\\\n    } catch (error) {\\\\n      ElMessage.error(\\\\'操作失败\\\\')\\\\n      console.error(\\\\'操作失败:\\\\', error)\\\\n    }\\\\n  }\\\\n\\\\n  const viewTransaction = async (transaction: PaymentTransaction) => {\\\\n    try {\\\\n      const response = await paymentAPI.getPaymentTransaction(transaction.id)\\\\n      if (response.success && response.data) {\\\\n        selectedTransaction.value = response.data\\\\n        showTransactionDialog.value = true\\\\n      } else {\\\\n        ElMessage.error(response.message || \\\\'获取交易详情失败\\\\')\\\\n      }\\\\n    } catch (error) {\\\\n      ElMessage.error(\\\\'获取交易详情失败\\\\')\\\\n      console.error(\\\\'获取交易详情失败:\\\\', error)\\\\n    }\\\\n  }\\\\n\\\\n  const createRefund = (transaction: PaymentTransaction) => {\\\\n    refundForm.transactionId = transaction.transactionId\\\\n    refundForm.amount = transaction.amount\\\\n    refundForm.reason = \\\\'\\\\'\\\\n    selectedTransaction.value = transaction\\\\n    showRefundDialog.value = true\\\\n  }\\\\n\\\\n  const confirmRefund = async () => {\\\\n    try {\\\\n      const request: CreateRefundRequest = {\\\\n        transactionId: refundForm.transactionId,\\\\n        amount: refundForm.amount,\\\\n        reason: refundForm.reason\\\\n      }\\\\n      \\\\n      const response = await paymentAPI.createRefund(request)\\\\n      if (response.success) {\\\\n        ElMessage.success(\\\\'退款申请成功\\\\')\\\\n        showRefundDialog.value = false\\\\n        await loadTransactions()\\\\n        await loadRefunds()\\\\n      } else {\\\\n        ElMessage.error(response.message || \\\\'退款申请失败\\\\')\\\\n      }\\\\n    } catch (error) {\\\\n      ElMessage.error(\\\\'退款申请失败\\\\')\\\\n      console.error(\\\\'退款申请失败:\\\\', error)\\\\n    }\\\\n  }\\\\n\\\\n  const exportTransactions = async () => {\\\\n    try {\\\\n      const response = await paymentAPI.exportTransactions(transactionFilter)\\\\n      if (response.success && response.data) {\\\\n        const blob = new Blob([response.data], { type: \\\\'application/vnd.ms-excel\\\\' })\\\\n        const link = document.createElement(\\\\'a\\\\')\\\\n        link.href = URL.createObjectURL(blob)\\\\n        link.download = `交易记录_${dayjs().format(\\\\'YYYY-MM-DD_HH-mm-ss\\\\')}.xlsx`\\\\n        link.click()\\\\n        ElMessage.success(\\\\'导出成功\\\\')\\\\n      } else {\\\\n        ElMessage.error(response.message || \\\\'导出失败\\\\')\\\\n      }\\\\n    } catch (error) {\\\\n      ElMessage.error(\\\\'导出失败\\\\')\\\\n      console.error(\\\\'导出失败:\\\\', error)\\\\n    }\\\\n  }\\\\n\\\\n  const exportRefunds = async () => {\\\\n    try {\\\\n      const response = await paymentAPI.exportRefunds(refundFilter)\\\\n      if (response.success && response.data) {\\\\n        const blob = new Blob([response.data], { type: \\\\'application/vnd.ms-excel\\\\' })\\\\n        const link = document.createElement(\\\\'a\\\\')\\\\n        link.href = URL.createObjectURL(blob)\\\\n        link.download = `退款记录_${dayjs().format(\\\\'YYYY-MM-DD_HH-mm-ss\\\\')}.xlsx`\\\\n        link.click()\\\\n        ElMessage.success(\\\\'导出成功\\\\')\\\\n      } else {\\\\n        ElMessage.error(response.message || \\\\'导出失败\\\\')\\\\n      }\\\\n    } catch (error) {\\\\n      ElMessage.error(\\\\'导出失败\\\\')\\\\n      console.error(\\\\'导出失败:\\\\', error)\\\\n    }\\\\n  }\\\\n\\\\n  const handleTransactionSearch = () => {\\\\n    transactionPagination.page = 1\\\\n    loadTransactions()\\\\n  }\\\\n\\\\n  const resetTransactionFilter = () => {\\\\n    Object.assign(transactionFilter, {\\\\n      search: \\\\'\\\\',\\\\n      paymentMethod: \\\\'\\\\' as PaymentMethod | \\\\'\\\\',\\\\n      status: \\\\'\\\\' as PaymentStatus | \\\\'\\\\',\\\\n      dateRange: [] as string[],\\\\n      minAmount: 0,\\\\n      maxAmount: 0\\\\n    })\\\\n    transactionPagination.page = 1\\\\n    loadTransactions()\\\\n  }\\\\n\\\\n  const handleRefundSearch = () => {\\\\n    refundPagination.page = 1\\\\n    loadRefunds()\\\\n  }\\\\n\\\\n  const resetRefundFilter = () => {\\\\n    Object.assign(refundFilter, {\\\\n      search: \\\\'\\\\',\\\\n      status: \\\\'\\\\' as RefundStatus | \\\\'\\\\',\\\\n      dateRange: [] as string[]\\\\n    })\\\\n    refundPagination.page = 1\\\\n    loadRefunds()\\\\n  }\\\\n\\\\n  const handleTransactionPageChange = (page: number) => {\\\\n    transactionPagination.page = page\\\\n    loadTransactions()\\\\n  }\\\\n\\\\n  const handleTransactionPageSizeChange = (pageSize: number) => {\\\\n    transactionPagination.limit = pageSize\\\\n    transactionPagination.page = 1\\\\n    loadTransactions()\\\\n  }\\\\n\\\\n  const handleRefundPageChange = (page: number) => {\\\\n    refundPagination.page = page\\\\n    loadRefunds()\\\\n  }\\\\n\\\\n  const handleRefundPageSizeChange = (pageSize: number) => {\\\\n    refundPagination.limit = pageSize\\\\n    refundPagination.page = 1\\\\n    loadRefunds()\\\\n  }\\\\n\\\\n  const handleTabChange = (tabName: string) => {\\\\n    activeTab.value = tabName as any\\\\n    if (tabName === \\\\'configs\\\\') {\\\\n      loadPaymentConfigs()\\\\n    } else if (tabName === \\\\'transactions\\\\') {\\\\n      loadTransactions()\\\\n    } else if (tabName === \\\\'refunds\\\\') {\\\\n      loadRefunds()\\\\n    }\\\\n  }\\\\n\\\\n  const formatNumber = (num: number): string => {\\\\n    return num.toLocaleString(\\\\'zh-CN\\\\', { minimumFractionDigits: 2, maximumFractionDigits: 2 })\\\\n  }\\\\n\\\\n  const formatDateTime = (date: string): string => {\\\\n    return dayjs(date).format(\\\\'YYYY-MM-DD HH:mm:ss\\\\')\\\\n  }\\\\n\\\\n  const getPaymentMethodName = (method: PaymentMethod): string => {\\\\n    const names: Record<PaymentMethod, string> = {\\\\n      [PaymentMethod.ALIPAY]: \\\\'支付宝\\\\',\\\\n      [PaymentMethod.WECHAT]: \\\\'微信支付\\\\',\\\\n      [PaymentMethod.UNIONPAY]: \\\\'银联支付\\\\',\\\\n      [PaymentMethod.CASH]: \\\\'现金\\\\',\\\\n      [PaymentMethod.CREDIT_CARD]: \\\\'银行卡\\\\',\\\\n      [PaymentMethod.DEBIT_CARD]: \\\\'借记卡\\\\',\\\\n      [PaymentMethod.DIGITAL_WALLET]: \\\\'数字钱包\\\\',\\\\n      [PaymentMethod.MEMBER_BALANCE]: \\\\'会员余额\\\\'\\\\n    }\\\\n    return names[method] || method\\\\n  }\\\\n\\\\n  const getPaymentStatusName = (status: PaymentStatus): string => {\\\\n    const names: Record<PaymentStatus, string> = {\\\\n      [PaymentStatus.PENDING]: \\\\'待支付\\\\',\\\\n      [PaymentStatus.PROCESSING]: \\\\'处理中\\\\',\\\\n      [PaymentStatus.SUCCESS]: \\\\'成功\\\\',\\\\n      [PaymentStatus.FAILED]: \\\\'失败\\\\',\\\\n      [PaymentStatus.CANCELLED]: \\\\'已取消\\\\',\\\\n      [PaymentStatus.REFUNDED]: \\\\'已退款\\\\',\\\\n      [PaymentStatus.PARTIALLY_REFUNDED]: \\\\'部分退款\\\\'\\\\n    }\\\\n    return names[status] || status\\\\n  }\\\\n\\\\n  const getPaymentStatusType = (status: PaymentStatus): string => {\\\\n    const types: Record<PaymentStatus, string> = {\\\\n      [PaymentStatus.PENDING]: \\\\'info\\\\',\\\\n      [PaymentStatus.PROCESSING]: \\\\'warning\\\\',\\\\n      [PaymentStatus.SUCCESS]: \\\\'success\\\\',\\\\n      [PaymentStatus.FAILED]: \\\\'danger\\\\',\\\\n      [PaymentStatus.CANCELLED]: \\\\'info\\\\',\\\\n      [PaymentStatus.REFUNDED]: \\\\'warning\\\\',\\\\n      [PaymentStatus.PARTIALLY_REFUNDED]: \\\\'warning\\\\'\\\\n    }\\\\n    return types[status] || \\\\'info\\\\'\\\\n  }\\\\n\\\\n  const getRefundStatusName = (status: RefundStatus): string => {\\\\n    const names: Record<RefundStatus, string> = {\\\\n      [RefundStatus.PENDING]: \\\\'待处理\\\\',\\\\n      [RefundStatus.PROCESSING]: \\\\'处理中\\\\',\\\\n      [RefundStatus.SUCCESS]: \\\\'成功\\\\',\\\\n      [RefundStatus.FAILED]: \\\\'失败\\\\',\\\\n      [RefundStatus.CANCELLED]: \\\\'已取消\\\\'\\\\n    }\\\\n    return names[status] || status\\\\n  }\\\\n\\\\n  const getRefundStatusType = (status: RefundStatus): string => {\\\\n    const types: Record<RefundStatus, string> = {\\\\n      [RefundStatus.PENDING]: \\\\'info\\\\',\\\\n      [RefundStatus.PROCESSING]: \\\\'warning\\\\',\\\\n      [RefundStatus.SUCCESS]: \\\\'success\\\\',\\\\n      [RefundStatus.FAILED]: \\\\'danger\\\\',\\\\n      [RefundStatus.CANCELLED]: \\\\'info\\\\'\\\\n    }\\\\n    return types[status] || \\\\'info\\\\'\\\\n  }\\\\n\\\\n  return {\\\\n    loading,\\\\n    activeTab,\\\\n    paymentConfigs,\\\\n    transactions,\\\\n    refunds,\\\\n    paymentStats,\\\\n    selectedConfig,\\\\n    selectedTransaction,\\\\n    selectedRefund,\\\\n    showConfigDialog,\\\\n    showTransactionDialog,\\\\n    showRefundDialog,\\\\n    configDialogType,\\\\n    configForm,\\\\n    refundForm,\\\\n    transactionPagination,\\\\n    refundPagination,\\\\n    transactionFilter,\\\\n    refundFilter,\\\\n    configsLoading,\\\\n    transactionsLoading,\\\\n    refundsLoading,\\\\n    loadPaymentConfigs,\\\\n    loadTransactions,\\\\n    loadRefunds,\\\\n    loadPaymentStats,\\\\n    handleAddConfig,\\\\n    handleEditConfig,\\\\n    handleDeleteConfig,\\\\n    handleToggleConfig,\\\\n    testPaymentConfig,\\\\n    confirmConfig,\\\\n    viewTransaction,\\\\n    createRefund,\\\\n    confirmRefund,\\\\n    exportTransactions,\\\\n    exportRefunds,\\\\n    handleTransactionSearch,\\\\n    resetTransactionFilter,\\\\n    handleRefundSearch,\\\\n    resetRefundFilter,\\\\n    handleTransactionPageChange,\\\\n    handleTransactionPageSizeChange,\\\\n    handleRefundPageChange,\\\\n    handleRefundPageSizeChange,\\\\n    handleTabChange,\\\\n    formatNumber,\\\\n    formatDateTime,\\\\n    getPaymentMethodName,\\\\n    getPaymentStatusName,\\\\n    getPaymentStatusType,\\\\n    getRefundStatusName,\\\\n    getRefundStatusType\\\\n  }\\\\n}\\\\n\",\"originAcceptText\":\"/**\\n * @fileoverview 支付管理Composable\\n * @description 管理支付管理功能的状态和逻辑\\n * @module usePayment\\n * @author YYC³\\n * @version 1.0.0\\n * @created 2025-01-20\\n */\\n\\nimport { ref, reactive, computed } from 'vue'\\nimport { ElMessage, ElMessageBox } from 'element-plus'\\nimport dayjs from 'dayjs'\\nimport { \\n  PaymentAPI, \\n  PaymentMethod, \\n  PaymentStatus, \\n  RefundStatus,\\n  type PaymentConfig, \\n  type PaymentTransaction, \\n  type RefundRecord, \\n  type PaymentStats,\\n  type CreatePaymentConfigRequest,\\n  type UpdatePaymentConfigRequest,\\n  type CreateRefundRequest,\\n  type PaymentQueryParams\\n} from '@/api/payment'\\n\\nconst paymentAPI = new PaymentAPI()\\n\\nexport function usePayment() {\\n  const loading = ref(false)\\n  const activeTab = ref<'configs' | 'transactions' | 'refunds'>('configs')\\n\\n  const paymentConfigs = ref<PaymentConfig[]>([])\\n  const transactions = ref<PaymentTransaction[]>([])\\n  const refunds = ref<RefundRecord[]>([])\\n  const paymentStats = ref<PaymentStats | null>(null)\\n\\n  const selectedConfig = ref<PaymentConfig | null>(null)\\n  const selectedTransaction = ref<PaymentTransaction | null>(null)\\n  const selectedRefund = ref<RefundRecord | null>(null)\\n\\n  const showConfigDialog = ref(false)\\n  const showTransactionDialog = ref(false)\\n  const showRefundDialog = ref(false)\\n\\n  const configDialogType = ref<'create' | 'edit'>('create')\\n\\n  const configForm = reactive({\\n    id: 0,\\n    method: PaymentMethod.ALIPAY,\\n    name: '',\\n    displayName: '',\\n    description: '',\\n    enabled: true,\\n    config: {\\n      appId: '',\\n      merchantId: '',\\n      apiKey: '',\\n      apiSecret: '',\\n      publicKey: '',\\n      privateKey: '',\\n      notifyUrl: '',\\n      returnUrl: '',\\n      supportedCurrencies: ['CNY'],\\n      minAmount: 0,\\n      maxAmount: 100000,\\n      feeRate: 0,\\n      fixedFee: 0\\n    }\\n  })\\n\\n  const refundForm = reactive({\\n    transactionId: '',\\n    amount: 0,\\n    reason: ''\\n  })\\n\\n  const transactionPagination = reactive({\\n    page: 1,\\n    limit: 20,\\n    total: 0\\n  })\\n\\n  const refundPagination = reactive({\\n    page: 1,\\n    limit: 20,\\n    total: 0\\n  })\\n\\n  const transactionFilter = reactive({\\n    search: '',\\n    paymentMethod: '' as PaymentMethod | '',\\n    status: '' as PaymentStatus | '',\\n    dateRange: [] as string[],\\n    minAmount: 0,\\n    maxAmount: 0\\n  })\\n\\n  const refundFilter = reactive({\\n    search: '',\\n    status: '' as RefundStatus | '',\\n    dateRange: [] as string[]\\n  })\\n\\n  const configsLoading = computed(() => loading.value && activeTab.value === 'configs')\\n  const transactionsLoading = computed(() => loading.value && activeTab.value === 'transactions')\\n  const refundsLoading = computed(() => loading.value && activeTab.value === 'refunds')\\n\\n  const loadPaymentConfigs = async () => {\\n    try {\\n      loading.value = true\\n      const response = await paymentAPI.getPaymentConfigs()\\n      if (response.success && response.data) {\\n        paymentConfigs.value = response.data\\n      } else {\\n        ElMessage.error(response.message || '加载支付配置失败')\\n      }\\n    } catch (error) {\\n      ElMessage.error('加载支付配置失败')\\n      console.error('加载支付配置失败:', error)\\n    } finally {\\n      loading.value = false\\n    }\\n  }\\n\\n  const loadTransactions = async () => {\\n    try {\\n      loading.value = true\\n      const params: PaymentQueryParams = {\\n        page: transactionPagination.page,\\n        limit: transactionPagination.limit,\\n        search: transactionFilter.search || undefined,\\n        paymentMethod: transactionFilter.paymentMethod || undefined,\\n        status: transactionFilter.status || undefined,\\n        startDate: transactionFilter.dateRange[0] || undefined,\\n        endDate: transactionFilter.dateRange[1] || undefined,\\n        minAmount: transactionFilter.minAmount || undefined,\\n        maxAmount: transactionFilter.maxAmount || undefined,\\n        sortBy: 'createdAt',\\n        sortOrder: 'desc'\\n      }\\n      \\n      const response = await paymentAPI.getPaymentTransactions(params)\\n      if (response.success && response.data) {\\n        transactions.value = response.data.items\\n        transactionPagination.total = response.data.pagination.total\\n      } else {\\n        ElMessage.error(response.message || '加载交易记录失败')\\n      }\\n    } catch (error) {\\n      ElMessage.error('加载交易记录失败')\\n      console.error('加载交易记录失败:', error)\\n    } finally {\\n      loading.value = false\\n    }\\n  }\\n\\n  const loadRefunds = async () => {\\n    try {\\n      loading.value = true\\n      const params: PaymentQueryParams = {\\n        page: refundPagination.page,\\n        limit: refundPagination.limit,\\n        search: refundFilter.search || undefined,\\n        startDate: refundFilter.dateRange[0] || undefined,\\n        endDate: refundFilter.dateRange[1] || undefined\\n      }\\n      \\n      const response = await paymentAPI.getRefundRecords(params)\\n      if (response.success && response.data) {\\n        refunds.value = response.data.items\\n        refundPagination.total = response.data.pagination.total\\n      } else {\\n        ElMessage.error(response.message || '加载退款记录失败')\\n      }\\n    } catch (error) {\\n      ElMessage.error('加载退款记录失败')\\n      console.error('加载退款记录失败:', error)\\n    } finally {\\n      loading.value = false\\n    }\\n  }\\n\\n  const loadPaymentStats = async () => {\\n    try {\\n      const response = await paymentAPI.getPaymentStats()\\n      if (response.success && response.data) {\\n        paymentStats.value = response.data\\n      } else {\\n        ElMessage.error(response.message || '加载支付统计失败')\\n      }\\n    } catch (error) {\\n      ElMessage.error('加载支付统计失败')\\n      console.error('加载支付统计失败:', error)\\n    }\\n  }\\n\\n  const handleAddConfig = () => {\\n    configDialogType.value = 'create'\\n    Object.assign(configForm, {\\n      id: 0,\\n      method: PaymentMethod.ALIPAY,\\n      name: '',\\n      displayName: '',\\n      description: '',\\n      enabled: true,\\n      config: {\\n        appId: '',\\n        merchantId: '',\\n        apiKey: '',\\n        apiSecret: '',\\n        publicKey: '',\\n        privateKey: '',\\n        notifyUrl: '',\\n        returnUrl: '',\\n        supportedCurrencies: ['CNY'],\\n        minAmount: 0,\\n        maxAmount: 100000,\\n        feeRate: 0,\\n        fixedFee: 0\\n      }\\n    })\\n    showConfigDialog.value = true\\n  }\\n\\n  const handleEditConfig = (config: PaymentConfig) => {\\n    configDialogType.value = 'edit'\\n    Object.assign(configForm, {\\n      id: config.id,\\n      method: config.method,\\n      name: config.name,\\n      displayName: config.displayName,\\n      description: config.description || '',\\n      enabled: config.enabled,\\n      config: { ...config.config }\\n    })\\n    selectedConfig.value = config\\n    showConfigDialog.value = true\\n  }\\n\\n  const handleDeleteConfig = async (config: PaymentConfig) => {\\n    try {\\n      await ElMessageBox.confirm(`确定要删除支付配置 \\\"${config.displayName}\\\" 吗？`, '提示', {\\n        confirmButtonText: '确定',\\n        cancelButtonText: '取消',\\n        type: 'warning'\\n      })\\n      \\n      const response = await paymentAPI.deletePaymentConfig(config.id)\\n      if (response.success) {\\n        ElMessage.success('删除成功')\\n        await loadPaymentConfigs()\\n      } else {\\n        ElMessage.error(response.message || '删除失败')\\n      }\\n    } catch (error) {\\n      if (error !== 'cancel') {\\n        ElMessage.error('删除失败')\\n        console.error('删除失败:', error)\\n      }\\n    }\\n  }\\n\\n  const handleToggleConfig = async (config: PaymentConfig) => {\\n    try {\\n      const response = await paymentAPI.togglePaymentConfig(config.id, !config.enabled)\\n      if (response.success) {\\n        config.enabled = !config.enabled\\n        ElMessage.success(config.enabled ? '启用成功' : '禁用成功')\\n      } else {\\n        ElMessage.error(response.message || '操作失败')\\n      }\\n    } catch (error) {\\n      ElMessage.error('操作失败')\\n      console.error('操作失败:', error)\\n    }\\n  }\\n\\n  const testPaymentConfig = async (config: PaymentConfig) => {\\n    try {\\n      const response = await paymentAPI.testPaymentConfig(config.id)\\n      if (response.success) {\\n        ElMessage.success('测试连接成功')\\n      } else {\\n        ElMessage.error(response.message || '测试连接失败')\\n      }\\n    } catch (error) {\\n      ElMessage.error('测试连接失败')\\n      console.error('测试连接失败:', error)\\n    }\\n  }\\n\\n  const confirmConfig = async () => {\\n    try {\\n      if (configDialogType.value === 'create') {\\n        const request: CreatePaymentConfigRequest = {\\n          method: configForm.method,\\n          name: configForm.name,\\n          displayName: configForm.displayName,\\n          description: configForm.description,\\n          enabled: configForm.enabled,\\n          config: configForm.config\\n        }\\n        \\n        const response = await paymentAPI.createPaymentConfig(request)\\n        if (response.success) {\\n          ElMessage.success('创建成功')\\n          showConfigDialog.value = false\\n          await loadPaymentConfigs()\\n        } else {\\n          ElMessage.error(response.message || '创建失败')\\n        }\\n      } else {\\n        const request: UpdatePaymentConfigRequest = {\\n          name: configForm.name,\\n          displayName: configForm.displayName,\\n          description: configForm.description,\\n          enabled: configForm.enabled,\\n          config: configForm.config\\n        }\\n        \\n        const response = await paymentAPI.updatePaymentConfig(configForm.id, request)\\n        if (response.success) {\\n          ElMessage.success('更新成功')\\n          showConfigDialog.value = false\\n          await loadPaymentConfigs()\\n        } else {\\n          ElMessage.error(response.message || '更新失败')\\n        }\\n      }\\n    } catch (error) {\\n      ElMessage.error('操作失败')\\n      console.error('操作失败:', error)\\n    }\\n  }\\n\\n  const viewTransaction = async (transaction: PaymentTransaction) => {\\n    try {\\n      const response = await paymentAPI.getPaymentTransaction(transaction.id)\\n      if (response.success && response.data) {\\n        selectedTransaction.value = response.data\\n        showTransactionDialog.value = true\\n      } else {\\n        ElMessage.error(response.message || '获取交易详情失败')\\n      }\\n    } catch (error) {\\n      ElMessage.error('获取交易详情失败')\\n      console.error('获取交易详情失败:', error)\\n    }\\n  }\\n\\n  const createRefund = (transaction: PaymentTransaction) => {\\n    refundForm.transactionId = transaction.transactionId\\n    refundForm.amount = transaction.amount\\n    refundForm.reason = ''\\n    selectedTransaction.value = transaction\\n    showRefundDialog.value = true\\n  }\\n\\n  const confirmRefund = async () => {\\n    try {\\n      const request: CreateRefundRequest = {\\n        transactionId: refundForm.transactionId,\\n        amount: refundForm.amount,\\n        reason: refundForm.reason\\n      }\\n      \\n      const response = await paymentAPI.createRefund(request)\\n      if (response.success) {\\n        ElMessage.success('退款申请成功')\\n        showRefundDialog.value = false\\n        await loadTransactions()\\n        await loadRefunds()\\n      } else {\\n        ElMessage.error(response.message || '退款申请失败')\\n      }\\n    } catch (error) {\\n      ElMessage.error('退款申请失败')\\n      console.error('退款申请失败:', error)\\n    }\\n  }\\n\\n  const exportTransactions = async () => {\\n    try {\\n      const response = await paymentAPI.exportTransactions(transactionFilter)\\n      if (response.success && response.data) {\\n        const blob = new Blob([response.data], { type: 'application/vnd.ms-excel' })\\n        const link = document.createElement('a')\\n        link.href = URL.createObjectURL(blob)\\n        link.download = `交易记录_${dayjs().format('YYYY-MM-DD_HH-mm-ss')}.xlsx`\\n        link.click()\\n        ElMessage.success('导出成功')\\n      } else {\\n        ElMessage.error(response.message || '导出失败')\\n      }\\n    } catch (error) {\\n      ElMessage.error('导出失败')\\n      console.error('导出失败:', error)\\n    }\\n  }\\n\\n  const exportRefunds = async () => {\\n    try {\\n      const response = await paymentAPI.exportRefunds(refundFilter)\\n      if (response.success && response.data) {\\n        const blob = new Blob([response.data], { type: 'application/vnd.ms-excel' })\\n        const link = document.createElement('a')\\n        link.href = URL.createObjectURL(blob)\\n        link.download = `退款记录_${dayjs().format('YYYY-MM-DD_HH-mm-ss')}.xlsx`\\n        link.click()\\n        ElMessage.success('导出成功')\\n      } else {\\n        ElMessage.error(response.message || '导出失败')\\n      }\\n    } catch (error) {\\n      ElMessage.error('导出失败')\\n      console.error('导出失败:', error)\\n    }\\n  }\\n\\n  const handleTransactionSearch = () => {\\n    transactionPagination.page = 1\\n    loadTransactions()\\n  }\\n\\n  const resetTransactionFilter = () => {\\n    Object.assign(transactionFilter, {\\n      search: '',\\n      paymentMethod: '' as PaymentMethod | '',\\n      status: '' as PaymentStatus | '',\\n      dateRange: [] as string[],\\n      minAmount: 0,\\n      maxAmount: 0\\n    })\\n    transactionPagination.page = 1\\n    loadTransactions()\\n  }\\n\\n  const handleRefundSearch = () => {\\n    refundPagination.page = 1\\n    loadRefunds()\\n  }\\n\\n  const resetRefundFilter = () => {\\n    Object.assign(refundFilter, {\\n      search: '',\\n      status: '' as RefundStatus | '',\\n      dateRange: [] as string[]\\n    })\\n    refundPagination.page = 1\\n    loadRefunds()\\n  }\\n\\n  const handleTransactionPageChange = (page: number) => {\\n    transactionPagination.page = page\\n    loadTransactions()\\n  }\\n\\n  const handleTransactionPageSizeChange = (pageSize: number) => {\\n    transactionPagination.limit = pageSize\\n    transactionPagination.page = 1\\n    loadTransactions()\\n  }\\n\\n  const handleRefundPageChange = (page: number) => {\\n    refundPagination.page = page\\n    loadRefunds()\\n  }\\n\\n  const handleRefundPageSizeChange = (pageSize: number) => {\\n    refundPagination.limit = pageSize\\n    refundPagination.page = 1\\n    loadRefunds()\\n  }\\n\\n  const handleTabChange = (tabName: string) => {\\n    activeTab.value = tabName as any\\n    if (tabName === 'configs') {\\n      loadPaymentConfigs()\\n    } else if (tabName === 'transactions') {\\n      loadTransactions()\\n    } else if (tabName === 'refunds') {\\n      loadRefunds()\\n    }\\n  }\\n\\n  const formatNumber = (num: number): string => {\\n    return num.toLocaleString('zh-CN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })\\n  }\\n\\n  const formatDateTime = (date: string): string => {\\n    return dayjs(date).format('YYYY-MM-DD HH:mm:ss')\\n  }\\n\\n  const getPaymentMethodName = (method: PaymentMethod): string => {\\n    const names: Record<PaymentMethod, string> = {\\n      [PaymentMethod.ALIPAY]: '支付宝',\\n      [PaymentMethod.WECHAT]: '微信支付',\\n      [PaymentMethod.UNIONPAY]: '银联支付',\\n      [PaymentMethod.CASH]: '现金',\\n      [PaymentMethod.CREDIT_CARD]: '银行卡',\\n      [PaymentMethod.DEBIT_CARD]: '借记卡',\\n      [PaymentMethod.DIGITAL_WALLET]: '数字钱包',\\n      [PaymentMethod.MEMBER_BALANCE]: '会员余额'\\n    }\\n    return names[method] || method\\n  }\\n\\n  const getPaymentStatusName = (status: PaymentStatus): string => {\\n    const names: Record<PaymentStatus, string> = {\\n      [PaymentStatus.PENDING]: '待支付',\\n      [PaymentStatus.PROCESSING]: '处理中',\\n      [PaymentStatus.SUCCESS]: '成功',\\n      [PaymentStatus.FAILED]: '失败',\\n      [PaymentStatus.CANCELLED]: '已取消',\\n      [PaymentStatus.REFUNDED]: '已退款',\\n      [PaymentStatus.PARTIALLY_REFUNDED]: '部分退款'\\n    }\\n    return names[status] || status\\n  }\\n\\n  const getPaymentStatusType = (status: PaymentStatus): string => {\\n    const types: Record<PaymentStatus, string> = {\\n      [PaymentStatus.PENDING]: 'info',\\n      [PaymentStatus.PROCESSING]: 'warning',\\n      [PaymentStatus.SUCCESS]: 'success',\\n      [PaymentStatus.FAILED]: 'danger',\\n      [PaymentStatus.CANCELLED]: 'info',\\n      [PaymentStatus.REFUNDED]: 'warning',\\n      [PaymentStatus.PARTIALLY_REFUNDED]: 'warning'\\n    }\\n    return types[status] || 'info'\\n  }\\n\\n  const getRefundStatusName = (status: RefundStatus): string => {\\n    const names: Record<RefundStatus, string> = {\\n      [RefundStatus.PENDING]: '待处理',\\n      [RefundStatus.PROCESSING]: '处理中',\\n      [RefundStatus.SUCCESS]: '成功',\\n      [RefundStatus.FAILED]: '失败',\\n      [RefundStatus.CANCELLED]: '已取消'\\n    }\\n    return names[status] || status\\n  }\\n\\n  const getRefundStatusType = (status: RefundStatus): string => {\\n    const types: Record<RefundStatus, string> = {\\n      [RefundStatus.PENDING]: 'info',\\n      [RefundStatus.PROCESSING]: 'warning',\\n      [RefundStatus.SUCCESS]: 'success',\\n      [RefundStatus.FAILED]: 'danger',\\n      [RefundStatus.CANCELLED]: 'info'\\n    }\\n    return types[status] || 'info'\\n  }\\n\\n  return {\\n    loading,\\n    activeTab,\\n    paymentConfigs,\\n    transactions,\\n    refunds,\\n    paymentStats,\\n    selectedConfig,\\n    selectedTransaction,\\n    selectedRefund,\\n    showConfigDialog,\\n    showTransactionDialog,\\n    showRefundDialog,\\n    configDialogType,\\n    configForm,\\n    refundForm,\\n    transactionPagination,\\n    refundPagination,\\n    transactionFilter,\\n    refundFilter,\\n    configsLoading,\\n    transactionsLoading,\\n    refundsLoading,\\n    loadPaymentConfigs,\\n    loadTransactions,\\n    loadRefunds,\\n    loadPaymentStats,\\n    handleAddConfig,\\n    handleEditConfig,\\n    handleDeleteConfig,\\n    handleToggleConfig,\\n    testPaymentConfig,\\n    confirmConfig,\\n    viewTransaction,\\n    createRefund,\\n    confirmRefund,\\n    exportTransactions,\\n    exportRefunds,\\n    handleTransactionSearch,\\n    resetTransactionFilter,\\n    handleRefundSearch,\\n    resetRefundFilter,\\n    handleTransactionPageChange,\\n    handleTransactionPageSizeChange,\\n    handleRefundPageChange,\\n    handleRefundPageSizeChange,\\n    handleTabChange,\\n    formatNumber,\\n    formatDateTime,\\n    getPaymentMethodName,\\n    getPaymentStatusName,\\n    getPaymentStatusType,\\n    getRefundStatusName,\\n    getRefundStatusType\\n  }\\n}\\n\",\"originTextLength\":17323,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768882423452}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/views/__tests__/PaymentManagement.test.ts": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":618,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":618,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"/**\\\\n * @fileoverview 支付管理组件单元测试\\\\n * @description 测试支付管理组件的功能\\\\n * @module PaymentManagement.test\\\\n * @author YYC³\\\\n * @version 1.0.0\\\\n * @created 2025-01-20\\\\n */\\\\n\\\\nimport { describe, it, expect, beforeEach, vi } from \\\\'vitest\\\\'\\\\nimport { mount, VueWrapper } from \\\\'@vue/test-utils\\\\'\\\\nimport { createPinia, setActivePinia } from \\\\'pinia\\\\'\\\\nimport ElementPlus from \\\\'element-plus\\\\'\\\\nimport PaymentManagement from \\\\'@/views/PaymentManagement.vue\\\\'\\\\nimport { PaymentAPI, PaymentMethod, PaymentStatus } from \\\\'@/api/payment\\\\'\\\\n\\\\nvi.mock(\\\\'@/api/payment\\\\', () => ({\\\\n  PaymentAPI: vi.fn().mockImplementation(() => ({\\\\n    getPaymentConfigs: vi.fn(() => Promise.resolve({\\\\n      success: true,\\\\n      data: [\\\\n        {\\\\n          id: 1,\\\\n          method: PaymentMethod.ALIPAY,\\\\n          name: \\\\'支付宝配置\\\\',\\\\n          displayName: \\\\'支付宝\\\\',\\\\n          description: \\\\'支付宝支付配置\\\\',\\\\n          enabled: true,\\\\n          config: {\\\\n            appId: \\\\'test_app_id\\\\',\\\\n            merchantId: \\\\'test_merchant_id\\\\',\\\\n            apiKey: \\\\'test_api_key\\\\',\\\\n            apiSecret: \\\\'test_api_secret\\\\',\\\\n            notifyUrl: \\\\'https://example.com/notify\\\\',\\\\n            returnUrl: \\\\'https://example.com/return\\\\',\\\\n            supportedCurrencies: [\\\\'CNY\\\\'],\\\\n            minAmount: 0.01,\\\\n            maxAmount: 100000,\\\\n            feeRate: 0.006,\\\\n            fixedFee: 0\\\\n          },\\\\n          createdAt: \\\\'2024-01-01T00:00:00Z\\\\'\\\\n        },\\\\n        {\\\\n          id: 2,\\\\n          method: PaymentMethod.WECHAT,\\\\n          name: \\\\'微信支付配置\\\\',\\\\n          displayName: \\\\'微信支付\\\\',\\\\n          description: \\\\'微信支付配置\\\\',\\\\n          enabled: true,\\\\n          config: {\\\\n            appId: \\\\'test_app_id\\\\',\\\\n            merchantId: \\\\'test_merchant_id\\\\',\\\\n            apiKey: \\\\'test_api_key\\\\',\\\\n            apiSecret: \\\\'test_api_secret\\\\',\\\\n            notifyUrl: \\\\'https://example.com/notify\\\\',\\\\n            returnUrl: \\\\'https://example.com/return\\\\',\\\\n            supportedCurrencies: [\\\\'CNY\\\\'],\\\\n            minAmount: 0.01,\\\\n            maxAmount: 100000,\\\\n            feeRate: 0.006,\\\\n            fixedFee: 0\\\\n          },\\\\n          createdAt: \\\\'2024-01-01T00:00:00Z\\\\'\\\\n        }\\\\n      ]\\\\n    })),\\\\n    getPaymentTransactions: vi.fn(() => Promise.resolve({\\\\n      success: true,\\\\n      data: {\\\\n        items: [\\\\n          {\\\\n            id: 1,\\\\n            transactionId: \\\\'TXN001\\\\',\\\\n            orderId: \\\\'ORD001\\\\',\\\\n            paymentMethod: PaymentMethod.ALIPAY,\\\\n            amount: 100,\\\\n            currency: \\\\'CNY\\\\',\\\\n            status: PaymentStatus.SUCCESS,\\\\n            paymentTime: \\\\'2024-01-01T12:00:00Z\\\\',\\\\n            createdAt: \\\\'2024-01-01T12:00:00Z\\\\'\\\\n          },\\\\n          {\\\\n            id: 2,\\\\n            transactionId: \\\\'TXN002\\\\',\\\\n            orderId: \\\\'ORD002\\\\',\\\\n            paymentMethod: PaymentMethod.WECHAT,\\\\n            amount: 200,\\\\n            currency: \\\\'CNY\\\\',\\\\n            status: PaymentStatus.SUCCESS,\\\\n            paymentTime: \\\\'2024-01-01T13:00:00Z\\\\',\\\\n            createdAt: \\\\'2024-01-01T13:00:00Z\\\\'\\\\n          }\\\\n        ],\\\\n        pagination: {\\\\n          page: 1,\\\\n          limit: 20,\\\\n          total: 2,\\\\n          totalPages: 1\\\\n        }\\\\n      }\\\\n    })),\\\\n    getRefundRecords: vi.fn(() => Promise.resolve({\\\\n      success: true,\\\\n      data: {\\\\n        items: [\\\\n          {\\\\n            id: 1,\\\\n            refundId: \\\\'REF001\\\\',\\\\n            transactionId: \\\\'TXN001\\\\',\\\\n            orderId: \\\\'ORD001\\\\',\\\\n            amount: 50,\\\\n            reason: \\\\'用户申请退款\\\\',\\\\n            status: \\\\'success\\\\',\\\\n            processedAt: \\\\'2024-01-01T14:00:00Z\\\\',\\\\n            createdAt: \\\\'2024-01-01T14:00:00Z\\\\'\\\\n          }\\\\n        ],\\\\n        pagination: {\\\\n          page: 1,\\\\n          limit: 20,\\\\n          total: 1,\\\\n          totalPages: 1\\\\n        }\\\\n      }\\\\n    })),\\\\n    getPaymentStats: vi.fn(() => Promise.resolve({\\\\n      success: true,\\\\n      data: {\\\\n        totalTransactions: 2,\\\\n        totalRevenue: { CNY: 300 },\\\\n        totalRefunds: { CNY: 50 },\\\\n        netRevenue: { CNY: 250 },\\\\n        successRate: 1,\\\\n        averageOrderValue: { CNY: 150 },\\\\n        transactionsByMethod: {\\\\n          [PaymentMethod.ALIPAY]: { count: 1, amount: 100, successRate: 1 },\\\\n          [PaymentMethod.WECHAT]: { count: 1, amount: 200, successRate: 1 },\\\\n          [PaymentMethod.UNIONPAY]: { count: 0, amount: 0, successRate: 0 },\\\\n          [PaymentMethod.CASH]: { count: 0, amount: 0, successRate: 0 },\\\\n          [PaymentMethod.CREDIT_CARD]: { count: 0, amount: 0, successRate: 0 },\\\\n          [PaymentMethod.DEBIT_CARD]: { count: 0, amount: 0, successRate: 0 },\\\\n          [PaymentMethod.DIGITAL_WALLET]: { count: 0, amount: 0, successRate: 0 },\\\\n          [PaymentMethod.MEMBER_BALANCE]: { count: 0, amount: 0, successRate: 0 }\\\\n        },\\\\n        dailyStats: [\\\\n          {\\\\n            date: \\\\'2024-01-01\\\\',\\\\n            revenue: 300,\\\\n            transactions: 2,\\\\n            refunds: 1\\\\n          }\\\\n        ],\\\\n        monthlyStats: [\\\\n          {\\\\n            month: \\\\'2024-01\\\\',\\\\n            revenue: 300,\\\\n            transactions: 2,\\\\n            refunds: 1\\\\n          }\\\\n        ]\\\\n      }\\\\n    })),\\\\n    createPaymentConfig: vi.fn(() => Promise.resolve({\\\\n      success: true,\\\\n      data: {\\\\n        id: 3,\\\\n        method: PaymentMethod.ALIPAY,\\\\n        name: \\\\'新支付宝配置\\\\',\\\\n        displayName: \\\\'新支付宝\\\\',\\\\n        description: \\\\'新支付宝支付配置\\\\',\\\\n        enabled: true,\\\\n        config: {\\\\n          appId: \\\\'new_app_id\\\\',\\\\n          merchantId: \\\\'new_merchant_id\\\\',\\\\n          apiKey: \\\\'new_api_key\\\\',\\\\n          apiSecret: \\\\'new_api_secret\\\\',\\\\n          notifyUrl: \\\\'https://example.com/notify\\\\',\\\\n          returnUrl: \\\\'https://example.com/return\\\\',\\\\n          supportedCurrencies: [\\\\'CNY\\\\'],\\\\n          minAmount: 0.01,\\\\n          maxAmount: 100000,\\\\n          feeRate: 0.006,\\\\n          fixedFee: 0\\\\n        },\\\\n        createdAt: \\\\'2024-01-01T00:00:00Z\\\\'\\\\n      }\\\\n    })),\\\\n    updatePaymentConfig: vi.fn(() => Promise.resolve({\\\\n      success: true,\\\\n      data: {\\\\n        id: 1,\\\\n        method: PaymentMethod.ALIPAY,\\\\n        name: \\\\'更新后的支付宝配置\\\\',\\\\n        displayName: \\\\'支付宝\\\\',\\\\n        description: \\\\'更新后的支付宝支付配置\\\\',\\\\n        enabled: true,\\\\n        config: {\\\\n          appId: \\\\'updated_app_id\\\\',\\\\n          merchantId: \\\\'updated_merchant_id\\\\',\\\\n          apiKey: \\\\'updated_api_key\\\\',\\\\n          apiSecret: \\\\'updated_api_secret\\\\',\\\\n          notifyUrl: \\\\'https://example.com/notify\\\\',\\\\n          returnUrl: \\\\'https://example.com/return\\\\',\\\\n          supportedCurrencies: [\\\\'CNY\\\\'],\\\\n          minAmount: 0.01,\\\\n          maxAmount: 100000,\\\\n          feeRate: 0.006,\\\\n          fixedFee: 0\\\\n        },\\\\n        createdAt: \\\\'2024-01-01T00:00:00Z\\\\'\\\\n      }\\\\n    })),\\\\n    deletePaymentConfig: vi.fn(() => Promise.resolve({\\\\n      success: true\\\\n    })),\\\\n    togglePaymentConfig: vi.fn(() => Promise.resolve({\\\\n      success: true\\\\n    })),\\\\n    testPaymentConfig: vi.fn(() => Promise.resolve({\\\\n      success: true\\\\n    })),\\\\n    createRefund: vi.fn(() => Promise.resolve({\\\\n      success: true,\\\\n      data: {\\\\n        id: 2,\\\\n        refundId: \\\\'REF002\\\\',\\\\n        transactionId: \\\\'TXN002\\\\',\\\\n        orderId: \\\\'ORD002\\\\',\\\\n        amount: 100,\\\\n        reason: \\\\'用户申请退款\\\\',\\\\n        status: \\\\'success\\\\',\\\\n        processedAt: \\\\'2024-01-01T15:00:00Z\\\\',\\\\n        createdAt: \\\\'2024-01-01T15:00:00Z\\\\'\\\\n      }\\\\n    })),\\\\n    exportTransactions: vi.fn(() => Promise.resolve({\\\\n      success: true,\\\\n      data: new Blob()\\\\n    })),\\\\n    exportRefunds: vi.fn(() => Promise.resolve({\\\\n      success: true,\\\\n      data: new Blob()\\\\n    }))\\\\n  }))\\\\n}))\\\\n\\\\ndescribe(\\\\'PaymentManagement组件\\\\', () => {\\\\n  let wrapper: VueWrapper<any>\\\\n  let pinia: any\\\\n\\\\n  beforeEach(() => {\\\\n    pinia = createPinia()\\\\n    setActivePinia(pinia)\\\\n\\\\n    wrapper = mount(PaymentManagement, {\\\\n      global: {\\\\n        plugins: [pinia, ElementPlus],\\\\n        stubs: {\\\\n          \\\\'el-card\\\\': true,\\\\n          \\\\'el-row\\\\': true,\\\\n          \\\\'el-col\\\\': true,\\\\n          \\\\'el-tabs\\\\': true,\\\\n          \\\\'el-tab-pane\\\\': true,\\\\n          \\\\'el-button\\\\': true,\\\\n          \\\\'el-button-group\\\\': true,\\\\n          \\\\'el-icon\\\\': true,\\\\n          \\\\'el-tag\\\\': true,\\\\n          \\\\'el-table\\\\': true,\\\\n          \\\\'el-table-column\\\\': true,\\\\n          \\\\'el-pagination\\\\': true,\\\\n          \\\\'el-dialog\\\\': true,\\\\n          \\\\'el-form\\\\': true,\\\\n          \\\\'el-form-item\\\\': true,\\\\n          \\\\'el-input\\\\': true,\\\\n          \\\\'el-input-number\\\\': true,\\\\n          \\\\'el-select\\\\': true,\\\\n          \\\\'el-option\\\\': true,\\\\n          \\\\'el-date-picker\\\\': true,\\\\n          \\\\'el-switch\\\\': true,\\\\n          \\\\'el-divider\\\\': true,\\\\n          \\\\'el-alert\\\\': true,\\\\n          \\\\'el-tooltip\\\\': true,\\\\n          \\\\'el-popover\\\\': true,\\\\n          \\\\'el-progress\\\\': true,\\\\n          \\\\'el-statistic\\\\': true,\\\\n          \\\\'el-badge\\\\': true,\\\\n          \\\\'el-dropdown\\\\': true,\\\\n          \\\\'el-dropdown-menu\\\\': true,\\\\n          \\\\'el-dropdown-item\\\\': true,\\\\n          \\\\'el-timeline\\\\': true,\\\\n          \\\\'el-timeline-item\\\\': true,\\\\n          \\\\'el-descriptions\\\\': true,\\\\n          \\\\'el-descriptions-item\\\\': true,\\\\n          \\\\'el-empty\\\\': true\\\\n        }\\\\n      }\\\\n    })\\\\n\\\\n    vi.clearAllMocks()\\\\n  })\\\\n\\\\n  afterEach(() => {\\\\n    wrapper.unmount()\\\\n  })\\\\n\\\\n  describe(\\\\'组件渲染\\\\', () => {\\\\n    it(\\\\'应该正确渲染支付管理页面\\\\', () => {\\\\n      expect(wrapper.find(\\\\'.payment-management\\\\').exists()).toBe(true)\\\\n      expect(wrapper.find(\\\\'.page-title\\\\').text()).toBe(\\\\'支付管理\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该显示统计卡片\\\\', () => {\\\\n      const statCards = wrapper.findAll(\\\\'.stat-card\\\\')\\\\n      expect(statCards.length).toBe(4)\\\\n    })\\\\n\\\\n    it(\\\\'应该显示功能标签页\\\\', () => {\\\\n      const tabs = wrapper.find(\\\\'.el-tabs\\\\')\\\\n      expect(tabs.exists()).toBe(true)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'支付配置管理\\\\', () => {\\\\n    it(\\\\'应该正确加载支付配置\\\\', async () => {\\\\n      await wrapper.vm.loadPaymentConfigs()\\\\n      expect(wrapper.vm.paymentConfigs.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该显示支付配置列表\\\\', () => {\\\\n      const configTable = wrapper.find(\\\\'.el-table\\\\')\\\\n      expect(configTable.exists()).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示支付方式图标\\\\', () => {\\\\n      const methodIcons = wrapper.findAll(\\\\'.method-icon\\\\')\\\\n      expect(methodIcons.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示支付配置状态\\\\', () => {\\\\n      const statusTags = wrapper.findAll(\\\\'.el-tag\\\\')\\\\n      expect(statusTags.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示手续费\\\\', () => {\\\\n      const feeRates = wrapper.findAll(\\\\'span\\\\')\\\\n      const hasFeeRate = feeRates.some(span => span.text().includes(\\\\'%\\\\'))\\\\n      expect(hasFeeRate).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示创建时间\\\\', () => {\\\\n      const createdAtCells = wrapper.findAll(\\\\'td\\\\')\\\\n      const hasCreatedAt = createdAtCells.some(cell => cell.text().includes(\\\\'2024-01-01\\\\'))\\\\n      expect(hasCreatedAt).toBe(true)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'交易记录管理\\\\', () => {\\\\n    it(\\\\'应该正确加载交易记录\\\\', async () => {\\\\n      await wrapper.vm.loadTransactions()\\\\n      expect(wrapper.vm.transactions.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该显示交易记录列表\\\\', () => {\\\\n      const transactionTable = wrapper.find(\\\\'.el-table\\\\')\\\\n      expect(transactionTable.exists()).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示交易号\\\\', () => {\\\\n      const transactionIdCells = wrapper.findAll(\\\\'td\\\\')\\\\n      const hasTransactionId = transactionIdCells.some(cell => cell.text().includes(\\\\'TXN\\\\'))\\\\n      expect(hasTransactionId).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示订单号\\\\', () => {\\\\n      const orderIdCells = wrapper.findAll(\\\\'td\\\\')\\\\n      const hasOrderId = orderIdCells.some(cell => cell.text().includes(\\\\'ORD\\\\'))\\\\n      expect(hasOrderId).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示支付方式\\\\', () => {\\\\n      const paymentMethodTags = wrapper.findAll(\\\\'.el-tag\\\\')\\\\n      expect(paymentMethodTags.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示金额\\\\', () => {\\\\n      const amountCells = wrapper.findAll(\\\\'td\\\\')\\\\n      const hasAmount = amountCells.some(cell => cell.text().includes(\\\\'¥\\\\'))\\\\n      expect(hasAmount).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示支付状态\\\\', () => {\\\\n      const statusTags = wrapper.findAll(\\\\'.el-tag\\\\')\\\\n      expect(statusTags.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示支付时间\\\\', () => {\\\\n      const paymentTimeCells = wrapper.findAll(\\\\'td\\\\')\\\\n      const hasPaymentTime = paymentTimeCells.some(cell => cell.text().includes(\\\\'12:00:00\\\\'))\\\\n      expect(hasPaymentTime).toBe(true)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'退款记录管理\\\\', () => {\\\\n    it(\\\\'应该正确加载退款记录\\\\', async () => {\\\\n      await wrapper.vm.loadRefunds()\\\\n      expect(wrapper.vm.refunds.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该显示退款记录列表\\\\', () => {\\\\n      const refundTable = wrapper.find(\\\\'.el-table\\\\')\\\\n      expect(refundTable.exists()).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示退款号\\\\', () => {\\\\n      const refundIdCells = wrapper.findAll(\\\\'td\\\\')\\\\n      const hasRefundId = refundIdCells.some(cell => cell.text().includes(\\\\'REF\\\\'))\\\\n      expect(hasRefundId).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示退款金额\\\\', () => {\\\\n      const amountCells = wrapper.findAll(\\\\'td\\\\')\\\\n      const hasAmount = amountCells.some(cell => cell.text().includes(\\\\'¥\\\\'))\\\\n      expect(hasAmount).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示退款状态\\\\', () => {\\\\n      const statusTags = wrapper.findAll(\\\\'.el-tag\\\\')\\\\n      expect(statusTags.length).toBeGreaterThan(0)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'支付配置操作\\\\', () => {\\\\n    it(\\\\'应该正确创建支付配置\\\\', async () => {\\\\n      wrapper.vm.configForm = {\\\\n        id: 0,\\\\n        method: PaymentMethod.ALIPAY,\\\\n        name: \\\\'新支付宝配置\\\\',\\\\n        displayName: \\\\'新支付宝\\\\',\\\\n        description: \\\\'新支付宝支付配置\\\\',\\\\n        enabled: true,\\\\n        config: {\\\\n          appId: \\\\'new_app_id\\\\',\\\\n          merchantId: \\\\'new_merchant_id\\\\',\\\\n          apiKey: \\\\'new_api_key\\\\',\\\\n          apiSecret: \\\\'new_api_secret\\\\',\\\\n          notifyUrl: \\\\'https://example.com/notify\\\\',\\\\n          returnUrl: \\\\'https://example.com/return\\\\',\\\\n          supportedCurrencies: [\\\\'CNY\\\\'],\\\\n          minAmount: 0.01,\\\\n          maxAmount: 100000,\\\\n          feeRate: 0.006,\\\\n          fixedFee: 0\\\\n        }\\\\n      }\\\\n      \\\\n      await wrapper.vm.confirmConfig()\\\\n      expect(wrapper.vm.paymentConfigs.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确更新支付配置\\\\', async () => {\\\\n      const config = wrapper.vm.paymentConfigs[0]\\\\n      wrapper.vm.configForm = {\\\\n        id: config.id,\\\\n        method: config.method,\\\\n        name: \\\\'更新后的支付宝配置\\\\',\\\\n        displayName: config.displayName,\\\\n        description: \\\\'更新后的支付宝支付配置\\\\',\\\\n        enabled: config.enabled,\\\\n        config: { ...config.config }\\\\n      }\\\\n      \\\\n      await wrapper.vm.confirmConfig()\\\\n      expect(wrapper.vm.paymentConfigs.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确删除支付配置\\\\', async () => {\\\\n      const config = wrapper.vm.paymentConfigs[0]\\\\n      await wrapper.vm.handleDeleteConfig(config)\\\\n      expect(wrapper.vm.paymentConfigs.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确启用/禁用支付配置\\\\', async () => {\\\\n      const config = wrapper.vm.paymentConfigs[0]\\\\n      const originalEnabled = config.enabled\\\\n      \\\\n      await wrapper.vm.handleToggleConfig(config)\\\\n      expect(config.enabled).toBe(!originalEnabled)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确测试支付配置\\\\', async () => {\\\\n      const config = wrapper.vm.paymentConfigs[0]\\\\n      await wrapper.vm.testPaymentConfig(config)\\\\n      expect(wrapper.vm.paymentConfigs.length).toBeGreaterThan(0)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'交易记录操作\\\\', () => {\\\\n    it(\\\\'应该正确查看交易详情\\\\', async () => {\\\\n      const transaction = wrapper.vm.transactions[0]\\\\n      await wrapper.vm.viewTransaction(transaction)\\\\n      expect(wrapper.vm.selectedTransaction).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确创建退款\\\\', async () => {\\\\n      const transaction = wrapper.vm.transactions[0]\\\\n      wrapper.vm.refundForm = {\\\\n        transactionId: transaction.transactionId,\\\\n        amount: transaction.amount,\\\\n        reason: \\\\'用户申请退款\\\\'\\\\n      }\\\\n      \\\\n      await wrapper.vm.confirmRefund()\\\\n      expect(wrapper.vm.refunds.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确导出交易记录\\\\', async () => {\\\\n      await wrapper.vm.exportTransactions()\\\\n      expect(wrapper.vm.transactions.length).toBeGreaterThan(0)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'筛选和搜索\\\\', () => {\\\\n    it(\\\\'应该正确搜索交易记录\\\\', async () => {\\\\n      wrapper.vm.transactionFilter.search = \\\\'TXN001\\\\'\\\\n      await wrapper.vm.handleTransactionSearch()\\\\n      expect(wrapper.vm.transactions.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确按支付方式筛选交易记录\\\\', async () => {\\\\n      wrapper.vm.transactionFilter.paymentMethod = PaymentMethod.ALIPAY\\\\n      await wrapper.vm.handleTransactionSearch()\\\\n      expect(wrapper.vm.transactions.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确按状态筛选交易记录\\\\', async () => {\\\\n      wrapper.vm.transactionFilter.status = PaymentStatus.SUCCESS\\\\n      await wrapper.vm.handleTransactionSearch()\\\\n      expect(wrapper.vm.transactions.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确按时间范围筛选交易记录\\\\', async () => {\\\\n      wrapper.vm.transactionFilter.dateRange = [\\\\'2024-01-01 00:00:00\\\\', \\\\'2024-01-01 23:59:59\\\\']\\\\n      await wrapper.vm.handleTransactionSearch()\\\\n      expect(wrapper.vm.transactions.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确重置交易记录筛选\\\\', async () => {\\\\n      wrapper.vm.transactionFilter.search = \\\\'TXN001\\\\'\\\\n      wrapper.vm.transactionFilter.paymentMethod = PaymentMethod.ALIPAY\\\\n      wrapper.vm.transactionFilter.status = PaymentStatus.SUCCESS\\\\n      \\\\n      await wrapper.vm.resetTransactionFilter()\\\\n      expect(wrapper.vm.transactionFilter.search).toBe(\\\\'\\\\')\\\\n      expect(wrapper.vm.transactionFilter.paymentMethod).toBe(\\\\'\\\\')\\\\n      expect(wrapper.vm.transactionFilter.status).toBe(\\\\'\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'分页功能\\\\', () => {\\\\n    it(\\\\'应该正确处理交易记录分页\\\\', async () => {\\\\n      wrapper.vm.transactionPagination.page = 2\\\\n      await wrapper.vm.handleTransactionPageChange(2)\\\\n      expect(wrapper.vm.transactionPagination.page).toBe(2)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确处理交易记录每页数量变化\\\\', async () => {\\\\n      wrapper.vm.transactionPagination.limit = 50\\\\n      await wrapper.vm.handleTransactionPageSizeChange(50)\\\\n      expect(wrapper.vm.transactionPagination.limit).toBe(50)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确处理退款记录分页\\\\', async () => {\\\\n      wrapper.vm.refundPagination.page = 2\\\\n      await wrapper.vm.handleRefundPageChange(2)\\\\n      expect(wrapper.vm.refundPagination.page).toBe(2)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确处理退款记录每页数量变化\\\\', async () => {\\\\n      wrapper.vm.refundPagination.limit = 50\\\\n      await wrapper.vm.handleRefundPageSizeChange(50)\\\\n      expect(wrapper.vm.refundPagination.limit).toBe(50)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'标签页切换\\\\', () => {\\\\n    it(\\\\'应该正确切换到交易记录标签页\\\\', async () => {\\\\n      await wrapper.vm.handleTabChange(\\\\'transactions\\\\')\\\\n      expect(wrapper.vm.activeTab).toBe(\\\\'transactions\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该正确切换到退款记录标签页\\\\', async () => {\\\\n      await wrapper.vm.handleTabChange(\\\\'refunds\\\\')\\\\n      expect(wrapper.vm.activeTab).toBe(\\\\'refunds\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该正确切换到支付配置标签页\\\\', async () => {\\\\n      await wrapper.vm.handleTabChange(\\\\'configs\\\\')\\\\n      expect(wrapper.vm.activeTab).toBe(\\\\'configs\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'数据格式化\\\\', () => {\\\\n    it(\\\\'应该正确格式化数字\\\\', () => {\\\\n      const formatted = wrapper.vm.formatNumber(1234567.89)\\\\n      expect(formatted).toBe(\\\\'1,234,567.89\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该正确格式化日期时间\\\\', () => {\\\\n      const formatted = wrapper.vm.formatDateTime(\\\\'2024-01-01T12:00:00Z\\\\')\\\\n      expect(formatted).toContain(\\\\'2024-01-01\\\\')\\\\n      expect(formatted).toContain(\\\\'12:00:00\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该正确获取支付方式名称\\\\', () => {\\\\n      const name = wrapper.vm.getPaymentMethodName(PaymentMethod.ALIPAY)\\\\n      expect(name).toBe(\\\\'支付宝\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该正确获取支付状态名称\\\\', () => {\\\\n      const name = wrapper.vm.getPaymentStatusName(PaymentStatus.SUCCESS)\\\\n      expect(name).toBe(\\\\'成功\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该正确获取支付状态类型\\\\', () => {\\\\n      const type = wrapper.vm.getPaymentStatusType(PaymentStatus.SUCCESS)\\\\n      expect(type).toBe(\\\\'success\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该正确获取退款状态名称\\\\', () => {\\\\n      const name = wrapper.vm.getRefundStatusName(\\\\'success\\\\')\\\\n      expect(name).toBe(\\\\'成功\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该正确获取退款状态类型\\\\', () => {\\\\n      const type = wrapper.vm.getRefundStatusType(\\\\'success\\\\')\\\\n      expect(type).toBe(\\\\'success\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'加载状态\\\\', () => {\\\\n    it(\\\\'应该正确显示加载状态\\\\', async () => {\\\\n      wrapper.vm.loading = true\\\\n      await wrapper.vm.$nextTick()\\\\n      expect(wrapper.vm.loading).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确隐藏加载状态\\\\', async () => {\\\\n      wrapper.vm.loading = false\\\\n      await wrapper.vm.$nextTick()\\\\n      expect(wrapper.vm.loading).toBe(false)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'统计数据\\\\', () => {\\\\n    it(\\\\'应该正确加载支付统计\\\\', async () => {\\\\n      await wrapper.vm.loadPaymentStats()\\\\n      expect(wrapper.vm.paymentStats).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示总收入\\\\', () => {\\\\n      const revenue = wrapper.vm.paymentStats?.totalRevenue?.CNY || 0\\\\n      expect(revenue).toBe(300)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示交易笔数\\\\', () => {\\\\n      const totalTransactions = wrapper.vm.paymentStats?.totalTransactions || 0\\\\n      expect(totalTransactions).toBe(2)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示成功率\\\\', () => {\\\\n      const successRate = wrapper.vm.paymentStats?.successRate || 0\\\\n      expect(successRate).toBe(1)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示退款金额\\\\', () => {\\\\n      const totalRefunds = wrapper.vm.paymentStats?.totalRefunds?.CNY || 0\\\\n      expect(totalRefunds).toBe(50)\\\\n    })\\\\n  })\\\\n})\\\\n\",\"originAcceptText\":\"/**\\n * @fileoverview 支付管理组件单元测试\\n * @description 测试支付管理组件的功能\\n * @module PaymentManagement.test\\n * @author YYC³\\n * @version 1.0.0\\n * @created 2025-01-20\\n */\\n\\nimport { describe, it, expect, beforeEach, vi } from 'vitest'\\nimport { mount, VueWrapper } from '@vue/test-utils'\\nimport { createPinia, setActivePinia } from 'pinia'\\nimport ElementPlus from 'element-plus'\\nimport PaymentManagement from '@/views/PaymentManagement.vue'\\nimport { PaymentAPI, PaymentMethod, PaymentStatus } from '@/api/payment'\\n\\nvi.mock('@/api/payment', () => ({\\n  PaymentAPI: vi.fn().mockImplementation(() => ({\\n    getPaymentConfigs: vi.fn(() => Promise.resolve({\\n      success: true,\\n      data: [\\n        {\\n          id: 1,\\n          method: PaymentMethod.ALIPAY,\\n          name: '支付宝配置',\\n          displayName: '支付宝',\\n          description: '支付宝支付配置',\\n          enabled: true,\\n          config: {\\n            appId: 'test_app_id',\\n            merchantId: 'test_merchant_id',\\n            apiKey: 'test_api_key',\\n            apiSecret: 'test_api_secret',\\n            notifyUrl: 'https://example.com/notify',\\n            returnUrl: 'https://example.com/return',\\n            supportedCurrencies: ['CNY'],\\n            minAmount: 0.01,\\n            maxAmount: 100000,\\n            feeRate: 0.006,\\n            fixedFee: 0\\n          },\\n          createdAt: '2024-01-01T00:00:00Z'\\n        },\\n        {\\n          id: 2,\\n          method: PaymentMethod.WECHAT,\\n          name: '微信支付配置',\\n          displayName: '微信支付',\\n          description: '微信支付配置',\\n          enabled: true,\\n          config: {\\n            appId: 'test_app_id',\\n            merchantId: 'test_merchant_id',\\n            apiKey: 'test_api_key',\\n            apiSecret: 'test_api_secret',\\n            notifyUrl: 'https://example.com/notify',\\n            returnUrl: 'https://example.com/return',\\n            supportedCurrencies: ['CNY'],\\n            minAmount: 0.01,\\n            maxAmount: 100000,\\n            feeRate: 0.006,\\n            fixedFee: 0\\n          },\\n          createdAt: '2024-01-01T00:00:00Z'\\n        }\\n      ]\\n    })),\\n    getPaymentTransactions: vi.fn(() => Promise.resolve({\\n      success: true,\\n      data: {\\n        items: [\\n          {\\n            id: 1,\\n            transactionId: 'TXN001',\\n            orderId: 'ORD001',\\n            paymentMethod: PaymentMethod.ALIPAY,\\n            amount: 100,\\n            currency: 'CNY',\\n            status: PaymentStatus.SUCCESS,\\n            paymentTime: '2024-01-01T12:00:00Z',\\n            createdAt: '2024-01-01T12:00:00Z'\\n          },\\n          {\\n            id: 2,\\n            transactionId: 'TXN002',\\n            orderId: 'ORD002',\\n            paymentMethod: PaymentMethod.WECHAT,\\n            amount: 200,\\n            currency: 'CNY',\\n            status: PaymentStatus.SUCCESS,\\n            paymentTime: '2024-01-01T13:00:00Z',\\n            createdAt: '2024-01-01T13:00:00Z'\\n          }\\n        ],\\n        pagination: {\\n          page: 1,\\n          limit: 20,\\n          total: 2,\\n          totalPages: 1\\n        }\\n      }\\n    })),\\n    getRefundRecords: vi.fn(() => Promise.resolve({\\n      success: true,\\n      data: {\\n        items: [\\n          {\\n            id: 1,\\n            refundId: 'REF001',\\n            transactionId: 'TXN001',\\n            orderId: 'ORD001',\\n            amount: 50,\\n            reason: '用户申请退款',\\n            status: 'success',\\n            processedAt: '2024-01-01T14:00:00Z',\\n            createdAt: '2024-01-01T14:00:00Z'\\n          }\\n        ],\\n        pagination: {\\n          page: 1,\\n          limit: 20,\\n          total: 1,\\n          totalPages: 1\\n        }\\n      }\\n    })),\\n    getPaymentStats: vi.fn(() => Promise.resolve({\\n      success: true,\\n      data: {\\n        totalTransactions: 2,\\n        totalRevenue: { CNY: 300 },\\n        totalRefunds: { CNY: 50 },\\n        netRevenue: { CNY: 250 },\\n        successRate: 1,\\n        averageOrderValue: { CNY: 150 },\\n        transactionsByMethod: {\\n          [PaymentMethod.ALIPAY]: { count: 1, amount: 100, successRate: 1 },\\n          [PaymentMethod.WECHAT]: { count: 1, amount: 200, successRate: 1 },\\n          [PaymentMethod.UNIONPAY]: { count: 0, amount: 0, successRate: 0 },\\n          [PaymentMethod.CASH]: { count: 0, amount: 0, successRate: 0 },\\n          [PaymentMethod.CREDIT_CARD]: { count: 0, amount: 0, successRate: 0 },\\n          [PaymentMethod.DEBIT_CARD]: { count: 0, amount: 0, successRate: 0 },\\n          [PaymentMethod.DIGITAL_WALLET]: { count: 0, amount: 0, successRate: 0 },\\n          [PaymentMethod.MEMBER_BALANCE]: { count: 0, amount: 0, successRate: 0 }\\n        },\\n        dailyStats: [\\n          {\\n            date: '2024-01-01',\\n            revenue: 300,\\n            transactions: 2,\\n            refunds: 1\\n          }\\n        ],\\n        monthlyStats: [\\n          {\\n            month: '2024-01',\\n            revenue: 300,\\n            transactions: 2,\\n            refunds: 1\\n          }\\n        ]\\n      }\\n    })),\\n    createPaymentConfig: vi.fn(() => Promise.resolve({\\n      success: true,\\n      data: {\\n        id: 3,\\n        method: PaymentMethod.ALIPAY,\\n        name: '新支付宝配置',\\n        displayName: '新支付宝',\\n        description: '新支付宝支付配置',\\n        enabled: true,\\n        config: {\\n          appId: 'new_app_id',\\n          merchantId: 'new_merchant_id',\\n          apiKey: 'new_api_key',\\n          apiSecret: 'new_api_secret',\\n          notifyUrl: 'https://example.com/notify',\\n          returnUrl: 'https://example.com/return',\\n          supportedCurrencies: ['CNY'],\\n          minAmount: 0.01,\\n          maxAmount: 100000,\\n          feeRate: 0.006,\\n          fixedFee: 0\\n        },\\n        createdAt: '2024-01-01T00:00:00Z'\\n      }\\n    })),\\n    updatePaymentConfig: vi.fn(() => Promise.resolve({\\n      success: true,\\n      data: {\\n        id: 1,\\n        method: PaymentMethod.ALIPAY,\\n        name: '更新后的支付宝配置',\\n        displayName: '支付宝',\\n        description: '更新后的支付宝支付配置',\\n        enabled: true,\\n        config: {\\n          appId: 'updated_app_id',\\n          merchantId: 'updated_merchant_id',\\n          apiKey: 'updated_api_key',\\n          apiSecret: 'updated_api_secret',\\n          notifyUrl: 'https://example.com/notify',\\n          returnUrl: 'https://example.com/return',\\n          supportedCurrencies: ['CNY'],\\n          minAmount: 0.01,\\n          maxAmount: 100000,\\n          feeRate: 0.006,\\n          fixedFee: 0\\n        },\\n        createdAt: '2024-01-01T00:00:00Z'\\n      }\\n    })),\\n    deletePaymentConfig: vi.fn(() => Promise.resolve({\\n      success: true\\n    })),\\n    togglePaymentConfig: vi.fn(() => Promise.resolve({\\n      success: true\\n    })),\\n    testPaymentConfig: vi.fn(() => Promise.resolve({\\n      success: true\\n    })),\\n    createRefund: vi.fn(() => Promise.resolve({\\n      success: true,\\n      data: {\\n        id: 2,\\n        refundId: 'REF002',\\n        transactionId: 'TXN002',\\n        orderId: 'ORD002',\\n        amount: 100,\\n        reason: '用户申请退款',\\n        status: 'success',\\n        processedAt: '2024-01-01T15:00:00Z',\\n        createdAt: '2024-01-01T15:00:00Z'\\n      }\\n    })),\\n    exportTransactions: vi.fn(() => Promise.resolve({\\n      success: true,\\n      data: new Blob()\\n    })),\\n    exportRefunds: vi.fn(() => Promise.resolve({\\n      success: true,\\n      data: new Blob()\\n    }))\\n  }))\\n}))\\n\\ndescribe('PaymentManagement组件', () => {\\n  let wrapper: VueWrapper<any>\\n  let pinia: any\\n\\n  beforeEach(() => {\\n    pinia = createPinia()\\n    setActivePinia(pinia)\\n\\n    wrapper = mount(PaymentManagement, {\\n      global: {\\n        plugins: [pinia, ElementPlus],\\n        stubs: {\\n          'el-card': true,\\n          'el-row': true,\\n          'el-col': true,\\n          'el-tabs': true,\\n          'el-tab-pane': true,\\n          'el-button': true,\\n          'el-button-group': true,\\n          'el-icon': true,\\n          'el-tag': true,\\n          'el-table': true,\\n          'el-table-column': true,\\n          'el-pagination': true,\\n          'el-dialog': true,\\n          'el-form': true,\\n          'el-form-item': true,\\n          'el-input': true,\\n          'el-input-number': true,\\n          'el-select': true,\\n          'el-option': true,\\n          'el-date-picker': true,\\n          'el-switch': true,\\n          'el-divider': true,\\n          'el-alert': true,\\n          'el-tooltip': true,\\n          'el-popover': true,\\n          'el-progress': true,\\n          'el-statistic': true,\\n          'el-badge': true,\\n          'el-dropdown': true,\\n          'el-dropdown-menu': true,\\n          'el-dropdown-item': true,\\n          'el-timeline': true,\\n          'el-timeline-item': true,\\n          'el-descriptions': true,\\n          'el-descriptions-item': true,\\n          'el-empty': true\\n        }\\n      }\\n    })\\n\\n    vi.clearAllMocks()\\n  })\\n\\n  afterEach(() => {\\n    wrapper.unmount()\\n  })\\n\\n  describe('组件渲染', () => {\\n    it('应该正确渲染支付管理页面', () => {\\n      expect(wrapper.find('.payment-management').exists()).toBe(true)\\n      expect(wrapper.find('.page-title').text()).toBe('支付管理')\\n    })\\n\\n    it('应该显示统计卡片', () => {\\n      const statCards = wrapper.findAll('.stat-card')\\n      expect(statCards.length).toBe(4)\\n    })\\n\\n    it('应该显示功能标签页', () => {\\n      const tabs = wrapper.find('.el-tabs')\\n      expect(tabs.exists()).toBe(true)\\n    })\\n  })\\n\\n  describe('支付配置管理', () => {\\n    it('应该正确加载支付配置', async () => {\\n      await wrapper.vm.loadPaymentConfigs()\\n      expect(wrapper.vm.paymentConfigs.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该显示支付配置列表', () => {\\n      const configTable = wrapper.find('.el-table')\\n      expect(configTable.exists()).toBe(true)\\n    })\\n\\n    it('应该正确显示支付方式图标', () => {\\n      const methodIcons = wrapper.findAll('.method-icon')\\n      expect(methodIcons.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确显示支付配置状态', () => {\\n      const statusTags = wrapper.findAll('.el-tag')\\n      expect(statusTags.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确显示手续费', () => {\\n      const feeRates = wrapper.findAll('span')\\n      const hasFeeRate = feeRates.some(span => span.text().includes('%'))\\n      expect(hasFeeRate).toBe(true)\\n    })\\n\\n    it('应该正确显示创建时间', () => {\\n      const createdAtCells = wrapper.findAll('td')\\n      const hasCreatedAt = createdAtCells.some(cell => cell.text().includes('2024-01-01'))\\n      expect(hasCreatedAt).toBe(true)\\n    })\\n  })\\n\\n  describe('交易记录管理', () => {\\n    it('应该正确加载交易记录', async () => {\\n      await wrapper.vm.loadTransactions()\\n      expect(wrapper.vm.transactions.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该显示交易记录列表', () => {\\n      const transactionTable = wrapper.find('.el-table')\\n      expect(transactionTable.exists()).toBe(true)\\n    })\\n\\n    it('应该正确显示交易号', () => {\\n      const transactionIdCells = wrapper.findAll('td')\\n      const hasTransactionId = transactionIdCells.some(cell => cell.text().includes('TXN'))\\n      expect(hasTransactionId).toBe(true)\\n    })\\n\\n    it('应该正确显示订单号', () => {\\n      const orderIdCells = wrapper.findAll('td')\\n      const hasOrderId = orderIdCells.some(cell => cell.text().includes('ORD'))\\n      expect(hasOrderId).toBe(true)\\n    })\\n\\n    it('应该正确显示支付方式', () => {\\n      const paymentMethodTags = wrapper.findAll('.el-tag')\\n      expect(paymentMethodTags.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确显示金额', () => {\\n      const amountCells = wrapper.findAll('td')\\n      const hasAmount = amountCells.some(cell => cell.text().includes('¥'))\\n      expect(hasAmount).toBe(true)\\n    })\\n\\n    it('应该正确显示支付状态', () => {\\n      const statusTags = wrapper.findAll('.el-tag')\\n      expect(statusTags.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确显示支付时间', () => {\\n      const paymentTimeCells = wrapper.findAll('td')\\n      const hasPaymentTime = paymentTimeCells.some(cell => cell.text().includes('12:00:00'))\\n      expect(hasPaymentTime).toBe(true)\\n    })\\n  })\\n\\n  describe('退款记录管理', () => {\\n    it('应该正确加载退款记录', async () => {\\n      await wrapper.vm.loadRefunds()\\n      expect(wrapper.vm.refunds.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该显示退款记录列表', () => {\\n      const refundTable = wrapper.find('.el-table')\\n      expect(refundTable.exists()).toBe(true)\\n    })\\n\\n    it('应该正确显示退款号', () => {\\n      const refundIdCells = wrapper.findAll('td')\\n      const hasRefundId = refundIdCells.some(cell => cell.text().includes('REF'))\\n      expect(hasRefundId).toBe(true)\\n    })\\n\\n    it('应该正确显示退款金额', () => {\\n      const amountCells = wrapper.findAll('td')\\n      const hasAmount = amountCells.some(cell => cell.text().includes('¥'))\\n      expect(hasAmount).toBe(true)\\n    })\\n\\n    it('应该正确显示退款状态', () => {\\n      const statusTags = wrapper.findAll('.el-tag')\\n      expect(statusTags.length).toBeGreaterThan(0)\\n    })\\n  })\\n\\n  describe('支付配置操作', () => {\\n    it('应该正确创建支付配置', async () => {\\n      wrapper.vm.configForm = {\\n        id: 0,\\n        method: PaymentMethod.ALIPAY,\\n        name: '新支付宝配置',\\n        displayName: '新支付宝',\\n        description: '新支付宝支付配置',\\n        enabled: true,\\n        config: {\\n          appId: 'new_app_id',\\n          merchantId: 'new_merchant_id',\\n          apiKey: 'new_api_key',\\n          apiSecret: 'new_api_secret',\\n          notifyUrl: 'https://example.com/notify',\\n          returnUrl: 'https://example.com/return',\\n          supportedCurrencies: ['CNY'],\\n          minAmount: 0.01,\\n          maxAmount: 100000,\\n          feeRate: 0.006,\\n          fixedFee: 0\\n        }\\n      }\\n      \\n      await wrapper.vm.confirmConfig()\\n      expect(wrapper.vm.paymentConfigs.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确更新支付配置', async () => {\\n      const config = wrapper.vm.paymentConfigs[0]\\n      wrapper.vm.configForm = {\\n        id: config.id,\\n        method: config.method,\\n        name: '更新后的支付宝配置',\\n        displayName: config.displayName,\\n        description: '更新后的支付宝支付配置',\\n        enabled: config.enabled,\\n        config: { ...config.config }\\n      }\\n      \\n      await wrapper.vm.confirmConfig()\\n      expect(wrapper.vm.paymentConfigs.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确删除支付配置', async () => {\\n      const config = wrapper.vm.paymentConfigs[0]\\n      await wrapper.vm.handleDeleteConfig(config)\\n      expect(wrapper.vm.paymentConfigs.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确启用/禁用支付配置', async () => {\\n      const config = wrapper.vm.paymentConfigs[0]\\n      const originalEnabled = config.enabled\\n      \\n      await wrapper.vm.handleToggleConfig(config)\\n      expect(config.enabled).toBe(!originalEnabled)\\n    })\\n\\n    it('应该正确测试支付配置', async () => {\\n      const config = wrapper.vm.paymentConfigs[0]\\n      await wrapper.vm.testPaymentConfig(config)\\n      expect(wrapper.vm.paymentConfigs.length).toBeGreaterThan(0)\\n    })\\n  })\\n\\n  describe('交易记录操作', () => {\\n    it('应该正确查看交易详情', async () => {\\n      const transaction = wrapper.vm.transactions[0]\\n      await wrapper.vm.viewTransaction(transaction)\\n      expect(wrapper.vm.selectedTransaction).toBeDefined()\\n    })\\n\\n    it('应该正确创建退款', async () => {\\n      const transaction = wrapper.vm.transactions[0]\\n      wrapper.vm.refundForm = {\\n        transactionId: transaction.transactionId,\\n        amount: transaction.amount,\\n        reason: '用户申请退款'\\n      }\\n      \\n      await wrapper.vm.confirmRefund()\\n      expect(wrapper.vm.refunds.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确导出交易记录', async () => {\\n      await wrapper.vm.exportTransactions()\\n      expect(wrapper.vm.transactions.length).toBeGreaterThan(0)\\n    })\\n  })\\n\\n  describe('筛选和搜索', () => {\\n    it('应该正确搜索交易记录', async () => {\\n      wrapper.vm.transactionFilter.search = 'TXN001'\\n      await wrapper.vm.handleTransactionSearch()\\n      expect(wrapper.vm.transactions.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确按支付方式筛选交易记录', async () => {\\n      wrapper.vm.transactionFilter.paymentMethod = PaymentMethod.ALIPAY\\n      await wrapper.vm.handleTransactionSearch()\\n      expect(wrapper.vm.transactions.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确按状态筛选交易记录', async () => {\\n      wrapper.vm.transactionFilter.status = PaymentStatus.SUCCESS\\n      await wrapper.vm.handleTransactionSearch()\\n      expect(wrapper.vm.transactions.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确按时间范围筛选交易记录', async () => {\\n      wrapper.vm.transactionFilter.dateRange = ['2024-01-01 00:00:00', '2024-01-01 23:59:59']\\n      await wrapper.vm.handleTransactionSearch()\\n      expect(wrapper.vm.transactions.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确重置交易记录筛选', async () => {\\n      wrapper.vm.transactionFilter.search = 'TXN001'\\n      wrapper.vm.transactionFilter.paymentMethod = PaymentMethod.ALIPAY\\n      wrapper.vm.transactionFilter.status = PaymentStatus.SUCCESS\\n      \\n      await wrapper.vm.resetTransactionFilter()\\n      expect(wrapper.vm.transactionFilter.search).toBe('')\\n      expect(wrapper.vm.transactionFilter.paymentMethod).toBe('')\\n      expect(wrapper.vm.transactionFilter.status).toBe('')\\n    })\\n  })\\n\\n  describe('分页功能', () => {\\n    it('应该正确处理交易记录分页', async () => {\\n      wrapper.vm.transactionPagination.page = 2\\n      await wrapper.vm.handleTransactionPageChange(2)\\n      expect(wrapper.vm.transactionPagination.page).toBe(2)\\n    })\\n\\n    it('应该正确处理交易记录每页数量变化', async () => {\\n      wrapper.vm.transactionPagination.limit = 50\\n      await wrapper.vm.handleTransactionPageSizeChange(50)\\n      expect(wrapper.vm.transactionPagination.limit).toBe(50)\\n    })\\n\\n    it('应该正确处理退款记录分页', async () => {\\n      wrapper.vm.refundPagination.page = 2\\n      await wrapper.vm.handleRefundPageChange(2)\\n      expect(wrapper.vm.refundPagination.page).toBe(2)\\n    })\\n\\n    it('应该正确处理退款记录每页数量变化', async () => {\\n      wrapper.vm.refundPagination.limit = 50\\n      await wrapper.vm.handleRefundPageSizeChange(50)\\n      expect(wrapper.vm.refundPagination.limit).toBe(50)\\n    })\\n  })\\n\\n  describe('标签页切换', () => {\\n    it('应该正确切换到交易记录标签页', async () => {\\n      await wrapper.vm.handleTabChange('transactions')\\n      expect(wrapper.vm.activeTab).toBe('transactions')\\n    })\\n\\n    it('应该正确切换到退款记录标签页', async () => {\\n      await wrapper.vm.handleTabChange('refunds')\\n      expect(wrapper.vm.activeTab).toBe('refunds')\\n    })\\n\\n    it('应该正确切换到支付配置标签页', async () => {\\n      await wrapper.vm.handleTabChange('configs')\\n      expect(wrapper.vm.activeTab).toBe('configs')\\n    })\\n  })\\n\\n  describe('数据格式化', () => {\\n    it('应该正确格式化数字', () => {\\n      const formatted = wrapper.vm.formatNumber(1234567.89)\\n      expect(formatted).toBe('1,234,567.89')\\n    })\\n\\n    it('应该正确格式化日期时间', () => {\\n      const formatted = wrapper.vm.formatDateTime('2024-01-01T12:00:00Z')\\n      expect(formatted).toContain('2024-01-01')\\n      expect(formatted).toContain('12:00:00')\\n    })\\n\\n    it('应该正确获取支付方式名称', () => {\\n      const name = wrapper.vm.getPaymentMethodName(PaymentMethod.ALIPAY)\\n      expect(name).toBe('支付宝')\\n    })\\n\\n    it('应该正确获取支付状态名称', () => {\\n      const name = wrapper.vm.getPaymentStatusName(PaymentStatus.SUCCESS)\\n      expect(name).toBe('成功')\\n    })\\n\\n    it('应该正确获取支付状态类型', () => {\\n      const type = wrapper.vm.getPaymentStatusType(PaymentStatus.SUCCESS)\\n      expect(type).toBe('success')\\n    })\\n\\n    it('应该正确获取退款状态名称', () => {\\n      const name = wrapper.vm.getRefundStatusName('success')\\n      expect(name).toBe('成功')\\n    })\\n\\n    it('应该正确获取退款状态类型', () => {\\n      const type = wrapper.vm.getRefundStatusType('success')\\n      expect(type).toBe('success')\\n    })\\n  })\\n\\n  describe('加载状态', () => {\\n    it('应该正确显示加载状态', async () => {\\n      wrapper.vm.loading = true\\n      await wrapper.vm.$nextTick()\\n      expect(wrapper.vm.loading).toBe(true)\\n    })\\n\\n    it('应该正确隐藏加载状态', async () => {\\n      wrapper.vm.loading = false\\n      await wrapper.vm.$nextTick()\\n      expect(wrapper.vm.loading).toBe(false)\\n    })\\n  })\\n\\n  describe('统计数据', () => {\\n    it('应该正确加载支付统计', async () => {\\n      await wrapper.vm.loadPaymentStats()\\n      expect(wrapper.vm.paymentStats).toBeDefined()\\n    })\\n\\n    it('应该正确显示总收入', () => {\\n      const revenue = wrapper.vm.paymentStats?.totalRevenue?.CNY || 0\\n      expect(revenue).toBe(300)\\n    })\\n\\n    it('应该正确显示交易笔数', () => {\\n      const totalTransactions = wrapper.vm.paymentStats?.totalTransactions || 0\\n      expect(totalTransactions).toBe(2)\\n    })\\n\\n    it('应该正确显示成功率', () => {\\n      const successRate = wrapper.vm.paymentStats?.successRate || 0\\n      expect(successRate).toBe(1)\\n    })\\n\\n    it('应该正确显示退款金额', () => {\\n      const totalRefunds = wrapper.vm.paymentStats?.totalRefunds?.CNY || 0\\n      expect(totalRefunds).toBe(50)\\n    })\\n  })\\n})\\n\",\"originTextLength\":20113,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768882511616}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/views/__tests__/PaymentManagement.integration.test.ts": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":585,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":585,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"/**\\\\n * @fileoverview 支付管理集成测试\\\\n * @description 测试支付管理模块的组件交互和数据流\\\\n * @module PaymentManagement.integration.test\\\\n * @author YYC³\\\\n * @version 1.0.0\\\\n * @created 2025-01-20\\\\n */\\\\n\\\\nimport { describe, it, expect, beforeEach, vi } from \\\\'vitest\\\\'\\\\nimport { mount, VueWrapper } from \\\\'@vue/test-utils\\\\'\\\\nimport { createPinia, setActivePinia } from \\\\'pinia\\\\'\\\\nimport { createRouter, createMemoryHistory } from \\\\'vue-router\\\\'\\\\nimport ElementPlus from \\\\'element-plus\\\\'\\\\nimport PaymentManagement from \\\\'@/views/PaymentManagement.vue\\\\'\\\\nimport { PaymentAPI, PaymentMethod, PaymentStatus } from \\\\'@/api/payment\\\\'\\\\n\\\\nconst router = createRouter({\\\\n  history: createMemoryHistory(),\\\\n  routes: [\\\\n    { path: \\\\'/\\\\', component: { template: \\\\'<div>Home</div>\\\\' } },\\\\n    { path: \\\\'/payment\\\\', component: PaymentManagement }\\\\n  ]\\\\n})\\\\n\\\\nvi.mock(\\\\'@/api/payment\\\\', () => ({\\\\n  PaymentAPI: vi.fn().mockImplementation(() => ({\\\\n    getPaymentConfigs: vi.fn(() => Promise.resolve({\\\\n      success: true,\\\\n      data: [\\\\n        {\\\\n          id: 1,\\\\n          method: PaymentMethod.ALIPAY,\\\\n          name: \\\\'支付宝配置\\\\',\\\\n          displayName: \\\\'支付宝\\\\',\\\\n          description: \\\\'支付宝支付配置\\\\',\\\\n          enabled: true,\\\\n          config: {\\\\n            appId: \\\\'test_app_id\\\\',\\\\n            merchantId: \\\\'test_merchant_id\\\\',\\\\n            apiKey: \\\\'test_api_key\\\\',\\\\n            apiSecret: \\\\'test_api_secret\\\\',\\\\n            notifyUrl: \\\\'https://example.com/notify\\\\',\\\\n            returnUrl: \\\\'https://example.com/return\\\\',\\\\n            supportedCurrencies: [\\\\'CNY\\\\'],\\\\n            minAmount: 0.01,\\\\n            maxAmount: 100000,\\\\n            feeRate: 0.006,\\\\n            fixedFee: 0\\\\n          },\\\\n          createdAt: \\\\'2024-01-01T00:00:00Z\\\\'\\\\n        },\\\\n        {\\\\n          id: 2,\\\\n          method: PaymentMethod.WECHAT,\\\\n          name: \\\\'微信支付配置\\\\',\\\\n          displayName: \\\\'微信支付\\\\',\\\\n          description: \\\\'微信支付配置\\\\',\\\\n          enabled: true,\\\\n          config: {\\\\n            appId: \\\\'test_app_id\\\\',\\\\n            merchantId: \\\\'test_merchant_id\\\\',\\\\n            apiKey: \\\\'test_api_key\\\\',\\\\n            apiSecret: \\\\'test_api_secret\\\\',\\\\n            notifyUrl: \\\\'https://example.com/notify\\\\',\\\\n            returnUrl: \\\\'https://example.com/return\\\\',\\\\n            supportedCurrencies: [\\\\'CNY\\\\'],\\\\n            minAmount: 0.01,\\\\n            maxAmount: 100000,\\\\n            feeRate: 0.006,\\\\n            fixedFee: 0\\\\n          },\\\\n          createdAt: \\\\'2024-01-01T00:00:00Z\\\\'\\\\n        }\\\\n      ]\\\\n    })),\\\\n    getPaymentTransactions: vi.fn(() => Promise.resolve({\\\\n      success: true,\\\\n      data: {\\\\n        items: [\\\\n          {\\\\n            id: 1,\\\\n            transactionId: \\\\'TXN001\\\\',\\\\n            orderId: \\\\'ORD001\\\\',\\\\n            paymentMethod: PaymentMethod.ALIPAY,\\\\n            amount: 100,\\\\n            currency: \\\\'CNY\\\\',\\\\n            status: PaymentStatus.SUCCESS,\\\\n            paymentTime: \\\\'2024-01-01T12:00:00Z\\\\',\\\\n            createdAt: \\\\'2024-01-01T12:00:00Z\\\\'\\\\n          },\\\\n          {\\\\n            id: 2,\\\\n            transactionId: \\\\'TXN002\\\\',\\\\n            orderId: \\\\'ORD002\\\\',\\\\n            paymentMethod: PaymentMethod.WECHAT,\\\\n            amount: 200,\\\\n            currency: \\\\'CNY\\\\',\\\\n            status: PaymentStatus.SUCCESS,\\\\n            paymentTime: \\\\'2024-01-01T13:00:00Z\\\\',\\\\n            createdAt: \\\\'2024-01-01T13:00:00Z\\\\'\\\\n          }\\\\n        ],\\\\n        pagination: {\\\\n          page: 1,\\\\n          limit: 20,\\\\n          total: 2,\\\\n          totalPages: 1\\\\n        }\\\\n      }\\\\n    })),\\\\n    getRefundRecords: vi.fn(() => Promise.resolve({\\\\n      success: true,\\\\n      data: {\\\\n        items: [\\\\n          {\\\\n            id: 1,\\\\n            refundId: \\\\'REF001\\\\',\\\\n            transactionId: \\\\'TXN001\\\\',\\\\n            orderId: \\\\'ORD001\\\\',\\\\n            amount: 50,\\\\n            reason: \\\\'用户申请退款\\\\',\\\\n            status: \\\\'success\\\\',\\\\n            processedAt: \\\\'2024-01-01T14:00:00Z\\\\',\\\\n            createdAt: \\\\'2024-01-01T14:00:00Z\\\\'\\\\n          }\\\\n        ],\\\\n        pagination: {\\\\n          page: 1,\\\\n          limit: 20,\\\\n          total: 1,\\\\n          totalPages: 1\\\\n        }\\\\n      }\\\\n    })),\\\\n    getPaymentStats: vi.fn(() => Promise.resolve({\\\\n      success: true,\\\\n      data: {\\\\n        totalTransactions: 2,\\\\n        totalRevenue: { CNY: 300 },\\\\n        totalRefunds: { CNY: 50 },\\\\n        netRevenue: { CNY: 250 },\\\\n        successRate: 1,\\\\n        averageOrderValue: { CNY: 150 },\\\\n        transactionsByMethod: {\\\\n          [PaymentMethod.ALIPAY]: { count: 1, amount: 100, successRate: 1 },\\\\n          [PaymentMethod.WECHAT]: { count: 1, amount: 200, successRate: 1 },\\\\n          [PaymentMethod.UNIONPAY]: { count: 0, amount: 0, successRate: 0 },\\\\n          [PaymentMethod.CASH]: { count: 0, amount: 0, successRate: 0 },\\\\n          [PaymentMethod.CREDIT_CARD]: { count: 0, amount: 0, successRate: 0 },\\\\n          [PaymentMethod.DEBIT_CARD]: { count: 0, amount: 0, successRate: 0 },\\\\n          [PaymentMethod.DIGITAL_WALLET]: { count: 0, amount: 0, successRate: 0 },\\\\n          [PaymentMethod.MEMBER_BALANCE]: { count: 0, amount: 0, successRate: 0 }\\\\n        },\\\\n        dailyStats: [\\\\n          {\\\\n            date: \\\\'2024-01-01\\\\',\\\\n            revenue: 300,\\\\n            transactions: 2,\\\\n            refunds: 1\\\\n          }\\\\n        ],\\\\n        monthlyStats: [\\\\n          {\\\\n            month: \\\\'2024-01\\\\',\\\\n            revenue: 300,\\\\n            transactions: 2,\\\\n            refunds: 1\\\\n          }\\\\n        ]\\\\n      }\\\\n    })),\\\\n    createPaymentConfig: vi.fn(() => Promise.resolve({\\\\n      success: true,\\\\n      data: {\\\\n        id: 3,\\\\n        method: PaymentMethod.ALIPAY,\\\\n        name: \\\\'新支付宝配置\\\\',\\\\n        displayName: \\\\'新支付宝\\\\',\\\\n        description: \\\\'新支付宝支付配置\\\\',\\\\n        enabled: true,\\\\n        config: {\\\\n          appId: \\\\'new_app_id\\\\',\\\\n          merchantId: \\\\'new_merchant_id\\\\',\\\\n          apiKey: \\\\'new_api_key\\\\',\\\\n          apiSecret: \\\\'new_api_secret\\\\',\\\\n          notifyUrl: \\\\'https://example.com/notify\\\\',\\\\n          returnUrl: \\\\'https://example.com/return\\\\',\\\\n          supportedCurrencies: [\\\\'CNY\\\\'],\\\\n          minAmount: 0.01,\\\\n          maxAmount: 100000,\\\\n          feeRate: 0.006,\\\\n          fixedFee: 0\\\\n        },\\\\n        createdAt: \\\\'2024-01-01T00:00:00Z\\\\'\\\\n      }\\\\n    })),\\\\n    updatePaymentConfig: vi.fn(() => Promise.resolve({\\\\n      success: true,\\\\n      data: {\\\\n        id: 1,\\\\n        method: PaymentMethod.ALIPAY,\\\\n        name: \\\\'更新后的支付宝配置\\\\',\\\\n        displayName: \\\\'支付宝\\\\',\\\\n        description: \\\\'更新后的支付宝支付配置\\\\',\\\\n        enabled: true,\\\\n        config: {\\\\n          appId: \\\\'updated_app_id\\\\',\\\\n          merchantId: \\\\'updated_merchant_id\\\\',\\\\n          apiKey: \\\\'updated_api_key\\\\',\\\\n          apiSecret: \\\\'updated_api_secret\\\\',\\\\n          notifyUrl: \\\\'https://example.com/notify\\\\',\\\\n          returnUrl: \\\\'https://example.com/return\\\\',\\\\n          supportedCurrencies: [\\\\'CNY\\\\'],\\\\n          minAmount: 0.01,\\\\n          maxAmount: 100000,\\\\n          feeRate: 0.006,\\\\n          fixedFee: 0\\\\n        },\\\\n        createdAt: \\\\'2024-01-01T00:00:00Z\\\\'\\\\n      }\\\\n    })),\\\\n    deletePaymentConfig: vi.fn(() => Promise.resolve({\\\\n      success: true\\\\n    })),\\\\n    togglePaymentConfig: vi.fn(() => Promise.resolve({\\\\n      success: true\\\\n    })),\\\\n    testPaymentConfig: vi.fn(() => Promise.resolve({\\\\n      success: true\\\\n    })),\\\\n    createRefund: vi.fn(() => Promise.resolve({\\\\n      success: true,\\\\n      data: {\\\\n        id: 2,\\\\n        refundId: \\\\'REF002\\\\',\\\\n        transactionId: \\\\'TXN002\\\\',\\\\n        orderId: \\\\'ORD002\\\\',\\\\n        amount: 100,\\\\n        reason: \\\\'用户申请退款\\\\',\\\\n        status: \\\\'success\\\\',\\\\n        processedAt: \\\\'2024-01-01T15:00:00Z\\\\',\\\\n        createdAt: \\\\'2024-01-01T15:00:00Z\\\\'\\\\n      }\\\\n    })),\\\\n    exportTransactions: vi.fn(() => Promise.resolve({\\\\n      success: true,\\\\n      data: new Blob()\\\\n    })),\\\\n    exportRefunds: vi.fn(() => Promise.resolve({\\\\n      success: true,\\\\n      data: new Blob()\\\\n    }))\\\\n  }))\\\\n})\\\\n\\\\ndescribe(\\\\'PaymentManagement集成测试\\\\', () => {\\\\n  let wrapper: VueWrapper<any>\\\\n  let pinia: any\\\\n\\\\n  beforeEach(() => {\\\\n    pinia = createPinia()\\\\n    setActivePinia(pinia)\\\\n\\\\n    wrapper = mount(PaymentManagement, {\\\\n      global: {\\\\n        plugins: [pinia, router, ElementPlus],\\\\n        stubs: {\\\\n          \\\\'el-card\\\\': true,\\\\n          \\\\'el-row\\\\': true,\\\\n          \\\\'el-col\\\\': true,\\\\n          \\\\'el-tabs\\\\': true,\\\\n          \\\\'el-tab-pane\\\\': true,\\\\n          \\\\'el-button\\\\': true,\\\\n          \\\\'el-button-group\\\\': true,\\\\n          \\\\'el-icon\\\\': true,\\\\n          \\\\'el-tag\\\\': true,\\\\n          \\\\'el-table\\\\': true,\\\\n          \\\\'el-table-column\\\\': true,\\\\n          \\\\'el-pagination\\\\': true,\\\\n          \\\\'el-dialog\\\\': true,\\\\n          \\\\'el-form\\\\': true,\\\\n          \\\\'el-form-item\\\\': true,\\\\n          \\\\'el-input\\\\': true,\\\\n          \\\\'el-input-number\\\\': true,\\\\n          \\\\'el-select\\\\': true,\\\\n          \\\\'el-option\\\\': true,\\\\n          \\\\'el-date-picker\\\\': true,\\\\n          \\\\'el-switch\\\\': true,\\\\n          \\\\'el-divider\\\\': true,\\\\n          \\\\'el-alert\\\\': true,\\\\n          \\\\'el-tooltip\\\\': true,\\\\n          \\\\'el-popover\\\\': true,\\\\n          \\\\'el-progress\\\\': true,\\\\n          \\\\'el-statistic\\\\': true,\\\\n          \\\\'el-badge\\\\': true,\\\\n          \\\\'el-dropdown\\\\': true,\\\\n          \\\\'el-dropdown-menu\\\\': true,\\\\n          \\\\'el-dropdown-item\\\\': true,\\\\n          \\\\'el-timeline\\\\': true,\\\\n          \\\\'el-timeline-item\\\\': true,\\\\n          \\\\'el-descriptions\\\\': true,\\\\n          \\\\'el-descriptions-item\\\\': true,\\\\n          \\\\'el-empty\\\\': true\\\\n        }\\\\n      }\\\\n    })\\\\n\\\\n    router.push(\\\\'/payment\\\\')\\\\n    vi.clearAllMocks()\\\\n  })\\\\n\\\\n  afterEach(() => {\\\\n    wrapper.unmount()\\\\n  })\\\\n\\\\n  describe(\\\\'组件集成\\\\', () => {\\\\n    it(\\\\'应该正确加载所有数据\\\\', async () => {\\\\n      await wrapper.vm.loadPaymentConfigs()\\\\n      await wrapper.vm.loadTransactions()\\\\n      await wrapper.vm.loadRefunds()\\\\n      await wrapper.vm.loadPaymentStats()\\\\n\\\\n      expect(wrapper.vm.paymentConfigs.length).toBeGreaterThan(0)\\\\n      expect(wrapper.vm.transactions.length).toBeGreaterThan(0)\\\\n      expect(wrapper.vm.refunds.length).toBeGreaterThan(0)\\\\n      expect(wrapper.vm.paymentStats).toBeDefined()\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示系统概览\\\\', () => {\\\\n      const statCards = wrapper.findAll(\\\\'.stat-card\\\\')\\\\n      expect(statCards.length).toBe(4)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确切换标签页\\\\', async () => {\\\\n      const tabs = wrapper.find(\\\\'.el-tabs\\\\')\\\\n      expect(tabs.exists()).toBe(true)\\\\n\\\\n      wrapper.vm.activeTab = \\\\'transactions\\\\'\\\\n      await wrapper.vm.$nextTick()\\\\n      expect(wrapper.vm.activeTab).toBe(\\\\'transactions\\\\')\\\\n\\\\n      wrapper.vm.activeTab = \\\\'refunds\\\\'\\\\n      await wrapper.vm.$nextTick()\\\\n      expect(wrapper.vm.activeTab).toBe(\\\\'refunds\\\\')\\\\n\\\\n      wrapper.vm.activeTab = \\\\'configs\\\\'\\\\n      await wrapper.vm.$nextTick()\\\\n      expect(wrapper.vm.activeTab).toBe(\\\\'configs\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'支付配置流程集成\\\\', () => {\\\\n    it(\\\\'应该完整处理支付配置生命周期\\\\', async () => {\\\\n      await wrapper.vm.loadPaymentConfigs()\\\\n\\\\n      const activeConfig = wrapper.vm.paymentConfigs.find((c: any) => c.enabled)\\\\n      expect(activeConfig).toBeDefined()\\\\n\\\\n      await wrapper.vm.handleToggleConfig(activeConfig)\\\\n      expect(activeConfig.enabled).toBe(false)\\\\n\\\\n      await wrapper.vm.handleToggleConfig(activeConfig)\\\\n      expect(activeConfig.enabled).toBe(true)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确筛选支付配置\\\\', async () => {\\\\n      await wrapper.vm.loadPaymentConfigs()\\\\n      expect(wrapper.vm.paymentConfigs.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确创建支付配置\\\\', async () => {\\\\n      wrapper.vm.configForm = {\\\\n        id: 0,\\\\n        method: PaymentMethod.ALIPAY,\\\\n        name: \\\\'新支付宝配置\\\\',\\\\n        displayName: \\\\'新支付宝\\\\',\\\\n        description: \\\\'新支付宝支付配置\\\\',\\\\n        enabled: true,\\\\n        config: {\\\\n          appId: \\\\'new_app_id\\\\',\\\\n          merchantId: \\\\'new_merchant_id\\\\',\\\\n          apiKey: \\\\'new_api_key\\\\',\\\\n          apiSecret: \\\\'new_api_secret\\\\',\\\\n          notifyUrl: \\\\'https://example.com/notify\\\\',\\\\n          returnUrl: \\\\'https://example.com/return\\\\',\\\\n          supportedCurrencies: [\\\\'CNY\\\\'],\\\\n          minAmount: 0.01,\\\\n          maxAmount: 100000,\\\\n          feeRate: 0.006,\\\\n          fixedFee: 0\\\\n        }\\\\n      }\\\\n\\\\n      await wrapper.vm.confirmConfig()\\\\n      expect(wrapper.vm.paymentConfigs.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确更新支付配置\\\\', async () => {\\\\n      await wrapper.vm.loadPaymentConfigs()\\\\n      const config = wrapper.vm.paymentConfigs[0]\\\\n\\\\n      wrapper.vm.configForm = {\\\\n        id: config.id,\\\\n        method: config.method,\\\\n        name: \\\\'更新后的支付宝配置\\\\',\\\\n        displayName: config.displayName,\\\\n        description: \\\\'更新后的支付宝支付配置\\\\',\\\\n        enabled: config.enabled,\\\\n        config: { ...config.config }\\\\n      }\\\\n\\\\n      await wrapper.vm.confirmConfig()\\\\n      expect(wrapper.vm.paymentConfigs.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确删除支付配置\\\\', async () => {\\\\n      await wrapper.vm.loadPaymentConfigs()\\\\n      const config = wrapper.vm.paymentConfigs[0]\\\\n\\\\n      await wrapper.vm.handleDeleteConfig(config)\\\\n      expect(wrapper.vm.paymentConfigs.length).toBeGreaterThan(0)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'交易记录流程集成\\\\', () => {\\\\n    it(\\\\'应该正确加载和显示交易记录\\\\', async () => {\\\\n      await wrapper.vm.loadTransactions()\\\\n      expect(wrapper.vm.transactions.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确筛选交易记录\\\\', async () => {\\\\n      await wrapper.vm.loadTransactions()\\\\n\\\\n      wrapper.vm.transactionFilter.search = \\\\'TXN001\\\\'\\\\n      await wrapper.vm.handleTransactionSearch()\\\\n      expect(wrapper.vm.transactions.length).toBeGreaterThan(0)\\\\n\\\\n      wrapper.vm.transactionFilter.paymentMethod = PaymentMethod.ALIPAY\\\\n      await wrapper.vm.handleTransactionSearch()\\\\n      expect(wrapper.vm.transactions.length).toBeGreaterThan(0)\\\\n\\\\n      wrapper.vm.transactionFilter.status = PaymentStatus.SUCCESS\\\\n      await wrapper.vm.handleTransactionSearch()\\\\n      expect(wrapper.vm.transactions.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确搜索交易记录\\\\', async () => {\\\\n      await wrapper.vm.loadTransactions()\\\\n\\\\n      wrapper.vm.transactionFilter.search = \\\\'TXN001\\\\'\\\\n      await wrapper.vm.handleTransactionSearch()\\\\n      expect(wrapper.vm.transactions.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确导出交易记录\\\\', async () => {\\\\n      await wrapper.vm.exportTransactions()\\\\n      expect(wrapper.vm.transactions.length).toBeGreaterThan(0)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'退款流程集成\\\\', () => {\\\\n    it(\\\\'应该正确加载和显示退款记录\\\\', async () => {\\\\n      await wrapper.vm.loadRefunds()\\\\n      expect(wrapper.vm.refunds.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确创建退款\\\\', async () => {\\\\n      await wrapper.vm.loadTransactions()\\\\n      const transaction = wrapper.vm.transactions[0]\\\\n\\\\n      wrapper.vm.refundForm = {\\\\n        transactionId: transaction.transactionId,\\\\n        amount: transaction.amount,\\\\n        reason: \\\\'用户申请退款\\\\'\\\\n      }\\\\n\\\\n      await wrapper.vm.confirmRefund()\\\\n      expect(wrapper.vm.refunds.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确导出退款记录\\\\', async () => {\\\\n      await wrapper.vm.exportRefunds()\\\\n      expect(wrapper.vm.refunds.length).toBeGreaterThan(0)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'统计数据集成\\\\', () => {\\\\n    it(\\\\'应该正确显示系统统计\\\\', async () => {\\\\n      await wrapper.vm.loadPaymentStats()\\\\n      expect(wrapper.vm.paymentStats).toBeDefined()\\\\n      expect(wrapper.vm.paymentStats.totalTransactions).toBe(2)\\\\n      expect(wrapper.vm.paymentStats.totalRevenue.CNY).toBe(300)\\\\n      expect(wrapper.vm.paymentStats.totalRefunds.CNY).toBe(50)\\\\n      expect(wrapper.vm.paymentStats.netRevenue.CNY).toBe(250)\\\\n      expect(wrapper.vm.paymentStats.successRate).toBe(1)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示按支付方式统计\\\\', async () => {\\\\n      await wrapper.vm.loadPaymentStats()\\\\n      expect(wrapper.vm.paymentStats.transactionsByMethod[PaymentMethod.ALIPAY].count).toBe(1)\\\\n      expect(wrapper.vm.paymentStats.transactionsByMethod[PaymentMethod.WECHAT].count).toBe(1)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示每日统计\\\\', async () => {\\\\n      await wrapper.vm.loadPaymentStats()\\\\n      expect(wrapper.vm.paymentStats.dailyStats.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示每月统计\\\\', async () => {\\\\n      await wrapper.vm.loadPaymentStats()\\\\n      expect(wrapper.vm.paymentStats.monthlyStats.length).toBeGreaterThan(0)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'分页集成\\\\', () => {\\\\n    it(\\\\'应该正确处理交易记录分页\\\\', async () => {\\\\n      await wrapper.vm.loadTransactions()\\\\n\\\\n      wrapper.vm.transactionPagination.page = 2\\\\n      await wrapper.vm.handleTransactionPageChange(2)\\\\n      expect(wrapper.vm.transactionPagination.page).toBe(2)\\\\n\\\\n      wrapper.vm.transactionPagination.limit = 50\\\\n      await wrapper.vm.handleTransactionPageSizeChange(50)\\\\n      expect(wrapper.vm.transactionPagination.limit).toBe(50)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确处理退款记录分页\\\\', async () => {\\\\n      await wrapper.vm.loadRefunds()\\\\n\\\\n      wrapper.vm.refundPagination.page = 2\\\\n      await wrapper.vm.handleRefundPageChange(2)\\\\n      expect(wrapper.vm.refundPagination.page).toBe(2)\\\\n\\\\n      wrapper.vm.refundPagination.limit = 50\\\\n      await wrapper.vm.handleRefundPageSizeChange(50)\\\\n      expect(wrapper.vm.refundPagination.limit).toBe(50)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'错误处理集成\\\\', () => {\\\\n    it(\\\\'应该正确处理API错误\\\\', async () => {\\\\n      const mockAPI = new PaymentAPI()\\\\n      vi.mocked(mockAPI.getPaymentConfigs).mockRejectedValueOnce(new Error(\\\\'API错误\\\\'))\\\\n      \\\\n      try {\\\\n        await wrapper.vm.loadPaymentConfigs()\\\\n      } catch (error) {\\\\n        expect(error).toBeDefined()\\\\n      }\\\\n    })\\\\n\\\\n    it(\\\\'应该正确处理网络错误\\\\', async () => {\\\\n      const mockAPI = new PaymentAPI()\\\\n      vi.mocked(mockAPI.getPaymentConfigs).mockRejectedValueOnce(new Error(\\\\'网络错误\\\\'))\\\\n      \\\\n      try {\\\\n        await wrapper.vm.loadPaymentConfigs()\\\\n      } catch (error) {\\\\n        expect(error).toBeDefined()\\\\n      }\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'性能集成\\\\', () => {\\\\n    it(\\\\'应该正确处理大量数据\\\\', async () => {\\\\n      const mockTransactions = Array.from({ length: 1000 }, (_, i) => ({\\\\n        id: i + 1,\\\\n        transactionId: `TXN${i + 1}`,\\\\n        orderId: `ORD${i + 1}`,\\\\n        paymentMethod: PaymentMethod.ALIPAY,\\\\n        amount: 100,\\\\n        currency: \\\\'CNY\\\\',\\\\n        status: PaymentStatus.SUCCESS,\\\\n        paymentTime: \\\\'2024-01-01T12:00:00Z\\\\',\\\\n        createdAt: \\\\'2024-01-01T12:00:00Z\\\\'\\\\n      }))\\\\n\\\\n      const mockAPI = new PaymentAPI()\\\\n      vi.mocked(mockAPI.getPaymentTransactions).mockResolvedValueOnce({\\\\n        success: true,\\\\n        data: {\\\\n          items: mockTransactions,\\\\n          pagination: {\\\\n            page: 1,\\\\n            limit: 1000,\\\\n            total: 1000,\\\\n            totalPages: 1\\\\n          }\\\\n        }\\\\n      })\\\\n\\\\n      await wrapper.vm.loadTransactions()\\\\n      expect(wrapper.vm.transactions.length).toBe(1000)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确处理实时数据更新\\\\', async () => {\\\\n      await wrapper.vm.loadPaymentConfigs()\\\\n      await wrapper.vm.loadTransactions()\\\\n      await wrapper.vm.loadRefunds()\\\\n      await wrapper.vm.loadPaymentStats()\\\\n\\\\n      await wrapper.vm.loadPaymentConfigs()\\\\n      await wrapper.vm.loadTransactions()\\\\n      await wrapper.vm.loadRefunds()\\\\n      await wrapper.vm.loadPaymentStats()\\\\n\\\\n      expect(wrapper.vm.paymentConfigs.length).toBeGreaterThan(0)\\\\n      expect(wrapper.vm.transactions.length).toBeGreaterThan(0)\\\\n      expect(wrapper.vm.refunds.length).toBeGreaterThan(0)\\\\n      expect(wrapper.vm.paymentStats).toBeDefined()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'用户体验集成\\\\', () => {\\\\n    it(\\\\'应该正确显示加载状态\\\\', async () => {\\\\n      wrapper.vm.loading = true\\\\n      await wrapper.vm.$nextTick()\\\\n      expect(wrapper.vm.loading).toBe(true)\\\\n\\\\n      wrapper.vm.loading = false\\\\n      await wrapper.vm.$nextTick()\\\\n      expect(wrapper.vm.loading).toBe(false)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示空状态\\\\', async () => {\\\\n      const mockAPI = new PaymentAPI()\\\\n      vi.mocked(mockAPI.getPaymentConfigs).mockResolvedValueOnce({\\\\n        success: true,\\\\n        data: []\\\\n      })\\\\n\\\\n      await wrapper.vm.loadPaymentConfigs()\\\\n      expect(wrapper.vm.paymentConfigs.length).toBe(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示错误状态\\\\', async () => {\\\\n      const mockAPI = new PaymentAPI()\\\\n      vi.mocked(mockAPI.getPaymentConfigs).mockRejectedValueOnce(new Error(\\\\'API错误\\\\'))\\\\n\\\\n      try {\\\\n        await wrapper.vm.loadPaymentConfigs()\\\\n      } catch (error) {\\\\n        expect(error).toBeDefined()\\\\n      }\\\\n    })\\\\n  })\\\\n})\\\\n\",\"originAcceptText\":\"/**\\n * @fileoverview 支付管理集成测试\\n * @description 测试支付管理模块的组件交互和数据流\\n * @module PaymentManagement.integration.test\\n * @author YYC³\\n * @version 1.0.0\\n * @created 2025-01-20\\n */\\n\\nimport { describe, it, expect, beforeEach, vi } from 'vitest'\\nimport { mount, VueWrapper } from '@vue/test-utils'\\nimport { createPinia, setActivePinia } from 'pinia'\\nimport { createRouter, createMemoryHistory } from 'vue-router'\\nimport ElementPlus from 'element-plus'\\nimport PaymentManagement from '@/views/PaymentManagement.vue'\\nimport { PaymentAPI, PaymentMethod, PaymentStatus } from '@/api/payment'\\n\\nconst router = createRouter({\\n  history: createMemoryHistory(),\\n  routes: [\\n    { path: '/', component: { template: '<div>Home</div>' } },\\n    { path: '/payment', component: PaymentManagement }\\n  ]\\n})\\n\\nvi.mock('@/api/payment', () => ({\\n  PaymentAPI: vi.fn().mockImplementation(() => ({\\n    getPaymentConfigs: vi.fn(() => Promise.resolve({\\n      success: true,\\n      data: [\\n        {\\n          id: 1,\\n          method: PaymentMethod.ALIPAY,\\n          name: '支付宝配置',\\n          displayName: '支付宝',\\n          description: '支付宝支付配置',\\n          enabled: true,\\n          config: {\\n            appId: 'test_app_id',\\n            merchantId: 'test_merchant_id',\\n            apiKey: 'test_api_key',\\n            apiSecret: 'test_api_secret',\\n            notifyUrl: 'https://example.com/notify',\\n            returnUrl: 'https://example.com/return',\\n            supportedCurrencies: ['CNY'],\\n            minAmount: 0.01,\\n            maxAmount: 100000,\\n            feeRate: 0.006,\\n            fixedFee: 0\\n          },\\n          createdAt: '2024-01-01T00:00:00Z'\\n        },\\n        {\\n          id: 2,\\n          method: PaymentMethod.WECHAT,\\n          name: '微信支付配置',\\n          displayName: '微信支付',\\n          description: '微信支付配置',\\n          enabled: true,\\n          config: {\\n            appId: 'test_app_id',\\n            merchantId: 'test_merchant_id',\\n            apiKey: 'test_api_key',\\n            apiSecret: 'test_api_secret',\\n            notifyUrl: 'https://example.com/notify',\\n            returnUrl: 'https://example.com/return',\\n            supportedCurrencies: ['CNY'],\\n            minAmount: 0.01,\\n            maxAmount: 100000,\\n            feeRate: 0.006,\\n            fixedFee: 0\\n          },\\n          createdAt: '2024-01-01T00:00:00Z'\\n        }\\n      ]\\n    })),\\n    getPaymentTransactions: vi.fn(() => Promise.resolve({\\n      success: true,\\n      data: {\\n        items: [\\n          {\\n            id: 1,\\n            transactionId: 'TXN001',\\n            orderId: 'ORD001',\\n            paymentMethod: PaymentMethod.ALIPAY,\\n            amount: 100,\\n            currency: 'CNY',\\n            status: PaymentStatus.SUCCESS,\\n            paymentTime: '2024-01-01T12:00:00Z',\\n            createdAt: '2024-01-01T12:00:00Z'\\n          },\\n          {\\n            id: 2,\\n            transactionId: 'TXN002',\\n            orderId: 'ORD002',\\n            paymentMethod: PaymentMethod.WECHAT,\\n            amount: 200,\\n            currency: 'CNY',\\n            status: PaymentStatus.SUCCESS,\\n            paymentTime: '2024-01-01T13:00:00Z',\\n            createdAt: '2024-01-01T13:00:00Z'\\n          }\\n        ],\\n        pagination: {\\n          page: 1,\\n          limit: 20,\\n          total: 2,\\n          totalPages: 1\\n        }\\n      }\\n    })),\\n    getRefundRecords: vi.fn(() => Promise.resolve({\\n      success: true,\\n      data: {\\n        items: [\\n          {\\n            id: 1,\\n            refundId: 'REF001',\\n            transactionId: 'TXN001',\\n            orderId: 'ORD001',\\n            amount: 50,\\n            reason: '用户申请退款',\\n            status: 'success',\\n            processedAt: '2024-01-01T14:00:00Z',\\n            createdAt: '2024-01-01T14:00:00Z'\\n          }\\n        ],\\n        pagination: {\\n          page: 1,\\n          limit: 20,\\n          total: 1,\\n          totalPages: 1\\n        }\\n      }\\n    })),\\n    getPaymentStats: vi.fn(() => Promise.resolve({\\n      success: true,\\n      data: {\\n        totalTransactions: 2,\\n        totalRevenue: { CNY: 300 },\\n        totalRefunds: { CNY: 50 },\\n        netRevenue: { CNY: 250 },\\n        successRate: 1,\\n        averageOrderValue: { CNY: 150 },\\n        transactionsByMethod: {\\n          [PaymentMethod.ALIPAY]: { count: 1, amount: 100, successRate: 1 },\\n          [PaymentMethod.WECHAT]: { count: 1, amount: 200, successRate: 1 },\\n          [PaymentMethod.UNIONPAY]: { count: 0, amount: 0, successRate: 0 },\\n          [PaymentMethod.CASH]: { count: 0, amount: 0, successRate: 0 },\\n          [PaymentMethod.CREDIT_CARD]: { count: 0, amount: 0, successRate: 0 },\\n          [PaymentMethod.DEBIT_CARD]: { count: 0, amount: 0, successRate: 0 },\\n          [PaymentMethod.DIGITAL_WALLET]: { count: 0, amount: 0, successRate: 0 },\\n          [PaymentMethod.MEMBER_BALANCE]: { count: 0, amount: 0, successRate: 0 }\\n        },\\n        dailyStats: [\\n          {\\n            date: '2024-01-01',\\n            revenue: 300,\\n            transactions: 2,\\n            refunds: 1\\n          }\\n        ],\\n        monthlyStats: [\\n          {\\n            month: '2024-01',\\n            revenue: 300,\\n            transactions: 2,\\n            refunds: 1\\n          }\\n        ]\\n      }\\n    })),\\n    createPaymentConfig: vi.fn(() => Promise.resolve({\\n      success: true,\\n      data: {\\n        id: 3,\\n        method: PaymentMethod.ALIPAY,\\n        name: '新支付宝配置',\\n        displayName: '新支付宝',\\n        description: '新支付宝支付配置',\\n        enabled: true,\\n        config: {\\n          appId: 'new_app_id',\\n          merchantId: 'new_merchant_id',\\n          apiKey: 'new_api_key',\\n          apiSecret: 'new_api_secret',\\n          notifyUrl: 'https://example.com/notify',\\n          returnUrl: 'https://example.com/return',\\n          supportedCurrencies: ['CNY'],\\n          minAmount: 0.01,\\n          maxAmount: 100000,\\n          feeRate: 0.006,\\n          fixedFee: 0\\n        },\\n        createdAt: '2024-01-01T00:00:00Z'\\n      }\\n    })),\\n    updatePaymentConfig: vi.fn(() => Promise.resolve({\\n      success: true,\\n      data: {\\n        id: 1,\\n        method: PaymentMethod.ALIPAY,\\n        name: '更新后的支付宝配置',\\n        displayName: '支付宝',\\n        description: '更新后的支付宝支付配置',\\n        enabled: true,\\n        config: {\\n          appId: 'updated_app_id',\\n          merchantId: 'updated_merchant_id',\\n          apiKey: 'updated_api_key',\\n          apiSecret: 'updated_api_secret',\\n          notifyUrl: 'https://example.com/notify',\\n          returnUrl: 'https://example.com/return',\\n          supportedCurrencies: ['CNY'],\\n          minAmount: 0.01,\\n          maxAmount: 100000,\\n          feeRate: 0.006,\\n          fixedFee: 0\\n        },\\n        createdAt: '2024-01-01T00:00:00Z'\\n      }\\n    })),\\n    deletePaymentConfig: vi.fn(() => Promise.resolve({\\n      success: true\\n    })),\\n    togglePaymentConfig: vi.fn(() => Promise.resolve({\\n      success: true\\n    })),\\n    testPaymentConfig: vi.fn(() => Promise.resolve({\\n      success: true\\n    })),\\n    createRefund: vi.fn(() => Promise.resolve({\\n      success: true,\\n      data: {\\n        id: 2,\\n        refundId: 'REF002',\\n        transactionId: 'TXN002',\\n        orderId: 'ORD002',\\n        amount: 100,\\n        reason: '用户申请退款',\\n        status: 'success',\\n        processedAt: '2024-01-01T15:00:00Z',\\n        createdAt: '2024-01-01T15:00:00Z'\\n      }\\n    })),\\n    exportTransactions: vi.fn(() => Promise.resolve({\\n      success: true,\\n      data: new Blob()\\n    })),\\n    exportRefunds: vi.fn(() => Promise.resolve({\\n      success: true,\\n      data: new Blob()\\n    }))\\n  }))\\n})\\n\\ndescribe('PaymentManagement集成测试', () => {\\n  let wrapper: VueWrapper<any>\\n  let pinia: any\\n\\n  beforeEach(() => {\\n    pinia = createPinia()\\n    setActivePinia(pinia)\\n\\n    wrapper = mount(PaymentManagement, {\\n      global: {\\n        plugins: [pinia, router, ElementPlus],\\n        stubs: {\\n          'el-card': true,\\n          'el-row': true,\\n          'el-col': true,\\n          'el-tabs': true,\\n          'el-tab-pane': true,\\n          'el-button': true,\\n          'el-button-group': true,\\n          'el-icon': true,\\n          'el-tag': true,\\n          'el-table': true,\\n          'el-table-column': true,\\n          'el-pagination': true,\\n          'el-dialog': true,\\n          'el-form': true,\\n          'el-form-item': true,\\n          'el-input': true,\\n          'el-input-number': true,\\n          'el-select': true,\\n          'el-option': true,\\n          'el-date-picker': true,\\n          'el-switch': true,\\n          'el-divider': true,\\n          'el-alert': true,\\n          'el-tooltip': true,\\n          'el-popover': true,\\n          'el-progress': true,\\n          'el-statistic': true,\\n          'el-badge': true,\\n          'el-dropdown': true,\\n          'el-dropdown-menu': true,\\n          'el-dropdown-item': true,\\n          'el-timeline': true,\\n          'el-timeline-item': true,\\n          'el-descriptions': true,\\n          'el-descriptions-item': true,\\n          'el-empty': true\\n        }\\n      }\\n    })\\n\\n    router.push('/payment')\\n    vi.clearAllMocks()\\n  })\\n\\n  afterEach(() => {\\n    wrapper.unmount()\\n  })\\n\\n  describe('组件集成', () => {\\n    it('应该正确加载所有数据', async () => {\\n      await wrapper.vm.loadPaymentConfigs()\\n      await wrapper.vm.loadTransactions()\\n      await wrapper.vm.loadRefunds()\\n      await wrapper.vm.loadPaymentStats()\\n\\n      expect(wrapper.vm.paymentConfigs.length).toBeGreaterThan(0)\\n      expect(wrapper.vm.transactions.length).toBeGreaterThan(0)\\n      expect(wrapper.vm.refunds.length).toBeGreaterThan(0)\\n      expect(wrapper.vm.paymentStats).toBeDefined()\\n    })\\n\\n    it('应该正确显示系统概览', () => {\\n      const statCards = wrapper.findAll('.stat-card')\\n      expect(statCards.length).toBe(4)\\n    })\\n\\n    it('应该正确切换标签页', async () => {\\n      const tabs = wrapper.find('.el-tabs')\\n      expect(tabs.exists()).toBe(true)\\n\\n      wrapper.vm.activeTab = 'transactions'\\n      await wrapper.vm.$nextTick()\\n      expect(wrapper.vm.activeTab).toBe('transactions')\\n\\n      wrapper.vm.activeTab = 'refunds'\\n      await wrapper.vm.$nextTick()\\n      expect(wrapper.vm.activeTab).toBe('refunds')\\n\\n      wrapper.vm.activeTab = 'configs'\\n      await wrapper.vm.$nextTick()\\n      expect(wrapper.vm.activeTab).toBe('configs')\\n    })\\n  })\\n\\n  describe('支付配置流程集成', () => {\\n    it('应该完整处理支付配置生命周期', async () => {\\n      await wrapper.vm.loadPaymentConfigs()\\n\\n      const activeConfig = wrapper.vm.paymentConfigs.find((c: any) => c.enabled)\\n      expect(activeConfig).toBeDefined()\\n\\n      await wrapper.vm.handleToggleConfig(activeConfig)\\n      expect(activeConfig.enabled).toBe(false)\\n\\n      await wrapper.vm.handleToggleConfig(activeConfig)\\n      expect(activeConfig.enabled).toBe(true)\\n    })\\n\\n    it('应该正确筛选支付配置', async () => {\\n      await wrapper.vm.loadPaymentConfigs()\\n      expect(wrapper.vm.paymentConfigs.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确创建支付配置', async () => {\\n      wrapper.vm.configForm = {\\n        id: 0,\\n        method: PaymentMethod.ALIPAY,\\n        name: '新支付宝配置',\\n        displayName: '新支付宝',\\n        description: '新支付宝支付配置',\\n        enabled: true,\\n        config: {\\n          appId: 'new_app_id',\\n          merchantId: 'new_merchant_id',\\n          apiKey: 'new_api_key',\\n          apiSecret: 'new_api_secret',\\n          notifyUrl: 'https://example.com/notify',\\n          returnUrl: 'https://example.com/return',\\n          supportedCurrencies: ['CNY'],\\n          minAmount: 0.01,\\n          maxAmount: 100000,\\n          feeRate: 0.006,\\n          fixedFee: 0\\n        }\\n      }\\n\\n      await wrapper.vm.confirmConfig()\\n      expect(wrapper.vm.paymentConfigs.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确更新支付配置', async () => {\\n      await wrapper.vm.loadPaymentConfigs()\\n      const config = wrapper.vm.paymentConfigs[0]\\n\\n      wrapper.vm.configForm = {\\n        id: config.id,\\n        method: config.method,\\n        name: '更新后的支付宝配置',\\n        displayName: config.displayName,\\n        description: '更新后的支付宝支付配置',\\n        enabled: config.enabled,\\n        config: { ...config.config }\\n      }\\n\\n      await wrapper.vm.confirmConfig()\\n      expect(wrapper.vm.paymentConfigs.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确删除支付配置', async () => {\\n      await wrapper.vm.loadPaymentConfigs()\\n      const config = wrapper.vm.paymentConfigs[0]\\n\\n      await wrapper.vm.handleDeleteConfig(config)\\n      expect(wrapper.vm.paymentConfigs.length).toBeGreaterThan(0)\\n    })\\n  })\\n\\n  describe('交易记录流程集成', () => {\\n    it('应该正确加载和显示交易记录', async () => {\\n      await wrapper.vm.loadTransactions()\\n      expect(wrapper.vm.transactions.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确筛选交易记录', async () => {\\n      await wrapper.vm.loadTransactions()\\n\\n      wrapper.vm.transactionFilter.search = 'TXN001'\\n      await wrapper.vm.handleTransactionSearch()\\n      expect(wrapper.vm.transactions.length).toBeGreaterThan(0)\\n\\n      wrapper.vm.transactionFilter.paymentMethod = PaymentMethod.ALIPAY\\n      await wrapper.vm.handleTransactionSearch()\\n      expect(wrapper.vm.transactions.length).toBeGreaterThan(0)\\n\\n      wrapper.vm.transactionFilter.status = PaymentStatus.SUCCESS\\n      await wrapper.vm.handleTransactionSearch()\\n      expect(wrapper.vm.transactions.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确搜索交易记录', async () => {\\n      await wrapper.vm.loadTransactions()\\n\\n      wrapper.vm.transactionFilter.search = 'TXN001'\\n      await wrapper.vm.handleTransactionSearch()\\n      expect(wrapper.vm.transactions.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确导出交易记录', async () => {\\n      await wrapper.vm.exportTransactions()\\n      expect(wrapper.vm.transactions.length).toBeGreaterThan(0)\\n    })\\n  })\\n\\n  describe('退款流程集成', () => {\\n    it('应该正确加载和显示退款记录', async () => {\\n      await wrapper.vm.loadRefunds()\\n      expect(wrapper.vm.refunds.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确创建退款', async () => {\\n      await wrapper.vm.loadTransactions()\\n      const transaction = wrapper.vm.transactions[0]\\n\\n      wrapper.vm.refundForm = {\\n        transactionId: transaction.transactionId,\\n        amount: transaction.amount,\\n        reason: '用户申请退款'\\n      }\\n\\n      await wrapper.vm.confirmRefund()\\n      expect(wrapper.vm.refunds.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确导出退款记录', async () => {\\n      await wrapper.vm.exportRefunds()\\n      expect(wrapper.vm.refunds.length).toBeGreaterThan(0)\\n    })\\n  })\\n\\n  describe('统计数据集成', () => {\\n    it('应该正确显示系统统计', async () => {\\n      await wrapper.vm.loadPaymentStats()\\n      expect(wrapper.vm.paymentStats).toBeDefined()\\n      expect(wrapper.vm.paymentStats.totalTransactions).toBe(2)\\n      expect(wrapper.vm.paymentStats.totalRevenue.CNY).toBe(300)\\n      expect(wrapper.vm.paymentStats.totalRefunds.CNY).toBe(50)\\n      expect(wrapper.vm.paymentStats.netRevenue.CNY).toBe(250)\\n      expect(wrapper.vm.paymentStats.successRate).toBe(1)\\n    })\\n\\n    it('应该正确显示按支付方式统计', async () => {\\n      await wrapper.vm.loadPaymentStats()\\n      expect(wrapper.vm.paymentStats.transactionsByMethod[PaymentMethod.ALIPAY].count).toBe(1)\\n      expect(wrapper.vm.paymentStats.transactionsByMethod[PaymentMethod.WECHAT].count).toBe(1)\\n    })\\n\\n    it('应该正确显示每日统计', async () => {\\n      await wrapper.vm.loadPaymentStats()\\n      expect(wrapper.vm.paymentStats.dailyStats.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确显示每月统计', async () => {\\n      await wrapper.vm.loadPaymentStats()\\n      expect(wrapper.vm.paymentStats.monthlyStats.length).toBeGreaterThan(0)\\n    })\\n  })\\n\\n  describe('分页集成', () => {\\n    it('应该正确处理交易记录分页', async () => {\\n      await wrapper.vm.loadTransactions()\\n\\n      wrapper.vm.transactionPagination.page = 2\\n      await wrapper.vm.handleTransactionPageChange(2)\\n      expect(wrapper.vm.transactionPagination.page).toBe(2)\\n\\n      wrapper.vm.transactionPagination.limit = 50\\n      await wrapper.vm.handleTransactionPageSizeChange(50)\\n      expect(wrapper.vm.transactionPagination.limit).toBe(50)\\n    })\\n\\n    it('应该正确处理退款记录分页', async () => {\\n      await wrapper.vm.loadRefunds()\\n\\n      wrapper.vm.refundPagination.page = 2\\n      await wrapper.vm.handleRefundPageChange(2)\\n      expect(wrapper.vm.refundPagination.page).toBe(2)\\n\\n      wrapper.vm.refundPagination.limit = 50\\n      await wrapper.vm.handleRefundPageSizeChange(50)\\n      expect(wrapper.vm.refundPagination.limit).toBe(50)\\n    })\\n  })\\n\\n  describe('错误处理集成', () => {\\n    it('应该正确处理API错误', async () => {\\n      const mockAPI = new PaymentAPI()\\n      vi.mocked(mockAPI.getPaymentConfigs).mockRejectedValueOnce(new Error('API错误'))\\n      \\n      try {\\n        await wrapper.vm.loadPaymentConfigs()\\n      } catch (error) {\\n        expect(error).toBeDefined()\\n      }\\n    })\\n\\n    it('应该正确处理网络错误', async () => {\\n      const mockAPI = new PaymentAPI()\\n      vi.mocked(mockAPI.getPaymentConfigs).mockRejectedValueOnce(new Error('网络错误'))\\n      \\n      try {\\n        await wrapper.vm.loadPaymentConfigs()\\n      } catch (error) {\\n        expect(error).toBeDefined()\\n      }\\n    })\\n  })\\n\\n  describe('性能集成', () => {\\n    it('应该正确处理大量数据', async () => {\\n      const mockTransactions = Array.from({ length: 1000 }, (_, i) => ({\\n        id: i + 1,\\n        transactionId: `TXN${i + 1}`,\\n        orderId: `ORD${i + 1}`,\\n        paymentMethod: PaymentMethod.ALIPAY,\\n        amount: 100,\\n        currency: 'CNY',\\n        status: PaymentStatus.SUCCESS,\\n        paymentTime: '2024-01-01T12:00:00Z',\\n        createdAt: '2024-01-01T12:00:00Z'\\n      }))\\n\\n      const mockAPI = new PaymentAPI()\\n      vi.mocked(mockAPI.getPaymentTransactions).mockResolvedValueOnce({\\n        success: true,\\n        data: {\\n          items: mockTransactions,\\n          pagination: {\\n            page: 1,\\n            limit: 1000,\\n            total: 1000,\\n            totalPages: 1\\n          }\\n        }\\n      })\\n\\n      await wrapper.vm.loadTransactions()\\n      expect(wrapper.vm.transactions.length).toBe(1000)\\n    })\\n\\n    it('应该正确处理实时数据更新', async () => {\\n      await wrapper.vm.loadPaymentConfigs()\\n      await wrapper.vm.loadTransactions()\\n      await wrapper.vm.loadRefunds()\\n      await wrapper.vm.loadPaymentStats()\\n\\n      await wrapper.vm.loadPaymentConfigs()\\n      await wrapper.vm.loadTransactions()\\n      await wrapper.vm.loadRefunds()\\n      await wrapper.vm.loadPaymentStats()\\n\\n      expect(wrapper.vm.paymentConfigs.length).toBeGreaterThan(0)\\n      expect(wrapper.vm.transactions.length).toBeGreaterThan(0)\\n      expect(wrapper.vm.refunds.length).toBeGreaterThan(0)\\n      expect(wrapper.vm.paymentStats).toBeDefined()\\n    })\\n  })\\n\\n  describe('用户体验集成', () => {\\n    it('应该正确显示加载状态', async () => {\\n      wrapper.vm.loading = true\\n      await wrapper.vm.$nextTick()\\n      expect(wrapper.vm.loading).toBe(true)\\n\\n      wrapper.vm.loading = false\\n      await wrapper.vm.$nextTick()\\n      expect(wrapper.vm.loading).toBe(false)\\n    })\\n\\n    it('应该正确显示空状态', async () => {\\n      const mockAPI = new PaymentAPI()\\n      vi.mocked(mockAPI.getPaymentConfigs).mockResolvedValueOnce({\\n        success: true,\\n        data: []\\n      })\\n\\n      await wrapper.vm.loadPaymentConfigs()\\n      expect(wrapper.vm.paymentConfigs.length).toBe(0)\\n    })\\n\\n    it('应该正确显示错误状态', async () => {\\n      const mockAPI = new PaymentAPI()\\n      vi.mocked(mockAPI.getPaymentConfigs).mockRejectedValueOnce(new Error('API错误'))\\n\\n      try {\\n        await wrapper.vm.loadPaymentConfigs()\\n      } catch (error) {\\n        expect(error).toBeDefined()\\n      }\\n    })\\n  })\\n})\\n\",\"originTextLength\":19164,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768882642597}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/docs/YYC3-Cater-Platform-%E6%96%87%E6%A1%A3%E9%97%AD%E7%8E%AF/YYC3-Cater-%E9%9C%80%E6%B1%82%E8%AE%BE%E8%AE%A1%E6%96%87%E6%A1%A3/%E6%94%AF%E4%BB%98%E7%AE%A1%E7%90%86%E5%8A%9F%E8%83%BD%E6%A8%A1%E5%9D%97%E9%9C%80%E6%B1%82%E5%88%86%E6%9E%90%E4%B8%8E%E8%AE%BE%E8%AE%A1%E6%96%87%E6%A1%A3.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":503,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":503,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# YYC³餐饮管理系统 - 支付管理功能模块需求分析与设计文档\\\\n\\\\n## 文档信息\\\\n\\\\n| 项目 | 内容 |\\\\n|------|------|\\\\n| 文档名称 | 支付管理功能模块需求分析与设计文档 |\\\\n| 文档版本 | V1.0.0 |\\\\n| 创建日期 | 2025-01-20 |\\\\n| 作者 | YYC³团队 |\\\\n| 文档状态 | 正式发布 |\\\\n\\\\n## 1. 概述\\\\n\\\\n### 1.1 模块简介\\\\n\\\\n支付管理模块是YYC³餐饮管理系统的核心财务模块，负责管理系统的支付方式配置、交易记录查询、退款处理等功能。该模块为管理员提供完整的支付管理能力，确保支付流程的安全、可靠和高效。\\\\n\\\\n### 1.2 模块目标\\\\n\\\\n- 提供完整的支付方式配置管理\\\\n- 实现灵活的支付方式选择\\\\n- 支持多种支付渠道（支付宝、微信支付、银联等）\\\\n- 提供交易记录查询和统计\\\\n- 实现退款申请和处理流程\\\\n- 确保支付安全和数据完整性\\\\n- 提供支付数据分析和报表\\\\n\\\\n### 1.3 适用范围\\\\n\\\\n本模块适用于YYC³餐饮管理系统的所有版本，包括单店版和连锁版。\\\\n\\\\n## 2. 功能需求\\\\n\\\\n### 2.1 支付配置管理\\\\n\\\\n#### 2.1.1 支付配置列表\\\\n\\\\n**功能描述**：展示系统中所有支付方式的配置信息，支持搜索、筛选和分页。\\\\n\\\\n**输入参数**：\\\\n- 关键词：支付方式名称、配置名称\\\\n- 支付方式：按支付方式筛选\\\\n- 状态：已启用、已禁用\\\\n- 页码：当前页码\\\\n- 每页数量：每页显示数量\\\\n\\\\n**输出结果**：\\\\n- 支付配置列表：包含支付配置基本信息\\\\n- 总数：符合条件的支付配置总数\\\\n\\\\n**字段说明**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | number | 是 | 配置ID |\\\\n| method | string | 是 | 支付方式：alipay/wechat/unionpay/cash/credit_card/debit_card/digital_wallet/member_balance |\\\\n| name | string | 是 | 配置名称 |\\\\n| displayName | string | 是 | 显示名称 |\\\\n| description | string | 否 | 描述 |\\\\n| enabled | boolean | 是 | 是否启用 |\\\\n| config | object | 是 | 配置详情 |\\\\n| createdAt | string | 是 | 创建时间 |\\\\n| updatedAt | string | 否 | 更新时间 |\\\\n\\\\n**配置详情字段**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| appId | string | 否 | 应用ID |\\\\n| merchantId | string | 否 | 商户ID |\\\\n| apiKey | string | 否 | API密钥 |\\\\n| apiSecret | string | 否 | API密钥 |\\\\n| publicKey | string | 否 | 公钥 |\\\\n| privateKey | string | 否 | 私钥 |\\\\n| notifyUrl | string | 否 | 异步通知URL |\\\\n| returnUrl | string | 否 | 同步返回URL |\\\\n| supportedCurrencies | array | 是 | 支持的货币 |\\\\n| minAmount | number | 是 | 最小金额 |\\\\n| maxAmount | number | 是 | 最大金额 |\\\\n| feeRate | number | 是 | 手续费率 |\\\\n| fixedFee | number | 是 | 固定手续费 |\\\\n\\\\n#### 2.1.2 新增支付配置\\\\n\\\\n**功能描述**：创建新的支付方式配置。\\\\n\\\\n**输入参数**：\\\\n- 支付方式：选择支付方式\\\\n- 配置名称：配置显示名称\\\\n- 显示名称：支付方式显示名称\\\\n- 描述：配置说明\\\\n- 是否启用：是否启用该支付方式\\\\n- 配置详情：支付方式的具体配置\\\\n\\\\n**验证规则**：\\\\n- 配置名称：2-50位字符\\\\n- 显示名称：2-20位中文字符\\\\n- 支付方式：必须选择\\\\n- 配置详情：根据支付方式不同而不同\\\\n\\\\n**业务规则**：\\\\n- 同一种支付方式只能有一个启用的配置\\\\n- 新配置默认状态为启用\\\\n- 自动记录创建时间和创建人\\\\n- 敏感信息加密存储\\\\n\\\\n#### 2.1.3 编辑支付配置\\\\n\\\\n**功能描述**：修改支付方式的配置信息。\\\\n\\\\n**输入参数**：\\\\n- 配置ID：要编辑的配置ID\\\\n- 配置名称：可修改\\\\n- 显示名称：可修改\\\\n- 描述：可修改\\\\n- 是否启用：可修改\\\\n- 配置详情：可修改\\\\n\\\\n**验证规则**：\\\\n- 配置名称：2-50位字符\\\\n- 显示名称：2-20位中文字符\\\\n- 配置详情：根据支付方式不同而不同\\\\n\\\\n**业务规则**：\\\\n- 记录修改时间和修改人\\\\n- 敏感信息加密存储\\\\n- 修改后立即生效\\\\n\\\\n#### 2.1.4 删除支付配置\\\\n\\\\n**功能描述**：删除指定的支付配置。\\\\n\\\\n**输入参数**：\\\\n- 配置ID：要删除的配置ID\\\\n\\\\n**业务规则**：\\\\n- 删除前需要二次确认\\\\n- 不能删除系统默认配置\\\\n- 不能删除仍有交易记录的配置\\\\n- 记录删除操作到审计日志\\\\n\\\\n#### 2.1.5 启用/禁用支付配置\\\\n\\\\n**功能描述**：启用或禁用支付配置。\\\\n\\\\n**输入参数**：\\\\n- 配置ID：要操作的配置ID\\\\n\\\\n**业务规则**：\\\\n- 禁用后该支付方式不可用\\\\n- 启用后该支付方式立即可用\\\\n- 记录启用/禁用操作\\\\n\\\\n#### 2.1.6 测试支付配置\\\\n\\\\n**功能描述**：测试支付配置是否正确。\\\\n\\\\n**输入参数**：\\\\n- 配置ID：要测试的配置ID\\\\n\\\\n**业务规则**：\\\\n- 测试使用小额金额（0.01元）\\\\n- 测试成功后显示成功提示\\\\n- 测试失败后显示错误信息\\\\n\\\\n### 2.2 交易记录管理\\\\n\\\\n#### 2.2.1 交易记录列表\\\\n\\\\n**功能描述**：展示系统中所有交易记录，支持搜索、筛选和分页。\\\\n\\\\n**输入参数**：\\\\n- 关键词：订单号、交易号\\\\n- 支付方式：按支付方式筛选\\\\n- 状态：待支付、处理中、成功、失败、已取消、已退款、部分退款\\\\n- 开始时间：交易开始时间\\\\n- 结束时间：交易结束时间\\\\n- 最小金额：最小交易金额\\\\n- 最大金额：最大交易金额\\\\n- 订单号：按订单号筛选\\\\n- 交易号：按交易号筛选\\\\n- 排序字段：创建时间、金额、支付时间\\\\n- 排序方式：升序、降序\\\\n- 页码：当前页码\\\\n- 每页数量：每页显示数量\\\\n\\\\n**输出结果**：\\\\n- 交易记录列表：包含交易详细信息\\\\n- 分页信息：总数、总页数等\\\\n\\\\n**字段说明**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | number | 是 | 交易ID |\\\\n| transactionId | string | 是 | 交易号 |\\\\n| orderId | string | 是 | 订单号 |\\\\n| paymentMethod | string | 是 | 支付方式 |\\\\n| amount | number | 是 | 交易金额 |\\\\n| currency | string | 是 | 货币类型 |\\\\n| status | string | 是 | 交易状态 |\\\\n| paymentTime | string | 否 | 支付时间 |\\\\n| failureReason | string | 否 | 失败原因 |\\\\n| externalTransactionId | string | 否 | 外部交易号 |\\\\n| gatewayResponse | object | 否 | 网关响应 |\\\\n| refundAmount | number | 否 | 退款金额 |\\\\n| refundedAt | string | 否 | 退款时间 |\\\\n| createdAt | string | 是 | 创建时间 |\\\\n| updatedAt | string | 否 | 更新时间 |\\\\n\\\\n#### 2.2.2 交易详情\\\\n\\\\n**功能描述**：查看交易的详细信息。\\\\n\\\\n**输入参数**：\\\\n- 交易ID：要查看的交易ID\\\\n\\\\n**输出结果**：\\\\n- 交易详情：包含交易的完整信息\\\\n\\\\n**业务规则**：\\\\n- 显示交易的完整信息\\\\n- 显示支付网关的响应信息\\\\n- 显示退款信息（如果有）\\\\n\\\\n#### 2.2.3 导出交易记录\\\\n\\\\n**功能描述**：导出交易记录到Excel文件。\\\\n\\\\n**输入参数**：\\\\n- 开始时间：导出开始时间\\\\n- 结束时间：导出结束时间\\\\n- 支付方式：按支付方式筛选\\\\n- 状态：按状态筛选\\\\n- 最小金额：最小交易金额\\\\n- 最大金额：最大交易金额\\\\n\\\\n**业务规则**：\\\\n- 导出需要管理员权限\\\\n- 导出文件命名包含时间戳\\\\n- 记录导出操作到审计日志\\\\n\\\\n### 2.3 退款管理\\\\n\\\\n#### 2.3.1 退款记录列表\\\\n\\\\n**功能描述**：展示系统中所有退款记录，支持搜索、筛选和分页。\\\\n\\\\n**输入参数**：\\\\n- 关键词：退款号、订单号、交易号\\\\n- 状态：待处理、处理中、成功、失败、已取消\\\\n- 开始时间：退款开始时间\\\\n- 结束时间：退款结束时间\\\\n- 页码：当前页码\\\\n- 每页数量：每页显示数量\\\\n\\\\n**输出结果**：\\\\n- 退款记录列表：包含退款详细信息\\\\n- 分页信息：总数、总页数等\\\\n\\\\n**字段说明**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | number | 是 | 退款ID |\\\\n| refundId | string | 是 | 退款号 |\\\\n| transactionId | string | 是 | 交易号 |\\\\n| orderId | string | 是 | 订单号 |\\\\n| amount | number | 是 | 退款金额 |\\\\n| reason | string | 是 | 退款原因 |\\\\n| status | string | 是 | 退款状态 |\\\\n| processedAt | string | 否 | 处理时间 |\\\\n| failureReason | string | 否 | 失败原因 |\\\\n| externalRefundId | string | 否 | 外部退款号 |\\\\n| gatewayResponse | object | 否 | 网关响应 |\\\\n| createdAt | string | 是 | 创建时间 |\\\\n| updatedAt | string | 否 | 更新时间 |\\\\n\\\\n#### 2.3.2 创建退款\\\\n\\\\n**功能描述**：为成功的交易创建退款。\\\\n\\\\n**输入参数**：\\\\n- 交易号：要退款的交易号\\\\n- 退款金额：退款金额\\\\n- 退款原因：退款原因说明\\\\n\\\\n**验证规则**：\\\\n- 交易号必须存在\\\\n- 交易状态必须为成功\\\\n- 退款金额必须小于等于交易金额\\\\n- 退款原因：必填，1-200字符\\\\n\\\\n**业务规则**：\\\\n- 退款金额不能超过交易金额\\\\n- 部分退款后交易状态变为部分退款\\\\n- 全额退款后交易状态变为已退款\\\\n- 退款申请后立即提交到支付网关\\\\n- 记录退款操作到审计日志\\\\n\\\\n#### 2.3.3 导出退款记录\\\\n\\\\n**功能描述**：导出退款记录到Excel文件。\\\\n\\\\n**输入参数**：\\\\n- 开始时间：导出开始时间\\\\n- 结束时间：导出结束时间\\\\n- 状态：按状态筛选\\\\n\\\\n**业务规则**：\\\\n- 导出需要管理员权限\\\\n- 导出文件命名包含时间戳\\\\n- 记录导出操作到审计日志\\\\n\\\\n### 2.4 支付统计\\\\n\\\\n#### 2.4.1 支付统计概览\\\\n\\\\n**功能描述**：展示支付相关的统计数据。\\\\n\\\\n**输出结果**：\\\\n- 总交易笔数\\\\n- 总收入（按货币）\\\\n- 总退款（按货币）\\\\n- 净收入（按货币）\\\\n- 成功率\\\\n- 平均订单价值（按货币）\\\\n- 按支付方式统计\\\\n- 每日统计\\\\n- 每月统计\\\\n\\\\n**字段说明**：\\\\n| 字段名 | 类型 | 说明 |\\\\n|--------|------|------|\\\\n| totalTransactions | number | 总交易笔数 |\\\\n| totalRevenue | object | 总收入（按货币） |\\\\n| totalRefunds | object | 总退款（按货币） |\\\\n| netRevenue | object | 净收入（按货币） |\\\\n| successRate | number | 成功率（0-1） |\\\\n| averageOrderValue | object | 平均订单价值（按货币） |\\\\n| transactionsByMethod | object | 按支付方式统计 |\\\\n| dailyStats | array | 每日统计 |\\\\n| monthlyStats | array | 每月统计 |\\\\n\\\\n**业务规则**：\\\\n- 统计数据实时更新\\\\n- 支持按时间范围查询\\\\n- 支持按支付方式筛选\\\\n\\\\n## 3. 非功能需求\\\\n\\\\n### 3.1 性能需求\\\\n\\\\n- 支付配置列表加载时间 < 1秒\\\\n- 交易记录列表加载时间 < 2秒\\\\n- 退款记录列表加载时间 < 2秒\\\\n- 支付统计加载时间 < 3秒\\\\n- 支持至少100,000条交易记录\\\\n- 支持至少10,000条退款记录\\\\n- 支付成功率 ≥ 99%\\\\n- 支付响应时间 < 3秒\\\\n\\\\n### 3.2 安全需求\\\\n\\\\n- 所有支付操作需要身份认证\\\\n- 敏感信息加密存储\\\\n- 支付数据传输使用HTTPS\\\\n- 支持支付密码验证\\\\n- 支持操作权限控制\\\\n- 支持数据访问权限控制\\\\n- 定期备份支付数据\\\\n- 支持支付风控规则\\\\n\\\\n### 3.3 可用性需求\\\\n\\\\n- 系统可用性 ≥ 99.9%\\\\n- 支持多浏览器访问\\\\n- 支持移动端访问\\\\n- 提供友好的错误提示\\\\n- 提供操作帮助文档\\\\n- 支持多种支付方式\\\\n\\\\n### 3.4 可维护性需求\\\\n\\\\n- 代码结构清晰\\\\n- 模块化设计\\\\n- 完善的日志记录\\\\n- 完善的错误处理\\\\n- 支持热更新\\\\n- 支持配置管理\\\\n- 支持支付网关扩展\\\\n\\\\n## 4. 技术设计\\\\n\\\\n### 4.1 技术栈\\\\n\\\\n- 前端框架：Vue 3 + TypeScript\\\\n- UI组件库：Element Plus\\\\n- 状态管理：Pinia\\\\n- 路由管理：Vue Router\\\\n- HTTP客户端：Axios\\\\n- 表单验证：Zod\\\\n- 图表库：ECharts\\\\n- 构建工具：Vite\\\\n\\\\n### 4.2 数据库设计\\\\n\\\\n#### 支付配置表（payment_configs）\\\\n\\\\n| 字段名 | 类型 | 约束 | 说明 |\\\\n|--------|------|--------|------|\\\\n| id | int | PRIMARY KEY | 配置ID |\\\\n| method | varchar(50) | NOT NULL | 支付方式 |\\\\n| name | varchar(100) | NOT NULL | 配置名称 |\\\\n| display_name | varchar(50) | NOT NULL | 显示名称 |\\\\n| description | text | NULL | 描述 |\\\\n| enabled | boolean | NOT NULL | 是否启用 |\\\\n| config | json | NOT NULL | 配置详情 |\\\\n| created_at | timestamp | NOT NULL | 创建时间 |\\\\n| updated_at | timestamp | NULL | 更新时间 |\\\\n\\\\n#### 交易记录表（payment_transactions）\\\\n\\\\n| 字段名 | 类型 | 约束 | 说明 |\\\\n|--------|------|--------|------|\\\\n| id | int | PRIMARY KEY | 交易ID |\\\\n| transaction_id | varchar(100) | UNIQUE | 交易号 |\\\\n| order_id | varchar(100) | NOT NULL | 订单号 |\\\\n| payment_method | varchar(50) | NOT NULL | 支付方式 |\\\\n| amount | decimal(10,2) | NOT NULL | 交易金额 |\\\\n| currency | varchar(10) | NOT NULL | 货币类型 |\\\\n| status | varchar(20) | NOT NULL | 交易状态 |\\\\n| payment_time | timestamp | NULL | 支付时间 |\\\\n| failure_reason | text | NULL | 失败原因 |\\\\n| external_transaction_id | varchar(100) | NULL | 外部交易号 |\\\\n| gateway_response | json | NULL | 网关响应 |\\\\n| refund_amount | decimal(10,2) | NULL | 退款金额 |\\\\n| refunded_at | timestamp | NULL | 退款时间 |\\\\n| created_at | timestamp | NOT NULL | 创建时间 |\\\\n| updated_at | timestamp | NULL | 更新时间 |\\\\n\\\\n#### 退款记录表（refund_records）\\\\n\\\\n| 字段名 | 类型 | 约束 | 说明 |\\\\n|--------|------|--------|------|\\\\n| id | int | PRIMARY KEY | 退款ID |\\\\n| refund_id | varchar(100) | UNIQUE | 退款号 |\\\\n| transaction_id | varchar(100) | NOT NULL | 交易号 |\\\\n| order_id | varchar(100) | NOT NULL | 订单号 |\\\\n| amount | decimal(10,2) | NOT NULL | 退款金额 |\\\\n| reason | text | NOT NULL | 退款原因 |\\\\n| status | varchar(20) | NOT NULL | 退款状态 |\\\\n| processed_at | timestamp | NULL | 处理时间 |\\\\n| failure_reason | text | NULL | 失败原因 |\\\\n| external_refund_id | varchar(100) | NULL | 外部退款号 |\\\\n| gateway_response | json | NULL | 网关响应 |\\\\n| created_at | timestamp | NOT NULL | 创建时间 |\\\\n| updated_at | timestamp | NULL | 更新时间 |\\\\n\\\\n### 4.3 API设计\\\\n\\\\n#### 支付配置API\\\\n\\\\n```\\\\nGET    /api/payment/configs          # 获取支付配置列表\\\\nGET    /api/payment/configs/:id      # 获取支付配置详情\\\\nPOST   /api/payment/configs          # 创建支付配置\\\\nPUT    /api/payment/configs/:id      # 更新支付配置\\\\nDELETE /api/payment/configs/:id      # 删除支付配置\\\\nPATCH  /api/payment/configs/:id/toggle  # 启用/禁用支付配置\\\\nPOST   /api/payment/configs/:id/test  # 测试支付配置\\\\n```\\\\n\\\\n#### 交易记录API\\\\n\\\\n```\\\\nGET    /api/payment/transactions          # 获取交易记录列表\\\\nGET    /api/payment/transactions/:id      # 获取交易详情\\\\nGET    /api/payment/transactions/export   # 导出交易记录\\\\n```\\\\n\\\\n#### 退款记录API\\\\n\\\\n```\\\\nGET    /api/payment/refunds          # 获取退款记录列表\\\\nGET    /api/payment/refunds/:id      # 获取退款详情\\\\nPOST   /api/payment/refunds          # 创建退款\\\\nGET    /api/payment/refunds/export   # 导出退款记录\\\\n```\\\\n\\\\n#### 支付统计API\\\\n\\\\n```\\\\nGET    /api/payment/stats          # 获取支付统计\\\\n```\\\\n\\\\n### 4.4 支付方式设计\\\\n\\\\n#### 支付方式列表\\\\n\\\\n| 支付方式 | 编码 | 说明 |\\\\n|---------|------|------|\\\\n| 支付宝 | alipay | 支持扫码支付、APP支付、网页支付 |\\\\n| 微信支付 | wechat | 支持扫码支付、APP支付、网页支付 |\\\\n| 银联支付 | unionpay | 支持银行卡支付 |\\\\n| 现金 | cash | 线下现金支付 |\\\\n| 银行卡 | credit_card | 支持信用卡支付 |\\\\n| 借记卡 | debit_card | 支持借记卡支付 |\\\\n| 数字钱包 | digital_wallet | 支持Apple Pay、Google Pay等 |\\\\n| 会员余额 | member_balance | 支持会员余额支付 |\\\\n\\\\n#### 支付状态列表\\\\n\\\\n| 支付状态 | 编码 | 说明 |\\\\n|---------|------|------|\\\\n| 待支付 | pending | 订单已创建，等待支付 |\\\\n| 处理中 | processing | 支付处理中 |\\\\n| 成功 | success | 支付成功 |\\\\n| 失败 | failed | 支付失败 |\\\\n| 已取消 | cancelled | 支付已取消 |\\\\n| 已退款 | refunded | 已全额退款 |\\\\n| 部分退款 | partially_refunded | 已部分退款 |\\\\n\\\\n#### 退款状态列表\\\\n\\\\n| 退款状态 | 编码 | 说明 |\\\\n|---------|------|------|\\\\n| 待处理 | pending | 退款申请已提交，等待处理 |\\\\n| 处理中 | processing | 退款处理中 |\\\\n| 成功 | success | 退款成功 |\\\\n| 失败 | failed | 退款失败 |\\\\n| 已取消 | cancelled | 退款已取消 |\\\\n\\\\n## 5. 界面设计\\\\n\\\\n### 5.1 支付管理主界面\\\\n\\\\n- 页面标题和描述\\\\n- 统计卡片（总收入、交易笔数、成功率、退款金额）\\\\n- 功能标签页（支付配置、交易记录、退款记录）\\\\n- 添加支付方式按钮\\\\n\\\\n### 5.2 支付配置界面\\\\n\\\\n- 支付配置列表表格\\\\n- 搜索和筛选工具栏\\\\n- 新增支付配置按钮\\\\n- 操作按钮（测试、编辑、启用/禁用、删除）\\\\n- 支付配置对话框\\\\n- 分页组件\\\\n\\\\n### 5.3 交易记录界面\\\\n\\\\n- 交易记录列表表格\\\\n- 搜索和筛选工具栏\\\\n- 导出记录按钮\\\\n- 交易详情对话框\\\\n- 退款对话框\\\\n- 分页组件\\\\n\\\\n### 5.4 退款记录界面\\\\n\\\\n- 退款记录列表表格\\\\n- 搜索和筛选工具栏\\\\n- 导出记录按钮\\\\n- 退款详情对话框\\\\n- 分页组件\\\\n\\\\n## 6. 测试计划\\\\n\\\\n### 6.1 单元测试\\\\n\\\\n- 支付配置管理功能测试\\\\n- 交易记录管理功能测试\\\\n- 退款管理功能测试\\\\n- 支付统计功能测试\\\\n- 数据格式化功能测试\\\\n\\\\n### 6.2 集成测试\\\\n\\\\n- 支付配置CRUD操作测试\\\\n- 交易记录查询测试\\\\n- 退款流程测试\\\\n- 支付统计测试\\\\n- 数据导出测试\\\\n\\\\n### 6.3 性能测试\\\\n\\\\n- 大数据量加载测试\\\\n- 并发操作测试\\\\n- 响应时间测试\\\\n- 支付成功率测试\\\\n\\\\n### 6.4 安全测试\\\\n\\\\n- 权限控制测试\\\\n- SQL注入测试\\\\n- XSS攻击测试\\\\n- CSRF攻击测试\\\\n- 支付安全测试\\\\n\\\\n## 7. 部署计划\\\\n\\\\n### 7.1 开发环境\\\\n\\\\n- 部署时间：2025-01-20\\\\n- 部署方式：本地开发环境\\\\n- 测试范围：功能测试\\\\n\\\\n### 7.2 测试环境\\\\n\\\\n- 部署时间：2025-01-25\\\\n- 部署方式：CI/CD自动部署\\\\n- 测试范围：集成测试、性能测试、安全测试\\\\n\\\\n### 7.3 生产环境\\\\n\\\\n- 部署时间：2025-02-01\\\\n- 部署方式：蓝绿部署\\\\n- 测试范围：冒烟测试\\\\n\\\\n## 8. 附录\\\\n\\\\n### 8.1 术语表\\\\n\\\\n| 术语 | 说明 |\\\\n|------|------|\\\\n| 支付方式 | 用户支付订单的方式，如支付宝、微信支付等 |\\\\n| 支付配置 | 支付方式的具体配置信息 |\\\\n| 交易记录 | 每一笔支付交易的详细记录 |\\\\n| 退款记录 | 每一笔退款操作的详细记录 |\\\\n| 支付统计 | 支付相关的统计数据 |\\\\n| 支付网关 | 处理支付的第三方服务 |\\\\n\\\\n### 8.2 参考文档\\\\n\\\\n- YYC³餐饮管理系统总体设计文档\\\\n- YYC³餐饮管理系统数据库设计文档\\\\n- YYC³餐饮管理系统API文档\\\\n- YYC³餐饮管理系统安全规范\\\\n\\\\n### 8.3 变更记录\\\\n\\\\n| 版本 | 日期 | 变更内容 | 变更人 |\\\\n|------|------|---------|--------|\\\\n| V1.0.0 | 2025-01-20 | 初始版本 | YYC³团队 |\\\\n\\\\n---\\\\n\\\\n**文档结束**\\\\n\",\"originAcceptText\":\"# YYC³餐饮管理系统 - 支付管理功能模块需求分析与设计文档\\n\\n## 文档信息\\n\\n| 项目 | 内容 |\\n|------|------|\\n| 文档名称 | 支付管理功能模块需求分析与设计文档 |\\n| 文档版本 | V1.0.0 |\\n| 创建日期 | 2025-01-20 |\\n| 作者 | YYC³团队 |\\n| 文档状态 | 正式发布 |\\n\\n## 1. 概述\\n\\n### 1.1 模块简介\\n\\n支付管理模块是YYC³餐饮管理系统的核心财务模块，负责管理系统的支付方式配置、交易记录查询、退款处理等功能。该模块为管理员提供完整的支付管理能力，确保支付流程的安全、可靠和高效。\\n\\n### 1.2 模块目标\\n\\n- 提供完整的支付方式配置管理\\n- 实现灵活的支付方式选择\\n- 支持多种支付渠道（支付宝、微信支付、银联等）\\n- 提供交易记录查询和统计\\n- 实现退款申请和处理流程\\n- 确保支付安全和数据完整性\\n- 提供支付数据分析和报表\\n\\n### 1.3 适用范围\\n\\n本模块适用于YYC³餐饮管理系统的所有版本，包括单店版和连锁版。\\n\\n## 2. 功能需求\\n\\n### 2.1 支付配置管理\\n\\n#### 2.1.1 支付配置列表\\n\\n**功能描述**：展示系统中所有支付方式的配置信息，支持搜索、筛选和分页。\\n\\n**输入参数**：\\n- 关键词：支付方式名称、配置名称\\n- 支付方式：按支付方式筛选\\n- 状态：已启用、已禁用\\n- 页码：当前页码\\n- 每页数量：每页显示数量\\n\\n**输出结果**：\\n- 支付配置列表：包含支付配置基本信息\\n- 总数：符合条件的支付配置总数\\n\\n**字段说明**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | number | 是 | 配置ID |\\n| method | string | 是 | 支付方式：alipay/wechat/unionpay/cash/credit_card/debit_card/digital_wallet/member_balance |\\n| name | string | 是 | 配置名称 |\\n| displayName | string | 是 | 显示名称 |\\n| description | string | 否 | 描述 |\\n| enabled | boolean | 是 | 是否启用 |\\n| config | object | 是 | 配置详情 |\\n| createdAt | string | 是 | 创建时间 |\\n| updatedAt | string | 否 | 更新时间 |\\n\\n**配置详情字段**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| appId | string | 否 | 应用ID |\\n| merchantId | string | 否 | 商户ID |\\n| apiKey | string | 否 | API密钥 |\\n| apiSecret | string | 否 | API密钥 |\\n| publicKey | string | 否 | 公钥 |\\n| privateKey | string | 否 | 私钥 |\\n| notifyUrl | string | 否 | 异步通知URL |\\n| returnUrl | string | 否 | 同步返回URL |\\n| supportedCurrencies | array | 是 | 支持的货币 |\\n| minAmount | number | 是 | 最小金额 |\\n| maxAmount | number | 是 | 最大金额 |\\n| feeRate | number | 是 | 手续费率 |\\n| fixedFee | number | 是 | 固定手续费 |\\n\\n#### 2.1.2 新增支付配置\\n\\n**功能描述**：创建新的支付方式配置。\\n\\n**输入参数**：\\n- 支付方式：选择支付方式\\n- 配置名称：配置显示名称\\n- 显示名称：支付方式显示名称\\n- 描述：配置说明\\n- 是否启用：是否启用该支付方式\\n- 配置详情：支付方式的具体配置\\n\\n**验证规则**：\\n- 配置名称：2-50位字符\\n- 显示名称：2-20位中文字符\\n- 支付方式：必须选择\\n- 配置详情：根据支付方式不同而不同\\n\\n**业务规则**：\\n- 同一种支付方式只能有一个启用的配置\\n- 新配置默认状态为启用\\n- 自动记录创建时间和创建人\\n- 敏感信息加密存储\\n\\n#### 2.1.3 编辑支付配置\\n\\n**功能描述**：修改支付方式的配置信息。\\n\\n**输入参数**：\\n- 配置ID：要编辑的配置ID\\n- 配置名称：可修改\\n- 显示名称：可修改\\n- 描述：可修改\\n- 是否启用：可修改\\n- 配置详情：可修改\\n\\n**验证规则**：\\n- 配置名称：2-50位字符\\n- 显示名称：2-20位中文字符\\n- 配置详情：根据支付方式不同而不同\\n\\n**业务规则**：\\n- 记录修改时间和修改人\\n- 敏感信息加密存储\\n- 修改后立即生效\\n\\n#### 2.1.4 删除支付配置\\n\\n**功能描述**：删除指定的支付配置。\\n\\n**输入参数**：\\n- 配置ID：要删除的配置ID\\n\\n**业务规则**：\\n- 删除前需要二次确认\\n- 不能删除系统默认配置\\n- 不能删除仍有交易记录的配置\\n- 记录删除操作到审计日志\\n\\n#### 2.1.5 启用/禁用支付配置\\n\\n**功能描述**：启用或禁用支付配置。\\n\\n**输入参数**：\\n- 配置ID：要操作的配置ID\\n\\n**业务规则**：\\n- 禁用后该支付方式不可用\\n- 启用后该支付方式立即可用\\n- 记录启用/禁用操作\\n\\n#### 2.1.6 测试支付配置\\n\\n**功能描述**：测试支付配置是否正确。\\n\\n**输入参数**：\\n- 配置ID：要测试的配置ID\\n\\n**业务规则**：\\n- 测试使用小额金额（0.01元）\\n- 测试成功后显示成功提示\\n- 测试失败后显示错误信息\\n\\n### 2.2 交易记录管理\\n\\n#### 2.2.1 交易记录列表\\n\\n**功能描述**：展示系统中所有交易记录，支持搜索、筛选和分页。\\n\\n**输入参数**：\\n- 关键词：订单号、交易号\\n- 支付方式：按支付方式筛选\\n- 状态：待支付、处理中、成功、失败、已取消、已退款、部分退款\\n- 开始时间：交易开始时间\\n- 结束时间：交易结束时间\\n- 最小金额：最小交易金额\\n- 最大金额：最大交易金额\\n- 订单号：按订单号筛选\\n- 交易号：按交易号筛选\\n- 排序字段：创建时间、金额、支付时间\\n- 排序方式：升序、降序\\n- 页码：当前页码\\n- 每页数量：每页显示数量\\n\\n**输出结果**：\\n- 交易记录列表：包含交易详细信息\\n- 分页信息：总数、总页数等\\n\\n**字段说明**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | number | 是 | 交易ID |\\n| transactionId | string | 是 | 交易号 |\\n| orderId | string | 是 | 订单号 |\\n| paymentMethod | string | 是 | 支付方式 |\\n| amount | number | 是 | 交易金额 |\\n| currency | string | 是 | 货币类型 |\\n| status | string | 是 | 交易状态 |\\n| paymentTime | string | 否 | 支付时间 |\\n| failureReason | string | 否 | 失败原因 |\\n| externalTransactionId | string | 否 | 外部交易号 |\\n| gatewayResponse | object | 否 | 网关响应 |\\n| refundAmount | number | 否 | 退款金额 |\\n| refundedAt | string | 否 | 退款时间 |\\n| createdAt | string | 是 | 创建时间 |\\n| updatedAt | string | 否 | 更新时间 |\\n\\n#### 2.2.2 交易详情\\n\\n**功能描述**：查看交易的详细信息。\\n\\n**输入参数**：\\n- 交易ID：要查看的交易ID\\n\\n**输出结果**：\\n- 交易详情：包含交易的完整信息\\n\\n**业务规则**：\\n- 显示交易的完整信息\\n- 显示支付网关的响应信息\\n- 显示退款信息（如果有）\\n\\n#### 2.2.3 导出交易记录\\n\\n**功能描述**：导出交易记录到Excel文件。\\n\\n**输入参数**：\\n- 开始时间：导出开始时间\\n- 结束时间：导出结束时间\\n- 支付方式：按支付方式筛选\\n- 状态：按状态筛选\\n- 最小金额：最小交易金额\\n- 最大金额：最大交易金额\\n\\n**业务规则**：\\n- 导出需要管理员权限\\n- 导出文件命名包含时间戳\\n- 记录导出操作到审计日志\\n\\n### 2.3 退款管理\\n\\n#### 2.3.1 退款记录列表\\n\\n**功能描述**：展示系统中所有退款记录，支持搜索、筛选和分页。\\n\\n**输入参数**：\\n- 关键词：退款号、订单号、交易号\\n- 状态：待处理、处理中、成功、失败、已取消\\n- 开始时间：退款开始时间\\n- 结束时间：退款结束时间\\n- 页码：当前页码\\n- 每页数量：每页显示数量\\n\\n**输出结果**：\\n- 退款记录列表：包含退款详细信息\\n- 分页信息：总数、总页数等\\n\\n**字段说明**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | number | 是 | 退款ID |\\n| refundId | string | 是 | 退款号 |\\n| transactionId | string | 是 | 交易号 |\\n| orderId | string | 是 | 订单号 |\\n| amount | number | 是 | 退款金额 |\\n| reason | string | 是 | 退款原因 |\\n| status | string | 是 | 退款状态 |\\n| processedAt | string | 否 | 处理时间 |\\n| failureReason | string | 否 | 失败原因 |\\n| externalRefundId | string | 否 | 外部退款号 |\\n| gatewayResponse | object | 否 | 网关响应 |\\n| createdAt | string | 是 | 创建时间 |\\n| updatedAt | string | 否 | 更新时间 |\\n\\n#### 2.3.2 创建退款\\n\\n**功能描述**：为成功的交易创建退款。\\n\\n**输入参数**：\\n- 交易号：要退款的交易号\\n- 退款金额：退款金额\\n- 退款原因：退款原因说明\\n\\n**验证规则**：\\n- 交易号必须存在\\n- 交易状态必须为成功\\n- 退款金额必须小于等于交易金额\\n- 退款原因：必填，1-200字符\\n\\n**业务规则**：\\n- 退款金额不能超过交易金额\\n- 部分退款后交易状态变为部分退款\\n- 全额退款后交易状态变为已退款\\n- 退款申请后立即提交到支付网关\\n- 记录退款操作到审计日志\\n\\n#### 2.3.3 导出退款记录\\n\\n**功能描述**：导出退款记录到Excel文件。\\n\\n**输入参数**：\\n- 开始时间：导出开始时间\\n- 结束时间：导出结束时间\\n- 状态：按状态筛选\\n\\n**业务规则**：\\n- 导出需要管理员权限\\n- 导出文件命名包含时间戳\\n- 记录导出操作到审计日志\\n\\n### 2.4 支付统计\\n\\n#### 2.4.1 支付统计概览\\n\\n**功能描述**：展示支付相关的统计数据。\\n\\n**输出结果**：\\n- 总交易笔数\\n- 总收入（按货币）\\n- 总退款（按货币）\\n- 净收入（按货币）\\n- 成功率\\n- 平均订单价值（按货币）\\n- 按支付方式统计\\n- 每日统计\\n- 每月统计\\n\\n**字段说明**：\\n| 字段名 | 类型 | 说明 |\\n|--------|------|------|\\n| totalTransactions | number | 总交易笔数 |\\n| totalRevenue | object | 总收入（按货币） |\\n| totalRefunds | object | 总退款（按货币） |\\n| netRevenue | object | 净收入（按货币） |\\n| successRate | number | 成功率（0-1） |\\n| averageOrderValue | object | 平均订单价值（按货币） |\\n| transactionsByMethod | object | 按支付方式统计 |\\n| dailyStats | array | 每日统计 |\\n| monthlyStats | array | 每月统计 |\\n\\n**业务规则**：\\n- 统计数据实时更新\\n- 支持按时间范围查询\\n- 支持按支付方式筛选\\n\\n## 3. 非功能需求\\n\\n### 3.1 性能需求\\n\\n- 支付配置列表加载时间 < 1秒\\n- 交易记录列表加载时间 < 2秒\\n- 退款记录列表加载时间 < 2秒\\n- 支付统计加载时间 < 3秒\\n- 支持至少100,000条交易记录\\n- 支持至少10,000条退款记录\\n- 支付成功率 ≥ 99%\\n- 支付响应时间 < 3秒\\n\\n### 3.2 安全需求\\n\\n- 所有支付操作需要身份认证\\n- 敏感信息加密存储\\n- 支付数据传输使用HTTPS\\n- 支持支付密码验证\\n- 支持操作权限控制\\n- 支持数据访问权限控制\\n- 定期备份支付数据\\n- 支持支付风控规则\\n\\n### 3.3 可用性需求\\n\\n- 系统可用性 ≥ 99.9%\\n- 支持多浏览器访问\\n- 支持移动端访问\\n- 提供友好的错误提示\\n- 提供操作帮助文档\\n- 支持多种支付方式\\n\\n### 3.4 可维护性需求\\n\\n- 代码结构清晰\\n- 模块化设计\\n- 完善的日志记录\\n- 完善的错误处理\\n- 支持热更新\\n- 支持配置管理\\n- 支持支付网关扩展\\n\\n## 4. 技术设计\\n\\n### 4.1 技术栈\\n\\n- 前端框架：Vue 3 + TypeScript\\n- UI组件库：Element Plus\\n- 状态管理：Pinia\\n- 路由管理：Vue Router\\n- HTTP客户端：Axios\\n- 表单验证：Zod\\n- 图表库：ECharts\\n- 构建工具：Vite\\n\\n### 4.2 数据库设计\\n\\n#### 支付配置表（payment_configs）\\n\\n| 字段名 | 类型 | 约束 | 说明 |\\n|--------|------|--------|------|\\n| id | int | PRIMARY KEY | 配置ID |\\n| method | varchar(50) | NOT NULL | 支付方式 |\\n| name | varchar(100) | NOT NULL | 配置名称 |\\n| display_name | varchar(50) | NOT NULL | 显示名称 |\\n| description | text | NULL | 描述 |\\n| enabled | boolean | NOT NULL | 是否启用 |\\n| config | json | NOT NULL | 配置详情 |\\n| created_at | timestamp | NOT NULL | 创建时间 |\\n| updated_at | timestamp | NULL | 更新时间 |\\n\\n#### 交易记录表（payment_transactions）\\n\\n| 字段名 | 类型 | 约束 | 说明 |\\n|--------|------|--------|------|\\n| id | int | PRIMARY KEY | 交易ID |\\n| transaction_id | varchar(100) | UNIQUE | 交易号 |\\n| order_id | varchar(100) | NOT NULL | 订单号 |\\n| payment_method | varchar(50) | NOT NULL | 支付方式 |\\n| amount | decimal(10,2) | NOT NULL | 交易金额 |\\n| currency | varchar(10) | NOT NULL | 货币类型 |\\n| status | varchar(20) | NOT NULL | 交易状态 |\\n| payment_time | timestamp | NULL | 支付时间 |\\n| failure_reason | text | NULL | 失败原因 |\\n| external_transaction_id | varchar(100) | NULL | 外部交易号 |\\n| gateway_response | json | NULL | 网关响应 |\\n| refund_amount | decimal(10,2) | NULL | 退款金额 |\\n| refunded_at | timestamp | NULL | 退款时间 |\\n| created_at | timestamp | NOT NULL | 创建时间 |\\n| updated_at | timestamp | NULL | 更新时间 |\\n\\n#### 退款记录表（refund_records）\\n\\n| 字段名 | 类型 | 约束 | 说明 |\\n|--------|------|--------|------|\\n| id | int | PRIMARY KEY | 退款ID |\\n| refund_id | varchar(100) | UNIQUE | 退款号 |\\n| transaction_id | varchar(100) | NOT NULL | 交易号 |\\n| order_id | varchar(100) | NOT NULL | 订单号 |\\n| amount | decimal(10,2) | NOT NULL | 退款金额 |\\n| reason | text | NOT NULL | 退款原因 |\\n| status | varchar(20) | NOT NULL | 退款状态 |\\n| processed_at | timestamp | NULL | 处理时间 |\\n| failure_reason | text | NULL | 失败原因 |\\n| external_refund_id | varchar(100) | NULL | 外部退款号 |\\n| gateway_response | json | NULL | 网关响应 |\\n| created_at | timestamp | NOT NULL | 创建时间 |\\n| updated_at | timestamp | NULL | 更新时间 |\\n\\n### 4.3 API设计\\n\\n#### 支付配置API\\n\\n```\\nGET    /api/payment/configs          # 获取支付配置列表\\nGET    /api/payment/configs/:id      # 获取支付配置详情\\nPOST   /api/payment/configs          # 创建支付配置\\nPUT    /api/payment/configs/:id      # 更新支付配置\\nDELETE /api/payment/configs/:id      # 删除支付配置\\nPATCH  /api/payment/configs/:id/toggle  # 启用/禁用支付配置\\nPOST   /api/payment/configs/:id/test  # 测试支付配置\\n```\\n\\n#### 交易记录API\\n\\n```\\nGET    /api/payment/transactions          # 获取交易记录列表\\nGET    /api/payment/transactions/:id      # 获取交易详情\\nGET    /api/payment/transactions/export   # 导出交易记录\\n```\\n\\n#### 退款记录API\\n\\n```\\nGET    /api/payment/refunds          # 获取退款记录列表\\nGET    /api/payment/refunds/:id      # 获取退款详情\\nPOST   /api/payment/refunds          # 创建退款\\nGET    /api/payment/refunds/export   # 导出退款记录\\n```\\n\\n#### 支付统计API\\n\\n```\\nGET    /api/payment/stats          # 获取支付统计\\n```\\n\\n### 4.4 支付方式设计\\n\\n#### 支付方式列表\\n\\n| 支付方式 | 编码 | 说明 |\\n|---------|------|------|\\n| 支付宝 | alipay | 支持扫码支付、APP支付、网页支付 |\\n| 微信支付 | wechat | 支持扫码支付、APP支付、网页支付 |\\n| 银联支付 | unionpay | 支持银行卡支付 |\\n| 现金 | cash | 线下现金支付 |\\n| 银行卡 | credit_card | 支持信用卡支付 |\\n| 借记卡 | debit_card | 支持借记卡支付 |\\n| 数字钱包 | digital_wallet | 支持Apple Pay、Google Pay等 |\\n| 会员余额 | member_balance | 支持会员余额支付 |\\n\\n#### 支付状态列表\\n\\n| 支付状态 | 编码 | 说明 |\\n|---------|------|------|\\n| 待支付 | pending | 订单已创建，等待支付 |\\n| 处理中 | processing | 支付处理中 |\\n| 成功 | success | 支付成功 |\\n| 失败 | failed | 支付失败 |\\n| 已取消 | cancelled | 支付已取消 |\\n| 已退款 | refunded | 已全额退款 |\\n| 部分退款 | partially_refunded | 已部分退款 |\\n\\n#### 退款状态列表\\n\\n| 退款状态 | 编码 | 说明 |\\n|---------|------|------|\\n| 待处理 | pending | 退款申请已提交，等待处理 |\\n| 处理中 | processing | 退款处理中 |\\n| 成功 | success | 退款成功 |\\n| 失败 | failed | 退款失败 |\\n| 已取消 | cancelled | 退款已取消 |\\n\\n## 5. 界面设计\\n\\n### 5.1 支付管理主界面\\n\\n- 页面标题和描述\\n- 统计卡片（总收入、交易笔数、成功率、退款金额）\\n- 功能标签页（支付配置、交易记录、退款记录）\\n- 添加支付方式按钮\\n\\n### 5.2 支付配置界面\\n\\n- 支付配置列表表格\\n- 搜索和筛选工具栏\\n- 新增支付配置按钮\\n- 操作按钮（测试、编辑、启用/禁用、删除）\\n- 支付配置对话框\\n- 分页组件\\n\\n### 5.3 交易记录界面\\n\\n- 交易记录列表表格\\n- 搜索和筛选工具栏\\n- 导出记录按钮\\n- 交易详情对话框\\n- 退款对话框\\n- 分页组件\\n\\n### 5.4 退款记录界面\\n\\n- 退款记录列表表格\\n- 搜索和筛选工具栏\\n- 导出记录按钮\\n- 退款详情对话框\\n- 分页组件\\n\\n## 6. 测试计划\\n\\n### 6.1 单元测试\\n\\n- 支付配置管理功能测试\\n- 交易记录管理功能测试\\n- 退款管理功能测试\\n- 支付统计功能测试\\n- 数据格式化功能测试\\n\\n### 6.2 集成测试\\n\\n- 支付配置CRUD操作测试\\n- 交易记录查询测试\\n- 退款流程测试\\n- 支付统计测试\\n- 数据导出测试\\n\\n### 6.3 性能测试\\n\\n- 大数据量加载测试\\n- 并发操作测试\\n- 响应时间测试\\n- 支付成功率测试\\n\\n### 6.4 安全测试\\n\\n- 权限控制测试\\n- SQL注入测试\\n- XSS攻击测试\\n- CSRF攻击测试\\n- 支付安全测试\\n\\n## 7. 部署计划\\n\\n### 7.1 开发环境\\n\\n- 部署时间：2025-01-20\\n- 部署方式：本地开发环境\\n- 测试范围：功能测试\\n\\n### 7.2 测试环境\\n\\n- 部署时间：2025-01-25\\n- 部署方式：CI/CD自动部署\\n- 测试范围：集成测试、性能测试、安全测试\\n\\n### 7.3 生产环境\\n\\n- 部署时间：2025-02-01\\n- 部署方式：蓝绿部署\\n- 测试范围：冒烟测试\\n\\n## 8. 附录\\n\\n### 8.1 术语表\\n\\n| 术语 | 说明 |\\n|------|------|\\n| 支付方式 | 用户支付订单的方式，如支付宝、微信支付等 |\\n| 支付配置 | 支付方式的具体配置信息 |\\n| 交易记录 | 每一笔支付交易的详细记录 |\\n| 退款记录 | 每一笔退款操作的详细记录 |\\n| 支付统计 | 支付相关的统计数据 |\\n| 支付网关 | 处理支付的第三方服务 |\\n\\n### 8.2 参考文档\\n\\n- YYC³餐饮管理系统总体设计文档\\n- YYC³餐饮管理系统数据库设计文档\\n- YYC³餐饮管理系统API文档\\n- YYC³餐饮管理系统安全规范\\n\\n### 8.3 变更记录\\n\\n| 版本 | 日期 | 变更内容 | 变更人 |\\n|------|------|---------|--------|\\n| V1.0.0 | 2025-01-20 | 初始版本 | YYC³团队 |\\n\\n---\\n\\n**文档结束**\\n\",\"originTextLength\":10816,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768882772112}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/docs/YYC3-Cater-Platform-%E6%96%87%E6%A1%A3%E9%97%AD%E7%8E%AF/YYC3-Cater-%E9%9C%80%E6%B1%82%E8%AE%BE%E8%AE%A1%E6%96%87%E6%A1%A3/%E8%BF%9E%E9%94%81%E7%AE%A1%E7%90%86%E5%8A%9F%E8%83%BD%E6%A8%A1%E5%9D%97%E9%9C%80%E6%B1%82%E5%88%86%E6%9E%90%E4%B8%8E%E8%AE%BE%E8%AE%A1%E6%96%87%E6%A1%A3.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":791,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":791,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# YYC³餐饮管理系统 - 连锁管理功能模块需求分析与设计文档\\\\n\\\\n## 文档信息\\\\n\\\\n| 项目 | 内容 |\\\\n|------|------|\\\\n| 文档名称 | 连锁管理功能模块需求分析与设计文档 |\\\\n| 文档版本 | V1.0.0 |\\\\n| 创建日期 | 2025-01-20 |\\\\n| 作者 | YYC³团队 |\\\\n| 文档状态 | 正式发布 |\\\\n\\\\n## 1. 概述\\\\n\\\\n### 1.1 模块简介\\\\n\\\\n连锁管理模块是YYC³餐饮管理系统的核心管理模块，负责管理连锁餐厅的门店信息、员工管理、库存管理、数据统计等功能。该模块为连锁餐饮企业提供了统一的门店管理平台，实现了跨门店的数据同步和统一管理。\\\\n\\\\n### 1.2 模块目标\\\\n\\\\n- 提供完整的门店信息管理\\\\n- 实现跨门店的数据同步\\\\n- 支持门店权限管理\\\\n- 提供门店数据统计和分析\\\\n- 实现库存统一管理\\\\n- 支持员工跨门店管理\\\\n- 提供门店绩效评估\\\\n- 确保数据安全和一致性\\\\n\\\\n### 1.3 适用范围\\\\n\\\\n本模块适用于YYC³餐饮管理系统的连锁版，支持多门店统一管理。\\\\n\\\\n## 2. 功能需求\\\\n\\\\n### 2.1 门店管理\\\\n\\\\n#### 2.1.1 门店列表\\\\n\\\\n**功能描述**：展示系统中所有门店信息，支持搜索、筛选和分页。\\\\n\\\\n**输入参数**：\\\\n- 关键词：门店名称、门店编号、地址\\\\n- 状态：营业中、休息中、已关闭\\\\n- 区域：按区域筛选\\\\n- 门店类型：直营店、加盟店\\\\n- 页码：当前页码\\\\n- 每页数量：每页显示数量\\\\n\\\\n**输出结果**：\\\\n- 门店列表：包含门店基本信息\\\\n- 总数：符合条件的门店总数\\\\n\\\\n**字段说明**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | number | 是 | 门店ID |\\\\n| storeCode | string | 是 | 门店编号 |\\\\n| name | string | 是 | 门店名称 |\\\\n| type | string | 是 | 门店类型：direct/franchise |\\\\n| status | string | 是 | 门店状态：open/closed/maintenance |\\\\n| address | string | 是 | 门店地址 |\\\\n| city | string | 是 | 所在城市 |\\\\n| district | string | 是 | 所在区县 |\\\\n| phone | string | 是 | 联系电话 |\\\\n| email | string | 否 | 邮箱 |\\\\n| manager | object | 是 | 店长信息 |\\\\n| businessHours | object | 是 | 营业时间 |\\\\n| area | number | 是 | 门店面积（平方米） |\\\\n| capacity | number | 是 | 最大容量（人） |\\\\n| tables | number | 是 | 桌位数量 |\\\\n| employees | number | 是 | 员工数量 |\\\\n| coordinates | object | 否 | 地理坐标 |\\\\n| facilities | array | 否 | 设施列表 |\\\\n| description | string | 否 | 门店描述 |\\\\n| images | array | 否 | 门店图片 |\\\\n| openingDate | string | 是 | 开业日期 |\\\\n| rating | number | 否 | 评分 |\\\\n| reviewCount | number | 否 | 评论数 |\\\\n| createdAt | string | 是 | 创建时间 |\\\\n| updatedAt | string | 否 | 更新时间 |\\\\n\\\\n**店长信息字段**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | number | 是 | 员工ID |\\\\n| name | string | 是 | 姓名 |\\\\n| phone | string | 是 | 电话 |\\\\n| avatar | string | 否 | 头像 |\\\\n\\\\n**营业时间字段**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| monday | object | 是 | 周一营业时间 |\\\\n| tuesday | object | 是 | 周二营业时间 |\\\\n| wednesday | object | 是 | 周三营业时间 |\\\\n| thursday | object | 是 | 周四营业时间 |\\\\n| friday | object | 是 | 周五营业时间 |\\\\n| saturday | object | 是 | 周六营业时间 |\\\\n| sunday | object | 是 | 周日营业时间 |\\\\n\\\\n**每日营业时间字段**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| open | string | 是 | 开门时间 |\\\\n| close | string | 是 | 关门时间 |\\\\n| enabled | boolean | 是 | 是否营业 |\\\\n\\\\n#### 2.1.2 新增门店\\\\n\\\\n**功能描述**：创建新的门店信息。\\\\n\\\\n**输入参数**：\\\\n- 门店编号：门店唯一编号\\\\n- 门店名称：门店显示名称\\\\n- 门店类型：直营店、加盟店\\\\n- 门店状态：营业中、休息中、已关闭\\\\n- 门店地址：详细地址\\\\n- 所在城市：城市名称\\\\n- 所在区县：区县名称\\\\n- 联系电话：联系电话\\\\n- 邮箱：邮箱地址（可选）\\\\n- 店长：选择店长\\\\n- 营业时间：设置营业时间\\\\n- 门店面积：门店面积（平方米）\\\\n- 最大容量：最大容量（人）\\\\n- 桌位数量：桌位数量\\\\n- 地理坐标：经纬度（可选）\\\\n- 设施列表：门店设施（可选）\\\\n- 门店描述：门店说明（可选）\\\\n- 门店图片：上传图片（可选）\\\\n- 开业日期：开业日期\\\\n\\\\n**验证规则**：\\\\n- 门店编号：4-20位字符，唯一\\\\n- 门店名称：2-50位中文字符\\\\n- 门店地址：5-200位字符\\\\n- 联系电话：11位手机号或座机号\\\\n- 邮箱：有效的邮箱格式\\\\n- 门店面积：正整数，1-10000\\\\n- 最大容量：正整数，1-1000\\\\n- 桌位数量：正整数，1-500\\\\n- 开业日期：有效的日期格式\\\\n\\\\n**业务规则**：\\\\n- 门店编号必须唯一\\\\n- 新门店默认状态为休息中\\\\n- 自动记录创建时间和创建人\\\\n- 自动生成门店ID\\\\n- 店长必须为已存在的员工\\\\n\\\\n#### 2.1.3 编辑门店\\\\n\\\\n**功能描述**：修改门店信息。\\\\n\\\\n**输入参数**：\\\\n- 门店ID：要编辑的门店ID\\\\n- 门店名称：可修改\\\\n- 门店类型：可修改\\\\n- 门店状态：可修改\\\\n- 门店地址：可修改\\\\n- 所在城市：可修改\\\\n- 所在区县：可修改\\\\n- 联系电话：可修改\\\\n- 邮箱：可修改\\\\n- 店长：可修改\\\\n- 营业时间：可修改\\\\n- 门店面积：可修改\\\\n- 最大容量：可修改\\\\n- 桌位数量：可修改\\\\n- 地理坐标：可修改\\\\n- 设施列表：可修改\\\\n- 门店描述：可修改\\\\n- 门店图片：可修改\\\\n\\\\n**验证规则**：\\\\n- 门店名称：2-50位中文字符\\\\n- 门店地址：5-200位字符\\\\n- 联系电话：11位手机号或座机号\\\\n- 邮箱：有效的邮箱格式\\\\n- 门店面积：正整数，1-10000\\\\n- 最大容量：正整数，1-1000\\\\n- 桌位数量：正整数，1-500\\\\n\\\\n**业务规则**：\\\\n- 记录修改时间和修改人\\\\n- 门店编号不可修改\\\\n- 修改后立即生效\\\\n\\\\n#### 2.1.4 删除门店\\\\n\\\\n**功能描述**：删除指定的门店。\\\\n\\\\n**输入参数**：\\\\n- 门店ID：要删除的门店ID\\\\n\\\\n**业务规则**：\\\\n- 删除前需要二次确认\\\\n- 不能删除有订单记录的门店\\\\n- 不能删除有员工的门店\\\\n- 记录删除操作到审计日志\\\\n\\\\n#### 2.1.5 门店详情\\\\n\\\\n**功能描述**：查看门店的详细信息。\\\\n\\\\n**输入参数**：\\\\n- 门店ID：要查看的门店ID\\\\n\\\\n**输出结果**：\\\\n- 门店详情：包含门店的完整信息\\\\n- 门店统计：订单数、营业额、员工数等\\\\n\\\\n**业务规则**：\\\\n- 显示门店的完整信息\\\\n- 显示门店的统计数据\\\\n- 显示门店的员工列表\\\\n- 显示门店的库存信息\\\\n\\\\n#### 2.1.6 门店状态管理\\\\n\\\\n**功能描述**：管理门店的营业状态。\\\\n\\\\n**输入参数**：\\\\n- 门店ID：要操作的门店ID\\\\n- 状态：营业中、休息中、已关闭\\\\n\\\\n**业务规则**：\\\\n- 状态变更立即生效\\\\n- 记录状态变更操作\\\\n- 状态变更后通知相关员工\\\\n- 已关闭的门店不能接单\\\\n\\\\n### 2.2 员工管理\\\\n\\\\n#### 2.2.1 员工列表\\\\n\\\\n**功能描述**：展示指定门店的员工信息，支持搜索、筛选和分页。\\\\n\\\\n**输入参数**：\\\\n- 门店ID：门店ID（可选，为空则显示所有员工）\\\\n- 关键词：员工姓名、工号、手机号\\\\n- 部门：按部门筛选\\\\n- 职位：按职位筛选\\\\n- 状态：在职、离职、请假\\\\n- 页码：当前页码\\\\n- 每页数量：每页显示数量\\\\n\\\\n**输出结果**：\\\\n- 员工列表：包含员工基本信息\\\\n- 总数：符合条件的员工总数\\\\n\\\\n**字段说明**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | number | 是 | 员工ID |\\\\n| employeeCode | string | 是 | 工号 |\\\\n| name | string | 是 | 姓名 |\\\\n| gender | string | 是 | 性别：male/female/other |\\\\n| phone | string | 是 | 手机号 |\\\\n| email | string | 否 | 邮箱 |\\\\n| avatar | string | 否 | 头像 |\\\\n| storeId | number | 是 | 所属门店ID |\\\\n| storeName | string | 是 | 所属门店名称 |\\\\n| department | string | 是 | 部门 |\\\\n| position | string | 是 | 职位 |\\\\n| status | string | 是 | 状态：active/resigned/leave |\\\\n| hireDate | string | 是 | 入职日期 |\\\\n| resignDate | string | 否 | 离职日期 |\\\\n| salary | number | 是 | 薪资 |\\\\n| address | string | 否 | 地址 |\\\\n| idCard | string | 否 | 身份证号 |\\\\n| bankAccount | string | 否 | 银行账号 |\\\\n| emergencyContact | object | 否 | 紧急联系人 |\\\\n| permissions | array | 是 | 权限列表 |\\\\n| createdAt | string | 是 | 创建时间 |\\\\n| updatedAt | string | 否 | 更新时间 |\\\\n\\\\n**紧急联系人字段**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| name | string | 是 | 姓名 |\\\\n| phone | string | 是 | 电话 |\\\\n| relationship | string | 是 | 关系 |\\\\n\\\\n#### 2.2.2 新增员工\\\\n\\\\n**功能描述**：创建新的员工信息。\\\\n\\\\n**输入参数**：\\\\n- 工号：员工工号\\\\n- 姓名：员工姓名\\\\n- 性别：性别\\\\n- 手机号：手机号\\\\n- 邮箱：邮箱（可选）\\\\n- 头像：头像（可选）\\\\n- 所属门店：选择门店\\\\n- 部门：选择部门\\\\n- 职位：选择职位\\\\n- 状态：在职、离职、请假\\\\n- 入职日期：入职日期\\\\n- 薪资：薪资\\\\n- 地址：地址（可选）\\\\n- 身份证号：身份证号（可选）\\\\n- 银行账号：银行账号（可选）\\\\n- 紧急联系人：紧急联系人信息（可选）\\\\n- 权限：选择权限\\\\n\\\\n**验证规则**：\\\\n- 工号：4-20位字符，唯一\\\\n- 姓名：2-20位中文字符\\\\n- 手机号：11位手机号\\\\n- 邮箱：有效的邮箱格式\\\\n- 薪资：正数，0-100000\\\\n- 身份证号：18位身份证号\\\\n\\\\n**业务规则**：\\\\n- 工号必须唯一\\\\n- 新员工默认状态为在职\\\\n- 自动记录创建时间和创建人\\\\n- 自动生成员工ID\\\\n- 所属门店必须存在\\\\n\\\\n#### 2.2.3 编辑员工\\\\n\\\\n**功能描述**：修改员工信息。\\\\n\\\\n**输入参数**：\\\\n- 员工ID：要编辑的员工ID\\\\n- 姓名：可修改\\\\n- 性别：可修改\\\\n- 手机号：可修改\\\\n- 邮箱：可修改\\\\n- 头像：可修改\\\\n- 所属门店：可修改\\\\n- 部门：可修改\\\\n- 职位：可修改\\\\n- 状态：可修改\\\\n- 薪资：可修改\\\\n- 地址：可修改\\\\n- 身份证号：可修改\\\\n- 银行账号：可修改\\\\n- 紧急联系人：可修改\\\\n- 权限：可修改\\\\n\\\\n**验证规则**：\\\\n- 姓名：2-20位中文字符\\\\n- 手机号：11位手机号\\\\n- 邮箱：有效的邮箱格式\\\\n- 薪资：正数，0-100000\\\\n- 身份证号：18位身份证号\\\\n\\\\n**业务规则**：\\\\n- 记录修改时间和修改人\\\\n- 工号不可修改\\\\n- 修改后立即生效\\\\n\\\\n#### 2.2.4 删除员工\\\\n\\\\n**功能描述**：删除指定的员工。\\\\n\\\\n**输入参数**：\\\\n- 员工ID：要删除的员工ID\\\\n\\\\n**业务规则**：\\\\n- 删除前需要二次确认\\\\n- 不能删除有订单记录的员工\\\\n- 记录删除操作到审计日志\\\\n\\\\n#### 2.2.5 员工调店\\\\n\\\\n**功能描述**：将员工调到其他门店。\\\\n\\\\n**输入参数**：\\\\n- 员工ID：要调动的员工ID\\\\n- 目标门店：目标门店ID\\\\n- 调动原因：调动原因\\\\n- 生效日期：生效日期\\\\n\\\\n**业务规则**：\\\\n- 调动后员工归属新门店\\\\n- 记录调动操作到审计日志\\\\n- 通知相关门店和员工\\\\n\\\\n#### 2.2.6 员工权限管理\\\\n\\\\n**功能描述**：管理员工的系统权限。\\\\n\\\\n**输入参数**：\\\\n- 员工ID：要操作的员工ID\\\\n- 权限列表：权限列表\\\\n\\\\n**业务规则**：\\\\n- 权限变更立即生效\\\\n- 记录权限变更操作\\\\n- 权限变更后通知员工\\\\n\\\\n### 2.3 库存管理\\\\n\\\\n#### 2.3.1 库存列表\\\\n\\\\n**功能描述**：展示指定门店的库存信息，支持搜索、筛选和分页。\\\\n\\\\n**输入参数**：\\\\n- 门店ID：门店ID（可选，为空则显示所有库存）\\\\n- 关键词：商品名称、商品编码\\\\n- 分类：按分类筛选\\\\n- 状态：充足、预警、缺货\\\\n- 页码：当前页码\\\\n- 每页数量：每页显示数量\\\\n\\\\n**输出结果**：\\\\n- 库存列表：包含库存基本信息\\\\n- 总数：符合条件的库存总数\\\\n\\\\n**字段说明**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | number | 是 | 库存ID |\\\\n| storeId | number | 是 | 门店ID |\\\\n| storeName | string | 是 | 门店名称 |\\\\n| productId | number | 是 | 商品ID |\\\\n| productName | string | 是 | 商品名称 |\\\\n| productCode | string | 是 | 商品编码 |\\\\n| category | string | 是 | 分类 |\\\\n| quantity | number | 是 | 当前数量 |\\\\n| unit | string | 是 | 单位 |\\\\n| minQuantity | number | 是 | 最小库存 |\\\\n| maxQuantity | number | 是 | 最大库存 |\\\\n| costPrice | number | 是 | 成本价 |\\\\n| status | string | 是 | 状态：normal/warning/out_of_stock |\\\\n| lastRestockDate | string | 否 | 最后补货日期 |\\\\n| supplier | object | 否 | 供应商信息 |\\\\n| location | string | 否 | 存放位置 |\\\\n| batchNumber | string | 否 | 批次号 |\\\\n| expiryDate | string | 否 | 过期日期 |\\\\n| createdAt | string | 是 | 创建时间 |\\\\n| updatedAt | string | 否 | 更新时间 |\\\\n\\\\n**供应商信息字段**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | number | 是 | 供应商ID |\\\\n| name | string | 是 | 供应商名称 |\\\\n| phone | string | 是 | 联系电话 |\\\\n\\\\n#### 2.3.2 库存补货\\\\n\\\\n**功能描述**：为门店库存补货。\\\\n\\\\n**输入参数**：\\\\n- 门店ID：门店ID\\\\n- 商品ID：商品ID\\\\n- 补货数量：补货数量\\\\n- 补货单价：补货单价\\\\n- 供应商：供应商（可选）\\\\n- 批次号：批次号（可选）\\\\n- 过期日期：过期日期（可选）\\\\n- 备注：备注（可选）\\\\n\\\\n**验证规则**：\\\\n- 补货数量：正整数，1-10000\\\\n- 补货单价：正数，0-100000\\\\n\\\\n**业务规则**：\\\\n- 补货后更新库存数量\\\\n- 记录补货操作到库存日志\\\\n- 补货后检查库存状态\\\\n- 通知相关员工\\\\n\\\\n#### 2.3.3 库存调拨\\\\n\\\\n**功能描述**：在门店之间调拨库存。\\\\n\\\\n**输入参数**：\\\\n- 源门店ID：源门店ID\\\\n- 目标门店ID：目标门店ID\\\\n- 商品ID：商品ID\\\\n- 调拨数量：调拨数量\\\\n- 调拨原因：调拨原因\\\\n- 生效日期：生效日期\\\\n\\\\n**验证规则**：\\\\n- 调拨数量：正整数，1-10000\\\\n- 源门店库存必须充足\\\\n\\\\n**业务规则**：\\\\n- 调拨后更新两个门店的库存\\\\n- 记录调拨操作到库存日志\\\\n- 通知相关门店\\\\n- 生成调拨单\\\\n\\\\n#### 2.3.4 库存盘点\\\\n\\\\n**功能描述**：对门店库存进行盘点。\\\\n\\\\n**输入参数**：\\\\n- 门店ID：门店ID\\\\n- 盘点日期：盘点日期\\\\n- 盘点明细：盘点明细列表\\\\n\\\\n**盘点明细字段**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| productId | number | 是 | 商品ID |\\\\n| actualQuantity | number | 是 | 实际数量 |\\\\n| difference | number | 是 | 差异数量 |\\\\n| reason | string | 否 | 差异原因 |\\\\n\\\\n**业务规则**：\\\\n- 盘点后更新库存数量\\\\n- 记录盘点操作到库存日志\\\\n- 生成盘点报告\\\\n- 记录库存差异\\\\n\\\\n#### 2.3.5 库存预警\\\\n\\\\n**功能描述**：查看库存预警信息。\\\\n\\\\n**输入参数**：\\\\n- 门店ID：门店ID（可选）\\\\n- 预警类型：低库存、即将过期\\\\n\\\\n**输出结果**：\\\\n- 预警列表：包含预警信息\\\\n\\\\n**业务规则**：\\\\n- 库存低于最小库存时预警\\\\n- 即将过期的商品预警\\\\n- 自动发送预警通知\\\\n\\\\n### 2.4 数据统计\\\\n\\\\n#### 2.4.1 门店统计\\\\n\\\\n**功能描述**：展示门店的统计数据。\\\\n\\\\n**输入参数**：\\\\n- 门店ID：门店ID（可选，为空则显示所有门店统计）\\\\n- 开始时间：统计开始时间\\\\n- 结束时间：统计结束时间\\\\n\\\\n**输出结果**：\\\\n- 门店统计：包含门店的各项统计数据\\\\n\\\\n**字段说明**：\\\\n| 字段名 | 类型 | 说明 |\\\\n|--------|------|------|\\\\n| storeId | number | 门店ID |\\\\n| storeName | string | 门店名称 |\\\\n| totalOrders | number | 总订单数 |\\\\n| totalRevenue | number | 总营业额 |\\\\n| averageOrderValue | number | 平均订单价值 |\\\\n| totalCustomers | number | 总顾客数 |\\\\n| customerRetentionRate | number | 顾客留存率 |\\\\n| employeeCount | number | 员工数量 |\\\\n| averageRating | number | 平均评分 |\\\\n| dailyStats | array | 每日统计 |\\\\n| monthlyStats | array | 每月统计 |\\\\n\\\\n**业务规则**：\\\\n- 统计数据实时更新\\\\n- 支持按时间范围查询\\\\n- 支持按门店筛选\\\\n\\\\n#### 2.4.2 员工绩效\\\\n\\\\n**功能描述**：展示员工的绩效数据。\\\\n\\\\n**输入参数**：\\\\n- 门店ID：门店ID（可选）\\\\n- 员工ID：员工ID（可选）\\\\n- 开始时间：统计开始时间\\\\n- 结束时间：统计结束时间\\\\n\\\\n**输出结果**：\\\\n- 员工绩效：包含员工的绩效数据\\\\n\\\\n**字段说明**：\\\\n| 字段名 | 类型 | 说明 |\\\\n|--------|------|------|\\\\n| employeeId | number | 员工ID |\\\\n| employeeName | string | 员工姓名 |\\\\n| storeName | string | 门店名称 |\\\\n| department | string | 部门 |\\\\n| position | string | 职位 |\\\\n| totalOrders | number | 总订单数 |\\\\n| totalRevenue | number | 总营业额 |\\\\n| averageOrderValue | number | 平均订单价值 |\\\\n| customerSatisfaction | number | 顾客满意度 |\\\\n| attendanceRate | number | 出勤率 |\\\\n| performanceScore | number | 绩效评分 |\\\\n| ranking | number | 排名 |\\\\n\\\\n**业务规则**：\\\\n- 绩效数据实时更新\\\\n- 支持按时间范围查询\\\\n- 支持按门店和员工筛选\\\\n\\\\n#### 2.4.3 营收对比\\\\n\\\\n**功能描述**：对比不同门店的营收数据。\\\\n\\\\n**输入参数**：\\\\n- 门店列表：门店ID列表\\\\n- 开始时间：统计开始时间\\\\n- 结束时间：统计结束时间\\\\n- 对比维度：日、周、月、年\\\\n\\\\n**输出结果**：\\\\n- 营收对比：包含各门店的营收对比数据\\\\n\\\\n**业务规则**：\\\\n- 支持多门店对比\\\\n- 支持多种时间维度\\\\n- 生成对比图表\\\\n\\\\n#### 2.4.4 趋势分析\\\\n\\\\n**功能描述**：分析门店的发展趋势。\\\\n\\\\n**输入参数**：\\\\n- 门店ID：门店ID\\\\n- 开始时间：统计开始时间\\\\n- 结束时间：统计结束时间\\\\n- 分析维度：订单、营收、顾客、员工\\\\n\\\\n**输出结果**：\\\\n- 趋势数据：包含趋势分析数据\\\\n\\\\n**业务规则**：\\\\n- 支持多种分析维度\\\\n- 生成趋势图表\\\\n- 提供趋势预测\\\\n\\\\n## 3. 非功能需求\\\\n\\\\n### 3.1 性能需求\\\\n\\\\n- 门店列表加载时间 < 1秒\\\\n- 员工列表加载时间 < 1秒\\\\n- 库存列表加载时间 < 2秒\\\\n- 统计数据加载时间 < 3秒\\\\n- 支持至少1000家门店\\\\n- 支持至少100,000名员工\\\\n- 支持至少1,000,000条库存记录\\\\n- 数据同步延迟 < 5秒\\\\n\\\\n### 3.2 安全需求\\\\n\\\\n- 所有操作需要身份认证\\\\n- 支持门店权限隔离\\\\n- 支持操作权限控制\\\\n- 敏感数据加密存储\\\\n- 支持数据访问权限控制\\\\n- 定期备份数据\\\\n- 支持审计日志\\\\n- 支持数据恢复\\\\n\\\\n### 3.3 可用性需求\\\\n\\\\n- 系统可用性 ≥ 99.9%\\\\n- 支持多浏览器访问\\\\n- 支持移动端访问\\\\n- 提供友好的错误提示\\\\n- 提供操作帮助文档\\\\n- 支持离线操作\\\\n\\\\n### 3.4 可维护性需求\\\\n\\\\n- 代码结构清晰\\\\n- 模块化设计\\\\n- 完善的日志记录\\\\n- 完善的错误处理\\\\n- 支持热更新\\\\n- 支持配置管理\\\\n- 支持功能扩展\\\\n\\\\n## 4. 技术设计\\\\n\\\\n### 4.1 技术栈\\\\n\\\\n- 前端框架：Vue 3 + TypeScript\\\\n- UI组件库：Element Plus\\\\n- 状态管理：Pinia\\\\n- 路由管理：Vue Router\\\\n- HTTP客户端：Axios\\\\n- 表单验证：Zod\\\\n- 图表库：ECharts\\\\n- 地图库：高德地图API\\\\n- 构建工具：Vite\\\\n\\\\n### 4.2 数据库设计\\\\n\\\\n#### 门店表（stores）\\\\n\\\\n| 字段名 | 类型 | 约束 | 说明 |\\\\n|--------|------|--------|------|\\\\n| id | int | PRIMARY KEY | 门店ID |\\\\n| store_code | varchar(50) | UNIQUE | 门店编号 |\\\\n| name | varchar(100) | NOT NULL | 门店名称 |\\\\n| type | varchar(20) | NOT NULL | 门店类型 |\\\\n| status | varchar(20) | NOT NULL | 门店状态 |\\\\n| address | varchar(200) | NOT NULL | 门店地址 |\\\\n| city | varchar(50) | NOT NULL | 所在城市 |\\\\n| district | varchar(50) | NOT NULL | 所在区县 |\\\\n| phone | varchar(20) | NOT NULL | 联系电话 |\\\\n| email | varchar(100) | NULL | 邮箱 |\\\\n| manager_id | int | NULL | 店长ID |\\\\n| business_hours | json | NOT NULL | 营业时间 |\\\\n| area | int | NOT NULL | 门店面积 |\\\\n| capacity | int | NOT NULL | 最大容量 |\\\\n| tables | int | NOT NULL | 桌位数量 |\\\\n| employees | int | NOT NULL | 员工数量 |\\\\n| coordinates | json | NULL | 地理坐标 |\\\\n| facilities | json | NULL | 设施列表 |\\\\n| description | text | NULL | 门店描述 |\\\\n| images | json | NULL | 门店图片 |\\\\n| opening_date | date | NOT NULL | 开业日期 |\\\\n| rating | decimal(2,1) | NULL | 评分 |\\\\n| review_count | int | NULL | 评论数 |\\\\n| created_at | timestamp | NOT NULL | 创建时间 |\\\\n| updated_at | timestamp | NULL | 更新时间 |\\\\n\\\\n#### 员工表（employees）\\\\n\\\\n| 字段名 | 类型 | 约束 | 说明 |\\\\n|--------|------|--------|------|\\\\n| id | int | PRIMARY KEY | 员工ID |\\\\n| employee_code | varchar(50) | UNIQUE | 工号 |\\\\n| name | varchar(50) | NOT NULL | 姓名 |\\\\n| gender | varchar(10) | NOT NULL | 性别 |\\\\n| phone | varchar(20) | NOT NULL | 手机号 |\\\\n| email | varchar(100) | NULL | 邮箱 |\\\\n| avatar | varchar(255) | NULL | 头像 |\\\\n| store_id | int | NOT NULL | 所属门店ID |\\\\n| department | varchar(50) | NOT NULL | 部门 |\\\\n| position | varchar(50) | NOT NULL | 职位 |\\\\n| status | varchar(20) | NOT NULL | 状态 |\\\\n| hire_date | date | NOT NULL | 入职日期 |\\\\n| resign_date | date | NULL | 离职日期 |\\\\n| salary | decimal(10,2) | NOT NULL | 薪资 |\\\\n| address | varchar(200) | NULL | 地址 |\\\\n| id_card | varchar(20) | NULL | 身份证号 |\\\\n| bank_account | varchar(50) | NULL | 银行账号 |\\\\n| emergency_contact | json | NULL | 紧急联系人 |\\\\n| permissions | json | NOT NULL | 权限列表 |\\\\n| created_at | timestamp | NOT NULL | 创建时间 |\\\\n| updated_at | timestamp | NULL | 更新时间 |\\\\n\\\\n#### 库存表（inventory）\\\\n\\\\n| 字段名 | 类型 | 约束 | 说明 |\\\\n|--------|------|--------|------|\\\\n| id | int | PRIMARY KEY | 库存ID |\\\\n| store_id | int | NOT NULL | 门店ID |\\\\n| product_id | int | NOT NULL | 商品ID |\\\\n| quantity | int | NOT NULL | 当前数量 |\\\\n| unit | varchar(20) | NOT NULL | 单位 |\\\\n| min_quantity | int | NOT NULL | 最小库存 |\\\\n| max_quantity | int | NOT NULL | 最大库存 |\\\\n| cost_price | decimal(10,2) | NOT NULL | 成本价 |\\\\n| status | varchar(20) | NOT NULL | 状态 |\\\\n| last_restock_date | date | NULL | 最后补货日期 |\\\\n| supplier | json | NULL | 供应商信息 |\\\\n| location | varchar(100) | NULL | 存放位置 |\\\\n| batch_number | varchar(50) | NULL | 批次号 |\\\\n| expiry_date | date | NULL | 过期日期 |\\\\n| created_at | timestamp | NOT NULL | 创建时间 |\\\\n| updated_at | timestamp | NULL | 更新时间 |\\\\n\\\\n### 4.3 API设计\\\\n\\\\n#### 门店管理API\\\\n\\\\n```\\\\nGET    /api/chain/stores              # 获取门店列表\\\\nGET    /api/chain/stores/:id          # 获取门店详情\\\\nPOST   /api/chain/stores              # 创建门店\\\\nPUT    /api/chain/stores/:id          # 更新门店\\\\nDELETE /api/chain/stores/:id          # 删除门店\\\\nPATCH  /api/chain/stores/:id/status   # 更新门店状态\\\\nGET    /api/chain/stores/:id/stats    # 获取门店统计\\\\n```\\\\n\\\\n#### 员工管理API\\\\n\\\\n```\\\\nGET    /api/chain/employees           # 获取员工列表\\\\nGET    /api/chain/employees/:id       # 获取员工详情\\\\nPOST   /api/chain/employees           # 创建员工\\\\nPUT    /api/chain/employees/:id       # 更新员工\\\\nDELETE /api/chain/employees/:id       # 删除员工\\\\nPOST   /api/chain/employees/:id/transfer  # 员工调店\\\\nPUT    /api/chain/employees/:id/permissions  # 更新员工权限\\\\nGET    /api/chain/employees/:id/performance  # 获取员工绩效\\\\n```\\\\n\\\\n#### 库存管理API\\\\n\\\\n```\\\\nGET    /api/chain/inventory          # 获取库存列表\\\\nGET    /api/chain/inventory/:id      # 获取库存详情\\\\nPOST   /api/chain/inventory/restock  # 库存补货\\\\nPOST   /api/chain/inventory/transfer # 库存调拨\\\\nPOST   /api/chain/inventory/check    # 库存盘点\\\\nGET    /api/chain/inventory/warnings # 获取库存预警\\\\n```\\\\n\\\\n#### 数据统计API\\\\n\\\\n```\\\\nGET    /api/chain/stats/stores       # 获取门店统计\\\\nGET    /api/chain/stats/employees    # 获取员工绩效\\\\nGET    /api/chain/stats/revenue      # 获取营收对比\\\\nGET    /api/chain/stats/trends      # 获取趋势分析\\\\n```\\\\n\\\\n### 4.4 门店类型设计\\\\n\\\\n| 门店类型 | 编码 | 说明 |\\\\n|---------|------|------|\\\\n| 直营店 | direct | 由公司直接经营的门店 |\\\\n| 加盟店 | franchise | 由加盟商经营的门店 |\\\\n\\\\n### 4.5 门店状态设计\\\\n\\\\n| 门店状态 | 编码 | 说明 |\\\\n|---------|------|------|\\\\n| 营业中 | open | 门店正常营业 |\\\\n| 休息中 | closed | 门店暂时休息 |\\\\n| 已关闭 | maintenance | 门店已关闭或维护 |\\\\n\\\\n### 4.6 员工状态设计\\\\n\\\\n| 员工状态 | 编码 | 说明 |\\\\n|---------|------|------|\\\\n| 在职 | active | 员工正常工作 |\\\\n| 离职 | resigned | 员工已离职 |\\\\n| 请假 | leave | 员工请假中 |\\\\n\\\\n### 4.7 库存状态设计\\\\n\\\\n| 库存状态 | 编码 | 说明 |\\\\n|---------|------|------|\\\\n| 充足 | normal | 库存数量正常 |\\\\n| 预警 | warning | 库存低于最小库存 |\\\\n| 缺货 | out_of_stock | 库存为零 |\\\\n\\\\n## 5. 界面设计\\\\n\\\\n### 5.1 连锁管理主界面\\\\n\\\\n- 页面标题和描述\\\\n- 统计卡片（门店总数、员工总数、库存总数、总营业额）\\\\n- 功能标签页（门店管理、员工管理、库存管理、数据统计）\\\\n- 添加门店按钮\\\\n\\\\n### 5.2 门店管理界面\\\\n\\\\n- 门店列表表格\\\\n- 搜索和筛选工具栏\\\\n- 新增门店按钮\\\\n- 操作按钮（查看、编辑、删除、状态管理）\\\\n- 门店详情对话框\\\\n- 门店地图显示\\\\n- 分页组件\\\\n\\\\n### 5.3 员工管理界面\\\\n\\\\n- 员工列表表格\\\\n- 搜索和筛选工具栏\\\\n- 新增员工按钮\\\\n- 操作按钮（查看、编辑、删除、调店、权限管理）\\\\n- 员工详情对话框\\\\n- 员工绩效对话框\\\\n- 分页组件\\\\n\\\\n### 5.4 库存管理界面\\\\n\\\\n- 库存列表表格\\\\n- 搜索和筛选工具栏\\\\n- 补货按钮\\\\n- 调拨按钮\\\\n- 盘点按钮\\\\n- 预警列表\\\\n- 操作按钮（补货、调拨、查看详情）\\\\n- 库存详情对话框\\\\n- 分页组件\\\\n\\\\n### 5.5 数据统计界面\\\\n\\\\n- 门店统计图表\\\\n- 员工绩效图表\\\\n- 营收对比图表\\\\n- 趋势分析图表\\\\n- 统计数据卡片\\\\n\\\\n## 6. 测试计划\\\\n\\\\n### 6.1 单元测试\\\\n\\\\n- 门店管理功能测试\\\\n- 员工管理功能测试\\\\n- 库存管理功能测试\\\\n- 数据统计功能测试\\\\n- 数据格式化功能测试\\\\n\\\\n### 6.2 集成测试\\\\n\\\\n- 门店CRUD操作测试\\\\n- 员工CRUD操作测试\\\\n- 库存操作测试\\\\n- 员工调店测试\\\\n- 库存调拨测试\\\\n- 数据统计测试\\\\n\\\\n### 6.3 性能测试\\\\n\\\\n- 大数据量加载测试\\\\n- 并发操作测试\\\\n- 响应时间测试\\\\n- 数据同步测试\\\\n\\\\n### 6.4 安全测试\\\\n\\\\n- 权限控制测试\\\\n- 数据隔离测试\\\\n- SQL注入测试\\\\n- XSS攻击测试\\\\n- CSRF攻击测试\\\\n\\\\n## 7. 部署计划\\\\n\\\\n### 7.1 开发环境\\\\n\\\\n- 部署时间：2025-01-20\\\\n- 部署方式：本地开发环境\\\\n- 测试范围：功能测试\\\\n\\\\n### 7.2 测试环境\\\\n\\\\n- 部署时间：2025-01-25\\\\n- 部署方式：CI/CD自动部署\\\\n- 测试范围：集成测试、性能测试、安全测试\\\\n\\\\n### 7.3 生产环境\\\\n\\\\n- 部署时间：2025-02-01\\\\n- 部署方式：蓝绿部署\\\\n- 测试范围：冒烟测试\\\\n\\\\n## 8. 附录\\\\n\\\\n### 8.1 术语表\\\\n\\\\n| 术语 | 说明 |\\\\n|------|------|\\\\n| 门店 | 连锁餐厅的各个分店 |\\\\n| 员工 | 门店的工作人员 |\\\\n| 库存 | 门店的商品库存 |\\\\n| 调店 | 员工从一个门店调到另一个门店 |\\\\n| 调拨 | 库存从一个门店调到另一个门店 |\\\\n| 盘点 | 对库存进行实际清点 |\\\\n| 绩效 | 员工的工作表现 |\\\\n| 营收对比 | 对比不同门店的营收数据 |\\\\n| 趋势分析 | 分析数据的发展趋势 |\\\\n\\\\n### 8.2 参考文档\\\\n\\\\n- YYC³餐饮管理系统总体设计文档\\\\n- YYC³餐饮管理系统数据库设计文档\\\\n- YYC³餐饮管理系统API文档\\\\n- YYC³餐饮管理系统安全规范\\\\n\\\\n### 8.3 变更记录\\\\n\\\\n| 版本 | 日期 | 变更内容 | 变更人 |\\\\n|------|------|---------|--------|\\\\n| V1.0.0 | 2025-01-20 | 初始版本 | YYC³团队 |\\\\n\\\\n---\\\\n\\\\n**文档结束**\\\\n\",\"originAcceptText\":\"# YYC³餐饮管理系统 - 连锁管理功能模块需求分析与设计文档\\n\\n## 文档信息\\n\\n| 项目 | 内容 |\\n|------|------|\\n| 文档名称 | 连锁管理功能模块需求分析与设计文档 |\\n| 文档版本 | V1.0.0 |\\n| 创建日期 | 2025-01-20 |\\n| 作者 | YYC³团队 |\\n| 文档状态 | 正式发布 |\\n\\n## 1. 概述\\n\\n### 1.1 模块简介\\n\\n连锁管理模块是YYC³餐饮管理系统的核心管理模块，负责管理连锁餐厅的门店信息、员工管理、库存管理、数据统计等功能。该模块为连锁餐饮企业提供了统一的门店管理平台，实现了跨门店的数据同步和统一管理。\\n\\n### 1.2 模块目标\\n\\n- 提供完整的门店信息管理\\n- 实现跨门店的数据同步\\n- 支持门店权限管理\\n- 提供门店数据统计和分析\\n- 实现库存统一管理\\n- 支持员工跨门店管理\\n- 提供门店绩效评估\\n- 确保数据安全和一致性\\n\\n### 1.3 适用范围\\n\\n本模块适用于YYC³餐饮管理系统的连锁版，支持多门店统一管理。\\n\\n## 2. 功能需求\\n\\n### 2.1 门店管理\\n\\n#### 2.1.1 门店列表\\n\\n**功能描述**：展示系统中所有门店信息，支持搜索、筛选和分页。\\n\\n**输入参数**：\\n- 关键词：门店名称、门店编号、地址\\n- 状态：营业中、休息中、已关闭\\n- 区域：按区域筛选\\n- 门店类型：直营店、加盟店\\n- 页码：当前页码\\n- 每页数量：每页显示数量\\n\\n**输出结果**：\\n- 门店列表：包含门店基本信息\\n- 总数：符合条件的门店总数\\n\\n**字段说明**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | number | 是 | 门店ID |\\n| storeCode | string | 是 | 门店编号 |\\n| name | string | 是 | 门店名称 |\\n| type | string | 是 | 门店类型：direct/franchise |\\n| status | string | 是 | 门店状态：open/closed/maintenance |\\n| address | string | 是 | 门店地址 |\\n| city | string | 是 | 所在城市 |\\n| district | string | 是 | 所在区县 |\\n| phone | string | 是 | 联系电话 |\\n| email | string | 否 | 邮箱 |\\n| manager | object | 是 | 店长信息 |\\n| businessHours | object | 是 | 营业时间 |\\n| area | number | 是 | 门店面积（平方米） |\\n| capacity | number | 是 | 最大容量（人） |\\n| tables | number | 是 | 桌位数量 |\\n| employees | number | 是 | 员工数量 |\\n| coordinates | object | 否 | 地理坐标 |\\n| facilities | array | 否 | 设施列表 |\\n| description | string | 否 | 门店描述 |\\n| images | array | 否 | 门店图片 |\\n| openingDate | string | 是 | 开业日期 |\\n| rating | number | 否 | 评分 |\\n| reviewCount | number | 否 | 评论数 |\\n| createdAt | string | 是 | 创建时间 |\\n| updatedAt | string | 否 | 更新时间 |\\n\\n**店长信息字段**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | number | 是 | 员工ID |\\n| name | string | 是 | 姓名 |\\n| phone | string | 是 | 电话 |\\n| avatar | string | 否 | 头像 |\\n\\n**营业时间字段**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| monday | object | 是 | 周一营业时间 |\\n| tuesday | object | 是 | 周二营业时间 |\\n| wednesday | object | 是 | 周三营业时间 |\\n| thursday | object | 是 | 周四营业时间 |\\n| friday | object | 是 | 周五营业时间 |\\n| saturday | object | 是 | 周六营业时间 |\\n| sunday | object | 是 | 周日营业时间 |\\n\\n**每日营业时间字段**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| open | string | 是 | 开门时间 |\\n| close | string | 是 | 关门时间 |\\n| enabled | boolean | 是 | 是否营业 |\\n\\n#### 2.1.2 新增门店\\n\\n**功能描述**：创建新的门店信息。\\n\\n**输入参数**：\\n- 门店编号：门店唯一编号\\n- 门店名称：门店显示名称\\n- 门店类型：直营店、加盟店\\n- 门店状态：营业中、休息中、已关闭\\n- 门店地址：详细地址\\n- 所在城市：城市名称\\n- 所在区县：区县名称\\n- 联系电话：联系电话\\n- 邮箱：邮箱地址（可选）\\n- 店长：选择店长\\n- 营业时间：设置营业时间\\n- 门店面积：门店面积（平方米）\\n- 最大容量：最大容量（人）\\n- 桌位数量：桌位数量\\n- 地理坐标：经纬度（可选）\\n- 设施列表：门店设施（可选）\\n- 门店描述：门店说明（可选）\\n- 门店图片：上传图片（可选）\\n- 开业日期：开业日期\\n\\n**验证规则**：\\n- 门店编号：4-20位字符，唯一\\n- 门店名称：2-50位中文字符\\n- 门店地址：5-200位字符\\n- 联系电话：11位手机号或座机号\\n- 邮箱：有效的邮箱格式\\n- 门店面积：正整数，1-10000\\n- 最大容量：正整数，1-1000\\n- 桌位数量：正整数，1-500\\n- 开业日期：有效的日期格式\\n\\n**业务规则**：\\n- 门店编号必须唯一\\n- 新门店默认状态为休息中\\n- 自动记录创建时间和创建人\\n- 自动生成门店ID\\n- 店长必须为已存在的员工\\n\\n#### 2.1.3 编辑门店\\n\\n**功能描述**：修改门店信息。\\n\\n**输入参数**：\\n- 门店ID：要编辑的门店ID\\n- 门店名称：可修改\\n- 门店类型：可修改\\n- 门店状态：可修改\\n- 门店地址：可修改\\n- 所在城市：可修改\\n- 所在区县：可修改\\n- 联系电话：可修改\\n- 邮箱：可修改\\n- 店长：可修改\\n- 营业时间：可修改\\n- 门店面积：可修改\\n- 最大容量：可修改\\n- 桌位数量：可修改\\n- 地理坐标：可修改\\n- 设施列表：可修改\\n- 门店描述：可修改\\n- 门店图片：可修改\\n\\n**验证规则**：\\n- 门店名称：2-50位中文字符\\n- 门店地址：5-200位字符\\n- 联系电话：11位手机号或座机号\\n- 邮箱：有效的邮箱格式\\n- 门店面积：正整数，1-10000\\n- 最大容量：正整数，1-1000\\n- 桌位数量：正整数，1-500\\n\\n**业务规则**：\\n- 记录修改时间和修改人\\n- 门店编号不可修改\\n- 修改后立即生效\\n\\n#### 2.1.4 删除门店\\n\\n**功能描述**：删除指定的门店。\\n\\n**输入参数**：\\n- 门店ID：要删除的门店ID\\n\\n**业务规则**：\\n- 删除前需要二次确认\\n- 不能删除有订单记录的门店\\n- 不能删除有员工的门店\\n- 记录删除操作到审计日志\\n\\n#### 2.1.5 门店详情\\n\\n**功能描述**：查看门店的详细信息。\\n\\n**输入参数**：\\n- 门店ID：要查看的门店ID\\n\\n**输出结果**：\\n- 门店详情：包含门店的完整信息\\n- 门店统计：订单数、营业额、员工数等\\n\\n**业务规则**：\\n- 显示门店的完整信息\\n- 显示门店的统计数据\\n- 显示门店的员工列表\\n- 显示门店的库存信息\\n\\n#### 2.1.6 门店状态管理\\n\\n**功能描述**：管理门店的营业状态。\\n\\n**输入参数**：\\n- 门店ID：要操作的门店ID\\n- 状态：营业中、休息中、已关闭\\n\\n**业务规则**：\\n- 状态变更立即生效\\n- 记录状态变更操作\\n- 状态变更后通知相关员工\\n- 已关闭的门店不能接单\\n\\n### 2.2 员工管理\\n\\n#### 2.2.1 员工列表\\n\\n**功能描述**：展示指定门店的员工信息，支持搜索、筛选和分页。\\n\\n**输入参数**：\\n- 门店ID：门店ID（可选，为空则显示所有员工）\\n- 关键词：员工姓名、工号、手机号\\n- 部门：按部门筛选\\n- 职位：按职位筛选\\n- 状态：在职、离职、请假\\n- 页码：当前页码\\n- 每页数量：每页显示数量\\n\\n**输出结果**：\\n- 员工列表：包含员工基本信息\\n- 总数：符合条件的员工总数\\n\\n**字段说明**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | number | 是 | 员工ID |\\n| employeeCode | string | 是 | 工号 |\\n| name | string | 是 | 姓名 |\\n| gender | string | 是 | 性别：male/female/other |\\n| phone | string | 是 | 手机号 |\\n| email | string | 否 | 邮箱 |\\n| avatar | string | 否 | 头像 |\\n| storeId | number | 是 | 所属门店ID |\\n| storeName | string | 是 | 所属门店名称 |\\n| department | string | 是 | 部门 |\\n| position | string | 是 | 职位 |\\n| status | string | 是 | 状态：active/resigned/leave |\\n| hireDate | string | 是 | 入职日期 |\\n| resignDate | string | 否 | 离职日期 |\\n| salary | number | 是 | 薪资 |\\n| address | string | 否 | 地址 |\\n| idCard | string | 否 | 身份证号 |\\n| bankAccount | string | 否 | 银行账号 |\\n| emergencyContact | object | 否 | 紧急联系人 |\\n| permissions | array | 是 | 权限列表 |\\n| createdAt | string | 是 | 创建时间 |\\n| updatedAt | string | 否 | 更新时间 |\\n\\n**紧急联系人字段**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| name | string | 是 | 姓名 |\\n| phone | string | 是 | 电话 |\\n| relationship | string | 是 | 关系 |\\n\\n#### 2.2.2 新增员工\\n\\n**功能描述**：创建新的员工信息。\\n\\n**输入参数**：\\n- 工号：员工工号\\n- 姓名：员工姓名\\n- 性别：性别\\n- 手机号：手机号\\n- 邮箱：邮箱（可选）\\n- 头像：头像（可选）\\n- 所属门店：选择门店\\n- 部门：选择部门\\n- 职位：选择职位\\n- 状态：在职、离职、请假\\n- 入职日期：入职日期\\n- 薪资：薪资\\n- 地址：地址（可选）\\n- 身份证号：身份证号（可选）\\n- 银行账号：银行账号（可选）\\n- 紧急联系人：紧急联系人信息（可选）\\n- 权限：选择权限\\n\\n**验证规则**：\\n- 工号：4-20位字符，唯一\\n- 姓名：2-20位中文字符\\n- 手机号：11位手机号\\n- 邮箱：有效的邮箱格式\\n- 薪资：正数，0-100000\\n- 身份证号：18位身份证号\\n\\n**业务规则**：\\n- 工号必须唯一\\n- 新员工默认状态为在职\\n- 自动记录创建时间和创建人\\n- 自动生成员工ID\\n- 所属门店必须存在\\n\\n#### 2.2.3 编辑员工\\n\\n**功能描述**：修改员工信息。\\n\\n**输入参数**：\\n- 员工ID：要编辑的员工ID\\n- 姓名：可修改\\n- 性别：可修改\\n- 手机号：可修改\\n- 邮箱：可修改\\n- 头像：可修改\\n- 所属门店：可修改\\n- 部门：可修改\\n- 职位：可修改\\n- 状态：可修改\\n- 薪资：可修改\\n- 地址：可修改\\n- 身份证号：可修改\\n- 银行账号：可修改\\n- 紧急联系人：可修改\\n- 权限：可修改\\n\\n**验证规则**：\\n- 姓名：2-20位中文字符\\n- 手机号：11位手机号\\n- 邮箱：有效的邮箱格式\\n- 薪资：正数，0-100000\\n- 身份证号：18位身份证号\\n\\n**业务规则**：\\n- 记录修改时间和修改人\\n- 工号不可修改\\n- 修改后立即生效\\n\\n#### 2.2.4 删除员工\\n\\n**功能描述**：删除指定的员工。\\n\\n**输入参数**：\\n- 员工ID：要删除的员工ID\\n\\n**业务规则**：\\n- 删除前需要二次确认\\n- 不能删除有订单记录的员工\\n- 记录删除操作到审计日志\\n\\n#### 2.2.5 员工调店\\n\\n**功能描述**：将员工调到其他门店。\\n\\n**输入参数**：\\n- 员工ID：要调动的员工ID\\n- 目标门店：目标门店ID\\n- 调动原因：调动原因\\n- 生效日期：生效日期\\n\\n**业务规则**：\\n- 调动后员工归属新门店\\n- 记录调动操作到审计日志\\n- 通知相关门店和员工\\n\\n#### 2.2.6 员工权限管理\\n\\n**功能描述**：管理员工的系统权限。\\n\\n**输入参数**：\\n- 员工ID：要操作的员工ID\\n- 权限列表：权限列表\\n\\n**业务规则**：\\n- 权限变更立即生效\\n- 记录权限变更操作\\n- 权限变更后通知员工\\n\\n### 2.3 库存管理\\n\\n#### 2.3.1 库存列表\\n\\n**功能描述**：展示指定门店的库存信息，支持搜索、筛选和分页。\\n\\n**输入参数**：\\n- 门店ID：门店ID（可选，为空则显示所有库存）\\n- 关键词：商品名称、商品编码\\n- 分类：按分类筛选\\n- 状态：充足、预警、缺货\\n- 页码：当前页码\\n- 每页数量：每页显示数量\\n\\n**输出结果**：\\n- 库存列表：包含库存基本信息\\n- 总数：符合条件的库存总数\\n\\n**字段说明**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | number | 是 | 库存ID |\\n| storeId | number | 是 | 门店ID |\\n| storeName | string | 是 | 门店名称 |\\n| productId | number | 是 | 商品ID |\\n| productName | string | 是 | 商品名称 |\\n| productCode | string | 是 | 商品编码 |\\n| category | string | 是 | 分类 |\\n| quantity | number | 是 | 当前数量 |\\n| unit | string | 是 | 单位 |\\n| minQuantity | number | 是 | 最小库存 |\\n| maxQuantity | number | 是 | 最大库存 |\\n| costPrice | number | 是 | 成本价 |\\n| status | string | 是 | 状态：normal/warning/out_of_stock |\\n| lastRestockDate | string | 否 | 最后补货日期 |\\n| supplier | object | 否 | 供应商信息 |\\n| location | string | 否 | 存放位置 |\\n| batchNumber | string | 否 | 批次号 |\\n| expiryDate | string | 否 | 过期日期 |\\n| createdAt | string | 是 | 创建时间 |\\n| updatedAt | string | 否 | 更新时间 |\\n\\n**供应商信息字段**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | number | 是 | 供应商ID |\\n| name | string | 是 | 供应商名称 |\\n| phone | string | 是 | 联系电话 |\\n\\n#### 2.3.2 库存补货\\n\\n**功能描述**：为门店库存补货。\\n\\n**输入参数**：\\n- 门店ID：门店ID\\n- 商品ID：商品ID\\n- 补货数量：补货数量\\n- 补货单价：补货单价\\n- 供应商：供应商（可选）\\n- 批次号：批次号（可选）\\n- 过期日期：过期日期（可选）\\n- 备注：备注（可选）\\n\\n**验证规则**：\\n- 补货数量：正整数，1-10000\\n- 补货单价：正数，0-100000\\n\\n**业务规则**：\\n- 补货后更新库存数量\\n- 记录补货操作到库存日志\\n- 补货后检查库存状态\\n- 通知相关员工\\n\\n#### 2.3.3 库存调拨\\n\\n**功能描述**：在门店之间调拨库存。\\n\\n**输入参数**：\\n- 源门店ID：源门店ID\\n- 目标门店ID：目标门店ID\\n- 商品ID：商品ID\\n- 调拨数量：调拨数量\\n- 调拨原因：调拨原因\\n- 生效日期：生效日期\\n\\n**验证规则**：\\n- 调拨数量：正整数，1-10000\\n- 源门店库存必须充足\\n\\n**业务规则**：\\n- 调拨后更新两个门店的库存\\n- 记录调拨操作到库存日志\\n- 通知相关门店\\n- 生成调拨单\\n\\n#### 2.3.4 库存盘点\\n\\n**功能描述**：对门店库存进行盘点。\\n\\n**输入参数**：\\n- 门店ID：门店ID\\n- 盘点日期：盘点日期\\n- 盘点明细：盘点明细列表\\n\\n**盘点明细字段**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| productId | number | 是 | 商品ID |\\n| actualQuantity | number | 是 | 实际数量 |\\n| difference | number | 是 | 差异数量 |\\n| reason | string | 否 | 差异原因 |\\n\\n**业务规则**：\\n- 盘点后更新库存数量\\n- 记录盘点操作到库存日志\\n- 生成盘点报告\\n- 记录库存差异\\n\\n#### 2.3.5 库存预警\\n\\n**功能描述**：查看库存预警信息。\\n\\n**输入参数**：\\n- 门店ID：门店ID（可选）\\n- 预警类型：低库存、即将过期\\n\\n**输出结果**：\\n- 预警列表：包含预警信息\\n\\n**业务规则**：\\n- 库存低于最小库存时预警\\n- 即将过期的商品预警\\n- 自动发送预警通知\\n\\n### 2.4 数据统计\\n\\n#### 2.4.1 门店统计\\n\\n**功能描述**：展示门店的统计数据。\\n\\n**输入参数**：\\n- 门店ID：门店ID（可选，为空则显示所有门店统计）\\n- 开始时间：统计开始时间\\n- 结束时间：统计结束时间\\n\\n**输出结果**：\\n- 门店统计：包含门店的各项统计数据\\n\\n**字段说明**：\\n| 字段名 | 类型 | 说明 |\\n|--------|------|------|\\n| storeId | number | 门店ID |\\n| storeName | string | 门店名称 |\\n| totalOrders | number | 总订单数 |\\n| totalRevenue | number | 总营业额 |\\n| averageOrderValue | number | 平均订单价值 |\\n| totalCustomers | number | 总顾客数 |\\n| customerRetentionRate | number | 顾客留存率 |\\n| employeeCount | number | 员工数量 |\\n| averageRating | number | 平均评分 |\\n| dailyStats | array | 每日统计 |\\n| monthlyStats | array | 每月统计 |\\n\\n**业务规则**：\\n- 统计数据实时更新\\n- 支持按时间范围查询\\n- 支持按门店筛选\\n\\n#### 2.4.2 员工绩效\\n\\n**功能描述**：展示员工的绩效数据。\\n\\n**输入参数**：\\n- 门店ID：门店ID（可选）\\n- 员工ID：员工ID（可选）\\n- 开始时间：统计开始时间\\n- 结束时间：统计结束时间\\n\\n**输出结果**：\\n- 员工绩效：包含员工的绩效数据\\n\\n**字段说明**：\\n| 字段名 | 类型 | 说明 |\\n|--------|------|------|\\n| employeeId | number | 员工ID |\\n| employeeName | string | 员工姓名 |\\n| storeName | string | 门店名称 |\\n| department | string | 部门 |\\n| position | string | 职位 |\\n| totalOrders | number | 总订单数 |\\n| totalRevenue | number | 总营业额 |\\n| averageOrderValue | number | 平均订单价值 |\\n| customerSatisfaction | number | 顾客满意度 |\\n| attendanceRate | number | 出勤率 |\\n| performanceScore | number | 绩效评分 |\\n| ranking | number | 排名 |\\n\\n**业务规则**：\\n- 绩效数据实时更新\\n- 支持按时间范围查询\\n- 支持按门店和员工筛选\\n\\n#### 2.4.3 营收对比\\n\\n**功能描述**：对比不同门店的营收数据。\\n\\n**输入参数**：\\n- 门店列表：门店ID列表\\n- 开始时间：统计开始时间\\n- 结束时间：统计结束时间\\n- 对比维度：日、周、月、年\\n\\n**输出结果**：\\n- 营收对比：包含各门店的营收对比数据\\n\\n**业务规则**：\\n- 支持多门店对比\\n- 支持多种时间维度\\n- 生成对比图表\\n\\n#### 2.4.4 趋势分析\\n\\n**功能描述**：分析门店的发展趋势。\\n\\n**输入参数**：\\n- 门店ID：门店ID\\n- 开始时间：统计开始时间\\n- 结束时间：统计结束时间\\n- 分析维度：订单、营收、顾客、员工\\n\\n**输出结果**：\\n- 趋势数据：包含趋势分析数据\\n\\n**业务规则**：\\n- 支持多种分析维度\\n- 生成趋势图表\\n- 提供趋势预测\\n\\n## 3. 非功能需求\\n\\n### 3.1 性能需求\\n\\n- 门店列表加载时间 < 1秒\\n- 员工列表加载时间 < 1秒\\n- 库存列表加载时间 < 2秒\\n- 统计数据加载时间 < 3秒\\n- 支持至少1000家门店\\n- 支持至少100,000名员工\\n- 支持至少1,000,000条库存记录\\n- 数据同步延迟 < 5秒\\n\\n### 3.2 安全需求\\n\\n- 所有操作需要身份认证\\n- 支持门店权限隔离\\n- 支持操作权限控制\\n- 敏感数据加密存储\\n- 支持数据访问权限控制\\n- 定期备份数据\\n- 支持审计日志\\n- 支持数据恢复\\n\\n### 3.3 可用性需求\\n\\n- 系统可用性 ≥ 99.9%\\n- 支持多浏览器访问\\n- 支持移动端访问\\n- 提供友好的错误提示\\n- 提供操作帮助文档\\n- 支持离线操作\\n\\n### 3.4 可维护性需求\\n\\n- 代码结构清晰\\n- 模块化设计\\n- 完善的日志记录\\n- 完善的错误处理\\n- 支持热更新\\n- 支持配置管理\\n- 支持功能扩展\\n\\n## 4. 技术设计\\n\\n### 4.1 技术栈\\n\\n- 前端框架：Vue 3 + TypeScript\\n- UI组件库：Element Plus\\n- 状态管理：Pinia\\n- 路由管理：Vue Router\\n- HTTP客户端：Axios\\n- 表单验证：Zod\\n- 图表库：ECharts\\n- 地图库：高德地图API\\n- 构建工具：Vite\\n\\n### 4.2 数据库设计\\n\\n#### 门店表（stores）\\n\\n| 字段名 | 类型 | 约束 | 说明 |\\n|--------|------|--------|------|\\n| id | int | PRIMARY KEY | 门店ID |\\n| store_code | varchar(50) | UNIQUE | 门店编号 |\\n| name | varchar(100) | NOT NULL | 门店名称 |\\n| type | varchar(20) | NOT NULL | 门店类型 |\\n| status | varchar(20) | NOT NULL | 门店状态 |\\n| address | varchar(200) | NOT NULL | 门店地址 |\\n| city | varchar(50) | NOT NULL | 所在城市 |\\n| district | varchar(50) | NOT NULL | 所在区县 |\\n| phone | varchar(20) | NOT NULL | 联系电话 |\\n| email | varchar(100) | NULL | 邮箱 |\\n| manager_id | int | NULL | 店长ID |\\n| business_hours | json | NOT NULL | 营业时间 |\\n| area | int | NOT NULL | 门店面积 |\\n| capacity | int | NOT NULL | 最大容量 |\\n| tables | int | NOT NULL | 桌位数量 |\\n| employees | int | NOT NULL | 员工数量 |\\n| coordinates | json | NULL | 地理坐标 |\\n| facilities | json | NULL | 设施列表 |\\n| description | text | NULL | 门店描述 |\\n| images | json | NULL | 门店图片 |\\n| opening_date | date | NOT NULL | 开业日期 |\\n| rating | decimal(2,1) | NULL | 评分 |\\n| review_count | int | NULL | 评论数 |\\n| created_at | timestamp | NOT NULL | 创建时间 |\\n| updated_at | timestamp | NULL | 更新时间 |\\n\\n#### 员工表（employees）\\n\\n| 字段名 | 类型 | 约束 | 说明 |\\n|--------|------|--------|------|\\n| id | int | PRIMARY KEY | 员工ID |\\n| employee_code | varchar(50) | UNIQUE | 工号 |\\n| name | varchar(50) | NOT NULL | 姓名 |\\n| gender | varchar(10) | NOT NULL | 性别 |\\n| phone | varchar(20) | NOT NULL | 手机号 |\\n| email | varchar(100) | NULL | 邮箱 |\\n| avatar | varchar(255) | NULL | 头像 |\\n| store_id | int | NOT NULL | 所属门店ID |\\n| department | varchar(50) | NOT NULL | 部门 |\\n| position | varchar(50) | NOT NULL | 职位 |\\n| status | varchar(20) | NOT NULL | 状态 |\\n| hire_date | date | NOT NULL | 入职日期 |\\n| resign_date | date | NULL | 离职日期 |\\n| salary | decimal(10,2) | NOT NULL | 薪资 |\\n| address | varchar(200) | NULL | 地址 |\\n| id_card | varchar(20) | NULL | 身份证号 |\\n| bank_account | varchar(50) | NULL | 银行账号 |\\n| emergency_contact | json | NULL | 紧急联系人 |\\n| permissions | json | NOT NULL | 权限列表 |\\n| created_at | timestamp | NOT NULL | 创建时间 |\\n| updated_at | timestamp | NULL | 更新时间 |\\n\\n#### 库存表（inventory）\\n\\n| 字段名 | 类型 | 约束 | 说明 |\\n|--------|------|--------|------|\\n| id | int | PRIMARY KEY | 库存ID |\\n| store_id | int | NOT NULL | 门店ID |\\n| product_id | int | NOT NULL | 商品ID |\\n| quantity | int | NOT NULL | 当前数量 |\\n| unit | varchar(20) | NOT NULL | 单位 |\\n| min_quantity | int | NOT NULL | 最小库存 |\\n| max_quantity | int | NOT NULL | 最大库存 |\\n| cost_price | decimal(10,2) | NOT NULL | 成本价 |\\n| status | varchar(20) | NOT NULL | 状态 |\\n| last_restock_date | date | NULL | 最后补货日期 |\\n| supplier | json | NULL | 供应商信息 |\\n| location | varchar(100) | NULL | 存放位置 |\\n| batch_number | varchar(50) | NULL | 批次号 |\\n| expiry_date | date | NULL | 过期日期 |\\n| created_at | timestamp | NOT NULL | 创建时间 |\\n| updated_at | timestamp | NULL | 更新时间 |\\n\\n### 4.3 API设计\\n\\n#### 门店管理API\\n\\n```\\nGET    /api/chain/stores              # 获取门店列表\\nGET    /api/chain/stores/:id          # 获取门店详情\\nPOST   /api/chain/stores              # 创建门店\\nPUT    /api/chain/stores/:id          # 更新门店\\nDELETE /api/chain/stores/:id          # 删除门店\\nPATCH  /api/chain/stores/:id/status   # 更新门店状态\\nGET    /api/chain/stores/:id/stats    # 获取门店统计\\n```\\n\\n#### 员工管理API\\n\\n```\\nGET    /api/chain/employees           # 获取员工列表\\nGET    /api/chain/employees/:id       # 获取员工详情\\nPOST   /api/chain/employees           # 创建员工\\nPUT    /api/chain/employees/:id       # 更新员工\\nDELETE /api/chain/employees/:id       # 删除员工\\nPOST   /api/chain/employees/:id/transfer  # 员工调店\\nPUT    /api/chain/employees/:id/permissions  # 更新员工权限\\nGET    /api/chain/employees/:id/performance  # 获取员工绩效\\n```\\n\\n#### 库存管理API\\n\\n```\\nGET    /api/chain/inventory          # 获取库存列表\\nGET    /api/chain/inventory/:id      # 获取库存详情\\nPOST   /api/chain/inventory/restock  # 库存补货\\nPOST   /api/chain/inventory/transfer # 库存调拨\\nPOST   /api/chain/inventory/check    # 库存盘点\\nGET    /api/chain/inventory/warnings # 获取库存预警\\n```\\n\\n#### 数据统计API\\n\\n```\\nGET    /api/chain/stats/stores       # 获取门店统计\\nGET    /api/chain/stats/employees    # 获取员工绩效\\nGET    /api/chain/stats/revenue      # 获取营收对比\\nGET    /api/chain/stats/trends      # 获取趋势分析\\n```\\n\\n### 4.4 门店类型设计\\n\\n| 门店类型 | 编码 | 说明 |\\n|---------|------|------|\\n| 直营店 | direct | 由公司直接经营的门店 |\\n| 加盟店 | franchise | 由加盟商经营的门店 |\\n\\n### 4.5 门店状态设计\\n\\n| 门店状态 | 编码 | 说明 |\\n|---------|------|------|\\n| 营业中 | open | 门店正常营业 |\\n| 休息中 | closed | 门店暂时休息 |\\n| 已关闭 | maintenance | 门店已关闭或维护 |\\n\\n### 4.6 员工状态设计\\n\\n| 员工状态 | 编码 | 说明 |\\n|---------|------|------|\\n| 在职 | active | 员工正常工作 |\\n| 离职 | resigned | 员工已离职 |\\n| 请假 | leave | 员工请假中 |\\n\\n### 4.7 库存状态设计\\n\\n| 库存状态 | 编码 | 说明 |\\n|---------|------|------|\\n| 充足 | normal | 库存数量正常 |\\n| 预警 | warning | 库存低于最小库存 |\\n| 缺货 | out_of_stock | 库存为零 |\\n\\n## 5. 界面设计\\n\\n### 5.1 连锁管理主界面\\n\\n- 页面标题和描述\\n- 统计卡片（门店总数、员工总数、库存总数、总营业额）\\n- 功能标签页（门店管理、员工管理、库存管理、数据统计）\\n- 添加门店按钮\\n\\n### 5.2 门店管理界面\\n\\n- 门店列表表格\\n- 搜索和筛选工具栏\\n- 新增门店按钮\\n- 操作按钮（查看、编辑、删除、状态管理）\\n- 门店详情对话框\\n- 门店地图显示\\n- 分页组件\\n\\n### 5.3 员工管理界面\\n\\n- 员工列表表格\\n- 搜索和筛选工具栏\\n- 新增员工按钮\\n- 操作按钮（查看、编辑、删除、调店、权限管理）\\n- 员工详情对话框\\n- 员工绩效对话框\\n- 分页组件\\n\\n### 5.4 库存管理界面\\n\\n- 库存列表表格\\n- 搜索和筛选工具栏\\n- 补货按钮\\n- 调拨按钮\\n- 盘点按钮\\n- 预警列表\\n- 操作按钮（补货、调拨、查看详情）\\n- 库存详情对话框\\n- 分页组件\\n\\n### 5.5 数据统计界面\\n\\n- 门店统计图表\\n- 员工绩效图表\\n- 营收对比图表\\n- 趋势分析图表\\n- 统计数据卡片\\n\\n## 6. 测试计划\\n\\n### 6.1 单元测试\\n\\n- 门店管理功能测试\\n- 员工管理功能测试\\n- 库存管理功能测试\\n- 数据统计功能测试\\n- 数据格式化功能测试\\n\\n### 6.2 集成测试\\n\\n- 门店CRUD操作测试\\n- 员工CRUD操作测试\\n- 库存操作测试\\n- 员工调店测试\\n- 库存调拨测试\\n- 数据统计测试\\n\\n### 6.3 性能测试\\n\\n- 大数据量加载测试\\n- 并发操作测试\\n- 响应时间测试\\n- 数据同步测试\\n\\n### 6.4 安全测试\\n\\n- 权限控制测试\\n- 数据隔离测试\\n- SQL注入测试\\n- XSS攻击测试\\n- CSRF攻击测试\\n\\n## 7. 部署计划\\n\\n### 7.1 开发环境\\n\\n- 部署时间：2025-01-20\\n- 部署方式：本地开发环境\\n- 测试范围：功能测试\\n\\n### 7.2 测试环境\\n\\n- 部署时间：2025-01-25\\n- 部署方式：CI/CD自动部署\\n- 测试范围：集成测试、性能测试、安全测试\\n\\n### 7.3 生产环境\\n\\n- 部署时间：2025-02-01\\n- 部署方式：蓝绿部署\\n- 测试范围：冒烟测试\\n\\n## 8. 附录\\n\\n### 8.1 术语表\\n\\n| 术语 | 说明 |\\n|------|------|\\n| 门店 | 连锁餐厅的各个分店 |\\n| 员工 | 门店的工作人员 |\\n| 库存 | 门店的商品库存 |\\n| 调店 | 员工从一个门店调到另一个门店 |\\n| 调拨 | 库存从一个门店调到另一个门店 |\\n| 盘点 | 对库存进行实际清点 |\\n| 绩效 | 员工的工作表现 |\\n| 营收对比 | 对比不同门店的营收数据 |\\n| 趋势分析 | 分析数据的发展趋势 |\\n\\n### 8.2 参考文档\\n\\n- YYC³餐饮管理系统总体设计文档\\n- YYC³餐饮管理系统数据库设计文档\\n- YYC³餐饮管理系统API文档\\n- YYC³餐饮管理系统安全规范\\n\\n### 8.3 变更记录\\n\\n| 版本 | 日期 | 变更内容 | 变更人 |\\n|------|------|---------|--------|\\n| V1.0.0 | 2025-01-20 | 初始版本 | YYC³团队 |\\n\\n---\\n\\n**文档结束**\\n\",\"originTextLength\":16252,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768883436657}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/api/chain.ts": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":719,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":719,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"/**\\\\n * @fileoverview 连锁管理API服务\\\\n * @description 提供连锁管理相关的API接口\\\\n * @module chain\\\\n * @author YYC³\\\\n * @version 1.0.0\\\\n * @created 2025-01-20\\\\n */\\\\n\\\\nimport { httpClient } from \\\\'@/utils/http\\\\'\\\\n\\\\nexport enum StoreType {\\\\n  DIRECT = \\\\'direct\\\\',\\\\n  FRANCHISE = \\\\'franchise\\\\'\\\\n}\\\\n\\\\nexport enum StoreStatus {\\\\n  OPEN = \\\\'open\\\\',\\\\n  CLOSED = \\\\'closed\\\\',\\\\n  MAINTENANCE = \\\\'maintenance\\\\'\\\\n}\\\\n\\\\nexport enum EmployeeStatus {\\\\n  ACTIVE = \\\\'active\\\\',\\\\n  RESIGNED = \\\\'resigned\\\\',\\\\n  LEAVE = \\\\'leave\\\\'\\\\n}\\\\n\\\\nexport enum InventoryStatus {\\\\n  NORMAL = \\\\'normal\\\\',\\\\n  WARNING = \\\\'warning\\\\',\\\\n  OUT_OF_STOCK = \\\\'out_of_stock\\\\'\\\\n}\\\\n\\\\nexport interface BusinessHours {\\\\n  open: string\\\\n  close: string\\\\n  enabled: boolean\\\\n}\\\\n\\\\nexport interface WeeklyBusinessHours {\\\\n  monday: BusinessHours\\\\n  tuesday: BusinessHours\\\\n  wednesday: BusinessHours\\\\n  thursday: BusinessHours\\\\n  friday: BusinessHours\\\\n  saturday: BusinessHours\\\\n  sunday: BusinessHours\\\\n}\\\\n\\\\nexport interface Manager {\\\\n  id: number\\\\n  name: string\\\\n  phone: string\\\\n  avatar?: string\\\\n}\\\\n\\\\nexport interface Store {\\\\n  id: number\\\\n  storeCode: string\\\\n  name: string\\\\n  type: StoreType\\\\n  status: StoreStatus\\\\n  address: string\\\\n  city: string\\\\n  district: string\\\\n  phone: string\\\\n  email?: string\\\\n  manager: Manager\\\\n  businessHours: WeeklyBusinessHours\\\\n  area: number\\\\n  capacity: number\\\\n  tables: number\\\\n  employees: number\\\\n  coordinates?: {\\\\n    latitude: number\\\\n    longitude: number\\\\n  }\\\\n  facilities?: string[]\\\\n  description?: string\\\\n  images?: string[]\\\\n  openingDate: string\\\\n  rating?: number\\\\n  reviewCount?: number\\\\n  createdAt: string\\\\n  updatedAt?: string\\\\n}\\\\n\\\\nexport interface EmergencyContact {\\\\n  name: string\\\\n  phone: string\\\\n  relationship: string\\\\n}\\\\n\\\\nexport interface Employee {\\\\n  id: number\\\\n  employeeCode: string\\\\n  name: string\\\\n  gender: \\\\'male\\\\' | \\\\'female\\\\' | \\\\'other\\\\'\\\\n  phone: string\\\\n  email?: string\\\\n  avatar?: string\\\\n  storeId: number\\\\n  storeName: string\\\\n  department: string\\\\n  position: string\\\\n  status: EmployeeStatus\\\\n  hireDate: string\\\\n  resignDate?: string\\\\n  salary: number\\\\n  address?: string\\\\n  idCard?: string\\\\n  bankAccount?: string\\\\n  emergencyContact?: EmergencyContact\\\\n  permissions: string[]\\\\n  createdAt: string\\\\n  updatedAt?: string\\\\n}\\\\n\\\\nexport interface Supplier {\\\\n  id: number\\\\n  name: string\\\\n  phone: string\\\\n}\\\\n\\\\nexport interface Inventory {\\\\n  id: number\\\\n  storeId: number\\\\n  storeName: string\\\\n  productId: number\\\\n  productName: string\\\\n  productCode: string\\\\n  category: string\\\\n  quantity: number\\\\n  unit: string\\\\n  minQuantity: number\\\\n  maxQuantity: number\\\\n  costPrice: number\\\\n  status: InventoryStatus\\\\n  lastRestockDate?: string\\\\n  supplier?: Supplier\\\\n  location?: string\\\\n  batchNumber?: string\\\\n  expiryDate?: string\\\\n  createdAt: string\\\\n  updatedAt?: string\\\\n}\\\\n\\\\nexport interface StoreStats {\\\\n  storeId: number\\\\n  storeName: string\\\\n  totalOrders: number\\\\n  totalRevenue: number\\\\n  averageOrderValue: number\\\\n  totalCustomers: number\\\\n  customerRetentionRate: number\\\\n  employeeCount: number\\\\n  averageRating: number\\\\n  dailyStats: DailyStats[]\\\\n  monthlyStats: MonthlyStats[]\\\\n}\\\\n\\\\nexport interface DailyStats {\\\\n  date: string\\\\n  orders: number\\\\n  revenue: number\\\\n  customers: number\\\\n}\\\\n\\\\nexport interface MonthlyStats {\\\\n  month: string\\\\n  orders: number\\\\n  revenue: number\\\\n  customers: number\\\\n}\\\\n\\\\nexport interface EmployeePerformance {\\\\n  employeeId: number\\\\n  employeeName: string\\\\n  storeName: string\\\\n  department: string\\\\n  position: string\\\\n  totalOrders: number\\\\n  totalRevenue: number\\\\n  averageOrderValue: number\\\\n  customerSatisfaction: number\\\\n  attendanceRate: number\\\\n  performanceScore: number\\\\n  ranking: number\\\\n}\\\\n\\\\nexport interface RevenueComparison {\\\\n  storeId: number\\\\n  storeName: string\\\\n  revenue: number\\\\n  orders: number\\\\n  growth: number\\\\n}\\\\n\\\\nexport interface TrendData {\\\\n  date: string\\\\n  value: number\\\\n  predicted?: number\\\\n}\\\\n\\\\nexport interface StoreQueryParams {\\\\n  page?: number\\\\n  limit?: number\\\\n  search?: string\\\\n  status?: StoreStatus\\\\n  type?: StoreType\\\\n  city?: string\\\\n  district?: string\\\\n}\\\\n\\\\nexport interface EmployeeQueryParams {\\\\n  page?: number\\\\n  limit?: number\\\\n  search?: string\\\\n  storeId?: number\\\\n  department?: string\\\\n  position?: string\\\\n  status?: EmployeeStatus\\\\n}\\\\n\\\\nexport interface InventoryQueryParams {\\\\n  page?: number\\\\n  limit?: number\\\\n  search?: string\\\\n  storeId?: number\\\\n  category?: string\\\\n  status?: InventoryStatus\\\\n}\\\\n\\\\nexport interface CreateStoreRequest {\\\\n  storeCode: string\\\\n  name: string\\\\n  type: StoreType\\\\n  status: StoreStatus\\\\n  address: string\\\\n  city: string\\\\n  district: string\\\\n  phone: string\\\\n  email?: string\\\\n  managerId: number\\\\n  businessHours: WeeklyBusinessHours\\\\n  area: number\\\\n  capacity: number\\\\n  tables: number\\\\n  coordinates?: {\\\\n    latitude: number\\\\n    longitude: number\\\\n  }\\\\n  facilities?: string[]\\\\n  description?: string\\\\n  images?: string[]\\\\n  openingDate: string\\\\n}\\\\n\\\\nexport interface UpdateStoreRequest {\\\\n  name?: string\\\\n  type?: StoreType\\\\n  status?: StoreStatus\\\\n  address?: string\\\\n  city?: string\\\\n  district?: string\\\\n  phone?: string\\\\n  email?: string\\\\n  managerId?: number\\\\n  businessHours?: WeeklyBusinessHours\\\\n  area?: number\\\\n  capacity?: number\\\\n  tables?: number\\\\n  coordinates?: {\\\\n    latitude: number\\\\n    longitude: number\\\\n  }\\\\n  facilities?: string[]\\\\n  description?: string\\\\n  images?: string[]\\\\n}\\\\n\\\\nexport interface CreateEmployeeRequest {\\\\n  employeeCode: string\\\\n  name: string\\\\n  gender: \\\\'male\\\\' | \\\\'female\\\\' | \\\\'other\\\\'\\\\n  phone: string\\\\n  email?: string\\\\n  avatar?: string\\\\n  storeId: number\\\\n  department: string\\\\n  position: string\\\\n  status: EmployeeStatus\\\\n  hireDate: string\\\\n  salary: number\\\\n  address?: string\\\\n  idCard?: string\\\\n  bankAccount?: string\\\\n  emergencyContact?: EmergencyContact\\\\n  permissions: string[]\\\\n}\\\\n\\\\nexport interface UpdateEmployeeRequest {\\\\n  name?: string\\\\n  gender?: \\\\'male\\\\' | \\\\'female\\\\' | \\\\'other\\\\'\\\\n  phone?: string\\\\n  email?: string\\\\n  avatar?: string\\\\n  storeId?: number\\\\n  department?: string\\\\n  position?: string\\\\n  status?: EmployeeStatus\\\\n  salary?: number\\\\n  address?: string\\\\n  idCard?: string\\\\n  bankAccount?: string\\\\n  emergencyContact?: EmergencyContact\\\\n  permissions?: string[]\\\\n}\\\\n\\\\nexport interface TransferEmployeeRequest {\\\\n  targetStoreId: number\\\\n  reason: string\\\\n  effectiveDate: string\\\\n}\\\\n\\\\nexport interface RestockInventoryRequest {\\\\n  storeId: number\\\\n  productId: number\\\\n  quantity: number\\\\n  costPrice: number\\\\n  supplier?: Supplier\\\\n  batchNumber?: string\\\\n  expiryDate?: string\\\\n  remarks?: string\\\\n}\\\\n\\\\nexport interface TransferInventoryRequest {\\\\n  sourceStoreId: number\\\\n  targetStoreId: number\\\\n  productId: number\\\\n  quantity: number\\\\n  reason: string\\\\n  effectiveDate: string\\\\n}\\\\n\\\\nexport interface CheckInventoryRequest {\\\\n  storeId: number\\\\n  checkDate: string\\\\n  details: {\\\\n    productId: number\\\\n    actualQuantity: number\\\\n    difference: number\\\\n    reason?: string\\\\n  }[]\\\\n}\\\\n\\\\nexport class ChainAPI {\\\\n  private baseUrl = \\\\'/api/chain\\\\'\\\\n\\\\n  async getStores(params?: StoreQueryParams): Promise<{ success: boolean; data: { items: Store[]; pagination: any }; message?: string }> {\\\\n    try {\\\\n      const queryString = new URLSearchParams()\\\\n      if (params?.page) queryString.set(\\\\'page\\\\', params.page.toString())\\\\n      if (params?.limit) queryString.set(\\\\'limit\\\\', params.limit.toString())\\\\n      if (params?.search) queryString.set(\\\\'search\\\\', params.search)\\\\n      if (params?.status) queryString.set(\\\\'status\\\\', params.status)\\\\n      if (params?.type) queryString.set(\\\\'type\\\\', params.type)\\\\n      if (params?.city) queryString.set(\\\\'city\\\\', params.city)\\\\n      if (params?.district) queryString.set(\\\\'district\\\\', params.district)\\\\n\\\\n      const endpoint = queryString.toString() ? `${this.baseUrl}/stores?${queryString}` : `${this.baseUrl}/stores`\\\\n      const response = await httpClient.get<{ success: boolean; data: { items: Store[]; pagination: any }; message?: string }>(endpoint)\\\\n      return response\\\\n    } catch (error) {\\\\n      console.error(\\\\'Get stores failed:\\\\', error)\\\\n      return {\\\\n        success: false,\\\\n        data: {\\\\n          items: [],\\\\n          pagination: {\\\\n            page: 1,\\\\n            limit: 20,\\\\n            total: 0,\\\\n            totalPages: 0\\\\n          }\\\\n        },\\\\n        message: \\\\'获取门店列表失败\\\\'\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  async getStore(id: number): Promise<{ success: boolean; data?: Store; message?: string }> {\\\\n    try {\\\\n      const response = await httpClient.get<{ success: boolean; data?: Store; message?: string }>(`${this.baseUrl}/stores/${id}`)\\\\n      return response\\\\n    } catch (error) {\\\\n      console.error(\\\\'Get store failed:\\\\', error)\\\\n      return {\\\\n        success: false,\\\\n        message: \\\\'获取门店详情失败\\\\'\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  async createStore(storeData: CreateStoreRequest): Promise<{ success: boolean; data?: Store; message?: string }> {\\\\n    try {\\\\n      const response = await httpClient.post<{ success: boolean; data?: Store; message?: string }>(`${this.baseUrl}/stores`, storeData)\\\\n      return response\\\\n    } catch (error) {\\\\n      console.error(\\\\'Create store failed:\\\\', error)\\\\n      return {\\\\n        success: false,\\\\n        message: \\\\'创建门店失败\\\\'\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  async updateStore(id: number, storeData: UpdateStoreRequest): Promise<{ success: boolean; data?: Store; message?: string }> {\\\\n    try {\\\\n      const response = await httpClient.put<{ success: boolean; data?: Store; message?: string }>(`${this.baseUrl}/stores/${id}`, storeData)\\\\n      return response\\\\n    } catch (error) {\\\\n      console.error(\\\\'Update store failed:\\\\', error)\\\\n      return {\\\\n        success: false,\\\\n        message: \\\\'更新门店失败\\\\'\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  async deleteStore(id: number): Promise<{ success: boolean; message?: string }> {\\\\n    try {\\\\n      const response = await httpClient.delete<{ success: boolean; message?: string }>(`${this.baseUrl}/stores/${id}`)\\\\n      return response\\\\n    } catch (error) {\\\\n      console.error(\\\\'Delete store failed:\\\\', error)\\\\n      return {\\\\n        success: false,\\\\n        message: \\\\'删除门店失败\\\\'\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  async updateStoreStatus(id: number, status: StoreStatus): Promise<{ success: boolean; message?: string }> {\\\\n    try {\\\\n      const response = await httpClient.patch<{ success: boolean; message?: string }>(`${this.baseUrl}/stores/${id}/status`, { status })\\\\n      return response\\\\n    } catch (error) {\\\\n      console.error(\\\\'Update store status failed:\\\\', error)\\\\n      return {\\\\n        success: false,\\\\n        message: \\\\'更新门店状态失败\\\\'\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  async getStoreStats(id: number, startDate?: string, endDate?: string): Promise<{ success: boolean; data?: StoreStats; message?: string }> {\\\\n    try {\\\\n      const queryString = new URLSearchParams()\\\\n      if (startDate) queryString.set(\\\\'startDate\\\\', startDate)\\\\n      if (endDate) queryString.set(\\\\'endDate\\\\', endDate)\\\\n\\\\n      const endpoint = queryString.toString() ? `${this.baseUrl}/stores/${id}/stats?${queryString}` : `${this.baseUrl}/stores/${id}/stats`\\\\n      const response = await httpClient.get<{ success: boolean; data?: StoreStats; message?: string }>(endpoint)\\\\n      return response\\\\n    } catch (error) {\\\\n      console.error(\\\\'Get store stats failed:\\\\', error)\\\\n      return {\\\\n        success: false,\\\\n        message: \\\\'获取门店统计失败\\\\'\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  async getEmployees(params?: EmployeeQueryParams): Promise<{ success: boolean; data: { items: Employee[]; pagination: any }; message?: string }> {\\\\n    try {\\\\n      const queryString = new URLSearchParams()\\\\n      if (params?.page) queryString.set(\\\\'page\\\\', params.page.toString())\\\\n      if (params?.limit) queryString.set(\\\\'limit\\\\', params.limit.toString())\\\\n      if (params?.search) queryString.set(\\\\'search\\\\', params.search)\\\\n      if (params?.storeId) queryString.set(\\\\'storeId\\\\', params.storeId.toString())\\\\n      if (params?.department) queryString.set(\\\\'department\\\\', params.department)\\\\n      if (params?.position) queryString.set(\\\\'position\\\\', params.position)\\\\n      if (params?.status) queryString.set(\\\\'status\\\\', params.status)\\\\n\\\\n      const endpoint = queryString.toString() ? `${this.baseUrl}/employees?${queryString}` : `${this.baseUrl}/employees`\\\\n      const response = await httpClient.get<{ success: boolean; data: { items: Employee[]; pagination: any }; message?: string }>(endpoint)\\\\n      return response\\\\n    } catch (error) {\\\\n      console.error(\\\\'Get employees failed:\\\\', error)\\\\n      return {\\\\n        success: false,\\\\n        data: {\\\\n          items: [],\\\\n          pagination: {\\\\n            page: 1,\\\\n            limit: 20,\\\\n            total: 0,\\\\n            totalPages: 0\\\\n          }\\\\n        },\\\\n        message: \\\\'获取员工列表失败\\\\'\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  async getEmployee(id: number): Promise<{ success: boolean; data?: Employee; message?: string }> {\\\\n    try {\\\\n      const response = await httpClient.get<{ success: boolean; data?: Employee; message?: string }>(`${this.baseUrl}/employees/${id}`)\\\\n      return response\\\\n    } catch (error) {\\\\n      console.error(\\\\'Get employee failed:\\\\', error)\\\\n      return {\\\\n        success: false,\\\\n        message: \\\\'获取员工详情失败\\\\'\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  async createEmployee(employeeData: CreateEmployeeRequest): Promise<{ success: boolean; data?: Employee; message?: string }> {\\\\n    try {\\\\n      const response = await httpClient.post<{ success: boolean; data?: Employee; message?: string }>(`${this.baseUrl}/employees`, employeeData)\\\\n      return response\\\\n    } catch (error) {\\\\n      console.error(\\\\'Create employee failed:\\\\', error)\\\\n      return {\\\\n        success: false,\\\\n        message: \\\\'创建员工失败\\\\'\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  async updateEmployee(id: number, employeeData: UpdateEmployeeRequest): Promise<{ success: boolean; data?: Employee; message?: string }> {\\\\n    try {\\\\n      const response = await httpClient.put<{ success: boolean; data?: Employee; message?: string }>(`${this.baseUrl}/employees/${id}`, employeeData)\\\\n      return response\\\\n    } catch (error) {\\\\n      console.error(\\\\'Update employee failed:\\\\', error)\\\\n      return {\\\\n        success: false,\\\\n        message: \\\\'更新员工失败\\\\'\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  async deleteEmployee(id: number): Promise<{ success: boolean; message?: string }> {\\\\n    try {\\\\n      const response = await httpClient.delete<{ success: boolean; message?: string }>(`${this.baseUrl}/employees/${id}`)\\\\n      return response\\\\n    } catch (error) {\\\\n      console.error(\\\\'Delete employee failed:\\\\', error)\\\\n      return {\\\\n        success: false,\\\\n        message: \\\\'删除员工失败\\\\'\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  async transferEmployee(id: number, transferData: TransferEmployeeRequest): Promise<{ success: boolean; message?: string }> {\\\\n    try {\\\\n      const response = await httpClient.post<{ success: boolean; message?: string }>(`${this.baseUrl}/employees/${id}/transfer`, transferData)\\\\n      return response\\\\n    } catch (error) {\\\\n      console.error(\\\\'Transfer employee failed:\\\\', error)\\\\n      return {\\\\n        success: false,\\\\n        message: \\\\'员工调店失败\\\\'\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  async updateEmployeePermissions(id: number, permissions: string[]): Promise<{ success: boolean; message?: string }> {\\\\n    try {\\\\n      const response = await httpClient.put<{ success: boolean; message?: string }>(`${this.baseUrl}/employees/${id}/permissions`, { permissions })\\\\n      return response\\\\n    } catch (error) {\\\\n      console.error(\\\\'Update employee permissions failed:\\\\', error)\\\\n      return {\\\\n        success: false,\\\\n        message: \\\\'更新员工权限失败\\\\'\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  async getEmployeePerformance(id: number, startDate?: string, endDate?: string): Promise<{ success: boolean; data?: EmployeePerformance; message?: string }> {\\\\n    try {\\\\n      const queryString = new URLSearchParams()\\\\n      if (startDate) queryString.set(\\\\'startDate\\\\', startDate)\\\\n      if (endDate) queryString.set(\\\\'endDate\\\\', endDate)\\\\n\\\\n      const endpoint = queryString.toString() ? `${this.baseUrl}/employees/${id}/performance?${queryString}` : `${this.baseUrl}/employees/${id}/performance`\\\\n      const response = await httpClient.get<{ success: boolean; data?: EmployeePerformance; message?: string }>(endpoint)\\\\n      return response\\\\n    } catch (error) {\\\\n      console.error(\\\\'Get employee performance failed:\\\\', error)\\\\n      return {\\\\n        success: false,\\\\n        message: \\\\'获取员工绩效失败\\\\'\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  async getInventory(params?: InventoryQueryParams): Promise<{ success: boolean; data: { items: Inventory[]; pagination: any }; message?: string }> {\\\\n    try {\\\\n      const queryString = new URLSearchParams()\\\\n      if (params?.page) queryString.set(\\\\'page\\\\', params.page.toString())\\\\n      if (params?.limit) queryString.set(\\\\'limit\\\\', params.limit.toString())\\\\n      if (params?.search) queryString.set(\\\\'search\\\\', params.search)\\\\n      if (params?.storeId) queryString.set(\\\\'storeId\\\\', params.storeId.toString())\\\\n      if (params?.category) queryString.set(\\\\'category\\\\', params.category)\\\\n      if (params?.status) queryString.set(\\\\'status\\\\', params.status)\\\\n\\\\n      const endpoint = queryString.toString() ? `${this.baseUrl}/inventory?${queryString}` : `${this.baseUrl}/inventory`\\\\n      const response = await httpClient.get<{ success: boolean; data: { items: Inventory[]; pagination: any }; message?: string }>(endpoint)\\\\n      return response\\\\n    } catch (error) {\\\\n      console.error(\\\\'Get inventory failed:\\\\', error)\\\\n      return {\\\\n        success: false,\\\\n        data: {\\\\n          items: [],\\\\n          pagination: {\\\\n            page: 1,\\\\n            limit: 20,\\\\n            total: 0,\\\\n            totalPages: 0\\\\n          }\\\\n        },\\\\n        message: \\\\'获取库存列表失败\\\\'\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  async getInventoryItem(id: number): Promise<{ success: boolean; data?: Inventory; message?: string }> {\\\\n    try {\\\\n      const response = await httpClient.get<{ success: boolean; data?: Inventory; message?: string }>(`${this.baseUrl}/inventory/${id}`)\\\\n      return response\\\\n    } catch (error) {\\\\n      console.error(\\\\'Get inventory item failed:\\\\', error)\\\\n      return {\\\\n        success: false,\\\\n        message: \\\\'获取库存详情失败\\\\'\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  async restockInventory(restockData: RestockInventoryRequest): Promise<{ success: boolean; message?: string }> {\\\\n    try {\\\\n      const response = await httpClient.post<{ success: boolean; message?: string }>(`${this.baseUrl}/inventory/restock`, restockData)\\\\n      return response\\\\n    } catch (error) {\\\\n      console.error(\\\\'Restock inventory failed:\\\\', error)\\\\n      return {\\\\n        success: false,\\\\n        message: \\\\'库存补货失败\\\\'\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  async transferInventory(transferData: TransferInventoryRequest): Promise<{ success: boolean; message?: string }> {\\\\n    try {\\\\n      const response = await httpClient.post<{ success: boolean; message?: string }>(`${this.baseUrl}/inventory/transfer`, transferData)\\\\n      return response\\\\n    } catch (error) {\\\\n      console.error(\\\\'Transfer inventory failed:\\\\', error)\\\\n      return {\\\\n        success: false,\\\\n        message: \\\\'库存调拨失败\\\\'\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  async checkInventory(checkData: CheckInventoryRequest): Promise<{ success: boolean; message?: string }> {\\\\n    try {\\\\n      const response = await httpClient.post<{ success: boolean; message?: string }>(`${this.baseUrl}/inventory/check`, checkData)\\\\n      return response\\\\n    } catch (error) {\\\\n      console.error(\\\\'Check inventory failed:\\\\', error)\\\\n      return {\\\\n        success: false,\\\\n        message: \\\\'库存盘点失败\\\\'\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  async getInventoryWarnings(storeId?: number): Promise<{ success: boolean; data: Inventory[]; message?: string }> {\\\\n    try {\\\\n      const queryString = new URLSearchParams()\\\\n      if (storeId) queryString.set(\\\\'storeId\\\\', storeId.toString())\\\\n\\\\n      const endpoint = queryString.toString() ? `${this.baseUrl}/inventory/warnings?${queryString}` : `${this.baseUrl}/inventory/warnings`\\\\n      const response = await httpClient.get<{ success: boolean; data: Inventory[]; message?: string }>(endpoint)\\\\n      return response\\\\n    } catch (error) {\\\\n      console.error(\\\\'Get inventory warnings failed:\\\\', error)\\\\n      return {\\\\n        success: false,\\\\n        data: [],\\\\n        message: \\\\'获取库存预警失败\\\\'\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  async getStoreStatsOverview(startDate?: string, endDate?: string): Promise<{ success: boolean; data: StoreStats[]; message?: string }> {\\\\n    try {\\\\n      const queryString = new URLSearchParams()\\\\n      if (startDate) queryString.set(\\\\'startDate\\\\', startDate)\\\\n      if (endDate) queryString.set(\\\\'endDate\\\\', endDate)\\\\n\\\\n      const endpoint = queryString.toString() ? `${this.baseUrl}/stats/stores?${queryString}` : `${this.baseUrl}/stats/stores`\\\\n      const response = await httpClient.get<{ success: boolean; data: StoreStats[]; message?: string }>(endpoint)\\\\n      return response\\\\n    } catch (error) {\\\\n      console.error(\\\\'Get store stats overview failed:\\\\', error)\\\\n      return {\\\\n        success: false,\\\\n        data: [],\\\\n        message: \\\\'获取门店统计失败\\\\'\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  async getEmployeePerformanceOverview(storeId?: number, startDate?: string, endDate?: string): Promise<{ success: boolean; data: EmployeePerformance[]; message?: string }> {\\\\n    try {\\\\n      const queryString = new URLSearchParams()\\\\n      if (storeId) queryString.set(\\\\'storeId\\\\', storeId.toString())\\\\n      if (startDate) queryString.set(\\\\'startDate\\\\', startDate)\\\\n      if (endDate) queryString.set(\\\\'endDate\\\\', endDate)\\\\n\\\\n      const endpoint = queryString.toString() ? `${this.baseUrl}/stats/employees?${queryString}` : `${this.baseUrl}/stats/employees`\\\\n      const response = await httpClient.get<{ success: boolean; data: EmployeePerformance[]; message?: string }>(endpoint)\\\\n      return response\\\\n    } catch (error) {\\\\n      console.error(\\\\'Get employee performance overview failed:\\\\', error)\\\\n      return {\\\\n        success: false,\\\\n        data: [],\\\\n        message: \\\\'获取员工绩效失败\\\\'\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  async getRevenueComparison(storeIds: number[], startDate?: string, endDate?: string, dimension?: \\\\'day\\\\' | \\\\'week\\\\' | \\\\'month\\\\' | \\\\'year\\\\'): Promise<{ success: boolean; data: RevenueComparison[]; message?: string }> {\\\\n    try {\\\\n      const queryString = new URLSearchParams()\\\\n      storeIds.forEach(id => queryString.append(\\\\'storeIds\\\\', id.toString()))\\\\n      if (startDate) queryString.set(\\\\'startDate\\\\', startDate)\\\\n      if (endDate) queryString.set(\\\\'endDate\\\\', endDate)\\\\n      if (dimension) queryString.set(\\\\'dimension\\\\', dimension)\\\\n\\\\n      const endpoint = queryString.toString() ? `${this.baseUrl}/stats/revenue?${queryString}` : `${this.baseUrl}/stats/revenue`\\\\n      const response = await httpClient.get<{ success: boolean; data: RevenueComparison[]; message?: string }>(endpoint)\\\\n      return response\\\\n    } catch (error) {\\\\n      console.error(\\\\'Get revenue comparison failed:\\\\', error)\\\\n      return {\\\\n        success: false,\\\\n        data: [],\\\\n        message: \\\\'获取营收对比失败\\\\'\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  async getTrendAnalysis(storeId: number, dimension: \\\\'orders\\\\' | \\\\'revenue\\\\' | \\\\'customers\\\\' | \\\\'employees\\\\', startDate?: string, endDate?: string): Promise<{ success: boolean; data: TrendData[]; message?: string }> {\\\\n    try {\\\\n      const queryString = new URLSearchParams()\\\\n      queryString.set(\\\\'dimension\\\\', dimension)\\\\n      if (startDate) queryString.set(\\\\'startDate\\\\', startDate)\\\\n      if (endDate) queryString.set(\\\\'endDate\\\\', endDate)\\\\n\\\\n      const endpoint = queryString.toString() ? `${this.baseUrl}/stats/trends?${queryString}` : `${this.baseUrl}/stats/trends`\\\\n      const response = await httpClient.get<{ success: boolean; data: TrendData[]; message?: string }>(endpoint)\\\\n      return response\\\\n    } catch (error) {\\\\n      console.error(\\\\'Get trend analysis failed:\\\\', error)\\\\n      return {\\\\n        success: false,\\\\n        data: [],\\\\n        message: \\\\'获取趋势分析失败\\\\'\\\\n      }\\\\n    }\\\\n  }\\\\n}\\\\n\\\\nexport const chainAPI = new ChainAPI()\\\\n\",\"originAcceptText\":\"/**\\n * @fileoverview 连锁管理API服务\\n * @description 提供连锁管理相关的API接口\\n * @module chain\\n * @author YYC³\\n * @version 1.0.0\\n * @created 2025-01-20\\n */\\n\\nimport { httpClient } from '@/utils/http'\\n\\nexport enum StoreType {\\n  DIRECT = 'direct',\\n  FRANCHISE = 'franchise'\\n}\\n\\nexport enum StoreStatus {\\n  OPEN = 'open',\\n  CLOSED = 'closed',\\n  MAINTENANCE = 'maintenance'\\n}\\n\\nexport enum EmployeeStatus {\\n  ACTIVE = 'active',\\n  RESIGNED = 'resigned',\\n  LEAVE = 'leave'\\n}\\n\\nexport enum InventoryStatus {\\n  NORMAL = 'normal',\\n  WARNING = 'warning',\\n  OUT_OF_STOCK = 'out_of_stock'\\n}\\n\\nexport interface BusinessHours {\\n  open: string\\n  close: string\\n  enabled: boolean\\n}\\n\\nexport interface WeeklyBusinessHours {\\n  monday: BusinessHours\\n  tuesday: BusinessHours\\n  wednesday: BusinessHours\\n  thursday: BusinessHours\\n  friday: BusinessHours\\n  saturday: BusinessHours\\n  sunday: BusinessHours\\n}\\n\\nexport interface Manager {\\n  id: number\\n  name: string\\n  phone: string\\n  avatar?: string\\n}\\n\\nexport interface Store {\\n  id: number\\n  storeCode: string\\n  name: string\\n  type: StoreType\\n  status: StoreStatus\\n  address: string\\n  city: string\\n  district: string\\n  phone: string\\n  email?: string\\n  manager: Manager\\n  businessHours: WeeklyBusinessHours\\n  area: number\\n  capacity: number\\n  tables: number\\n  employees: number\\n  coordinates?: {\\n    latitude: number\\n    longitude: number\\n  }\\n  facilities?: string[]\\n  description?: string\\n  images?: string[]\\n  openingDate: string\\n  rating?: number\\n  reviewCount?: number\\n  createdAt: string\\n  updatedAt?: string\\n}\\n\\nexport interface EmergencyContact {\\n  name: string\\n  phone: string\\n  relationship: string\\n}\\n\\nexport interface Employee {\\n  id: number\\n  employeeCode: string\\n  name: string\\n  gender: 'male' | 'female' | 'other'\\n  phone: string\\n  email?: string\\n  avatar?: string\\n  storeId: number\\n  storeName: string\\n  department: string\\n  position: string\\n  status: EmployeeStatus\\n  hireDate: string\\n  resignDate?: string\\n  salary: number\\n  address?: string\\n  idCard?: string\\n  bankAccount?: string\\n  emergencyContact?: EmergencyContact\\n  permissions: string[]\\n  createdAt: string\\n  updatedAt?: string\\n}\\n\\nexport interface Supplier {\\n  id: number\\n  name: string\\n  phone: string\\n}\\n\\nexport interface Inventory {\\n  id: number\\n  storeId: number\\n  storeName: string\\n  productId: number\\n  productName: string\\n  productCode: string\\n  category: string\\n  quantity: number\\n  unit: string\\n  minQuantity: number\\n  maxQuantity: number\\n  costPrice: number\\n  status: InventoryStatus\\n  lastRestockDate?: string\\n  supplier?: Supplier\\n  location?: string\\n  batchNumber?: string\\n  expiryDate?: string\\n  createdAt: string\\n  updatedAt?: string\\n}\\n\\nexport interface StoreStats {\\n  storeId: number\\n  storeName: string\\n  totalOrders: number\\n  totalRevenue: number\\n  averageOrderValue: number\\n  totalCustomers: number\\n  customerRetentionRate: number\\n  employeeCount: number\\n  averageRating: number\\n  dailyStats: DailyStats[]\\n  monthlyStats: MonthlyStats[]\\n}\\n\\nexport interface DailyStats {\\n  date: string\\n  orders: number\\n  revenue: number\\n  customers: number\\n}\\n\\nexport interface MonthlyStats {\\n  month: string\\n  orders: number\\n  revenue: number\\n  customers: number\\n}\\n\\nexport interface EmployeePerformance {\\n  employeeId: number\\n  employeeName: string\\n  storeName: string\\n  department: string\\n  position: string\\n  totalOrders: number\\n  totalRevenue: number\\n  averageOrderValue: number\\n  customerSatisfaction: number\\n  attendanceRate: number\\n  performanceScore: number\\n  ranking: number\\n}\\n\\nexport interface RevenueComparison {\\n  storeId: number\\n  storeName: string\\n  revenue: number\\n  orders: number\\n  growth: number\\n}\\n\\nexport interface TrendData {\\n  date: string\\n  value: number\\n  predicted?: number\\n}\\n\\nexport interface StoreQueryParams {\\n  page?: number\\n  limit?: number\\n  search?: string\\n  status?: StoreStatus\\n  type?: StoreType\\n  city?: string\\n  district?: string\\n}\\n\\nexport interface EmployeeQueryParams {\\n  page?: number\\n  limit?: number\\n  search?: string\\n  storeId?: number\\n  department?: string\\n  position?: string\\n  status?: EmployeeStatus\\n}\\n\\nexport interface InventoryQueryParams {\\n  page?: number\\n  limit?: number\\n  search?: string\\n  storeId?: number\\n  category?: string\\n  status?: InventoryStatus\\n}\\n\\nexport interface CreateStoreRequest {\\n  storeCode: string\\n  name: string\\n  type: StoreType\\n  status: StoreStatus\\n  address: string\\n  city: string\\n  district: string\\n  phone: string\\n  email?: string\\n  managerId: number\\n  businessHours: WeeklyBusinessHours\\n  area: number\\n  capacity: number\\n  tables: number\\n  coordinates?: {\\n    latitude: number\\n    longitude: number\\n  }\\n  facilities?: string[]\\n  description?: string\\n  images?: string[]\\n  openingDate: string\\n}\\n\\nexport interface UpdateStoreRequest {\\n  name?: string\\n  type?: StoreType\\n  status?: StoreStatus\\n  address?: string\\n  city?: string\\n  district?: string\\n  phone?: string\\n  email?: string\\n  managerId?: number\\n  businessHours?: WeeklyBusinessHours\\n  area?: number\\n  capacity?: number\\n  tables?: number\\n  coordinates?: {\\n    latitude: number\\n    longitude: number\\n  }\\n  facilities?: string[]\\n  description?: string\\n  images?: string[]\\n}\\n\\nexport interface CreateEmployeeRequest {\\n  employeeCode: string\\n  name: string\\n  gender: 'male' | 'female' | 'other'\\n  phone: string\\n  email?: string\\n  avatar?: string\\n  storeId: number\\n  department: string\\n  position: string\\n  status: EmployeeStatus\\n  hireDate: string\\n  salary: number\\n  address?: string\\n  idCard?: string\\n  bankAccount?: string\\n  emergencyContact?: EmergencyContact\\n  permissions: string[]\\n}\\n\\nexport interface UpdateEmployeeRequest {\\n  name?: string\\n  gender?: 'male' | 'female' | 'other'\\n  phone?: string\\n  email?: string\\n  avatar?: string\\n  storeId?: number\\n  department?: string\\n  position?: string\\n  status?: EmployeeStatus\\n  salary?: number\\n  address?: string\\n  idCard?: string\\n  bankAccount?: string\\n  emergencyContact?: EmergencyContact\\n  permissions?: string[]\\n}\\n\\nexport interface TransferEmployeeRequest {\\n  targetStoreId: number\\n  reason: string\\n  effectiveDate: string\\n}\\n\\nexport interface RestockInventoryRequest {\\n  storeId: number\\n  productId: number\\n  quantity: number\\n  costPrice: number\\n  supplier?: Supplier\\n  batchNumber?: string\\n  expiryDate?: string\\n  remarks?: string\\n}\\n\\nexport interface TransferInventoryRequest {\\n  sourceStoreId: number\\n  targetStoreId: number\\n  productId: number\\n  quantity: number\\n  reason: string\\n  effectiveDate: string\\n}\\n\\nexport interface CheckInventoryRequest {\\n  storeId: number\\n  checkDate: string\\n  details: {\\n    productId: number\\n    actualQuantity: number\\n    difference: number\\n    reason?: string\\n  }[]\\n}\\n\\nexport class ChainAPI {\\n  private baseUrl = '/api/chain'\\n\\n  async getStores(params?: StoreQueryParams): Promise<{ success: boolean; data: { items: Store[]; pagination: any }; message?: string }> {\\n    try {\\n      const queryString = new URLSearchParams()\\n      if (params?.page) queryString.set('page', params.page.toString())\\n      if (params?.limit) queryString.set('limit', params.limit.toString())\\n      if (params?.search) queryString.set('search', params.search)\\n      if (params?.status) queryString.set('status', params.status)\\n      if (params?.type) queryString.set('type', params.type)\\n      if (params?.city) queryString.set('city', params.city)\\n      if (params?.district) queryString.set('district', params.district)\\n\\n      const endpoint = queryString.toString() ? `${this.baseUrl}/stores?${queryString}` : `${this.baseUrl}/stores`\\n      const response = await httpClient.get<{ success: boolean; data: { items: Store[]; pagination: any }; message?: string }>(endpoint)\\n      return response\\n    } catch (error) {\\n      console.error('Get stores failed:', error)\\n      return {\\n        success: false,\\n        data: {\\n          items: [],\\n          pagination: {\\n            page: 1,\\n            limit: 20,\\n            total: 0,\\n            totalPages: 0\\n          }\\n        },\\n        message: '获取门店列表失败'\\n      }\\n    }\\n  }\\n\\n  async getStore(id: number): Promise<{ success: boolean; data?: Store; message?: string }> {\\n    try {\\n      const response = await httpClient.get<{ success: boolean; data?: Store; message?: string }>(`${this.baseUrl}/stores/${id}`)\\n      return response\\n    } catch (error) {\\n      console.error('Get store failed:', error)\\n      return {\\n        success: false,\\n        message: '获取门店详情失败'\\n      }\\n    }\\n  }\\n\\n  async createStore(storeData: CreateStoreRequest): Promise<{ success: boolean; data?: Store; message?: string }> {\\n    try {\\n      const response = await httpClient.post<{ success: boolean; data?: Store; message?: string }>(`${this.baseUrl}/stores`, storeData)\\n      return response\\n    } catch (error) {\\n      console.error('Create store failed:', error)\\n      return {\\n        success: false,\\n        message: '创建门店失败'\\n      }\\n    }\\n  }\\n\\n  async updateStore(id: number, storeData: UpdateStoreRequest): Promise<{ success: boolean; data?: Store; message?: string }> {\\n    try {\\n      const response = await httpClient.put<{ success: boolean; data?: Store; message?: string }>(`${this.baseUrl}/stores/${id}`, storeData)\\n      return response\\n    } catch (error) {\\n      console.error('Update store failed:', error)\\n      return {\\n        success: false,\\n        message: '更新门店失败'\\n      }\\n    }\\n  }\\n\\n  async deleteStore(id: number): Promise<{ success: boolean; message?: string }> {\\n    try {\\n      const response = await httpClient.delete<{ success: boolean; message?: string }>(`${this.baseUrl}/stores/${id}`)\\n      return response\\n    } catch (error) {\\n      console.error('Delete store failed:', error)\\n      return {\\n        success: false,\\n        message: '删除门店失败'\\n      }\\n    }\\n  }\\n\\n  async updateStoreStatus(id: number, status: StoreStatus): Promise<{ success: boolean; message?: string }> {\\n    try {\\n      const response = await httpClient.patch<{ success: boolean; message?: string }>(`${this.baseUrl}/stores/${id}/status`, { status })\\n      return response\\n    } catch (error) {\\n      console.error('Update store status failed:', error)\\n      return {\\n        success: false,\\n        message: '更新门店状态失败'\\n      }\\n    }\\n  }\\n\\n  async getStoreStats(id: number, startDate?: string, endDate?: string): Promise<{ success: boolean; data?: StoreStats; message?: string }> {\\n    try {\\n      const queryString = new URLSearchParams()\\n      if (startDate) queryString.set('startDate', startDate)\\n      if (endDate) queryString.set('endDate', endDate)\\n\\n      const endpoint = queryString.toString() ? `${this.baseUrl}/stores/${id}/stats?${queryString}` : `${this.baseUrl}/stores/${id}/stats`\\n      const response = await httpClient.get<{ success: boolean; data?: StoreStats; message?: string }>(endpoint)\\n      return response\\n    } catch (error) {\\n      console.error('Get store stats failed:', error)\\n      return {\\n        success: false,\\n        message: '获取门店统计失败'\\n      }\\n    }\\n  }\\n\\n  async getEmployees(params?: EmployeeQueryParams): Promise<{ success: boolean; data: { items: Employee[]; pagination: any }; message?: string }> {\\n    try {\\n      const queryString = new URLSearchParams()\\n      if (params?.page) queryString.set('page', params.page.toString())\\n      if (params?.limit) queryString.set('limit', params.limit.toString())\\n      if (params?.search) queryString.set('search', params.search)\\n      if (params?.storeId) queryString.set('storeId', params.storeId.toString())\\n      if (params?.department) queryString.set('department', params.department)\\n      if (params?.position) queryString.set('position', params.position)\\n      if (params?.status) queryString.set('status', params.status)\\n\\n      const endpoint = queryString.toString() ? `${this.baseUrl}/employees?${queryString}` : `${this.baseUrl}/employees`\\n      const response = await httpClient.get<{ success: boolean; data: { items: Employee[]; pagination: any }; message?: string }>(endpoint)\\n      return response\\n    } catch (error) {\\n      console.error('Get employees failed:', error)\\n      return {\\n        success: false,\\n        data: {\\n          items: [],\\n          pagination: {\\n            page: 1,\\n            limit: 20,\\n            total: 0,\\n            totalPages: 0\\n          }\\n        },\\n        message: '获取员工列表失败'\\n      }\\n    }\\n  }\\n\\n  async getEmployee(id: number): Promise<{ success: boolean; data?: Employee; message?: string }> {\\n    try {\\n      const response = await httpClient.get<{ success: boolean; data?: Employee; message?: string }>(`${this.baseUrl}/employees/${id}`)\\n      return response\\n    } catch (error) {\\n      console.error('Get employee failed:', error)\\n      return {\\n        success: false,\\n        message: '获取员工详情失败'\\n      }\\n    }\\n  }\\n\\n  async createEmployee(employeeData: CreateEmployeeRequest): Promise<{ success: boolean; data?: Employee; message?: string }> {\\n    try {\\n      const response = await httpClient.post<{ success: boolean; data?: Employee; message?: string }>(`${this.baseUrl}/employees`, employeeData)\\n      return response\\n    } catch (error) {\\n      console.error('Create employee failed:', error)\\n      return {\\n        success: false,\\n        message: '创建员工失败'\\n      }\\n    }\\n  }\\n\\n  async updateEmployee(id: number, employeeData: UpdateEmployeeRequest): Promise<{ success: boolean; data?: Employee; message?: string }> {\\n    try {\\n      const response = await httpClient.put<{ success: boolean; data?: Employee; message?: string }>(`${this.baseUrl}/employees/${id}`, employeeData)\\n      return response\\n    } catch (error) {\\n      console.error('Update employee failed:', error)\\n      return {\\n        success: false,\\n        message: '更新员工失败'\\n      }\\n    }\\n  }\\n\\n  async deleteEmployee(id: number): Promise<{ success: boolean; message?: string }> {\\n    try {\\n      const response = await httpClient.delete<{ success: boolean; message?: string }>(`${this.baseUrl}/employees/${id}`)\\n      return response\\n    } catch (error) {\\n      console.error('Delete employee failed:', error)\\n      return {\\n        success: false,\\n        message: '删除员工失败'\\n      }\\n    }\\n  }\\n\\n  async transferEmployee(id: number, transferData: TransferEmployeeRequest): Promise<{ success: boolean; message?: string }> {\\n    try {\\n      const response = await httpClient.post<{ success: boolean; message?: string }>(`${this.baseUrl}/employees/${id}/transfer`, transferData)\\n      return response\\n    } catch (error) {\\n      console.error('Transfer employee failed:', error)\\n      return {\\n        success: false,\\n        message: '员工调店失败'\\n      }\\n    }\\n  }\\n\\n  async updateEmployeePermissions(id: number, permissions: string[]): Promise<{ success: boolean; message?: string }> {\\n    try {\\n      const response = await httpClient.put<{ success: boolean; message?: string }>(`${this.baseUrl}/employees/${id}/permissions`, { permissions })\\n      return response\\n    } catch (error) {\\n      console.error('Update employee permissions failed:', error)\\n      return {\\n        success: false,\\n        message: '更新员工权限失败'\\n      }\\n    }\\n  }\\n\\n  async getEmployeePerformance(id: number, startDate?: string, endDate?: string): Promise<{ success: boolean; data?: EmployeePerformance; message?: string }> {\\n    try {\\n      const queryString = new URLSearchParams()\\n      if (startDate) queryString.set('startDate', startDate)\\n      if (endDate) queryString.set('endDate', endDate)\\n\\n      const endpoint = queryString.toString() ? `${this.baseUrl}/employees/${id}/performance?${queryString}` : `${this.baseUrl}/employees/${id}/performance`\\n      const response = await httpClient.get<{ success: boolean; data?: EmployeePerformance; message?: string }>(endpoint)\\n      return response\\n    } catch (error) {\\n      console.error('Get employee performance failed:', error)\\n      return {\\n        success: false,\\n        message: '获取员工绩效失败'\\n      }\\n    }\\n  }\\n\\n  async getInventory(params?: InventoryQueryParams): Promise<{ success: boolean; data: { items: Inventory[]; pagination: any }; message?: string }> {\\n    try {\\n      const queryString = new URLSearchParams()\\n      if (params?.page) queryString.set('page', params.page.toString())\\n      if (params?.limit) queryString.set('limit', params.limit.toString())\\n      if (params?.search) queryString.set('search', params.search)\\n      if (params?.storeId) queryString.set('storeId', params.storeId.toString())\\n      if (params?.category) queryString.set('category', params.category)\\n      if (params?.status) queryString.set('status', params.status)\\n\\n      const endpoint = queryString.toString() ? `${this.baseUrl}/inventory?${queryString}` : `${this.baseUrl}/inventory`\\n      const response = await httpClient.get<{ success: boolean; data: { items: Inventory[]; pagination: any }; message?: string }>(endpoint)\\n      return response\\n    } catch (error) {\\n      console.error('Get inventory failed:', error)\\n      return {\\n        success: false,\\n        data: {\\n          items: [],\\n          pagination: {\\n            page: 1,\\n            limit: 20,\\n            total: 0,\\n            totalPages: 0\\n          }\\n        },\\n        message: '获取库存列表失败'\\n      }\\n    }\\n  }\\n\\n  async getInventoryItem(id: number): Promise<{ success: boolean; data?: Inventory; message?: string }> {\\n    try {\\n      const response = await httpClient.get<{ success: boolean; data?: Inventory; message?: string }>(`${this.baseUrl}/inventory/${id}`)\\n      return response\\n    } catch (error) {\\n      console.error('Get inventory item failed:', error)\\n      return {\\n        success: false,\\n        message: '获取库存详情失败'\\n      }\\n    }\\n  }\\n\\n  async restockInventory(restockData: RestockInventoryRequest): Promise<{ success: boolean; message?: string }> {\\n    try {\\n      const response = await httpClient.post<{ success: boolean; message?: string }>(`${this.baseUrl}/inventory/restock`, restockData)\\n      return response\\n    } catch (error) {\\n      console.error('Restock inventory failed:', error)\\n      return {\\n        success: false,\\n        message: '库存补货失败'\\n      }\\n    }\\n  }\\n\\n  async transferInventory(transferData: TransferInventoryRequest): Promise<{ success: boolean; message?: string }> {\\n    try {\\n      const response = await httpClient.post<{ success: boolean; message?: string }>(`${this.baseUrl}/inventory/transfer`, transferData)\\n      return response\\n    } catch (error) {\\n      console.error('Transfer inventory failed:', error)\\n      return {\\n        success: false,\\n        message: '库存调拨失败'\\n      }\\n    }\\n  }\\n\\n  async checkInventory(checkData: CheckInventoryRequest): Promise<{ success: boolean; message?: string }> {\\n    try {\\n      const response = await httpClient.post<{ success: boolean; message?: string }>(`${this.baseUrl}/inventory/check`, checkData)\\n      return response\\n    } catch (error) {\\n      console.error('Check inventory failed:', error)\\n      return {\\n        success: false,\\n        message: '库存盘点失败'\\n      }\\n    }\\n  }\\n\\n  async getInventoryWarnings(storeId?: number): Promise<{ success: boolean; data: Inventory[]; message?: string }> {\\n    try {\\n      const queryString = new URLSearchParams()\\n      if (storeId) queryString.set('storeId', storeId.toString())\\n\\n      const endpoint = queryString.toString() ? `${this.baseUrl}/inventory/warnings?${queryString}` : `${this.baseUrl}/inventory/warnings`\\n      const response = await httpClient.get<{ success: boolean; data: Inventory[]; message?: string }>(endpoint)\\n      return response\\n    } catch (error) {\\n      console.error('Get inventory warnings failed:', error)\\n      return {\\n        success: false,\\n        data: [],\\n        message: '获取库存预警失败'\\n      }\\n    }\\n  }\\n\\n  async getStoreStatsOverview(startDate?: string, endDate?: string): Promise<{ success: boolean; data: StoreStats[]; message?: string }> {\\n    try {\\n      const queryString = new URLSearchParams()\\n      if (startDate) queryString.set('startDate', startDate)\\n      if (endDate) queryString.set('endDate', endDate)\\n\\n      const endpoint = queryString.toString() ? `${this.baseUrl}/stats/stores?${queryString}` : `${this.baseUrl}/stats/stores`\\n      const response = await httpClient.get<{ success: boolean; data: StoreStats[]; message?: string }>(endpoint)\\n      return response\\n    } catch (error) {\\n      console.error('Get store stats overview failed:', error)\\n      return {\\n        success: false,\\n        data: [],\\n        message: '获取门店统计失败'\\n      }\\n    }\\n  }\\n\\n  async getEmployeePerformanceOverview(storeId?: number, startDate?: string, endDate?: string): Promise<{ success: boolean; data: EmployeePerformance[]; message?: string }> {\\n    try {\\n      const queryString = new URLSearchParams()\\n      if (storeId) queryString.set('storeId', storeId.toString())\\n      if (startDate) queryString.set('startDate', startDate)\\n      if (endDate) queryString.set('endDate', endDate)\\n\\n      const endpoint = queryString.toString() ? `${this.baseUrl}/stats/employees?${queryString}` : `${this.baseUrl}/stats/employees`\\n      const response = await httpClient.get<{ success: boolean; data: EmployeePerformance[]; message?: string }>(endpoint)\\n      return response\\n    } catch (error) {\\n      console.error('Get employee performance overview failed:', error)\\n      return {\\n        success: false,\\n        data: [],\\n        message: '获取员工绩效失败'\\n      }\\n    }\\n  }\\n\\n  async getRevenueComparison(storeIds: number[], startDate?: string, endDate?: string, dimension?: 'day' | 'week' | 'month' | 'year'): Promise<{ success: boolean; data: RevenueComparison[]; message?: string }> {\\n    try {\\n      const queryString = new URLSearchParams()\\n      storeIds.forEach(id => queryString.append('storeIds', id.toString()))\\n      if (startDate) queryString.set('startDate', startDate)\\n      if (endDate) queryString.set('endDate', endDate)\\n      if (dimension) queryString.set('dimension', dimension)\\n\\n      const endpoint = queryString.toString() ? `${this.baseUrl}/stats/revenue?${queryString}` : `${this.baseUrl}/stats/revenue`\\n      const response = await httpClient.get<{ success: boolean; data: RevenueComparison[]; message?: string }>(endpoint)\\n      return response\\n    } catch (error) {\\n      console.error('Get revenue comparison failed:', error)\\n      return {\\n        success: false,\\n        data: [],\\n        message: '获取营收对比失败'\\n      }\\n    }\\n  }\\n\\n  async getTrendAnalysis(storeId: number, dimension: 'orders' | 'revenue' | 'customers' | 'employees', startDate?: string, endDate?: string): Promise<{ success: boolean; data: TrendData[]; message?: string }> {\\n    try {\\n      const queryString = new URLSearchParams()\\n      queryString.set('dimension', dimension)\\n      if (startDate) queryString.set('startDate', startDate)\\n      if (endDate) queryString.set('endDate', endDate)\\n\\n      const endpoint = queryString.toString() ? `${this.baseUrl}/stats/trends?${queryString}` : `${this.baseUrl}/stats/trends`\\n      const response = await httpClient.get<{ success: boolean; data: TrendData[]; message?: string }>(endpoint)\\n      return response\\n    } catch (error) {\\n      console.error('Get trend analysis failed:', error)\\n      return {\\n        success: false,\\n        data: [],\\n        message: '获取趋势分析失败'\\n      }\\n    }\\n  }\\n}\\n\\nexport const chainAPI = new ChainAPI()\\n\",\"originTextLength\":22948,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768883556045}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/composables/useChain.ts": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":939,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":939,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"/**\\\\n * @fileoverview 连锁管理Composable\\\\n * @description 管理连锁管理功能的状态和逻辑\\\\n * @module useChain\\\\n * @author YYC³\\\\n * @version 1.0.0\\\\n * @created 2025-01-20\\\\n */\\\\n\\\\nimport { ref, reactive, computed } from \\\\'vue\\\\'\\\\nimport { ElMessage, ElMessageBox } from \\\\'element-plus\\\\'\\\\nimport dayjs from \\\\'dayjs\\\\'\\\\nimport { \\\\n  chainAPI, \\\\n  StoreType, \\\\n  StoreStatus, \\\\n  EmployeeStatus, \\\\n  InventoryStatus,\\\\n  type Store, \\\\n  type Employee, \\\\n  type Inventory, \\\\n  type StoreStats,\\\\n  type EmployeePerformance,\\\\n  type RevenueComparison,\\\\n  type TrendData,\\\\n  type CreateStoreRequest,\\\\n  type UpdateStoreRequest,\\\\n  type CreateEmployeeRequest,\\\\n  type UpdateEmployeeRequest,\\\\n  type TransferEmployeeRequest,\\\\n  type RestockInventoryRequest,\\\\n  type TransferInventoryRequest,\\\\n  type CheckInventoryRequest,\\\\n  type StoreQueryParams,\\\\n  type EmployeeQueryParams,\\\\n  type InventoryQueryParams\\\\n} from \\\\'@/api/chain\\\\'\\\\n\\\\nexport function useChain() {\\\\n  const loading = ref(false)\\\\n  const activeTab = ref<\\\\'stores\\\\' | \\\\'employees\\\\' | \\\\'inventory\\\\' | \\\\'stats\\\\'>(\\\\'stores\\\\')\\\\n\\\\n  const stores = ref<Store[]>([])\\\\n  const employees = ref<Employee[]>([])\\\\n  const inventory = ref<Inventory[]>([])\\\\n  const storeStats = ref<StoreStats[]>([])\\\\n  const employeePerformance = ref<EmployeePerformance[]>([])\\\\n  const revenueComparison = ref<RevenueComparison[]>([])\\\\n  const trendData = ref<TrendData[]>([])\\\\n\\\\n  const selectedStore = ref<Store | null>(null)\\\\n  const selectedEmployee = ref<Employee | null>(null)\\\\n  const selectedInventory = ref<Inventory | null>(null)\\\\n\\\\n  const showStoreDialog = ref(false)\\\\n  const showEmployeeDialog = ref(false)\\\\n  const showInventoryDialog = ref(false)\\\\n  const showTransferDialog = ref(false)\\\\n  const showRestockDialog = ref(false)\\\\n  const showTransferInventoryDialog = ref(false)\\\\n  const showCheckDialog = ref(false)\\\\n\\\\n  const storeDialogType = ref<\\\\'create\\\\' | \\\\'edit\\\\'>(\\\\'create\\\\')\\\\n  const employeeDialogType = ref<\\\\'create\\\\' | \\\\'edit\\\\'>(\\\\'create\\\\')\\\\n\\\\n  const storeForm = reactive({\\\\n    id: 0,\\\\n    storeCode: \\\\'\\\\',\\\\n    name: \\\\'\\\\',\\\\n    type: StoreType.DIRECT,\\\\n    status: StoreStatus.OPEN,\\\\n    address: \\\\'\\\\',\\\\n    city: \\\\'\\\\',\\\\n    district: \\\\'\\\\',\\\\n    phone: \\\\'\\\\',\\\\n    email: \\\\'\\\\',\\\\n    managerId: 0,\\\\n    businessHours: {\\\\n      monday: { open: \\\\'09:00\\\\', close: \\\\'22:00\\\\', enabled: true },\\\\n      tuesday: { open: \\\\'09:00\\\\', close: \\\\'22:00\\\\', enabled: true },\\\\n      wednesday: { open: \\\\'09:00\\\\', close: \\\\'22:00\\\\', enabled: true },\\\\n      thursday: { open: \\\\'09:00\\\\', close: \\\\'22:00\\\\', enabled: true },\\\\n      friday: { open: \\\\'09:00\\\\', close: \\\\'22:00\\\\', enabled: true },\\\\n      saturday: { open: \\\\'09:00\\\\', close: \\\\'22:00\\\\', enabled: true },\\\\n      sunday: { open: \\\\'09:00\\\\', close: \\\\'22:00\\\\', enabled: true }\\\\n    },\\\\n    area: 100,\\\\n    capacity: 100,\\\\n    tables: 20,\\\\n    coordinates: { latitude: 0, longitude: 0 },\\\\n    facilities: [] as string[],\\\\n    description: \\\\'\\\\',\\\\n    images: [] as string[],\\\\n    openingDate: \\\\'\\\\'\\\\n  })\\\\n\\\\n  const employeeForm = reactive({\\\\n    id: 0,\\\\n    employeeCode: \\\\'\\\\',\\\\n    name: \\\\'\\\\',\\\\n    gender: \\\\'male\\\\' as \\\\'male\\\\' | \\\\'female\\\\' | \\\\'other\\\\',\\\\n    phone: \\\\'\\\\',\\\\n    email: \\\\'\\\\',\\\\n    avatar: \\\\'\\\\',\\\\n    storeId: 0,\\\\n    department: \\\\'\\\\',\\\\n    position: \\\\'\\\\',\\\\n    status: EmployeeStatus.ACTIVE,\\\\n    hireDate: \\\\'\\\\',\\\\n    salary: 0,\\\\n    address: \\\\'\\\\',\\\\n    idCard: \\\\'\\\\',\\\\n    bankAccount: \\\\'\\\\',\\\\n    emergencyContact: { name: \\\\'\\\\', phone: \\\\'\\\\', relationship: \\\\'\\\\' },\\\\n    permissions: [] as string[]\\\\n  })\\\\n\\\\n  const transferForm = reactive({\\\\n    targetStoreId: 0,\\\\n    reason: \\\\'\\\\',\\\\n    effectiveDate: \\\\'\\\\'\\\\n  })\\\\n\\\\n  const restockForm = reactive({\\\\n    storeId: 0,\\\\n    productId: 0,\\\\n    quantity: 0,\\\\n    costPrice: 0,\\\\n    supplier: { id: 0, name: \\\\'\\\\', phone: \\\\'\\\\' },\\\\n    batchNumber: \\\\'\\\\',\\\\n    expiryDate: \\\\'\\\\',\\\\n    remarks: \\\\'\\\\'\\\\n  })\\\\n\\\\n  const transferInventoryForm = reactive({\\\\n    sourceStoreId: 0,\\\\n    targetStoreId: 0,\\\\n    productId: 0,\\\\n    quantity: 0,\\\\n    reason: \\\\'\\\\',\\\\n    effectiveDate: \\\\'\\\\'\\\\n  })\\\\n\\\\n  const checkForm = reactive({\\\\n    storeId: 0,\\\\n    checkDate: \\\\'\\\\',\\\\n    details: [] as { productId: number; actualQuantity: number; difference: number; reason?: string }[]\\\\n  })\\\\n\\\\n  const storePagination = reactive({\\\\n    page: 1,\\\\n    limit: 20,\\\\n    total: 0\\\\n  })\\\\n\\\\n  const employeePagination = reactive({\\\\n    page: 1,\\\\n    limit: 20,\\\\n    total: 0\\\\n  })\\\\n\\\\n  const inventoryPagination = reactive({\\\\n    page: 1,\\\\n    limit: 20,\\\\n    total: 0\\\\n  })\\\\n\\\\n  const storeFilter = reactive({\\\\n    search: \\\\'\\\\',\\\\n    status: \\\\'\\\\' as StoreStatus | \\\\'\\\\',\\\\n    type: \\\\'\\\\' as StoreType | \\\\'\\\\',\\\\n    city: \\\\'\\\\',\\\\n    district: \\\\'\\\\'\\\\n  })\\\\n\\\\n  const employeeFilter = reactive({\\\\n    search: \\\\'\\\\',\\\\n    storeId: 0,\\\\n    department: \\\\'\\\\',\\\\n    position: \\\\'\\\\',\\\\n    status: \\\\'\\\\' as EmployeeStatus | \\\\'\\\\'\\\\n  })\\\\n\\\\n  const inventoryFilter = reactive({\\\\n    search: \\\\'\\\\',\\\\n    storeId: 0,\\\\n    category: \\\\'\\\\',\\\\n    status: \\\\'\\\\' as InventoryStatus | \\\\'\\\\'\\\\n  })\\\\n\\\\n  const storesLoading = computed(() => loading.value && activeTab.value === \\\\'stores\\\\')\\\\n  const employeesLoading = computed(() => loading.value && activeTab.value === \\\\'employees\\\\')\\\\n  const inventoryLoading = computed(() => loading.value && activeTab.value === \\\\'inventory\\\\')\\\\n  const statsLoading = computed(() => loading.value && activeTab.value === \\\\'stats\\\\')\\\\n\\\\n  const loadStores = async () => {\\\\n    try {\\\\n      loading.value = true\\\\n      const params: StoreQueryParams = {\\\\n        page: storePagination.page,\\\\n        limit: storePagination.limit,\\\\n        search: storeFilter.search || undefined,\\\\n        status: storeFilter.status || undefined,\\\\n        type: storeFilter.type || undefined,\\\\n        city: storeFilter.city || undefined,\\\\n        district: storeFilter.district || undefined\\\\n      }\\\\n      \\\\n      const response = await chainAPI.getStores(params)\\\\n      if (response.success && response.data) {\\\\n        stores.value = response.data.items\\\\n        storePagination.total = response.data.pagination.total\\\\n      } else {\\\\n        ElMessage.error(response.message || \\\\'加载门店列表失败\\\\')\\\\n      }\\\\n    } catch (error) {\\\\n      ElMessage.error(\\\\'加载门店列表失败\\\\')\\\\n      console.error(\\\\'加载门店列表失败:\\\\', error)\\\\n    } finally {\\\\n      loading.value = false\\\\n    }\\\\n  }\\\\n\\\\n  const loadEmployees = async () => {\\\\n    try {\\\\n      loading.value = true\\\\n      const params: EmployeeQueryParams = {\\\\n        page: employeePagination.page,\\\\n        limit: employeePagination.limit,\\\\n        search: employeeFilter.search || undefined,\\\\n        storeId: employeeFilter.storeId || undefined,\\\\n        department: employeeFilter.department || undefined,\\\\n        position: employeeFilter.position || undefined,\\\\n        status: employeeFilter.status || undefined\\\\n      }\\\\n      \\\\n      const response = await chainAPI.getEmployees(params)\\\\n      if (response.success && response.data) {\\\\n        employees.value = response.data.items\\\\n        employeePagination.total = response.data.pagination.total\\\\n      } else {\\\\n        ElMessage.error(response.message || \\\\'加载员工列表失败\\\\')\\\\n      }\\\\n    } catch (error) {\\\\n      ElMessage.error(\\\\'加载员工列表失败\\\\')\\\\n      console.error(\\\\'加载员工列表失败:\\\\', error)\\\\n    } finally {\\\\n      loading.value = false\\\\n    }\\\\n  }\\\\n\\\\n  const loadInventory = async () => {\\\\n    try {\\\\n      loading.value = true\\\\n      const params: InventoryQueryParams = {\\\\n        page: inventoryPagination.page,\\\\n        limit: inventoryPagination.limit,\\\\n        search: inventoryFilter.search || undefined,\\\\n        storeId: inventoryFilter.storeId || undefined,\\\\n        category: inventoryFilter.category || undefined,\\\\n        status: inventoryFilter.status || undefined\\\\n      }\\\\n      \\\\n      const response = await chainAPI.getInventory(params)\\\\n      if (response.success && response.data) {\\\\n        inventory.value = response.data.items\\\\n        inventoryPagination.total = response.data.pagination.total\\\\n      } else {\\\\n        ElMessage.error(response.message || \\\\'加载库存列表失败\\\\')\\\\n      }\\\\n    } catch (error) {\\\\n      ElMessage.error(\\\\'加载库存列表失败\\\\')\\\\n      console.error(\\\\'加载库存列表失败:\\\\', error)\\\\n    } finally {\\\\n      loading.value = false\\\\n    }\\\\n  }\\\\n\\\\n  const loadStoreStats = async () => {\\\\n    try {\\\\n      const response = await chainAPI.getStoreStatsOverview()\\\\n      if (response.success && response.data) {\\\\n        storeStats.value = response.data\\\\n      } else {\\\\n        ElMessage.error(response.message || \\\\'加载门店统计失败\\\\')\\\\n      }\\\\n    } catch (error) {\\\\n      ElMessage.error(\\\\'加载门店统计失败\\\\')\\\\n      console.error(\\\\'加载门店统计失败:\\\\', error)\\\\n    }\\\\n  }\\\\n\\\\n  const loadEmployeePerformance = async () => {\\\\n    try {\\\\n      const response = await chainAPI.getEmployeePerformanceOverview()\\\\n      if (response.success && response.data) {\\\\n        employeePerformance.value = response.data\\\\n      } else {\\\\n        ElMessage.error(response.message || \\\\'加载员工绩效失败\\\\')\\\\n      }\\\\n    } catch (error) {\\\\n      ElMessage.error(\\\\'加载员工绩效失败\\\\')\\\\n      console.error(\\\\'加载员工绩效失败:\\\\', error)\\\\n    }\\\\n  }\\\\n\\\\n  const handleAddStore = () => {\\\\n    storeDialogType.value = \\\\'create\\\\'\\\\n    Object.assign(storeForm, {\\\\n      id: 0,\\\\n      storeCode: \\\\'\\\\',\\\\n      name: \\\\'\\\\',\\\\n      type: StoreType.DIRECT,\\\\n      status: StoreStatus.OPEN,\\\\n      address: \\\\'\\\\',\\\\n      city: \\\\'\\\\',\\\\n      district: \\\\'\\\\',\\\\n      phone: \\\\'\\\\',\\\\n      email: \\\\'\\\\',\\\\n      managerId: 0,\\\\n      businessHours: {\\\\n        monday: { open: \\\\'09:00\\\\', close: \\\\'22:00\\\\', enabled: true },\\\\n        tuesday: { open: \\\\'09:00\\\\', close: \\\\'22:00\\\\', enabled: true },\\\\n        wednesday: { open: \\\\'09:00\\\\', close: \\\\'22:00\\\\', enabled: true },\\\\n        thursday: { open: \\\\'09:00\\\\', close: \\\\'22:00\\\\', enabled: true },\\\\n        friday: { open: \\\\'09:00\\\\', close: \\\\'22:00\\\\', enabled: true },\\\\n        saturday: { open: \\\\'09:00\\\\', close: \\\\'22:00\\\\', enabled: true },\\\\n        sunday: { open: \\\\'09:00\\\\', close: \\\\'22:00\\\\', enabled: true }\\\\n      },\\\\n      area: 100,\\\\n      capacity: 100,\\\\n      tables: 20,\\\\n      coordinates: { latitude: 0, longitude: 0 },\\\\n      facilities: [] as string[],\\\\n      description: \\\\'\\\\',\\\\n      images: [] as string[],\\\\n      openingDate: \\\\'\\\\'\\\\n    })\\\\n    showStoreDialog.value = true\\\\n  }\\\\n\\\\n  const handleEditStore = (store: Store) => {\\\\n    storeDialogType.value = \\\\'edit\\\\'\\\\n    Object.assign(storeForm, {\\\\n      id: store.id,\\\\n      storeCode: store.storeCode,\\\\n      name: store.name,\\\\n      type: store.type,\\\\n      status: store.status,\\\\n      address: store.address,\\\\n      city: store.city,\\\\n      district: store.district,\\\\n      phone: store.phone,\\\\n      email: store.email || \\\\'\\\\',\\\\n      managerId: store.manager.id,\\\\n      businessHours: { ...store.businessHours },\\\\n      area: store.area,\\\\n      capacity: store.capacity,\\\\n      tables: store.tables,\\\\n      coordinates: store.coordinates || { latitude: 0, longitude: 0 },\\\\n      facilities: store.facilities || [],\\\\n      description: store.description || \\\\'\\\\',\\\\n      images: store.images || [],\\\\n      openingDate: store.openingDate\\\\n    })\\\\n    selectedStore.value = store\\\\n    showStoreDialog.value = true\\\\n  }\\\\n\\\\n  const handleDeleteStore = async (store: Store) => {\\\\n    try {\\\\n      await ElMessageBox.confirm(`确定要删除门店 \\\\\\\"${store.name}\\\\\\\" 吗？`, \\\\'提示\\\\', {\\\\n        confirmButtonText: \\\\'确定\\\\',\\\\n        cancelButtonText: \\\\'取消\\\\',\\\\n        type: \\\\'warning\\\\'\\\\n      })\\\\n      \\\\n      const response = await chainAPI.deleteStore(store.id)\\\\n      if (response.success) {\\\\n        ElMessage.success(\\\\'删除成功\\\\')\\\\n        await loadStores()\\\\n      } else {\\\\n        ElMessage.error(response.message || \\\\'删除失败\\\\')\\\\n      }\\\\n    } catch (error) {\\\\n      if (error !== \\\\'cancel\\\\') {\\\\n        ElMessage.error(\\\\'删除失败\\\\')\\\\n        console.error(\\\\'删除失败:\\\\', error)\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  const handleUpdateStoreStatus = async (store: Store, status: StoreStatus) => {\\\\n    try {\\\\n      const response = await chainAPI.updateStoreStatus(store.id, status)\\\\n      if (response.success) {\\\\n        store.status = status\\\\n        ElMessage.success(\\\\'状态更新成功\\\\')\\\\n      } else {\\\\n        ElMessage.error(response.message || \\\\'状态更新失败\\\\')\\\\n      }\\\\n    } catch (error) {\\\\n      ElMessage.error(\\\\'状态更新失败\\\\')\\\\n      console.error(\\\\'状态更新失败:\\\\', error)\\\\n    }\\\\n  }\\\\n\\\\n  const confirmStore = async () => {\\\\n    try {\\\\n      if (storeDialogType.value === \\\\'create\\\\') {\\\\n        const request: CreateStoreRequest = {\\\\n          storeCode: storeForm.storeCode,\\\\n          name: storeForm.name,\\\\n          type: storeForm.type,\\\\n          status: storeForm.status,\\\\n          address: storeForm.address,\\\\n          city: storeForm.city,\\\\n          district: storeForm.district,\\\\n          phone: storeForm.phone,\\\\n          email: storeForm.email,\\\\n          managerId: storeForm.managerId,\\\\n          businessHours: storeForm.businessHours,\\\\n          area: storeForm.area,\\\\n          capacity: storeForm.capacity,\\\\n          tables: storeForm.tables,\\\\n          coordinates: storeForm.coordinates,\\\\n          facilities: storeForm.facilities,\\\\n          description: storeForm.description,\\\\n          images: storeForm.images,\\\\n          openingDate: storeForm.openingDate\\\\n        }\\\\n        \\\\n        const response = await chainAPI.createStore(request)\\\\n        if (response.success) {\\\\n          ElMessage.success(\\\\'创建成功\\\\')\\\\n          showStoreDialog.value = false\\\\n          await loadStores()\\\\n        } else {\\\\n          ElMessage.error(response.message || \\\\'创建失败\\\\')\\\\n        }\\\\n      } else {\\\\n        const request: UpdateStoreRequest = {\\\\n          name: storeForm.name,\\\\n          type: storeForm.type,\\\\n          status: storeForm.status,\\\\n          address: storeForm.address,\\\\n          city: storeForm.city,\\\\n          district: storeForm.district,\\\\n          phone: storeForm.phone,\\\\n          email: storeForm.email,\\\\n          managerId: storeForm.managerId,\\\\n          businessHours: storeForm.businessHours,\\\\n          area: storeForm.area,\\\\n          capacity: storeForm.capacity,\\\\n          tables: storeForm.tables,\\\\n          coordinates: storeForm.coordinates,\\\\n          facilities: storeForm.facilities,\\\\n          description: storeForm.description,\\\\n          images: storeForm.images\\\\n        }\\\\n        \\\\n        const response = await chainAPI.updateStore(storeForm.id, request)\\\\n        if (response.success) {\\\\n          ElMessage.success(\\\\'更新成功\\\\')\\\\n          showStoreDialog.value = false\\\\n          await loadStores()\\\\n        } else {\\\\n          ElMessage.error(response.message || \\\\'更新失败\\\\')\\\\n        }\\\\n      }\\\\n    } catch (error) {\\\\n      ElMessage.error(\\\\'操作失败\\\\')\\\\n      console.error(\\\\'操作失败:\\\\', error)\\\\n    }\\\\n  }\\\\n\\\\n  const handleAddEmployee = () => {\\\\n    employeeDialogType.value = \\\\'create\\\\'\\\\n    Object.assign(employeeForm, {\\\\n      id: 0,\\\\n      employeeCode: \\\\'\\\\',\\\\n      name: \\\\'\\\\',\\\\n      gender: \\\\'male\\\\',\\\\n      phone: \\\\'\\\\',\\\\n      email: \\\\'\\\\',\\\\n      avatar: \\\\'\\\\',\\\\n      storeId: 0,\\\\n      department: \\\\'\\\\',\\\\n      position: \\\\'\\\\',\\\\n      status: EmployeeStatus.ACTIVE,\\\\n      hireDate: \\\\'\\\\',\\\\n      salary: 0,\\\\n      address: \\\\'\\\\',\\\\n      idCard: \\\\'\\\\',\\\\n      bankAccount: \\\\'\\\\',\\\\n      emergencyContact: { name: \\\\'\\\\', phone: \\\\'\\\\', relationship: \\\\'\\\\' },\\\\n      permissions: [] as string[]\\\\n    })\\\\n    showEmployeeDialog.value = true\\\\n  }\\\\n\\\\n  const handleEditEmployee = (employee: Employee) => {\\\\n    employeeDialogType.value = \\\\'edit\\\\'\\\\n    Object.assign(employeeForm, {\\\\n      id: employee.id,\\\\n      employeeCode: employee.employeeCode,\\\\n      name: employee.name,\\\\n      gender: employee.gender,\\\\n      phone: employee.phone,\\\\n      email: employee.email || \\\\'\\\\',\\\\n      avatar: employee.avatar || \\\\'\\\\',\\\\n      storeId: employee.storeId,\\\\n      department: employee.department,\\\\n      position: employee.position,\\\\n      status: employee.status,\\\\n      hireDate: employee.hireDate,\\\\n      salary: employee.salary,\\\\n      address: employee.address || \\\\'\\\\',\\\\n      idCard: employee.idCard || \\\\'\\\\',\\\\n      bankAccount: employee.bankAccount || \\\\'\\\\',\\\\n      emergencyContact: employee.emergencyContact || { name: \\\\'\\\\', phone: \\\\'\\\\', relationship: \\\\'\\\\' },\\\\n      permissions: employee.permissions\\\\n    })\\\\n    selectedEmployee.value = employee\\\\n    showEmployeeDialog.value = true\\\\n  }\\\\n\\\\n  const handleDeleteEmployee = async (employee: Employee) => {\\\\n    try {\\\\n      await ElMessageBox.confirm(`确定要删除员工 \\\\\\\"${employee.name}\\\\\\\" 吗？`, \\\\'提示\\\\', {\\\\n        confirmButtonText: \\\\'确定\\\\',\\\\n        cancelButtonText: \\\\'取消\\\\',\\\\n        type: \\\\'warning\\\\'\\\\n      })\\\\n      \\\\n      const response = await chainAPI.deleteEmployee(employee.id)\\\\n      if (response.success) {\\\\n        ElMessage.success(\\\\'删除成功\\\\')\\\\n        await loadEmployees()\\\\n      } else {\\\\n        ElMessage.error(response.message || \\\\'删除失败\\\\')\\\\n      }\\\\n    } catch (error) {\\\\n      if (error !== \\\\'cancel\\\\') {\\\\n        ElMessage.error(\\\\'删除失败\\\\')\\\\n        console.error(\\\\'删除失败:\\\\', error)\\\\n      }\\\\n    }\\\\n  }\\\\n\\\\n  const handleTransferEmployee = (employee: Employee) => {\\\\n    transferForm.targetStoreId = 0\\\\n    transferForm.reason = \\\\'\\\\'\\\\n    transferForm.effectiveDate = \\\\'\\\\'\\\\n    selectedEmployee.value = employee\\\\n    showTransferDialog.value = true\\\\n  }\\\\n\\\\n  const confirmTransfer = async () => {\\\\n    try {\\\\n      if (!selectedEmployee.value) return\\\\n      \\\\n      const request: TransferEmployeeRequest = {\\\\n        targetStoreId: transferForm.targetStoreId,\\\\n        reason: transferForm.reason,\\\\n        effectiveDate: transferForm.effectiveDate\\\\n      }\\\\n      \\\\n      const response = await chainAPI.transferEmployee(selectedEmployee.value.id, request)\\\\n      if (response.success) {\\\\n        ElMessage.success(\\\\'调店成功\\\\')\\\\n        showTransferDialog.value = false\\\\n        await loadEmployees()\\\\n      } else {\\\\n        ElMessage.error(response.message || \\\\'调店失败\\\\')\\\\n      }\\\\n    } catch (error) {\\\\n      ElMessage.error(\\\\'调店失败\\\\')\\\\n      console.error(\\\\'调店失败:\\\\', error)\\\\n    }\\\\n  }\\\\n\\\\n  const confirmEmployee = async () => {\\\\n    try {\\\\n      if (employeeDialogType.value === \\\\'create\\\\') {\\\\n        const request: CreateEmployeeRequest = {\\\\n          employeeCode: employeeForm.employeeCode,\\\\n          name: employeeForm.name,\\\\n          gender: employeeForm.gender,\\\\n          phone: employeeForm.phone,\\\\n          email: employeeForm.email,\\\\n          avatar: employeeForm.avatar,\\\\n          storeId: employeeForm.storeId,\\\\n          department: employeeForm.department,\\\\n          position: employeeForm.position,\\\\n          status: employeeForm.status,\\\\n          hireDate: employeeForm.hireDate,\\\\n          salary: employeeForm.salary,\\\\n          address: employeeForm.address,\\\\n          idCard: employeeForm.idCard,\\\\n          bankAccount: employeeForm.bankAccount,\\\\n          emergencyContact: employeeForm.emergencyContact,\\\\n          permissions: employeeForm.permissions\\\\n        }\\\\n        \\\\n        const response = await chainAPI.createEmployee(request)\\\\n        if (response.success) {\\\\n          ElMessage.success(\\\\'创建成功\\\\')\\\\n          showEmployeeDialog.value = false\\\\n          await loadEmployees()\\\\n        } else {\\\\n          ElMessage.error(response.message || \\\\'创建失败\\\\')\\\\n        }\\\\n      } else {\\\\n        const request: UpdateEmployeeRequest = {\\\\n          name: employeeForm.name,\\\\n          gender: employeeForm.gender,\\\\n          phone: employeeForm.phone,\\\\n          email: employeeForm.email,\\\\n          avatar: employeeForm.avatar,\\\\n          storeId: employeeForm.storeId,\\\\n          department: employeeForm.department,\\\\n          position: employeeForm.position,\\\\n          status: employeeForm.status,\\\\n          salary: employeeForm.salary,\\\\n          address: employeeForm.address,\\\\n          idCard: employeeForm.idCard,\\\\n          bankAccount: employeeForm.bankAccount,\\\\n          emergencyContact: employeeForm.emergencyContact,\\\\n          permissions: employeeForm.permissions\\\\n        }\\\\n        \\\\n        const response = await chainAPI.updateEmployee(employeeForm.id, request)\\\\n        if (response.success) {\\\\n          ElMessage.success(\\\\'更新成功\\\\')\\\\n          showEmployeeDialog.value = false\\\\n          await loadEmployees()\\\\n        } else {\\\\n          ElMessage.error(response.message || \\\\'更新失败\\\\')\\\\n        }\\\\n      }\\\\n    } catch (error) {\\\\n      ElMessage.error(\\\\'操作失败\\\\')\\\\n      console.error(\\\\'操作失败:\\\\', error)\\\\n    }\\\\n  }\\\\n\\\\n  const handleRestock = (inventoryItem: Inventory) => {\\\\n    restockForm.storeId = inventoryItem.storeId\\\\n    restockForm.productId = inventoryItem.productId\\\\n    restockForm.quantity = 0\\\\n    restockForm.costPrice = 0\\\\n    restockForm.supplier = { id: 0, name: \\\\'\\\\', phone: \\\\'\\\\' }\\\\n    restockForm.batchNumber = \\\\'\\\\'\\\\n    restockForm.expiryDate = \\\\'\\\\'\\\\n    restockForm.remarks = \\\\'\\\\'\\\\n    selectedInventory.value = inventoryItem\\\\n    showRestockDialog.value = true\\\\n  }\\\\n\\\\n  const confirmRestock = async () => {\\\\n    try {\\\\n      const request: RestockInventoryRequest = {\\\\n        storeId: restockForm.storeId,\\\\n        productId: restockForm.productId,\\\\n        quantity: restockForm.quantity,\\\\n        costPrice: restockForm.costPrice,\\\\n        supplier: restockForm.supplier,\\\\n        batchNumber: restockForm.batchNumber,\\\\n        expiryDate: restockForm.expiryDate,\\\\n        remarks: restockForm.remarks\\\\n      }\\\\n      \\\\n      const response = await chainAPI.restockInventory(request)\\\\n      if (response.success) {\\\\n        ElMessage.success(\\\\'补货成功\\\\')\\\\n        showRestockDialog.value = false\\\\n        await loadInventory()\\\\n      } else {\\\\n        ElMessage.error(response.message || \\\\'补货失败\\\\')\\\\n      }\\\\n    } catch (error) {\\\\n      ElMessage.error(\\\\'补货失败\\\\')\\\\n      console.error(\\\\'补货失败:\\\\', error)\\\\n    }\\\\n  }\\\\n\\\\n  const handleTransferInventory = (inventoryItem: Inventory) => {\\\\n    transferInventoryForm.sourceStoreId = inventoryItem.storeId\\\\n    transferInventoryForm.targetStoreId = 0\\\\n    transferInventoryForm.productId = inventoryItem.productId\\\\n    transferInventoryForm.quantity = 0\\\\n    transferInventoryForm.reason = \\\\'\\\\'\\\\n    transferInventoryForm.effectiveDate = \\\\'\\\\'\\\\n    selectedInventory.value = inventoryItem\\\\n    showTransferInventoryDialog.value = true\\\\n  }\\\\n\\\\n  const confirmTransferInventory = async () => {\\\\n    try {\\\\n      const request: TransferInventoryRequest = {\\\\n        sourceStoreId: transferInventoryForm.sourceStoreId,\\\\n        targetStoreId: transferInventoryForm.targetStoreId,\\\\n        productId: transferInventoryForm.productId,\\\\n        quantity: transferInventoryForm.quantity,\\\\n        reason: transferInventoryForm.reason,\\\\n        effectiveDate: transferInventoryForm.effectiveDate\\\\n      }\\\\n      \\\\n      const response = await chainAPI.transferInventory(request)\\\\n      if (response.success) {\\\\n        ElMessage.success(\\\\'调拨成功\\\\')\\\\n        showTransferInventoryDialog.value = false\\\\n        await loadInventory()\\\\n      } else {\\\\n        ElMessage.error(response.message || \\\\'调拨失败\\\\')\\\\n      }\\\\n    } catch (error) {\\\\n      ElMessage.error(\\\\'调拨失败\\\\')\\\\n      console.error(\\\\'调拨失败:\\\\', error)\\\\n    }\\\\n  }\\\\n\\\\n  const handleCheckInventory = (storeId: number) => {\\\\n    checkForm.storeId = storeId\\\\n    checkForm.checkDate = dayjs().format(\\\\'YYYY-MM-DD\\\\')\\\\n    checkForm.details = []\\\\n    showCheckDialog.value = true\\\\n  }\\\\n\\\\n  const confirmCheck = async () => {\\\\n    try {\\\\n      const request: CheckInventoryRequest = {\\\\n        storeId: checkForm.storeId,\\\\n        checkDate: checkForm.checkDate,\\\\n        details: checkForm.details\\\\n      }\\\\n      \\\\n      const response = await chainAPI.checkInventory(request)\\\\n      if (response.success) {\\\\n        ElMessage.success(\\\\'盘点成功\\\\')\\\\n        showCheckDialog.value = false\\\\n        await loadInventory()\\\\n      } else {\\\\n        ElMessage.error(response.message || \\\\'盘点失败\\\\')\\\\n      }\\\\n    } catch (error) {\\\\n      ElMessage.error(\\\\'盘点失败\\\\')\\\\n      console.error(\\\\'盘点失败:\\\\', error)\\\\n    }\\\\n  }\\\\n\\\\n  const handleStoreSearch = () => {\\\\n    storePagination.page = 1\\\\n    loadStores()\\\\n  }\\\\n\\\\n  const resetStoreFilter = () => {\\\\n    Object.assign(storeFilter, {\\\\n      search: \\\\'\\\\',\\\\n      status: \\\\'\\\\' as StoreStatus | \\\\'\\\\',\\\\n      type: \\\\'\\\\' as StoreType | \\\\'\\\\',\\\\n      city: \\\\'\\\\',\\\\n      district: \\\\'\\\\'\\\\n    })\\\\n    storePagination.page = 1\\\\n    loadStores()\\\\n  }\\\\n\\\\n  const handleEmployeeSearch = () => {\\\\n    employeePagination.page = 1\\\\n    loadEmployees()\\\\n  }\\\\n\\\\n  const resetEmployeeFilter = () => {\\\\n    Object.assign(employeeFilter, {\\\\n      search: \\\\'\\\\',\\\\n      storeId: 0,\\\\n      department: \\\\'\\\\',\\\\n      position: \\\\'\\\\',\\\\n      status: \\\\'\\\\' as EmployeeStatus | \\\\'\\\\'\\\\n    })\\\\n    employeePagination.page = 1\\\\n    loadEmployees()\\\\n  }\\\\n\\\\n  const handleInventorySearch = () => {\\\\n    inventoryPagination.page = 1\\\\n    loadInventory()\\\\n  }\\\\n\\\\n  const resetInventoryFilter = () => {\\\\n    Object.assign(inventoryFilter, {\\\\n      search: \\\\'\\\\',\\\\n      storeId: 0,\\\\n      category: \\\\'\\\\',\\\\n      status: \\\\'\\\\' as InventoryStatus | \\\\'\\\\'\\\\n    })\\\\n    inventoryPagination.page = 1\\\\n    loadInventory()\\\\n  }\\\\n\\\\n  const handleStorePageChange = (page: number) => {\\\\n    storePagination.page = page\\\\n    loadStores()\\\\n  }\\\\n\\\\n  const handleStorePageSizeChange = (pageSize: number) => {\\\\n    storePagination.limit = pageSize\\\\n    storePagination.page = 1\\\\n    loadStores()\\\\n  }\\\\n\\\\n  const handleEmployeePageChange = (page: number) => {\\\\n    employeePagination.page = page\\\\n    loadEmployees()\\\\n  }\\\\n\\\\n  const handleEmployeePageSizeChange = (pageSize: number) => {\\\\n    employeePagination.limit = pageSize\\\\n    employeePagination.page = 1\\\\n    loadEmployees()\\\\n  }\\\\n\\\\n  const handleInventoryPageChange = (page: number) => {\\\\n    inventoryPagination.page = page\\\\n    loadInventory()\\\\n  }\\\\n\\\\n  const handleInventoryPageSizeChange = (pageSize: number) => {\\\\n    inventoryPagination.limit = pageSize\\\\n    inventoryPagination.page = 1\\\\n    loadInventory()\\\\n  }\\\\n\\\\n  const handleTabChange = (tabName: string) => {\\\\n    activeTab.value = tabName as any\\\\n    if (tabName === \\\\'stores\\\\') {\\\\n      loadStores()\\\\n    } else if (tabName === \\\\'employees\\\\') {\\\\n      loadEmployees()\\\\n    } else if (tabName === \\\\'inventory\\\\') {\\\\n      loadInventory()\\\\n    } else if (tabName === \\\\'stats\\\\') {\\\\n      loadStoreStats()\\\\n      loadEmployeePerformance()\\\\n    }\\\\n  }\\\\n\\\\n  const formatNumber = (num: number): string => {\\\\n    return num.toLocaleString(\\\\'zh-CN\\\\', { minimumFractionDigits: 2, maximumFractionDigits: 2 })\\\\n  }\\\\n\\\\n  const formatDateTime = (date: string): string => {\\\\n    return dayjs(date).format(\\\\'YYYY-MM-DD HH:mm:ss\\\\')\\\\n  }\\\\n\\\\n  const getStoreTypeName = (type: StoreType): string => {\\\\n    const names: Record<StoreType, string> = {\\\\n      [StoreType.DIRECT]: \\\\'直营店\\\\',\\\\n      [StoreType.FRANCHISE]: \\\\'加盟店\\\\'\\\\n    }\\\\n    return names[type] || type\\\\n  }\\\\n\\\\n  const getStoreStatusName = (status: StoreStatus): string => {\\\\n    const names: Record<StoreStatus, string> = {\\\\n      [StoreStatus.OPEN]: \\\\'营业中\\\\',\\\\n      [StoreStatus.CLOSED]: \\\\'休息中\\\\',\\\\n      [StoreStatus.MAINTENANCE]: \\\\'已关闭\\\\'\\\\n    }\\\\n    return names[status] || status\\\\n  }\\\\n\\\\n  const getStoreStatusType = (status: StoreStatus): string => {\\\\n    const types: Record<StoreStatus, string> = {\\\\n      [StoreStatus.OPEN]: \\\\'success\\\\',\\\\n      [StoreStatus.CLOSED]: \\\\'warning\\\\',\\\\n      [StoreStatus.MAINTENANCE]: \\\\'danger\\\\'\\\\n    }\\\\n    return types[status] || \\\\'info\\\\'\\\\n  }\\\\n\\\\n  const getEmployeeStatusName = (status: EmployeeStatus): string => {\\\\n    const names: Record<EmployeeStatus, string> = {\\\\n      [EmployeeStatus.ACTIVE]: \\\\'在职\\\\',\\\\n      [EmployeeStatus.RESIGNED]: \\\\'离职\\\\',\\\\n      [EmployeeStatus.LEAVE]: \\\\'请假\\\\'\\\\n    }\\\\n    return names[status] || status\\\\n  }\\\\n\\\\n  const getEmployeeStatusType = (status: EmployeeStatus): string => {\\\\n    const types: Record<EmployeeStatus, string> = {\\\\n      [EmployeeStatus.ACTIVE]: \\\\'success\\\\',\\\\n      [EmployeeStatus.RESIGNED]: \\\\'danger\\\\',\\\\n      [EmployeeStatus.LEAVE]: \\\\'warning\\\\'\\\\n    }\\\\n    return types[status] || \\\\'info\\\\'\\\\n  }\\\\n\\\\n  const getInventoryStatusName = (status: InventoryStatus): string => {\\\\n    const names: Record<InventoryStatus, string> = {\\\\n      [InventoryStatus.NORMAL]: \\\\'充足\\\\',\\\\n      [InventoryStatus.WARNING]: \\\\'预警\\\\',\\\\n      [InventoryStatus.OUT_OF_STOCK]: \\\\'缺货\\\\'\\\\n    }\\\\n    return names[status] || status\\\\n  }\\\\n\\\\n  const getInventoryStatusType = (status: InventoryStatus): string => {\\\\n    const types: Record<InventoryStatus, string> = {\\\\n      [InventoryStatus.NORMAL]: \\\\'success\\\\',\\\\n      [InventoryStatus.WARNING]: \\\\'warning\\\\',\\\\n      [InventoryStatus.OUT_OF_STOCK]: \\\\'danger\\\\'\\\\n    }\\\\n    return types[status] || \\\\'info\\\\'\\\\n  }\\\\n\\\\n  return {\\\\n    loading,\\\\n    activeTab,\\\\n    stores,\\\\n    employees,\\\\n    inventory,\\\\n    storeStats,\\\\n    employeePerformance,\\\\n    revenueComparison,\\\\n    trendData,\\\\n    selectedStore,\\\\n    selectedEmployee,\\\\n    selectedInventory,\\\\n    showStoreDialog,\\\\n    showEmployeeDialog,\\\\n    showInventoryDialog,\\\\n    showTransferDialog,\\\\n    showRestockDialog,\\\\n    showTransferInventoryDialog,\\\\n    showCheckDialog,\\\\n    storeDialogType,\\\\n    employeeDialogType,\\\\n    storeForm,\\\\n    employeeForm,\\\\n    transferForm,\\\\n    restockForm,\\\\n    transferInventoryForm,\\\\n    checkForm,\\\\n    storePagination,\\\\n    employeePagination,\\\\n    inventoryPagination,\\\\n    storeFilter,\\\\n    employeeFilter,\\\\n    inventoryFilter,\\\\n    storesLoading,\\\\n    employeesLoading,\\\\n    inventoryLoading,\\\\n    statsLoading,\\\\n    loadStores,\\\\n    loadEmployees,\\\\n    loadInventory,\\\\n    loadStoreStats,\\\\n    loadEmployeePerformance,\\\\n    handleAddStore,\\\\n    handleEditStore,\\\\n    handleDeleteStore,\\\\n    handleUpdateStoreStatus,\\\\n    confirmStore,\\\\n    handleAddEmployee,\\\\n    handleEditEmployee,\\\\n    handleDeleteEmployee,\\\\n    handleTransferEmployee,\\\\n    confirmTransfer,\\\\n    confirmEmployee,\\\\n    handleRestock,\\\\n    confirmRestock,\\\\n    handleTransferInventory,\\\\n    confirmTransferInventory,\\\\n    handleCheckInventory,\\\\n    confirmCheck,\\\\n    handleStoreSearch,\\\\n    resetStoreFilter,\\\\n    handleEmployeeSearch,\\\\n    resetEmployeeFilter,\\\\n    handleInventorySearch,\\\\n    resetInventoryFilter,\\\\n    handleStorePageChange,\\\\n    handleStorePageSizeChange,\\\\n    handleEmployeePageChange,\\\\n    handleEmployeePageSizeChange,\\\\n    handleInventoryPageChange,\\\\n    handleInventoryPageSizeChange,\\\\n    handleTabChange,\\\\n    formatNumber,\\\\n    formatDateTime,\\\\n    getStoreTypeName,\\\\n    getStoreStatusName,\\\\n    getStoreStatusType,\\\\n    getEmployeeStatusName,\\\\n    getEmployeeStatusType,\\\\n    getInventoryStatusName,\\\\n    getInventoryStatusType\\\\n  }\\\\n}\\\\n\",\"originAcceptText\":\"/**\\n * @fileoverview 连锁管理Composable\\n * @description 管理连锁管理功能的状态和逻辑\\n * @module useChain\\n * @author YYC³\\n * @version 1.0.0\\n * @created 2025-01-20\\n */\\n\\nimport { ref, reactive, computed } from 'vue'\\nimport { ElMessage, ElMessageBox } from 'element-plus'\\nimport dayjs from 'dayjs'\\nimport { \\n  chainAPI, \\n  StoreType, \\n  StoreStatus, \\n  EmployeeStatus, \\n  InventoryStatus,\\n  type Store, \\n  type Employee, \\n  type Inventory, \\n  type StoreStats,\\n  type EmployeePerformance,\\n  type RevenueComparison,\\n  type TrendData,\\n  type CreateStoreRequest,\\n  type UpdateStoreRequest,\\n  type CreateEmployeeRequest,\\n  type UpdateEmployeeRequest,\\n  type TransferEmployeeRequest,\\n  type RestockInventoryRequest,\\n  type TransferInventoryRequest,\\n  type CheckInventoryRequest,\\n  type StoreQueryParams,\\n  type EmployeeQueryParams,\\n  type InventoryQueryParams\\n} from '@/api/chain'\\n\\nexport function useChain() {\\n  const loading = ref(false)\\n  const activeTab = ref<'stores' | 'employees' | 'inventory' | 'stats'>('stores')\\n\\n  const stores = ref<Store[]>([])\\n  const employees = ref<Employee[]>([])\\n  const inventory = ref<Inventory[]>([])\\n  const storeStats = ref<StoreStats[]>([])\\n  const employeePerformance = ref<EmployeePerformance[]>([])\\n  const revenueComparison = ref<RevenueComparison[]>([])\\n  const trendData = ref<TrendData[]>([])\\n\\n  const selectedStore = ref<Store | null>(null)\\n  const selectedEmployee = ref<Employee | null>(null)\\n  const selectedInventory = ref<Inventory | null>(null)\\n\\n  const showStoreDialog = ref(false)\\n  const showEmployeeDialog = ref(false)\\n  const showInventoryDialog = ref(false)\\n  const showTransferDialog = ref(false)\\n  const showRestockDialog = ref(false)\\n  const showTransferInventoryDialog = ref(false)\\n  const showCheckDialog = ref(false)\\n\\n  const storeDialogType = ref<'create' | 'edit'>('create')\\n  const employeeDialogType = ref<'create' | 'edit'>('create')\\n\\n  const storeForm = reactive({\\n    id: 0,\\n    storeCode: '',\\n    name: '',\\n    type: StoreType.DIRECT,\\n    status: StoreStatus.OPEN,\\n    address: '',\\n    city: '',\\n    district: '',\\n    phone: '',\\n    email: '',\\n    managerId: 0,\\n    businessHours: {\\n      monday: { open: '09:00', close: '22:00', enabled: true },\\n      tuesday: { open: '09:00', close: '22:00', enabled: true },\\n      wednesday: { open: '09:00', close: '22:00', enabled: true },\\n      thursday: { open: '09:00', close: '22:00', enabled: true },\\n      friday: { open: '09:00', close: '22:00', enabled: true },\\n      saturday: { open: '09:00', close: '22:00', enabled: true },\\n      sunday: { open: '09:00', close: '22:00', enabled: true }\\n    },\\n    area: 100,\\n    capacity: 100,\\n    tables: 20,\\n    coordinates: { latitude: 0, longitude: 0 },\\n    facilities: [] as string[],\\n    description: '',\\n    images: [] as string[],\\n    openingDate: ''\\n  })\\n\\n  const employeeForm = reactive({\\n    id: 0,\\n    employeeCode: '',\\n    name: '',\\n    gender: 'male' as 'male' | 'female' | 'other',\\n    phone: '',\\n    email: '',\\n    avatar: '',\\n    storeId: 0,\\n    department: '',\\n    position: '',\\n    status: EmployeeStatus.ACTIVE,\\n    hireDate: '',\\n    salary: 0,\\n    address: '',\\n    idCard: '',\\n    bankAccount: '',\\n    emergencyContact: { name: '', phone: '', relationship: '' },\\n    permissions: [] as string[]\\n  })\\n\\n  const transferForm = reactive({\\n    targetStoreId: 0,\\n    reason: '',\\n    effectiveDate: ''\\n  })\\n\\n  const restockForm = reactive({\\n    storeId: 0,\\n    productId: 0,\\n    quantity: 0,\\n    costPrice: 0,\\n    supplier: { id: 0, name: '', phone: '' },\\n    batchNumber: '',\\n    expiryDate: '',\\n    remarks: ''\\n  })\\n\\n  const transferInventoryForm = reactive({\\n    sourceStoreId: 0,\\n    targetStoreId: 0,\\n    productId: 0,\\n    quantity: 0,\\n    reason: '',\\n    effectiveDate: ''\\n  })\\n\\n  const checkForm = reactive({\\n    storeId: 0,\\n    checkDate: '',\\n    details: [] as { productId: number; actualQuantity: number; difference: number; reason?: string }[]\\n  })\\n\\n  const storePagination = reactive({\\n    page: 1,\\n    limit: 20,\\n    total: 0\\n  })\\n\\n  const employeePagination = reactive({\\n    page: 1,\\n    limit: 20,\\n    total: 0\\n  })\\n\\n  const inventoryPagination = reactive({\\n    page: 1,\\n    limit: 20,\\n    total: 0\\n  })\\n\\n  const storeFilter = reactive({\\n    search: '',\\n    status: '' as StoreStatus | '',\\n    type: '' as StoreType | '',\\n    city: '',\\n    district: ''\\n  })\\n\\n  const employeeFilter = reactive({\\n    search: '',\\n    storeId: 0,\\n    department: '',\\n    position: '',\\n    status: '' as EmployeeStatus | ''\\n  })\\n\\n  const inventoryFilter = reactive({\\n    search: '',\\n    storeId: 0,\\n    category: '',\\n    status: '' as InventoryStatus | ''\\n  })\\n\\n  const storesLoading = computed(() => loading.value && activeTab.value === 'stores')\\n  const employeesLoading = computed(() => loading.value && activeTab.value === 'employees')\\n  const inventoryLoading = computed(() => loading.value && activeTab.value === 'inventory')\\n  const statsLoading = computed(() => loading.value && activeTab.value === 'stats')\\n\\n  const loadStores = async () => {\\n    try {\\n      loading.value = true\\n      const params: StoreQueryParams = {\\n        page: storePagination.page,\\n        limit: storePagination.limit,\\n        search: storeFilter.search || undefined,\\n        status: storeFilter.status || undefined,\\n        type: storeFilter.type || undefined,\\n        city: storeFilter.city || undefined,\\n        district: storeFilter.district || undefined\\n      }\\n      \\n      const response = await chainAPI.getStores(params)\\n      if (response.success && response.data) {\\n        stores.value = response.data.items\\n        storePagination.total = response.data.pagination.total\\n      } else {\\n        ElMessage.error(response.message || '加载门店列表失败')\\n      }\\n    } catch (error) {\\n      ElMessage.error('加载门店列表失败')\\n      console.error('加载门店列表失败:', error)\\n    } finally {\\n      loading.value = false\\n    }\\n  }\\n\\n  const loadEmployees = async () => {\\n    try {\\n      loading.value = true\\n      const params: EmployeeQueryParams = {\\n        page: employeePagination.page,\\n        limit: employeePagination.limit,\\n        search: employeeFilter.search || undefined,\\n        storeId: employeeFilter.storeId || undefined,\\n        department: employeeFilter.department || undefined,\\n        position: employeeFilter.position || undefined,\\n        status: employeeFilter.status || undefined\\n      }\\n      \\n      const response = await chainAPI.getEmployees(params)\\n      if (response.success && response.data) {\\n        employees.value = response.data.items\\n        employeePagination.total = response.data.pagination.total\\n      } else {\\n        ElMessage.error(response.message || '加载员工列表失败')\\n      }\\n    } catch (error) {\\n      ElMessage.error('加载员工列表失败')\\n      console.error('加载员工列表失败:', error)\\n    } finally {\\n      loading.value = false\\n    }\\n  }\\n\\n  const loadInventory = async () => {\\n    try {\\n      loading.value = true\\n      const params: InventoryQueryParams = {\\n        page: inventoryPagination.page,\\n        limit: inventoryPagination.limit,\\n        search: inventoryFilter.search || undefined,\\n        storeId: inventoryFilter.storeId || undefined,\\n        category: inventoryFilter.category || undefined,\\n        status: inventoryFilter.status || undefined\\n      }\\n      \\n      const response = await chainAPI.getInventory(params)\\n      if (response.success && response.data) {\\n        inventory.value = response.data.items\\n        inventoryPagination.total = response.data.pagination.total\\n      } else {\\n        ElMessage.error(response.message || '加载库存列表失败')\\n      }\\n    } catch (error) {\\n      ElMessage.error('加载库存列表失败')\\n      console.error('加载库存列表失败:', error)\\n    } finally {\\n      loading.value = false\\n    }\\n  }\\n\\n  const loadStoreStats = async () => {\\n    try {\\n      const response = await chainAPI.getStoreStatsOverview()\\n      if (response.success && response.data) {\\n        storeStats.value = response.data\\n      } else {\\n        ElMessage.error(response.message || '加载门店统计失败')\\n      }\\n    } catch (error) {\\n      ElMessage.error('加载门店统计失败')\\n      console.error('加载门店统计失败:', error)\\n    }\\n  }\\n\\n  const loadEmployeePerformance = async () => {\\n    try {\\n      const response = await chainAPI.getEmployeePerformanceOverview()\\n      if (response.success && response.data) {\\n        employeePerformance.value = response.data\\n      } else {\\n        ElMessage.error(response.message || '加载员工绩效失败')\\n      }\\n    } catch (error) {\\n      ElMessage.error('加载员工绩效失败')\\n      console.error('加载员工绩效失败:', error)\\n    }\\n  }\\n\\n  const handleAddStore = () => {\\n    storeDialogType.value = 'create'\\n    Object.assign(storeForm, {\\n      id: 0,\\n      storeCode: '',\\n      name: '',\\n      type: StoreType.DIRECT,\\n      status: StoreStatus.OPEN,\\n      address: '',\\n      city: '',\\n      district: '',\\n      phone: '',\\n      email: '',\\n      managerId: 0,\\n      businessHours: {\\n        monday: { open: '09:00', close: '22:00', enabled: true },\\n        tuesday: { open: '09:00', close: '22:00', enabled: true },\\n        wednesday: { open: '09:00', close: '22:00', enabled: true },\\n        thursday: { open: '09:00', close: '22:00', enabled: true },\\n        friday: { open: '09:00', close: '22:00', enabled: true },\\n        saturday: { open: '09:00', close: '22:00', enabled: true },\\n        sunday: { open: '09:00', close: '22:00', enabled: true }\\n      },\\n      area: 100,\\n      capacity: 100,\\n      tables: 20,\\n      coordinates: { latitude: 0, longitude: 0 },\\n      facilities: [] as string[],\\n      description: '',\\n      images: [] as string[],\\n      openingDate: ''\\n    })\\n    showStoreDialog.value = true\\n  }\\n\\n  const handleEditStore = (store: Store) => {\\n    storeDialogType.value = 'edit'\\n    Object.assign(storeForm, {\\n      id: store.id,\\n      storeCode: store.storeCode,\\n      name: store.name,\\n      type: store.type,\\n      status: store.status,\\n      address: store.address,\\n      city: store.city,\\n      district: store.district,\\n      phone: store.phone,\\n      email: store.email || '',\\n      managerId: store.manager.id,\\n      businessHours: { ...store.businessHours },\\n      area: store.area,\\n      capacity: store.capacity,\\n      tables: store.tables,\\n      coordinates: store.coordinates || { latitude: 0, longitude: 0 },\\n      facilities: store.facilities || [],\\n      description: store.description || '',\\n      images: store.images || [],\\n      openingDate: store.openingDate\\n    })\\n    selectedStore.value = store\\n    showStoreDialog.value = true\\n  }\\n\\n  const handleDeleteStore = async (store: Store) => {\\n    try {\\n      await ElMessageBox.confirm(`确定要删除门店 \\\"${store.name}\\\" 吗？`, '提示', {\\n        confirmButtonText: '确定',\\n        cancelButtonText: '取消',\\n        type: 'warning'\\n      })\\n      \\n      const response = await chainAPI.deleteStore(store.id)\\n      if (response.success) {\\n        ElMessage.success('删除成功')\\n        await loadStores()\\n      } else {\\n        ElMessage.error(response.message || '删除失败')\\n      }\\n    } catch (error) {\\n      if (error !== 'cancel') {\\n        ElMessage.error('删除失败')\\n        console.error('删除失败:', error)\\n      }\\n    }\\n  }\\n\\n  const handleUpdateStoreStatus = async (store: Store, status: StoreStatus) => {\\n    try {\\n      const response = await chainAPI.updateStoreStatus(store.id, status)\\n      if (response.success) {\\n        store.status = status\\n        ElMessage.success('状态更新成功')\\n      } else {\\n        ElMessage.error(response.message || '状态更新失败')\\n      }\\n    } catch (error) {\\n      ElMessage.error('状态更新失败')\\n      console.error('状态更新失败:', error)\\n    }\\n  }\\n\\n  const confirmStore = async () => {\\n    try {\\n      if (storeDialogType.value === 'create') {\\n        const request: CreateStoreRequest = {\\n          storeCode: storeForm.storeCode,\\n          name: storeForm.name,\\n          type: storeForm.type,\\n          status: storeForm.status,\\n          address: storeForm.address,\\n          city: storeForm.city,\\n          district: storeForm.district,\\n          phone: storeForm.phone,\\n          email: storeForm.email,\\n          managerId: storeForm.managerId,\\n          businessHours: storeForm.businessHours,\\n          area: storeForm.area,\\n          capacity: storeForm.capacity,\\n          tables: storeForm.tables,\\n          coordinates: storeForm.coordinates,\\n          facilities: storeForm.facilities,\\n          description: storeForm.description,\\n          images: storeForm.images,\\n          openingDate: storeForm.openingDate\\n        }\\n        \\n        const response = await chainAPI.createStore(request)\\n        if (response.success) {\\n          ElMessage.success('创建成功')\\n          showStoreDialog.value = false\\n          await loadStores()\\n        } else {\\n          ElMessage.error(response.message || '创建失败')\\n        }\\n      } else {\\n        const request: UpdateStoreRequest = {\\n          name: storeForm.name,\\n          type: storeForm.type,\\n          status: storeForm.status,\\n          address: storeForm.address,\\n          city: storeForm.city,\\n          district: storeForm.district,\\n          phone: storeForm.phone,\\n          email: storeForm.email,\\n          managerId: storeForm.managerId,\\n          businessHours: storeForm.businessHours,\\n          area: storeForm.area,\\n          capacity: storeForm.capacity,\\n          tables: storeForm.tables,\\n          coordinates: storeForm.coordinates,\\n          facilities: storeForm.facilities,\\n          description: storeForm.description,\\n          images: storeForm.images\\n        }\\n        \\n        const response = await chainAPI.updateStore(storeForm.id, request)\\n        if (response.success) {\\n          ElMessage.success('更新成功')\\n          showStoreDialog.value = false\\n          await loadStores()\\n        } else {\\n          ElMessage.error(response.message || '更新失败')\\n        }\\n      }\\n    } catch (error) {\\n      ElMessage.error('操作失败')\\n      console.error('操作失败:', error)\\n    }\\n  }\\n\\n  const handleAddEmployee = () => {\\n    employeeDialogType.value = 'create'\\n    Object.assign(employeeForm, {\\n      id: 0,\\n      employeeCode: '',\\n      name: '',\\n      gender: 'male',\\n      phone: '',\\n      email: '',\\n      avatar: '',\\n      storeId: 0,\\n      department: '',\\n      position: '',\\n      status: EmployeeStatus.ACTIVE,\\n      hireDate: '',\\n      salary: 0,\\n      address: '',\\n      idCard: '',\\n      bankAccount: '',\\n      emergencyContact: { name: '', phone: '', relationship: '' },\\n      permissions: [] as string[]\\n    })\\n    showEmployeeDialog.value = true\\n  }\\n\\n  const handleEditEmployee = (employee: Employee) => {\\n    employeeDialogType.value = 'edit'\\n    Object.assign(employeeForm, {\\n      id: employee.id,\\n      employeeCode: employee.employeeCode,\\n      name: employee.name,\\n      gender: employee.gender,\\n      phone: employee.phone,\\n      email: employee.email || '',\\n      avatar: employee.avatar || '',\\n      storeId: employee.storeId,\\n      department: employee.department,\\n      position: employee.position,\\n      status: employee.status,\\n      hireDate: employee.hireDate,\\n      salary: employee.salary,\\n      address: employee.address || '',\\n      idCard: employee.idCard || '',\\n      bankAccount: employee.bankAccount || '',\\n      emergencyContact: employee.emergencyContact || { name: '', phone: '', relationship: '' },\\n      permissions: employee.permissions\\n    })\\n    selectedEmployee.value = employee\\n    showEmployeeDialog.value = true\\n  }\\n\\n  const handleDeleteEmployee = async (employee: Employee) => {\\n    try {\\n      await ElMessageBox.confirm(`确定要删除员工 \\\"${employee.name}\\\" 吗？`, '提示', {\\n        confirmButtonText: '确定',\\n        cancelButtonText: '取消',\\n        type: 'warning'\\n      })\\n      \\n      const response = await chainAPI.deleteEmployee(employee.id)\\n      if (response.success) {\\n        ElMessage.success('删除成功')\\n        await loadEmployees()\\n      } else {\\n        ElMessage.error(response.message || '删除失败')\\n      }\\n    } catch (error) {\\n      if (error !== 'cancel') {\\n        ElMessage.error('删除失败')\\n        console.error('删除失败:', error)\\n      }\\n    }\\n  }\\n\\n  const handleTransferEmployee = (employee: Employee) => {\\n    transferForm.targetStoreId = 0\\n    transferForm.reason = ''\\n    transferForm.effectiveDate = ''\\n    selectedEmployee.value = employee\\n    showTransferDialog.value = true\\n  }\\n\\n  const confirmTransfer = async () => {\\n    try {\\n      if (!selectedEmployee.value) return\\n      \\n      const request: TransferEmployeeRequest = {\\n        targetStoreId: transferForm.targetStoreId,\\n        reason: transferForm.reason,\\n        effectiveDate: transferForm.effectiveDate\\n      }\\n      \\n      const response = await chainAPI.transferEmployee(selectedEmployee.value.id, request)\\n      if (response.success) {\\n        ElMessage.success('调店成功')\\n        showTransferDialog.value = false\\n        await loadEmployees()\\n      } else {\\n        ElMessage.error(response.message || '调店失败')\\n      }\\n    } catch (error) {\\n      ElMessage.error('调店失败')\\n      console.error('调店失败:', error)\\n    }\\n  }\\n\\n  const confirmEmployee = async () => {\\n    try {\\n      if (employeeDialogType.value === 'create') {\\n        const request: CreateEmployeeRequest = {\\n          employeeCode: employeeForm.employeeCode,\\n          name: employeeForm.name,\\n          gender: employeeForm.gender,\\n          phone: employeeForm.phone,\\n          email: employeeForm.email,\\n          avatar: employeeForm.avatar,\\n          storeId: employeeForm.storeId,\\n          department: employeeForm.department,\\n          position: employeeForm.position,\\n          status: employeeForm.status,\\n          hireDate: employeeForm.hireDate,\\n          salary: employeeForm.salary,\\n          address: employeeForm.address,\\n          idCard: employeeForm.idCard,\\n          bankAccount: employeeForm.bankAccount,\\n          emergencyContact: employeeForm.emergencyContact,\\n          permissions: employeeForm.permissions\\n        }\\n        \\n        const response = await chainAPI.createEmployee(request)\\n        if (response.success) {\\n          ElMessage.success('创建成功')\\n          showEmployeeDialog.value = false\\n          await loadEmployees()\\n        } else {\\n          ElMessage.error(response.message || '创建失败')\\n        }\\n      } else {\\n        const request: UpdateEmployeeRequest = {\\n          name: employeeForm.name,\\n          gender: employeeForm.gender,\\n          phone: employeeForm.phone,\\n          email: employeeForm.email,\\n          avatar: employeeForm.avatar,\\n          storeId: employeeForm.storeId,\\n          department: employeeForm.department,\\n          position: employeeForm.position,\\n          status: employeeForm.status,\\n          salary: employeeForm.salary,\\n          address: employeeForm.address,\\n          idCard: employeeForm.idCard,\\n          bankAccount: employeeForm.bankAccount,\\n          emergencyContact: employeeForm.emergencyContact,\\n          permissions: employeeForm.permissions\\n        }\\n        \\n        const response = await chainAPI.updateEmployee(employeeForm.id, request)\\n        if (response.success) {\\n          ElMessage.success('更新成功')\\n          showEmployeeDialog.value = false\\n          await loadEmployees()\\n        } else {\\n          ElMessage.error(response.message || '更新失败')\\n        }\\n      }\\n    } catch (error) {\\n      ElMessage.error('操作失败')\\n      console.error('操作失败:', error)\\n    }\\n  }\\n\\n  const handleRestock = (inventoryItem: Inventory) => {\\n    restockForm.storeId = inventoryItem.storeId\\n    restockForm.productId = inventoryItem.productId\\n    restockForm.quantity = 0\\n    restockForm.costPrice = 0\\n    restockForm.supplier = { id: 0, name: '', phone: '' }\\n    restockForm.batchNumber = ''\\n    restockForm.expiryDate = ''\\n    restockForm.remarks = ''\\n    selectedInventory.value = inventoryItem\\n    showRestockDialog.value = true\\n  }\\n\\n  const confirmRestock = async () => {\\n    try {\\n      const request: RestockInventoryRequest = {\\n        storeId: restockForm.storeId,\\n        productId: restockForm.productId,\\n        quantity: restockForm.quantity,\\n        costPrice: restockForm.costPrice,\\n        supplier: restockForm.supplier,\\n        batchNumber: restockForm.batchNumber,\\n        expiryDate: restockForm.expiryDate,\\n        remarks: restockForm.remarks\\n      }\\n      \\n      const response = await chainAPI.restockInventory(request)\\n      if (response.success) {\\n        ElMessage.success('补货成功')\\n        showRestockDialog.value = false\\n        await loadInventory()\\n      } else {\\n        ElMessage.error(response.message || '补货失败')\\n      }\\n    } catch (error) {\\n      ElMessage.error('补货失败')\\n      console.error('补货失败:', error)\\n    }\\n  }\\n\\n  const handleTransferInventory = (inventoryItem: Inventory) => {\\n    transferInventoryForm.sourceStoreId = inventoryItem.storeId\\n    transferInventoryForm.targetStoreId = 0\\n    transferInventoryForm.productId = inventoryItem.productId\\n    transferInventoryForm.quantity = 0\\n    transferInventoryForm.reason = ''\\n    transferInventoryForm.effectiveDate = ''\\n    selectedInventory.value = inventoryItem\\n    showTransferInventoryDialog.value = true\\n  }\\n\\n  const confirmTransferInventory = async () => {\\n    try {\\n      const request: TransferInventoryRequest = {\\n        sourceStoreId: transferInventoryForm.sourceStoreId,\\n        targetStoreId: transferInventoryForm.targetStoreId,\\n        productId: transferInventoryForm.productId,\\n        quantity: transferInventoryForm.quantity,\\n        reason: transferInventoryForm.reason,\\n        effectiveDate: transferInventoryForm.effectiveDate\\n      }\\n      \\n      const response = await chainAPI.transferInventory(request)\\n      if (response.success) {\\n        ElMessage.success('调拨成功')\\n        showTransferInventoryDialog.value = false\\n        await loadInventory()\\n      } else {\\n        ElMessage.error(response.message || '调拨失败')\\n      }\\n    } catch (error) {\\n      ElMessage.error('调拨失败')\\n      console.error('调拨失败:', error)\\n    }\\n  }\\n\\n  const handleCheckInventory = (storeId: number) => {\\n    checkForm.storeId = storeId\\n    checkForm.checkDate = dayjs().format('YYYY-MM-DD')\\n    checkForm.details = []\\n    showCheckDialog.value = true\\n  }\\n\\n  const confirmCheck = async () => {\\n    try {\\n      const request: CheckInventoryRequest = {\\n        storeId: checkForm.storeId,\\n        checkDate: checkForm.checkDate,\\n        details: checkForm.details\\n      }\\n      \\n      const response = await chainAPI.checkInventory(request)\\n      if (response.success) {\\n        ElMessage.success('盘点成功')\\n        showCheckDialog.value = false\\n        await loadInventory()\\n      } else {\\n        ElMessage.error(response.message || '盘点失败')\\n      }\\n    } catch (error) {\\n      ElMessage.error('盘点失败')\\n      console.error('盘点失败:', error)\\n    }\\n  }\\n\\n  const handleStoreSearch = () => {\\n    storePagination.page = 1\\n    loadStores()\\n  }\\n\\n  const resetStoreFilter = () => {\\n    Object.assign(storeFilter, {\\n      search: '',\\n      status: '' as StoreStatus | '',\\n      type: '' as StoreType | '',\\n      city: '',\\n      district: ''\\n    })\\n    storePagination.page = 1\\n    loadStores()\\n  }\\n\\n  const handleEmployeeSearch = () => {\\n    employeePagination.page = 1\\n    loadEmployees()\\n  }\\n\\n  const resetEmployeeFilter = () => {\\n    Object.assign(employeeFilter, {\\n      search: '',\\n      storeId: 0,\\n      department: '',\\n      position: '',\\n      status: '' as EmployeeStatus | ''\\n    })\\n    employeePagination.page = 1\\n    loadEmployees()\\n  }\\n\\n  const handleInventorySearch = () => {\\n    inventoryPagination.page = 1\\n    loadInventory()\\n  }\\n\\n  const resetInventoryFilter = () => {\\n    Object.assign(inventoryFilter, {\\n      search: '',\\n      storeId: 0,\\n      category: '',\\n      status: '' as InventoryStatus | ''\\n    })\\n    inventoryPagination.page = 1\\n    loadInventory()\\n  }\\n\\n  const handleStorePageChange = (page: number) => {\\n    storePagination.page = page\\n    loadStores()\\n  }\\n\\n  const handleStorePageSizeChange = (pageSize: number) => {\\n    storePagination.limit = pageSize\\n    storePagination.page = 1\\n    loadStores()\\n  }\\n\\n  const handleEmployeePageChange = (page: number) => {\\n    employeePagination.page = page\\n    loadEmployees()\\n  }\\n\\n  const handleEmployeePageSizeChange = (pageSize: number) => {\\n    employeePagination.limit = pageSize\\n    employeePagination.page = 1\\n    loadEmployees()\\n  }\\n\\n  const handleInventoryPageChange = (page: number) => {\\n    inventoryPagination.page = page\\n    loadInventory()\\n  }\\n\\n  const handleInventoryPageSizeChange = (pageSize: number) => {\\n    inventoryPagination.limit = pageSize\\n    inventoryPagination.page = 1\\n    loadInventory()\\n  }\\n\\n  const handleTabChange = (tabName: string) => {\\n    activeTab.value = tabName as any\\n    if (tabName === 'stores') {\\n      loadStores()\\n    } else if (tabName === 'employees') {\\n      loadEmployees()\\n    } else if (tabName === 'inventory') {\\n      loadInventory()\\n    } else if (tabName === 'stats') {\\n      loadStoreStats()\\n      loadEmployeePerformance()\\n    }\\n  }\\n\\n  const formatNumber = (num: number): string => {\\n    return num.toLocaleString('zh-CN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })\\n  }\\n\\n  const formatDateTime = (date: string): string => {\\n    return dayjs(date).format('YYYY-MM-DD HH:mm:ss')\\n  }\\n\\n  const getStoreTypeName = (type: StoreType): string => {\\n    const names: Record<StoreType, string> = {\\n      [StoreType.DIRECT]: '直营店',\\n      [StoreType.FRANCHISE]: '加盟店'\\n    }\\n    return names[type] || type\\n  }\\n\\n  const getStoreStatusName = (status: StoreStatus): string => {\\n    const names: Record<StoreStatus, string> = {\\n      [StoreStatus.OPEN]: '营业中',\\n      [StoreStatus.CLOSED]: '休息中',\\n      [StoreStatus.MAINTENANCE]: '已关闭'\\n    }\\n    return names[status] || status\\n  }\\n\\n  const getStoreStatusType = (status: StoreStatus): string => {\\n    const types: Record<StoreStatus, string> = {\\n      [StoreStatus.OPEN]: 'success',\\n      [StoreStatus.CLOSED]: 'warning',\\n      [StoreStatus.MAINTENANCE]: 'danger'\\n    }\\n    return types[status] || 'info'\\n  }\\n\\n  const getEmployeeStatusName = (status: EmployeeStatus): string => {\\n    const names: Record<EmployeeStatus, string> = {\\n      [EmployeeStatus.ACTIVE]: '在职',\\n      [EmployeeStatus.RESIGNED]: '离职',\\n      [EmployeeStatus.LEAVE]: '请假'\\n    }\\n    return names[status] || status\\n  }\\n\\n  const getEmployeeStatusType = (status: EmployeeStatus): string => {\\n    const types: Record<EmployeeStatus, string> = {\\n      [EmployeeStatus.ACTIVE]: 'success',\\n      [EmployeeStatus.RESIGNED]: 'danger',\\n      [EmployeeStatus.LEAVE]: 'warning'\\n    }\\n    return types[status] || 'info'\\n  }\\n\\n  const getInventoryStatusName = (status: InventoryStatus): string => {\\n    const names: Record<InventoryStatus, string> = {\\n      [InventoryStatus.NORMAL]: '充足',\\n      [InventoryStatus.WARNING]: '预警',\\n      [InventoryStatus.OUT_OF_STOCK]: '缺货'\\n    }\\n    return names[status] || status\\n  }\\n\\n  const getInventoryStatusType = (status: InventoryStatus): string => {\\n    const types: Record<InventoryStatus, string> = {\\n      [InventoryStatus.NORMAL]: 'success',\\n      [InventoryStatus.WARNING]: 'warning',\\n      [InventoryStatus.OUT_OF_STOCK]: 'danger'\\n    }\\n    return types[status] || 'info'\\n  }\\n\\n  return {\\n    loading,\\n    activeTab,\\n    stores,\\n    employees,\\n    inventory,\\n    storeStats,\\n    employeePerformance,\\n    revenueComparison,\\n    trendData,\\n    selectedStore,\\n    selectedEmployee,\\n    selectedInventory,\\n    showStoreDialog,\\n    showEmployeeDialog,\\n    showInventoryDialog,\\n    showTransferDialog,\\n    showRestockDialog,\\n    showTransferInventoryDialog,\\n    showCheckDialog,\\n    storeDialogType,\\n    employeeDialogType,\\n    storeForm,\\n    employeeForm,\\n    transferForm,\\n    restockForm,\\n    transferInventoryForm,\\n    checkForm,\\n    storePagination,\\n    employeePagination,\\n    inventoryPagination,\\n    storeFilter,\\n    employeeFilter,\\n    inventoryFilter,\\n    storesLoading,\\n    employeesLoading,\\n    inventoryLoading,\\n    statsLoading,\\n    loadStores,\\n    loadEmployees,\\n    loadInventory,\\n    loadStoreStats,\\n    loadEmployeePerformance,\\n    handleAddStore,\\n    handleEditStore,\\n    handleDeleteStore,\\n    handleUpdateStoreStatus,\\n    confirmStore,\\n    handleAddEmployee,\\n    handleEditEmployee,\\n    handleDeleteEmployee,\\n    handleTransferEmployee,\\n    confirmTransfer,\\n    confirmEmployee,\\n    handleRestock,\\n    confirmRestock,\\n    handleTransferInventory,\\n    confirmTransferInventory,\\n    handleCheckInventory,\\n    confirmCheck,\\n    handleStoreSearch,\\n    resetStoreFilter,\\n    handleEmployeeSearch,\\n    resetEmployeeFilter,\\n    handleInventorySearch,\\n    resetInventoryFilter,\\n    handleStorePageChange,\\n    handleStorePageSizeChange,\\n    handleEmployeePageChange,\\n    handleEmployeePageSizeChange,\\n    handleInventoryPageChange,\\n    handleInventoryPageSizeChange,\\n    handleTabChange,\\n    formatNumber,\\n    formatDateTime,\\n    getStoreTypeName,\\n    getStoreStatusName,\\n    getStoreStatusType,\\n    getEmployeeStatusName,\\n    getEmployeeStatusType,\\n    getInventoryStatusName,\\n    getInventoryStatusType\\n  }\\n}\\n\",\"originTextLength\":28684,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768883703913}]",
