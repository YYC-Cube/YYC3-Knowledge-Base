hover:bg-neutral-100 focus:ring-neutral-500\\\\',\\\\n      },\\\\n      size: {\\\\n        sm: \\\\'px-2 py-0.5 text-xs\\\\',\\\\n        md: \\\\'px-2.5 py-1 text-sm\\\\',\\\\n        lg: \\\\'px-3 py-1.5 text-base\\\\',\\\\n      },\\\\n      rounded: {\\\\n        none: \\\\'rounded-none\\\\',\\\\n        sm: \\\\'rounded-sm\\\\',\\\\n        md: \\\\'rounded-md\\\\',\\\\n        lg: \\\\'rounded-lg\\\\',\\\\n        full: \\\\'rounded-full\\\\',\\\\n      },\\\\n    },\\\\n    defaultVariants: {\\\\n      variant: \\\\'default\\\\',\\\\n      size: \\\\'md\\\\',\\\\n      rounded: \\\\'md\\\\',\\\\n    },\\\\n  }\\\\n)\\\\n\\\\ntype BadgeVariants = VariantProps<typeof badgeVariants>\\\\n\\\\nexport const Badge = defineComponent({\\\\n  name: \\\\'Badge\\\\',\\\\n  props: {\\\\n    variant: {\\\\n      type: String as PropType<BadgeVariants[\\\\'variant\\\\']>,\\\\n      default: \\\\'default\\\\',\\\\n      validator: (value: string) => {\\\\n        return [\\\\'default\\\\', \\\\'secondary\\\\', \\\\'success\\\\', \\\\'warning\\\\', \\\\'danger\\\\', \\\\'outline\\\\', \\\\'ghost\\\\'].includes(value)\\\\n      },\\\\n    },\\\\n    size: {\\\\n      type: String as PropType<BadgeVariants[\\\\'size\\\\']>,\\\\n      default: \\\\'md\\\\',\\\\n      validator: (value: string) => {\\\\n        return [\\\\'sm\\\\', \\\\'md\\\\', \\\\'lg\\\\'].includes(value)\\\\n      },\\\\n    },\\\\n    rounded: {\\\\n      type: String as PropType<BadgeVariants[\\\\'rounded\\\\']>,\\\\n      default: \\\\'md\\\\',\\\\n      validator: (value: string) => {\\\\n        return [\\\\'none\\\\', \\\\'sm\\\\', \\\\'md\\\\', \\\\'lg\\\\', \\\\'full\\\\'].includes(value)\\\\n      },\\\\n    },\\\\n    dot: {\\\\n      type: Boolean,\\\\n      default: false,\\\\n    },\\\\n    count: {\\\\n      type: Number,\\\\n      default: undefined,\\\\n    },\\\\n    maxCount: {\\\\n      type: Number,\\\\n      default: 99,\\\\n    },\\\\n    showZero: {\\\\n      type: Boolean,\\\\n      default: false,\\\\n    },\\\\n  },\\\\n  setup(props, { attrs, slots }) {\\\\n    const displayCount = computed(() => {\\\\n      if (props.count === undefined) {\\\\n        return undefined\\\\n      }\\\\n      if (props.count === 0 && !props.showZero) {\\\\n        return undefined\\\\n      }\\\\n      return props.count > props.maxCount ? `${props.maxCount}+` : props.count\\\\n    })\\\\n\\\\n    return () => {\\\\n      const { variant, size, rounded, dot, count, maxCount, showZero } = props\\\\n      const classes = cn(badgeVariants({ variant, size, rounded }))\\\\n\\\\n      if (count !== undefined) {\\\\n        const countValue = displayCount.value\\\\n        if (countValue === undefined) {\\\\n          return slots.default?.()\\\\n        }\\\\n\\\\n        return (\\\\n          <span class={cn(\\\\'relative inline-flex\\\\', attrs.class as string)}>\\\\n            {slots.default?.()}\\\\n            {countValue !== undefined && (\\\\n              <span class={cn(\\\\'absolute -top-2 -right-2\\\\', classes)}>\\\\n                {dot ? (\\\\n                  <span class=\\\\\\\"w-2 h-2 rounded-full bg-current\\\\\\\" />\\\\n                ) : (\\\\n                  countValue\\\\n                )}\\\\n              </span>\\\\n            )}\\\\n          </span>\\\\n        )\\\\n      }\\\\n\\\\n      return (\\\\n        <span class={cn(classes, attrs.class as string)}>\\\\n          {dot && <span class=\\\\\\\"w-2 h-2 rounded-full bg-current mr-1\\\\\\\" />}\\\\n          {slots.default?.()}\\\\n        </span>\\\\n      )\\\\n    }\\\\n  },\\\\n})\\\\n\",\"originAcceptText\":\"/**\\n * @fileoverview YYC³餐饮行业智能化平台 - 徽章组件\\n * @description 统一的徽章组件，支持多种样式和尺寸\\n * @author YYC³\\n * @version 1.0.0\\n * @created 2026-01-21\\n * @copyright Copyright (c) 2026 YYC³\\n * @license MIT\\n */\\n\\nimport { defineComponent, type PropType } from 'vue'\\nimport { cva, type VariantProps } from 'class-variance-authority'\\nimport { cn } from '@/utils/cn'\\n\\nconst badgeVariants = cva(\\n  'inline-flex items-center justify-center rounded-md border px-2.5 py-0.5 text-xs font-medium w-fit whitespace-nowrap shrink-0 gap-1 transition-[color,box-shadow] overflow-hidden focus:outline-none focus:ring-2 focus:ring-offset-2',\\n  {\\n    variants: {\\n      variant: {\\n        default:\\n          'border-transparent bg-primary-600 text-white hover:bg-primary-700 focus:ring-primary-500',\\n        secondary:\\n          'border-transparent bg-secondary-600 text-white hover:bg-secondary-700 focus:ring-secondary-500',\\n        success:\\n          'border-transparent bg-success-600 text-white hover:bg-success-700 focus:ring-success-500',\\n        warning:\\n          'border-transparent bg-warning-600 text-white hover:bg-warning-700 focus:ring-warning-500',\\n        danger:\\n          'border-transparent bg-danger-600 text-white hover:bg-danger-700 focus:ring-danger-500',\\n        outline:\\n          'border-primary-600 text-primary-600 hover:bg-primary-50 focus:ring-primary-500',\\n        ghost:\\n          'bg-transparent text-neutral-700 hover:bg-neutral-100 focus:ring-neutral-500',\\n      },\\n      size: {\\n        sm: 'px-2 py-0.5 text-xs',\\n        md: 'px-2.5 py-1 text-sm',\\n        lg: 'px-3 py-1.5 text-base',\\n      },\\n      rounded: {\\n        none: 'rounded-none',\\n        sm: 'rounded-sm',\\n        md: 'rounded-md',\\n        lg: 'rounded-lg',\\n        full: 'rounded-full',\\n      },\\n    },\\n    defaultVariants: {\\n      variant: 'default',\\n      size: 'md',\\n      rounded: 'md',\\n    },\\n  }\\n)\\n\\ntype BadgeVariants = VariantProps<typeof badgeVariants>\\n\\nexport const Badge = defineComponent({\\n  name: 'Badge',\\n  props: {\\n    variant: {\\n      type: String as PropType<BadgeVariants['variant']>,\\n      default: 'default',\\n      validator: (value: string) => {\\n        return ['default', 'secondary', 'success', 'warning', 'danger', 'outline', 'ghost'].includes(value)\\n      },\\n    },\\n    size: {\\n      type: String as PropType<BadgeVariants['size']>,\\n      default: 'md',\\n      validator: (value: string) => {\\n        return ['sm', 'md', 'lg'].includes(value)\\n      },\\n    },\\n    rounded: {\\n      type: String as PropType<BadgeVariants['rounded']>,\\n      default: 'md',\\n      validator: (value: string) => {\\n        return ['none', 'sm', 'md', 'lg', 'full'].includes(value)\\n      },\\n    },\\n    dot: {\\n      type: Boolean,\\n      default: false,\\n    },\\n    count: {\\n      type: Number,\\n      default: undefined,\\n    },\\n    maxCount: {\\n      type: Number,\\n      default: 99,\\n    },\\n    showZero: {\\n      type: Boolean,\\n      default: false,\\n    },\\n  },\\n  setup(props, { attrs, slots }) {\\n    const displayCount = computed(() => {\\n      if (props.count === undefined) {\\n        return undefined\\n      }\\n      if (props.count === 0 && !props.showZero) {\\n        return undefined\\n      }\\n      return props.count > props.maxCount ? `${props.maxCount}+` : props.count\\n    })\\n\\n    return () => {\\n      const { variant, size, rounded, dot, count, maxCount, showZero } = props\\n      const classes = cn(badgeVariants({ variant, size, rounded }))\\n\\n      if (count !== undefined) {\\n        const countValue = displayCount.value\\n        if (countValue === undefined) {\\n          return slots.default?.()\\n        }\\n\\n        return (\\n          <span class={cn('relative inline-flex', attrs.class as string)}>\\n            {slots.default?.()}\\n            {countValue !== undefined && (\\n              <span class={cn('absolute -top-2 -right-2', classes)}>\\n                {dot ? (\\n                  <span class=\\\"w-2 h-2 rounded-full bg-current\\\" />\\n                ) : (\\n                  countValue\\n                )}\\n              </span>\\n            )}\\n          </span>\\n        )\\n      }\\n\\n      return (\\n        <span class={cn(classes, attrs.class as string)}>\\n          {dot && <span class=\\\"w-2 h-2 rounded-full bg-current mr-1\\\" />}\\n          {slots.default?.()}\\n        </span>\\n      )\\n    }\\n  },\\n})\\n\",\"originTextLength\":4254,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768928464726},{\"originRange\":{\"start\":{\"line\":10,\"character\":0},\"end\":{\"line\":10,\"character\":62}},\"modifyRange\":{\"start\":{\"line\":10,\"character\":0},\"end\":{\"line\":10,\"character\":62}},\"action\":\"None\",\"isLine\":false,\"originText\":\"import { defineComponent, computed, type PropType } from \\\\'vue\\\\'\",\"originAcceptText\":\"import { defineComponent, computed, type PropType } from 'vue'\",\"originTextLength\":62,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768928470374}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/components/UI/Alert/index.tsx": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":156,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":156,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"/**\\\\n * @fileoverview YYC³餐饮行业智能化平台 - 警告提示组件\\\\n * @description 统一的警告提示组件，支持多种样式和操作\\\\n * @author YYC³\\\\n * @version 1.0.0\\\\n * @created 2026-01-21\\\\n * @copyright Copyright (c) 2026 YYC³\\\\n * @license MIT\\\\n */\\\\n\\\\nimport { defineComponent, type PropType } from \\\\'vue\\\\'\\\\nimport { cva, type VariantProps } from \\\\'class-variance-authority\\\\'\\\\nimport { cn } from \\\\'@/utils/cn\\\\'\\\\nimport { X, CheckCircle, AlertCircle, AlertTriangle, Info } from \\\\'lucide-vue-next\\\\'\\\\n\\\\nconst alertVariants = cva(\\\\n  \\\\'relative w-full rounded-lg border px-4 py-3 text-sm flex items-start gap-3\\\\',\\\\n  {\\\\n    variants: {\\\\n      variant: {\\\\n        default:\\\\n          \\\\'bg-white border-neutral-200 text-neutral-900\\\\',\\\\n        info:\\\\n          \\\\'bg-blue-50 border-blue-200 text-blue-900\\\\',\\\\n        success:\\\\n          \\\\'bg-green-50 border-green-200 text-green-900\\\\',\\\\n        warning:\\\\n          \\\\'bg-yellow-50 border-yellow-200 text-yellow-900\\\\',\\\\n        danger:\\\\n          \\\\'bg-red-50 border-red-200 text-red-900\\\\',\\\\n      },\\\\n    },\\\\n    defaultVariants: {\\\\n      variant: \\\\'default\\\\',\\\\n    },\\\\n  }\\\\n)\\\\n\\\\ntype AlertVariants = VariantProps<typeof alertVariants>\\\\n\\\\nexport const Alert = defineComponent({\\\\n  name: \\\\'Alert\\\\',\\\\n  props: {\\\\n    variant: {\\\\n      type: String as PropType<AlertVariants[\\\\'variant\\\\']>,\\\\n      default: \\\\'default\\\\',\\\\n      validator: (value: string) => {\\\\n        return [\\\\'default\\\\', \\\\'info\\\\', \\\\'success\\\\', \\\\'warning\\\\', \\\\'danger\\\\'].includes(value)\\\\n      },\\\\n    },\\\\n    showIcon: {\\\\n      type: Boolean,\\\\n      default: true,\\\\n    },\\\\n    closable: {\\\\n      type: Boolean,\\\\n      default: false,\\\\n    },\\\\n    banner: {\\\\n      type: Boolean,\\\\n      default: false,\\\\n    },\\\\n  },\\\\n  emits: [\\\\'close\\\\'],\\\\n  setup(props, { emit, attrs, slots }) {\\\\n    const visible = ref(true)\\\\n\\\\n    const iconComponent = computed(() => {\\\\n      switch (props.variant) {\\\\n        case \\\\'success\\\\':\\\\n          return CheckCircle\\\\n        case \\\\'warning\\\\':\\\\n          return AlertTriangle\\\\n        case \\\\'danger\\\\':\\\\n          return AlertCircle\\\\n        case \\\\'info\\\\':\\\\n        default:\\\\n          return Info\\\\n      }\\\\n    })\\\\n\\\\n    const iconColor = computed(() => {\\\\n      switch (props.variant) {\\\\n        case \\\\'success\\\\':\\\\n          return \\\\'text-green-600\\\\'\\\\n        case \\\\'warning\\\\':\\\\n          return \\\\'text-yellow-600\\\\'\\\\n        case \\\\'danger\\\\':\\\\n          return \\\\'text-red-600\\\\'\\\\n        case \\\\'info\\\\':\\\\n        default:\\\\n          return \\\\'text-blue-600\\\\'\\\\n      }\\\\n    })\\\\n\\\\n    const handleClose = () => {\\\\n      visible.value = false\\\\n      emit(\\\\'close\\\\')\\\\n    }\\\\n\\\\n    return () => {\\\\n      if (!visible.value) {\\\\n        return null\\\\n      }\\\\n\\\\n      const { variant, showIcon, closable, banner } = props\\\\n      const classes = cn(\\\\n        alertVariants({ variant }),\\\\n        banner && \\\\'rounded-none border-x-0 border-t-0\\\\',\\\\n        attrs.class as string\\\\n      )\\\\n\\\\n      return (\\\\n        <div class={classes} role=\\\\\\\"alert\\\\\\\">\\\\n          {showIcon && (\\\\n            <div class=\\\\\\\"flex-shrink-0 mt-0.5\\\\\\\">\\\\n              <iconComponent.value size={16} class={iconColor.value} />\\\\n            </div>\\\\n          )}\\\\n          <div class=\\\\\\\"flex-1 min-w-0\\\\\\\">\\\\n            {slots.default?.()}\\\\n          </div>\\\\n          {closable && (\\\\n            <button\\\\n              type=\\\\\\\"button\\\\\\\"\\\\n              class=\\\\\\\"flex-shrink-0 ml-2 text-neutral-400 hover:text-neutral-600 transition-colors\\\\\\\"\\\\n              onClick={handleClose}\\\\n            >\\\\n              <X size={16} />\\\\n            </button>\\\\n          )}\\\\n        </div>\\\\n      )\\\\n    }\\\\n  },\\\\n})\\\\n\\\\nexport const AlertTitle = defineComponent({\\\\n  name: \\\\'AlertTitle\\\\',\\\\n  setup(props, { attrs, slots }) {\\\\n    return () => (\\\\n      <div\\\\n        class={cn(\\\\n          \\\\'font-semibold mb-1\\\\',\\\\n          attrs.class as string\\\\n        )}\\\\n      >\\\\n        {slots.default?.()}\\\\n      </div>\\\\n    )\\\\n  },\\\\n})\\\\n\\\\nexport const AlertDescription = defineComponent({\\\\n  name: \\\\'AlertDescription\\\\',\\\\n  setup(props, { attrs, slots }) {\\\\n    return () => (\\\\n      <div\\\\n        class={cn(\\\\n          \\\\'text-neutral-600\\\\',\\\\n          attrs.class as string\\\\n        )}\\\\n      >\\\\n        {slots.default?.()}\\\\n      </div>\\\\n    )\\\\n  },\\\\n})\\\\n\",\"originAcceptText\":\"/**\\n * @fileoverview YYC³餐饮行业智能化平台 - 警告提示组件\\n * @description 统一的警告提示组件，支持多种样式和操作\\n * @author YYC³\\n * @version 1.0.0\\n * @created 2026-01-21\\n * @copyright Copyright (c) 2026 YYC³\\n * @license MIT\\n */\\n\\nimport { defineComponent, type PropType } from 'vue'\\nimport { cva, type VariantProps } from 'class-variance-authority'\\nimport { cn } from '@/utils/cn'\\nimport { X, CheckCircle, AlertCircle, AlertTriangle, Info } from 'lucide-vue-next'\\n\\nconst alertVariants = cva(\\n  'relative w-full rounded-lg border px-4 py-3 text-sm flex items-start gap-3',\\n  {\\n    variants: {\\n      variant: {\\n        default:\\n          'bg-white border-neutral-200 text-neutral-900',\\n        info:\\n          'bg-blue-50 border-blue-200 text-blue-900',\\n        success:\\n          'bg-green-50 border-green-200 text-green-900',\\n        warning:\\n          'bg-yellow-50 border-yellow-200 text-yellow-900',\\n        danger:\\n          'bg-red-50 border-red-200 text-red-900',\\n      },\\n    },\\n    defaultVariants: {\\n      variant: 'default',\\n    },\\n  }\\n)\\n\\ntype AlertVariants = VariantProps<typeof alertVariants>\\n\\nexport const Alert = defineComponent({\\n  name: 'Alert',\\n  props: {\\n    variant: {\\n      type: String as PropType<AlertVariants['variant']>,\\n      default: 'default',\\n      validator: (value: string) => {\\n        return ['default', 'info', 'success', 'warning', 'danger'].includes(value)\\n      },\\n    },\\n    showIcon: {\\n      type: Boolean,\\n      default: true,\\n    },\\n    closable: {\\n      type: Boolean,\\n      default: false,\\n    },\\n    banner: {\\n      type: Boolean,\\n      default: false,\\n    },\\n  },\\n  emits: ['close'],\\n  setup(props, { emit, attrs, slots }) {\\n    const visible = ref(true)\\n\\n    const iconComponent = computed(() => {\\n      switch (props.variant) {\\n        case 'success':\\n          return CheckCircle\\n        case 'warning':\\n          return AlertTriangle\\n        case 'danger':\\n          return AlertCircle\\n        case 'info':\\n        default:\\n          return Info\\n      }\\n    })\\n\\n    const iconColor = computed(() => {\\n      switch (props.variant) {\\n        case 'success':\\n          return 'text-green-600'\\n        case 'warning':\\n          return 'text-yellow-600'\\n        case 'danger':\\n          return 'text-red-600'\\n        case 'info':\\n        default:\\n          return 'text-blue-600'\\n      }\\n    })\\n\\n    const handleClose = () => {\\n      visible.value = false\\n      emit('close')\\n    }\\n\\n    return () => {\\n      if (!visible.value) {\\n        return null\\n      }\\n\\n      const { variant, showIcon, closable, banner } = props\\n      const classes = cn(\\n        alertVariants({ variant }),\\n        banner && 'rounded-none border-x-0 border-t-0',\\n        attrs.class as string\\n      )\\n\\n      return (\\n        <div class={classes} role=\\\"alert\\\">\\n          {showIcon && (\\n            <div class=\\\"flex-shrink-0 mt-0.5\\\">\\n              <iconComponent.value size={16} class={iconColor.value} />\\n            </div>\\n          )}\\n          <div class=\\\"flex-1 min-w-0\\\">\\n            {slots.default?.()}\\n          </div>\\n          {closable && (\\n            <button\\n              type=\\\"button\\\"\\n              class=\\\"flex-shrink-0 ml-2 text-neutral-400 hover:text-neutral-600 transition-colors\\\"\\n              onClick={handleClose}\\n            >\\n              <X size={16} />\\n            </button>\\n          )}\\n        </div>\\n      )\\n    }\\n  },\\n})\\n\\nexport const AlertTitle = defineComponent({\\n  name: 'AlertTitle',\\n  setup(props, { attrs, slots }) {\\n    return () => (\\n      <div\\n        class={cn(\\n          'font-semibold mb-1',\\n          attrs.class as string\\n        )}\\n      >\\n        {slots.default?.()}\\n      </div>\\n    )\\n  },\\n})\\n\\nexport const AlertDescription = defineComponent({\\n  name: 'AlertDescription',\\n  setup(props, { attrs, slots }) {\\n    return () => (\\n      <div\\n        class={cn(\\n          'text-neutral-600',\\n          attrs.class as string\\n        )}\\n      >\\n        {slots.default?.()}\\n      </div>\\n    )\\n  },\\n})\\n\",\"originTextLength\":3920,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768928492453},{\"originRange\":{\"start\":{\"line\":10,\"character\":0},\"end\":{\"line\":10,\"character\":67}},\"modifyRange\":{\"start\":{\"line\":10,\"character\":0},\"end\":{\"line\":10,\"character\":67}},\"action\":\"None\",\"isLine\":false,\"originText\":\"import { defineComponent, computed, ref, type PropType } from \\\\'vue\\\\'\",\"originAcceptText\":\"import { defineComponent, computed, ref, type PropType } from 'vue'\",\"originTextLength\":67,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768928498895}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/components/UI/Form/index.tsx": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":388,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":388,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"/**\\\\n * @fileoverview YYC³餐饮行业智能化平台 - 表单组件\\\\n * @description 统一的表单组件，支持表单验证和状态管理\\\\n * @author YYC³\\\\n * @version 1.0.0\\\\n * @created 2026-01-21\\\\n * @copyright Copyright (c) 2026 YYC³\\\\n * @license MIT\\\\n */\\\\n\\\\nimport { defineComponent, provide, inject, ref, computed, type PropType, type InjectionKey } from \\\\'vue\\\\'\\\\nimport { cn } from \\\\'@/utils/cn\\\\'\\\\n\\\\nexport interface FormField {\\\\n  name: string\\\\n  value: any\\\\n  error?: string\\\\n  touched?: boolean\\\\n  dirty?: boolean\\\\n  required?: boolean\\\\n  rules?: Array<(value: any) => boolean | string>\\\\n}\\\\n\\\\nexport interface FormContext {\\\\n  fields: Record<string, FormField>\\\\n  values: Record<string, any>\\\\n  errors: Record<string, string>\\\\n  touched: Record<string, boolean>\\\\n  dirty: Record<string, boolean>\\\\n  valid: boolean\\\\n  submitting: boolean\\\\n  registerField: (field: FormField) => void\\\\n  unregisterField: (name: string) => void\\\\n  updateFieldValue: (name: string, value: any) => void\\\\n  setFieldError: (name: string, error: string) => void\\\\n  setFieldTouched: (name: string, touched: boolean) => void\\\\n  validateField: (name: string) => boolean\\\\n  validateAll: () => boolean\\\\n  reset: () => void\\\\n  submit: () => void\\\\n}\\\\n\\\\nconst FORM_KEY: InjectionKey<FormContext> = Symbol(\\\\'form\\\\')\\\\n\\\\nexport const useForm = () => {\\\\n  const form = inject(FORM_KEY)\\\\n  if (!form) {\\\\n    throw new Error(\\\\'useForm must be used within a Form component\\\\')\\\\n  }\\\\n  return form\\\\n}\\\\n\\\\nexport const Form = defineComponent({\\\\n  name: \\\\'Form\\\\',\\\\n  props: {\\\\n    initialValues: {\\\\n      type: Object as PropType<Record<string, any>>,\\\\n      default: () => ({}),\\\\n    },\\\\n    onSubmit: {\\\\n      type: Function as PropType<(values: Record<string, any>) => void | Promise<void>>,\\\\n      default: undefined,\\\\n    },\\\\n    layout: {\\\\n      type: String as PropType<\\\\'vertical\\\\' | \\\\'horizontal\\\\' | \\\\'inline\\\\'>,\\\\n      default: \\\\'vertical\\\\',\\\\n      validator: (value: string) => [\\\\'vertical\\\\', \\\\'horizontal\\\\', \\\\'inline\\\\'].includes(value),\\\\n    },\\\\n    labelWidth: {\\\\n      type: [String, Number] as PropType<string | number>,\\\\n      default: \\\\'auto\\\\',\\\\n    },\\\\n    disabled: {\\\\n      type: Boolean,\\\\n      default: false,\\\\n    },\\\\n  },\\\\n  emits: [\\\\'submit\\\\', \\\\'submit-success\\\\', \\\\'submit-error\\\\'],\\\\n  setup(props, { emit, slots }) {\\\\n    const fields = ref<Record<string, FormField>>({})\\\\n    const submitting = ref(false)\\\\n\\\\n    const values = computed(() => {\\\\n      const result: Record<string, any> = { ...props.initialValues }\\\\n      Object.entries(fields.value).forEach(([name, field]) => {\\\\n        result[name] = field.value\\\\n      })\\\\n      return result\\\\n    })\\\\n\\\\n    const errors = computed(() => {\\\\n      const result: Record<string, string> = {}\\\\n      Object.entries(fields.value).forEach(([name, field]) => {\\\\n        if (field.error) {\\\\n          result[name] = field.error\\\\n        }\\\\n      })\\\\n      return result\\\\n    })\\\\n\\\\n    const touched = computed(() => {\\\\n      const result: Record<string, boolean> = {}\\\\n      Object.entries(fields.value).forEach(([name, field]) => {\\\\n        result[name] = field.touched || false\\\\n      })\\\\n      return result\\\\n    })\\\\n\\\\n    const dirty = computed(() => {\\\\n      const result: Record<string, boolean> = {}\\\\n      Object.entries(fields.value).forEach(([name, field]) => {\\\\n        result[name] = field.dirty || false\\\\n      })\\\\n      return result\\\\n    })\\\\n\\\\n    const valid = computed(() => {\\\\n      return Object.keys(errors.value).length === 0\\\\n    })\\\\n\\\\n    const registerField = (field: FormField) => {\\\\n      fields.value[field.name] = {\\\\n        ...field,\\\\n        value: props.initialValues[field.name] !== undefined ? props.initialValues[field.name] : field.value,\\\\n      }\\\\n    }\\\\n\\\\n    const unregisterField = (name: string) => {\\\\n      delete fields.value[name]\\\\n    }\\\\n\\\\n    const updateFieldValue = (name: string, value: any) => {\\\\n      if (fields.value[name]) {\\\\n        fields.value[name].value = value\\\\n        fields.value[name].dirty = true\\\\n      }\\\\n    }\\\\n\\\\n    const setFieldError = (name: string, error: string) => {\\\\n      if (fields.value[name]) {\\\\n        fields.value[name].error = error\\\\n      }\\\\n    }\\\\n\\\\n    const setFieldTouched = (name: string, touched: boolean) => {\\\\n      if (fields.value[name]) {\\\\n        fields.value[name].touched = touched\\\\n      }\\\\n    }\\\\n\\\\n    const validateField = (name: string): boolean => {\\\\n      const field = fields.value[name]\\\\n      if (!field || !field.rules) {\\\\n        return true\\\\n      }\\\\n\\\\n      for (const rule of field.rules) {\\\\n        const result = rule(field.value)\\\\n        if (result !== true) {\\\\n          setFieldError(name, typeof result === \\\\'string\\\\' ? result : \\\\'验证失败\\\\')\\\\n          return false\\\\n        }\\\\n      }\\\\n\\\\n      setFieldError(name, \\\\'\\\\')\\\\n      return true\\\\n    }\\\\n\\\\n    const validateAll = (): boolean => {\\\\n      let isValid = true\\\\n      Object.keys(fields.value).forEach(name => {\\\\n        if (!validateField(name)) {\\\\n          isValid = false\\\\n        }\\\\n      })\\\\n      return isValid\\\\n    }\\\\n\\\\n    const reset = () => {\\\\n      Object.keys(fields.value).forEach(name => {\\\\n        fields.value[name].value = props.initialValues[name] !== undefined ? props.initialValues[name] : \\\\'\\\\'\\\\n        fields.value[name].error = \\\\'\\\\'\\\\n        fields.value[name].touched = false\\\\n        fields.value[name].dirty = false\\\\n      })\\\\n    }\\\\n\\\\n    const submit = async () => {\\\\n      if (!validateAll()) {\\\\n        return\\\\n      }\\\\n\\\\n      submitting.value = true\\\\n      emit(\\\\'submit\\\\', values.value)\\\\n\\\\n      try {\\\\n        if (props.onSubmit) {\\\\n          await props.onSubmit(values.value)\\\\n          emit(\\\\'submit-success\\\\', values.value)\\\\n        }\\\\n      } catch (error) {\\\\n        emit(\\\\'submit-error\\\\', error)\\\\n      } finally {\\\\n        submitting.value = false\\\\n      }\\\\n    }\\\\n\\\\n    const handleSubmit = (event: Event) => {\\\\n      event.preventDefault()\\\\n      submit()\\\\n    }\\\\n\\\\n    const formContext: FormContext = {\\\\n      fields,\\\\n      values,\\\\n      errors,\\\\n      touched,\\\\n      dirty,\\\\n      valid,\\\\n      submitting,\\\\n      registerField,\\\\n      unregisterField,\\\\n      updateFieldValue,\\\\n      setFieldError,\\\\n      setFieldTouched,\\\\n      validateField,\\\\n      validateAll,\\\\n      reset,\\\\n      submit,\\\\n    }\\\\n\\\\n    provide(FORM_KEY, formContext)\\\\n\\\\n    return () => (\\\\n      <form\\\\n        onSubmit={handleSubmit}\\\\n        class={cn(\\\\n          \\\\'space-y-4\\\\',\\\\n          props.layout === \\\\'inline\\\\' && \\\\'flex flex-wrap items-center gap-4 space-y-0\\\\',\\\\n          props.layout === \\\\'horizontal\\\\' && \\\\'space-y-6\\\\',\\\\n          attrs.class as string\\\\n        )}\\\\n      >\\\\n        {slots.default?.({\\\\n          values: values.value,\\\\n          errors: errors.value,\\\\n          touched: touched.value,\\\\n          dirty: dirty.value,\\\\n          valid: valid.value,\\\\n          submitting: submitting.value,\\\\n          validate: validateAll,\\\\n          reset,\\\\n          submit,\\\\n        })}\\\\n      </form>\\\\n    )\\\\n  },\\\\n})\\\\n\\\\nexport const FormItem = defineComponent({\\\\n  name: \\\\'FormItem\\\\',\\\\n  props: {\\\\n    name: {\\\\n      type: String,\\\\n      required: true,\\\\n    },\\\\n    label: {\\\\n      type: String,\\\\n      default: \\\\'\\\\',\\\\n    },\\\\n    required: {\\\\n      type: Boolean,\\\\n      default: false,\\\\n    },\\\\n    rules: {\\\\n      type: Array as PropType<Array<(value: any) => boolean | string>>,\\\\n      default: () => [],\\\\n    },\\\\n    layout: {\\\\n      type: String as PropType<\\\\'vertical\\\\' | \\\\'horizontal\\\\' | \\\\'inline\\\\'>,\\\\n      default: undefined,\\\\n    },\\\\n    labelWidth: {\\\\n      type: [String, Number] as PropType<string | number>,\\\\n      default: undefined,\\\\n    },\\\\n  },\\\\n  setup(props, { attrs, slots }) {\\\\n    const form = useForm()\\\\n    const id = computed(() => `form-item-${props.name}`)\\\\n\\\\n    const field = computed(() => form.fields[props.name])\\\\n    const error = computed(() => form.errors[props.name])\\\\n    const touched = computed(() => form.touched[props.name])\\\\n    const dirty = computed(() => form.dirty[props.name])\\\\n\\\\n    const layout = computed(() => props.layout || form.layout)\\\\n    const labelWidth = computed(() => props.labelWidth !== undefined ? props.labelWidth : form.labelWidth)\\\\n\\\\n    onMounted(() => {\\\\n      form.registerField({\\\\n        name: props.name,\\\\n        value: \\\\'\\\\',\\\\n        required: props.required,\\\\n        rules: props.rules,\\\\n      })\\\\n    })\\\\n\\\\n    onUnmounted(() => {\\\\n      form.unregisterField(props.name)\\\\n    })\\\\n\\\\n    const handleBlur = () => {\\\\n      form.setFieldTouched(props.name, true)\\\\n      form.validateField(props.name)\\\\n    }\\\\n\\\\n    return () => {\\\\n      const itemLayout = layout.value\\\\n      const itemLabelWidth = labelWidth.value\\\\n\\\\n      return (\\\\n        <div\\\\n          class={cn(\\\\n            \\\\'space-y-2\\\\',\\\\n            itemLayout === \\\\'inline\\\\' && \\\\'flex items-center gap-2 space-y-0\\\\',\\\\n            itemLayout === \\\\'horizontal\\\\' && \\\\'grid grid-cols-[auto_1fr] gap-4 items-start\\\\',\\\\n            attrs.class as string\\\\n          )}\\\\n        >\\\\n          {props.label && (\\\\n            <label\\\\n              for={id.value}\\\\n              class={cn(\\\\n                \\\\'text-sm font-medium text-neutral-700\\\\',\\\\n                itemLayout === \\\\'inline\\\\' && \\\\'whitespace-nowrap\\\\',\\\\n                itemLayout === \\\\'horizontal\\\\' && \\\\'pt-2\\\\',\\\\n                itemLabelWidth !== \\\\'auto\\\\' && \\\\'flex-shrink-0\\\\'\\\\n              )}\\\\n              style={itemLabelWidth !== \\\\'auto\\\\' ? { width: typeof itemLabelWidth === \\\\'number\\\\' ? `${itemLabelWidth}px` : itemLabelWidth } : {}}\\\\n            >\\\\n              {props.label}\\\\n              {props.required && <span class=\\\\\\\"text-danger-500 ml-1\\\\\\\">*</span>}\\\\n            </label>\\\\n          )}\\\\n          <div class={cn(\\\\'flex-1\\\\', itemLayout === \\\\'horizontal\\\\' && \\\\'min-w-0\\\\')}>\\\\n            {slots.default?.({\\\\n              id: id.value,\\\\n              name: props.name,\\\\n              value: field.value?.value,\\\\n              error: error.value,\\\\n              touched: touched.value,\\\\n              dirty: dirty.value,\\\\n              onBlur: handleBlur,\\\\n            })}\\\\n            {error.value && touched.value && (\\\\n              <p class=\\\\\\\"mt-1 text-sm text-danger-600\\\\\\\">\\\\n                {error.value}\\\\n              </p>\\\\n            )}\\\\n            {slots.description?.()}\\\\n          </div>\\\\n        </div>\\\\n      )\\\\n    }\\\\n  },\\\\n})\\\\n\\\\nexport const FormLabel = defineComponent({\\\\n  name: \\\\'FormLabel\\\\',\\\\n  props: {\\\\n    for: {\\\\n      type: String,\\\\n      default: \\\\'\\\\',\\\\n    },\\\\n    required: {\\\\n      type: Boolean,\\\\n      default: false,\\\\n    },\\\\n  },\\\\n  setup(props, { attrs, slots }) {\\\\n    return () => (\\\\n      <label\\\\n        for={props.for}\\\\n        class={cn(\\\\n          \\\\'block text-sm font-medium text-neutral-700 mb-1\\\\',\\\\n          attrs.class as string\\\\n        )}\\\\n      >\\\\n        {slots.default?.()}\\\\n        {props.required && <span class=\\\\\\\"text-danger-500 ml-1\\\\\\\">*</span>}\\\\n      </label>\\\\n    )\\\\n  },\\\\n})\\\\n\\\\nexport const FormDescription = defineComponent({\\\\n  name: \\\\'FormDescription\\\\',\\\\n  setup(props, { attrs, slots }) {\\\\n    return () => (\\\\n      <p\\\\n        class={cn(\\\\n          \\\\'text-sm text-neutral-600 mt-1\\\\',\\\\n          attrs.class as string\\\\n        )}\\\\n      >\\\\n        {slots.default?.()}\\\\n      </p>\\\\n    )\\\\n  },\\\\n})\\\\n\\\\nexport const FormMessage = defineComponent({\\\\n  name: \\\\'FormMessage\\\\',\\\\n  setup(props, { attrs, slots }) {\\\\n    return () => (\\\\n      <p\\\\n        class={cn(\\\\n          \\\\'text-sm text-danger-600 mt-1\\\\',\\\\n          attrs.class as string\\\\n        )}\\\\n      >\\\\n        {slots.default?.()}\\\\n      </p>\\\\n    )\\\\n  },\\\\n})\\\\n\",\"originAcceptText\":\"/**\\n * @fileoverview YYC³餐饮行业智能化平台 - 表单组件\\n * @description 统一的表单组件，支持表单验证和状态管理\\n * @author YYC³\\n * @version 1.0.0\\n * @created 2026-01-21\\n * @copyright Copyright (c) 2026 YYC³\\n * @license MIT\\n */\\n\\nimport { defineComponent, provide, inject, ref, computed, type PropType, type InjectionKey } from 'vue'\\nimport { cn } from '@/utils/cn'\\n\\nexport interface FormField {\\n  name: string\\n  value: any\\n  error?: string\\n  touched?: boolean\\n  dirty?: boolean\\n  required?: boolean\\n  rules?: Array<(value: any) => boolean | string>\\n}\\n\\nexport interface FormContext {\\n  fields: Record<string, FormField>\\n  values: Record<string, any>\\n  errors: Record<string, string>\\n  touched: Record<string, boolean>\\n  dirty: Record<string, boolean>\\n  valid: boolean\\n  submitting: boolean\\n  registerField: (field: FormField) => void\\n  unregisterField: (name: string) => void\\n  updateFieldValue: (name: string, value: any) => void\\n  setFieldError: (name: string, error: string) => void\\n  setFieldTouched: (name: string, touched: boolean) => void\\n  validateField: (name: string) => boolean\\n  validateAll: () => boolean\\n  reset: () => void\\n  submit: () => void\\n}\\n\\nconst FORM_KEY: InjectionKey<FormContext> = Symbol('form')\\n\\nexport const useForm = () => {\\n  const form = inject(FORM_KEY)\\n  if (!form) {\\n    throw new Error('useForm must be used within a Form component')\\n  }\\n  return form\\n}\\n\\nexport const Form = defineComponent({\\n  name: 'Form',\\n  props: {\\n    initialValues: {\\n      type: Object as PropType<Record<string, any>>,\\n      default: () => ({}),\\n    },\\n    onSubmit: {\\n      type: Function as PropType<(values: Record<string, any>) => void | Promise<void>>,\\n      default: undefined,\\n    },\\n    layout: {\\n      type: String as PropType<'vertical' | 'horizontal' | 'inline'>,\\n      default: 'vertical',\\n      validator: (value: string) => ['vertical', 'horizontal', 'inline'].includes(value),\\n    },\\n    labelWidth: {\\n      type: [String, Number] as PropType<string | number>,\\n      default: 'auto',\\n    },\\n    disabled: {\\n      type: Boolean,\\n      default: false,\\n    },\\n  },\\n  emits: ['submit', 'submit-success', 'submit-error'],\\n  setup(props, { emit, slots }) {\\n    const fields = ref<Record<string, FormField>>({})\\n    const submitting = ref(false)\\n\\n    const values = computed(() => {\\n      const result: Record<string, any> = { ...props.initialValues }\\n      Object.entries(fields.value).forEach(([name, field]) => {\\n        result[name] = field.value\\n      })\\n      return result\\n    })\\n\\n    const errors = computed(() => {\\n      const result: Record<string, string> = {}\\n      Object.entries(fields.value).forEach(([name, field]) => {\\n        if (field.error) {\\n          result[name] = field.error\\n        }\\n      })\\n      return result\\n    })\\n\\n    const touched = computed(() => {\\n      const result: Record<string, boolean> = {}\\n      Object.entries(fields.value).forEach(([name, field]) => {\\n        result[name] = field.touched || false\\n      })\\n      return result\\n    })\\n\\n    const dirty = computed(() => {\\n      const result: Record<string, boolean> = {}\\n      Object.entries(fields.value).forEach(([name, field]) => {\\n        result[name] = field.dirty || false\\n      })\\n      return result\\n    })\\n\\n    const valid = computed(() => {\\n      return Object.keys(errors.value).length === 0\\n    })\\n\\n    const registerField = (field: FormField) => {\\n      fields.value[field.name] = {\\n        ...field,\\n        value: props.initialValues[field.name] !== undefined ? props.initialValues[field.name] : field.value,\\n      }\\n    }\\n\\n    const unregisterField = (name: string) => {\\n      delete fields.value[name]\\n    }\\n\\n    const updateFieldValue = (name: string, value: any) => {\\n      if (fields.value[name]) {\\n        fields.value[name].value = value\\n        fields.value[name].dirty = true\\n      }\\n    }\\n\\n    const setFieldError = (name: string, error: string) => {\\n      if (fields.value[name]) {\\n        fields.value[name].error = error\\n      }\\n    }\\n\\n    const setFieldTouched = (name: string, touched: boolean) => {\\n      if (fields.value[name]) {\\n        fields.value[name].touched = touched\\n      }\\n    }\\n\\n    const validateField = (name: string): boolean => {\\n      const field = fields.value[name]\\n      if (!field || !field.rules) {\\n        return true\\n      }\\n\\n      for (const rule of field.rules) {\\n        const result = rule(field.value)\\n        if (result !== true) {\\n          setFieldError(name, typeof result === 'string' ? result : '验证失败')\\n          return false\\n        }\\n      }\\n\\n      setFieldError(name, '')\\n      return true\\n    }\\n\\n    const validateAll = (): boolean => {\\n      let isValid = true\\n      Object.keys(fields.value).forEach(name => {\\n        if (!validateField(name)) {\\n          isValid = false\\n        }\\n      })\\n      return isValid\\n    }\\n\\n    const reset = () => {\\n      Object.keys(fields.value).forEach(name => {\\n        fields.value[name].value = props.initialValues[name] !== undefined ? props.initialValues[name] : ''\\n        fields.value[name].error = ''\\n        fields.value[name].touched = false\\n        fields.value[name].dirty = false\\n      })\\n    }\\n\\n    const submit = async () => {\\n      if (!validateAll()) {\\n        return\\n      }\\n\\n      submitting.value = true\\n      emit('submit', values.value)\\n\\n      try {\\n        if (props.onSubmit) {\\n          await props.onSubmit(values.value)\\n          emit('submit-success', values.value)\\n        }\\n      } catch (error) {\\n        emit('submit-error', error)\\n      } finally {\\n        submitting.value = false\\n      }\\n    }\\n\\n    const handleSubmit = (event: Event) => {\\n      event.preventDefault()\\n      submit()\\n    }\\n\\n    const formContext: FormContext = {\\n      fields,\\n      values,\\n      errors,\\n      touched,\\n      dirty,\\n      valid,\\n      submitting,\\n      registerField,\\n      unregisterField,\\n      updateFieldValue,\\n      setFieldError,\\n      setFieldTouched,\\n      validateField,\\n      validateAll,\\n      reset,\\n      submit,\\n    }\\n\\n    provide(FORM_KEY, formContext)\\n\\n    return () => (\\n      <form\\n        onSubmit={handleSubmit}\\n        class={cn(\\n          'space-y-4',\\n          props.layout === 'inline' && 'flex flex-wrap items-center gap-4 space-y-0',\\n          props.layout === 'horizontal' && 'space-y-6',\\n          attrs.class as string\\n        )}\\n      >\\n        {slots.default?.({\\n          values: values.value,\\n          errors: errors.value,\\n          touched: touched.value,\\n          dirty: dirty.value,\\n          valid: valid.value,\\n          submitting: submitting.value,\\n          validate: validateAll,\\n          reset,\\n          submit,\\n        })}\\n      </form>\\n    )\\n  },\\n})\\n\\nexport const FormItem = defineComponent({\\n  name: 'FormItem',\\n  props: {\\n    name: {\\n      type: String,\\n      required: true,\\n    },\\n    label: {\\n      type: String,\\n      default: '',\\n    },\\n    required: {\\n      type: Boolean,\\n      default: false,\\n    },\\n    rules: {\\n      type: Array as PropType<Array<(value: any) => boolean | string>>,\\n      default: () => [],\\n    },\\n    layout: {\\n      type: String as PropType<'vertical' | 'horizontal' | 'inline'>,\\n      default: undefined,\\n    },\\n    labelWidth: {\\n      type: [String, Number] as PropType<string | number>,\\n      default: undefined,\\n    },\\n  },\\n  setup(props, { attrs, slots }) {\\n    const form = useForm()\\n    const id = computed(() => `form-item-${props.name}`)\\n\\n    const field = computed(() => form.fields[props.name])\\n    const error = computed(() => form.errors[props.name])\\n    const touched = computed(() => form.touched[props.name])\\n    const dirty = computed(() => form.dirty[props.name])\\n\\n    const layout = computed(() => props.layout || form.layout)\\n    const labelWidth = computed(() => props.labelWidth !== undefined ? props.labelWidth : form.labelWidth)\\n\\n    onMounted(() => {\\n      form.registerField({\\n        name: props.name,\\n        value: '',\\n        required: props.required,\\n        rules: props.rules,\\n      })\\n    })\\n\\n    onUnmounted(() => {\\n      form.unregisterField(props.name)\\n    })\\n\\n    const handleBlur = () => {\\n      form.setFieldTouched(props.name, true)\\n      form.validateField(props.name)\\n    }\\n\\n    return () => {\\n      const itemLayout = layout.value\\n      const itemLabelWidth = labelWidth.value\\n\\n      return (\\n        <div\\n          class={cn(\\n            'space-y-2',\\n            itemLayout === 'inline' && 'flex items-center gap-2 space-y-0',\\n            itemLayout === 'horizontal' && 'grid grid-cols-[auto_1fr] gap-4 items-start',\\n            attrs.class as string\\n          )}\\n        >\\n          {props.label && (\\n            <label\\n              for={id.value}\\n              class={cn(\\n                'text-sm font-medium text-neutral-700',\\n                itemLayout === 'inline' && 'whitespace-nowrap',\\n                itemLayout === 'horizontal' && 'pt-2',\\n                itemLabelWidth !== 'auto' && 'flex-shrink-0'\\n              )}\\n              style={itemLabelWidth !== 'auto' ? { width: typeof itemLabelWidth === 'number' ? `${itemLabelWidth}px` : itemLabelWidth } : {}}\\n            >\\n              {props.label}\\n              {props.required && <span class=\\\"text-danger-500 ml-1\\\">*</span>}\\n            </label>\\n          )}\\n          <div class={cn('flex-1', itemLayout === 'horizontal' && 'min-w-0')}>\\n            {slots.default?.({\\n              id: id.value,\\n              name: props.name,\\n              value: field.value?.value,\\n              error: error.value,\\n              touched: touched.value,\\n              dirty: dirty.value,\\n              onBlur: handleBlur,\\n            })}\\n            {error.value && touched.value && (\\n              <p class=\\\"mt-1 text-sm text-danger-600\\\">\\n                {error.value}\\n              </p>\\n            )}\\n            {slots.description?.()}\\n          </div>\\n        </div>\\n      )\\n    }\\n  },\\n})\\n\\nexport const FormLabel = defineComponent({\\n  name: 'FormLabel',\\n  props: {\\n    for: {\\n      type: String,\\n      default: '',\\n    },\\n    required: {\\n      type: Boolean,\\n      default: false,\\n    },\\n  },\\n  setup(props, { attrs, slots }) {\\n    return () => (\\n      <label\\n        for={props.for}\\n        class={cn(\\n          'block text-sm font-medium text-neutral-700 mb-1',\\n          attrs.class as string\\n        )}\\n      >\\n        {slots.default?.()}\\n        {props.required && <span class=\\\"text-danger-500 ml-1\\\">*</span>}\\n      </label>\\n    )\\n  },\\n})\\n\\nexport const FormDescription = defineComponent({\\n  name: 'FormDescription',\\n  setup(props, { attrs, slots }) {\\n    return () => (\\n      <p\\n        class={cn(\\n          'text-sm text-neutral-600 mt-1',\\n          attrs.class as string\\n        )}\\n      >\\n        {slots.default?.()}\\n      </p>\\n    )\\n  },\\n})\\n\\nexport const FormMessage = defineComponent({\\n  name: 'FormMessage',\\n  setup(props, { attrs, slots }) {\\n    return () => (\\n      <p\\n        class={cn(\\n          'text-sm text-danger-600 mt-1',\\n          attrs.class as string\\n        )}\\n      >\\n        {slots.default?.()}\\n      </p>\\n    )\\n  },\\n})\\n\",\"originTextLength\":10928,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768928575904}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/components/UI/Select/index.tsx": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":397,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":397,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"/**\\\\n * @fileoverview YYC³餐饮行业智能化平台 - 选择器组件\\\\n * @description 统一的选择器组件，支持单选、多选和分组\\\\n * @author YYC³\\\\n * @version 1.0.0\\\\n * @created 2026-01-21\\\\n * @copyright Copyright (c) 2026 YYC³\\\\n * @license MIT\\\\n */\\\\n\\\\nimport { defineComponent, ref, computed, watch, type PropType } from \\\\'vue\\\\'\\\\nimport { cn } from \\\\'@/utils/cn\\\\'\\\\nimport { ChevronDown, ChevronUp, Check, Search } from \\\\'lucide-vue-next\\\\'\\\\n\\\\nexport interface SelectOption {\\\\n  label: string\\\\n  value: string | number\\\\n  disabled?: boolean\\\\n  group?: string\\\\n  children?: SelectOption[]\\\\n}\\\\n\\\\nexport const Select = defineComponent({\\\\n  name: \\\\'Select\\\\',\\\\n  props: {\\\\n    modelValue: {\\\\n      type: [String, Number, Array] as PropType<string | number | (string | number)[]>,\\\\n      default: \\\\'\\\\',\\\\n    },\\\\n    options: {\\\\n      type: Array as PropType<SelectOption[]>,\\\\n      default: () => [],\\\\n    },\\\\n    placeholder: {\\\\n      type: String,\\\\n      default: \\\\'请选择\\\\',\\\\n    },\\\\n    disabled: {\\\\n      type: Boolean,\\\\n      default: false,\\\\n    },\\\\n    readonly: {\\\\n      type: Boolean,\\\\n      default: false,\\\\n    },\\\\n    multiple: {\\\\n      type: Boolean,\\\\n      default: false,\\\\n    },\\\\n    searchable: {\\\\n      type: Boolean,\\\\n      default: false,\\\\n    },\\\\n    clearable: {\\\\n      type: Boolean,\\\\n      default: false,\\\\n    },\\\\n    filterable: {\\\\n      type: Boolean,\\\\n      default: false,\\\\n    },\\\\n    size: {\\\\n      type: String as PropType<\\\\'sm\\\\' | \\\\'md\\\\' | \\\\'lg\\\\'>,\\\\n      default: \\\\'md\\\\',\\\\n      validator: (value: string) => [\\\\'sm\\\\', \\\\'md\\\\', \\\\'lg\\\\'].includes(value),\\\\n    },\\\\n    loading: {\\\\n      type: Boolean,\\\\n      default: false,\\\\n    },\\\\n    remote: {\\\\n      type: Boolean,\\\\n      default: false,\\\\n    },\\\\n    remoteMethod: {\\\\n      type: Function as PropType<(query: string) => void>,\\\\n      default: undefined,\\\\n    },\\\\n    maxTagCount: {\\\\n      type: Number,\\\\n      default: undefined,\\\\n    },\\\\n  },\\\\n  emits: [\\\\'update:modelValue\\\\', \\\\'change\\\\', \\\\'clear\\\\', \\\\'visible-change\\\\', \\\\'remove-tag\\\\'],\\\\n  setup(props, { emit }) {\\\\n    const visible = ref(false)\\\\n    const searchQuery = ref(\\\\'\\\\')\\\\n    const highlightedIndex = ref(-1)\\\\n    const selectRef = ref<HTMLElement>()\\\\n    const dropdownRef = ref<HTMLElement>()\\\\n\\\\n    const filteredOptions = computed(() => {\\\\n      if (!props.filterable && !props.searchable) {\\\\n        return props.options\\\\n      }\\\\n\\\\n      const query = searchQuery.value.toLowerCase()\\\\n      return props.options.filter(option => {\\\\n        if (option.children) {\\\\n          return option.children.some(child => \\\\n            child.label.toLowerCase().includes(query)\\\\n          )\\\\n        }\\\\n        return option.label.toLowerCase().includes(query)\\\\n      })\\\\n    })\\\\n\\\\n    const selectedOptions = computed(() => {\\\\n      if (props.multiple && Array.isArray(props.modelValue)) {\\\\n        return props.options.filter(option => \\\\n          props.modelValue.includes(option.value)\\\\n        )\\\\n      }\\\\n      const option = props.options.find(option => option.value === props.modelValue)\\\\n      return option ? [option] : []\\\\n    })\\\\n\\\\n    const displayValue = computed(() => {\\\\n      if (props.multiple && Array.isArray(props.modelValue)) {\\\\n        if (props.modelValue.length === 0) {\\\\n          return props.placeholder\\\\n        }\\\\n        if (props.maxTagCount !== undefined && props.modelValue.length > props.maxTagCount) {\\\\n          return `+${props.modelValue.length - props.maxTagCount}`\\\\n        }\\\\n        return selectedOptions.value.map(opt => opt.label).join(\\\\', \\\\')\\\\n      }\\\\n      const option = props.options.find(opt => opt.value === props.modelValue)\\\\n      return option ? option.label : props.placeholder\\\\n    })\\\\n\\\\n    const sizeClasses = computed(() => {\\\\n      switch (props.size) {\\\\n        case \\\\'sm\\\\':\\\\n          return \\\\'h-8 px-2 py-1 text-sm\\\\'\\\\n        case \\\\'lg\\\\':\\\\n          return \\\\'h-12 px-4 py-3 text-lg\\\\'\\\\n        default:\\\\n          return \\\\'h-10 px-3 py-2 text-base\\\\'\\\\n      }\\\\n    })\\\\n\\\\n    const toggleDropdown = () => {\\\\n      if (props.disabled || props.readonly) {\\\\n        return\\\\n      }\\\\n      visible.value = !visible.value\\\\n      emit(\\\\'visible-change\\\\', visible.value)\\\\n    }\\\\n\\\\n    const closeDropdown = () => {\\\\n      visible.value = false\\\\n      searchQuery.value = \\\\'\\\\'\\\\n      highlightedIndex.value = -1\\\\n      emit(\\\\'visible-change\\\\', false)\\\\n    }\\\\n\\\\n    const selectOption = (option: SelectOption) => {\\\\n      if (option.disabled) {\\\\n        return\\\\n      }\\\\n\\\\n      if (props.multiple) {\\\\n        const currentValue = Array.isArray(props.modelValue) ? [...props.modelValue] : []\\\\n        const index = currentValue.indexOf(option.value)\\\\n        if (index > -1) {\\\\n          currentValue.splice(index, 1)\\\\n        } else {\\\\n          currentValue.push(option.value)\\\\n        }\\\\n        emit(\\\\'update:modelValue\\\\', currentValue)\\\\n        emit(\\\\'change\\\\', currentValue)\\\\n      } else {\\\\n        emit(\\\\'update:modelValue\\\\', option.value)\\\\n        emit(\\\\'change\\\\', option.value)\\\\n        closeDropdown()\\\\n      }\\\\n    }\\\\n\\\\n    const handleClear = (event: Event) => {\\\\n      event.stopPropagation()\\\\n      if (props.multiple) {\\\\n        emit(\\\\'update:modelValue\\\\', [])\\\\n        emit(\\\\'change\\\\', [])\\\\n      } else {\\\\n        emit(\\\\'update:modelValue\\\\', \\\\'\\\\')\\\\n        emit(\\\\'change\\\\', \\\\'\\\\')\\\\n      }\\\\n      emit(\\\\'clear\\\\')\\\\n    }\\\\n\\\\n    const handleSearch = (value: string) => {\\\\n      searchQuery.value = value\\\\n      if (props.remote && props.remoteMethod) {\\\\n        props.remoteMethod(value)\\\\n      }\\\\n    }\\\\n\\\\n    const handleRemoveTag = (value: string | number, event: Event) => {\\\\n      event.stopPropagation()\\\\n      const currentValue = Array.isArray(props.modelValue) ? [...props.modelValue] : []\\\\n      const index = currentValue.indexOf(value)\\\\n      if (index > -1) {\\\\n        currentValue.splice(index, 1)\\\\n        emit(\\\\'update:modelValue\\\\', currentValue)\\\\n        emit(\\\\'remove-tag\\\\', value)\\\\n      }\\\\n    }\\\\n\\\\n    const isSelected = (option: SelectOption) => {\\\\n      if (props.multiple && Array.isArray(props.modelValue)) {\\\\n        return props.modelValue.includes(option.value)\\\\n      }\\\\n      return props.modelValue === option.value\\\\n    }\\\\n\\\\n    const isHighlighted = (index: number) => {\\\\n      return highlightedIndex.value === index\\\\n    }\\\\n\\\\n    const getOptionGroups = () => {\\\\n      const groups: Record<string, SelectOption[]> = {}\\\\n      filteredOptions.value.forEach(option => {\\\\n        if (option.group) {\\\\n          if (!groups[option.group]) {\\\\n            groups[option.group] = []\\\\n          }\\\\n          groups[option.group].push(option)\\\\n        } else if (option.children) {\\\\n          option.children.forEach(child => {\\\\n            if (!groups[option.label]) {\\\\n              groups[option.label] = []\\\\n            }\\\\n            groups[option.label].push(child)\\\\n          })\\\\n        }\\\\n      })\\\\n      return groups\\\\n    }\\\\n\\\\n    const getUngroupedOptions = () => {\\\\n      return filteredOptions.value.filter(option => !option.group && !option.children)\\\\n    }\\\\n\\\\n    const handleKeydown = (event: KeyboardEvent) => {\\\\n      switch (event.key) {\\\\n        case \\\\'ArrowDown\\\\':\\\\n          event.preventDefault()\\\\n          highlightedIndex.value = Math.min(highlightedIndex.value + 1, filteredOptions.value.length - 1)\\\\n          break\\\\n        case \\\\'ArrowUp\\\\':\\\\n          event.preventDefault()\\\\n          highlightedIndex.value = Math.max(highlightedIndex.value - 1, 0)\\\\n          break\\\\n        case \\\\'Enter\\\\':\\\\n          event.preventDefault()\\\\n          if (highlightedIndex.value >= 0 && highlightedIndex.value < filteredOptions.value.length) {\\\\n            selectOption(filteredOptions.value[highlightedIndex.value])\\\\n          }\\\\n          break\\\\n        case \\\\'Escape\\\\':\\\\n          closeDropdown()\\\\n          break\\\\n      }\\\\n    }\\\\n\\\\n    watch(() => props.modelValue, () => {\\\\n      if (!visible.value) {\\\\n        return\\\\n      }\\\\n      if (props.multiple && Array.isArray(props.modelValue)) {\\\\n        highlightedIndex.value = -1\\\\n      }\\\\n    })\\\\n\\\\n    return () => (\\\\n      <div ref={selectRef} class=\\\\\\\"relative w-full\\\\\\\">\\\\n        <div\\\\n          class={cn(\\\\n            \\\\'flex items-center justify-between w-full rounded-lg border bg-white cursor-pointer transition-all duration-200 outline-none focus:outline-none focus:ring-2 focus:ring-offset-2\\\\',\\\\n            sizeClasses.value,\\\\n            props.disabled ? \\\\'opacity-50 cursor-not-allowed pointer-events-none\\\\' : \\\\'\\\\',\\\\n            props.readonly ? \\\\'cursor-default\\\\' : \\\\'\\\\',\\\\n            visible.value ? \\\\'border-primary-500 ring-primary-500/50\\\\' : \\\\'border-neutral-300 focus:border-primary-500 focus:ring-primary-500/50\\\\'\\\\n          )}\\\\n          onClick={toggleDropdown}\\\\n          onKeydown={handleKeydown}\\\\n          tabindex={props.disabled ? -1 : 0}\\\\n        >\\\\n          <div class=\\\\\\\"flex-1 min-w-0 flex items-center gap-2\\\\\\\">\\\\n            {props.multiple && Array.isArray(props.modelValue) && props.modelValue.length > 0 ? (\\\\n              <div class=\\\\\\\"flex items-center gap-1 flex-wrap\\\\\\\">\\\\n                {selectedOptions.value.slice(0, props.maxTagCount).map(option => (\\\\n                  <span\\\\n                    key={option.value}\\\\n                    class=\\\\\\\"inline-flex items-center gap-1 px-2 py-0.5 bg-primary-100 text-primary-700 rounded text-xs\\\\\\\"\\\\n                  >\\\\n                    {option.label}\\\\n                    {!props.disabled && !props.readonly && (\\\\n                      <button\\\\n                        type=\\\\\\\"button\\\\\\\"\\\\n                        class=\\\\\\\"hover:text-primary-900\\\\\\\"\\\\n                        onClick={(e: Event) => handleRemoveTag(option.value, e)}\\\\n                      >\\\\n                        ×\\\\n                      </button>\\\\n                    )}\\\\n                  </span>\\\\n                ))}\\\\n                {props.maxTagCount !== undefined && selectedOptions.value.length > props.maxTagCount && (\\\\n                  <span class=\\\\\\\"text-neutral-500 text-xs\\\\\\\">\\\\n                    +{selectedOptions.value.length - props.maxTagCount}\\\\n                  </span>\\\\n                )}\\\\n              </div>\\\\n            ) : (\\\\n              <span class={cn(\\\\'truncate\\\\', !props.modelValue && \\\\'text-neutral-400\\\\')}>\\\\n                {displayValue.value}\\\\n              </span>\\\\n            )}\\\\n          </div>\\\\n          <div class=\\\\\\\"flex items-center gap-1\\\\\\\">\\\\n            {props.clearable && props.modelValue && !props.disabled && !props.readonly && (\\\\n              <button\\\\n                type=\\\\\\\"button\\\\\\\"\\\\n                class=\\\\\\\"text-neutral-400 hover:text-neutral-600 transition-colors\\\\\\\"\\\\n                onClick={handleClear}\\\\n              >\\\\n                ×\\\\n              </button>\\\\n            )}\\\\n            {visible.value ? (\\\\n              <ChevronUp size={16} class=\\\\\\\"text-neutral-400\\\\\\\" />\\\\n            ) : (\\\\n              <ChevronDown size={16} class=\\\\\\\"text-neutral-400\\\\\\\" />\\\\n            )}\\\\n          </div>\\\\n        </div>\\\\n\\\\n        {visible.value && (\\\\n          <div\\\\n            ref={dropdownRef}\\\\n            class={cn(\\\\n              \\\\'absolute z-50 w-full mt-1 bg-white border border-neutral-200 rounded-lg shadow-lg max-h-60 overflow-auto\\\\',\\\\n              \\\\'animate-in fade-in zoom-in-95 duration-200\\\\'\\\\n            )}\\\\n          >\\\\n            {props.searchable && (\\\\n              <div class=\\\\\\\"p-2 border-b border-neutral-200\\\\\\\">\\\\n                <div class=\\\\\\\"relative\\\\\\\">\\\\n                  <Search size={16} class=\\\\\\\"absolute left-3 top-1/2 -translate-y-1/2 text-neutral-400\\\\\\\" />\\\\n                  <input\\\\n                    type=\\\\\\\"text\\\\\\\"\\\\n                    value={searchQuery.value}\\\\n                    onInput={(e: Event) => handleSearch((e.target as HTMLInputElement).value)}\\\\n                    placeholder=\\\\\\\"搜索...\\\\\\\"\\\\n                    class=\\\\\\\"w-full pl-9 pr-3 py-2 border border-neutral-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent text-sm\\\\\\\"\\\\n                  />\\\\n                </div>\\\\n              </div>\\\\n            )}\\\\n\\\\n            {props.loading ? (\\\\n              <div class=\\\\\\\"flex items-center justify-center py-8\\\\\\\">\\\\n                <svg class=\\\\\\\"animate-spin h-6 w-6 text-primary-600\\\\\\\" xmlns=\\\\\\\"http://www.w3.org/2000/svg\\\\\\\" fill=\\\\\\\"none\\\\\\\" viewBox=\\\\\\\"0 0 24 24\\\\\\\">\\\\n                  <circle class=\\\\\\\"opacity-25\\\\\\\" cx=\\\\\\\"12\\\\\\\" cy=\\\\\\\"12\\\\\\\" r=\\\\\\\"10\\\\\\\" stroke=\\\\\\\"currentColor\\\\\\\" strokeWidth=\\\\\\\"4\\\\\\\"></circle>\\\\n                  <path class=\\\\\\\"opacity-75\\\\\\\" fill=\\\\\\\"currentColor\\\\\\\" d=\\\\\\\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\\\\\\\"></path>\\\\n                </svg>\\\\n              </div>\\\\n            ) : (\\\\n              <div class=\\\\\\\"py-1\\\\\\\">\\\\n                {Object.entries(getOptionGroups()).map(([groupName, options]) => (\\\\n                  <div key={groupName}>\\\\n                    <div class=\\\\\\\"px-3 py-2 text-xs font-semibold text-neutral-500 bg-neutral-50\\\\\\\">\\\\n                      {groupName}\\\\n                    </div>\\\\n                    {options.map((option, index) => (\\\\n                      <div\\\\n                        key={option.value}\\\\n                        class={cn(\\\\n                          \\\\'px-3 py-2 cursor-pointer transition-colors flex items-center justify-between\\\\',\\\\n                          option.disabled ? \\\\'opacity-50 cursor-not-allowed\\\\' : \\\\'hover:bg-neutral-100\\\\',\\\\n                          isSelected(option) && \\\\'bg-primary-50 text-primary-700\\\\',\\\\n                          isHighlighted(index) && \\\\'bg-neutral-100\\\\'\\\\n                        )}\\\\n                        onClick={() => !option.disabled && selectOption(option)}\\\\n                      >\\\\n                        <span>{option.label}</span>\\\\n                        {isSelected(option) && <Check size={16} />}\\\\n                      </div>\\\\n                    ))}\\\\n                  </div>\\\\n                ))}\\\\n                {getUngroupedOptions().map((option, index) => (\\\\n                  <div\\\\n                    key={option.value}\\\\n                    class={cn(\\\\n                      \\\\'px-3 py-2 cursor-pointer transition-colors flex items-center justify-between\\\\',\\\\n                      option.disabled ? \\\\'opacity-50 cursor-not-allowed\\\\' : \\\\'hover:bg-neutral-100\\\\',\\\\n                      isSelected(option) && \\\\'bg-primary-50 text-primary-700\\\\',\\\\n                      isHighlighted(index) && \\\\'bg-neutral-100\\\\'\\\\n                    )}\\\\n                    onClick={() => !option.disabled && selectOption(option)}\\\\n                  >\\\\n                    <span>{option.label}</span>\\\\n                    {isSelected(option) && <Check size={16} />}\\\\n                  </div>\\\\n                ))}\\\\n                {filteredOptions.value.length === 0 && (\\\\n                  <div class=\\\\\\\"px-3 py-8 text-center text-neutral-500 text-sm\\\\\\\">\\\\n                    无数据\\\\n                  </div>\\\\n                )}\\\\n              </div>\\\\n            )}\\\\n          </div>\\\\n        )}\\\\n      </div>\\\\n    )\\\\n  },\\\\n})\\\\n\",\"originAcceptText\":\"/**\\n * @fileoverview YYC³餐饮行业智能化平台 - 选择器组件\\n * @description 统一的选择器组件，支持单选、多选和分组\\n * @author YYC³\\n * @version 1.0.0\\n * @created 2026-01-21\\n * @copyright Copyright (c) 2026 YYC³\\n * @license MIT\\n */\\n\\nimport { defineComponent, ref, computed, watch, type PropType } from 'vue'\\nimport { cn } from '@/utils/cn'\\nimport { ChevronDown, ChevronUp, Check, Search } from 'lucide-vue-next'\\n\\nexport interface SelectOption {\\n  label: string\\n  value: string | number\\n  disabled?: boolean\\n  group?: string\\n  children?: SelectOption[]\\n}\\n\\nexport const Select = defineComponent({\\n  name: 'Select',\\n  props: {\\n    modelValue: {\\n      type: [String, Number, Array] as PropType<string | number | (string | number)[]>,\\n      default: '',\\n    },\\n    options: {\\n      type: Array as PropType<SelectOption[]>,\\n      default: () => [],\\n    },\\n    placeholder: {\\n      type: String,\\n      default: '请选择',\\n    },\\n    disabled: {\\n      type: Boolean,\\n      default: false,\\n    },\\n    readonly: {\\n      type: Boolean,\\n      default: false,\\n    },\\n    multiple: {\\n      type: Boolean,\\n      default: false,\\n    },\\n    searchable: {\\n      type: Boolean,\\n      default: false,\\n    },\\n    clearable: {\\n      type: Boolean,\\n      default: false,\\n    },\\n    filterable: {\\n      type: Boolean,\\n      default: false,\\n    },\\n    size: {\\n      type: String as PropType<'sm' | 'md' | 'lg'>,\\n      default: 'md',\\n      validator: (value: string) => ['sm', 'md', 'lg'].includes(value),\\n    },\\n    loading: {\\n      type: Boolean,\\n      default: false,\\n    },\\n    remote: {\\n      type: Boolean,\\n      default: false,\\n    },\\n    remoteMethod: {\\n      type: Function as PropType<(query: string) => void>,\\n      default: undefined,\\n    },\\n    maxTagCount: {\\n      type: Number,\\n      default: undefined,\\n    },\\n  },\\n  emits: ['update:modelValue', 'change', 'clear', 'visible-change', 'remove-tag'],\\n  setup(props, { emit }) {\\n    const visible = ref(false)\\n    const searchQuery = ref('')\\n    const highlightedIndex = ref(-1)\\n    const selectRef = ref<HTMLElement>()\\n    const dropdownRef = ref<HTMLElement>()\\n\\n    const filteredOptions = computed(() => {\\n      if (!props.filterable && !props.searchable) {\\n        return props.options\\n      }\\n\\n      const query = searchQuery.value.toLowerCase()\\n      return props.options.filter(option => {\\n        if (option.children) {\\n          return option.children.some(child => \\n            child.label.toLowerCase().includes(query)\\n          )\\n        }\\n        return option.label.toLowerCase().includes(query)\\n      })\\n    })\\n\\n    const selectedOptions = computed(() => {\\n      if (props.multiple && Array.isArray(props.modelValue)) {\\n        return props.options.filter(option => \\n          props.modelValue.includes(option.value)\\n        )\\n      }\\n      const option = props.options.find(option => option.value === props.modelValue)\\n      return option ? [option] : []\\n    })\\n\\n    const displayValue = computed(() => {\\n      if (props.multiple && Array.isArray(props.modelValue)) {\\n        if (props.modelValue.length === 0) {\\n          return props.placeholder\\n        }\\n        if (props.maxTagCount !== undefined && props.modelValue.length > props.maxTagCount) {\\n          return `+${props.modelValue.length - props.maxTagCount}`\\n        }\\n        return selectedOptions.value.map(opt => opt.label).join(', ')\\n      }\\n      const option = props.options.find(opt => opt.value === props.modelValue)\\n      return option ? option.label : props.placeholder\\n    })\\n\\n    const sizeClasses = computed(() => {\\n      switch (props.size) {\\n        case 'sm':\\n          return 'h-8 px-2 py-1 text-sm'\\n        case 'lg':\\n          return 'h-12 px-4 py-3 text-lg'\\n        default:\\n          return 'h-10 px-3 py-2 text-base'\\n      }\\n    })\\n\\n    const toggleDropdown = () => {\\n      if (props.disabled || props.readonly) {\\n        return\\n      }\\n      visible.value = !visible.value\\n      emit('visible-change', visible.value)\\n    }\\n\\n    const closeDropdown = () => {\\n      visible.value = false\\n      searchQuery.value = ''\\n      highlightedIndex.value = -1\\n      emit('visible-change', false)\\n    }\\n\\n    const selectOption = (option: SelectOption) => {\\n      if (option.disabled) {\\n        return\\n      }\\n\\n      if (props.multiple) {\\n        const currentValue = Array.isArray(props.modelValue) ? [...props.modelValue] : []\\n        const index = currentValue.indexOf(option.value)\\n        if (index > -1) {\\n          currentValue.splice(index, 1)\\n        } else {\\n          currentValue.push(option.value)\\n        }\\n        emit('update:modelValue', currentValue)\\n        emit('change', currentValue)\\n      } else {\\n        emit('update:modelValue', option.value)\\n        emit('change', option.value)\\n        closeDropdown()\\n      }\\n    }\\n\\n    const handleClear = (event: Event) => {\\n      event.stopPropagation()\\n      if (props.multiple) {\\n        emit('update:modelValue', [])\\n        emit('change', [])\\n      } else {\\n        emit('update:modelValue', '')\\n        emit('change', '')\\n      }\\n      emit('clear')\\n    }\\n\\n    const handleSearch = (value: string) => {\\n      searchQuery.value = value\\n      if (props.remote && props.remoteMethod) {\\n        props.remoteMethod(value)\\n      }\\n    }\\n\\n    const handleRemoveTag = (value: string | number, event: Event) => {\\n      event.stopPropagation()\\n      const currentValue = Array.isArray(props.modelValue) ? [...props.modelValue] : []\\n      const index = currentValue.indexOf(value)\\n      if (index > -1) {\\n        currentValue.splice(index, 1)\\n        emit('update:modelValue', currentValue)\\n        emit('remove-tag', value)\\n      }\\n    }\\n\\n    const isSelected = (option: SelectOption) => {\\n      if (props.multiple && Array.isArray(props.modelValue)) {\\n        return props.modelValue.includes(option.value)\\n      }\\n      return props.modelValue === option.value\\n    }\\n\\n    const isHighlighted = (index: number) => {\\n      return highlightedIndex.value === index\\n    }\\n\\n    const getOptionGroups = () => {\\n      const groups: Record<string, SelectOption[]> = {}\\n      filteredOptions.value.forEach(option => {\\n        if (option.group) {\\n          if (!groups[option.group]) {\\n            groups[option.group] = []\\n          }\\n          groups[option.group].push(option)\\n        } else if (option.children) {\\n          option.children.forEach(child => {\\n            if (!groups[option.label]) {\\n              groups[option.label] = []\\n            }\\n            groups[option.label].push(child)\\n          })\\n        }\\n      })\\n      return groups\\n    }\\n\\n    const getUngroupedOptions = () => {\\n      return filteredOptions.value.filter(option => !option.group && !option.children)\\n    }\\n\\n    const handleKeydown = (event: KeyboardEvent) => {\\n      switch (event.key) {\\n        case 'ArrowDown':\\n          event.preventDefault()\\n          highlightedIndex.value = Math.min(highlightedIndex.value + 1, filteredOptions.value.length - 1)\\n          break\\n        case 'ArrowUp':\\n          event.preventDefault()\\n          highlightedIndex.value = Math.max(highlightedIndex.value - 1, 0)\\n          break\\n        case 'Enter':\\n          event.preventDefault()\\n          if (highlightedIndex.value >= 0 && highlightedIndex.value < filteredOptions.value.length) {\\n            selectOption(filteredOptions.value[highlightedIndex.value])\\n          }\\n          break\\n        case 'Escape':\\n          closeDropdown()\\n          break\\n      }\\n    }\\n\\n    watch(() => props.modelValue, () => {\\n      if (!visible.value) {\\n        return\\n      }\\n      if (props.multiple && Array.isArray(props.modelValue)) {\\n        highlightedIndex.value = -1\\n      }\\n    })\\n\\n    return () => (\\n      <div ref={selectRef} class=\\\"relative w-full\\\">\\n        <div\\n          class={cn(\\n            'flex items-center justify-between w-full rounded-lg border bg-white cursor-pointer transition-all duration-200 outline-none focus:outline-none focus:ring-2 focus:ring-offset-2',\\n            sizeClasses.value,\\n            props.disabled ? 'opacity-50 cursor-not-allowed pointer-events-none' : '',\\n            props.readonly ? 'cursor-default' : '',\\n            visible.value ? 'border-primary-500 ring-primary-500/50' : 'border-neutral-300 focus:border-primary-500 focus:ring-primary-500/50'\\n          )}\\n          onClick={toggleDropdown}\\n          onKeydown={handleKeydown}\\n          tabindex={props.disabled ? -1 : 0}\\n        >\\n          <div class=\\\"flex-1 min-w-0 flex items-center gap-2\\\">\\n            {props.multiple && Array.isArray(props.modelValue) && props.modelValue.length > 0 ? (\\n              <div class=\\\"flex items-center gap-1 flex-wrap\\\">\\n                {selectedOptions.value.slice(0, props.maxTagCount).map(option => (\\n                  <span\\n                    key={option.value}\\n                    class=\\\"inline-flex items-center gap-1 px-2 py-0.5 bg-primary-100 text-primary-700 rounded text-xs\\\"\\n                  >\\n                    {option.label}\\n                    {!props.disabled && !props.readonly && (\\n                      <button\\n                        type=\\\"button\\\"\\n                        class=\\\"hover:text-primary-900\\\"\\n                        onClick={(e: Event) => handleRemoveTag(option.value, e)}\\n                      >\\n                        ×\\n                      </button>\\n                    )}\\n                  </span>\\n                ))}\\n                {props.maxTagCount !== undefined && selectedOptions.value.length > props.maxTagCount && (\\n                  <span class=\\\"text-neutral-500 text-xs\\\">\\n                    +{selectedOptions.value.length - props.maxTagCount}\\n                  </span>\\n                )}\\n              </div>\\n            ) : (\\n              <span class={cn('truncate', !props.modelValue && 'text-neutral-400')}>\\n                {displayValue.value}\\n              </span>\\n            )}\\n          </div>\\n          <div class=\\\"flex items-center gap-1\\\">\\n            {props.clearable && props.modelValue && !props.disabled && !props.readonly && (\\n              <button\\n                type=\\\"button\\\"\\n                class=\\\"text-neutral-400 hover:text-neutral-600 transition-colors\\\"\\n                onClick={handleClear}\\n              >\\n                ×\\n              </button>\\n            )}\\n            {visible.value ? (\\n              <ChevronUp size={16} class=\\\"text-neutral-400\\\" />\\n            ) : (\\n              <ChevronDown size={16} class=\\\"text-neutral-400\\\" />\\n            )}\\n          </div>\\n        </div>\\n\\n        {visible.value && (\\n          <div\\n            ref={dropdownRef}\\n            class={cn(\\n              'absolute z-50 w-full mt-1 bg-white border border-neutral-200 rounded-lg shadow-lg max-h-60 overflow-auto',\\n              'animate-in fade-in zoom-in-95 duration-200'\\n            )}\\n          >\\n            {props.searchable && (\\n              <div class=\\\"p-2 border-b border-neutral-200\\\">\\n                <div class=\\\"relative\\\">\\n                  <Search size={16} class=\\\"absolute left-3 top-1/2 -translate-y-1/2 text-neutral-400\\\" />\\n                  <input\\n                    type=\\\"text\\\"\\n                    value={searchQuery.value}\\n                    onInput={(e: Event) => handleSearch((e.target as HTMLInputElement).value)}\\n                    placeholder=\\\"搜索...\\\"\\n                    class=\\\"w-full pl-9 pr-3 py-2 border border-neutral-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent text-sm\\\"\\n                  />\\n                </div>\\n              </div>\\n            )}\\n\\n            {props.loading ? (\\n              <div class=\\\"flex items-center justify-center py-8\\\">\\n                <svg class=\\\"animate-spin h-6 w-6 text-primary-600\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" fill=\\\"none\\\" viewBox=\\\"0 0 24 24\\\">\\n                  <circle class=\\\"opacity-25\\\" cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"10\\\" stroke=\\\"currentColor\\\" strokeWidth=\\\"4\\\"></circle>\\n                  <path class=\\\"opacity-75\\\" fill=\\\"currentColor\\\" d=\\\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\\\"></path>\\n                </svg>\\n              </div>\\n            ) : (\\n              <div class=\\\"py-1\\\">\\n                {Object.entries(getOptionGroups()).map(([groupName, options]) => (\\n                  <div key={groupName}>\\n                    <div class=\\\"px-3 py-2 text-xs font-semibold text-neutral-500 bg-neutral-50\\\">\\n                      {groupName}\\n                    </div>\\n                    {options.map((option, index) => (\\n                      <div\\n                        key={option.value}\\n                        class={cn(\\n                          'px-3 py-2 cursor-pointer transition-colors flex items-center justify-between',\\n                          option.disabled ? 'opacity-50 cursor-not-allowed' : 'hover:bg-neutral-100',\\n                          isSelected(option) && 'bg-primary-50 text-primary-700',\\n                          isHighlighted(index) && 'bg-neutral-100'\\n                        )}\\n                        onClick={() => !option.disabled && selectOption(option)}\\n                      >\\n                        <span>{option.label}</span>\\n                        {isSelected(option) && <Check size={16} />}\\n                      </div>\\n                    ))}\\n                  </div>\\n                ))}\\n                {getUngroupedOptions().map((option, index) => (\\n                  <div\\n                    key={option.value}\\n                    class={cn(\\n                      'px-3 py-2 cursor-pointer transition-colors flex items-center justify-between',\\n                      option.disabled ? 'opacity-50 cursor-not-allowed' : 'hover:bg-neutral-100',\\n                      isSelected(option) && 'bg-primary-50 text-primary-700',\\n                      isHighlighted(index) && 'bg-neutral-100'\\n                    )}\\n                    onClick={() => !option.disabled && selectOption(option)}\\n                  >\\n                    <span>{option.label}</span>\\n                    {isSelected(option) && <Check size={16} />}\\n                  </div>\\n                ))}\\n                {filteredOptions.value.length === 0 && (\\n                  <div class=\\\"px-3 py-8 text-center text-neutral-500 text-sm\\\">\\n                    无数据\\n                  </div>\\n                )}\\n              </div>\\n            )}\\n          </div>\\n        )}\\n      </div>\\n    )\\n  },\\n})\\n\",\"originTextLength\":14280,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768928650571},{\"originRange\":{\"start\":{\"line\":10,\"character\":0},\"end\":{\"line\":10,\"character\":98}},\"modifyRange\":{\"start\":{\"line\":10,\"character\":0},\"end\":{\"line\":10,\"character\":98}},\"action\":\"None\",\"isLine\":false,\"originText\":\"import { defineComponent, ref, computed, watch, onMounted, onUnmounted, type PropType } from \\\\'vue\\\\'\",\"originAcceptText\":\"import { defineComponent, ref, computed, watch, onMounted, onUnmounted, type PropType } from 'vue'\",\"originTextLength\":98,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768928659792}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/components/UI/Checkbox/index.tsx": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":199,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":199,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"/**\\\\n * @fileoverview YYC³餐饮行业智能化平台 - 复选框组件\\\\n * @description 统一的复选框组件，支持单选、多选和分组\\\\n * @author YYC³\\\\n * @version 1.0.0\\\\n * @created 2026-01-21\\\\n * @copyright Copyright (c) 2026 YYC³\\\\n * @license MIT\\\\n */\\\\n\\\\nimport { defineComponent, type PropType } from \\\\'vue\\\\'\\\\nimport { cn } from \\\\'@/utils/cn\\\\'\\\\nimport { Check, Minus } from \\\\'lucide-vue-next\\\\'\\\\n\\\\nexport const Checkbox = defineComponent({\\\\n  name: \\\\'Checkbox\\\\',\\\\n  props: {\\\\n    modelValue: {\\\\n      type: [Boolean, String, Array] as PropType<boolean | string | string[]>,\\\\n      default: false,\\\\n    },\\\\n    value: {\\\\n      type: [String, Number] as PropType<string | number>,\\\\n      default: \\\\'\\\\',\\\\n    },\\\\n    label: {\\\\n      type: String,\\\\n      default: \\\\'\\\\',\\\\n    },\\\\n    disabled: {\\\\n      type: Boolean,\\\\n      default: false,\\\\n    },\\\\n    indeterminate: {\\\\n      type: Boolean,\\\\n      default: false,\\\\n    },\\\\n    size: {\\\\n      type: String as PropType<\\\\'sm\\\\' | \\\\'md\\\\' | \\\\'lg\\\\'>,\\\\n      default: \\\\'md\\\\',\\\\n      validator: (value: string) => [\\\\'sm\\\\', \\\\'md\\\\', \\\\'lg\\\\'].includes(value),\\\\n    },\\\\n    trueValue: {\\\\n      type: [Boolean, String, Number] as PropType<boolean | string | number>,\\\\n      default: true,\\\\n    },\\\\n    falseValue: {\\\\n      type: [Boolean, String, Number] as PropType<boolean | string | number>,\\\\n      default: false,\\\\n    },\\\\n  },\\\\n  emits: [\\\\'update:modelValue\\\\', \\\\'change\\\\'],\\\\n  setup(props, { emit }) {\\\\n    const isChecked = computed(() => {\\\\n      if (Array.isArray(props.modelValue)) {\\\\n        return props.modelValue.includes(props.value as string)\\\\n      }\\\\n      return props.modelValue === props.trueValue\\\\n    })\\\\n\\\\n    const sizeClasses = computed(() => {\\\\n      switch (props.size) {\\\\n        case \\\\'sm\\\\':\\\\n          return \\\\'w-4 h-4\\\\'\\\\n        case \\\\'lg\\\\':\\\\n          return \\\\'w-6 h-6\\\\'\\\\n        default:\\\\n          return \\\\'w-5 h-5\\\\'\\\\n      }\\\\n    })\\\\n\\\\n    const iconSize = computed(() => {\\\\n      switch (props.size) {\\\\n        case \\\\'sm\\\\':\\\\n          return 12\\\\n        case \\\\'lg\\\\':\\\\n          return 20\\\\n        default:\\\\n          return 16\\\\n      }\\\\n    })\\\\n\\\\n    const handleChange = (event: Event) => {\\\\n      if (props.disabled) {\\\\n        return\\\\n      }\\\\n\\\\n      let newValue: any\\\\n      if (Array.isArray(props.modelValue)) {\\\\n        const currentValue = [...props.modelValue]\\\\n        const index = currentValue.indexOf(props.value as string)\\\\n        if (index > -1) {\\\\n          currentValue.splice(index, 1)\\\\n        } else {\\\\n          currentValue.push(props.value as string)\\\\n        }\\\\n        newValue = currentValue\\\\n      } else {\\\\n        newValue = isChecked.value ? props.falseValue : props.trueValue\\\\n      }\\\\n\\\\n      emit(\\\\'update:modelValue\\\\', newValue)\\\\n      emit(\\\\'change\\\\', newValue)\\\\n    }\\\\n\\\\n    return () => (\\\\n      <label\\\\n        class={cn(\\\\n          \\\\'inline-flex items-center gap-2 cursor-pointer\\\\',\\\\n          props.disabled && \\\\'opacity-50 cursor-not-allowed\\\\'\\\\n        )}\\\\n      >\\\\n        <div class=\\\\\\\"relative\\\\\\\">\\\\n          <input\\\\n            type=\\\\\\\"checkbox\\\\\\\"\\\\n            checked={isChecked.value}\\\\n            disabled={props.disabled}\\\\n            class={cn(\\\\n              \\\\'appearance-none border border-neutral-300 rounded bg-white transition-all duration-200 outline-none focus:outline-none focus:ring-2 focus:ring-offset-2\\\\',\\\\n              sizeClasses.value,\\\\n              isChecked.value && \\\\'bg-primary-600 border-primary-600\\\\',\\\\n              !isChecked.value && \\\\'hover:border-primary-400\\\\',\\\\n              props.disabled && \\\\'opacity-50 cursor-not-allowed\\\\',\\\\n              \\\\'focus:ring-primary-500/50\\\\'\\\\n            )}\\\\n            onChange={handleChange}\\\\n          />\\\\n          {isChecked.value && (\\\\n            <div class={cn(\\\\'absolute inset-0 flex items-center justify-center text-white pointer-events-none\\\\')}>\\\\n              {props.indeterminate ? (\\\\n                <Minus size={iconSize.value} />\\\\n              ) : (\\\\n                <Check size={iconSize.value} />\\\\n              )}\\\\n            </div>\\\\n          )}\\\\n        </div>\\\\n        {props.label && (\\\\n          <span class={cn(\\\\'text-sm\\\\', props.disabled && \\\\'text-neutral-400\\\\')}>\\\\n            {props.label}\\\\n          </span>\\\\n        )}\\\\n      </label>\\\\n    )\\\\n  },\\\\n})\\\\n\\\\nexport const CheckboxGroup = defineComponent({\\\\n  name: \\\\'CheckboxGroup\\\\',\\\\n  props: {\\\\n    modelValue: {\\\\n      type: Array as PropType<string[]>,\\\\n      default: () => [],\\\\n    },\\\\n    options: {\\\\n      type: Array as PropType<Array<{ label: string; value: string; disabled?: boolean }>>,\\\\n      default: () => [],\\\\n    },\\\\n    disabled: {\\\\n      type: Boolean,\\\\n      default: false,\\\\n    },\\\\n    size: {\\\\n      type: String as PropType<\\\\'sm\\\\' | \\\\'md\\\\' | \\\\'lg\\\\'>,\\\\n      default: \\\\'md\\\\',\\\\n      validator: (value: string) => [\\\\'sm\\\\', \\\\'md\\\\', \\\\'lg\\\\'].includes(value),\\\\n    },\\\\n    direction: {\\\\n      type: String as PropType<\\\\'horizontal\\\\' | \\\\'vertical\\\\'>,\\\\n      default: \\\\'vertical\\\\',\\\\n      validator: (value: string) => [\\\\'horizontal\\\\', \\\\'vertical\\\\'].includes(value),\\\\n    },\\\\n  },\\\\n  emits: [\\\\'update:modelValue\\\\', \\\\'change\\\\'],\\\\n  setup(props, { emit }) {\\\\n    const handleChange = (value: string) => {\\\\n      const currentValue = [...props.modelValue]\\\\n      const index = currentValue.indexOf(value)\\\\n      if (index > -1) {\\\\n        currentValue.splice(index, 1)\\\\n      } else {\\\\n        currentValue.push(value)\\\\n      }\\\\n      emit(\\\\'update:modelValue\\\\', currentValue)\\\\n      emit(\\\\'change\\\\', currentValue)\\\\n    }\\\\n\\\\n    return () => (\\\\n      <div\\\\n        class={cn(\\\\n          \\\\'flex gap-4\\\\',\\\\n          props.direction === \\\\'vertical\\\\' ? \\\\'flex-col\\\\' : \\\\'flex-row flex-wrap\\\\'\\\\n        )}\\\\n      >\\\\n        {props.options.map(option => (\\\\n          <Checkbox\\\\n            key={option.value}\\\\n            modelValue={props.modelValue.includes(option.value)}\\\\n            value={option.value}\\\\n            label={option.label}\\\\n            disabled={props.disabled || option.disabled}\\\\n            size={props.size}\\\\n            onChange={() => handleChange(option.value)}\\\\n          />\\\\n        ))}\\\\n      </div>\\\\n    )\\\\n  },\\\\n})\\\\n\",\"originAcceptText\":\"/**\\n * @fileoverview YYC³餐饮行业智能化平台 - 复选框组件\\n * @description 统一的复选框组件，支持单选、多选和分组\\n * @author YYC³\\n * @version 1.0.0\\n * @created 2026-01-21\\n * @copyright Copyright (c) 2026 YYC³\\n * @license MIT\\n */\\n\\nimport { defineComponent, type PropType } from 'vue'\\nimport { cn } from '@/utils/cn'\\nimport { Check, Minus } from 'lucide-vue-next'\\n\\nexport const Checkbox = defineComponent({\\n  name: 'Checkbox',\\n  props: {\\n    modelValue: {\\n      type: [Boolean, String, Array] as PropType<boolean | string | string[]>,\\n      default: false,\\n    },\\n    value: {\\n      type: [String, Number] as PropType<string | number>,\\n      default: '',\\n    },\\n    label: {\\n      type: String,\\n      default: '',\\n    },\\n    disabled: {\\n      type: Boolean,\\n      default: false,\\n    },\\n    indeterminate: {\\n      type: Boolean,\\n      default: false,\\n    },\\n    size: {\\n      type: String as PropType<'sm' | 'md' | 'lg'>,\\n      default: 'md',\\n      validator: (value: string) => ['sm', 'md', 'lg'].includes(value),\\n    },\\n    trueValue: {\\n      type: [Boolean, String, Number] as PropType<boolean | string | number>,\\n      default: true,\\n    },\\n    falseValue: {\\n      type: [Boolean, String, Number] as PropType<boolean | string | number>,\\n      default: false,\\n    },\\n  },\\n  emits: ['update:modelValue', 'change'],\\n  setup(props, { emit }) {\\n    const isChecked = computed(() => {\\n      if (Array.isArray(props.modelValue)) {\\n        return props.modelValue.includes(props.value as string)\\n      }\\n      return props.modelValue === props.trueValue\\n    })\\n\\n    const sizeClasses = computed(() => {\\n      switch (props.size) {\\n        case 'sm':\\n          return 'w-4 h-4'\\n        case 'lg':\\n          return 'w-6 h-6'\\n        default:\\n          return 'w-5 h-5'\\n      }\\n    })\\n\\n    const iconSize = computed(() => {\\n      switch (props.size) {\\n        case 'sm':\\n          return 12\\n        case 'lg':\\n          return 20\\n        default:\\n          return 16\\n      }\\n    })\\n\\n    const handleChange = (event: Event) => {\\n      if (props.disabled) {\\n        return\\n      }\\n\\n      let newValue: any\\n      if (Array.isArray(props.modelValue)) {\\n        const currentValue = [...props.modelValue]\\n        const index = currentValue.indexOf(props.value as string)\\n        if (index > -1) {\\n          currentValue.splice(index, 1)\\n        } else {\\n          currentValue.push(props.value as string)\\n        }\\n        newValue = currentValue\\n      } else {\\n        newValue = isChecked.value ? props.falseValue : props.trueValue\\n      }\\n\\n      emit('update:modelValue', newValue)\\n      emit('change', newValue)\\n    }\\n\\n    return () => (\\n      <label\\n        class={cn(\\n          'inline-flex items-center gap-2 cursor-pointer',\\n          props.disabled && 'opacity-50 cursor-not-allowed'\\n        )}\\n      >\\n        <div class=\\\"relative\\\">\\n          <input\\n            type=\\\"checkbox\\\"\\n            checked={isChecked.value}\\n            disabled={props.disabled}\\n            class={cn(\\n              'appearance-none border border-neutral-300 rounded bg-white transition-all duration-200 outline-none focus:outline-none focus:ring-2 focus:ring-offset-2',\\n              sizeClasses.value,\\n              isChecked.value && 'bg-primary-600 border-primary-600',\\n              !isChecked.value && 'hover:border-primary-400',\\n              props.disabled && 'opacity-50 cursor-not-allowed',\\n              'focus:ring-primary-500/50'\\n            )}\\n            onChange={handleChange}\\n          />\\n          {isChecked.value && (\\n            <div class={cn('absolute inset-0 flex items-center justify-center text-white pointer-events-none')}>\\n              {props.indeterminate ? (\\n                <Minus size={iconSize.value} />\\n              ) : (\\n                <Check size={iconSize.value} />\\n              )}\\n            </div>\\n          )}\\n        </div>\\n        {props.label && (\\n          <span class={cn('text-sm', props.disabled && 'text-neutral-400')}>\\n            {props.label}\\n          </span>\\n        )}\\n      </label>\\n    )\\n  },\\n})\\n\\nexport const CheckboxGroup = defineComponent({\\n  name: 'CheckboxGroup',\\n  props: {\\n    modelValue: {\\n      type: Array as PropType<string[]>,\\n      default: () => [],\\n    },\\n    options: {\\n      type: Array as PropType<Array<{ label: string; value: string; disabled?: boolean }>>,\\n      default: () => [],\\n    },\\n    disabled: {\\n      type: Boolean,\\n      default: false,\\n    },\\n    size: {\\n      type: String as PropType<'sm' | 'md' | 'lg'>,\\n      default: 'md',\\n      validator: (value: string) => ['sm', 'md', 'lg'].includes(value),\\n    },\\n    direction: {\\n      type: String as PropType<'horizontal' | 'vertical'>,\\n      default: 'vertical',\\n      validator: (value: string) => ['horizontal', 'vertical'].includes(value),\\n    },\\n  },\\n  emits: ['update:modelValue', 'change'],\\n  setup(props, { emit }) {\\n    const handleChange = (value: string) => {\\n      const currentValue = [...props.modelValue]\\n      const index = currentValue.indexOf(value)\\n      if (index > -1) {\\n        currentValue.splice(index, 1)\\n      } else {\\n        currentValue.push(value)\\n      }\\n      emit('update:modelValue', currentValue)\\n      emit('change', currentValue)\\n    }\\n\\n    return () => (\\n      <div\\n        class={cn(\\n          'flex gap-4',\\n          props.direction === 'vertical' ? 'flex-col' : 'flex-row flex-wrap'\\n        )}\\n      >\\n        {props.options.map(option => (\\n          <Checkbox\\n            key={option.value}\\n            modelValue={props.modelValue.includes(option.value)}\\n            value={option.value}\\n            label={option.label}\\n            disabled={props.disabled || option.disabled}\\n            size={props.size}\\n            onChange={() => handleChange(option.value)}\\n          />\\n        ))}\\n      </div>\\n    )\\n  },\\n})\\n\",\"originTextLength\":5736,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768928687406},{\"originRange\":{\"start\":{\"line\":10,\"character\":0},\"end\":{\"line\":10,\"character\":62}},\"modifyRange\":{\"start\":{\"line\":10,\"character\":0},\"end\":{\"line\":10,\"character\":62}},\"action\":\"None\",\"isLine\":false,\"originText\":\"import { defineComponent,