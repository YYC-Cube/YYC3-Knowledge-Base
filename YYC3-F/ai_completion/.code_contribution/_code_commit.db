:00Z\\\\'\\\\n      }\\\\n    })),\\\\n    deleteStore: vi.fn(() => Promise.resolve({\\\\n      success: true\\\\n    })),\\\\n    updateStoreStatus: vi.fn(() => Promise.resolve({\\\\n      success: true\\\\n    })),\\\\n    createEmployee: vi.fn(() => Promise.resolve({\\\\n      success: true,\\\\n      data: {\\\\n        id: 2,\\\\n        employeeCode: \\\\'EMP002\\\\',\\\\n        name: \\\\'李四\\\\',\\\\n        gender: \\\\'female\\\\',\\\\n        phone: \\\\'13900139000\\\\',\\\\n        email: \\\\'lisi@example.com\\\\',\\\\n        avatar: \\\\'https://example.com/avatar2.jpg\\\\',\\\\n        storeId: 1,\\\\n        storeName: \\\\'北京朝阳店\\\\',\\\\n        department: \\\\'前厅\\\\',\\\\n        position: \\\\'服务员\\\\',\\\\n        status: EmployeeStatus.ACTIVE,\\\\n        hireDate: \\\\'2024-01-01\\\\',\\\\n        salary: 5000,\\\\n        address: \\\\'北京市朝阳区\\\\',\\\\n        idCard: \\\\'310101199401011234\\\\',\\\\n        bankAccount: \\\\'6222021234567890124\\\\',\\\\n        emergencyContact: {\\\\n          name: \\\\'赵六\\\\',\\\\n          phone: \\\\'13600136000\\\\',\\\\n          relationship: \\\\'配偶\\\\'\\\\n        },\\\\n        permissions: [\\\\'store:read\\\\'],\\\\n        createdAt: \\\\'2024-01-01T00:00:00Z\\\\'\\\\n      }\\\\n    })),\\\\n    updateEmployee: vi.fn(() => Promise.resolve({\\\\n      success: true,\\\\n      data: {\\\\n        id: 1,\\\\n        employeeCode: \\\\'EMP001\\\\',\\\\n        name: \\\\'张三（更新）\\\\',\\\\n        gender: \\\\'male\\\\',\\\\n        phone: \\\\'13800138000\\\\',\\\\n        email: \\\\'zhangsan@example.com\\\\',\\\\n        avatar: \\\\'https://example.com/avatar1.jpg\\\\',\\\\n        storeId: 1,\\\\n        storeName: \\\\'北京朝阳店\\\\',\\\\n        department: \\\\'前厅\\\\',\\\\n        position: \\\\'店长\\\\',\\\\n        status: EmployeeStatus.ACTIVE,\\\\n        hireDate: \\\\'2020-01-01\\\\',\\\\n        salary: 8500,\\\\n        address: \\\\'北京市朝阳区\\\\',\\\\n        idCard: \\\\'110101199001011234\\\\',\\\\n        bankAccount: \\\\'6222021234567890123\\\\',\\\\n        emergencyContact: {\\\\n          name: \\\\'王五\\\\',\\\\n          phone: \\\\'13700137000\\\\',\\\\n          relationship: \\\\'配偶\\\\'\\\\n        },\\\\n        permissions: [\\\\'store:read\\\\', \\\\'store:write\\\\'],\\\\n        createdAt: \\\\'2020-01-01T00:00:00Z\\\\'\\\\n      }\\\\n    })),\\\\n    deleteEmployee: vi.fn(() => Promise.resolve({\\\\n      success: true\\\\n    })),\\\\n    transferEmployee: vi.fn(() => Promise.resolve({\\\\n      success: true\\\\n    })),\\\\n    restockInventory: vi.fn(() => Promise.resolve({\\\\n      success: true\\\\n    })),\\\\n    transferInventory: vi.fn(() => Promise.resolve({\\\\n      success: true\\\\n    })),\\\\n    checkInventory: vi.fn(() => Promise.resolve({\\\\n      success: true\\\\n    })),\\\\n    getStoreStatsOverview: vi.fn(() => Promise.resolve({\\\\n      success: true,\\\\n      data: [\\\\n        {\\\\n          storeId: 1,\\\\n          storeName: \\\\'北京朝阳店\\\\',\\\\n          totalOrders: 1000,\\\\n          totalRevenue: 500000,\\\\n          averageOrderValue: 500,\\\\n          totalCustomers: 800,\\\\n          customerRetentionRate: 0.8,\\\\n          employeeCount: 20,\\\\n          averageRating: 4.5,\\\\n          dailyStats: [],\\\\n          monthlyStats: []\\\\n        }\\\\n      ]\\\\n    })),\\\\n    getEmployeePerformanceOverview: vi.fn(() => Promise.resolve({\\\\n      success: true,\\\\n      data: [\\\\n        {\\\\n          employeeId: 1,\\\\n          employeeName: \\\\'张三\\\\',\\\\n          storeName: \\\\'北京朝阳店\\\\',\\\\n          department: \\\\'前厅\\\\',\\\\n          position: \\\\'店长\\\\',\\\\n          totalOrders: 200,\\\\n          totalRevenue: 100000,\\\\n          averageOrderValue: 500,\\\\n          customerSatisfaction: 0.9,\\\\n          attendanceRate: 0.95,\\\\n          performanceScore: 90,\\\\n          ranking: 1\\\\n        }\\\\n      ]\\\\n    }))\\\\n  }))\\\\n})\\\\n\\\\ndescribe(\\\\'ChainManagement集成测试\\\\', () => {\\\\n  let wrapper: VueWrapper<any>\\\\n  let pinia: any\\\\n\\\\n  beforeEach(() => {\\\\n    pinia = createPinia()\\\\n    setActivePinia(pinia)\\\\n\\\\n    wrapper = mount(ChainManagement, {\\\\n      global: {\\\\n        plugins: [pinia, router, ElementPlus],\\\\n        stubs: {\\\\n          \\\\'el-card\\\\': true,\\\\n          \\\\'el-row\\\\': true,\\\\n          \\\\'el-col\\\\': true,\\\\n          \\\\'el-tabs\\\\': true,\\\\n          \\\\'el-tab-pane\\\\': true,\\\\n          \\\\'el-button\\\\': true,\\\\n          \\\\'el-button-group\\\\': true,\\\\n          \\\\'el-icon\\\\': true,\\\\n          \\\\'el-tag\\\\': true,\\\\n          \\\\'el-table\\\\': true,\\\\n          \\\\'el-table-column\\\\': true,\\\\n          \\\\'el-pagination\\\\': true,\\\\n          \\\\'el-dialog\\\\': true,\\\\n          \\\\'el-form\\\\': true,\\\\n          \\\\'el-form-item\\\\': true,\\\\n          \\\\'el-input\\\\': true,\\\\n          \\\\'el-input-number\\\\': true,\\\\n          \\\\'el-select\\\\': true,\\\\n          \\\\'el-option\\\\': true,\\\\n          \\\\'el-radio\\\\': true,\\\\n          \\\\'el-radio-group\\\\': true,\\\\n          \\\\'el-date-picker\\\\': true,\\\\n          \\\\'el-time-picker\\\\': true,\\\\n          \\\\'el-switch\\\\': true,\\\\n          \\\\'el-dropdown\\\\': true,\\\\n          \\\\'el-dropdown-menu\\\\': true,\\\\n          \\\\'el-dropdown-item\\\\': true,\\\\n          \\\\'el-rate\\\\': true,\\\\n          \\\\'el-avatar\\\\': true,\\\\n          \\\\'el-divider\\\\': true,\\\\n          \\\\'el-alert\\\\': true,\\\\n          \\\\'el-tooltip\\\\': true,\\\\n          \\\\'el-popover\\\\': true,\\\\n          \\\\'el-progress\\\\': true,\\\\n          \\\\'el-statistic\\\\': true,\\\\n          \\\\'el-badge\\\\': true,\\\\n          \\\\'el-empty\\\\': true\\\\n        }\\\\n      }\\\\n    })\\\\n\\\\n    router.push(\\\\'/chain\\\\')\\\\n    vi.clearAllMocks()\\\\n  })\\\\n\\\\n  afterEach(() => {\\\\n    wrapper.unmount()\\\\n  })\\\\n\\\\n  describe(\\\\'组件集成\\\\', () => {\\\\n    it(\\\\'应该正确加载所有数据\\\\', async () => {\\\\n      await wrapper.vm.loadStores()\\\\n      await wrapper.vm.loadEmployees()\\\\n      await wrapper.vm.loadInventory()\\\\n      await wrapper.vm.loadStoreStats()\\\\n      await wrapper.vm.loadEmployeePerformance()\\\\n\\\\n      expect(wrapper.vm.stores.length).toBeGreaterThan(0)\\\\n      expect(wrapper.vm.employees.length).toBeGreaterThan(0)\\\\n      expect(wrapper.vm.inventory.length).toBeGreaterThan(0)\\\\n      expect(wrapper.vm.storeStats.length).toBeGreaterThan(0)\\\\n      expect(wrapper.vm.employeePerformance.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示系统概览\\\\', () => {\\\\n      const statCards = wrapper.findAll(\\\\'.stat-card\\\\')\\\\n      expect(statCards.length).toBe(4)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确切换标签页\\\\', async () => {\\\\n      const tabs = wrapper.find(\\\\'.el-tabs\\\\')\\\\n      expect(tabs.exists()).toBe(true)\\\\n\\\\n      wrapper.vm.activeTab = \\\\'employees\\\\'\\\\n      await wrapper.vm.$nextTick()\\\\n      expect(wrapper.vm.activeTab).toBe(\\\\'employees\\\\')\\\\n\\\\n      wrapper.vm.activeTab = \\\\'inventory\\\\'\\\\n      await wrapper.vm.$nextTick()\\\\n      expect(wrapper.vm.activeTab).toBe(\\\\'inventory\\\\')\\\\n\\\\n      wrapper.vm.activeTab = \\\\'stats\\\\'\\\\n      await wrapper.vm.$nextTick()\\\\n      expect(wrapper.vm.activeTab).toBe(\\\\'stats\\\\')\\\\n\\\\n      wrapper.vm.activeTab = \\\\'stores\\\\'\\\\n      await wrapper.vm.$nextTick()\\\\n      expect(wrapper.vm.activeTab).toBe(\\\\'stores\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'门店管理流程集成\\\\', () => {\\\\n    it(\\\\'应该完整处理门店生命周期\\\\', async () => {\\\\n      await wrapper.vm.loadStores()\\\\n\\\\n      const activeStore = wrapper.vm.stores.find((s: any) => s.status === StoreStatus.OPEN)\\\\n      expect(activeStore).toBeDefined()\\\\n\\\\n      await wrapper.vm.handleUpdateStoreStatus(activeStore, StoreStatus.CLOSED)\\\\n      expect(activeStore.status).toBe(StoreStatus.CLOSED)\\\\n\\\\n      await wrapper.vm.handleUpdateStoreStatus(activeStore, StoreStatus.OPEN)\\\\n      expect(activeStore.status).toBe(StoreStatus.OPEN)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确筛选门店\\\\', async () => {\\\\n      await wrapper.vm.loadStores()\\\\n      expect(wrapper.vm.stores.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确创建门店\\\\', async () => {\\\\n      wrapper.vm.storeForm = {\\\\n        id: 0,\\\\n        storeCode: \\\\'ST002\\\\',\\\\n        name: \\\\'上海浦东店\\\\',\\\\n        type: StoreType.DIRECT,\\\\n        status: StoreStatus.OPEN,\\\\n        address: \\\\'上海市浦东新区陆家嘴环路1000号\\\\',\\\\n        city: \\\\'上海市\\\\',\\\\n        district: \\\\'浦东新区\\\\',\\\\n        phone: \\\\'021-87654321\\\\',\\\\n        email: \\\\'shanghai@example.com\\\\',\\\\n        managerId: 2,\\\\n        businessHours: {\\\\n          monday: { open: \\\\'09:00\\\\', close: \\\\'22:00\\\\', enabled: true },\\\\n          tuesday: { open: \\\\'09:00\\\\', close: \\\\'22:00\\\\', enabled: true },\\\\n          wednesday: { open: \\\\'09:00\\\\', close: \\\\'22:00\\\\', enabled: true },\\\\n          thursday: { open: \\\\'09:00\\\\', close: \\\\'22:00\\\\', enabled: true },\\\\n          friday: { open: \\\\'09:00\\\\', close: \\\\'22:00\\\\', enabled: true },\\\\n          saturday: { open: \\\\'09:00\\\\', close: \\\\'22:00\\\\', enabled: true },\\\\n          sunday: { open: \\\\'09:00\\\\', close: \\\\'22:00\\\\', enabled: true }\\\\n        },\\\\n        area: 180,\\\\n        capacity: 120,\\\\n        tables: 25,\\\\n        coordinates: { latitude: 31.2304, longitude: 121.4737 },\\\\n        facilities: [\\\\'WiFi\\\\', \\\\'空调\\\\', \\\\'停车场\\\\'],\\\\n        description: \\\\'上海浦东店\\\\',\\\\n        images: [\\\\'https://example.com/store2.jpg\\\\'],\\\\n        openingDate: \\\\'2024-01-01\\\\'\\\\n      }\\\\n\\\\n      await wrapper.vm.confirmStore()\\\\n      expect(wrapper.vm.stores.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确更新门店\\\\', async () => {\\\\n      await wrapper.vm.loadStores()\\\\n      const store = wrapper.vm.stores[0]\\\\n\\\\n      wrapper.vm.storeForm = {\\\\n        id: store.id,\\\\n        storeCode: store.storeCode,\\\\n        name: \\\\'北京朝阳店（更新）\\\\',\\\\n        type: store.type,\\\\n        status: store.status,\\\\n        address: store.address,\\\\n        city: store.city,\\\\n        district: store.district,\\\\n        phone: store.phone,\\\\n        email: store.email,\\\\n        managerId: store.manager.id,\\\\n        businessHours: { ...store.businessHours },\\\\n        area: store.area,\\\\n        capacity: store.capacity,\\\\n        tables: store.tables,\\\\n        coordinates: store.coordinates,\\\\n        facilities: store.facilities,\\\\n        description: \\\\'北京朝阳店（更新）\\\\',\\\\n        images: store.images,\\\\n        openingDate: store.openingDate\\\\n      }\\\\n\\\\n      await wrapper.vm.confirmStore()\\\\n      expect(wrapper.vm.stores.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确删除门店\\\\', async () => {\\\\n      await wrapper.vm.loadStores()\\\\n      const store = wrapper.vm.stores[0]\\\\n\\\\n      await wrapper.vm.handleDeleteStore(store)\\\\n      expect(wrapper.vm.stores.length).toBeGreaterThan(0)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'员工管理流程集成\\\\', () => {\\\\n    it(\\\\'应该正确加载和显示员工\\\\', async () => {\\\\n      await wrapper.vm.loadEmployees()\\\\n      expect(wrapper.vm.employees.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确筛选员工\\\\', async () => {\\\\n      await wrapper.vm.loadEmployees()\\\\n\\\\n      wrapper.vm.employeeFilter.search = \\\\'张三\\\\'\\\\n      await wrapper.vm.handleEmployeeSearch()\\\\n      expect(wrapper.vm.employees.length).toBeGreaterThan(0)\\\\n\\\\n      wrapper.vm.employeeFilter.storeId = 1\\\\n      await wrapper.vm.handleEmployeeSearch()\\\\n      expect(wrapper.vm.employees.length).toBeGreaterThan(0)\\\\n\\\\n      wrapper.vm.employeeFilter.status = EmployeeStatus.ACTIVE\\\\n      await wrapper.vm.handleEmployeeSearch()\\\\n      expect(wrapper.vm.employees.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确创建员工\\\\', async () => {\\\\n      wrapper.vm.employeeForm = {\\\\n        id: 0,\\\\n        employeeCode: \\\\'EMP002\\\\',\\\\n        name: \\\\'李四\\\\',\\\\n        gender: \\\\'female\\\\',\\\\n        phone: \\\\'13900139000\\\\',\\\\n        email: \\\\'lisi@example.com\\\\',\\\\n        avatar: \\\\'https://example.com/avatar2.jpg\\\\',\\\\n        storeId: 1,\\\\n        department: \\\\'前厅\\\\',\\\\n        position: \\\\'服务员\\\\',\\\\n        status: EmployeeStatus.ACTIVE,\\\\n        hireDate: \\\\'2024-01-01\\\\',\\\\n        salary: 5000,\\\\n        address: \\\\'北京市朝阳区\\\\',\\\\n        idCard: \\\\'310101199401011234\\\\',\\\\n        bankAccount: \\\\'6222021234567890124\\\\',\\\\n        emergencyContact: { name: \\\\'赵六\\\\', phone: \\\\'13600136000\\\\', relationship: \\\\'配偶\\\\' },\\\\n        permissions: [\\\\'store:read\\\\']\\\\n      }\\\\n\\\\n      await wrapper.vm.confirmEmployee()\\\\n      expect(wrapper.vm.employees.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确更新员工\\\\', async () => {\\\\n      await wrapper.vm.loadEmployees()\\\\n      const employee = wrapper.vm.employees[0]\\\\n\\\\n      wrapper.vm.employeeForm = {\\\\n        id: employee.id,\\\\n        employeeCode: employee.employeeCode,\\\\n        name: \\\\'张三（更新）\\\\',\\\\n        gender: employee.gender,\\\\n        phone: employee.phone,\\\\n        email: employee.email,\\\\n        avatar: employee.avatar,\\\\n        storeId: employee.storeId,\\\\n        department: employee.department,\\\\n        position: employee.position,\\\\n        status: employee.status,\\\\n        hireDate: employee.hireDate,\\\\n        salary: 8500,\\\\n        address: employee.address,\\\\n        idCard: employee.idCard,\\\\n        bankAccount: employee.bankAccount,\\\\n        emergencyContact: employee.emergencyContact,\\\\n        permissions: employee.permissions\\\\n      }\\\\n\\\\n      await wrapper.vm.confirmEmployee()\\\\n      expect(wrapper.vm.employees.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确删除员工\\\\', async () => {\\\\n      await wrapper.vm.loadEmployees()\\\\n      const employee = wrapper.vm.employees[0]\\\\n\\\\n      await wrapper.vm.handleDeleteEmployee(employee)\\\\n      expect(wrapper.vm.employees.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确调店员工\\\\', async () => {\\\\n      await wrapper.vm.loadEmployees()\\\\n      const employee = wrapper.vm.employees[0]\\\\n\\\\n      wrapper.vm.transferForm = {\\\\n        targetStoreId: 1,\\\\n        reason: \\\\'调店\\\\',\\\\n        effectiveDate: \\\\'2024-02-01\\\\'\\\\n      }\\\\n\\\\n      await wrapper.vm.confirmTransfer()\\\\n      expect(wrapper.vm.employees.length).toBeGreaterThan(0)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'库存管理流程集成\\\\', () => {\\\\n    it(\\\\'应该正确加载和显示库存\\\\', async () => {\\\\n      await wrapper.vm.loadInventory()\\\\n      expect(wrapper.vm.inventory.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确筛选库存\\\\', async () => {\\\\n      await wrapper.vm.loadInventory()\\\\n\\\\n      wrapper.vm.inventoryFilter.search = \\\\'牛肉\\\\'\\\\n      await wrapper.vm.handleInventorySearch()\\\\n      expect(wrapper.vm.inventory.length).toBeGreaterThan(0)\\\\n\\\\n      wrapper.vm.inventoryFilter.status = InventoryStatus.NORMAL\\\\n      await wrapper.vm.handleInventorySearch()\\\\n      expect(wrapper.vm.inventory.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确补货\\\\', async () => {\\\\n      await wrapper.vm.loadInventory()\\\\n      const inventoryItem = wrapper.vm.inventory[0]\\\\n\\\\n      wrapper.vm.restockForm = {\\\\n        storeId: inventoryItem.storeId,\\\\n        productId: inventoryItem.productId,\\\\n        quantity: 10,\\\\n        costPrice: 50,\\\\n        supplier: { id: 1, name: \\\\'供应商A\\\\', phone: \\\\'13800138001\\\\' },\\\\n        batchNumber: \\\\'BATCH002\\\\',\\\\n        expiryDate: \\\\'2024-03-01\\\\',\\\\n        remarks: \\\\'补货\\\\'\\\\n      }\\\\n\\\\n      await wrapper.vm.confirmRestock()\\\\n      expect(wrapper.vm.inventory.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确调拨库存\\\\', async () => {\\\\n      await wrapper.vm.loadInventory()\\\\n      const inventoryItem = wrapper.vm.inventory[0]\\\\n\\\\n      wrapper.vm.transferInventoryForm = {\\\\n        sourceStoreId: inventoryItem.storeId,\\\\n        targetStoreId: 2,\\\\n        productId: inventoryItem.productId,\\\\n        quantity: 5,\\\\n        reason: \\\\'调拨\\\\',\\\\n        effectiveDate: \\\\'2024-02-01\\\\'\\\\n      }\\\\n\\\\n      await wrapper.vm.confirmTransferInventory()\\\\n      expect(wrapper.vm.inventory.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确盘点库存\\\\', async () => {\\\\n      wrapper.vm.checkForm = {\\\\n        storeId: 1,\\\\n        checkDate: \\\\'2024-01-20\\\\',\\\\n        details: [\\\\n          {\\\\n            productId: 1,\\\\n            actualQuantity: 45,\\\\n            difference: -5,\\\\n            reason: \\\\'损耗\\\\'\\\\n          }\\\\n        ]\\\\n      }\\\\n\\\\n      await wrapper.vm.confirmCheck()\\\\n      expect(wrapper.vm.inventory.length).toBeGreaterThan(0)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'数据统计集成\\\\', () => {\\\\n    it(\\\\'应该正确显示门店统计\\\\', async () => {\\\\n      await wrapper.vm.loadStoreStats()\\\\n      expect(wrapper.vm.storeStats.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示员工绩效\\\\', async () => {\\\\n      await wrapper.vm.loadEmployeePerformance()\\\\n      expect(wrapper.vm.employeePerformance.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确计算总营业额\\\\', () => {\\\\n      const totalRevenue = wrapper.vm.totalRevenue\\\\n      expect(totalRevenue).toBeGreaterThan(0)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'分页集成\\\\', () => {\\\\n    it(\\\\'应该正确处理门店分页\\\\', async () => {\\\\n      await wrapper.vm.loadStores()\\\\n\\\\n      wrapper.vm.storePagination.page = 2\\\\n      await wrapper.vm.handleStorePageChange(2)\\\\n      expect(wrapper.vm.storePagination.page).toBe(2)\\\\n\\\\n      wrapper.vm.storePagination.limit = 50\\\\n      await wrapper.vm.handleStorePageSizeChange(50)\\\\n      expect(wrapper.vm.storePagination.limit).toBe(50)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确处理员工分页\\\\', async () => {\\\\n      await wrapper.vm.loadEmployees()\\\\n\\\\n      wrapper.vm.employeePagination.page = 2\\\\n      await wrapper.vm.handleEmployeePageChange(2)\\\\n      expect(wrapper.vm.employeePagination.page).toBe(2)\\\\n\\\\n      wrapper.vm.employeePagination.limit = 50\\\\n      await wrapper.vm.handleEmployeePageSizeChange(50)\\\\n      expect(wrapper.vm.employeePagination.limit).toBe(50)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确处理库存分页\\\\', async () => {\\\\n      await wrapper.vm.loadInventory()\\\\n\\\\n      wrapper.vm.inventoryPagination.page = 2\\\\n      await wrapper.vm.handleInventoryPageChange(2)\\\\n      expect(wrapper.vm.inventoryPagination.page).toBe(2)\\\\n\\\\n      wrapper.vm.inventoryPagination.limit = 50\\\\n      await wrapper.vm.handleInventoryPageSizeChange(50)\\\\n      expect(wrapper.vm.inventoryPagination.limit).toBe(50)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'错误处理集成\\\\', () => {\\\\n    it(\\\\'应该正确处理API错误\\\\', async () => {\\\\n      const mockAPI = new ChainAPI()\\\\n      vi.mocked(mockAPI.getStores).mockRejectedValueOnce(new Error(\\\\'API错误\\\\'))\\\\n      \\\\n      try {\\\\n        await wrapper.vm.loadStores()\\\\n      } catch (error) {\\\\n        expect(error).toBeDefined()\\\\n      }\\\\n    })\\\\n\\\\n    it(\\\\'应该正确处理网络错误\\\\', async () => {\\\\n      const mockAPI = new ChainAPI()\\\\n      vi.mocked(mockAPI.getStores).mockRejectedValueOnce(new Error(\\\\'网络错误\\\\'))\\\\n      \\\\n      try {\\\\n        await wrapper.vm.loadStores()\\\\n      } catch (error) {\\\\n        expect(error).toBeDefined()\\\\n      }\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'性能集成\\\\', () => {\\\\n    it(\\\\'应该正确处理大量数据\\\\', async () => {\\\\n      const mockStores = Array.from({ length: 1000 }, (_, i) => ({\\\\n        id: i + 1,\\\\n        storeCode: `ST${i + 1}`,\\\\n        name: `门店${i + 1}`,\\\\n        type: StoreType.DIRECT,\\\\n        status: StoreStatus.OPEN,\\\\n        address: `地址${i + 1}`,\\\\n        city: \\\\'北京市\\\\',\\\\n        district: \\\\'朝阳区\\\\',\\\\n        phone: \\\\'010-12345678\\\\',\\\\n        email: \\\\'store@example.com\\\\',\\\\n        manager: {\\\\n          id: 1,\\\\n          name: \\\\'张三\\\\',\\\\n          phone: \\\\'13800138000\\\\',\\\\n          avatar: \\\\'https://example.com/avatar1.jpg\\\\'\\\\n        },\\\\n        businessHours: {\\\\n          monday: { open: \\\\'09:00\\\\', close: \\\\'22:00\\\\', enabled: true },\\\\n          tuesday: { open: \\\\'09:00\\\\', close: \\\\'22:00\\\\', enabled: true },\\\\n          wednesday: { open: \\\\'09:00\\\\', close: \\\\'22:00\\\\', enabled: true },\\\\n          thursday: { open: \\\\'09:00\\\\', close: \\\\'22:00\\\\', enabled: true },\\\\n          friday: { open: \\\\'09:00\\\\', close: \\\\'22:00\\\\', enabled: true },\\\\n          saturday: { open: \\\\'09:00\\\\', close: \\\\'22:00\\\\', enabled: true },\\\\n          sunday: { open: \\\\'09:00\\\\', close: \\\\'22:00\\\\', enabled: true }\\\\n        },\\\\n        area: 200,\\\\n        capacity: 150,\\\\n        tables: 30,\\\\n        employees: 20,\\\\n        coordinates: { latitude: 39.9042, longitude: 116.4074 },\\\\n        facilities: [\\\\'WiFi\\\\', \\\\'空调\\\\', \\\\'停车场\\\\'],\\\\n        description: \\\\'门店描述\\\\',\\\\n        images: [\\\\'https://example.com/store.jpg\\\\'],\\\\n        openingDate: \\\\'2020-01-01\\\\',\\\\n        rating: 4.5,\\\\n        reviewCount: 100,\\\\n        createdAt: \\\\'2020-01-01T00:00:00Z\\\\'\\\\n      }))\\\\n\\\\n      const mockAPI = new ChainAPI()\\\\n      vi.mocked(mockAPI.getStores).mockResolvedValueOnce({\\\\n        success: true,\\\\n        data: {\\\\n          items: mockStores,\\\\n          pagination: {\\\\n            page: 1,\\\\n            limit: 1000,\\\\n            total: 1000,\\\\n            totalPages: 1\\\\n          }\\\\n        }\\\\n      })\\\\n\\\\n      await wrapper.vm.loadStores()\\\\n      expect(wrapper.vm.stores.length).toBe(1000)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确处理实时数据更新\\\\', async () => {\\\\n      await wrapper.vm.loadStores()\\\\n      await wrapper.vm.loadEmployees()\\\\n      await wrapper.vm.loadInventory()\\\\n      await wrapper.vm.loadStoreStats()\\\\n      await wrapper.vm.loadEmployeePerformance()\\\\n\\\\n      await wrapper.vm.loadStores()\\\\n      await wrapper.vm.loadEmployees()\\\\n      await wrapper.vm.loadInventory()\\\\n      await wrapper.vm.loadStoreStats()\\\\n      await wrapper.vm.loadEmployeePerformance()\\\\n\\\\n      expect(wrapper.vm.stores.length).toBeGreaterThan(0)\\\\n      expect(wrapper.vm.employees.length).toBeGreaterThan(0)\\\\n      expect(wrapper.vm.inventory.length).toBeGreaterThan(0)\\\\n      expect(wrapper.vm.storeStats.length).toBeGreaterThan(0)\\\\n      expect(wrapper.vm.employeePerformance.length).toBeGreaterThan(0)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'用户体验集成\\\\', () => {\\\\n    it(\\\\'应该正确显示加载状态\\\\', async () => {\\\\n      wrapper.vm.loading = true\\\\n      await wrapper.vm.$nextTick()\\\\n      expect(wrapper.vm.loading).toBe(true)\\\\n\\\\n      wrapper.vm.loading = false\\\\n      await wrapper.vm.$nextTick()\\\\n      expect(wrapper.vm.loading).toBe(false)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示空状态\\\\', async () => {\\\\n      const mockAPI = new ChainAPI()\\\\n      vi.mocked(mockAPI.getStores).mockResolvedValueOnce({\\\\n        success: true,\\\\n        data: {\\\\n          items: [],\\\\n          pagination: {\\\\n            page: 1,\\\\n            limit: 20,\\\\n            total: 0,\\\\n            totalPages: 0\\\\n          }\\\\n        }\\\\n      })\\\\n\\\\n      await wrapper.vm.loadStores()\\\\n      expect(wrapper.vm.stores.length).toBe(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确显示错误状态\\\\', async () => {\\\\n      const mockAPI = new ChainAPI()\\\\n      vi.mocked(mockAPI.getStores).mockRejectedValueOnce(new Error(\\\\'API错误\\\\'))\\\\n\\\\n      try {\\\\n        await wrapper.vm.loadStores()\\\\n      } catch (error) {\\\\n        expect(error).toBeDefined()\\\\n      }\\\\n    })\\\\n  })\\\\n})\\\\n\",\"originAcceptText\":\"/**\\n * @fileoverview 连锁管理集成测试\\n * @description 测试连锁管理模块的组件交互和数据流\\n * @module ChainManagement.integration.test\\n * @author YYC³\\n * @version 1.0.0\\n * @created 2025-01-20\\n */\\n\\nimport { describe, it, expect, beforeEach, vi } from 'vitest'\\nimport { mount, VueWrapper } from '@vue/test-utils'\\nimport { createPinia, setActivePinia } from 'pinia'\\nimport { createRouter, createMemoryHistory } from 'vue-router'\\nimport ElementPlus from 'element-plus'\\nimport ChainManagement from '@/views/ChainManagement.vue'\\nimport { ChainAPI, StoreType, StoreStatus, EmployeeStatus, InventoryStatus } from '@/api/chain'\\n\\nconst router = createRouter({\\n  history: createMemoryHistory(),\\n  routes: [\\n    { path: '/', component: { template: '<div>Home</div>' } },\\n    { path: '/chain', component: ChainManagement }\\n  ]\\n})\\n\\nvi.mock('@/api/chain', () => ({\\n  ChainAPI: vi.fn().mockImplementation(() => ({\\n    getStores: vi.fn(() => Promise.resolve({\\n      success: true,\\n      data: {\\n        items: [\\n          {\\n            id: 1,\\n            storeCode: 'ST001',\\n            name: '北京朝阳店',\\n            type: StoreType.DIRECT,\\n            status: StoreStatus.OPEN,\\n            address: '北京市朝阳区建国路88号',\\n            city: '北京市',\\n            district: '朝阳区',\\n            phone: '010-12345678',\\n            email: 'beijing@example.com',\\n            manager: {\\n              id: 1,\\n              name: '张三',\\n              phone: '13800138000',\\n              avatar: 'https://example.com/avatar1.jpg'\\n            },\\n            businessHours: {\\n              monday: { open: '09:00', close: '22:00', enabled: true },\\n              tuesday: { open: '09:00', close: '22:00', enabled: true },\\n              wednesday: { open: '09:00', close: '22:00', enabled: true },\\n              thursday: { open: '09:00', close: '22:00', enabled: true },\\n              friday: { open: '09:00', close: '22:00', enabled: true },\\n              saturday: { open: '09:00', close: '22:00', enabled: true },\\n              sunday: { open: '09:00', close: '22:00', enabled: true }\\n            },\\n            area: 200,\\n            capacity: 150,\\n            tables: 30,\\n            employees: 20,\\n            coordinates: { latitude: 39.9042, longitude: 116.4074 },\\n            facilities: ['WiFi', '空调', '停车场'],\\n            description: '北京朝阳店',\\n            images: ['https://example.com/store1.jpg'],\\n            openingDate: '2020-01-01',\\n            rating: 4.5,\\n            reviewCount: 100,\\n            createdAt: '2020-01-01T00:00:00Z'\\n          }\\n        ],\\n        pagination: {\\n          page: 1,\\n          limit: 20,\\n          total: 1,\\n          totalPages: 1\\n        }\\n      }\\n    })),\\n    getEmployees: vi.fn(() => Promise.resolve({\\n      success: true,\\n      data: {\\n        items: [\\n          {\\n            id: 1,\\n            employeeCode: 'EMP001',\\n            name: '张三',\\n            gender: 'male',\\n            phone: '13800138000',\\n            email: 'zhangsan@example.com',\\n            avatar: 'https://example.com/avatar1.jpg',\\n            storeId: 1,\\n            storeName: '北京朝阳店',\\n            department: '前厅',\\n            position: '店长',\\n            status: EmployeeStatus.ACTIVE,\\n            hireDate: '2020-01-01',\\n            salary: 8000,\\n            address: '北京市朝阳区',\\n            idCard: '110101199001011234',\\n            bankAccount: '6222021234567890123',\\n            emergencyContact: {\\n              name: '王五',\\n              phone: '13700137000',\\n              relationship: '配偶'\\n            },\\n            permissions: ['store:read', 'store:write'],\\n            createdAt: '2020-01-01T00:00:00Z'\\n          }\\n        ],\\n        pagination: {\\n          page: 1,\\n          limit: 20,\\n          total: 1,\\n          totalPages: 1\\n        }\\n      }\\n    })),\\n    getInventory: vi.fn(() => Promise.resolve({\\n      success: true,\\n      data: {\\n        items: [\\n          {\\n            id: 1,\\n            storeId: 1,\\n            storeName: '北京朝阳店',\\n            productId: 1,\\n            productName: '牛肉',\\n            productCode: 'PRD001',\\n            category: '食材',\\n            quantity: 50,\\n            unit: '公斤',\\n            minQuantity: 10,\\n            maxQuantity: 100,\\n            costPrice: 50,\\n            status: InventoryStatus.NORMAL,\\n            lastRestockDate: '2024-01-15',\\n            supplier: {\\n              id: 1,\\n              name: '供应商A',\\n              phone: '13800138001'\\n            },\\n            location: '冷藏库A',\\n            batchNumber: 'BATCH001',\\n            expiryDate: '2024-02-01',\\n            createdAt: '2024-01-01T00:00:00Z'\\n          }\\n        ],\\n        pagination: {\\n          page: 1,\\n          limit: 20,\\n          total: 1,\\n          totalPages: 1\\n        }\\n      }\\n    })),\\n    createStore: vi.fn(() => Promise.resolve({\\n      success: true,\\n      data: {\\n        id: 2,\\n        storeCode: 'ST002',\\n        name: '上海浦东店',\\n        type: StoreType.DIRECT,\\n        status: StoreStatus.OPEN,\\n        address: '上海市浦东新区陆家嘴环路1000号',\\n        city: '上海市',\\n        district: '浦东新区',\\n        phone: '021-87654321',\\n        email: 'shanghai@example.com',\\n        manager: {\\n          id: 2,\\n          name: '李四',\\n          phone: '13900139000',\\n          avatar: 'https://example.com/avatar2.jpg'\\n        },\\n        businessHours: {\\n          monday: { open: '09:00', close: '22:00', enabled: true },\\n          tuesday: { open: '09:00', close: '22:00', enabled: true },\\n          wednesday: { open: '09:00', close: '22:00', enabled: true },\\n          thursday: { open: '09:00', close: '22:00', enabled: true },\\n          friday: { open: '09:00', close: '22:00', enabled: true },\\n          saturday: { open: '09:00', close: '22:00', enabled: true },\\n          sunday: { open: '09:00', close: '22:00', enabled: true }\\n        },\\n        area: 180,\\n        capacity: 120,\\n        tables: 25,\\n        employees: 18,\\n        coordinates: { latitude: 31.2304, longitude: 121.4737 },\\n        facilities: ['WiFi', '空调', '停车场'],\\n        description: '上海浦东店',\\n        images: ['https://example.com/store2.jpg'],\\n        openingDate: '2024-01-01',\\n        rating: 0,\\n        reviewCount: 0,\\n        createdAt: '2024-01-01T00:00:00Z'\\n      }\\n    })),\\n    updateStore: vi.fn(() => Promise.resolve({\\n      success: true,\\n      data: {\\n        id: 1,\\n        storeCode: 'ST001',\\n        name: '北京朝阳店（更新）',\\n        type: StoreType.DIRECT,\\n        status: StoreStatus.OPEN,\\n        address: '北京市朝阳区建国路88号',\\n        city: '北京市',\\n        district: '朝阳区',\\n        phone: '010-12345678',\\n        email: 'beijing@example.com',\\n        manager: {\\n          id: 1,\\n          name: '张三',\\n          phone: '13800138000',\\n          avatar: 'https://example.com/avatar1.jpg'\\n        },\\n        businessHours: {\\n          monday: { open: '09:00', close: '22:00', enabled: true },\\n          tuesday: { open: '09:00', close: '22:00', enabled: true },\\n          wednesday: { open: '09:00', close: '22:00', enabled: true },\\n          thursday: { open: '09:00', close: '22:00', enabled: true },\\n          friday: { open: '09:00', close: '22:00', enabled: true },\\n          saturday: { open: '09:00', close: '22:00', enabled: true },\\n          sunday: { open: '09:00', close: '22:00', enabled: true }\\n        },\\n        area: 200,\\n        capacity: 150,\\n        tables: 30,\\n        employees: 20,\\n        coordinates: { latitude: 39.9042, longitude: 116.4074 },\\n        facilities: ['WiFi', '空调', '停车场'],\\n        description: '北京朝阳店（更新）',\\n        images: ['https://example.com/store1.jpg'],\\n        openingDate: '2020-01-01',\\n        rating: 4.5,\\n        reviewCount: 100,\\n        createdAt: '2020-01-01T00:00:00Z'\\n      }\\n    })),\\n    deleteStore: vi.fn(() => Promise.resolve({\\n      success: true\\n    })),\\n    updateStoreStatus: vi.fn(() => Promise.resolve({\\n      success: true\\n    })),\\n    createEmployee: vi.fn(() => Promise.resolve({\\n      success: true,\\n      data: {\\n        id: 2,\\n        employeeCode: 'EMP002',\\n        name: '李四',\\n        gender: 'female',\\n        phone: '13900139000',\\n        email: 'lisi@example.com',\\n        avatar: 'https://example.com/avatar2.jpg',\\n        storeId: 1,\\n        storeName: '北京朝阳店',\\n        department: '前厅',\\n        position: '服务员',\\n        status: EmployeeStatus.ACTIVE,\\n        hireDate: '2024-01-01',\\n        salary: 5000,\\n        address: '北京市朝阳区',\\n        idCard: '310101199401011234',\\n        bankAccount: '6222021234567890124',\\n        emergencyContact: {\\n          name: '赵六',\\n          phone: '13600136000',\\n          relationship: '配偶'\\n        },\\n        permissions: ['store:read'],\\n        createdAt: '2024-01-01T00:00:00Z'\\n      }\\n    })),\\n    updateEmployee: vi.fn(() => Promise.resolve({\\n      success: true,\\n      data: {\\n        id: 1,\\n        employeeCode: 'EMP001',\\n        name: '张三（更新）',\\n        gender: 'male',\\n        phone: '13800138000',\\n        email: 'zhangsan@example.com',\\n        avatar: 'https://example.com/avatar1.jpg',\\n        storeId: 1,\\n        storeName: '北京朝阳店',\\n        department: '前厅',\\n        position: '店长',\\n        status: EmployeeStatus.ACTIVE,\\n        hireDate: '2020-01-01',\\n        salary: 8500,\\n        address: '北京市朝阳区',\\n        idCard: '110101199001011234',\\n        bankAccount: '6222021234567890123',\\n        emergencyContact: {\\n          name: '王五',\\n          phone: '13700137000',\\n          relationship: '配偶'\\n        },\\n        permissions: ['store:read', 'store:write'],\\n        createdAt: '2020-01-01T00:00:00Z'\\n      }\\n    })),\\n    deleteEmployee: vi.fn(() => Promise.resolve({\\n      success: true\\n    })),\\n    transferEmployee: vi.fn(() => Promise.resolve({\\n      success: true\\n    })),\\n    restockInventory: vi.fn(() => Promise.resolve({\\n      success: true\\n    })),\\n    transferInventory: vi.fn(() => Promise.resolve({\\n      success: true\\n    })),\\n    checkInventory: vi.fn(() => Promise.resolve({\\n      success: true\\n    })),\\n    getStoreStatsOverview: vi.fn(() => Promise.resolve({\\n      success: true,\\n      data: [\\n        {\\n          storeId: 1,\\n          storeName: '北京朝阳店',\\n          totalOrders: 1000,\\n          totalRevenue: 500000,\\n          averageOrderValue: 500,\\n          totalCustomers: 800,\\n          customerRetentionRate: 0.8,\\n          employeeCount: 20,\\n          averageRating: 4.5,\\n          dailyStats: [],\\n          monthlyStats: []\\n        }\\n      ]\\n    })),\\n    getEmployeePerformanceOverview: vi.fn(() => Promise.resolve({\\n      success: true,\\n      data: [\\n        {\\n          employeeId: 1,\\n          employeeName: '张三',\\n          storeName: '北京朝阳店',\\n          department: '前厅',\\n          position: '店长',\\n          totalOrders: 200,\\n          totalRevenue: 100000,\\n          averageOrderValue: 500,\\n          customerSatisfaction: 0.9,\\n          attendanceRate: 0.95,\\n          performanceScore: 90,\\n          ranking: 1\\n        }\\n      ]\\n    }))\\n  }))\\n})\\n\\ndescribe('ChainManagement集成测试', () => {\\n  let wrapper: VueWrapper<any>\\n  let pinia: any\\n\\n  beforeEach(() => {\\n    pinia = createPinia()\\n    setActivePinia(pinia)\\n\\n    wrapper = mount(ChainManagement, {\\n      global: {\\n        plugins: [pinia, router, ElementPlus],\\n        stubs: {\\n          'el-card': true,\\n          'el-row': true,\\n          'el-col': true,\\n          'el-tabs': true,\\n          'el-tab-pane': true,\\n          'el-button': true,\\n          'el-button-group': true,\\n          'el-icon': true,\\n          'el-tag': true,\\n          'el-table': true,\\n          'el-table-column': true,\\n          'el-pagination': true,\\n          'el-dialog': true,\\n          'el-form': true,\\n          'el-form-item': true,\\n          'el-input': true,\\n          'el-input-number': true,\\n          'el-select': true,\\n          'el-option': true,\\n          'el-radio': true,\\n          'el-radio-group': true,\\n          'el-date-picker': true,\\n          'el-time-picker': true,\\n          'el-switch': true,\\n          'el-dropdown': true,\\n          'el-dropdown-menu': true,\\n          'el-dropdown-item': true,\\n          'el-rate': true,\\n          'el-avatar': true,\\n          'el-divider': true,\\n          'el-alert': true,\\n          'el-tooltip': true,\\n          'el-popover': true,\\n          'el-progress': true,\\n          'el-statistic': true,\\n          'el-badge': true,\\n          'el-empty': true\\n        }\\n      }\\n    })\\n\\n    router.push('/chain')\\n    vi.clearAllMocks()\\n  })\\n\\n  afterEach(() => {\\n    wrapper.unmount()\\n  })\\n\\n  describe('组件集成', () => {\\n    it('应该正确加载所有数据', async () => {\\n      await wrapper.vm.loadStores()\\n      await wrapper.vm.loadEmployees()\\n      await wrapper.vm.loadInventory()\\n      await wrapper.vm.loadStoreStats()\\n      await wrapper.vm.loadEmployeePerformance()\\n\\n      expect(wrapper.vm.stores.length).toBeGreaterThan(0)\\n      expect(wrapper.vm.employees.length).toBeGreaterThan(0)\\n      expect(wrapper.vm.inventory.length).toBeGreaterThan(0)\\n      expect(wrapper.vm.storeStats.length).toBeGreaterThan(0)\\n      expect(wrapper.vm.employeePerformance.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确显示系统概览', () => {\\n      const statCards = wrapper.findAll('.stat-card')\\n      expect(statCards.length).toBe(4)\\n    })\\n\\n    it('应该正确切换标签页', async () => {\\n      const tabs = wrapper.find('.el-tabs')\\n      expect(tabs.exists()).toBe(true)\\n\\n      wrapper.vm.activeTab = 'employees'\\n      await wrapper.vm.$nextTick()\\n      expect(wrapper.vm.activeTab).toBe('employees')\\n\\n      wrapper.vm.activeTab = 'inventory'\\n      await wrapper.vm.$nextTick()\\n      expect(wrapper.vm.activeTab).toBe('inventory')\\n\\n      wrapper.vm.activeTab = 'stats'\\n      await wrapper.vm.$nextTick()\\n      expect(wrapper.vm.activeTab).toBe('stats')\\n\\n      wrapper.vm.activeTab = 'stores'\\n      await wrapper.vm.$nextTick()\\n      expect(wrapper.vm.activeTab).toBe('stores')\\n    })\\n  })\\n\\n  describe('门店管理流程集成', () => {\\n    it('应该完整处理门店生命周期', async () => {\\n      await wrapper.vm.loadStores()\\n\\n      const activeStore = wrapper.vm.stores.find((s: any) => s.status === StoreStatus.OPEN)\\n      expect(activeStore).toBeDefined()\\n\\n      await wrapper.vm.handleUpdateStoreStatus(activeStore, StoreStatus.CLOSED)\\n      expect(activeStore.status).toBe(StoreStatus.CLOSED)\\n\\n      await wrapper.vm.handleUpdateStoreStatus(activeStore, StoreStatus.OPEN)\\n      expect(activeStore.status).toBe(StoreStatus.OPEN)\\n    })\\n\\n    it('应该正确筛选门店', async () => {\\n      await wrapper.vm.loadStores()\\n      expect(wrapper.vm.stores.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确创建门店', async () => {\\n      wrapper.vm.storeForm = {\\n        id: 0,\\n        storeCode: 'ST002',\\n        name: '上海浦东店',\\n        type: StoreType.DIRECT,\\n        status: StoreStatus.OPEN,\\n        address: '上海市浦东新区陆家嘴环路1000号',\\n        city: '上海市',\\n        district: '浦东新区',\\n        phone: '021-87654321',\\n        email: 'shanghai@example.com',\\n        managerId: 2,\\n        businessHours: {\\n          monday: { open: '09:00', close: '22:00', enabled: true },\\n          tuesday: { open: '09:00', close: '22:00', enabled: true },\\n          wednesday: { open: '09:00', close: '22:00', enabled: true },\\n          thursday: { open: '09:00', close: '22:00', enabled: true },\\n          friday: { open: '09:00', close: '22:00', enabled: true },\\n          saturday: { open: '09:00', close: '22:00', enabled: true },\\n          sunday: { open: '09:00', close: '22:00', enabled: true }\\n        },\\n        area: 180,\\n        capacity: 120,\\n        tables: 25,\\n        coordinates: { latitude: 31.2304, longitude: 121.4737 },\\n        facilities: ['WiFi', '空调', '停车场'],\\n        description: '上海浦东店',\\n        images: ['https://example.com/store2.jpg'],\\n        openingDate: '2024-01-01'\\n      }\\n\\n      await wrapper.vm.confirmStore()\\n      expect(wrapper.vm.stores.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确更新门店', async () => {\\n      await wrapper.vm.loadStores()\\n      const store = wrapper.vm.stores[0]\\n\\n      wrapper.vm.storeForm = {\\n        id: store.id,\\n        storeCode: store.storeCode,\\n        name: '北京朝阳店（更新）',\\n        type: store.type,\\n        status: store.status,\\n        address: store.address,\\n        city: store.city,\\n        district: store.district,\\n        phone: store.phone,\\n        email: store.email,\\n        managerId: store.manager.id,\\n        businessHours: { ...store.businessHours },\\n        area: store.area,\\n        capacity: store.capacity,\\n        tables: store.tables,\\n        coordinates: store.coordinates,\\n        facilities: store.facilities,\\n        description: '北京朝阳店（更新）',\\n        images: store.images,\\n        openingDate: store.openingDate\\n      }\\n\\n      await wrapper.vm.confirmStore()\\n      expect(wrapper.vm.stores.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确删除门店', async () => {\\n      await wrapper.vm.loadStores()\\n      const store = wrapper.vm.stores[0]\\n\\n      await wrapper.vm.handleDeleteStore(store)\\n      expect(wrapper.vm.stores.length).toBeGreaterThan(0)\\n    })\\n  })\\n\\n  describe('员工管理流程集成', () => {\\n    it('应该正确加载和显示员工', async () => {\\n      await wrapper.vm.loadEmployees()\\n      expect(wrapper.vm.employees.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确筛选员工', async () => {\\n      await wrapper.vm.loadEmployees()\\n\\n      wrapper.vm.employeeFilter.search = '张三'\\n      await wrapper.vm.handleEmployeeSearch()\\n      expect(wrapper.vm.employees.length).toBeGreaterThan(0)\\n\\n      wrapper.vm.employeeFilter.storeId = 1\\n      await wrapper.vm.handleEmployeeSearch()\\n      expect(wrapper.vm.employees.length).toBeGreaterThan(0)\\n\\n      wrapper.vm.employeeFilter.status = EmployeeStatus.ACTIVE\\n      await wrapper.vm.handleEmployeeSearch()\\n      expect(wrapper.vm.employees.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确创建员工', async () => {\\n      wrapper.vm.employeeForm = {\\n        id: 0,\\n        employeeCode: 'EMP002',\\n        name: '李四',\\n        gender: 'female',\\n        phone: '13900139000',\\n        email: 'lisi@example.com',\\n        avatar: 'https://example.com/avatar2.jpg',\\n        storeId: 1,\\n        department: '前厅',\\n        position: '服务员',\\n        status: EmployeeStatus.ACTIVE,\\n        hireDate: '2024-01-01',\\n        salary: 5000,\\n        address: '北京市朝阳区',\\n        idCard: '310101199401011234',\\n        bankAccount: '6222021234567890124',\\n        emergencyContact: { name: '赵六', phone: '13600136000', relationship: '配偶' },\\n        permissions: ['store:read']\\n      }\\n\\n      await wrapper.vm.confirmEmployee()\\n      expect(wrapper.vm.employees.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确更新员工', async () => {\\n      await wrapper.vm.loadEmployees()\\n      const employee = wrapper.vm.employees[0]\\n\\n      wrapper.vm.employeeForm = {\\n        id: employee.id,\\n        employeeCode: employee.employeeCode,\\n        name: '张三（更新）',\\n        gender: employee.gender,\\n        phone: employee.phone,\\n        email: employee.email,\\n        avatar: employee.avatar,\\n        storeId: employee.storeId,\\n        department: employee.department,\\n        position: employee.position,\\n        status: employee.status,\\n        hireDate: employee.hireDate,\\n        salary: 8500,\\n        address: employee.address,\\n        idCard: employee.idCard,\\n        bankAccount: employee.bankAccount,\\n        emergencyContact: employee.emergencyContact,\\n        permissions: employee.permissions\\n      }\\n\\n      await wrapper.vm.confirmEmployee()\\n      expect(wrapper.vm.employees.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确删除员工', async () => {\\n      await wrapper.vm.loadEmployees()\\n      const employee = wrapper.vm.employees[0]\\n\\n      await wrapper.vm.handleDeleteEmployee(employee)\\n      expect(wrapper.vm.employees.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确调店员工', async () => {\\n      await wrapper.vm.loadEmployees()\\n      const employee = wrapper.vm.employees[0]\\n\\n      wrapper.vm.transferForm = {\\n        targetStoreId: 1,\\n        reason: '调店',\\n        effectiveDate: '2024-02-01'\\n      }\\n\\n      await wrapper.vm.confirmTransfer()\\n      expect(wrapper.vm.employees.length).toBeGreaterThan(0)\\n    })\\n  })\\n\\n  describe('库存管理流程集成', () => {\\n    it('应该正确加载和显示库存', async () => {\\n      await wrapper.vm.loadInventory()\\n      expect(wrapper.vm.inventory.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确筛选库存', async () => {\\n      await wrapper.vm.loadInventory()\\n\\n      wrapper.vm.inventoryFilter.search = '牛肉'\\n      await wrapper.vm.handleInventorySearch()\\n      expect(wrapper.vm.inventory.length).toBeGreaterThan(0)\\n\\n      wrapper.vm.inventoryFilter.status = InventoryStatus.NORMAL\\n      await wrapper.vm.handleInventorySearch()\\n      expect(wrapper.vm.inventory.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确补货', async () => {\\n      await wrapper.vm.loadInventory()\\n      const inventoryItem = wrapper.vm.inventory[0]\\n\\n      wrapper.vm.restockForm = {\\n        storeId: inventoryItem.storeId,\\n        productId: inventoryItem.productId,\\n        quantity: 10,\\n        costPrice: 50,\\n        supplier: { id: 1, name: '供应商A', phone: '13800138001' },\\n        batchNumber: 'BATCH002',\\n        expiryDate: '2024-03-01',\\n        remarks: '补货'\\n      }\\n\\n      await wrapper.vm.confirmRestock()\\n      expect(wrapper.vm.inventory.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确调拨库存', async () => {\\n      await wrapper.vm.loadInventory()\\n      const inventoryItem = wrapper.vm.inventory[0]\\n\\n      wrapper.vm.transferInventoryForm = {\\n        sourceStoreId: inventoryItem.storeId,\\n        targetStoreId: 2,\\n        productId: inventoryItem.productId,\\n        quantity: 5,\\n        reason: '调拨',\\n        effectiveDate: '2024-02-01'\\n      }\\n\\n      await wrapper.vm.confirmTransferInventory()\\n      expect(wrapper.vm.inventory.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确盘点库存', async () => {\\n      wrapper.vm.checkForm = {\\n        storeId: 1,\\n        checkDate: '2024-01-20',\\n        details: [\\n          {\\n            productId: 1,\\n            actualQuantity: 45,\\n            difference: -5,\\n            reason: '损耗'\\n          }\\n        ]\\n      }\\n\\n      await wrapper.vm.confirmCheck()\\n      expect(wrapper.vm.inventory.length).toBeGreaterThan(0)\\n    })\\n  })\\n\\n  describe('数据统计集成', () => {\\n    it('应该正确显示门店统计', async () => {\\n      await wrapper.vm.loadStoreStats()\\n      expect(wrapper.vm.storeStats.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确显示员工绩效', async () => {\\n      await wrapper.vm.loadEmployeePerformance()\\n      expect(wrapper.vm.employeePerformance.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该正确计算总营业额', () => {\\n      const totalRevenue = wrapper.vm.totalRevenue\\n      expect(totalRevenue).toBeGreaterThan(0)\\n    })\\n  })\\n\\n  describe('分页集成', () => {\\n    it('应该正确处理门店分页', async () => {\\n      await wrapper.vm.loadStores()\\n\\n      wrapper.vm.storePagination.page = 2\\n      await wrapper.vm.handleStorePageChange(2)\\n      expect(wrapper.vm.storePagination.page).toBe(2)\\n\\n      wrapper.vm.storePagination.limit = 50\\n      await wrapper.vm.handleStorePageSizeChange(50)\\n      expect(wrapper.vm.storePagination.limit).toBe(50)\\n    })\\n\\n    it('应该正确处理员工分页', async () => {\\n      await wrapper.vm.loadEmployees()\\n\\n      wrapper.vm.employeePagination.page = 2\\n      await wrapper.vm.handleEmployeePageChange(2)\\n      expect(wrapper.vm.employeePagination.page).toBe(2)\\n\\n      wrapper.vm.employeePagination.limit = 50\\n      await wrapper.vm.handleEmployeePageSizeChange(50)\\n      expect(wrapper.vm.employeePagination.limit).toBe(50)\\n    })\\n\\n    it('应该正确处理库存分页', async () => {\\n      await wrapper.vm.loadInventory()\\n\\n      wrapper.vm.inventoryPagination.page = 2\\n      await wrapper.vm.handleInventoryPageChange(2)\\n      expect(wrapper.vm.inventoryPagination.page).toBe(2)\\n\\n      wrapper.vm.inventoryPagination.limit = 50\\n      await wrapper.vm.handleInventoryPageSizeChange(50)\\n      expect(wrapper.vm.inventoryPagination.limit).toBe(50)\\n    })\\n  })\\n\\n  describe('错误处理集成', () => {\\n    it('应该正确处理API错误', async () => {\\n      const mockAPI = new ChainAPI()\\n      vi.mocked(mockAPI.getStores).mockRejectedValueOnce(new Error('API错误'))\\n      \\n      try {\\n        await wrapper.vm.loadStores()\\n      } catch (error) {\\n        expect(error).toBeDefined()\\n      }\\n    })\\n\\n    it('应该正确处理网络错误', async () => {\\n      const mockAPI = new ChainAPI()\\n      vi.mocked(mockAPI.getStores).mockRejectedValueOnce(new Error('网络错误'))\\n      \\n      try {\\n        await wrapper.vm.loadStores()\\n      } catch (error) {\\n        expect(error).toBeDefined()\\n      }\\n    })\\n  })\\n\\n  describe('性能集成', () => {\\n    it('应该正确处理大量数据', async () => {\\n      const mockStores = Array.from({ length: 1000 }, (_, i) => ({\\n        id: i + 1,\\n        storeCode: `ST${i + 1}`,\\n        name: `门店${i + 1}`,\\n        type: StoreType.DIRECT,\\n        status: StoreStatus.OPEN,\\n        address: `地址${i + 1}`,\\n        city: '北京市',\\n        district: '朝阳区',\\n        phone: '010-12345678',\\n        email: 'store@example.com',\\n        manager: {\\n          id: 1,\\n          name: '张三',\\n          phone: '13800138000',\\n          avatar: 'https://example.com/avatar1.jpg'\\n        },\\n        businessHours: {\\n          monday: { open: '09:00', close: '22:00', enabled: true },\\n          tuesday: { open: '09:00', close: '22:00', enabled: true },\\n          wednesday: { open: '09:00', close: '22:00', enabled: true },\\n          thursday: { open: '09:00', close: '22:00', enabled: true },\\n          friday: { open: '09:00', close: '22:00', enabled: true },\\n          saturday: { open: '09:00', close: '22:00', enabled: true },\\n          sunday: { open: '09:00', close: '22:00', enabled: true }\\n        },\\n        area: 200,\\n        capacity: 150,\\n        tables: 30,\\n        employees: 20,\\n        coordinates: { latitude: 39.9042, longitude: 116.4074 },\\n        facilities: ['WiFi', '空调', '停车场'],\\n        description: '门店描述',\\n        images: ['https://example.com/store.jpg'],\\n        openingDate: '2020-01-01',\\n        rating: 4.5,\\n        reviewCount: 100,\\n        createdAt: '2020-01-01T00:00:00Z'\\n      }))\\n\\n      const mockAPI = new ChainAPI()\\n      vi.mocked(mockAPI.getStores).mockResolvedValueOnce({\\n        success: true,\\n        data: {\\n          items: mockStores,\\n          pagination: {\\n            page: 1,\\n            limit: 1000,\\n            total: 1000,\\n            totalPages: 1\\n          }\\n        }\\n      })\\n\\n      await wrapper.vm.loadStores()\\n      expect(wrapper.vm.stores.length).toBe(1000)\\n    })\\n\\n    it('应该正确处理实时数据更新', async () => {\\n      await wrapper.vm.loadStores()\\n      await wrapper.vm.loadEmployees()\\n      await wrapper.vm.loadInventory()\\n      await wrapper.vm.loadStoreStats()\\n      await wrapper.vm.loadEmployeePerformance()\\n\\n      await wrapper.vm.loadStores()\\n      await wrapper.vm.loadEmployees()\\n      await wrapper.vm.loadInventory()\\n      await wrapper.vm.loadStoreStats()\\n      await wrapper.vm.loadEmployeePerformance()\\n\\n      expect(wrapper.vm.stores.length).toBeGreaterThan(0)\\n      expect(wrapper.vm.employees.length).toBeGreaterThan(0)\\n      expect(wrapper.vm.inventory.length).toBeGreaterThan(0)\\n      expect(wrapper.vm.storeStats.length).toBeGreaterThan(0)\\n      expect(wrapper.vm.employeePerformance.length).toBeGreaterThan(0)\\n    })\\n  })\\n\\n  describe('用户体验集成', () => {\\n    it('应该正确显示加载状态', async () => {\\n      wrapper.vm.loading = true\\n      await wrapper.vm.$nextTick()\\n      expect(wrapper.vm.loading).toBe(true)\\n\\n      wrapper.vm.loading = false\\n      await wrapper.vm.$nextTick()\\n      expect(wrapper.vm.loading).toBe(false)\\n    })\\n\\n    it('应该正确显示空状态', async () => {\\n      const mockAPI = new ChainAPI()\\n      vi.mocked(mockAPI.getStores).mockResolvedValueOnce({\\n        success: true,\\n        data: {\\n          items: [],\\n          pagination: {\\n            page: 1,\\n            limit: 20,\\n            total: 0,\\n            totalPages: 0\\n          }\\n        }\\n      })\\n\\n      await wrapper.vm.loadStores()\\n      expect(wrapper.vm.stores.length).toBe(0)\\n    })\\n\\n    it('应该正确显示错误状态', async () => {\\n      const mockAPI = new ChainAPI()\\n      vi.mocked(mockAPI.getStores).mockRejectedValueOnce(new Error('API错误'))\\n\\n      try {\\n        await wrapper.vm.loadStores()\\n      } catch (error) {\\n        expect(error).toBeDefined()\\n      }\\n    })\\n  })\\n})\\n\",\"originTextLength\":27761,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768884175707}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/docs/YYC3-Cater-Platform-%E6%96%87%E6%A1%A3%E9%97%AD%E7%8E%AF/YYC3-Cater-%E9%9C%80%E6%B1%82%E8%AE%BE%E8%AE%A1%E6%96%87%E6%A1%A3/%E5%8E%A8%E6%88%BF%E7%AE%A1%E7%90%86%E5%8A%9F%E8%83%BD%E6%A8%A1%E5%9D%97%E9%9C%80%E6%B1%82%E5%88%86%E6%9E%90%E4%B8%8E%E8%AE%BE%E8%AE%A1%E6%96%87%E6%A1%A3.md": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":1502,\"character\":1}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":1502,\"character\":1}},\"action\":\"None\",\"isLine\":false,\"originText\":\"# YYC³餐饮管理系统 - 厨房管理功能模块需求分析与设计文档\\\\n\\\\n## 文档信息\\\\n\\\\n| 项目 | 内容 |\\\\n|------|------|\\\\n| 文档名称 | 厨房管理功能模块需求分析与设计文档 |\\\\n| 文档版本 | V1.0.0 |\\\\n| 创建日期 | 2025-01-20 |\\\\n| 作者 | YYC³团队 |\\\\n| 文档状态 | 正式发布 |\\\\n\\\\n## 1. 概述\\\\n\\\\n### 1.1 模块简介\\\\n\\\\n厨房管理模块是YYC³餐饮管理系统的核心运营模块，负责管理厨房设备、厨房员工、厨房任务、厨房库存、厨房卫生、厨房安全等功能。该模块为餐饮企业提供了完整的厨房管理解决方案，实现了厨房运营的标准化、规范化和数字化。\\\\n\\\\n### 1.2 模块目标\\\\n\\\\n- 提供完整的厨房设备管理\\\\n- 实现厨房员工排班和任务分配\\\\n- 支持厨房任务跟踪和进度管理\\\\n- 提供厨房库存实时监控\\\\n- 实现厨房卫生检查和记录\\\\n- 支持厨房安全监控和预警\\\\n- 提供厨房绩效评估和数据分析\\\\n- 确保厨房运营符合食品安全标准\\\\n\\\\n### 1.3 适用范围\\\\n\\\\n本模块适用于YYC³餐饮管理系统的所有版本，支持单店和连锁店的厨房管理。\\\\n\\\\n## 2. 功能需求\\\\n\\\\n### 2.1 厨房设备管理\\\\n\\\\n#### 2.1.1 设备列表\\\\n\\\\n**功能描述**：展示系统中所有厨房设备信息，支持搜索、筛选和分页。\\\\n\\\\n**输入参数**：\\\\n- 关键词：设备名称、设备编号、品牌型号\\\\n- 设备类型：烹饪设备、制冷设备、加工设备、清洗设备、储存设备\\\\n- 状态：正常、维修中、报废\\\\n- 位置：按厨房区域筛选\\\\n- 页码：当前页码\\\\n- 每页数量：每页显示数量\\\\n\\\\n**输出结果**：\\\\n- 设备列表：包含设备基本信息\\\\n- 总数：符合条件的设备总数\\\\n\\\\n**字段说明**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | number | 是 | 设备ID |\\\\n| equipmentCode | string | 是 | 设备编号 |\\\\n| name | string | 是 | 设备名称 |\\\\n| type | string | 是 | 设备类型：cooking/refrigeration/processing/cleaning/storage |\\\\n| brand | string | 是 | 品牌 |\\\\n| model | string | 是 | 型号 |\\\\n| status | string | 是 | 设备状态：normal/maintenance/scrapped |\\\\n| location | string | 是 | 设备位置 |\\\\n| purchaseDate | string | 是 | 购买日期 |\\\\n| warrantyDate | string | 是 | 保修到期日期 |\\\\n| lastMaintenanceDate | string | 是 | 上次维护日期 |\\\\n| nextMaintenanceDate | string | 是 | 下次维护日期 |\\\\n| maintenanceInterval | number | 是 | 维护间隔（天） |\\\\n| power | number | 是 | 功率（瓦） |\\\\n| specifications | object | 是 | 技术规格 |\\\\n| images | array | 否 | 设备图片 |\\\\n| description | string | 否 | 设备描述 |\\\\n| responsiblePerson | object | 是 | 负责人信息 |\\\\n| createdAt | string | 是 | 创建时间 |\\\\n| updatedAt | string | 否 | 更新时间 |\\\\n\\\\n**技术规格字段**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| capacity | string | 否 | 容量 |\\\\n| temperature | object | 否 | 温度范围 |\\\\n| dimensions | object | 否 | 尺寸 |\\\\n| weight | number | 否 | 重量（公斤） |\\\\n| material | string | 否 | 材质 |\\\\n\\\\n**负责人信息字段**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | number | 是 | 员工ID |\\\\n| name | string | 是 | 姓名 |\\\\n| phone | string | 是 | 电话 |\\\\n\\\\n#### 2.1.2 创建设备\\\\n\\\\n**功能描述**：创建新的厨房设备记录。\\\\n\\\\n**输入参数**：\\\\n- 设备编号：唯一标识\\\\n- 设备名称：设备名称\\\\n- 设备类型：选择设备类型\\\\n- 品牌：设备品牌\\\\n- 型号：设备型号\\\\n- 设备位置：设备所在位置\\\\n- 购买日期：购买日期\\\\n- 保修到期日期：保修到期日期\\\\n- 维护间隔：维护间隔天数\\\\n- 功率：设备功率\\\\n- 技术规格：技术规格信息\\\\n- 设备描述：设备描述\\\\n- 负责人：设备负责人\\\\n- 设备图片：设备图片\\\\n\\\\n**输出结果**：\\\\n- 成功：返回创建的设备信息\\\\n- 失败：返回错误信息\\\\n\\\\n**验证规则**：\\\\n- 设备编号不能为空且唯一\\\\n- 设备名称不能为空\\\\n- 设备类型必须选择\\\\n- 品牌不能为空\\\\n- 型号不能为空\\\\n- 购买日期不能晚于当前日期\\\\n- 保修到期日期必须晚于购买日期\\\\n- 维护间隔必须大于0\\\\n- 功率必须大于0\\\\n\\\\n#### 2.1.3 更新设备\\\\n\\\\n**功能描述**：更新已有厨房设备信息。\\\\n\\\\n**输入参数**：\\\\n- 设备ID：要更新的设备ID\\\\n- 其他字段：同创建设备\\\\n\\\\n**输出结果**：\\\\n- 成功：返回更新后的设备信息\\\\n- 失败：返回错误信息\\\\n\\\\n**验证规则**：\\\\n- 设备ID必须存在\\\\n- 其他验证规则同创建设备\\\\n\\\\n#### 2.1.4 删除设备\\\\n\\\\n**功能描述**：删除厨房设备记录。\\\\n\\\\n**输入参数**：\\\\n- 设备ID：要删除的设备ID\\\\n\\\\n**输出结果**：\\\\n- 成功：返回删除成功信息\\\\n- 失败：返回错误信息\\\\n\\\\n**验证规则**：\\\\n- 设备ID必须存在\\\\n- 设备状态不能为\\\\\\\"正常\\\\\\\"时才能删除\\\\n\\\\n#### 2.1.5 设备状态管理\\\\n\\\\n**功能描述**：更新设备状态（正常、维修中、报废）。\\\\n\\\\n**输入参数**：\\\\n- 设备ID：设备ID\\\\n- 状态：新状态\\\\n- 备注：状态变更备注\\\\n\\\\n**输出结果**：\\\\n- 成功：返回更新后的设备信息\\\\n- 失败：返回错误信息\\\\n\\\\n**验证规则**：\\\\n- 设备ID必须存在\\\\n- 状态必须为有效值\\\\n- 设备状态为\\\\\\\"报废\\\\\\\"时不能恢复为\\\\\\\"正常\\\\\\\"\\\\n\\\\n#### 2.1.6 设备维护记录\\\\n\\\\n**功能描述**：记录设备维护信息。\\\\n\\\\n**输入参数**：\\\\n- 设备ID：设备ID\\\\n- 维护类型：常规维护、故障维修\\\\n- 维护内容：维护内容描述\\\\n- 维护人员：维护人员\\\\n- 维护日期：维护日期\\\\n- 维护费用：维护费用\\\\n- 备注：备注信息\\\\n\\\\n**输出结果**：\\\\n- 成功：返回维护记录信息\\\\n- 失败：返回错误信息\\\\n\\\\n**验证规则**：\\\\n- 设备ID必须存在\\\\n- 维护类型必须选择\\\\n- 维护内容不能为空\\\\n- 维护人员不能为空\\\\n- 维护日期不能晚于当前日期\\\\n- 维护费用必须大于等于0\\\\n\\\\n#### 2.1.7 设备维护提醒\\\\n\\\\n**功能描述**：系统自动提醒即将到期的设备维护。\\\\n\\\\n**触发条件**：\\\\n- 设备下次维护日期在7天内\\\\n- 设备上次维护日期已超过维护间隔\\\\n\\\\n**提醒方式**：\\\\n- 系统内通知\\\\n- 邮件通知\\\\n- 短信通知（可选）\\\\n\\\\n### 2.2 厨房员工管理\\\\n\\\\n#### 2.2.1 员工列表\\\\n\\\\n**功能描述**：展示厨房员工信息，支持搜索、筛选和分页。\\\\n\\\\n**输入参数**：\\\\n- 关键词：员工姓名、员工编号、电话\\\\n- 岗位：厨师长、主厨、副主厨、厨师、帮厨、洗碗工\\\\n- 状态：在职、离职、请假\\\\n- 技能：按技能筛选\\\\n- 页码：当前页码\\\\n- 每页数量：每页显示数量\\\\n\\\\n**输出结果**：\\\\n- 员工列表：包含员工基本信息\\\\n- 总数：符合条件的员工总数\\\\n\\\\n**字段说明**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | number | 是 | 员工ID |\\\\n| employeeCode | string | 是 | 员工编号 |\\\\n| name | string | 是 | 姓名 |\\\\n| gender | string | 是 | 性别：male/female |\\\\n| age | number | 是 | 年龄 |\\\\n| phone | string | 是 | 电话 |\\\\n| email | string | 否 | 邮箱 |\\\\n| avatar | string | 否 | 头像 |\\\\n| position | string | 是 | 岗位：head_chef/sous_chef/chef/assistant/dishwasher |\\\\n| level | string | 是 | 级别：senior/middle/junior |\\\\n| status | string | 是 | 状态：active/resigned/leave |\\\\n| skills | array | 是 | 技能列表 |\\\\n| certifications | array | 否 | 证书列表 |\\\\n| hireDate | string | 是 | 入职日期 |\\\\n| salary | number | 是 | 薪资 |\\\\n| workHours | object | 是 | 工作时间 |\\\\n| performance | object | 否 | 绩效数据 |\\\\n| createdAt | string | 是 | 创建时间 |\\\\n| updatedAt | string | 否 | 更新时间 |\\\\n\\\\n**技能字段**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | number | 是 | 技能ID |\\\\n| name | string | 是 | 技能名称 |\\\\n| level | string | 是 | 技能等级：expert/proficient/basic |\\\\n\\\\n**证书字段**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | number | 是 | 证书ID |\\\\n| name | string | 是 | 证书名称 |\\\\n| number | string | 是 | 证书编号 |\\\\n| issueDate | string | 是 | 发证日期 |\\\\n| expiryDate | string | 是 | 到期日期 |\\\\n| issuer | string | 是 | 发证机构 |\\\\n\\\\n**工作时间字段**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| workDays | array | 是 | 工作日 |\\\\n| startTime | string | 是 | 开始时间 |\\\\n| endTime | string | 是 | 结束时间 |\\\\n| breakTime | array | 否 | 休息时间 |\\\\n\\\\n**绩效数据字段**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| rating | number | 是 | 评分（0-5） |\\\\n| completedTasks | number | 是 | 完成任务数 |\\\\n| qualityScore | number | 是 | 质量评分 |\\\\n| efficiencyScore | number | 是 | 效率评分 |\\\\n\\\\n#### 2.2.2 创建员工\\\\n\\\\n**功能描述**：创建新的厨房员工记录。\\\\n\\\\n**输入参数**：\\\\n- 员工编号：唯一标识\\\\n- 姓名：员工姓名\\\\n- 性别：性别\\\\n- 年龄：年龄\\\\n- 电话：联系电话\\\\n- 邮箱：邮箱地址\\\\n- 岗位：选择岗位\\\\n- 级别：选择级别\\\\n- 技能：技能列表\\\\n- 证书：证书列表\\\\n- 入职日期：入职日期\\\\n- 薪资：薪资\\\\n- 工作时间：工作时间安排\\\\n\\\\n**输出结果**：\\\\n- 成功：返回创建的员工信息\\\\n- 失败：返回错误信息\\\\n\\\\n**验证规则**：\\\\n- 员工编号不能为空且唯一\\\\n- 姓名不能为空\\\\n- 性别必须选择\\\\n- 年龄必须在18-65之间\\\\n- 电话不能为空且格式正确\\\\n- 邮箱格式必须正确（如果提供）\\\\n- 岗位必须选择\\\\n- 级别必须选择\\\\n- 入职日期不能晚于当前日期\\\\n- 薪资必须大于0\\\\n- 工作时间必须完整\\\\n\\\\n#### 2.2.3 更新员工\\\\n\\\\n**功能描述**：更新已有厨房员工信息。\\\\n\\\\n**输入参数**：\\\\n- 员工ID：要更新的员工ID\\\\n- 其他字段：同创建员工\\\\n\\\\n**输出结果**：\\\\n- 成功：返回更新后的员工信息\\\\n- 失败：返回错误信息\\\\n\\\\n**验证规则**：\\\\n- 员工ID必须存在\\\\n- 其他验证规则同创建员工\\\\n\\\\n#### 2.2.4 删除员工\\\\n\\\\n**功能描述**：删除厨房员工记录。\\\\n\\\\n**输入参数**：\\\\n- 员工ID：要删除的员工ID\\\\n\\\\n**输出结果**：\\\\n- 成功：返回删除成功信息\\\\n- 失败：返回错误信息\\\\n\\\\n**验证规则**：\\\\n- 员工ID必须存在\\\\n- 员工状态不能为\\\\\\\"在职\\\\\\\"时才能删除\\\\n\\\\n#### 2.2.5 员工排班管理\\\\n\\\\n**功能描述**：管理员工排班信息。\\\\n\\\\n**输入参数**：\\\\n- 员工ID：员工ID\\\\n- 排班日期：排班日期\\\\n- 班次：早班、中班、晚班\\\\n- 工作时间：具体工作时间\\\\n- 备注：备注信息\\\\n\\\\n**输出结果**：\\\\n- 成功：返回排班信息\\\\n- 失败：返回错误信息\\\\n\\\\n**验证规则**：\\\\n- 员工ID必须存在\\\\n- 排班日期不能早于当前日期\\\\n- 班次必须选择\\\\n- 工作时间必须完整\\\\n\\\\n#### 2.2.6 员工绩效评估\\\\n\\\\n**功能描述**：评估员工绩效。\\\\n\\\\n**输入参数**：\\\\n- 员工ID：员工ID\\\\n- 评估周期：评估周期（月度、季度、年度）\\\\n- 评分：评分（0-5）\\\\n- 完成任务数：完成任务数\\\\n- 质量评分：质量评分\\\\n- 效率评分：效率评分\\\\n- 评语：评语\\\\n\\\\n**输出结果**：\\\\n- 成功：返回绩效评估信息\\\\n- 失败：返回错误信息\\\\n\\\\n**验证规则**：\\\\n- 员工ID必须存在\\\\n- 评估周期必须选择\\\\n- 评分必须在0-5之间\\\\n- 完成任务数必须大于等于0\\\\n- 质量评分必须在0-5之间\\\\n- 效率评分必须在0-5之间\\\\n\\\\n### 2.3 厨房任务管理\\\\n\\\\n#### 2.3.1 任务列表\\\\n\\\\n**功能描述**：展示厨房任务信息，支持搜索、筛选和分页。\\\\n\\\\n**输入参数**：\\\\n- 关键词：任务名称、任务编号\\\\n- 任务类型：烹饪任务、准备任务、清洁任务、维护任务\\\\n- 状态：待处理、进行中、已完成、已取消\\\\n- 优先级：高、中、低\\\\n- 分配给：按员工筛选\\\\n- 日期范围：按日期筛选\\\\n- 页码：当前页码\\\\n- 每页数量：每页显示数量\\\\n\\\\n**输出结果**：\\\\n- 任务列表：包含任务基本信息\\\\n- 总数：符合条件的任务总数\\\\n\\\\n**字段说明**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | number | 是 | 任务ID |\\\\n| taskCode | string | 是 | 任务编号 |\\\\n| name | string | 是 | 任务名称 |\\\\n| type | string | 是 | 任务类型：cooking/preparation/cleaning/maintenance |\\\\n| status | string | 是 | 状态：pending/in_progress/completed/cancelled |\\\\n| priority | string | 是 | 优先级：high/medium/low |\\\\n| description | string | 是 | 任务描述 |\\\\n| assignedTo | object | 是 | 分配给 |\\\\n| createdBy | object | 是 | 创建人 |\\\\n| startTime | string | 是 | 开始时间 |\\\\n| endTime | string | 否 | 结束时间 |\\\\n| estimatedDuration | number | 是 | 预计时长（分钟） |\\\\n| actualDuration | number | 否 | 实际时长（分钟） |\\\\n| orderItems | array | 否 | 关联订单项 |\\\\n| materials | array | 否 | 所需材料 |\\\\n| steps | array | 否 | 任务步骤 |\\\\n| notes | string | 否 | 备注 |\\\\n| createdAt | string | 是 | 创建时间 |\\\\n| updatedAt | string | 否 | 更新时间 |\\\\n\\\\n**分配给字段**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | number | 是 | 员工ID |\\\\n| name | string | 是 | 姓名 |\\\\n| avatar | string | 否 | 头像 |\\\\n\\\\n**创建人字段**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | number | 是 | 员工ID |\\\\n| name | string | 是 | 姓名 |\\\\n\\\\n**订单项字段**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | number | 是 | 订单项ID |\\\\n| orderId | number | 是 | 订单ID |\\\\n| dishName | string | 是 | 菜品名称 |\\\\n| quantity | number | 是 | 数量 |\\\\n| specifications | string | 否 | 规格要求 |\\\\n\\\\n**材料字段**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | number | 是 | 材料ID |\\\\n| name | string | 是 | 材料名称 |\\\\n| quantity | number | 是 | 数量 |\\\\n| unit | string | 是 | 单位 |\\\\n\\\\n**步骤字段**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | number | 是 | 步骤ID |\\\\n| sequence | number | 是 | 顺序 |\\\\n| description | string | 是 | 描述 |\\\\n| estimatedTime | number | 是 | 预计时间（分钟） |\\\\n\\\\n#### 2.3.2 创建任务\\\\n\\\\n**功能描述**：创建新的厨房任务。\\\\n\\\\n**输入参数**：\\\\n- 任务编号：唯一标识\\\\n- 任务名称：任务名称\\\\n- 任务类型：选择任务类型\\\\n- 优先级：选择优先级\\\\n- 任务描述：任务描述\\\\n- 分配给：选择员工\\\\n- 开始时间：开始时间\\\\n- 预计时长：预计时长\\\\n- 关联订单项：关联订单项\\\\n- 所需材料：所需材料\\\\n- 任务步骤：任务步骤\\\\n- 备注：备注\\\\n\\\\n**输出结果**：\\\\n- 成功：返回创建的任务信息\\\\n- 失败：返回错误信息\\\\n\\\\n**验证规则**：\\\\n- 任务编号不能为空且唯一\\\\n- 任务名称不能为空\\\\n- 任务类型必须选择\\\\n- 优先级必须选择\\\\n- 任务描述不能为空\\\\n- 分配给必须选择\\\\n- 开始时间不能早于当前时间\\\\n- 预计时长必须大于0\\\\n\\\\n#### 2.3.3 更新任务\\\\n\\\\n**功能描述**：更新已有厨房任务信息。\\\\n\\\\n**输入参数**：\\\\n- 任务ID：要更新的任务ID\\\\n- 其他字段：同创建任务\\\\n\\\\n**输出结果**：\\\\n- 成功：返回更新后的任务信息\\\\n- 失败：返回错误信息\\\\n\\\\n**验证规则**：\\\\n- 任务ID必须存在\\\\n- 其他验证规则同创建任务\\\\n\\\\n#### 2.3.4 删除任务\\\\n\\\\n**功能描述**：删除厨房任务记录。\\\\n\\\\n**输入参数**：\\\\n- 任务ID：要删除的任务ID\\\\n\\\\n**输出结果**：\\\\n- 成功：返回删除成功信息\\\\n- 失败：返回错误信息\\\\n\\\\n**验证规则**：\\\\n- 任务ID必须存在\\\\n- 任务状态不能为\\\\\\\"进行中\\\\\\\"时才能删除\\\\n\\\\n#### 2.3.5 任务状态管理\\\\n\\\\n**功能描述**：更新任务状态（待处理、进行中、已完成、已取消）。\\\\n\\\\n**输入参数**：\\\\n- 任务ID：任务ID\\\\n- 状态：新状态\\\\n- 备注：状态变更备注\\\\n\\\\n**输出结果**：\\\\n- 成功：返回更新后的任务信息\\\\n- 失败：返回错误信息\\\\n\\\\n**验证规则**：\\\\n- 任务ID必须存在\\\\n- 状态必须为有效值\\\\n- 任务状态流转必须符合业务规则\\\\n\\\\n#### 2.3.6 任务进度跟踪\\\\n\\\\n**功能描述**：跟踪任务执行进度。\\\\n\\\\n**输入参数**：\\\\n- 任务ID：任务ID\\\\n- 当前步骤：当前执行步骤\\\\n- 完成进度：完成进度（0-100%）\\\\n- 实际时长：实际时长\\\\n- 备注：备注\\\\n\\\\n**输出结果**：\\\\n- 成功：返回进度更新信息\\\\n- 失败：返回错误信息\\\\n\\\\n**验证规则**：\\\\n- 任务ID必须存在\\\\n- 完成进度必须在0-100之间\\\\n- 实际时长必须大于等于0\\\\n\\\\n#### 2.3.7 任务提醒\\\\n\\\\n**功能描述**：系统自动提醒即将到期的任务。\\\\n\\\\n**触发条件**：\\\\n- 任务开始时间在15分钟内\\\\n- 任务预计时长即将到期\\\\n- 任务超时未完成\\\\n\\\\n**提醒方式**：\\\\n- 系统内通知\\\\n- 声音提醒\\\\n- 短信通知（可选）\\\\n\\\\n### 2.4 厨房库存管理\\\\n\\\\n#### 2.4.1 库存列表\\\\n\\\\n**功能描述**：展示厨房库存信息，支持搜索、筛选和分页。\\\\n\\\\n**输入参数**：\\\\n- 关键词：材料名称、材料编号\\\\n- 材料类型：食材、调料、包装材料\\\\n- 分类：按分类筛选\\\\n- 状态：充足、不足、过期\\\\n- 页码：当前页码\\\\n- 每页数量：每页显示数量\\\\n\\\\n**输出结果**：\\\\n- 库存列表：包含库存基本信息\\\\n- 总数：符合条件的库存总数\\\\n\\\\n**字段说明**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | number | 是 | 库存ID |\\\\n| materialCode | string | 是 | 材料编号 |\\\\n| name | string | 是 | 材料名称 |\\\\n| type | string | 是 | 材料类型：ingredient/seasoning/packaging |\\\\n| category | string | 是 | 分类 |\\\\n| unit | string | 是 | 单位 |\\\\n| quantity | number | 是 | 当前数量 |\\\\n| minQuantity | number | 是 | 最小库存量 |\\\\n| maxQuantity | number | 是 | 最大库存量 |\\\\n| status | string | 是 | 状态：sufficient/insufficient/expired |\\\\n| purchasePrice | number | 是 | 采购价格 |\\\\n| supplier | object | 是 | 供应商信息 |\\\\n| storageLocation | string | 是 | 存储位置 |\\\\n| expiryDate | string | 是 | 到期日期 |\\\\n| batchNumber | string | 是 | 批次号 |\\\\n| lastStockInDate | string | 是 | 上次入库日期 |\\\\n| lastStockOutDate | string | 否 | 上次出库日期 |\\\\n| images | array | 否 | 材料图片 |\\\\n| description | string | 否 | 材料描述 |\\\\n| createdAt | string | 是 | 创建时间 |\\\\n| updatedAt | string | 否 | 更新时间 |\\\\n\\\\n**供应商信息字段**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | number | 是 | 供应商ID |\\\\n| name | string | 是 | 供应商名称 |\\\\n| contact | string | 是 | 联系人 |\\\\n| phone | string | 是 | 电话 |\\\\n\\\\n#### 2.4.2 入库管理\\\\n\\\\n**功能描述**：记录材料入库信息。\\\\n\\\\n**输入参数**：\\\\n- 材料ID：材料ID\\\\n- 入库数量：入库数量\\\\n- 入库日期：入库日期\\\\n- 批次号：批次号\\\\n- 到期日期：到期日期\\\\n- 供应商：供应商\\\\n- 采购价格：采购价格\\\\n- 备注：备注\\\\n\\\\n**输出结果**：\\\\n- 成功：返回入库记录信息\\\\n- 失败：返回错误信息\\\\n\\\\n**验证规则**：\\\\n- 材料ID必须存在\\\\n- 入库数量必须大于0\\\\n- 入库日期不能晚于当前日期\\\\n- 批次号不能为空\\\\n- 到期日期必须晚于当前日期\\\\n- 采购价格必须大于0\\\\n\\\\n#### 2.4.3 出库管理\\\\n\\\\n**功能描述**：记录材料出库信息。\\\\n\\\\n**输入参数**：\\\\n- 材料ID：材料ID\\\\n- 出库数量：出库数量\\\\n- 出库日期：出库日期\\\\n- 用途：用途\\\\n- 使用人：使用人\\\\n- 备注：备注\\\\n\\\\n**输出结果**：\\\\n- 成功：返回出库记录信息\\\\n- 失败：返回错误信息\\\\n\\\\n**验证规则**：\\\\n- 材料ID必须存在\\\\n- 出库数量必须大于0\\\\n- 出库数量不能大于当前库存量\\\\n- 出库日期不能晚于当前日期\\\\n- 用途不能为空\\\\n- 使用人不能为空\\\\n\\\\n#### 2.4.4 库存盘点\\\\n\\\\n**功能描述**：进行库存盘点。\\\\n\\\\n**输入参数**：\\\\n- 盘点日期：盘点日期\\\\n- 盘点人：盘点人\\\\n- 盘点明细：盘点明细列表\\\\n\\\\n**输出结果**：\\\\n- 成功：返回盘点记录信息\\\\n- 失败：返回错误信息\\\\n\\\\n**盘点明细字段**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| materialId | number | 是 | 材料ID |\\\\n| systemQuantity | number | 是 | 系统数量 |\\\\n| actualQuantity | number | 是 | 实际数量 |\\\\n| difference | number | 是 | 差异 |\\\\n| reason | string | 否 | 差异原因 |\\\\n\\\\n**验证规则**：\\\\n- 盘点日期不能晚于当前日期\\\\n- 盘点人不能为空\\\\n- 盘点明细不能为空\\\\n\\\\n#### 2.4.5 库存预警\\\\n\\\\n**功能描述**：系统自动预警库存不足或即将过期的材料。\\\\n\\\\n**触发条件**：\\\\n- 材料数量小于最小库存量\\\\n- 材料到期日期在7天内\\\\n- 材料已过期\\\\n\\\\n**预警方式**：\\\\n- 系统内通知\\\\n- 邮件通知\\\\n- 短信通知（可选）\\\\n\\\\n### 2.5 厨房卫生管理\\\\n\\\\n#### 2.5.1 卫生检查列表\\\\n\\\\n**功能描述**：展示厨房卫生检查记录，支持搜索、筛选和分页。\\\\n\\\\n**输入参数**：\\\\n- 关键词：检查编号、检查人\\\\n- 检查类型：日常检查、周检查、月检查\\\\n- 检查区域：按区域筛选\\\\n- 检查结果：合格、不合格\\\\n- 日期范围：按日期筛选\\\\n- 页码：当前页码\\\\n- 每页数量：每页显示数量\\\\n\\\\n**输出结果**：\\\\n- 检查列表：包含检查基本信息\\\\n- 总数：符合条件的检查总数\\\\n\\\\n**字段说明**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | number | 是 | 检查ID |\\\\n| checkCode | string | 是 | 检查编号 |\\\\n| type | string | 是 | 检查类型：daily/weekly/monthly |\\\\n| area | string | 是 | 检查区域 |\\\\n| checker | object | 是 | 检查人 |\\\\n| checkDate | string | 是 | 检查日期 |\\\\n| result | string | 是 | 检查结果：passed/failed |\\\\n| score | number | 是 | 评分（0-100） |\\\\n| items | array | 是 | 检查项列表 |\\\\n| issues | array | 否 | 发现问题 |\\\\n| photos | array | 否 | 检查照片 |\\\\n| remarks | string | 否 | 备注 |\\\\n| createdAt | string | 是 | 创建时间 |\\\\n| updatedAt | string | 否 | 更新时间 |\\\\n\\\\n**检查人字段**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | number | 是 | 员工ID |\\\\n| name | string | 是 | 姓名 |\\\\n\\\\n**检查项字段**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | number | 是 | 检查项ID |\\\\n| name | string | 是 | 检查项名称 |\\\\n| standard | string | 是 | 检查标准 |\\\\n| result | string | 是 | 结果：passed/failed |\\\\n| score | number | 是 | 得分 |\\\\n| remarks | string | 否 | 备注 |\\\\n\\\\n**发现问题字段**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | number | 是 | 问题ID |\\\\n| description | string | 是 | 问题描述 |\\\\n| severity | string | 是 | 严重程度：high/medium/low |\\\\n| status | string | 是 | 状态：pending/in_progress/resolved |\\\\n| assignedTo | object | 否 | 负责人 |\\\\n| dueDate | string | 否 | 截止日期 |\\\\n\\\\n#### 2.5.2 创建检查记录\\\\n\\\\n**功能描述**：创建新的卫生检查记录。\\\\n\\\\n**输入参数**：\\\\n- 检查编号：唯一标识\\\\n- 检查类型：选择检查类型\\\\n- 检查区域：选择检查区域\\\\n- 检查日期：检查日期\\\\n- 检查项：检查项列表\\\\n- 检查照片：检查照片\\\\n- 备注：备注\\\\n\\\\n**输出结果**：\\\\n- 成功：返回创建的检查记录信息\\\\n- 失败：返回错误信息\\\\n\\\\n**验证规则**：\\\\n- 检查编号不能为空且唯一\\\\n- 检查类型必须选择\\\\n- 检查区域必须选择\\\\n- 检查日期不能晚于当前日期\\\\n- 检查项不能为空\\\\n\\\\n#### 2.5.3 更新检查记录\\\\n\\\\n**功能描述**：更新已有卫生检查记录。\\\\n\\\\n**输入参数**：\\\\n- 检查ID：要更新的检查ID\\\\n- 其他字段：同创建检查记录\\\\n\\\\n**输出结果**：\\\\n- 成功：返回更新后的检查记录信息\\\\n- 失败：返回错误信息\\\\n\\\\n**验证规则**：\\\\n- 检查ID必须存在\\\\n- 其他验证规则同创建检查记录\\\\n\\\\n#### 2.5.4 问题跟踪\\\\n\\\\n**功能描述**：跟踪卫生检查发现的问题。\\\\n\\\\n**输入参数**：\\\\n- 问题ID：问题ID\\\\n- 状态：新状态\\\\n- 负责人：负责人\\\\n- 截止日期：截止日期\\\\n- 处理措施：处理措施\\\\n- 备注：备注\\\\n\\\\n**输出结果**：\\\\n- 成功：返回问题更新信息\\\\n- 失败：返回错误信息\\\\n\\\\n**验证规则**：\\\\n- 问题ID必须存在\\\\n- 状态必须为有效值\\\\n- 截止日期必须晚于当前日期\\\\n\\\\n#### 2.5.5 卫生检查提醒\\\\n\\\\n**功能描述**：系统自动提醒即将到期的卫生检查。\\\\n\\\\n**触发条件**：\\\\n- 日常检查：每天固定时间提醒\\\\n- 周检查：每周固定时间提醒\\\\n- 月检查：每月固定时间提醒\\\\n\\\\n**提醒方式**：\\\\n- 系统内通知\\\\n- 邮件通知\\\\n- 短信通知（可选）\\\\n\\\\n### 2.6 厨房安全管理\\\\n\\\\n#### 2.6.1 安全检查列表\\\\n\\\\n**功能描述**：展示厨房安全检查记录，支持搜索、筛选和分页。\\\\n\\\\n**输入参数**：\\\\n- 关键词：检查编号、检查人\\\\n- 检查类型：日常检查、周检查、月检查、专项检查\\\\n- 检查项目：按项目筛选\\\\n- 检查结果：合格、不合格\\\\n- 日期范围：按日期筛选\\\\n- 页码：当前页码\\\\n- 每页数量：每页显示数量\\\\n\\\\n**输出结果**：\\\\n- 检查列表：包含检查基本信息\\\\n- 总数：符合条件的检查总数\\\\n\\\\n**字段说明**：\\\\n| 字段名 | 类型 | 必填 | 说明 |\\\\n|--------|------|------|------|\\\\n| id | number | 是 | 检查ID |\\\\n| checkCode | string | 是 | 检查编号 |\\\\n| type | string | 是 | 检查类型：daily/weekly/monthly/special |\\\\n| project | string | 是 | 检查项目 |\\\\n| checker | object | 是 | 检查人 |\\\\n| checkDate | string | 是 | 检查日期 |\\\\n| result | string | 是 | 检查结果：passed/failed |\\\\n| items | array | 是 | 检查项列表 |\\\\n| risks | array | 否 | 发现风险 |\\\\n| photos | array | 否 | 检查照片 |\\\\n| remarks | string | 否 | 备注 |\\\\n| createdAt | string | 是 | 创建时间 |\\\\n| updatedAt | string | 否 | 更新时间 |\\\\n\\\\n**检查项目类型**：\\\\n- 消防安全\\\\n- 用电安全\\\\n- 燃气安全\\\\n- 设备安全\\\\n- 食品安全\\\\n- 人员安全\\\\n\\\\n#### 2.6.2 创建安全检查记录\\\\n\\\\n**功能描述**：创建新的安全检查记录。\\\\n\\\\n**输入参数**：\\\\n- 检查编号：唯一标识\\\\n- 检查类型：选择检查类型\\\\n- 检查项目：选择检查项目\\\\n- 检查日期：检查日期\\\\n- 检查项：检查项列表\\\\n- 检查照片：检查照片\\\\n- 备注：备注\\\\n\\\\n**输出结果**：\\\\n- 成功：返回创建的检查记录信息\\\\n- 失败：返回错误信息\\\\n\\\\n**验证规则**：\\\\n- 检查编号不能为空且唯一\\\\n- 检查类型必须选择\\\\n- 检查项目必须选择\\\\n- 检查日期不能晚于当前日期\\\\n- 检查项不能为空\\\\n\\\\n#### 2.6.3 风险预警\\\\n\\\\n**功能描述**：系统自动预警安全风险。\\\\n\\\\n**触发条件**：\\\\n- 检查发现高风险问题\\\\n- 设备出现故障\\\\n- 环境参数异常（温度、湿度等）\\\\n- 员工操作违规\\\\n\\\\n**预警方式**：\\\\n- 系统内通知\\\\n- 邮件通知\\\\n- 短信通知\\\\n- 声光报警（可选）\\\\n\\\\n#### 2.6.4 事故记录\\\\n\\\\n**功能描述**：记录厨房安全事故。\\\\n\\\\n**输入参数**：\\\\n- 事故编号：唯一标识\\\\n- 事故类型：事故类型\\\\n- 发生时间：发生时间\\\\n- 发生地点：发生地点\\\\n- 事故描述：事故描述\\\\n- 涉及人员：涉及人员\\\\n- 处理措施：处理措施\\\\n- 责任人：责任人\\\\n- 事故照片：事故照片\\\\n- 备注：备注\\\\n\\\\n**输出结果**：\\\\n- 成功：返回事故记录信息\\\\n- 失败：返回错误信息\\\\n\\\\n**验证规则**：\\\\n- 事故编号不能为空且唯一\\\\n- 事故类型必须选择\\\\n- 发生时间不能晚于当前日期\\\\n- 事故描述不能为空\\\\n\\\\n### 2.7 厨房绩效统计\\\\n\\\\n#### 2.7.1 设备统计\\\\n\\\\n**功能描述**：统计厨房设备使用情况。\\\\n\\\\n**输入参数**：\\\\n- 统计周期：日、周、月、年\\\\n- 设备类型：按设备类型筛选\\\\n- 日期范围：日期范围\\\\n\\\\n**输出结果**：\\\\n- 设备总数：设备总数\\\\n- 正常设备数：正常设备数\\\\n- 维修设备数：维修设备数\\\\n- 报废设备数：报废设备数\\\\n- 设备利用率：设备利用率\\\\n- 设备维护次数：设备维护次数\\\\n- 设备故障率：设备故障率\\\\n\\\\n#### 2.7.2 员工统计\\\\n\\\\n**功能描述**：统计厨房员工工作情况。\\\\n\\\\n**输入参数**：\\\\n- 统计周期：日、周、月、年\\\\n- 员工岗位：按岗位筛选\\\\n- 日期范围：日期范围\\\\n\\\\n**输出结果**：\\\\n- 员工总数：员工总数\\\\n- 在职员工数：在职员工数\\\\n- 完成任务数：完成任务数\\\\n- 平均评分：平均评分\\\\n- 出勤率：出勤率\\\\n- 工作时长：工作时长\\\\n\\\\n#### 2.7.3 任务统计\\\\n\\\\n**功能描述**：统计厨房任务完成情况。\\\\n\\\\n**输入参数**：\\\\n- 统计周期：日、周、月、年\\\\n- 任务类型：按任务类型筛选\\\\n- 日期范围：日期范围\\\\n\\\\n**输出结果**：\\\\n- 任务总数：任务总数\\\\n- 完成任务数：完成任务数\\\\n- 待处理任务数：待处理任务数\\\\n- 进行中任务数：进行中任务数\\\\n- 已取消任务数：已取消任务数\\\\n- 任务完成率：任务完成率\\\\n- 平均完成时长：平均完成时长\\\\n- 超时任务数：超时任务数\\\\n\\\\n#### 2.7.4 库存统计\\\\n\\\\n**功能描述**：统计厨房库存情况。\\\\n\\\\n**输入参数**：\\\\n- 统计周期：日、周、月、年\\\\n- 材料类型：按材料类型筛选\\\\n- 日期范围：日期范围\\\\n\\\\n**输出结果**：\\\\n- 材料总数：材料总数\\\\n- 充足材料数：充足材料数\\\\n- 不足材料数：不足材料数\\\\n- 过期材料数：过期材料数\\\\n- 库存周转率：库存周转率\\\\n- 库存准确率：库存准确率\\\\n- 库存损耗率：库存损耗率\\\\n\\\\n#### 2.7.5 卫生统计\\\\n\\\\n**功能描述**：统计厨房卫生检查情况。\\\\n\\\\n**输入参数**：\\\\n- 统计周期：日、周、月、年\\\\n- 检查类型：按检查类型筛选\\\\n- 日期范围：日期范围\\\\n\\\\n**输出结果**：\\\\n- 检查总数：检查总数\\\\n- 合格次数：合格次数\\\\n- 不合格次数：不合格次数\\\\n- 合格率：合格率\\\\n- 平均评分：平均评分\\\\n- 发现问题数：发现问题数\\\\n- 问题解决率：问题解决率\\\\n\\\\n#### 2.7.6 安全统计\\\\n\\\\n**功能描述**：统计厨房安全检查情况。\\\\n\\\\n**输入参数**：\\\\n- 统计周期：日、周、月、年\\\\n- 检查类型：按检查类型筛选\\\\n- 日期范围：日期范围\\\\n\\\\n**输出结果**：\\\\n- 检查总数：检查总数\\\\n- 合格次数：合格次数\\\\n- 不合格次数：不合格次数\\\\n- 合格率：合格率\\\\n- 发现风险数：发现风险数\\\\n- 风险解决率：风险解决率\\\\n- 事故发生数：事故发生数\\\\n\\\\n## 3. 非功能需求\\\\n\\\\n### 3.1 性能需求\\\\n\\\\n- 页面加载时间：首页加载时间不超过3秒\\\\n- 数据加载时间：列表数据加载时间不超过2秒\\\\n- 响应时间：用户操作响应时间不超过1秒\\\\n- 并发支持：支持至少100个并发用户\\\\n- 数据库查询：复杂查询响应时间不超过5秒\\\\n\\\\n### 3.2 安全需求\\\\n\\\\n- 用户认证：所有用户必须通过身份认证才能访问系统\\\\n- 权限控制：基于角色的访问控制（RBAC）\\\\n- 数据加密：敏感数据必须加密存储\\\\n- 操作日志：记录所有关键操作日志\\\\n- 数据备份：每日自动备份数据\\\\n- 安全审计：定期进行安全审计\\\\n\\\\n### 3.3 可用性需求\\\\n\\\\n- 系统可用性：系统可用性不低于99.5%\\\\n- 故障恢复：系统故障后30分钟内恢复服务\\\\n- 数据恢复：数据恢复时间不超过1小时\\\\n- 容错能力：系统具备容错能力，避免单点故障\\\\n\\\\n### 3.4 可维护性需求\\\\n\\\\n- 代码规范：遵循项目代码规范\\\\n- 注释完整：关键代码必须有完整注释\\\\n- 模块化设计：系统采用模块化设计，便于维护\\\\n- 日志记录：完善的日志记录机制，便于问题排查\\\\n\\\\n### 3.5 可扩展性需求\\\\n\\\\n- 水平扩展：系统支持水平扩展\\\\n- 垂直扩展：系统支持垂直扩展\\\\n- 接口标准化：采用标准化接口，便于集成第三方系统\\\\n\\\\n## 4. 技术设计\\\\n\\\\n### 4.1 技术栈\\\\n\\\\n#### 4.1.1 前端技术栈\\\\n\\\\n- 框架：Vue 3 + TypeScript\\\\n- UI组件库：Element Plus\\\\n- 状态管理：Pinia\\\\n- 路由：Vue Router\\\\n- HTTP客户端：Axios\\\\n- 图表库：ECharts\\\\n- 构建工具：Vite\\\\n\\\\n#### 4.1.2 后端技术栈\\\\n\\\\n- 框架：Node.js + Express/Nest.js\\\\n- 语言：TypeScript\\\\n- 数据库：PostgreSQL\\\\n- 缓存：Redis\\\\n- ORM：Prisma\\\\n- 认证：JWT\\\\n- 文件存储：本地存储/云存储\\\\n\\\\n### 4.2 数据库设计\\\\n\\\\n#### 4.2.1 设备表（kitchen_equipment）\\\\n\\\\n```sql\\\\nCREATE TABLE kitchen_equipment (\\\\n  id SERIAL PRIMARY KEY,\\\\n  equipment_code VARCHAR(50) UNIQUE NOT NULL,\\\\n  name VARCHAR(100) NOT NULL,\\\\n  type VARCHAR(50) NOT NULL,\\\\n  brand VARCHAR(100) NOT NULL,\\\\n  model VARCHAR(100) NOT NULL,\\\\n  status VARCHAR(50) NOT NULL DEFAULT \\\\'normal\\\\',\\\\n  location VARCHAR(200) NOT NULL,\\\\n  purchase_date DATE NOT NULL,\\\\n  warranty_date DATE NOT NULL,\\\\n  last_maintenance_date DATE NOT NULL,\\\\n  next_maintenance_date DATE NOT NULL,\\\\n  maintenance_interval INTEGER NOT NULL,\\\\n  power INTEGER NOT NULL,\\\\n  specifications JSONB NOT NULL,\\\\n  images TEXT[],\\\\n  description TEXT,\\\\n  responsible_person_id INTEGER NOT NULL,\\\\n  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\\\n  updated_at TIMESTAMP,\\\\n  FOREIGN KEY (responsible_person_id) REFERENCES kitchen_employees(id)\\\\n);\\\\n```\\\\n\\\\n#### 4.2.2 设备维护记录表（equipment_maintenance）\\\\n\\\\n```sql\\\\nCREATE TABLE equipment_maintenance (\\\\n  id SERIAL PRIMARY KEY,\\\\n  equipment_id INTEGER NOT NULL,\\\\n  type VARCHAR(50) NOT NULL,\\\\n  content TEXT NOT NULL,\\\\n  maintainer_id INTEGER NOT NULL,\\\\n  maintenance_date DATE NOT NULL,\\\\n  cost DECIMAL(10, 2) NOT NULL,\\\\n  remarks TEXT,\\\\n  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\\\n  FOREIGN KEY (equipment_id) REFERENCES kitchen_equipment(id),\\\\n  FOREIGN KEY (maintainer_id) REFERENCES kitchen_employees(id)\\\\n);\\\\n```\\\\n\\\\n#### 4.2.3 厨房员工表（kitchen_employees）\\\\n\\\\n```sql\\\\nCREATE TABLE kitchen_employees (\\\\n  id SERIAL PRIMARY KEY,\\\\n  employee_code VARCHAR(50) UNIQUE NOT NULL,\\\\n  name VARCHAR(100) NOT NULL,\\\\n  gender VARCHAR(10) NOT NULL,\\\\n  age INTEGER NOT NULL,\\\\n  phone VARCHAR(20) NOT NULL,\\\\n  email VARCHAR(100),\\\\n  avatar TEXT,\\\\n  position VARCHAR(50) NOT NULL,\\\\n  level VARCHAR(50) NOT NULL,\\\\n  status VARCHAR(50) NOT NULL DEFAULT \\\\'active\\\\',\\\\n  skills JSONB NOT NULL,\\\\n  certifications JSONB,\\\\n  hire_date DATE NOT NULL,\\\\n  salary DECIMAL(10, 2) NOT NULL,\\\\n  work_hours JSONB NOT NULL,\\\\n  performance JSONB,\\\\n  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\\\n  updated_at TIMESTAMP\\\\n);\\\\n```\\\\n\\\\n#### 4.2.4 员工排班表（employee_schedules）\\\\n\\\\n```sql\\\\nCREATE TABLE employee_schedules (\\\\n  id SERIAL PRIMARY KEY,\\\\n  employee_id INTEGER NOT NULL,\\\\n  schedule_date DATE NOT NULL,\\\\n  shift VARCHAR(50) NOT NULL,\\\\n  work_time JSONB NOT NULL,\\\\n  remarks TEXT,\\\\n  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\\\n  FOREIGN KEY (employee_id) REFERENCES kitchen_employees(id)\\\\n);\\\\n```\\\\n\\\\n#### 4.2.5 员工绩效表（employee_performance）\\\\n\\\\n```sql\\\\nCREATE TABLE employee_performance (\\\\n  id SERIAL PRIMARY KEY,\\\\n  employee_id INTEGER NOT NULL,\\\\n  evaluation_period VARCHAR(50) NOT NULL,\\\\n  rating DECIMAL(2, 1) NOT NULL,\\\\n  completed_tasks INTEGER NOT NULL,\\\\n  quality_score DECIMAL(2, 1) NOT NULL,\\\\n  efficiency_score DECIMAL(2, 1) NOT NULL,\\\\n  remarks TEXT,\\\\n  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\\\n  FOREIGN KEY (employee_id) REFERENCES kitchen_employees(id)\\\\n);\\\\n```\\\\n\\\\n#### 4.2.6 厨房任务表（kitchen_tasks）\\\\n\\\\n```sql\\\\nCREATE TABLE kitchen_tasks (\\\\n  id SERIAL PRIMARY KEY,\\\\n  task_code VARCHAR(50) UNIQUE NOT NULL,\\\\n  name VARCHAR(200) NOT NULL,\\\\n  type VARCHAR(50) NOT NULL,\\\\n  status VARCHAR(50) NOT NULL DEFAULT \\\\'pending\\\\',\\\\n  priority VARCHAR(50) NOT NULL,\\\\n  description TEXT NOT NULL,\\\\n  assigned_to_id INTEGER NOT NULL,\\\\n  created_by_id INTEGER NOT NULL,\\\\n  start_time TIMESTAMP NOT NULL,\\\\n  end_time TIMESTAMP,\\\\n  estimated_duration INTEGER NOT NULL,\\\\n  actual_duration INTEGER,\\\\n  order_items JSONB,\\\\n  materials JSONB,\\\\n  steps JSONB,\\\\n  notes TEXT,\\\\n  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\\\n  updated_at TIMESTAMP,\\\\n  FOREIGN KEY (assigned_to_id) REFERENCES kitchen_employees(id),\\\\n  FOREIGN KEY (created_by_id) REFERENCES kitchen_employees(id)\\\\n);\\\\n```\\\\n\\\\n#### 4.2.7 任务进度表（task_progress）\\\\n\\\\n```sql\\\\nCREATE TABLE task_progress (\\\\n  id SERIAL PRIMARY KEY,\\\\n  task_id INTEGER NOT NULL,\\\\n  current_step INTEGER NOT NULL,\\\\n  progress INTEGER NOT NULL,\\\\n  actual_duration INTEGER,\\\\n  remarks TEXT,\\\\n  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\\\n  FOREIGN KEY (task_id) REFERENCES kitchen_tasks(id)\\\\n);\\\\n```\\\\n\\\\n#### 4.2.8 厨房库存表（kitchen_inventory）\\\\n\\\\n```sql\\\\nCREATE TABLE kitchen_inventory (\\\\n  id SERIAL PRIMARY KEY,\\\\n  material_code VARCHAR(50) UNIQUE NOT NULL,\\\\n  name VARCHAR(200) NOT NULL,\\\\n  type VARCHAR(50) NOT NULL,\\\\n  category VARCHAR(100) NOT NULL,\\\\n  unit VARCHAR(20) NOT NULL,\\\\n  quantity DECIMAL(10, 2) NOT NULL,\\\\n  min_quantity DECIMAL(10, 2) NOT NULL,\\\\n  max_quantity DECIMAL(10, 2) NOT NULL,\\\\n  status VARCHAR(50) NOT NULL DEFAULT \\\\'sufficient\\\\',\\\\n  purchase_price DECIMAL(10, 2) NOT NULL,\\\\n  supplier_id INTEGER NOT NULL,\\\\n  storage_location VARCHAR(200) NOT NULL,\\\\n  expiry_date DATE NOT NULL,\\\\n  batch_number VARCHAR(50) NOT NULL,\\\\n  last_stock_in_date DATE NOT NULL,\\\\n  last_stock_out_date DATE,\\\\n  images TEXT[],\\\\n  description TEXT,\\\\n  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\\\n  updated_at TIMESTAMP,\\\\n  FOREIGN KEY (supplier_id) REFERENCES suppliers(id)\\\\n);\\\\n```\\\\n\\\\n#### 4.2.9 库存变动记录表（inventory_transactions）\\\\n\\\\n```sql\\\\nCREATE TABLE inventory_transactions (\\\\n  id SERIAL PRIMARY KEY,\\\\n  inventory_id INTEGER NOT NULL,\\\\n  type VARCHAR(50) NOT NULL,\\\\n  quantity DECIMAL(10, 2) NOT NULL,\\\\n  transaction_date DATE NOT NULL,\\\\n  purpose TEXT,\\\\n  user_id INTEGER NOT NULL,\\\\n  batch_number VARCHAR(50),\\\\n  expiry_date DATE,\\\\n  supplier_id INTEGER,\\\\n  purchase_price DECIMAL(10, 2),\\\\n  remarks TEXT,\\\\n  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\\\n  FOREIGN KEY (inventory_id) REFERENCES kitchen_inventory(id),\\\\n  FOREIGN KEY (user_id) REFERENCES users(id),\\\\n  FOREIGN KEY (supplier_id) REFERENCES suppliers(id)\\\\n);\\\\n```\\\\n\\\\n#### 4.2.10 库存盘点表（inventory_counts）\\\\n\\\\n```sql\\\\nCREATE TABLE inventory_counts (\\\\n  id SERIAL PRIMARY KEY,\\\\n  count_date DATE NOT NULL,\\\\n  counter_id INTEGER NOT NULL,\\\\n  remarks TEXT,\\\\n  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\\\n  FOREIGN KEY (counter_id) REFERENCES kitchen_employees(id)\\\\n);\\\\n```\\\\n\\\\n#### 4.2.11 库存盘点明细表（inventory_count_details）\\\\n\\\\n```sql\\\\nCREATE TABLE inventory_count_details (\\\\n  id SERIAL PRIMARY KEY,\\\\n  count_id INTEGER NOT NULL,\\\\n  inventory_id INTEGER NOT NULL,\\\\n  system_quantity DECIMAL(10, 2) NOT NULL,\\\\n  actual_quantity DECIMAL(10, 2) NOT NULL,\\\\n  difference DECIMAL(10, 2) NOT NULL,\\\\n  reason TEXT,\\\\n  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\\\n  FOREIGN KEY (count_id) REFERENCES inventory_counts(id),\\\\n  FOREIGN KEY (inventory_id) REFERENCES kitchen_inventory(id)\\\\n);\\\\n```\\\\n\\\\n#### 4.2.12 卫生检查表（hygiene_inspections）\\\\n\\\\n```sql\\\\nCREATE TABLE hygiene_inspections (\\\\n  id SERIAL PRIMARY KEY,\\\\n  check_code VARCHAR(50) UNIQUE NOT NULL,\\\\n  type VARCHAR(50) NOT NULL,\\\\n  area VARCHAR(100) NOT NULL,\\\\n  checker_id INTEGER NOT NULL,\\\\n  check_date DATE NOT NULL,\\\\n  result VARCHAR(50) NOT NULL,\\\\n  score INTEGER NOT NULL,\\\\n  items JSONB NOT NULL,\\\\n  issues JSONB,\\\\n  photos TEXT[],\\\\n  remarks TEXT,\\\\n  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\\\n  updated_at TIMESTAMP,\\\\n  FOREIGN KEY (checker_id) REFERENCES kitchen_employees(id)\\\\n);\\\\n```\\\\n\\\\n#### 4.2.13 安全检查表（safety_inspections）\\\\n\\\\n```sql\\\\nCREATE TABLE safety_inspections (\\\\n  id SERIAL PRIMARY KEY,\\\\n  check_code VARCHAR(50) UNIQUE NOT NULL,\\\\n  type VARCHAR(50) NOT NULL,\\\\n  project VARCHAR(100) NOT NULL,\\\\n  checker_id INTEGER NOT NULL,\\\\n  check_date DATE NOT NULL,\\\\n  result VARCHAR(50) NOT NULL,\\\\n  items JSONB NOT NULL,\\\\n  risks JSONB,\\\\n  photos TEXT[],\\\\n  remarks TEXT,\\\\n  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\\\n  updated_at TIMESTAMP,\\\\n  FOREIGN KEY (checker_id) REFERENCES kitchen_employees(id)\\\\n);\\\\n```\\\\n\\\\n#### 4.2.14 事故记录表（accidents）\\\\n\\\\n```sql\\\\nCREATE TABLE accidents (\\\\n  id SERIAL PRIMARY KEY,\\\\n  accident_code VARCHAR(50) UNIQUE NOT NULL,\\\\n  type VARCHAR(50) NOT NULL,\\\\n  occurrence_time TIMESTAMP NOT NULL,\\\\n  location VARCHAR(200) NOT NULL,\\\\n  description TEXT NOT NULL,\\\\n  involved_persons JSONB,\\\\n  measures TEXT,\\\\n  responsible_person_id INTEGER,\\\\n  photos TEXT[],\\\\n  remarks TEXT,\\\\n  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\\\n  FOREIGN KEY (responsible_person_id) REFERENCES kitchen_employees(id)\\\\n);\\\\n```\\\\n\\\\n### 4.3 API设计\\\\n\\\\n#### 4.3.1 设备管理API\\\\n\\\\n| 方法 | 路径 | 描述 |\\\\n|------|------|------|\\\\n| GET | /api/kitchen/equipment | 获取设备列表 |\\\\n| GET | /api/kitchen/equipment/:id | 获取设备详情 |\\\\n| POST | /api/kitchen/equipment | 创建设备 |\\\\n| PUT | /api/kitchen/equipment/:id | 更新设备 |\\\\n| DELETE | /api/kitchen/equipment/:id | 删除设备 |\\\\n| PUT | /api/kitchen/equipment/:id/status | 更新设备状态 |\\\\n| GET | /api/kitchen/equipment/:id/maintenance | 获取设备维护记录 |\\\\n| POST | /api/kitchen/equipment/:id/maintenance | 创建设备维护记录 |\\\\n\\\\n#### 4.3.2 员工管理API\\\\n\\\\n| 方法 | 路径 | 描述 |\\\\n|------|------|------|\\\\n| GET | /api/kitchen/employees | 获取员工列表 |\\\\n| GET | /api/kitchen/employees/:id | 获取员工详情 |\\\\n| POST | /api/kitchen/employees | 创建员工 |\\\\n| PUT | /api/kitchen/employees/:id | 更新员工 |\\\\n| DELETE | /api/kitchen/employees/:id | 删除员工 |\\\\n| GET | /api/kitchen/employees/:id/schedules | 获取员工排班 |\\\\n| POST | /api/kitchen/employees/:id/schedules | 创建员工排班 |\\\\n| GET | /api/kitchen/employees/:id/performance | 获取员工绩效 |\\\\n| POST | /api/kitchen/employees/:id/performance | 创建员工绩效 |\\\\n\\\\n#### 4.3.3 任务管理API\\\\n\\\\n| 方法 | 路径 | 描述 |\\\\n|------|------|------|\\\\n| GET | /api/kitchen/tasks | 获取任务列表 |\\\\n| GET | /api/kitchen/tasks/:id | 获取任务详情 |\\\\n| POST | /api/kitchen/tasks | 创建任务 |\\\\n| PUT | /api/kitchen/tasks/:id | 更新任务 |\\\\n| DELETE | /api/kitchen/tasks/:id | 删除任务 |\\\\n| PUT | /api/kitchen/tasks/:id/status | 更新任务状态 |\\\\n| GET | /api/kitchen/tasks/:id/progress | 获取任务进度 |\\\\n| PUT | /api/kitchen/tasks/:id/progress | 更新任务进度 |\\\\n\\\\n#### 4.3.4 库存管理API\\\\n\\\\n| 方法 | 路径 | 描述 |\\\\n|------|------|------|\\\\n| GET | /api/kitchen/inventory | 获取库存列表 |\\\\n| GET | /api/kitchen/inventory/:id | 获取库存详情 |\\\\n| POST | /api/kitchen/inventory/:id/stock-in | 入库 |\\\\n| POST | /api/kitchen/inventory/:id/stock-out | 出库 |\\\\n| GET | /api/kitchen/inventory/counts | 获取盘点记录 |\\\\n| POST | /api/kitchen/inventory/counts | 创建盘点记录 |\\\\n\\\\n#### 4.3.5 卫生管理API\\\\n\\\\n| 方法 | 路径 | 描述 |\\\\n|------|------|------|\\\\n| GET | /api/kitchen/hygiene-inspections | 获取卫生检查记录 |\\\\n| GET | /api/kitchen/hygiene-inspections/:id | 获取卫生检查详情 |\\\\n| POST | /api/kitchen/hygiene-inspections | 创建卫生检查记录 |\\\\n| PUT | /api/kitchen/hygiene-inspections/:id | 更新卫生检查记录 |\\\\n| PUT | /api/kitchen/hygiene-inspections/:id/issues/:issueId | 更新问题状态 |\\\\n\\\\n#### 4.3.6 安全管理API\\\\n\\\\n| 方法 | 路径 | 描述 |\\\\n|------|------|------|\\\\n| GET | /api/kitchen/safety-inspections | 获取安全检查记录 |\\\\n| GET | /api/kitchen/safety-inspections/:id | 获取安全检查详情 |\\\\n| POST | /api/kitchen/safety-inspections | 创建安全检查记录 |\\\\n| PUT | /api/kitchen/safety-inspections/:id | 更新安全检查记录 |\\\\n| GET | /api/kitchen/accidents | 获取事故记录 |\\\\n| POST | /api/kitchen/accidents | 创建事故记录 |\\\\n\\\\n#### 4.3.7 统计分析API\\\\n\\\\n| 方法 | 路径 | 描述 |\\\\n|------|------|------|\\\\n| GET | /api/kitchen/statistics/equipment | 获取设备统计 |\\\\n| GET | /api/kitchen/statistics/employees | 获取员工统计 |\\\\n| GET | /api/kitchen/statistics/tasks | 获取任务统计 |\\\\n| GET | /api/kitchen/statistics/inventory | 获取库存统计 |\\\\n| GET | /api/kitchen/statistics/hygiene | 获取卫生统计 |\\\\n| GET | /api/kitchen/statistics/safety | 获取安全统计 |\\\\n\\\\n### 4.4 系统架构设计\\\\n\\\\n#### 4.4.1 整体架构\\\\n\\\\n```\\\\n┌─────────────────────────────────────────────────────────┐\\\\n│                      前端层                              │\\\\n│  ┌──────────────┐  ┌──────────────┐  ┌──────────────┐ │\\\\n│  │  厨房设备    │  │  厨房员工    │  │  厨房任务    │ │\\\\n│  │  管理模块    │  │  管理模块    │  │  管理模块    │ │\\\\n│  └──────────────┘  └──────────────┘  └──────────────┘ │\\\\n│  ┌──────────────┐  ┌──────────────┐  ┌──────────────┐ │\\\\n│  │  厨房库存    │  │  厨房卫生    │  │  厨房安全    │ │\\\\n│  │  管理模块    │  │  管理模块    │  │  管理模块    │ │\\\\n│  └──────────────┘  └──────────────┘  └──────────────┘ │\\\\n│  ┌──────────────┐                                        │\\\\n│  │  厨房绩效    │                                        │\\\\n│  │  统计模块    │                                        │\\\\n│  └──────────────┘                                        │\\\\n└─────────────────────────────────────────────────────────┘\\\\n                            │\\\\n                            ▼\\\\n┌─────────────────────────────────────────────────────────┐\\\\n│                      API网关层                            │\\\\n│  ┌──────────────┐  ┌──────────────┐  ┌──────────────┐ │\\\\n│  │  认证授权    │  │  请求路由    │  │  限流熔断    │ │\\\\n│  └──────────────┘  └──────────────┘  └──────────────┘ │\\\\n└─────────────────────────────────────────────────────────┘\\\\n                            │\\\\n                            ▼\\\\n┌─────────────────────────────────────────────────────────┐\\\\n│                      业务逻辑层                          │\\\\n│  ┌──────────────┐  ┌──────────────┐  ┌──────────────┐ │\\\\n│  │  设备服务    │  │  员工服务    │  │  任务服务    │ │\\\\n│  └──────────────┘  └──────────────┘  └──────────────┘ │\\\\n│  ┌──────────────┐  ┌──────────────┐  ┌──────────────┐ │\\\\n│  │  库存服务    │  │  卫生服务    │  │  安全服务    │ │\\\\n│  └──────────────┘  └──────────────┘  └──────────────┘ │\\\\n│  ┌──────────────┐                                        │\\\\n│  │  统计服务    │                                        │\\\\n│  └──────────────┘                                        │\\\\n└─────────────────────────────────────────────────────────┘\\\\n                            │\\\\n                            ▼\\\\n┌─────────────────────────────────────────────────────────┐\\\\n│                      数据访问层                          │\\\\n│  ┌──────────────┐  ┌──────────────┐  ┌──────────────┐ │\\\\n│  │  设备DAO     │  │  员工DAO     │  │  任务DAO     │ │\\\\n│  └──────────────┘  └──────────────┘  └──────────────┘ │\\\\n│  ┌──────────────┐  ┌──────────────┐  ┌──────────────┐ │\\\\n│  │  库存DAO     │  │  卫生DAO     │  │  安全DAO     │ │\\\\n│  └──────────────┘  └──────────────┘  └──────────────┘ │\\\\n│  ┌──────────────┐                                        │\\\\n│  │  统计DAO     │                                        │\\\\n│  └──────────────┘                                        │\\\\n└─────────────────────────────────────────────────────────┘\\\\n                            │\\\\n                            ▼\\\\n┌─────────────────────────────────────────────────────────┐\\\\n│                      数据存储层                          │\\\\n│  ┌──────────────┐  ┌──────────────┐  ┌──────────────┐ │\\\\n│  │ PostgreSQL   │  │    Redis     │  │  文件存储    │ │\\\\n│  └──────────────┘  └──────────────┘  └──────────────┘ │\\\\n└─────────────────────────────────────────────────────────┘\\\\n```\\\\n\\\\n#### 4.4.2 模块依赖关系\\\\n\\\\n```\\\\n厨房管理模块\\\\n├── 设备管理\\\\n│   ├── 设备信息管理\\\\n│   ├── 设备维护管理\\\\n│   └── 设备提醒服务\\\\n├── 员工管理\\\\n│   ├── 员工信息管理\\\\n│   ├── 员工排班管理\\\\n│   └── 员工绩效管理\\\\n├── 任务管理\\\\n│   ├── 任务分配管理\\\\n│   ├── 任务进度跟踪\\\\n│   └── 任务提醒服务\\\\n├── 库存管理\\\\n│   ├── 库存出入库管理\\\\n│   ├── 库存盘点管理\\\\n│   └── 库存预警服务\\\\n├── 卫生管理\\\\n│   ├── 卫生检查管理\\\\n│   ├── 问题跟踪管理\\\\n│   └── 卫生检查提醒\\\\n└── 安全管理\\\\n    ├── 安全检查管理\\\\n    ├── 风险预警服务\\\\n    └── 事故记录管理\\\\n```\\\\n\\\\n## 5. 界面设计\\\\n\\\\n### 5.1 厨房管理主界面\\\\n\\\\n#### 5.1.1 页面布局\\\\n\\\\n```\\\\n┌─────────────────────────────────────────────────────────┐\\\\n│  厨房管理                              [刷新] [设置]    │\\\\n├─────────────────────────────────────────────────────────┤\\\\n│  [设备管理] [员工管理] [任务管理] [库存管理]            │\\\\n│  [卫生管理] [安全管理] [绩效统计]                       │\\\\n├─────────────────────────────────────────────────────────┤\\\\n│  ┌──────────────┐  ┌──────────────┐  ┌──────────────┐ │\\\\n│  │  设备总数    │  │  员工总数    │  │  任务总数    │ │\\\\n│  │     50       │  │     30       │  │    120       │ │\\\\n│  └──────────────┘  └──────────────┘  └──────────────┘ │\\\\n│  ┌──────────────┐  ┌──────────────┐  ┌──────────────┐ │\\\\n│  │  库存总数    │  │  卫生合格率  │  │  安全合格率  │ │\\\\n│  │    200       │  │    98%       │  │    99%       │ │\\\\n│  └──────────────┘  └──────────────┘  └──────────────┘ │\\\\n├─────────────────────────────────────────────────────────┤\\\\n│  [当前活动任务]                                        │\\\\n│  ┌───────────────────────────────────────────────────┐ │\\\\n│  │ 任务1 - 烹饪任务 - 进行中 - 员工A - 30分钟       │ │\\\\n│  │ 任务2 - 准备任务 - 进行中 - 员工B - 15分钟       │ │\\\\n│  │ 任务3 - 清洁任务 - 待处理 - 员工C - 45分钟       │ │\\\\n│  └───────────────────────────────────────────────────┘ │\\\\n├─────────────────────────────────────────────────────────┤\\\\n│  [库存预警]                                            │\\\\n│  ┌───────────────────────────────────────────────────┐ │\\\\n│  │ 材料1 - 数量不足 - 当前: 5 / 最小: 10            │ │\\\\n│  │ 材料2 - 即将过期 - 到期日期: 2025-01-25          │ │\\\\n│  └───────────────────────────────────────────────────┘ │\\\\n├─────────────────────────────────────────────────────────┤\\\\n│  [设备维护提醒]                                        │\\\\n│  ┌───────────────────────────────────────────────────┐ │\\\\n│  │ 设备1 - 下次维护日期: 2025-01-22                 │ │\\\\n│  │ 设备2 - 下次维护日期: 2025-01-23                 │ │\\\\n│  └───────────────────────────────────────────────────┘ │\\\\n└─────────────────────────────────────────────────────────┘\\\\n```\\\\n\\\\n### 5.2 设备管理界面\\\\n\\\\n#### 5.2.1 设备列表界面\\\\n\\\\n```\\\\n┌─────────────────────────────────────────────────────────┐\\\\n│  设备管理                                  [新增设备]    │\\\\n├─────────────────────────────────────────────────────────┤\\\\n│  搜索: [________________] 类型: [全部▼] 状态: [全部▼]  │\\\\n│  位置: [全部▼]                                          │\\\\n├─────────────────────────────────────────────────────────┤\\\\n│  ┌───────────────────────────────────────────────────┐ │\\\\n│  │ 设备编号 │ 设备名称 │ 类型 │ 状态 │ 位置 │ 操作   │ │\\\\n│  ├───────────────────────────────────────────────────┤ │\\\\n│  │ EQ001    │ 炉灶     │ 烹饪 │ 正常 │ A区  │ [编辑] │ │\\\\n│  │          │          │ 设备 │      │      │ [删除] │ │\\\\n│  ├───────────────────────────────────────────────────┤ │\\\\n│  │ EQ002    │ 冰箱     │ 制冷 │ 正常 │ B区  │ [编辑] │ │\\\\n│  │          │          │ 设备 │      │      │ [删除] │ │\\\\n│  ├───────────────────────────────────────────────────┤ │\\\\n│  │ EQ003    │ 切菜机   │ 加工 │ 维修 │ A区  │ [编辑] │ │\\\\n│  │          │          │ 设备 │ 中   │      │ [删除] │ │\\\\n│  └───────────────────────────────────────────────────┘ │\\\\n│  共 50 条记录  [上一页] 1 / 5 [下一页]                │\\\\n└─────────────────────────────────────────────────────────┘\\\\n```\\\\n\\\\n#### 5.2.2 设备详情界面\\\\n\\\\n```\\\\n┌─────────────────────────────────────────────────────────┐\\\\n│  设备详情                              [返回] [编辑]    │\\\\n├─────────────────────────────────────────────────────────┤\\\\n│  设备编号: EQ001                                       │\\\\n│  设备名称: 炉灶                                         │\\\\n│  设备类型: 烹饪设备                                     │\\\\n│  品牌: XXX                                             │\\\\n│  型号: XXX-001                                         │\\\\n│  状态: 正常                                            │\\\\n│  位置: A区                                             │\\\\n│  购买日期: 2024-01-15                                  │\\\\n│  保修到期: 2025-01-15                                  │\\\\n│  上次维护: 2024-12-15                                  │\\\\n│  下次维护: 2025-01-15                                  │\\\\n│  维护间隔: 30天                                        │\\\\n│  功率: 5000瓦                                          │\\\\n│  负责人: 张三 (13800138000)                            │\\\\n├─────────────────────────────────────────────────────────┤\\\\n│  [维护记录]                                            │\\\\n│  ┌───────────────────────────────────────────────────┐ │\\\\n│  │ 2024-12-15 - 常规维护 - 维修人员A - 费用: 500元   │ │\\\\n│  │ 2024-11-15 - 常规维护 - 维修人员A - 费用: 500元   │ │\\\\n│  └───────────────────────────────────────────────────┘ │\\\\n└─────────────────────────────────────────────────────────┘\\\\n```\\\\n\\\\n### 5.3 员工管理界面\\\\n\\\\n#### 5.3.1 员工列表界面\\\\n\\\\n```\\\\n┌─────────────────────────────────────────────────────────┐\\\\n│  员工管理                                  [新增员工]    │\\\\n├─────────────────────────────────────────────────────────┤\\\\n│  搜索: [________________] 岗位: [全部▼] 状态: [全部▼]  │\\\\n│  技能: [全部▼]                                          │\\\\n├─────────────────────────────────────────────────────────┤\\\\n│  ┌───────────────────────────────────────────────────┐ │\\\\n│  │ 员工编号 │ 姓名 │ 岗位 │ 级别 │ 状态 │ 操作     │ │\\\\n│  ├───────────────────────────────────────────────────┤ │\\\\n│  │ EMP001   │ 张三 │ 厨师长│ 高级 │ 在职 │ [编辑]  │ │\\\\n│  │          │      │      │      │      │ [删除]  │ │\\\\n│  ├───────────────────────────────────────────────────┤ │\\\\n│  │ EMP002   │ 李四 │ 主厨 │ 中级 │ 在职 │ [编辑]  │ │\\\\n│  │          │      │      │      │      │ [删除]  │ │\\\\n│  ├───────────────────────────────────────────────────┤ │\\\\n│  │ EMP003   │ 王五 │ 厨师 │ 初级 │ 请假 │ [编辑]  │ │\\\\n│  │          │      │      │      │      │ [删除]  │ │\\\\n│  └───────────────────────────────────────────────────┘ │\\\\n│  共 30 条记录  [上一页] 1 / 3 [下一页]                │\\\\n└─────────────────────────────────────────────────────────┘\\\\n```\\\\n\\\\n#### 5.3.2 员工排班界面\\\\n\\\\n```\\\\n┌─────────────────────────────────────────────────────────┐\\\\n│  员工排班                                  [新增排班]    │\\\\n├─────────────────────────────────────────────────────────┤\\\\n│  员工: [张三▼]  日期: [2025-01-20]                     │\\\\n├─────────────────────────────────────────────────────────┤\\\\n│  ┌───────────────────────────────────────────────────┐ │\\\\n│  │ 日期       │ 班次 │ 工作时间          │ 操作     │ │\\\\n│  ├───────────────────────────────────────────────────┤ │\\\\n│  │ 2025-01-20 │ 早班 │ 06:00 - 14:00    │ [编辑]   │ │\\\\n│  │ 2025-01-21 │ 中班 │ 10:00 - 18:00    │ [编辑]   │ │\\\\n│  │ 2025-01-22 │ 晚班 │ 14:00 - 22:00    │ [编辑]   │ │\\\\n│  └───────────────────────────────────────────────────┘ │\\\\n└─────────────────────────────────────────────────────────┘\\\\n```\\\\n\\\\n### 5.4 任务管理界面\\\\n\\\\n#### 5.4.1 任务列表界面\\\\n\\\\n```\\\\n┌─────────────────────────────────────────────────────────┐\\\\n│  任务管理                                  [新增任务]    │\\\\n├─────────────────────────────────────────────────────────┤\\\\n│  搜索: [________________] 类型: [全部▼] 状态: [全部▼]  │\\\\n│  优先级: [全部▼]  分配给: [全部▼]                       │\\\\n├─────────────────────────────────────────────────────────┤\\\\n│  ┌───────────────────────────────────────────────────┐ │\\\\n│  │ 任务编号 │ 任务名称 │ 类型 │ 状态 │ 优先级 │ 操作│ │\\\\n│  ├───────────────────────────────────────────────────┤ │\\\\n│  │ TASK001  │ 烹饪任务A│ 烹饪 │ 进行│ 高    │ [编辑]│ │\\\\n│  │          │          │ 任务 │ 中  │       │ [删除]│ │\\\\n│  ├───────────────────────────────────────────────────┤ │\\\\n│  │ TASK002  │ 准备任务B│ 准备 │ 待处│ 中    │ [编辑]│ │\\\\n│  │          │          │ 任务 │ 理  │       │ [删除]│ │\\\\n│  ├───────────────────────────────────────────────────┤ │\\\\n│  │ TASK003  │ 清洁任务C│ 清洁 │ 已完│ 低    │ [编辑]│ │\\\\n│  │          │          │ 任务 │ 成  │       │ [删除]│ │\\\\n│  └───────────────────────────────────────────────────┘ │\\\\n│  共 120 条记录  [上一页] 1 / 12 [下一页]              │\\\\n└─────────────────────────────────────────────────────────┘\\\\n```\\\\n\\\\n#### 5.4.2 任务详情界面\\\\n\\\\n```\\\\n┌\",\"originAcceptText\":\"# YYC³餐饮管理系统 - 厨房管理功能模块需求分析与设计文档\\n\\n## 文档信息\\n\\n| 项目 | 内容 |\\n|------|------|\\n| 文档名称 | 厨房管理功能模块需求分析与设计文档 |\\n| 文档版本 | V1.0.0 |\\n| 创建日期 | 2025-01-20 |\\n| 作者 | YYC³团队 |\\n| 文档状态 | 正式发布 |\\n\\n## 1. 概述\\n\\n### 1.1 模块简介\\n\\n厨房管理模块是YYC³餐饮管理系统的核心运营模块，负责管理厨房设备、厨房员工、厨房任务、厨房库存、厨房卫生、厨房安全等功能。该模块为餐饮企业提供了完整的厨房管理解决方案，实现了厨房运营的标准化、规范化和数字化。\\n\\n### 1.2 模块目标\\n\\n- 提供完整的厨房设备管理\\n- 实现厨房员工排班和任务分配\\n- 支持厨房任务跟踪和进度管理\\n- 提供厨房库存实时监控\\n- 实现厨房卫生检查和记录\\n- 支持厨房安全监控和预警\\n- 提供厨房绩效评估和数据分析\\n- 确保厨房运营符合食品安全标准\\n\\n### 1.3 适用范围\\n\\n本模块适用于YYC³餐饮管理系统的所有版本，支持单店和连锁店的厨房管理。\\n\\n## 2. 功能需求\\n\\n### 2.1 厨房设备管理\\n\\n#### 2.1.1 设备列表\\n\\n**功能描述**：展示系统中所有厨房设备信息，支持搜索、筛选和分页。\\n\\n**输入参数**：\\n- 关键词：设备名称、设备编号、品牌型号\\n- 设备类型：烹饪设备、制冷设备、加工设备、清洗设备、储存设备\\n- 状态：正常、维修中、报废\\n- 位置：按厨房区域筛选\\n- 页码：当前页码\\n- 每页数量：每页显示数量\\n\\n**输出结果**：\\n- 设备列表：包含设备基本信息\\n- 总数：符合条件的设备总数\\n\\n**字段说明**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | number | 是 | 设备ID |\\n| equipmentCode | string | 是 | 设备编号 |\\n| name | string | 是 | 设备名称 |\\n| type | string | 是 | 设备类型：cooking/refrigeration/processing/cleaning/storage |\\n| brand | string | 是 | 品牌 |\\n| model | string | 是 | 型号 |\\n| status | string | 是 | 设备状态：normal/maintenance/scrapped |\\n| location | string | 是 | 设备位置 |\\n| purchaseDate | string | 是 | 购买日期 |\\n| warrantyDate | string | 是 | 保修到期日期 |\\n| lastMaintenanceDate | string | 是 | 上次维护日期 |\\n| nextMaintenanceDate | string | 是 | 下次维护日期 |\\n| maintenanceInterval | number | 是 | 维护间隔（天） |\\n| power | number | 是 | 功率（瓦） |\\n| specifications | object | 是 | 技术规格 |\\n| images | array | 否 | 设备图片 |\\n| description | string | 否 | 设备描述 |\\n| responsiblePerson | object | 是 | 负责人信息 |\\n| createdAt | string | 是 | 创建时间 |\\n| updatedAt | string | 否 | 更新时间 |\\n\\n**技术规格字段**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| capacity | string | 否 | 容量 |\\n| temperature | object | 否 | 温度范围 |\\n| dimensions | object | 否 | 尺寸 |\\n| weight | number | 否 | 重量（公斤） |\\n| material | string | 否 | 材质 |\\n\\n**负责人信息字段**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | number | 是 | 员工ID |\\n| name | string | 是 | 姓名 |\\n| phone | string | 是 | 电话 |\\n\\n#### 2.1.2 创建设备\\n\\n**功能描述**：创建新的厨房设备记录。\\n\\n**输入参数**：\\n- 设备编号：唯一标识\\n- 设备名称：设备名称\\n- 设备类型：选择设备类型\\n- 品牌：设备品牌\\n- 型号：设备型号\\n- 设备位置：设备所在位置\\n- 购买日期：购买日期\\n- 保修到期日期：保修到期日期\\n- 维护间隔：维护间隔天数\\n- 功率：设备功率\\n- 技术规格：技术规格信息\\n- 设备描述：设备描述\\n- 负责人：设备负责人\\n- 设备图片：设备图片\\n\\n**输出结果**：\\n- 成功：返回创建的设备信息\\n- 失败：返回错误信息\\n\\n**验证规则**：\\n- 设备编号不能为空且唯一\\n- 设备名称不能为空\\n- 设备类型必须选择\\n- 品牌不能为空\\n- 型号不能为空\\n- 购买日期不能晚于当前日期\\n- 保修到期日期必须晚于购买日期\\n- 维护间隔必须大于0\\n- 功率必须大于0\\n\\n#### 2.1.3 更新设备\\n\\n**功能描述**：更新已有厨房设备信息。\\n\\n**输入参数**：\\n- 设备ID：要更新的设备ID\\n- 其他字段：同创建设备\\n\\n**输出结果**：\\n- 成功：返回更新后的设备信息\\n- 失败：返回错误信息\\n\\n**验证规则**：\\n- 设备ID必须存在\\n- 其他验证规则同创建设备\\n\\n#### 2.1.4 删除设备\\n\\n**功能描述**：删除厨房设备记录。\\n\\n**输入参数**：\\n- 设备ID：要删除的设备ID\\n\\n**输出结果**：\\n- 成功：返回删除成功信息\\n- 失败：返回错误信息\\n\\n**验证规则**：\\n- 设备ID必须存在\\n- 设备状态不能为\\\"正常\\\"时才能删除\\n\\n#### 2.1.5 设备状态管理\\n\\n**功能描述**：更新设备状态（正常、维修中、报废）。\\n\\n**输入参数**：\\n- 设备ID：设备ID\\n- 状态：新状态\\n- 备注：状态变更备注\\n\\n**输出结果**：\\n- 成功：返回更新后的设备信息\\n- 失败：返回错误信息\\n\\n**验证规则**：\\n- 设备ID必须存在\\n- 状态必须为有效值\\n- 设备状态为\\\"报废\\\"时不能恢复为\\\"正常\\\"\\n\\n#### 2.1.6 设备维护记录\\n\\n**功能描述**：记录设备维护信息。\\n\\n**输入参数**：\\n- 设备ID：设备ID\\n- 维护类型：常规维护、故障维修\\n- 维护内容：维护内容描述\\n- 维护人员：维护人员\\n- 维护日期：维护日期\\n- 维护费用：维护费用\\n- 备注：备注信息\\n\\n**输出结果**：\\n- 成功：返回维护记录信息\\n- 失败：返回错误信息\\n\\n**验证规则**：\\n- 设备ID必须存在\\n- 维护类型必须选择\\n- 维护内容不能为空\\n- 维护人员不能为空\\n- 维护日期不能晚于当前日期\\n- 维护费用必须大于等于0\\n\\n#### 2.1.7 设备维护提醒\\n\\n**功能描述**：系统自动提醒即将到期的设备维护。\\n\\n**触发条件**：\\n- 设备下次维护日期在7天内\\n- 设备上次维护日期已超过维护间隔\\n\\n**提醒方式**：\\n- 系统内通知\\n- 邮件通知\\n- 短信通知（可选）\\n\\n### 2.2 厨房员工管理\\n\\n#### 2.2.1 员工列表\\n\\n**功能描述**：展示厨房员工信息，支持搜索、筛选和分页。\\n\\n**输入参数**：\\n- 关键词：员工姓名、员工编号、电话\\n- 岗位：厨师长、主厨、副主厨、厨师、帮厨、洗碗工\\n- 状态：在职、离职、请假\\n- 技能：按技能筛选\\n- 页码：当前页码\\n- 每页数量：每页显示数量\\n\\n**输出结果**：\\n- 员工列表：包含员工基本信息\\n- 总数：符合条件的员工总数\\n\\n**字段说明**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | number | 是 | 员工ID |\\n| employeeCode | string | 是 | 员工编号 |\\n| name | string | 是 | 姓名 |\\n| gender | string | 是 | 性别：male/female |\\n| age | number | 是 | 年龄 |\\n| phone | string | 是 | 电话 |\\n| email | string | 否 | 邮箱 |\\n| avatar | string | 否 | 头像 |\\n| position | string | 是 | 岗位：head_chef/sous_chef/chef/assistant/dishwasher |\\n| level | string | 是 | 级别：senior/middle/junior |\\n| status | string | 是 | 状态：active/resigned/leave |\\n| skills | array | 是 | 技能列表 |\\n| certifications | array | 否 | 证书列表 |\\n| hireDate | string | 是 | 入职日期 |\\n| salary | number | 是 | 薪资 |\\n| workHours | object | 是 | 工作时间 |\\n| performance | object | 否 | 绩效数据 |\\n| createdAt | string | 是 | 创建时间 |\\n| updatedAt | string | 否 | 更新时间 |\\n\\n**技能字段**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | number | 是 | 技能ID |\\n| name | string | 是 | 技能名称 |\\n| level | string | 是 | 技能等级：expert/proficient/basic |\\n\\n**证书字段**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | number | 是 | 证书ID |\\n| name | string | 是 | 证书名称 |\\n| number | string | 是 | 证书编号 |\\n| issueDate | string | 是 | 发证日期 |\\n| expiryDate | string | 是 | 到期日期 |\\n| issuer | string | 是 | 发证机构 |\\n\\n**工作时间字段**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| workDays | array | 是 | 工作日 |\\n| startTime | string | 是 | 开始时间 |\\n| endTime | string | 是 | 结束时间 |\\n| breakTime | array | 否 | 休息时间 |\\n\\n**绩效数据字段**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| rating | number | 是 | 评分（0-5） |\\n| completedTasks | number | 是 | 完成任务数 |\\n| qualityScore | number | 是 | 质量评分 |\\n| efficiencyScore | number | 是 | 效率评分 |\\n\\n#### 2.2.2 创建员工\\n\\n**功能描述**：创建新的厨房员工记录。\\n\\n**输入参数**：\\n- 员工编号：唯一标识\\n- 姓名：员工姓名\\n- 性别：性别\\n- 年龄：年龄\\n- 电话：联系电话\\n- 邮箱：邮箱地址\\n- 岗位：选择岗位\\n- 级别：选择级别\\n- 技能：技能列表\\n- 证书：证书列表\\n- 入职日期：入职日期\\n- 薪资：薪资\\n- 工作时间：工作时间安排\\n\\n**输出结果**：\\n- 成功：返回创建的员工信息\\n- 失败：返回错误信息\\n\\n**验证规则**：\\n- 员工编号不能为空且唯一\\n- 姓名不能为空\\n- 性别必须选择\\n- 年龄必须在18-65之间\\n- 电话不能为空且格式正确\\n- 邮箱格式必须正确（如果提供）\\n- 岗位必须选择\\n- 级别必须选择\\n- 入职日期不能晚于当前日期\\n- 薪资必须大于0\\n- 工作时间必须完整\\n\\n#### 2.2.3 更新员工\\n\\n**功能描述**：更新已有厨房员工信息。\\n\\n**输入参数**：\\n- 员工ID：要更新的员工ID\\n- 其他字段：同创建员工\\n\\n**输出结果**：\\n- 成功：返回更新后的员工信息\\n- 失败：返回错误信息\\n\\n**验证规则**：\\n- 员工ID必须存在\\n- 其他验证规则同创建员工\\n\\n#### 2.2.4 删除员工\\n\\n**功能描述**：删除厨房员工记录。\\n\\n**输入参数**：\\n- 员工ID：要删除的员工ID\\n\\n**输出结果**：\\n- 成功：返回删除成功信息\\n- 失败：返回错误信息\\n\\n**验证规则**：\\n- 员工ID必须存在\\n- 员工状态不能为\\\"在职\\\"时才能删除\\n\\n#### 2.2.5 员工排班管理\\n\\n**功能描述**：管理员工排班信息。\\n\\n**输入参数**：\\n- 员工ID：员工ID\\n- 排班日期：排班日期\\n- 班次：早班、中班、晚班\\n- 工作时间：具体工作时间\\n- 备注：备注信息\\n\\n**输出结果**：\\n- 成功：返回排班信息\\n- 失败：返回错误信息\\n\\n**验证规则**：\\n- 员工ID必须存在\\n- 排班日期不能早于当前日期\\n- 班次必须选择\\n- 工作时间必须完整\\n\\n#### 2.2.6 员工绩效评估\\n\\n**功能描述**：评估员工绩效。\\n\\n**输入参数**：\\n- 员工ID：员工ID\\n- 评估周期：评估周期（月度、季度、年度）\\n- 评分：评分（0-5）\\n- 完成任务数：完成任务数\\n- 质量评分：质量评分\\n- 效率评分：效率评分\\n- 评语：评语\\n\\n**输出结果**：\\n- 成功：返回绩效评估信息\\n- 失败：返回错误信息\\n\\n**验证规则**：\\n- 员工ID必须存在\\n- 评估周期必须选择\\n- 评分必须在0-5之间\\n- 完成任务数必须大于等于0\\n- 质量评分必须在0-5之间\\n- 效率评分必须在0-5之间\\n\\n### 2.3 厨房任务管理\\n\\n#### 2.3.1 任务列表\\n\\n**功能描述**：展示厨房任务信息，支持搜索、筛选和分页。\\n\\n**输入参数**：\\n- 关键词：任务名称、任务编号\\n- 任务类型：烹饪任务、准备任务、清洁任务、维护任务\\n- 状态：待处理、进行中、已完成、已取消\\n- 优先级：高、中、低\\n- 分配给：按员工筛选\\n- 日期范围：按日期筛选\\n- 页码：当前页码\\n- 每页数量：每页显示数量\\n\\n**输出结果**：\\n- 任务列表：包含任务基本信息\\n- 总数：符合条件的任务总数\\n\\n**字段说明**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | number | 是 | 任务ID |\\n| taskCode | string | 是 | 任务编号 |\\n| name | string | 是 | 任务名称 |\\n| type | string | 是 | 任务类型：cooking/preparation/cleaning/maintenance |\\n| status | string | 是 | 状态：pending/in_progress/completed/cancelled |\\n| priority | string | 是 | 优先级：high/medium/low |\\n| description | string | 是 | 任务描述 |\\n| assignedTo | object | 是 | 分配给 |\\n| createdBy | object | 是 | 创建人 |\\n| startTime | string | 是 | 开始时间 |\\n| endTime | string | 否 | 结束时间 |\\n| estimatedDuration | number | 是 | 预计时长（分钟） |\\n| actualDuration | number | 否 | 实际时长（分钟） |\\n| orderItems | array | 否 | 关联订单项 |\\n| materials | array | 否 | 所需材料 |\\n| steps | array | 否 | 任务步骤 |\\n| notes | string | 否 | 备注 |\\n| createdAt | string | 是 | 创建时间 |\\n| updatedAt | string | 否 | 更新时间 |\\n\\n**分配给字段**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | number | 是 | 员工ID |\\n| name | string | 是 | 姓名 |\\n| avatar | string | 否 | 头像 |\\n\\n**创建人字段**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | number | 是 | 员工ID |\\n| name | string | 是 | 姓名 |\\n\\n**订单项字段**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | number | 是 | 订单项ID |\\n| orderId | number | 是 | 订单ID |\\n| dishName | string | 是 | 菜品名称 |\\n| quantity | number | 是 | 数量 |\\n| specifications | string | 否 | 规格要求 |\\n\\n**材料字段**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | number | 是 | 材料ID |\\n| name | string | 是 | 材料名称 |\\n| quantity | number | 是 | 数量 |\\n| unit | string | 是 | 单位 |\\n\\n**步骤字段**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | number | 是 | 步骤ID |\\n| sequence | number | 是 | 顺序 |\\n| description | string | 是 | 描述 |\\n| estimatedTime | number | 是 | 预计时间（分钟） |\\n\\n#### 2.3.2 创建任务\\n\\n**功能描述**：创建新的厨房任务。\\n\\n**输入参数**：\\n- 任务编号：唯一标识\\n- 任务名称：任务名称\\n- 任务类型：选择任务类型\\n- 优先级：选择优先级\\n- 任务描述：任务描述\\n- 分配给：选择员工\\n- 开始时间：开始时间\\n- 预计时长：预计时长\\n- 关联订单项：关联订单项\\n- 所需材料：所需材料\\n- 任务步骤：任务步骤\\n- 备注：备注\\n\\n**输出结果**：\\n- 成功：返回创建的任务信息\\n- 失败：返回错误信息\\n\\n**验证规则**：\\n- 任务编号不能为空且唯一\\n- 任务名称不能为空\\n- 任务类型必须选择\\n- 优先级必须选择\\n- 任务描述不能为空\\n- 分配给必须选择\\n- 开始时间不能早于当前时间\\n- 预计时长必须大于0\\n\\n#### 2.3.3 更新任务\\n\\n**功能描述**：更新已有厨房任务信息。\\n\\n**输入参数**：\\n- 任务ID：要更新的任务ID\\n- 其他字段：同创建任务\\n\\n**输出结果**：\\n- 成功：返回更新后的任务信息\\n- 失败：返回错误信息\\n\\n**验证规则**：\\n- 任务ID必须存在\\n- 其他验证规则同创建任务\\n\\n#### 2.3.4 删除任务\\n\\n**功能描述**：删除厨房任务记录。\\n\\n**输入参数**：\\n- 任务ID：要删除的任务ID\\n\\n**输出结果**：\\n- 成功：返回删除成功信息\\n- 失败：返回错误信息\\n\\n**验证规则**：\\n- 任务ID必须存在\\n- 任务状态不能为\\\"进行中\\\"时才能删除\\n\\n#### 2.3.5 任务状态管理\\n\\n**功能描述**：更新任务状态（待处理、进行中、已完成、已取消）。\\n\\n**输入参数**：\\n- 任务ID：任务ID\\n- 状态：新状态\\n- 备注：状态变更备注\\n\\n**输出结果**：\\n- 成功：返回更新后的任务信息\\n- 失败：返回错误信息\\n\\n**验证规则**：\\n- 任务ID必须存在\\n- 状态必须为有效值\\n- 任务状态流转必须符合业务规则\\n\\n#### 2.3.6 任务进度跟踪\\n\\n**功能描述**：跟踪任务执行进度。\\n\\n**输入参数**：\\n- 任务ID：任务ID\\n- 当前步骤：当前执行步骤\\n- 完成进度：完成进度（0-100%）\\n- 实际时长：实际时长\\n- 备注：备注\\n\\n**输出结果**：\\n- 成功：返回进度更新信息\\n- 失败：返回错误信息\\n\\n**验证规则**：\\n- 任务ID必须存在\\n- 完成进度必须在0-100之间\\n- 实际时长必须大于等于0\\n\\n#### 2.3.7 任务提醒\\n\\n**功能描述**：系统自动提醒即将到期的任务。\\n\\n**触发条件**：\\n- 任务开始时间在15分钟内\\n- 任务预计时长即将到期\\n- 任务超时未完成\\n\\n**提醒方式**：\\n- 系统内通知\\n- 声音提醒\\n- 短信通知（可选）\\n\\n### 2.4 厨房库存管理\\n\\n#### 2.4.1 库存列表\\n\\n**功能描述**：展示厨房库存信息，支持搜索、筛选和分页。\\n\\n**输入参数**：\\n- 关键词：材料名称、材料编号\\n- 材料类型：食材、调料、包装材料\\n- 分类：按分类筛选\\n- 状态：充足、不足、过期\\n- 页码：当前页码\\n- 每页数量：每页显示数量\\n\\n**输出结果**：\\n- 库存列表：包含库存基本信息\\n- 总数：符合条件的库存总数\\n\\n**字段说明**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | number | 是 | 库存ID |\\n| materialCode | string | 是 | 材料编号 |\\n| name | string | 是 | 材料名称 |\\n| type | string | 是 | 材料类型：ingredient/seasoning/packaging |\\n| category | string | 是 | 分类 |\\n| unit | string | 是 | 单位 |\\n| quantity | number | 是 | 当前数量 |\\n| minQuantity | number | 是 | 最小库存量 |\\n| maxQuantity | number | 是 | 最大库存量 |\\n| status | string | 是 | 状态：sufficient/insufficient/expired |\\n| purchasePrice | number | 是 | 采购价格 |\\n| supplier | object | 是 | 供应商信息 |\\n| storageLocation | string | 是 | 存储位置 |\\n| expiryDate | string | 是 | 到期日期 |\\n| batchNumber | string | 是 | 批次号 |\\n| lastStockInDate | string | 是 | 上次入库日期 |\\n| lastStockOutDate | string | 否 | 上次出库日期 |\\n| images | array | 否 | 材料图片 |\\n| description | string | 否 | 材料描述 |\\n| createdAt | string | 是 | 创建时间 |\\n| updatedAt | string | 否 | 更新时间 |\\n\\n**供应商信息字段**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | number | 是 | 供应商ID |\\n| name | string | 是 | 供应商名称 |\\n| contact | string | 是 | 联系人 |\\n| phone | string | 是 | 电话 |\\n\\n#### 2.4.2 入库管理\\n\\n**功能描述**：记录材料入库信息。\\n\\n**输入参数**：\\n- 材料ID：材料ID\\n- 入库数量：入库数量\\n- 入库日期：入库日期\\n- 批次号：批次号\\n- 到期日期：到期日期\\n- 供应商：供应商\\n- 采购价格：采购价格\\n- 备注：备注\\n\\n**输出结果**：\\n- 成功：返回入库记录信息\\n- 失败：返回错误信息\\n\\n**验证规则**：\\n- 材料ID必须存在\\n- 入库数量必须大于0\\n- 入库日期不能晚于当前日期\\n- 批次号不能为空\\n- 到期日期必须晚于当前日期\\n- 采购价格必须大于0\\n\\n#### 2.4.3 出库管理\\n\\n**功能描述**：记录材料出库信息。\\n\\n**输入参数**：\\n- 材料ID：材料ID\\n- 出库数量：出库数量\\n- 出库日期：出库日期\\n- 用途：用途\\n- 使用人：使用人\\n- 备注：备注\\n\\n**输出结果**：\\n- 成功：返回出库记录信息\\n- 失败：返回错误信息\\n\\n**验证规则**：\\n- 材料ID必须存在\\n- 出库数量必须大于0\\n- 出库数量不能大于当前库存量\\n- 出库日期不能晚于当前日期\\n- 用途不能为空\\n- 使用人不能为空\\n\\n#### 2.4.4 库存盘点\\n\\n**功能描述**：进行库存盘点。\\n\\n**输入参数**：\\n- 盘点日期：盘点日期\\n- 盘点人：盘点人\\n- 盘点明细：盘点明细列表\\n\\n**输出结果**：\\n- 成功：返回盘点记录信息\\n- 失败：返回错误信息\\n\\n**盘点明细字段**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| materialId | number | 是 | 材料ID |\\n| systemQuantity | number | 是 | 系统数量 |\\n| actualQuantity | number | 是 | 实际数量 |\\n| difference | number | 是 | 差异 |\\n| reason | string | 否 | 差异原因 |\\n\\n**验证规则**：\\n- 盘点日期不能晚于当前日期\\n- 盘点人不能为空\\n- 盘点明细不能为空\\n\\n#### 2.4.5 库存预警\\n\\n**功能描述**：系统自动预警库存不足或即将过期的材料。\\n\\n**触发条件**：\\n- 材料数量小于最小库存量\\n- 材料到期日期在7天内\\n- 材料已过期\\n\\n**预警方式**：\\n- 系统内通知\\n- 邮件通知\\n- 短信通知（可选）\\n\\n### 2.5 厨房卫生管理\\n\\n#### 2.5.1 卫生检查列表\\n\\n**功能描述**：展示厨房卫生检查记录，支持搜索、筛选和分页。\\n\\n**输入参数**：\\n- 关键词：检查编号、检查人\\n- 检查类型：日常检查、周检查、月检查\\n- 检查区域：按区域筛选\\n- 检查结果：合格、不合格\\n- 日期范围：按日期筛选\\n- 页码：当前页码\\n- 每页数量：每页显示数量\\n\\n**输出结果**：\\n- 检查列表：包含检查基本信息\\n- 总数：符合条件的检查总数\\n\\n**字段说明**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | number | 是 | 检查ID |\\n| checkCode | string | 是 | 检查编号 |\\n| type | string | 是 | 检查类型：daily/weekly/monthly |\\n| area | string | 是 | 检查区域 |\\n| checker | object | 是 | 检查人 |\\n| checkDate | string | 是 | 检查日期 |\\n| result | string | 是 | 检查结果：passed/failed |\\n| score | number | 是 | 评分（0-100） |\\n| items | array | 是 | 检查项列表 |\\n| issues | array | 否 | 发现问题 |\\n| photos | array | 否 | 检查照片 |\\n| remarks | string | 否 | 备注 |\\n| createdAt | string | 是 | 创建时间 |\\n| updatedAt | string | 否 | 更新时间 |\\n\\n**检查人字段**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | number | 是 | 员工ID |\\n| name | string | 是 | 姓名 |\\n\\n**检查项字段**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | number | 是 | 检查项ID |\\n| name | string | 是 | 检查项名称 |\\n| standard | string | 是 | 检查标准 |\\n| result | string | 是 | 结果：passed/failed |\\n| score | number | 是 | 得分 |\\n| remarks | string | 否 | 备注 |\\n\\n**发现问题字段**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | number | 是 | 问题ID |\\n| description | string | 是 | 问题描述 |\\n| severity | string | 是 | 严重程度：high/medium/low |\\n| status | string | 是 | 状态：pending/in_progress/resolved |\\n| assignedTo | object | 否 | 负责人 |\\n| dueDate | string | 否 | 截止日期 |\\n\\n#### 2.5.2 创建检查记录\\n\\n**功能描述**：创建新的卫生检查记录。\\n\\n**输入参数**：\\n- 检查编号：唯一标识\\n- 检查类型：选择检查类型\\n- 检查区域：选择检查区域\\n- 检查日期：检查日期\\n- 检查项：检查项列表\\n- 检查照片：检查照片\\n- 备注：备注\\n\\n**输出结果**：\\n- 成功：返回创建的检查记录信息\\n- 失败：返回错误信息\\n\\n**验证规则**：\\n- 检查编号不能为空且唯一\\n- 检查类型必须选择\\n- 检查区域必须选择\\n- 检查日期不能晚于当前日期\\n- 检查项不能为空\\n\\n#### 2.5.3 更新检查记录\\n\\n**功能描述**：更新已有卫生检查记录。\\n\\n**输入参数**：\\n- 检查ID：要更新的检查ID\\n- 其他字段：同创建检查记录\\n\\n**输出结果**：\\n- 成功：返回更新后的检查记录信息\\n- 失败：返回错误信息\\n\\n**验证规则**：\\n- 检查ID必须存在\\n- 其他验证规则同创建检查记录\\n\\n#### 2.5.4 问题跟踪\\n\\n**功能描述**：跟踪卫生检查发现的问题。\\n\\n**输入参数**：\\n- 问题ID：问题ID\\n- 状态：新状态\\n- 负责人：负责人\\n- 截止日期：截止日期\\n- 处理措施：处理措施\\n- 备注：备注\\n\\n**输出结果**：\\n- 成功：返回问题更新信息\\n- 失败：返回错误信息\\n\\n**验证规则**：\\n- 问题ID必须存在\\n- 状态必须为有效值\\n- 截止日期必须晚于当前日期\\n\\n#### 2.5.5 卫生检查提醒\\n\\n**功能描述**：系统自动提醒即将到期的卫生检查。\\n\\n**触发条件**：\\n- 日常检查：每天固定时间提醒\\n- 周检查：每周固定时间提醒\\n- 月检查：每月固定时间提醒\\n\\n**提醒方式**：\\n- 系统内通知\\n- 邮件通知\\n- 短信通知（可选）\\n\\n### 2.6 厨房安全管理\\n\\n#### 2.6.1 安全检查列表\\n\\n**功能描述**：展示厨房安全检查记录，支持搜索、筛选和分页。\\n\\n**输入参数**：\\n- 关键词：检查编号、检查人\\n- 检查类型：日常检查、周检查、月检查、专项检查\\n- 检查项目：按项目筛选\\n- 检查结果：合格、不合格\\n- 日期范围：按日期筛选\\n- 页码：当前页码\\n- 每页数量：每页显示数量\\n\\n**输出结果**：\\n- 检查列表：包含检查基本信息\\n- 总数：符合条件的检查总数\\n\\n**字段说明**：\\n| 字段名 | 类型 | 必填 | 说明 |\\n|--------|------|------|------|\\n| id | number | 是 | 检查ID |\\n| checkCode | string | 是 | 检查编号 |\\n| type | string | 是 | 检查类型：daily/weekly/monthly/special |\\n| project | string | 是 | 检查项目 |\\n| checker | object | 是 | 检查人 |\\n| checkDate | string | 是 | 检查日期 |\\n| result | string | 是 | 检查结果：passed/failed |\\n| items | array | 是 | 检查项列表 |\\n| risks | array | 否 | 发现风险 |\\n| photos | array | 否 | 检查照片 |\\n| remarks | string | 否 | 备注 |\\n| createdAt | string | 是 | 创建时间 |\\n| updatedAt | string | 否 | 更新时间 |\\n\\n**检查项目类型**：\\n- 消防安全\\n- 用电安全\\n- 燃气安全\\n- 设备安全\\n- 食品安全\\n- 人员安全\\n\\n#### 2.6.2 创建安全检查记录\\n\\n**功能描述**：创建新的安全检查记录。\\n\\n**输入参数**：\\n- 检查编号：唯一标识\\n- 检查类型：选择检查类型\\n- 检查项目：选择检查项目\\n- 检查日期：检查日期\\n- 检查项：检查项列表\\n- 检查照片：检查照片\\n- 备注：备注\\n\\n**输出结果**：\\n- 成功：返回创建的检查记录信息\\n- 失败：返回错误信息\\n\\n**验证规则**：\\n- 检查编号不能为空且唯一\\n- 检查类型必须选择\\n- 检查项目必须选择\\n- 检查日期不能晚于当前日期\\n- 检查项不能为空\\n\\n#### 2.6.3 风险预警\\n\\n**功能描述**：系统自动预警安全风险。\\n\\n**触发条件**：\\n- 检查发现高风险问题\\n- 设备出现故障\\n- 环境参数异常（温度、湿度等）\\n- 员工操作违规\\n\\n**预警方式**：\\n- 系统内通知\\n- 邮件通知\\n- 短信通知\\n- 声光报警（可选）\\n\\n#### 2.6.4 事故记录\\n\\n**功能描述**：记录厨房安全事故。\\n\\n**输入参数**：\\n- 事故编号：唯一标识\\n- 事故类型：事故类型\\n- 发生时间：发生时间\\n- 发生地点：发生地点\\n- 事故描述：事故描述\\n- 涉及人员：涉及人员\\n- 处理措施：处理措施\\n- 责任人：责任人\\n- 事故照片：事故照片\\n- 备注：备注\\n\\n**输出结果**：\\n- 成功：返回事故记录信息\\n- 失败：返回错误信息\\n\\n**验证规则**：\\n- 事故编号不能为空且唯一\\n- 事故类型必须选择\\n- 发生时间不能晚于当前日期\\n- 事故描述不能为空\\n\\n### 2.7 厨房绩效统计\\n\\n#### 2.7.1 设备统计\\n\\n**功能描述**：统计厨房设备使用情况。\\n\\n**输入参数**：\\n- 统计周期：日、周、月、年\\n- 设备类型：按设备类型筛选\\n- 日期范围：日期范围\\n\\n**输出结果**：\\n- 设备总数：设备总数\\n- 正常设备数：正常设备数\\n- 维修设备数：维修设备数\\n- 报废设备数：报废设备数\\n- 设备利用率：设备利用率\\n- 设备维护次数：设备维护次数\\n- 设备故障率：设备故障率\\n\\n#### 2.7.2 员工统计\\n\\n**功能描述**：统计厨房员工工作情况。\\n\\n**输入参数**：\\n- 统计周期：日、周、月、年\\n- 员工岗位：按岗位筛选\\n- 日期范围：日期范围\\n\\n**输出结果**：\\n- 员工总数：员工总数\\n- 在职员工数：在职员工数\\n- 完成任务数：完成任务数\\n- 平均评分：平均评分\\n- 出勤率：出勤率\\n- 工作时长：工作时长\\n\\n#### 2.7.3 任务统计\\n\\n**功能描述**：统计厨房任务完成情况。\\n\\n**输入参数**：\\n- 统计周期：日、周、月、年\\n- 任务类型：按任务类型筛选\\n- 日期范围：日期范围\\n\\n**输出结果**：\\n- 任务总数：任务总数\\n- 完成任务数：完成任务数\\n- 待处理任务数：待处理任务数\\n- 进行中任务数：进行中任务数\\n- 已取消任务数：已取消任务数\\n- 任务完成率：任务完成率\\n- 平均完成时长：平均完成时长\\n- 超时任务数：超时任务数\\n\\n#### 2.7.4 库存统计\\n\\n**功能描述**：统计厨房库存情况。\\n\\n**输入参数**：\\n- 统计周期：日、周、月、年\\n- 材料类型：按材料类型筛选\\n- 日期范围：日期范围\\n\\n**输出结果**：\\n- 材料总数：材料总数\\n- 充足材料数：充足材料数\\n- 不足材料数：不足材料数\\n- 过期材料数：过期材料数\\n- 库存周转率：库存周转率\\n- 库存准确率：库存准确率\\n- 库存损耗率：库存损耗率\\n\\n#### 2.7.5 卫生统计\\n\\n**功能描述**：统计厨房卫生检查情况。\\n\\n**输入参数**：\\n- 统计周期：日、周、月、年\\n- 检查类型：按检查类型筛选\\n- 日期范围：日期范围\\n\\n**输出结果**：\\n- 检查总数：检查总数\\n- 合格次数：合格次数\\n- 不合格次数：不合格次数\\n- 合格率：合格率\\n- 平均评分：平均评分\\n- 发现问题数：发现问题数\\n- 问题解决率：问题解决率\\n\\n#### 2.7.6 安全统计\\n\\n**功能描述**：统计厨房安全检查情况。\\n\\n**输入参数**：\\n- 统计周期：日、周、月、年\\n- 检查类型：按检查类型筛选\\n- 日期范围：日期范围\\n\\n**输出结果**：\\n- 检查总数：检查总数\\n- 合格次数：合格次数\\n- 不合格次数：不合格次数\\n- 合格率：合格率\\n- 发现风险数：发现风险数\\n- 风险解决率：风险解决率\\n- 事故发生数：事故发生数\\n\\n## 3. 非功能需求\\n\\n### 3.1 性能需求\\n\\n- 页面加载时间：首页加载时间不超过3秒\\n- 数据加载时间：列表数据加载时间不超过2秒\\n- 响应时间：用户操作响应时间不超过1秒\\n- 并发支持：支持至少100个并发用户\\n- 数据库查询：复杂查询响应时间不超过5秒\\n\\n### 3.2 安全需求\\n\\n- 用户认证：所有用户必须通过身份认证才能访问系统\\n- 权限控制：基于角色的访问控制（RBAC）\\n- 数据加密：敏感数据必须加密存储\\n- 操作日志：记录所有关键操作日志\\n- 数据备份：每日自动备份数据\\n- 安全审计：定期进行安全审计\\n\\n### 3.3 可用性需求\\n\\n- 系统可用性：系统可用性不低于99.5%\\n- 故障恢复：系统故障后30分钟内恢复服务\\n- 数据恢复：数据恢复时间不超过1小时\\n- 容错能力：系统具备容错能力，避免单点故障\\n\\n### 3.4 可维护性需求\\n\\n- 代码规范：遵循项目代码规范\\n- 注释完整：关键代码必须有完整注释\\n- 模块化设计：系统采用模块化设计，便于维护\\n- 日志记录：完善的日志记录机制，便于问题排查\\n\\n### 3.5 可扩展性需求\\n\\n- 水平扩展：系统支持水平扩展\\n- 垂直扩展：系统支持垂直扩展\\n- 接口标准化：采用标准化接口，便于集成第三方系统\\n\\n## 4. 技术设计\\n\\n### 4.1 技术栈\\n\\n#### 4.1.1 前端技术栈\\n\\n- 框架：Vue 3 + TypeScript\\n- UI组件库：Element Plus\\n- 状态管理：Pinia\\n- 路由：Vue Router\\n- HTTP客户端：Axios\\n- 图表库：ECharts\\n- 构建工具：Vite\\n\\n#### 4.1.2 后端技术栈\\n\\n- 框架：Node.js + Express/Nest.js\\n- 语言：TypeScript\\n- 数据库：PostgreSQL\\n- 缓存：Redis\\n- ORM：Prisma\\n- 认证：JWT\\n- 文件存储：本地存储/云存储\\n\\n### 4.2 数据库设计\\n\\n#### 4.2.1 设备表（kitchen_equipment）\\n\\n```sql\\nCREATE TABLE kitchen_equipment (\\n  id SERIAL PRIMARY KEY,\\n  equipment_code VARCHAR(50) UNIQUE NOT NULL,\\n  name VARCHAR(100) NOT NULL,\\n  type VARCHAR(50) NOT NULL,\\n  brand VARCHAR(100) NOT NULL,\\n  model VARCHAR(100) NOT NULL,\\n  status VARCHAR(50) NOT NULL DEFAULT 'normal',\\n  location VARCHAR(200) NOT NULL,\\n  purchase_date DATE NOT NULL,\\n  warranty_date DATE NOT NULL,\\n  last_maintenance_date DATE NOT NULL,\\n  next_maintenance_date DATE NOT NULL,\\n  maintenance_interval INTEGER NOT NULL,\\n  power INTEGER NOT NULL,\\n  specifications JSONB NOT NULL,\\n  images TEXT[],\\n  description TEXT,\\n  responsible_person_id INTEGER NOT NULL,\\n  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\n  updated_at TIMESTAMP,\\n  FOREIGN KEY (responsible_person_id) REFERENCES kitchen_employees(id)\\n);\\n```\\n\\n#### 4.2.2 设备维护记录表（equipment_maintenance）\\n\\n```sql\\nCREATE TABLE equipment_maintenance (\\n  id SERIAL PRIMARY KEY,\\n  equipment_id INTEGER NOT NULL,\\n  type VARCHAR(50) NOT NULL,\\n  content TEXT NOT NULL,\\n  maintainer_id INTEGER NOT NULL,\\n  maintenance_date DATE NOT NULL,\\n  cost DECIMAL(10, 2) NOT NULL,\\n  remarks TEXT,\\n  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\n  FOREIGN KEY (equipment_id) REFERENCES kitchen_equipment(id),\\n  FOREIGN KEY (maintainer_id) REFERENCES kitchen_employees(id)\\n);\\n```\\n\\n#### 4.2.3 厨房员工表（kitchen_employees）\\n\\n```sql\\nCREATE TABLE kitchen_employees (\\n  id SERIAL PRIMARY KEY,\\n  employee_code VARCHAR(50) UNIQUE NOT NULL,\\n  name VARCHAR(100) NOT NULL,\\n  gender VARCHAR(10) NOT NULL,\\n  age INTEGER NOT NULL,\\n  phone VARCHAR(20) NOT NULL,\\n  email VARCHAR(100),\\n  avatar TEXT,\\n  position VARCHAR(50) NOT NULL,\\n  level VARCHAR(50) NOT NULL,\\n  status VARCHAR(50) NOT NULL DEFAULT 'active',\\n  skills JSONB NOT NULL,\\n  certifications JSONB,\\n  hire_date DATE NOT NULL,\\n  salary DECIMAL(10, 2) NOT NULL,\\n  work_hours JSONB NOT NULL,\\n  performance JSONB,\\n  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\n  updated_at TIMESTAMP\\n);\\n```\\n\\n#### 4.2.4 员工排班表（employee_schedules）\\n\\n```sql\\nCREATE TABLE employee_schedules (\\n  id SERIAL PRIMARY KEY,\\n  employee_id INTEGER NOT NULL,\\n  schedule_date DATE NOT NULL,\\n  shift VARCHAR(50) NOT NULL,\\n  work_time JSONB NOT NULL,\\n  remarks TEXT,\\n  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\n  FOREIGN KEY (employee_id) REFERENCES kitchen_employees(id)\\n);\\n```\\n\\n#### 4.2.5 员工绩效表（employee_performance）\\n\\n```sql\\nCREATE TABLE employee_performance (\\n  id SERIAL PRIMARY KEY,\\n  employee_id INTEGER NOT NULL,\\n  evaluation_period VARCHAR(50) NOT NULL,\\n  rating DECIMAL(2, 1) NOT NULL,\\n  completed_tasks INTEGER NOT NULL,\\n  quality_score DECIMAL(2, 1) NOT NULL,\\n  efficiency_score DECIMAL(2, 1) NOT NULL,\\n  remarks TEXT,\\n  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\n  FOREIGN KEY (employee_id) REFERENCES kitchen_employees(id)\\n);\\n```\\n\\n#### 4.2.6 厨房任务表（kitchen_tasks）\\n\\n```sql\\nCREATE TABLE kitchen_tasks (\\n  id SERIAL PRIMARY KEY,\\n  task_code VARCHAR(50) UNIQUE NOT NULL,\\n  name VARCHAR(200) NOT NULL,\\n  type VARCHAR(50) NOT NULL,\\n  status VARCHAR(50) NOT NULL DEFAULT 'pending',\\n  priority VARCHAR(50) NOT NULL,\\n  description TEXT NOT NULL,\\n  assigned_to_id INTEGER NOT NULL,\\n  created_by_id INTEGER NOT NULL,\\n  start_time TIMESTAMP NOT NULL,\\n  end_time TIMESTAMP,\\n  estimated_duration INTEGER NOT NULL,\\n  actual_duration INTEGER,\\n  order_items JSONB,\\n  materials JSONB,\\n  steps JSONB,\\n  notes TEXT,\\n  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\n  updated_at TIMESTAMP,\\n  FOREIGN KEY (assigned_to_id) REFERENCES kitchen_employees(id),\\n  FOREIGN KEY (created_by_id) REFERENCES kitchen_employees(id)\\n);\\n```\\n\\n#### 4.2.7 任务进度表（task_progress）\\n\\n```sql\\nCREATE TABLE task_progress (\\n  id SERIAL PRIMARY KEY,\\n  task_id INTEGER NOT NULL,\\n  current_step INTEGER NOT NULL,\\n  progress INTEGER NOT NULL,\\n  actual_duration INTEGER,\\n  remarks TEXT,\\n  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\n  FOREIGN KEY (task_id) REFERENCES kitchen_tasks(id)\\n);\\n```\\n\\n#### 4.2.8 厨房库存表（kitchen_inventory）\\n\\n```sql\\nCREATE TABLE kitchen_inventory (\\n  id SERIAL PRIMARY KEY,\\n  material_code VARCHAR(50) UNIQUE NOT NULL,\\n  name VARCHAR(200) NOT NULL,\\n  type VARCHAR(50) NOT NULL,\\n  category VARCHAR(100) NOT NULL,\\n  unit VARCHAR(20) NOT NULL,\\n  quantity DECIMAL(10, 2) NOT NULL,\\n  min_quantity DECIMAL(10, 2) NOT NULL,\\n  max_quantity DECIMAL(10, 2) NOT NULL,\\n  status VARCHAR(50) NOT NULL DEFAULT 'sufficient',\\n  purchase_price DECIMAL(10, 2) NOT NULL,\\n  supplier_id INTEGER NOT NULL,\\n  storage_location VARCHAR(200) NOT NULL,\\n  expiry_date DATE NOT NULL,\\n  batch_number VARCHAR(50) NOT NULL,\\n  last_stock_in_date DATE NOT NULL,\\n  last_stock_out_date DATE,\\n  images TEXT[],\\n  description TEXT,\\n  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\n  updated_at TIMESTAMP,\\n  FOREIGN KEY (supplier_id) REFERENCES suppliers(id)\\n);\\n```\\n\\n#### 4.2.9 库存变动记录表（inventory_transactions）\\n\\n```sql\\nCREATE TABLE inventory_transactions (\\n  id SERIAL PRIMARY KEY,\\n  inventory_id INTEGER NOT NULL,\\n  type VARCHAR(50) NOT NULL,\\n  quantity DECIMAL(10, 2) NOT NULL,\\n  transaction_date DATE NOT NULL,\\n  purpose TEXT,\\n  user_id INTEGER NOT NULL,\\n  batch_number VARCHAR(50),\\n  expiry_date DATE,\\n  supplier_id INTEGER,\\n  purchase_price DECIMAL(10, 2),\\n  remarks TEXT,\\n  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\n  FOREIGN KEY (inventory_id) REFERENCES kitchen_inventory(id),\\n  FOREIGN KEY (user_id) REFERENCES users(id),\\n  FOREIGN KEY (supplier_id) REFERENCES suppliers(id)\\n);\\n```\\n\\n#### 4.2.10 库存盘点表（inventory_counts）\\n\\n```sql\\nCREATE TABLE inventory_counts (\\n  id SERIAL PRIMARY KEY,\\n  count_date DATE NOT NULL,\\n  counter_id INTEGER NOT NULL,\\n  remarks TEXT,\\n  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\n  FOREIGN KEY (counter_id) REFERENCES kitchen_employees(id)\\n);\\n```\\n\\n#### 4.2.11 库存盘点明细表（inventory_count_details）\\n\\n```sql\\nCREATE TABLE inventory_count_details (\\n  id SERIAL PRIMARY KEY,\\n  count_id INTEGER NOT NULL,\\n  inventory_id INTEGER NOT NULL,\\n  system_quantity DECIMAL(10, 2) NOT NULL,\\n  actual_quantity DECIMAL(10, 2) NOT NULL,\\n  difference DECIMAL(10, 2) NOT NULL,\\n  reason TEXT,\\n  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\n  FOREIGN KEY (count_id) REFERENCES inventory_counts(id),\\n  FOREIGN KEY (inventory_id) REFERENCES kitchen_inventory(id)\\n);\\n```\\n\\n#### 4.2.12 卫生检查表（hygiene_inspections）\\n\\n```sql\\nCREATE TABLE hygiene_inspections (\\n  id SERIAL PRIMARY KEY,\\n  check_code VARCHAR(50) UNIQUE NOT NULL,\\n  type VARCHAR(50) NOT NULL,\\n  area VARCHAR(100) NOT NULL,\\n  checker_id INTEGER NOT NULL,\\n  check_date DATE NOT NULL,\\n  result VARCHAR(50) NOT NULL,\\n  score INTEGER NOT NULL,\\n  items JSONB NOT NULL,\\n  issues JSONB,\\n  photos TEXT[],\\n  remarks TEXT,\\n  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\n  updated_at TIMESTAMP,\\n  FOREIGN KEY (checker_id) REFERENCES kitchen_employees(id)\\n);\\n```\\n\\n#### 4.2.13 安全检查表（safety_inspections）\\n\\n```sql\\nCREATE TABLE safety_inspections (\\n  id SERIAL PRIMARY KEY,\\n  check_code VARCHAR(50) UNIQUE NOT NULL,\\n  type VARCHAR(50) NOT NULL,\\n  project VARCHAR(100) NOT NULL,\\n  checker_id INTEGER NOT NULL,\\n  check_date DATE NOT NULL,\\n  result VARCHAR(50) NOT NULL,\\n  items JSONB NOT NULL,\\n  risks JSONB,\\n  photos TEXT[],\\n  remarks TEXT,\\n  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\n  updated_at TIMESTAMP,\\n  FOREIGN KEY (checker_id) REFERENCES kitchen_employees(id)\\n);\\n```\\n\\n#### 4.2.14 事故记录表（accidents）\\n\\n```sql\\nCREATE TABLE accidents (\\n  id SERIAL PRIMARY KEY,\\n  accident_code VARCHAR(50) UNIQUE NOT NULL,\\n  type VARCHAR(50) NOT NULL,\\n  occurrence_time TIMESTAMP NOT NULL,\\n  location VARCHAR(200) NOT NULL,\\n  description TEXT NOT NULL,\\n  involved_persons JSONB,\\n  measures TEXT,\\n  responsible_person_id INTEGER,\\n  photos TEXT[],\\n  remarks TEXT,\\n  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\\n  FOREIGN KEY (responsible_person_id) REFERENCES kitchen_employees(id)\\n);\\n```\\n\\n### 4.3 API设计\\n\\n#### 4.3.1 设备管理API\\n\\n| 方法 | 路径 | 描述 |\\n|------|------|------|\\n| GET | /api/kitchen/equipment | 获取设备列表 |\\n| GET | /api/kitchen/equipment/:id | 获取设备详情 |\\n| POST | /api/kitchen/equipment | 创建设备 |\\n| PUT | /api/kitchen/equipment/:id | 更新设备 |\\n| DELETE | /api/kitchen/equipment/:id | 删除设备 |\\n| PUT | /api/kitchen/equipment/:id/status | 更新设备状态 |\\n| GET | /api/kitchen/equipment/:id/maintenance | 获取设备维护记录 |\\n| POST | /api/kitchen/equipment/:id/maintenance | 创建设备维护记录 |\\n\\n#### 4.3.2 员工管理API\\n\\n| 方法 | 路径 | 描述 |\\n|------|------|------|\\n| GET | /api/kitchen/employees | 获取员工列表 |\\n| GET | /api/kitchen/employees/:id | 获取员工详情 |\\n| POST | /api/kitchen/employees | 创建员工 |\\n| PUT | /api/kitchen/employees/:id | 更新员工 |\\n| DELETE | /api/kitchen/employees/:id | 删除员工 |\\n| GET | /api/kitchen/employees/:id/schedules | 获取员工排班 |\\n| POST | /api/kitchen/employees/:id/schedules | 创建员工排班 |\\n| GET | /api/kitchen/employees/:id/performance | 获取员工绩效 |\\n| POST | /api/kitchen/employees/:id/performance | 创建员工绩效 |\\n\\n#### 4.3.3 任务管理API\\n\\n| 方法 | 路径 | 描述 |\\n|------|------|------|\\n| GET | /api/kitchen/tasks | 获取任务列表 |\\n| GET | /api/kitchen/tasks/:id | 获取任务详情 |\\n| POST | /api/kitchen/tasks | 创建任务 |\\n| PUT | /api/kitchen/tasks/:id | 更新任务 |\\n| DELETE | /api/kitchen/tasks/:id | 删除任务 |\\n| PUT | /api/kitchen/tasks/:id/status | 更新任务状态 |\\n| GET | /api/kitchen/tasks/:id/progress | 获取任务进度 |\\n| PUT | /api/kitchen/tasks/:id/progress | 更新任务进度 |\\n\\n#### 4.3.4 库存管理API\\n\\n| 方法 | 路径 | 描述 |\\n|------|------|------|\\n| GET | /api/kitchen/inventory | 获取库存列表 |\\n| GET | /api/kitchen/inventory/:id | 获取库存详情 |\\n| POST | /api/kitchen/inventory/:id/stock-in | 入库 |\\n| POST | /api/kitchen/inventory/:id/stock-out | 出库 |\\n| GET | /api/kitchen/inventory/counts | 获取盘点记录 |\\n| POST | /api/kitchen/inventory/counts | 创建盘点记录 |\\n\\n#### 4.3.5 卫生管理API\\n\\n| 方法 | 路径 | 描述 |\\n|------|------|------|\\n| GET | /api/kitchen/hygiene-inspections | 获取卫生检查记录 |\\n| GET | /api/kitchen/hygiene-inspections/:id | 获取卫生检查详情 |\\n| POST | /api/kitchen/hygiene-inspections | 创建卫生检查记录 |\\n| PUT | /api/kitchen/hygiene-inspections/:id | 更新卫生检查记录 |\\n| PUT | /api/kitchen/hygiene-inspections/:id/issues/:issueId | 更新问题状态 |\\n\\n#### 4.3.6 安全管理API\\n\\n| 方法 | 路径 | 描述 |\\n|------|------|------|\\n| GET | /api/kitchen/safety-inspections | 获取安全检查记录 |\\n| GET | /api/kitchen/safety-inspections/:id | 获取安全检查详情 |\\n| POST | /api/kitchen/safety-inspections | 创建安全检查记录 |\\n| PUT | /api/kitchen/safety-inspections/:id | 更新安全检查记录 |\\n| GET | /api/kitchen/accidents | 获取事故记录 |\\n| POST | /api/kitchen/accidents | 创建事故记录 |\\n\\n#### 4.3.7 统计分析API\\n\\n| 方法 | 路径 | 描述 |\\n|------|------|------|\\n| GET | /api/kitchen/statistics/equipment | 获取设备统计 |\\n| GET | /api/kitchen/statistics/employees | 获取员工统计 |\\n| GET | /api/kitchen/statistics/tasks | 获取任务统计 |\\n| GET | /api/kitchen/statistics/inventory | 获取库存统计 |\\n| GET | /api/kitchen/statistics/hygiene | 获取卫生统计 |\\n| GET | /api/kitchen/statistics/safety | 获取安全统计 |\\n\\n### 4.4 系统架构设计\\n\\n#### 4.4.1 整体架构\\n\\n```\\n┌─────────────────────────────────────────────────────────┐\\n│                      前端层                              │\\n│  ┌──────────────┐  ┌──────────────┐  ┌──────────────┐ │\\n│  │  厨房设备    │  │  厨房员工    │  │  厨房任务    │ │\\n│  │  管理模块    │  │  管理模块    │  │  管理模块    │ │\\n│  └──────────────┘  └──────────────┘  └──────────────┘ │\\n│  ┌──────────────┐  ┌──────────────┐  ┌──────────────┐ │\\n│  │  厨房库存    │  │  厨房卫生    │  │  厨房安全    │ │\\n│  │  管理模块    │  │  管理模块    │  │  管理模块    │ │\\n│  └──────────────┘  └──────────────┘  └──────────────┘ │\\n│  ┌──────────────┐                                        │\\n│  │  厨房绩效    │                                        │\\n│  │  统计模块    │                                        │\\n│  └──────────────┘                                        │\\n└─────────────────────────────────────────────────────────┘\\n                            │\\n                            ▼\\n┌─────────────────────────────────────────────────────────┐\\n│                      API网关层                            │\\n│  ┌──────────────┐  ┌──────────────┐  ┌──────────────┐ │\\n│  │  认证授权    │  │  请求路由    │  │  限流熔断    │ │\\n│  └──────────────┘  └──────────────┘  └──────────────┘ │\\n└─────────────────────────────────────────────────────────┘\\n                            │\\n                            ▼\\n┌─────────────────────────────────────────────────────────┐\\n│                      业务逻辑层                          │\\n│  ┌──────────────┐  ┌──────────────┐  ┌──────────────┐ │\\n│  │  设备服务    │  │  员工服务    │  │  任务服务    │ │\\n│  └──────────────┘  └──────────────┘  └──────────────┘ │\\n│  ┌──────────────┐  ┌──────────────┐  ┌──────────────┐ │\\n│  │  库存服务    │  │  卫生服务    │  │  安全服务    │ │\\n│  └──────────────┘  └──────────────┘  └──────────────┘ │\\n│  ┌──────────────┐                                        │\\n│  │  统计服务    │                                        │\\n│  └──────────────┘                                        │\\n└─────────────────────────────────────────────────────────┘\\n                            │\\n                            ▼\\n┌─────────────────────────────────────────────────────────┐\\n│                      数据访问层                          │\\n│  ┌──────────────┐  ┌──────────────┐  ┌──────────────┐ │\\n│  │  设备DAO     │  │  员工DAO     │  │  任务DAO     │ │\\n│  └──────────────┘  └──────────────┘  └──────────────┘ │\\n│  ┌──────────────┐  ┌──────────────┐  ┌──────────────┐ │\\n│  │  库存DAO     │  │  卫生DAO     │  │  安全DAO     │ │\\n│  └──────────────┘  └──────────────┘  └──────────────┘ │\\n│  ┌──────────────┐                                        │\\n│  │  统计DAO     │                                        │\\n│  └──────────────┘                                        │\\n└─────────────────────────────────────────────────────────┘\\n                            │\\n                            ▼\\n┌─────────────────────────────────────────────────────────┐\\n│                      数据存储层                          │\\n│  ┌──────────────┐  ┌──────────────┐  ┌──────────────┐ │\\n│  │ PostgreSQL   │  │    Redis     │  │  文件存储    │ │\\n│  └──────────────┘  └──────────────┘  └──────────────┘ │\\n└─────────────────────────────────────────────────────────┘\\n```\\n\\n#### 4.4.2 模块依赖关系\\n\\n```\\n厨房管理模块\\n├── 设备管理\\n│   ├── 设备信息管理\\n│   ├── 设备维护管理\\n│   └── 设备提醒服务\\n├── 员工管理\\n│   ├── 员工信息管理\\n│   ├── 员工排班管理\\n│   └── 员工绩效管理\\n├── 任务管理\\n│   ├── 任务分配管理\\n│   ├── 任务进度跟踪\\n│   └── 任务提醒服务\\n├── 库存管理\\n│   ├── 库存出入库管理\\n│   ├── 库存盘点管理\\n│   └── 库存预警服务\\n├── 卫生管理\\n│   ├── 卫生检查管理\\n│   ├── 问题跟踪管理\\n│   └── 卫生检查提醒\\n└── 安全管理\\n    ├── 安全检查管理\\n    ├── 风险预警服务\\n    └── 事故记录管理\\n```\\n\\n## 5. 界面设计\\n\\n### 5.1 厨房管理主界面\\n\\n#### 5.1.1 页面布局\\n\\n```\\n┌─────────────────────────────────────────────────────────┐\\n│  厨房管理                              [刷新] [设置]    │\\n├─────────────────────────────────────────────────────────┤\\n│  [设备管理] [员工管理] [任务管理] [库存管理]            │\\n│  [卫生管理] [安全管理] [绩效统计]                       │\\n├─────────────────────────────────────────────────────────┤\\n│  ┌──────────────┐  ┌──────────────┐  ┌──────────────┐ │\\n│  │  设备总数    │  │  员工总数    │  │  任务总数    │ │\\n│  │     50       │  │     30       │  │    120       │ │\\n│  └──────────────┘  └──────────────┘  └──────────────┘ │\\n│  ┌──────────────┐  ┌──────────────┐  ┌──────────────┐ │\\n│  │  库存总数    │  │  卫生合格率  │  │  安全合格率  │ │\\n│  │    200       │  │    98%       │  │    99%       │ │\\n│  └──────────────┘  └──────────────┘  └──────────────┘ │\\n├─────────────────────────────────────────────────────────┤\\n│  [当前活动任务]                                        │\\n│  ┌───────────────────────────────────────────────────┐ │\\n│  │ 任务1 - 烹饪任务 - 进行中 - 员工A - 30分钟       │ │\\n│  │ 任务2 - 准备任务 - 进行中 - 员工B - 15分钟       │ │\\n│  │ 任务3 - 清洁任务 - 待处理 - 员工C - 45分钟       │ │\\n│  └───────────────────────────────────────────────────┘ │\\n├─────────────────────────────────────────────────────────┤\\n│  [库存预警]                                            │\\n│  ┌───────────────────────────────────────────────────┐ │\\n│  │ 材料1 - 数量不足 - 当前: 5 / 最小: 10            │ │\\n│  │ 材料2 - 即将过期 - 到期日期: 2025-01-25          │ │\\n│  └───────────────────────────────────────────────────┘ │\\n├─────────────────────────────────────────────────────────┤\\n│  [设备维护提醒]                                        │\\n│  ┌───────────────────────────────────────────────────┐ │\\n│  │ 设备1 - 下次维护日期: 2025-01-22                 │ │\\n│  │ 设备2 - 下次维护日期: 2025-01-23                 │ │\\n│  └───────────────────────────────────────────────────┘ │\\n└─────────────────────────────────────────────────────────┘\\n```\\n\\n### 5.2 设备管理界面\\n\\n#### 5.2.1 设备列表界面\\n\\n```\\n┌─────────────────────────────────────────────────────────┐\\n│  设备管理                                  [新增设备]    │\\n├─────────────────────────────────────────────────────────┤\\n│  搜索: [________________] 类型: [全部▼] 状态: [全部▼]  │\\n│  位置: [全部▼]                                          │\\n├─────────────────────────────────────────────────────────┤\\n│  ┌───────────────────────────────────────────────────┐ │\\n│  │ 设备编号 │ 设备名称 │ 类型 │ 状态 │ 位置 │ 操作   │ │\\n│  ├───────────────────────────────────────────────────┤ │\\n│  │ EQ001    │ 炉灶     │ 烹饪 │ 正常 │ A区  │ [编辑] │ │\\n│  │          │          │ 设备 │      │      │ [删除] │ │\\n│  ├───────────────────────────────────────────────────┤ │\\n│  │ EQ002    │ 冰箱     │ 制冷 │ 正常 │ B区  │ [编辑] │ │\\n│  │          │          │ 设备 │      │      │ [删除] │ │\\n│  ├───────────────────────────────────────────────────┤ │\\n│  │ EQ003    │ 切菜机   │ 加工 │ 维修 │ A区  │ [编辑] │ │\\n│  │          │          │ 设备 │ 中   │      │ [删除] │ │\\n│  └───────────────────────────────────────────────────┘ │\\n│  共 50 条记录  [上一页] 1 / 5 [下一页]                │\\n└─────────────────────────────────────────────────────────┘\\n```\\n\\n#### 5.2.2 设备详情界面\\n\\n```\\n┌─────────────────────────────────────────────────────────┐\\n│  设备详情                              [返回] [编辑]    │\\n├─────────────────────────────────────────────────────────┤\\n│  设备编号: EQ001                                       │\\n│  设备名称: 炉灶                                         │\\n│  设备类型: 烹饪设备                                     │\\n│  品牌: XXX                                             │\\n│  型号: XXX-001                                         │\\n│  状态: 正常                                            │\\n│  位置: A区                                             │\\n│  购买日期: 2024-01-15                                  │\\n│  保修到期: 2025-01-15                                  │\\n│  上次维护: 2024-12-15                                  │\\n│  下次维护: 2025-01-15                                  │\\n│  维护间隔: 30天                                        │\\n│  功率: 5000瓦                                          │\\n│  负责人: 张三 (13800138000)                            │\\n├─────────────────────────────────────────────────────────┤\\n│  [维护记录]                                            │\\n│  ┌───────────────────────────────────────────────────┐ │\\n│  │ 2024-12-15 - 常规维护 - 维修人员A - 费用: 500元   │ │\\n│  │ 2024-11-15 - 常规维护 - 维修人员A - 费用: 500元   │ │\\n│  └───────────────────────────────────────────────────┘ │\\n└─────────────────────────────────────────────────────────┘\\n```\\n\\n### 5.3 员工管理界面\\n\\n#### 5.3.1 员工列表界面\\n\\n```\\n┌─────────────────────────────────────────────────────────┐\\n│  员工管理                                  [新增员工]    │\\n├─────────────────────────────────────────────────────────┤\\n│  搜索: [________________] 岗位: [全部▼] 状态: [全部▼]  │\\n│  技能: [全部▼]                                          │\\n├─────────────────────────────────────────────────────────┤\\n│  ┌───────────────────────────────────────────────────┐ │\\n│  │ 员工编号 │ 姓名 │ 岗位 │ 级别 │ 状态 │ 操作     │ │\\n│  ├───────────────────────────────────────────────────┤ │\\n│  │ EMP001   │ 张三 │ 厨师长│ 高级 │ 在职 │ [编辑]  │ │\\n│  │          │      │      │      │      │ [删除]  │ │\\n│  ├───────────────────────────────────────────────────┤ │\\n│  │ EMP002   │ 李四 │ 主厨 │ 中级 │ 在职 │ [编辑]  │ │\\n│  │          │      │      │      │      │ [删除]  │ │\\n│  ├───────────────────────────────────────────────────┤ │\\n│  │ EMP003   │ 王五 │ 厨师 │ 初级 │ 请假 │ [编辑]  │ │\\n│  │          │      │      │      │      │ [删除]  │ │\\n│  └───────────────────────────────────────────────────┘ │\\n│  共 30 条记录  [上一页] 1 / 3 [下一页]                │\\n└─────────────────────────────────────────────────────────┘\\n```\\n\\n#### 5.3.2 员工排班界面\\n\\n```\\n┌─────────────────────────────────────────────────────────┐\\n│  员工排班                                  [新增排班]    │\\n├─────────────────────────────────────────────────────────┤\\n│  员工: [张三▼]  日期: [2025-01-20]                     │\\n├─────────────────────────────────────────────────────────┤\\n│  ┌───────────────────────────────────────────────────┐ │\\n│  │ 日期       │ 班次 │ 工作时间          │ 操作     │ │\\n│  ├───────────────────────────────────────────────────┤ │\\n│  │ 2025-01-20 │ 早班 │ 06:00 - 14:00    │ [编辑]   │ │\\n│  │ 2025-01-21 │ 中班 │ 10:00 - 18:00    │ [编辑]   │ │\\n│  │ 2025-01-22 │ 晚班 │ 14:00 - 22:00    │ [编辑]   │ │\\n│  └───────────────────────────────────────────────────┘ │\\n└─────────────────────────────────────────────────────────┘\\n```\\n\\n### 5.4 任务管理界面\\n\\n#### 5.4.1 任务列表界面\\n\\n```\\n┌─────────────────────────────────────────────────────────┐\\n│  任务管理                                  [新增任务]    │\\n├─────────────────────────────────────────────────────────┤\\n│  搜索: [________________] 类型: [全部▼] 状态: [全部▼]  │\\n│  优先级: [全部▼]  分配给: [全部▼]                       │\\n├─────────────────────────────────────────────────────────┤\\n│  ┌───────────────────────────────────────────────────┐ │\\n│  │ 任务编号 │ 任务名称 │ 类型 │ 状态 │ 优先级 │ 操作│ │\\n│  ├───────────────────────────────────────────────────┤ │\\n│  │ TASK001  │ 烹饪任务A│ 烹饪 │ 进行│ 高    │ [编辑]│ │\\n│  │          │          │ 任务 │ 中  │       │ [删除]│ │\\n│  ├───────────────────────────────────────────────────┤ │\\n│  │ TASK002  │ 准备任务B│ 准备 │ 待处│ 中    │ [编辑]│ │\\n│  │          │          │ 任务 │ 理  │       │ [删除]│ │\\n│  ├───────────────────────────────────────────────────┤ │\\n│  │ TASK003  │ 清洁任务C│ 清洁 │ 已完│ 低    │ [编辑]│ │\\n│  │          │          │ 任务 │ 成  │       │ [删除]│ │\\n│  └───────────────────────────────────────────────────┘ │\\n│  共 120 条记录  [上一页] 1 / 12 [下一页]              │\\n└─────────────────────────────────────────────────────────┘\\n```\\n\\n#### 5.4.2 任务详情界面\\n\\n```\\n┌\",\"originTextLength\":38839,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768885750656}]",
  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/types/kitchen.ts": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":317,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":317,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"/**\\\\n * @fileoverview YYC³餐饮平台 - 厨房管理类型定义\\\\n * @description 厨房管理模块相关数据结构\\\\n * @author YYC³\\\\n * @version 1.0.0\\\\n * @created 2025-01-20\\\\n * @copyright Copyright (c) 2025 YYC³\\\\n * @license MIT\\\\n */\\\\n\\\\nexport interface KitchenEquipment {\\\\n  id: string;\\\\n  equipmentCode: string;\\\\n  name: string;\\\\n  type: EquipmentType;\\\\n  brand: string;\\\\n  model: string;\\\\n  status: EquipmentStatus;\\\\n  location: string;\\\\n  purchaseDate: string;\\\\n  warrantyDate: string;\\\\n  lastMaintenanceDate: string;\\\\n  nextMaintenanceDate: string;\\\\n  maintenanceInterval: number;\\\\n  power: number;\\\\n  specifications: Record<string, any>;\\\\n  images: string[];\\\\n  description?: string;\\\\n  responsiblePersonId: string;\\\\n  createdAt: string;\\\\n  updatedAt?: string;\\\\n}\\\\n\\\\nexport type EquipmentType = \\\\n  | \\\\'cooking\\\\'\\\\n  | \\\\'refrigeration\\\\'\\\\n  | \\\\'baking\\\\'\\\\n  | \\\\'dishwashing\\\\'\\\\n  | \\\\'cutting\\\\'\\\\n  | \\\\'mixing\\\\'\\\\n  | \\\\'other\\\\';\\\\n\\\\nexport type EquipmentStatus = \\\\n  | \\\\'normal\\\\'\\\\n  | \\\\'maintenance\\\\'\\\\n  | \\\\'repair\\\\'\\\\n  | \\\\'scrapped\\\\';\\\\n\\\\nexport interface KitchenEmployee {\\\\n  id: string;\\\\n  employeeCode: string;\\\\n  name: string;\\\\n  avatar?: string;\\\\n  position: EmployeePosition;\\\\n  status: EmployeeStatus;\\\\n  phone: string;\\\\n  email?: string;\\\\n  hireDate: string;\\\\n  skills: string[];\\\\n  certifications: Certification[];\\\\n  currentTasks: number;\\\\n  totalTasksCompleted: number;\\\\n  efficiency: number;\\\\n  averageTime: number;\\\\n  workSchedule: WorkSchedule[];\\\\n  createdAt: string;\\\\n  updatedAt?: string;\\\\n}\\\\n\\\\nexport type EmployeePosition = \\\\n  | \\\\'chef\\\\'\\\\n  | \\\\'sous_chef\\\\'\\\\n  | \\\\'line_cook\\\\'\\\\n  | \\\\'prep_cook\\\\'\\\\n  | \\\\'dishwasher\\\\'\\\\n  | \\\\'other\\\\';\\\\n\\\\nexport type EmployeeStatus = \\\\n  | \\\\'online\\\\'\\\\n  | \\\\'busy\\\\'\\\\n  | \\\\'break\\\\'\\\\n  | \\\\'offline\\\\';\\\\n\\\\nexport interface Certification {\\\\n  id: string;\\\\n  name: string;\\\\n  issueDate: string;\\\\n  expiryDate: string;\\\\n  issuer: string;\\\\n}\\\\n\\\\nexport interface WorkSchedule {\\\\n  id: string;\\\\n  dayOfWeek: number;\\\\n  startTime: string;\\\\n  endTime: string;\\\\n  station?: string;\\\\n}\\\\n\\\\nexport interface KitchenTask {\\\\n  id: string;\\\\n  taskId: string;\\\\n  orderNo: string;\\\\n  itemName: string;\\\\n  quantity: number;\\\\n  station: TaskStation;\\\\n  priority: TaskPriority;\\\\n  status: TaskStatus;\\\\n  tableNumber: string;\\\\n  estimatedTime?: number;\\\\n  assignedTo?: string;\\\\n  specialRequests?: string;\\\\n  createdAt: string;\\\\n  updatedAt?: string;\\\\n}\\\\n\\\\nexport type TaskStation = \\\\n  | \\\\'hot_dish\\\\'\\\\n  | \\\\'cold_dish\\\\'\\\\n  | \\\\'soup\\\\'\\\\n  | \\\\'bar\\\\'\\\\n  | \\\\'dessert\\\\'\\\\n  | \\\\'general\\\\';\\\\n\\\\nexport type TaskPriority = \\\\n  | \\\\'low\\\\'\\\\n  | \\\\'normal\\\\'\\\\n  | \\\\'high\\\\'\\\\n  | \\\\'urgent\\\\';\\\\n\\\\nexport type TaskStatus = \\\\n  | \\\\'pending\\\\'\\\\n  | \\\\'preparing\\\\'\\\\n  | \\\\'ready\\\\'\\\\n  | \\\\'served\\\\'\\\\n  | \\\\'cancelled\\\\';\\\\n\\\\nexport interface KitchenInventory {\\\\n  id: string;\\\\n  itemCode: string;\\\\n  name: string;\\\\n  category: InventoryCategory;\\\\n  unit: string;\\\\n  quantity: number;\\\\n  minQuantity: number;\\\\n  maxQuantity: number;\\\\n  unitPrice: number;\\\\n  supplier: string;\\\\n  lastRestockDate: string;\\\\n  expiryDate?: string;\\\\n  status: InventoryStatus;\\\\n  location: string;\\\\n  createdAt: string;\\\\n  updatedAt?: string;\\\\n}\\\\n\\\\nexport type InventoryCategory = \\\\n  | \\\\'vegetables\\\\'\\\\n  | \\\\'meat\\\\'\\\\n  | \\\\'seafood\\\\'\\\\n  | \\\\'dairy\\\\'\\\\n  | \\\\'dry_goods\\\\'\\\\n  | \\\\'spices\\\\'\\\\n  | \\\\'other\\\\';\\\\n\\\\nexport type InventoryStatus = \\\\n  | \\\\'normal\\\\'\\\\n  | \\\\'low_stock\\\\'\\\\n  | \\\\'out_of_stock\\\\'\\\\n  | \\\\'expired\\\\';\\\\n\\\\nexport interface HygieneRecord {\\\\n  id: string;\\\\n  recordCode: string;\\\\n  type: HygieneType;\\\\n  area: string;\\\\n  inspectorId: string;\\\\n  inspectorName: string;\\\\n  checkDate: string;\\\\n  checkTime: string;\\\\n  items: HygieneCheckItem[];\\\\n  result: HygieneResult;\\\\n  score: number;\\\\n  issues: HygieneIssue[];\\\\n  photos: string[];\\\\n  notes?: string;\\\\n  createdAt: string;\\\\n  updatedAt?: string;\\\\n}\\\\n\\\\nexport type HygieneType = \\\\n  | \\\\'daily\\\\'\\\\n  | \\\\'weekly\\\\'\\\\n  | \\\\'monthly\\\\'\\\\n  | \\\\'special\\\\';\\\\n\\\\nexport interface HygieneCheckItem {\\\\n  id: string;\\\\n  item: string;\\\\n  standard: string;\\\\n  result: \\\\'pass\\\\' | \\\\'fail\\\\';\\\\n  notes?: string;\\\\n}\\\\n\\\\nexport type HygieneResult = \\\\n  | \\\\'pass\\\\'\\\\n  | \\\\'fail\\\\'\\\\n  | \\\\'conditional\\\\';\\\\n\\\\nexport interface HygieneIssue {\\\\n  id: string;\\\\n  description: string;\\\\n  severity: \\\\'low\\\\' | \\\\'medium\\\\' | \\\\'high\\\\';\\\\n  status: \\\\'pending\\\\' | \\\\'in_progress\\\\' | \\\\'resolved\\\\';\\\\n  dueDate: string;\\\\n  assignedTo?: string;\\\\n}\\\\n\\\\nexport interface SafetyRecord {\\\\n  id: string;\\\\n  recordCode: string;\\\\n  type: SafetyType;\\\\n  location: string;\\\\n  reporterId: string;\\\\n  reporterName: string;\\\\n  incidentDate: string;\\\\n  incidentTime: string;\\\\n  description: string;\\\\n  severity: SafetySeverity;\\\\n  status: SafetyStatus;\\\\n  photos: string[];\\\\n  witnesses: string[];\\\\n  actions: SafetyAction[];\\\\n  createdAt: string;\\\\n  updatedAt?: string;\\\\n}\\\\n\\\\nexport type SafetyType = \\\\n  | \\\\'fire\\\\'\\\\n  | \\\\'injury\\\\'\\\\n  | \\\\'equipment\\\\'\\\\n  | \\\\'food_poisoning\\\\'\\\\n  | \\\\'other\\\\';\\\\n\\\\nexport type SafetySeverity = \\\\n  | \\\\'minor\\\\'\\\\n  | \\\\'moderate\\\\'\\\\n  | \\\\'severe\\\\'\\\\n  | \\\\'critical\\\\';\\\\n\\\\nexport type SafetyStatus = \\\\n  | \\\\'reported\\\\'\\\\n  | \\\\'investigating\\\\'\\\\n  | \\\\'resolved\\\\'\\\\n  | \\\\'closed\\\\';\\\\n\\\\nexport interface SafetyAction {\\\\n  id: string;\\\\n  action: string;\\\\n  responsiblePerson: string;\\\\n  dueDate: string;\\\\n  status: \\\\'pending\\\\' | \\\\'in_progress\\\\' | \\\\'completed\\\\';\\\\n  completedDate?: string;\\\\n}\\\\n\\\\nexport interface KitchenStats {\\\\n  activeTasks: number;\\\\n  completedToday: number;\\\\n  efficiencyRate: number;\\\\n  averagePreparationTime: number;\\\\n  totalEmployees: number;\\\\n  onlineEmployees: number;\\\\n  totalEquipment: number;\\\\n  normalEquipment: number;\\\\n  maintenanceEquipment: number;\\\\n  lowStockItems: number;\\\\n  expiredItems: number;\\\\n}\\\\n\\\\nexport interface KitchenAnalytics {\\\\n  taskDistribution: TaskDistributionData[];\\\\n  stationDistribution: StationDistributionData[];\\\\n  staffEfficiency: StaffEfficiencyData[];\\\\n  peakHours: PeakHourData[];\\\\n  equipmentUtilization: EquipmentUtilizationData[];\\\\n  inventoryTrends: InventoryTrendData[];\\\\n}\\\\n\\\\nexport interface TaskDistributionData {\\\\n  status: string;\\\\n  count: number;\\\\n  percentage: number;\\\\n}\\\\n\\\\nexport interface StationDistributionData {\\\\n  station: string;\\\\n  count: number;\\\\n  percentage: number;\\\\n}\\\\n\\\\nexport interface StaffEfficiencyData {\\\\n  employeeId: string;\\\\n  employeeName: string;\\\\n  tasksCompleted: number;\\\\n  averageTime: number;\\\\n  efficiency: number;\\\\n}\\\\n\\\\nexport interface PeakHourData {\\\\n  hour: number;\\\\n  taskCount: number;\\\\n  orderCount: number;\\\\n}\\\\n\\\\nexport interface EquipmentUtilizationData {\\\\n  equipmentId: string;\\\\n  equipmentName: string;\\\\n  usageHours: number;\\\\n  utilizationRate: number;\\\\n}\\\\n\\\\nexport interface InventoryTrendData {\\\\n  date: string;\\\\n  itemCount: number;\\\\n  value: number;\\\\n}\\\\n\\\\nexport interface KitchenDisplay {\\\\n  id: string;\\\\n  displayName: string;\\\\n  station: string;\\\\n  type: \\\\'task\\\\' | \\\\'order\\\\' | \\\\'custom\\\\';\\\\n  layout: DisplayLayout;\\\\n  filters: DisplayFilter[];\\\\n  refreshInterval: number;\\\\n  isActive: boolean;\\\\n  createdAt: string;\\\\n  updatedAt?: string;\\\\n}\\\\n\\\\nexport interface DisplayLayout {\\\\n  columns: number;\\\\n  rows: number;\\\\n  cardSize: \\\\'small\\\\' | \\\\'medium\\\\' | \\\\'large\\\\';\\\\n  showDetails: boolean;\\\\n  showTimer: boolean;\\\\n}\\\\n\\\\nexport interface DisplayFilter {\\\\n  field: string;\\\\n  operator: \\\\'eq\\\\' | \\\\'neq\\\\' | \\\\'gt\\\\' | \\\\'lt\\\\' | \\\\'in\\\\' | \\\\'contains\\\\';\\\\n  value: any;\\\\n}\\\\n\",\"originAcceptText\":\"/**\\n * @fileoverview YYC³餐饮平台 - 厨房管理类型定义\\n * @description 厨房管理模块相关数据结构\\n * @author YYC³\\n * @version 1.0.0\\n * @created 2025-01-20\\n * @copyright Copyright (c) 2025 YYC³\\n * @license MIT\\n */\\n\\nexport interface KitchenEquipment {\\n  id: string;\\n  equipmentCode: string;\\n  name: string;\\n  type: EquipmentType;\\n  brand: string;\\n  model: string;\\n  status: EquipmentStatus;\\n  location: string;\\n  purchaseDate: string;\\n  warrantyDate: string;\\n  lastMaintenanceDate: string;\\n  nextMaintenanceDate: string;\\n  maintenanceInterval: number;\\n  power: number;\\n  specifications: Record<string, any>;\\n  images: string[];\\n  description?: string;\\n  responsiblePersonId: string;\\n  createdAt: string;\\n  updatedAt?: string;\\n}\\n\\nexport type EquipmentType = \\n  | 'cooking'\\n  | 'refrigeration'\\n  | 'baking'\\n  | 'dishwashing'\\n  | 'cutting'\\n  | 'mixing'\\n  | 'other';\\n\\nexport type EquipmentStatus = \\n  | 'normal'\\n  | 'maintenance'\\n  | 'repair'\\n  | 'scrapped';\\n\\nexport interface KitchenEmployee {\\n  id: string;\\n  employeeCode: string;\\n  name: string;\\n  avatar?: string;\\n  position: EmployeePosition;\\n  status: EmployeeStatus;\\n  phone: string;\\n  email?: string;\\n  hireDate: string;\\n  skills: string[];\\n  certifications: Certification[];\\n  currentTasks: number;\\n  totalTasksCompleted: number;\\n  efficiency: number;\\n  averageTime: number;\\n  workSchedule: WorkSchedule[];\\n  createdAt: string;\\n  updatedAt?: string;\\n}\\n\\nexport type EmployeePosition = \\n  | 'chef'\\n  | 'sous_chef'\\n  | 'line_cook'\\n  | 'prep_cook'\\n  | 'dishwasher'\\n  | 'other';\\n\\nexport type EmployeeStatus = \\n  | 'online'\\n  | 'busy'\\n  | 'break'\\n  | 'offline';\\n\\nexport interface Certification {\\n  id: string;\\n  name: string;\\n  issueDate: string;\\n  expiryDate: string;\\n  issuer: string;\\n}\\n\\nexport interface WorkSchedule {\\n  id: string;\\n  dayOfWeek: number;\\n  startTime: string;\\n  endTime: string;\\n  station?: string;\\n}\\n\\nexport interface KitchenTask {\\n  id: string;\\n  taskId: string;\\n  orderNo: string;\\n  itemName: string;\\n  quantity: number;\\n  station: TaskStation;\\n  priority: TaskPriority;\\n  status: TaskStatus;\\n  tableNumber: string;\\n  estimatedTime?: number;\\n  assignedTo?: string;\\n  specialRequests?: string;\\n  createdAt: string;\\n  updatedAt?: string;\\n}\\n\\nexport type TaskStation = \\n  | 'hot_dish'\\n  | 'cold_dish'\\n  | 'soup'\\n  | 'bar'\\n  | 'dessert'\\n  | 'general';\\n\\nexport type TaskPriority = \\n  | 'low'\\n  | 'normal'\\n  | 'high'\\n  | 'urgent';\\n\\nexport type TaskStatus = \\n  | 'pending'\\n  | 'preparing'\\n  | 'ready'\\n  | 'served'\\n  | 'cancelled';\\n\\nexport interface KitchenInventory {\\n  id: string;\\n  itemCode: string;\\n  name: string;\\n  category: InventoryCategory;\\n  unit: string;\\n  quantity: number;\\n  minQuantity: number;\\n  maxQuantity: number;\\n  unitPrice: number;\\n  supplier: string;\\n  lastRestockDate: string;\\n  expiryDate?: string;\\n  status: InventoryStatus;\\n  location: string;\\n  createdAt: string;\\n  updatedAt?: string;\\n}\\n\\nexport type InventoryCategory = \\n  | 'vegetables'\\n  | 'meat'\\n  | 'seafood'\\n  | 'dairy'\\n  | 'dry_goods'\\n  | 'spices'\\n  | 'other';\\n\\nexport type InventoryStatus = \\n  | 'normal'\\n  | 'low_stock'\\n  | 'out_of_stock'\\n  | 'expired';\\n\\nexport interface HygieneRecord {\\n  id: string;\\n  recordCode: string;\\n  type: HygieneType;\\n  area: string;\\n  inspectorId: string;\\n  inspectorName: string;\\n  checkDate: string;\\n  checkTime: string;\\n  items: HygieneCheckItem[];\\n  result: HygieneResult;\\n  score: number;\\n  issues: HygieneIssue[];\\n  photos: string[];\\n  notes?: string;\\n  createdAt: string;\\n  updatedAt?: string;\\n}\\n\\nexport type HygieneType = \\n  | 'daily'\\n  | 'weekly'\\n  | 'monthly'\\n  | 'special';\\n\\nexport interface HygieneCheckItem {\\n  id: string;\\n  item: string;\\n  standard: string;\\n  result: 'pass' | 'fail';\\n  notes?: string;\\n}\\n\\nexport type HygieneResult = \\n  | 'pass'\\n  | 'fail'\\n  | 'conditional';\\n\\nexport interface HygieneIssue {\\n  id: string;\\n  description: string;\\n  severity: 'low' | 'medium' | 'high';\\n  status: 'pending' | 'in_progress' | 'resolved';\\n  dueDate: string;\\n  assignedTo?: string;\\n}\\n\\nexport interface SafetyRecord {\\n  id: string;\\n  recordCode: string;\\n  type: SafetyType;\\n  location: string;\\n  reporterId: string;\\n  reporterName: string;\\n  incidentDate: string;\\n  incidentTime: string;\\n  description: string;\\n  severity: SafetySeverity;\\n  status: SafetyStatus;\\n  photos: string[];\\n  witnesses: string[];\\n  actions: SafetyAction[];\\n  createdAt: string;\\n  updatedAt?