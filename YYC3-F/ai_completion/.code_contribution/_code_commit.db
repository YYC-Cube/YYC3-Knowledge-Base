  "range-cache-file:///Users/my/Downloads/yyc3-catering-platform/frontend/apps/admin-dashboard/src/composables/__tests__/useKitchen.test.ts": "[{\"originRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":740,\"character\":0}},\"modifyRange\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":740,\"character\":0}},\"action\":\"None\",\"isLine\":false,\"originText\":\"/**\\\\n * @fileoverview YYC³餐饮管理系统 - useKitchen Composable测试\\\\n * @description 测试useKitchen composable的功能\\\\n * @module useKitchen.test\\\\n * @author YYC³\\\\n * @version 1.0.0\\\\n * @created 2025-01-20\\\\n */\\\\n\\\\nimport { describe, it, expect, beforeEach, vi, afterEach } from \\\\'vitest\\\\'\\\\nimport { ref } from \\\\'vue\\\\'\\\\nimport { useKitchen } from \\\\'@/composables/useKitchen\\\\'\\\\nimport { kitchenAPI } from \\\\'@/api/kitchen\\\\'\\\\nimport type {\\\\n  KitchenEquipment,\\\\n  KitchenEmployee,\\\\n  KitchenTask,\\\\n  KitchenInventory,\\\\n  HygieneRecord,\\\\n  SafetyRecord,\\\\n  TaskStatus,\\\\n  EmployeeStatus\\\\n} from \\\\'@/types/kitchen\\\\'\\\\n\\\\nvi.mock(\\\\'@/api/kitchen\\\\', () => ({\\\\n  kitchenAPI: {\\\\n    getStats: vi.fn(),\\\\n    getAnalytics: vi.fn(),\\\\n    getEquipment: vi.fn(),\\\\n    createEquipment: vi.fn(),\\\\n    updateEquipment: vi.fn(),\\\\n    deleteEquipment: vi.fn(),\\\\n    getEmployees: vi.fn(),\\\\n    createEmployee: vi.fn(),\\\\n    updateEmployee: vi.fn(),\\\\n    deleteEmployee: vi.fn(),\\\\n    updateEmployeeStatus: vi.fn(),\\\\n    getTasks: vi.fn(),\\\\n    createTask: vi.fn(),\\\\n    updateTask: vi.fn(),\\\\n    deleteTask: vi.fn(),\\\\n    updateTaskStatus: vi.fn(),\\\\n    assignTask: vi.fn(),\\\\n    getInventory: vi.fn(),\\\\n    createInventoryItem: vi.fn(),\\\\n    updateInventoryItem: vi.fn(),\\\\n    deleteInventoryItem: vi.fn(),\\\\n    restockInventory: vi.fn(),\\\\n    getHygieneRecords: vi.fn(),\\\\n    createHygieneRecord: vi.fn(),\\\\n    updateHygieneRecord: vi.fn(),\\\\n    getSafetyRecords: vi.fn(),\\\\n    createSafetyRecord: vi.fn(),\\\\n    updateSafetyRecord: vi.fn(),\\\\n    getDisplays: vi.fn(),\\\\n    createDisplay: vi.fn(),\\\\n    updateDisplay: vi.fn(),\\\\n    deleteDisplay: vi.fn()\\\\n  }\\\\n}))\\\\n\\\\nvi.mock(\\\\'element-plus\\\\', () => ({\\\\n  ElMessage: {\\\\n    success: vi.fn(),\\\\n    error: vi.fn(),\\\\n    warning: vi.fn(),\\\\n    info: vi.fn()\\\\n  }\\\\n}))\\\\n\\\\ndescribe(\\\\'useKitchen Composable\\\\', () => {\\\\n  const mockStats = {\\\\n    activeTasks: 5,\\\\n    completedToday: 42,\\\\n    efficiencyRate: 85.5,\\\\n    averagePreparationTime: 900,\\\\n    totalEmployees: 10,\\\\n    onlineEmployees: 8,\\\\n    totalEquipment: 20,\\\\n    normalEquipment: 18,\\\\n    maintenanceEquipment: 2,\\\\n    lowStockItems: 3,\\\\n    expiredItems: 1\\\\n  }\\\\n\\\\n  const mockEquipment: KitchenEquipment[] = [\\\\n    {\\\\n      id: \\\\'eq-1\\\\',\\\\n      equipmentCode: \\\\'EQ001\\\\',\\\\n      name: \\\\'商用蒸柜\\\\',\\\\n      type: \\\\'cooking\\\\',\\\\n      brand: \\\\'美的\\\\',\\\\n      model: \\\\'MZ-2000\\\\',\\\\n      status: \\\\'normal\\\\',\\\\n      location: \\\\'后厨A区\\\\',\\\\n      purchaseDate: \\\\'2023-01-01\\\\',\\\\n      warrantyDate: \\\\'2025-01-01\\\\',\\\\n      lastMaintenanceDate: \\\\'2024-12-01\\\\',\\\\n      nextMaintenanceDate: \\\\'2025-01-01\\\\',\\\\n      maintenanceInterval: 30,\\\\n      power: 5000,\\\\n      specifications: { capacity: \\\\'200L\\\\', temperature: \\\\'100°C\\\\' },\\\\n      images: [],\\\\n      responsiblePersonId: \\\\'emp-1\\\\',\\\\n      createdAt: \\\\'2023-01-01T00:00:00Z\\\\'\\\\n    }\\\\n  ]\\\\n\\\\n  const mockEmployees: KitchenEmployee[] = [\\\\n    {\\\\n      id: \\\\'emp-1\\\\',\\\\n      employeeCode: \\\\'KITCHEN001\\\\',\\\\n      name: \\\\'张三\\\\',\\\\n      avatar: \\\\'https://example.com/avatar1.jpg\\\\',\\\\n      position: \\\\'chef\\\\',\\\\n      status: \\\\'online\\\\',\\\\n      phone: \\\\'13800138000\\\\',\\\\n      email: \\\\'zhangsan@example.com\\\\',\\\\n      hireDate: \\\\'2023-01-01\\\\',\\\\n      skills: [\\\\'炒菜\\\\', \\\\'炖汤\\\\', \\\\'切配\\\\'],\\\\n      certifications: [\\\\n        {\\\\n          id: \\\\'cert-1\\\\',\\\\n          name: \\\\'厨师证\\\\',\\\\n          issueDate: \\\\'2022-01-01\\\\',\\\\n          expiryDate: \\\\'2025-01-01\\\\',\\\\n          issuer: \\\\'北京市烹饪协会\\\\'\\\\n        }\\\\n      ],\\\\n      currentTasks: 2,\\\\n      totalTasksCompleted: 150,\\\\n      efficiency: 92.5,\\\\n      averageTime: 12,\\\\n      workSchedule: [],\\\\n      createdAt: \\\\'2023-01-01T00:00:00Z\\\\'\\\\n    },\\\\n    {\\\\n      id: \\\\'emp-2\\\\',\\\\n      employeeCode: \\\\'KITCHEN002\\\\',\\\\n      name: \\\\'李四\\\\',\\\\n      avatar: \\\\'https://example.com/avatar2.jpg\\\\',\\\\n      position: \\\\'line_cook\\\\',\\\\n      status: \\\\'busy\\\\',\\\\n      phone: \\\\'13900139000\\\\',\\\\n      email: \\\\'lisi@example.com\\\\',\\\\n      hireDate: \\\\'2023-06-01\\\\',\\\\n      skills: [\\\\'切配\\\\', \\\\'备菜\\\\'],\\\\n      certifications: [],\\\\n      currentTasks: 3,\\\\n      totalTasksCompleted: 120,\\\\n      efficiency: 88.0,\\\\n      averageTime: 15,\\\\n      workSchedule: [],\\\\n      createdAt: \\\\'2023-06-01T00:00:00Z\\\\'\\\\n    }\\\\n  ]\\\\n\\\\n  const mockTasks: KitchenTask[] = [\\\\n    {\\\\n      id: \\\\'task-1\\\\',\\\\n      taskId: \\\\'TASK001\\\\',\\\\n      orderNo: \\\\'ORD001\\\\',\\\\n      itemName: \\\\'红烧肉\\\\',\\\\n      quantity: 2,\\\\n      station: \\\\'hot_dish\\\\',\\\\n      priority: \\\\'high\\\\',\\\\n      status: \\\\'pending\\\\',\\\\n      tableNumber: \\\\'A01\\\\',\\\\n      estimatedTime: 15,\\\\n      assignedTo: \\\\'emp-1\\\\',\\\\n      specialRequests: \\\\'少辣\\\\',\\\\n      createdAt: \\\\'2025-01-20T10:00:00Z\\\\'\\\\n    },\\\\n    {\\\\n      id: \\\\'task-2\\\\',\\\\n      taskId: \\\\'TASK002\\\\',\\\\n      orderNo: \\\\'ORD002\\\\',\\\\n      itemName: \\\\'清蒸鱼\\\\',\\\\n      quantity: 1,\\\\n      station: \\\\'hot_dish\\\\',\\\\n      priority: \\\\'normal\\\\',\\\\n      status: \\\\'preparing\\\\',\\\\n      tableNumber: \\\\'A02\\\\',\\\\n      estimatedTime: 20,\\\\n      assignedTo: \\\\'emp-2\\\\',\\\\n      createdAt: \\\\'2025-01-20T10:05:00Z\\\\'\\\\n    }\\\\n  ]\\\\n\\\\n  const mockInventory: KitchenInventory[] = [\\\\n    {\\\\n      id: \\\\'inv-1\\\\',\\\\n      itemCode: \\\\'ING001\\\\',\\\\n      name: \\\\'猪肉\\\\',\\\\n      category: \\\\'meat\\\\',\\\\n      unit: \\\\'公斤\\\\',\\\\n      quantity: 50,\\\\n      minQuantity: 10,\\\\n      maxQuantity: 100,\\\\n      unitPrice: 50,\\\\n      supplier: \\\\'供应商A\\\\',\\\\n      lastRestockDate: \\\\'2025-01-15\\\\',\\\\n      status: \\\\'normal\\\\',\\\\n      location: \\\\'冷藏库A\\\\',\\\\n      createdAt: \\\\'2025-01-01T00:00:00Z\\\\'\\\\n    }\\\\n  ]\\\\n\\\\n  beforeEach(() => {\\\\n    vi.clearAllMocks()\\\\n    vi.useFakeTimers()\\\\n  })\\\\n\\\\n  afterEach(() => {\\\\n    vi.restoreAllMocks()\\\\n    vi.useRealTimers()\\\\n  })\\\\n\\\\n  describe(\\\\'状态管理\\\\', () => {\\\\n    it(\\\\'应该初始化正确的状态\\\\', () => {\\\\n      const { loading, stats, equipment, employees, tasks, inventory } = useKitchen()\\\\n\\\\n      expect(loading.value).toBe(false)\\\\n      expect(stats.value).toBeDefined()\\\\n      expect(equipment.value).toEqual([])\\\\n      expect(employees.value).toEqual([])\\\\n      expect(tasks.value).toEqual([])\\\\n      expect(inventory.value).toEqual([])\\\\n    })\\\\n\\\\n    it(\\\\'应该正确计算设备利用率\\\\', () => {\\\\n      const { equipmentUtilization } = useKitchen()\\\\n      expect(equipmentUtilization.value).toBe(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该正确计算员工在线率\\\\', () => {\\\\n      const { employeeOnlineRate } = useKitchen()\\\\n      expect(employeeOnlineRate.value).toBe(0)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'统计数据加载\\\\', () => {\\\\n    it(\\\\'应该成功加载统计数据\\\\', async () => {\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: mockStats\\\\n      }\\\\n      vi.mocked(kitchenAPI.getStats).mockResolvedValue(mockResponse)\\\\n\\\\n      const { loadStats, stats } = useKitchen()\\\\n      await loadStats()\\\\n\\\\n      expect(kitchenAPI.getStats).toHaveBeenCalled()\\\\n      expect(stats.value).toEqual(mockStats)\\\\n    })\\\\n\\\\n    it(\\\\'应该处理加载统计数据失败\\\\', async () => {\\\\n      vi.mocked(kitchenAPI.getStats).mockRejectedValue(new Error(\\\\'加载失败\\\\'))\\\\n\\\\n      const { loadStats } = useKitchen()\\\\n      await expect(loadStats()).resolves.toBeUndefined()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'设备管理\\\\', () => {\\\\n    it(\\\\'应该成功加载设备列表\\\\', async () => {\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: {\\\\n          items: mockEquipment,\\\\n          pagination: { page: 1, limit: 20, total: 1, totalPages: 1 }\\\\n        }\\\\n      }\\\\n      vi.mocked(kitchenAPI.getEquipment).mockResolvedValue(mockResponse)\\\\n\\\\n      const { loadEquipment, equipment } = useKitchen()\\\\n      await loadEquipment()\\\\n\\\\n      expect(kitchenAPI.getEquipment).toHaveBeenCalled()\\\\n      expect(equipment.value).toEqual(mockEquipment)\\\\n    })\\\\n\\\\n    it(\\\\'应该成功创建设备\\\\', async () => {\\\\n      const newEquipment = {\\\\n        equipmentCode: \\\\'EQ002\\\\',\\\\n        name: \\\\'商用烤箱\\\\',\\\\n        type: \\\\'cooking\\\\' as const,\\\\n        brand: \\\\'西门子\\\\',\\\\n        model: \\\\'SI-3000\\\\',\\\\n        status: \\\\'normal\\\\' as const,\\\\n        location: \\\\'后厨B区\\\\',\\\\n        purchaseDate: \\\\'2025-01-20\\\\',\\\\n        warrantyDate: \\\\'2027-01-20\\\\',\\\\n        lastMaintenanceDate: \\\\'2025-01-20\\\\',\\\\n        nextMaintenanceDate: \\\\'2025-02-20\\\\',\\\\n        maintenanceInterval: 30,\\\\n        power: 3000,\\\\n        specifications: { capacity: \\\\'100L\\\\', temperature: \\\\'250°C\\\\' },\\\\n        images: [],\\\\n        responsiblePersonId: \\\\'emp-1\\\\'\\\\n      }\\\\n\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: { ...newEquipment, id: \\\\'eq-2\\\\', createdAt: \\\\'2025-01-20T00:00:00Z\\\\' }\\\\n      }\\\\n      vi.mocked(kitchenAPI.createEquipment).mockResolvedValue(mockResponse)\\\\n\\\\n      const { createEquipment, equipment } = useKitchen()\\\\n      await createEquipment(newEquipment)\\\\n\\\\n      expect(kitchenAPI.createEquipment).toHaveBeenCalledWith(newEquipment)\\\\n      expect(equipment.value.length).toBeGreaterThan(0)\\\\n    })\\\\n\\\\n    it(\\\\'应该成功更新设备\\\\', async () => {\\\\n      const updatedEquipment = {\\\\n        ...mockEquipment[0],\\\\n        name: \\\\'商用蒸柜（更新）\\\\'\\\\n      }\\\\n\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: updatedEquipment\\\\n      }\\\\n      vi.mocked(kitchenAPI.updateEquipment).mockResolvedValue(mockResponse)\\\\n\\\\n      const { updateEquipment } = useKitchen()\\\\n      await updateEquipment(\\\\'eq-1\\\\', updatedEquipment)\\\\n\\\\n      expect(kitchenAPI.updateEquipment).toHaveBeenCalledWith(\\\\'eq-1\\\\', updatedEquipment)\\\\n    })\\\\n\\\\n    it(\\\\'应该成功删除设备\\\\', async () => {\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: true\\\\n      }\\\\n      vi.mocked(kitchenAPI.deleteEquipment).mockResolvedValue(mockResponse)\\\\n\\\\n      const { deleteEquipment } = useKitchen()\\\\n      await deleteEquipment(\\\\'eq-1\\\\')\\\\n\\\\n      expect(kitchenAPI.deleteEquipment).toHaveBeenCalledWith(\\\\'eq-1\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'员工管理\\\\', () => {\\\\n    it(\\\\'应该成功加载员工列表\\\\', async () => {\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: {\\\\n          items: mockEmployees,\\\\n          pagination: { page: 1, limit: 20, total: 2, totalPages: 1 }\\\\n        }\\\\n      }\\\\n      vi.mocked(kitchenAPI.getEmployees).mockResolvedValue(mockResponse)\\\\n\\\\n      const { loadEmployees, employees } = useKitchen()\\\\n      await loadEmployees()\\\\n\\\\n      expect(kitchenAPI.getEmployees).toHaveBeenCalled()\\\\n      expect(employees.value).toEqual(mockEmployees)\\\\n    })\\\\n\\\\n    it(\\\\'应该成功创建员工\\\\', async () => {\\\\n      const newEmployee = {\\\\n        employeeCode: \\\\'KITCHEN003\\\\',\\\\n        name: \\\\'王五\\\\',\\\\n        position: \\\\'line_cook\\\\' as const,\\\\n        status: \\\\'online\\\\' as const,\\\\n        phone: \\\\'13700137000\\\\',\\\\n        email: \\\\'wangwu@example.com\\\\',\\\\n        hireDate: \\\\'2025-01-20\\\\',\\\\n        skills: [\\\\'切配\\\\'],\\\\n        certifications: [],\\\\n        currentTasks: 0,\\\\n        totalTasksCompleted: 0,\\\\n        efficiency: 0,\\\\n        averageTime: 0,\\\\n        workSchedule: []\\\\n      }\\\\n\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: { ...newEmployee, id: \\\\'emp-3\\\\', createdAt: \\\\'2025-01-20T00:00:00Z\\\\' }\\\\n      }\\\\n      vi.mocked(kitchenAPI.createEmployee).mockResolvedValue(mockResponse)\\\\n\\\\n      const { createEmployee } = useKitchen()\\\\n      await createEmployee(newEmployee)\\\\n\\\\n      expect(kitchenAPI.createEmployee).toHaveBeenCalledWith(newEmployee)\\\\n    })\\\\n\\\\n    it(\\\\'应该成功更新员工\\\\', async () => {\\\\n      const updatedEmployee = {\\\\n        ...mockEmployees[0],\\\\n        name: \\\\'张三（更新）\\\\'\\\\n      }\\\\n\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: updatedEmployee\\\\n      }\\\\n      vi.mocked(kitchenAPI.updateEmployee).mockResolvedValue(mockResponse)\\\\n\\\\n      const { updateEmployee } = useKitchen()\\\\n      await updateEmployee(\\\\'emp-1\\\\', updatedEmployee)\\\\n\\\\n      expect(kitchenAPI.updateEmployee).toHaveBeenCalledWith(\\\\'emp-1\\\\', updatedEmployee)\\\\n    })\\\\n\\\\n    it(\\\\'应该成功删除员工\\\\', async () => {\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: true\\\\n      }\\\\n      vi.mocked(kitchenAPI.deleteEmployee).mockResolvedValue(mockResponse)\\\\n\\\\n      const { deleteEmployee } = useKitchen()\\\\n      await deleteEmployee(\\\\'emp-1\\\\')\\\\n\\\\n      expect(kitchenAPI.deleteEmployee).toHaveBeenCalledWith(\\\\'emp-1\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该成功更新员工状态\\\\', async () => {\\\\n      const newStatus: EmployeeStatus = \\\\'break\\\\'\\\\n      const updatedEmployee = {\\\\n        ...mockEmployees[0],\\\\n        status: newStatus\\\\n      }\\\\n\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: updatedEmployee\\\\n      }\\\\n      vi.mocked(kitchenAPI.updateEmployeeStatus).mockResolvedValue(mockResponse)\\\\n\\\\n      const { updateEmployeeStatus } = useKitchen()\\\\n      await updateEmployeeStatus(\\\\'emp-1\\\\', newStatus)\\\\n\\\\n      expect(kitchenAPI.updateEmployeeStatus).toHaveBeenCalledWith(\\\\'emp-1\\\\', newStatus)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'任务管理\\\\', () => {\\\\n    it(\\\\'应该成功加载任务列表\\\\', async () => {\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: {\\\\n          items: mockTasks,\\\\n          pagination: { page: 1, limit: 20, total: 2, totalPages: 1 }\\\\n        }\\\\n      }\\\\n      vi.mocked(kitchenAPI.getTasks).mockResolvedValue(mockResponse)\\\\n\\\\n      const { loadTasks, tasks } = useKitchen()\\\\n      await loadTasks()\\\\n\\\\n      expect(kitchenAPI.getTasks).toHaveBeenCalled()\\\\n      expect(tasks.value).toEqual(mockTasks)\\\\n    })\\\\n\\\\n    it(\\\\'应该成功创建任务\\\\', async () => {\\\\n      const newTask = {\\\\n        taskId: \\\\'TASK003\\\\',\\\\n        orderNo: \\\\'ORD003\\\\',\\\\n        itemName: \\\\'宫保鸡丁\\\\',\\\\n        quantity: 1,\\\\n        station: \\\\'hot_dish\\\\' as const,\\\\n        priority: \\\\'normal\\\\' as const,\\\\n        status: \\\\'pending\\\\' as const,\\\\n        tableNumber: \\\\'A03\\\\',\\\\n        estimatedTime: 18,\\\\n        createdAt: \\\\'2025-01-20T10:10:00Z\\\\'\\\\n      }\\\\n\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: { ...newTask, id: \\\\'task-3\\\\' }\\\\n      }\\\\n      vi.mocked(kitchenAPI.createTask).mockResolvedValue(mockResponse)\\\\n\\\\n      const { createTask } = useKitchen()\\\\n      await createTask(newTask)\\\\n\\\\n      expect(kitchenAPI.createTask).toHaveBeenCalledWith(newTask)\\\\n    })\\\\n\\\\n    it(\\\\'应该成功更新任务\\\\', async () => {\\\\n      const updatedTask = {\\\\n        ...mockTasks[0],\\\\n        status: \\\\'preparing\\\\' as TaskStatus\\\\n      }\\\\n\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: updatedTask\\\\n      }\\\\n      vi.mocked(kitchenAPI.updateTask).mockResolvedValue(mockResponse)\\\\n\\\\n      const { updateTask } = useKitchen()\\\\n      await updateTask(\\\\'task-1\\\\', updatedTask)\\\\n\\\\n      expect(kitchenAPI.updateTask).toHaveBeenCalledWith(\\\\'task-1\\\\', updatedTask)\\\\n    })\\\\n\\\\n    it(\\\\'应该成功删除任务\\\\', async () => {\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: true\\\\n      }\\\\n      vi.mocked(kitchenAPI.deleteTask).mockResolvedValue(mockResponse)\\\\n\\\\n      const { deleteTask } = useKitchen()\\\\n      await deleteTask(\\\\'task-1\\\\')\\\\n\\\\n      expect(kitchenAPI.deleteTask).toHaveBeenCalledWith(\\\\'task-1\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该成功更新任务状态\\\\', async () => {\\\\n      const newStatus: TaskStatus = \\\\'ready\\\\'\\\\n      const updatedTask = {\\\\n        ...mockTasks[0],\\\\n        status: newStatus\\\\n      }\\\\n\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: updatedTask\\\\n      }\\\\n      vi.mocked(kitchenAPI.updateTaskStatus).mockResolvedValue(mockResponse)\\\\n\\\\n      const { updateTaskStatus } = useKitchen()\\\\n      await updateTaskStatus(\\\\'task-1\\\\', newStatus)\\\\n\\\\n      expect(kitchenAPI.updateTaskStatus).toHaveBeenCalledWith(\\\\'task-1\\\\', newStatus)\\\\n    })\\\\n\\\\n    it(\\\\'应该成功分配任务\\\\', async () => {\\\\n      const assignedTask = {\\\\n        ...mockTasks[0],\\\\n        assignedTo: \\\\'emp-2\\\\'\\\\n      }\\\\n\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: assignedTask\\\\n      }\\\\n      vi.mocked(kitchenAPI.assignTask).mockResolvedValue(mockResponse)\\\\n\\\\n      const { assignTask } = useKitchen()\\\\n      await assignTask(\\\\'task-1\\\\', \\\\'emp-2\\\\')\\\\n\\\\n      expect(kitchenAPI.assignTask).toHaveBeenCalledWith(\\\\'task-1\\\\', \\\\'emp-2\\\\')\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'库存管理\\\\', () => {\\\\n    it(\\\\'应该成功加载库存列表\\\\', async () => {\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: {\\\\n          items: mockInventory,\\\\n          pagination: { page: 1, limit: 20, total: 1, totalPages: 1 }\\\\n        }\\\\n      }\\\\n      vi.mocked(kitchenAPI.getInventory).mockResolvedValue(mockResponse)\\\\n\\\\n      const { loadInventory, inventory } = useKitchen()\\\\n      await loadInventory()\\\\n\\\\n      expect(kitchenAPI.getInventory).toHaveBeenCalled()\\\\n      expect(inventory.value).toEqual(mockInventory)\\\\n    })\\\\n\\\\n    it(\\\\'应该成功创建库存项\\\\', async () => {\\\\n      const newItem = {\\\\n        itemCode: \\\\'ING002\\\\',\\\\n        name: \\\\'鸡肉\\\\',\\\\n        category: \\\\'meat\\\\' as const,\\\\n        unit: \\\\'公斤\\\\',\\\\n        quantity: 30,\\\\n        minQuantity: 10,\\\\n        maxQuantity: 100,\\\\n        unitPrice: 30,\\\\n        supplier: \\\\'供应商B\\\\',\\\\n        lastRestockDate: \\\\'2025-01-20\\\\',\\\\n        status: \\\\'normal\\\\' as const,\\\\n        location: \\\\'冷藏库B\\\\'\\\\n      }\\\\n\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: { ...newItem, id: \\\\'inv-2\\\\', createdAt: \\\\'2025-01-20T00:00:00Z\\\\' }\\\\n      }\\\\n      vi.mocked(kitchenAPI.createInventoryItem).mockResolvedValue(mockResponse)\\\\n\\\\n      const { createInventoryItem } = useKitchen()\\\\n      await createInventoryItem(newItem)\\\\n\\\\n      expect(kitchenAPI.createInventoryItem).toHaveBeenCalledWith(newItem)\\\\n    })\\\\n\\\\n    it(\\\\'应该成功更新库存项\\\\', async () => {\\\\n      const updatedItem = {\\\\n        ...mockInventory[0],\\\\n        quantity: 60\\\\n      }\\\\n\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: updatedItem\\\\n      }\\\\n      vi.mocked(kitchenAPI.updateInventoryItem).mockResolvedValue(mockResponse)\\\\n\\\\n      const { updateInventoryItem } = useKitchen()\\\\n      await updateInventoryItem(\\\\'inv-1\\\\', updatedItem)\\\\n\\\\n      expect(kitchenAPI.updateInventoryItem).toHaveBeenCalledWith(\\\\'inv-1\\\\', updatedItem)\\\\n    })\\\\n\\\\n    it(\\\\'应该成功删除库存项\\\\', async () => {\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: true\\\\n      }\\\\n      vi.mocked(kitchenAPI.deleteInventoryItem).mockResolvedValue(mockResponse)\\\\n\\\\n      const { deleteInventoryItem } = useKitchen()\\\\n      await deleteInventoryItem(\\\\'inv-1\\\\')\\\\n\\\\n      expect(kitchenAPI.deleteInventoryItem).toHaveBeenCalledWith(\\\\'inv-1\\\\')\\\\n    })\\\\n\\\\n    it(\\\\'应该成功补货\\\\', async () => {\\\\n      const restockedItem = {\\\\n        ...mockInventory[0],\\\\n        quantity: 80\\\\n      }\\\\n\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: restockedItem\\\\n      }\\\\n      vi.mocked(kitchenAPI.restockInventory).mockResolvedValue(mockResponse)\\\\n\\\\n      const { restockInventory } = useKitchen()\\\\n      await restockInventory(\\\\'inv-1\\\\', 30)\\\\n\\\\n      expect(kitchenAPI.restockInventory).toHaveBeenCalledWith(\\\\'inv-1\\\\', 30)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'卫生记录管理\\\\', () => {\\\\n    it(\\\\'应该成功加载卫生记录\\\\', async () => {\\\\n      const mockRecords: HygieneRecord[] = [\\\\n        {\\\\n          id: \\\\'hyg-1\\\\',\\\\n          recordCode: \\\\'HYG001\\\\',\\\\n          type: \\\\'daily\\\\',\\\\n          area: \\\\'后厨A区\\\\',\\\\n          inspectorId: \\\\'emp-1\\\\',\\\\n          inspectorName: \\\\'张三\\\\',\\\\n          checkDate: \\\\'2025-01-20\\\\',\\\\n          checkTime: \\\\'08:00\\\\',\\\\n          items: [\\\\n            {\\\\n              id: \\\\'item-1\\\\',\\\\n              item: \\\\'地面清洁\\\\',\\\\n              standard: \\\\'无油污、无积水\\\\',\\\\n              result: \\\\'pass\\\\'\\\\n            }\\\\n          ],\\\\n          result: \\\\'pass\\\\',\\\\n          score: 100,\\\\n          issues: [],\\\\n          photos: [],\\\\n          createdAt: \\\\'2025-01-20T08:00:00Z\\\\'\\\\n        }\\\\n      ]\\\\n\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: {\\\\n          items: mockRecords,\\\\n          pagination: { page: 1, limit: 20, total: 1, totalPages: 1 }\\\\n        }\\\\n      }\\\\n      vi.mocked(kitchenAPI.getHygieneRecords).mockResolvedValue(mockResponse)\\\\n\\\\n      const { loadHygieneRecords, hygieneRecords } = useKitchen()\\\\n      await loadHygieneRecords()\\\\n\\\\n      expect(kitchenAPI.getHygieneRecords).toHaveBeenCalled()\\\\n      expect(hygieneRecords.value).toEqual(mockRecords)\\\\n    })\\\\n\\\\n    it(\\\\'应该成功创建卫生记录\\\\', async () => {\\\\n      const newRecord = {\\\\n        recordCode: \\\\'HYG002\\\\',\\\\n        type: \\\\'daily\\\\' as const,\\\\n        area: \\\\'后厨B区\\\\',\\\\n        inspectorId: \\\\'emp-2\\\\',\\\\n        inspectorName: \\\\'李四\\\\',\\\\n        checkDate: \\\\'2025-01-20\\\\',\\\\n        checkTime: \\\\'09:00\\\\',\\\\n        items: [\\\\n          {\\\\n            id: \\\\'item-2\\\\',\\\\n            item: \\\\'设备清洁\\\\',\\\\n            standard: \\\\'无油污、无残留\\\\',\\\\n            result: \\\\'pass\\\\'\\\\n          }\\\\n        ],\\\\n        result: \\\\'pass\\\\' as const,\\\\n        score: 100,\\\\n        issues: [],\\\\n        photos: []\\\\n      }\\\\n\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: { ...newRecord, id: \\\\'hyg-2\\\\', createdAt: \\\\'2025-01-20T09:00:00Z\\\\' }\\\\n      }\\\\n      vi.mocked(kitchenAPI.createHygieneRecord).mockResolvedValue(mockResponse)\\\\n\\\\n      const { createHygieneRecord } = useKitchen()\\\\n      await createHygieneRecord(newRecord)\\\\n\\\\n      expect(kitchenAPI.createHygieneRecord).toHaveBeenCalledWith(newRecord)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'安全记录管理\\\\', () => {\\\\n    it(\\\\'应该成功加载安全记录\\\\', async () => {\\\\n      const mockRecords: SafetyRecord[] = [\\\\n        {\\\\n          id: \\\\'safe-1\\\\',\\\\n          recordCode: \\\\'SAFE001\\\\',\\\\n          type: \\\\'injury\\\\',\\\\n          location: \\\\'后厨A区\\\\',\\\\n          reporterId: \\\\'emp-1\\\\',\\\\n          reporterName: \\\\'张三\\\\',\\\\n          incidentDate: \\\\'2025-01-20\\\\',\\\\n          incidentTime: \\\\'10:00\\\\',\\\\n          description: \\\\'轻微烫伤\\\\',\\\\n          severity: \\\\'minor\\\\',\\\\n          status: \\\\'resolved\\\\',\\\\n          photos: [],\\\\n          witnesses: [],\\\\n          actions: [],\\\\n          createdAt: \\\\'2025-01-20T10:00:00Z\\\\'\\\\n        }\\\\n      ]\\\\n\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: {\\\\n          items: mockRecords,\\\\n          pagination: { page: 1, limit: 20, total: 1, totalPages: 1 }\\\\n        }\\\\n      }\\\\n      vi.mocked(kitchenAPI.getSafetyRecords).mockResolvedValue(mockResponse)\\\\n\\\\n      const { loadSafetyRecords, safetyRecords } = useKitchen()\\\\n      await loadSafetyRecords()\\\\n\\\\n      expect(kitchenAPI.getSafetyRecords).toHaveBeenCalled()\\\\n      expect(safetyRecords.value).toEqual(mockRecords)\\\\n    })\\\\n\\\\n    it(\\\\'应该成功创建安全记录\\\\', async () => {\\\\n      const newRecord = {\\\\n        recordCode: \\\\'SAFE002\\\\',\\\\n        type: \\\\'equipment\\\\' as const,\\\\n        location: \\\\'后厨B区\\\\',\\\\n        reporterId: \\\\'emp-2\\\\',\\\\n        reporterName: \\\\'李四\\\\',\\\\n        incidentDate: \\\\'2025-01-20\\\\',\\\\n        incidentTime: \\\\'11:00\\\\',\\\\n        description: \\\\'设备故障\\\\',\\\\n        severity: \\\\'moderate\\\\' as const,\\\\n        status: \\\\'reported\\\\' as const,\\\\n        photos: [],\\\\n        witnesses: [],\\\\n        actions: []\\\\n      }\\\\n\\\\n      const mockResponse = {\\\\n        success: true,\\\\n        data: { ...newRecord, id: \\\\'safe-2\\\\', createdAt: \\\\'2025-01-20T11:00:00Z\\\\' }\\\\n      }\\\\n      vi.mocked(kitchenAPI.createSafetyRecord).mockResolvedValue(mockResponse)\\\\n\\\\n      const { createSafetyRecord } = useKitchen()\\\\n      await createSafetyRecord(newRecord)\\\\n\\\\n      expect(kitchenAPI.createSafetyRecord).toHaveBeenCalledWith(newRecord)\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'数据刷新\\\\', () => {\\\\n    it(\\\\'应该成功刷新所有数据\\\\', async () => {\\\\n      const mockStatsResponse = {\\\\n        success: true,\\\\n        data: mockStats\\\\n      }\\\\n      const mockTasksResponse = {\\\\n        success: true,\\\\n        data: {\\\\n          items: mockTasks,\\\\n          pagination: { page: 1, limit: 20, total: 2, totalPages: 1 }\\\\n        }\\\\n      }\\\\n      const mockEmployeesResponse = {\\\\n        success: true,\\\\n        data: {\\\\n          items: mockEmployees,\\\\n          pagination: { page: 1, limit: 20, total: 2, totalPages: 1 }\\\\n        }\\\\n      }\\\\n\\\\n      vi.mocked(kitchenAPI.getStats).mockResolvedValue(mockStatsResponse)\\\\n      vi.mocked(kitchenAPI.getTasks).mockResolvedValue(mockTasksResponse)\\\\n      vi.mocked(kitchenAPI.getEmployees).mockResolvedValue(mockEmployeesResponse)\\\\n\\\\n      const { refreshData } = useKitchen()\\\\n      await refreshData()\\\\n\\\\n      expect(kitchenAPI.getStats).toHaveBeenCalled()\\\\n      expect(kitchenAPI.getTasks).toHaveBeenCalled()\\\\n      expect(kitchenAPI.getEmployees).toHaveBeenCalled()\\\\n    })\\\\n  })\\\\n\\\\n  describe(\\\\'自动刷新\\\\', () => {\\\\n    it(\\\\'应该启动自动刷新\\\\', () => {\\\\n      const { startAutoRefresh, stopAutoRefresh } = useKitchen()\\\\n\\\\n      startAutoRefresh(5000)\\\\n\\\\n      vi.advanceTimersByTime(5000)\\\\n\\\\n      stopAutoRefresh()\\\\n    })\\\\n\\\\n    it(\\\\'应该停止自动刷新\\\\', () => {\\\\n      const { startAutoRefresh, stopAutoRefresh } = useKitchen()\\\\n\\\\n      startAutoRefresh(5000)\\\\n      stopAutoRefresh()\\\\n\\\\n      vi.advanceTimersByTime(10000)\\\\n    })\\\\n  })\\\\n})\\\\n\",\"originAcceptText\":\"/**\\n * @fileoverview YYC³餐饮管理系统 - useKitchen Composable测试\\n * @description 测试useKitchen composable的功能\\n * @module useKitchen.test\\n * @author YYC³\\n * @version 1.0.0\\n * @created 2025-01-20\\n */\\n\\nimport { describe, it, expect, beforeEach, vi, afterEach } from 'vitest'\\nimport { ref } from 'vue'\\nimport { useKitchen } from '@/composables/useKitchen'\\nimport { kitchenAPI } from '@/api/kitchen'\\nimport type {\\n  KitchenEquipment,\\n  KitchenEmployee,\\n  KitchenTask,\\n  KitchenInventory,\\n  HygieneRecord,\\n  SafetyRecord,\\n  TaskStatus,\\n  EmployeeStatus\\n} from '@/types/kitchen'\\n\\nvi.mock('@/api/kitchen', () => ({\\n  kitchenAPI: {\\n    getStats: vi.fn(),\\n    getAnalytics: vi.fn(),\\n    getEquipment: vi.fn(),\\n    createEquipment: vi.fn(),\\n    updateEquipment: vi.fn(),\\n    deleteEquipment: vi.fn(),\\n    getEmployees: vi.fn(),\\n    createEmployee: vi.fn(),\\n    updateEmployee: vi.fn(),\\n    deleteEmployee: vi.fn(),\\n    updateEmployeeStatus: vi.fn(),\\n    getTasks: vi.fn(),\\n    createTask: vi.fn(),\\n    updateTask: vi.fn(),\\n    deleteTask: vi.fn(),\\n    updateTaskStatus: vi.fn(),\\n    assignTask: vi.fn(),\\n    getInventory: vi.fn(),\\n    createInventoryItem: vi.fn(),\\n    updateInventoryItem: vi.fn(),\\n    deleteInventoryItem: vi.fn(),\\n    restockInventory: vi.fn(),\\n    getHygieneRecords: vi.fn(),\\n    createHygieneRecord: vi.fn(),\\n    updateHygieneRecord: vi.fn(),\\n    getSafetyRecords: vi.fn(),\\n    createSafetyRecord: vi.fn(),\\n    updateSafetyRecord: vi.fn(),\\n    getDisplays: vi.fn(),\\n    createDisplay: vi.fn(),\\n    updateDisplay: vi.fn(),\\n    deleteDisplay: vi.fn()\\n  }\\n}))\\n\\nvi.mock('element-plus', () => ({\\n  ElMessage: {\\n    success: vi.fn(),\\n    error: vi.fn(),\\n    warning: vi.fn(),\\n    info: vi.fn()\\n  }\\n}))\\n\\ndescribe('useKitchen Composable', () => {\\n  const mockStats = {\\n    activeTasks: 5,\\n    completedToday: 42,\\n    efficiencyRate: 85.5,\\n    averagePreparationTime: 900,\\n    totalEmployees: 10,\\n    onlineEmployees: 8,\\n    totalEquipment: 20,\\n    normalEquipment: 18,\\n    maintenanceEquipment: 2,\\n    lowStockItems: 3,\\n    expiredItems: 1\\n  }\\n\\n  const mockEquipment: KitchenEquipment[] = [\\n    {\\n      id: 'eq-1',\\n      equipmentCode: 'EQ001',\\n      name: '商用蒸柜',\\n      type: 'cooking',\\n      brand: '美的',\\n      model: 'MZ-2000',\\n      status: 'normal',\\n      location: '后厨A区',\\n      purchaseDate: '2023-01-01',\\n      warrantyDate: '2025-01-01',\\n      lastMaintenanceDate: '2024-12-01',\\n      nextMaintenanceDate: '2025-01-01',\\n      maintenanceInterval: 30,\\n      power: 5000,\\n      specifications: { capacity: '200L', temperature: '100°C' },\\n      images: [],\\n      responsiblePersonId: 'emp-1',\\n      createdAt: '2023-01-01T00:00:00Z'\\n    }\\n  ]\\n\\n  const mockEmployees: KitchenEmployee[] = [\\n    {\\n      id: 'emp-1',\\n      employeeCode: 'KITCHEN001',\\n      name: '张三',\\n      avatar: 'https://example.com/avatar1.jpg',\\n      position: 'chef',\\n      status: 'online',\\n      phone: '13800138000',\\n      email: 'zhangsan@example.com',\\n      hireDate: '2023-01-01',\\n      skills: ['炒菜', '炖汤', '切配'],\\n      certifications: [\\n        {\\n          id: 'cert-1',\\n          name: '厨师证',\\n          issueDate: '2022-01-01',\\n          expiryDate: '2025-01-01',\\n          issuer: '北京市烹饪协会'\\n        }\\n      ],\\n      currentTasks: 2,\\n      totalTasksCompleted: 150,\\n      efficiency: 92.5,\\n      averageTime: 12,\\n      workSchedule: [],\\n      createdAt: '2023-01-01T00:00:00Z'\\n    },\\n    {\\n      id: 'emp-2',\\n      employeeCode: 'KITCHEN002',\\n      name: '李四',\\n      avatar: 'https://example.com/avatar2.jpg',\\n      position: 'line_cook',\\n      status: 'busy',\\n      phone: '13900139000',\\n      email: 'lisi@example.com',\\n      hireDate: '2023-06-01',\\n      skills: ['切配', '备菜'],\\n      certifications: [],\\n      currentTasks: 3,\\n      totalTasksCompleted: 120,\\n      efficiency: 88.0,\\n      averageTime: 15,\\n      workSchedule: [],\\n      createdAt: '2023-06-01T00:00:00Z'\\n    }\\n  ]\\n\\n  const mockTasks: KitchenTask[] = [\\n    {\\n      id: 'task-1',\\n      taskId: 'TASK001',\\n      orderNo: 'ORD001',\\n      itemName: '红烧肉',\\n      quantity: 2,\\n      station: 'hot_dish',\\n      priority: 'high',\\n      status: 'pending',\\n      tableNumber: 'A01',\\n      estimatedTime: 15,\\n      assignedTo: 'emp-1',\\n      specialRequests: '少辣',\\n      createdAt: '2025-01-20T10:00:00Z'\\n    },\\n    {\\n      id: 'task-2',\\n      taskId: 'TASK002',\\n      orderNo: 'ORD002',\\n      itemName: '清蒸鱼',\\n      quantity: 1,\\n      station: 'hot_dish',\\n      priority: 'normal',\\n      status: 'preparing',\\n      tableNumber: 'A02',\\n      estimatedTime: 20,\\n      assignedTo: 'emp-2',\\n      createdAt: '2025-01-20T10:05:00Z'\\n    }\\n  ]\\n\\n  const mockInventory: KitchenInventory[] = [\\n    {\\n      id: 'inv-1',\\n      itemCode: 'ING001',\\n      name: '猪肉',\\n      category: 'meat',\\n      unit: '公斤',\\n      quantity: 50,\\n      minQuantity: 10,\\n      maxQuantity: 100,\\n      unitPrice: 50,\\n      supplier: '供应商A',\\n      lastRestockDate: '2025-01-15',\\n      status: 'normal',\\n      location: '冷藏库A',\\n      createdAt: '2025-01-01T00:00:00Z'\\n    }\\n  ]\\n\\n  beforeEach(() => {\\n    vi.clearAllMocks()\\n    vi.useFakeTimers()\\n  })\\n\\n  afterEach(() => {\\n    vi.restoreAllMocks()\\n    vi.useRealTimers()\\n  })\\n\\n  describe('状态管理', () => {\\n    it('应该初始化正确的状态', () => {\\n      const { loading, stats, equipment, employees, tasks, inventory } = useKitchen()\\n\\n      expect(loading.value).toBe(false)\\n      expect(stats.value).toBeDefined()\\n      expect(equipment.value).toEqual([])\\n      expect(employees.value).toEqual([])\\n      expect(tasks.value).toEqual([])\\n      expect(inventory.value).toEqual([])\\n    })\\n\\n    it('应该正确计算设备利用率', () => {\\n      const { equipmentUtilization } = useKitchen()\\n      expect(equipmentUtilization.value).toBe(0)\\n    })\\n\\n    it('应该正确计算员工在线率', () => {\\n      const { employeeOnlineRate } = useKitchen()\\n      expect(employeeOnlineRate.value).toBe(0)\\n    })\\n  })\\n\\n  describe('统计数据加载', () => {\\n    it('应该成功加载统计数据', async () => {\\n      const mockResponse = {\\n        success: true,\\n        data: mockStats\\n      }\\n      vi.mocked(kitchenAPI.getStats).mockResolvedValue(mockResponse)\\n\\n      const { loadStats, stats } = useKitchen()\\n      await loadStats()\\n\\n      expect(kitchenAPI.getStats).toHaveBeenCalled()\\n      expect(stats.value).toEqual(mockStats)\\n    })\\n\\n    it('应该处理加载统计数据失败', async () => {\\n      vi.mocked(kitchenAPI.getStats).mockRejectedValue(new Error('加载失败'))\\n\\n      const { loadStats } = useKitchen()\\n      await expect(loadStats()).resolves.toBeUndefined()\\n    })\\n  })\\n\\n  describe('设备管理', () => {\\n    it('应该成功加载设备列表', async () => {\\n      const mockResponse = {\\n        success: true,\\n        data: {\\n          items: mockEquipment,\\n          pagination: { page: 1, limit: 20, total: 1, totalPages: 1 }\\n        }\\n      }\\n      vi.mocked(kitchenAPI.getEquipment).mockResolvedValue(mockResponse)\\n\\n      const { loadEquipment, equipment } = useKitchen()\\n      await loadEquipment()\\n\\n      expect(kitchenAPI.getEquipment).toHaveBeenCalled()\\n      expect(equipment.value).toEqual(mockEquipment)\\n    })\\n\\n    it('应该成功创建设备', async () => {\\n      const newEquipment = {\\n        equipmentCode: 'EQ002',\\n        name: '商用烤箱',\\n        type: 'cooking' as const,\\n        brand: '西门子',\\n        model: 'SI-3000',\\n        status: 'normal' as const,\\n        location: '后厨B区',\\n        purchaseDate: '2025-01-20',\\n        warrantyDate: '2027-01-20',\\n        lastMaintenanceDate: '2025-01-20',\\n        nextMaintenanceDate: '2025-02-20',\\n        maintenanceInterval: 30,\\n        power: 3000,\\n        specifications: { capacity: '100L', temperature: '250°C' },\\n        images: [],\\n        responsiblePersonId: 'emp-1'\\n      }\\n\\n      const mockResponse = {\\n        success: true,\\n        data: { ...newEquipment, id: 'eq-2', createdAt: '2025-01-20T00:00:00Z' }\\n      }\\n      vi.mocked(kitchenAPI.createEquipment).mockResolvedValue(mockResponse)\\n\\n      const { createEquipment, equipment } = useKitchen()\\n      await createEquipment(newEquipment)\\n\\n      expect(kitchenAPI.createEquipment).toHaveBeenCalledWith(newEquipment)\\n      expect(equipment.value.length).toBeGreaterThan(0)\\n    })\\n\\n    it('应该成功更新设备', async () => {\\n      const updatedEquipment = {\\n        ...mockEquipment[0],\\n        name: '商用蒸柜（更新）'\\n      }\\n\\n      const mockResponse = {\\n        success: true,\\n        data: updatedEquipment\\n      }\\n      vi.mocked(kitchenAPI.updateEquipment).mockResolvedValue(mockResponse)\\n\\n      const { updateEquipment } = useKitchen()\\n      await updateEquipment('eq-1', updatedEquipment)\\n\\n      expect(kitchenAPI.updateEquipment).toHaveBeenCalledWith('eq-1', updatedEquipment)\\n    })\\n\\n    it('应该成功删除设备', async () => {\\n      const mockResponse = {\\n        success: true,\\n        data: true\\n      }\\n      vi.mocked(kitchenAPI.deleteEquipment).mockResolvedValue(mockResponse)\\n\\n      const { deleteEquipment } = useKitchen()\\n      await deleteEquipment('eq-1')\\n\\n      expect(kitchenAPI.deleteEquipment).toHaveBeenCalledWith('eq-1')\\n    })\\n  })\\n\\n  describe('员工管理', () => {\\n    it('应该成功加载员工列表', async () => {\\n      const mockResponse = {\\n        success: true,\\n        data: {\\n          items: mockEmployees,\\n          pagination: { page: 1, limit: 20, total: 2, totalPages: 1 }\\n        }\\n      }\\n      vi.mocked(kitchenAPI.getEmployees).mockResolvedValue(mockResponse)\\n\\n      const { loadEmployees, employees } = useKitchen()\\n      await loadEmployees()\\n\\n      expect(kitchenAPI.getEmployees).toHaveBeenCalled()\\n      expect(employees.value).toEqual(mockEmployees)\\n    })\\n\\n    it('应该成功创建员工', async () => {\\n      const newEmployee = {\\n        employeeCode: 'KITCHEN003',\\n        name: '王五',\\n        position: 'line_cook' as const,\\n        status: 'online' as const,\\n        phone: '13700137000',\\n        email: 'wangwu@example.com',\\n        hireDate: '2025-01-20',\\n        skills: ['切配'],\\n        certifications: [],\\n        currentTasks: 0,\\n        totalTasksCompleted: 0,\\n        efficiency: 0,\\n        averageTime: 0,\\n        workSchedule: []\\n      }\\n\\n      const mockResponse = {\\n        success: true,\\n        data: { ...newEmployee, id: 'emp-3', createdAt: '2025-01-20T00:00:00Z' }\\n      }\\n      vi.mocked(kitchenAPI.createEmployee).mockResolvedValue(mockResponse)\\n\\n      const { createEmployee } = useKitchen()\\n      await createEmployee(newEmployee)\\n\\n      expect(kitchenAPI.createEmployee).toHaveBeenCalledWith(newEmployee)\\n    })\\n\\n    it('应该成功更新员工', async () => {\\n      const updatedEmployee = {\\n        ...mockEmployees[0],\\n        name: '张三（更新）'\\n      }\\n\\n      const mockResponse = {\\n        success: true,\\n        data: updatedEmployee\\n      }\\n      vi.mocked(kitchenAPI.updateEmployee).mockResolvedValue(mockResponse)\\n\\n      const { updateEmployee } = useKitchen()\\n      await updateEmployee('emp-1', updatedEmployee)\\n\\n      expect(kitchenAPI.updateEmployee).toHaveBeenCalledWith('emp-1', updatedEmployee)\\n    })\\n\\n    it('应该成功删除员工', async () => {\\n      const mockResponse = {\\n        success: true,\\n        data: true\\n      }\\n      vi.mocked(kitchenAPI.deleteEmployee).mockResolvedValue(mockResponse)\\n\\n      const { deleteEmployee } = useKitchen()\\n      await deleteEmployee('emp-1')\\n\\n      expect(kitchenAPI.deleteEmployee).toHaveBeenCalledWith('emp-1')\\n    })\\n\\n    it('应该成功更新员工状态', async () => {\\n      const newStatus: EmployeeStatus = 'break'\\n      const updatedEmployee = {\\n        ...mockEmployees[0],\\n        status: newStatus\\n      }\\n\\n      const mockResponse = {\\n        success: true,\\n        data: updatedEmployee\\n      }\\n      vi.mocked(kitchenAPI.updateEmployeeStatus).mockResolvedValue(mockResponse)\\n\\n      const { updateEmployeeStatus } = useKitchen()\\n      await updateEmployeeStatus('emp-1', newStatus)\\n\\n      expect(kitchenAPI.updateEmployeeStatus).toHaveBeenCalledWith('emp-1', newStatus)\\n    })\\n  })\\n\\n  describe('任务管理', () => {\\n    it('应该成功加载任务列表', async () => {\\n      const mockResponse = {\\n        success: true,\\n        data: {\\n          items: mockTasks,\\n          pagination: { page: 1, limit: 20, total: 2, totalPages: 1 }\\n        }\\n      }\\n      vi.mocked(kitchenAPI.getTasks).mockResolvedValue(mockResponse)\\n\\n      const { loadTasks, tasks } = useKitchen()\\n      await loadTasks()\\n\\n      expect(kitchenAPI.getTasks).toHaveBeenCalled()\\n      expect(tasks.value).toEqual(mockTasks)\\n    })\\n\\n    it('应该成功创建任务', async () => {\\n      const newTask = {\\n        taskId: 'TASK003',\\n        orderNo: 'ORD003',\\n        itemName: '宫保鸡丁',\\n        quantity: 1,\\n        station: 'hot_dish' as const,\\n        priority: 'normal' as const,\\n        status: 'pending' as const,\\n        tableNumber: 'A03',\\n        estimatedTime: 18,\\n        createdAt: '2025-01-20T10:10:00Z'\\n      }\\n\\n      const mockResponse = {\\n        success: true,\\n        data: { ...newTask, id: 'task-3' }\\n      }\\n      vi.mocked(kitchenAPI.createTask).mockResolvedValue(mockResponse)\\n\\n      const { createTask } = useKitchen()\\n      await createTask(newTask)\\n\\n      expect(kitchenAPI.createTask).toHaveBeenCalledWith(newTask)\\n    })\\n\\n    it('应该成功更新任务', async () => {\\n      const updatedTask = {\\n        ...mockTasks[0],\\n        status: 'preparing' as TaskStatus\\n      }\\n\\n      const mockResponse = {\\n        success: true,\\n        data: updatedTask\\n      }\\n      vi.mocked(kitchenAPI.updateTask).mockResolvedValue(mockResponse)\\n\\n      const { updateTask } = useKitchen()\\n      await updateTask('task-1', updatedTask)\\n\\n      expect(kitchenAPI.updateTask).toHaveBeenCalledWith('task-1', updatedTask)\\n    })\\n\\n    it('应该成功删除任务', async () => {\\n      const mockResponse = {\\n        success: true,\\n        data: true\\n      }\\n      vi.mocked(kitchenAPI.deleteTask).mockResolvedValue(mockResponse)\\n\\n      const { deleteTask } = useKitchen()\\n      await deleteTask('task-1')\\n\\n      expect(kitchenAPI.deleteTask).toHaveBeenCalledWith('task-1')\\n    })\\n\\n    it('应该成功更新任务状态', async () => {\\n      const newStatus: TaskStatus = 'ready'\\n      const updatedTask = {\\n        ...mockTasks[0],\\n        status: newStatus\\n      }\\n\\n      const mockResponse = {\\n        success: true,\\n        data: updatedTask\\n      }\\n      vi.mocked(kitchenAPI.updateTaskStatus).mockResolvedValue(mockResponse)\\n\\n      const { updateTaskStatus } = useKitchen()\\n      await updateTaskStatus('task-1', newStatus)\\n\\n      expect(kitchenAPI.updateTaskStatus).toHaveBeenCalledWith('task-1', newStatus)\\n    })\\n\\n    it('应该成功分配任务', async () => {\\n      const assignedTask = {\\n        ...mockTasks[0],\\n        assignedTo: 'emp-2'\\n      }\\n\\n      const mockResponse = {\\n        success: true,\\n        data: assignedTask\\n      }\\n      vi.mocked(kitchenAPI.assignTask).mockResolvedValue(mockResponse)\\n\\n      const { assignTask } = useKitchen()\\n      await assignTask('task-1', 'emp-2')\\n\\n      expect(kitchenAPI.assignTask).toHaveBeenCalledWith('task-1', 'emp-2')\\n    })\\n  })\\n\\n  describe('库存管理', () => {\\n    it('应该成功加载库存列表', async () => {\\n      const mockResponse = {\\n        success: true,\\n        data: {\\n          items: mockInventory,\\n          pagination: { page: 1, limit: 20, total: 1, totalPages: 1 }\\n        }\\n      }\\n      vi.mocked(kitchenAPI.getInventory).mockResolvedValue(mockResponse)\\n\\n      const { loadInventory, inventory } = useKitchen()\\n      await loadInventory()\\n\\n      expect(kitchenAPI.getInventory).toHaveBeenCalled()\\n      expect(inventory.value).toEqual(mockInventory)\\n    })\\n\\n    it('应该成功创建库存项', async () => {\\n      const newItem = {\\n        itemCode: 'ING002',\\n        name: '鸡肉',\\n        category: 'meat' as const,\\n        unit: '公斤',\\n        quantity: 30,\\n        minQuantity: 10,\\n        maxQuantity: 100,\\n        unitPrice: 30,\\n        supplier: '供应商B',\\n        lastRestockDate: '2025-01-20',\\n        status: 'normal' as const,\\n        location: '冷藏库B'\\n      }\\n\\n      const mockResponse = {\\n        success: true,\\n        data: { ...newItem, id: 'inv-2', createdAt: '2025-01-20T00:00:00Z' }\\n      }\\n      vi.mocked(kitchenAPI.createInventoryItem).mockResolvedValue(mockResponse)\\n\\n      const { createInventoryItem } = useKitchen()\\n      await createInventoryItem(newItem)\\n\\n      expect(kitchenAPI.createInventoryItem).toHaveBeenCalledWith(newItem)\\n    })\\n\\n    it('应该成功更新库存项', async () => {\\n      const updatedItem = {\\n        ...mockInventory[0],\\n        quantity: 60\\n      }\\n\\n      const mockResponse = {\\n        success: true,\\n        data: updatedItem\\n      }\\n      vi.mocked(kitchenAPI.updateInventoryItem).mockResolvedValue(mockResponse)\\n\\n      const { updateInventoryItem } = useKitchen()\\n      await updateInventoryItem('inv-1', updatedItem)\\n\\n      expect(kitchenAPI.updateInventoryItem).toHaveBeenCalledWith('inv-1', updatedItem)\\n    })\\n\\n    it('应该成功删除库存项', async () => {\\n      const mockResponse = {\\n        success: true,\\n        data: true\\n      }\\n      vi.mocked(kitchenAPI.deleteInventoryItem).mockResolvedValue(mockResponse)\\n\\n      const { deleteInventoryItem } = useKitchen()\\n      await deleteInventoryItem('inv-1')\\n\\n      expect(kitchenAPI.deleteInventoryItem).toHaveBeenCalledWith('inv-1')\\n    })\\n\\n    it('应该成功补货', async () => {\\n      const restockedItem = {\\n        ...mockInventory[0],\\n        quantity: 80\\n      }\\n\\n      const mockResponse = {\\n        success: true,\\n        data: restockedItem\\n      }\\n      vi.mocked(kitchenAPI.restockInventory).mockResolvedValue(mockResponse)\\n\\n      const { restockInventory } = useKitchen()\\n      await restockInventory('inv-1', 30)\\n\\n      expect(kitchenAPI.restockInventory).toHaveBeenCalledWith('inv-1', 30)\\n    })\\n  })\\n\\n  describe('卫生记录管理', () => {\\n    it('应该成功加载卫生记录', async () => {\\n      const mockRecords: HygieneRecord[] = [\\n        {\\n          id: 'hyg-1',\\n          recordCode: 'HYG001',\\n          type: 'daily',\\n          area: '后厨A区',\\n          inspectorId: 'emp-1',\\n          inspectorName: '张三',\\n          checkDate: '2025-01-20',\\n          checkTime: '08:00',\\n          items: [\\n            {\\n              id: 'item-1',\\n              item: '地面清洁',\\n              standard: '无油污、无积水',\\n              result: 'pass'\\n            }\\n          ],\\n          result: 'pass',\\n          score: 100,\\n          issues: [],\\n          photos: [],\\n          createdAt: '2025-01-20T08:00:00Z'\\n        }\\n      ]\\n\\n      const mockResponse = {\\n        success: true,\\n        data: {\\n          items: mockRecords,\\n          pagination: { page: 1, limit: 20, total: 1, totalPages: 1 }\\n        }\\n      }\\n      vi.mocked(kitchenAPI.getHygieneRecords).mockResolvedValue(mockResponse)\\n\\n      const { loadHygieneRecords, hygieneRecords } = useKitchen()\\n      await loadHygieneRecords()\\n\\n      expect(kitchenAPI.getHygieneRecords).toHaveBeenCalled()\\n      expect(hygieneRecords.value).toEqual(mockRecords)\\n    })\\n\\n    it('应该成功创建卫生记录', async () => {\\n      const newRecord = {\\n        recordCode: 'HYG002',\\n        type: 'daily' as const,\\n        area: '后厨B区',\\n        inspectorId: 'emp-2',\\n        inspectorName: '李四',\\n        checkDate: '2025-01-20',\\n        checkTime: '09:00',\\n        items: [\\n          {\\n            id: 'item-2',\\n            item: '设备清洁',\\n            standard: '无油污、无残留',\\n            result: 'pass'\\n          }\\n        ],\\n        result: 'pass' as const,\\n        score: 100,\\n        issues: [],\\n        photos: []\\n      }\\n\\n      const mockResponse = {\\n        success: true,\\n        data: { ...newRecord, id: 'hyg-2', createdAt: '2025-01-20T09:00:00Z' }\\n      }\\n      vi.mocked(kitchenAPI.createHygieneRecord).mockResolvedValue(mockResponse)\\n\\n      const { createHygieneRecord } = useKitchen()\\n      await createHygieneRecord(newRecord)\\n\\n      expect(kitchenAPI.createHygieneRecord).toHaveBeenCalledWith(newRecord)\\n    })\\n  })\\n\\n  describe('安全记录管理', () => {\\n    it('应该成功加载安全记录', async () => {\\n      const mockRecords: SafetyRecord[] = [\\n        {\\n          id: 'safe-1',\\n          recordCode: 'SAFE001',\\n          type: 'injury',\\n          location: '后厨A区',\\n          reporterId: 'emp-1',\\n          reporterName: '张三',\\n          incidentDate: '2025-01-20',\\n          incidentTime: '10:00',\\n          description: '轻微烫伤',\\n          severity: 'minor',\\n          status: 'resolved',\\n          photos: [],\\n          witnesses: [],\\n          actions: [],\\n          createdAt: '2025-01-20T10:00:00Z'\\n        }\\n      ]\\n\\n      const mockResponse = {\\n        success: true,\\n        data: {\\n          items: mockRecords,\\n          pagination: { page: 1, limit: 20, total: 1, totalPages: 1 }\\n        }\\n      }\\n      vi.mocked(kitchenAPI.getSafetyRecords).mockResolvedValue(mockResponse)\\n\\n      const { loadSafetyRecords, safetyRecords } = useKitchen()\\n      await loadSafetyRecords()\\n\\n      expect(kitchenAPI.getSafetyRecords).toHaveBeenCalled()\\n      expect(safetyRecords.value).toEqual(mockRecords)\\n    })\\n\\n    it('应该成功创建安全记录', async () => {\\n      const newRecord = {\\n        recordCode: 'SAFE002',\\n        type: 'equipment' as const,\\n        location: '后厨B区',\\n        reporterId: 'emp-2',\\n        reporterName: '李四',\\n        incidentDate: '2025-01-20',\\n        incidentTime: '11:00',\\n        description: '设备故障',\\n        severity: 'moderate' as const,\\n        status: 'reported' as const,\\n        photos: [],\\n        witnesses: [],\\n        actions: []\\n      }\\n\\n      const mockResponse = {\\n        success: true,\\n        data: { ...newRecord, id: 'safe-2', createdAt: '2025-01-20T11:00:00Z' }\\n      }\\n      vi.mocked(kitchenAPI.createSafetyRecord).mockResolvedValue(mockResponse)\\n\\n      const { createSafetyRecord } = useKitchen()\\n      await createSafetyRecord(newRecord)\\n\\n      expect(kitchenAPI.createSafetyRecord).toHaveBeenCalledWith(newRecord)\\n    })\\n  })\\n\\n  describe('数据刷新', () => {\\n    it('应该成功刷新所有数据', async () => {\\n      const mockStatsResponse = {\\n        success: true,\\n        data: mockStats\\n      }\\n      const mockTasksResponse = {\\n        success: true,\\n        data: {\\n          items: mockTasks,\\n          pagination: { page: 1, limit: 20, total: 2, totalPages: 1 }\\n        }\\n      }\\n      const mockEmployeesResponse = {\\n        success: true,\\n        data: {\\n          items: mockEmployees,\\n          pagination: { page: 1, limit: 20, total: 2, totalPages: 1 }\\n        }\\n      }\\n\\n      vi.mocked(kitchenAPI.getStats).mockResolvedValue(mockStatsResponse)\\n      vi.mocked(kitchenAPI.getTasks).mockResolvedValue(mockTasksResponse)\\n      vi.mocked(kitchenAPI.getEmployees).mockResolvedValue(mockEmployeesResponse)\\n\\n      const { refreshData } = useKitchen()\\n      await refreshData()\\n\\n      expect(kitchenAPI.getStats).toHaveBeenCalled()\\n      expect(kitchenAPI.getTasks).toHaveBeenCalled()\\n      expect(kitchenAPI.getEmployees).toHaveBeenCalled()\\n    })\\n  })\\n\\n  describe('自动刷新', () => {\\n    it('应该启动自动刷新', () => {\\n      const { startAutoRefresh, stopAutoRefresh } = useKitchen()\\n\\n      startAutoRefresh(5000)\\n\\n      vi.advanceTimersByTime(5000)\\n\\n      stopAutoRefresh()\\n    })\\n\\n    it('应该停止自动刷新', () => {\\n      const { startAutoRefresh, stopAutoRefresh } = useKitchen()\\n\\n      startAutoRefresh(5000)\\n      stopAutoRefresh()\\n\\n      vi.advanceTimersByTime(10000)\\n    })\\n  })\\n})\\n\",\"originTextLength\":22736,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",\"updateTime\":1768887165358},{\"originRange\":{\"start\":{\"line\":302,\"character\":0},\"end\":{\"line\":304,\"character\":30}},\"modifyRange\":{\"start\":{\"line\":302,\"character\":0},\"end\":{\"line\":304,\"character\":30}},\"action\":\"None\",\"isLine\":false,\"originText\":\"      const createdEquipment = { ...newEquipment, id: \\\\'eq-2\\\\', createdAt: \\\\'2025-01-20T00:00:00Z\\\\' }\\\\n      const updatedEquipmentList = [...mockEquipment, createdEquipment]\\\\n\\\\n      const createResponse = {\",\"originAcceptText\":\"      const createdEquipment = { ...newEquipment, id: 'eq-2', createdAt: '2025-01-20T00:00:00Z' }\\n      const updatedEquipmentList = [...mockEquipment, createdEquipment]\\n\\n      const createResponse = {\",\"originTextLength\":201,\"aiScene\":\"builder\",\"behaviorType\":\"accept\",